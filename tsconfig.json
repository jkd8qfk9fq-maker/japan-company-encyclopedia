{
  // The real options live in tsconfig.base.json (JCE-076, docs/decisions.md). The indirection is
  // load-bearing: Next.js rewrites tsconfig.json to force its required values — resolveJsonModule:
  // true among them — unless the config uses `extends`, in which case it leaves the file alone
  // (writeConfigurationDefaults bails out). resolveJsonModule: false is what keeps the type check
  // small enough for the production build; do not inline this file back.
  "extends": "./tsconfig.base.json"
}
