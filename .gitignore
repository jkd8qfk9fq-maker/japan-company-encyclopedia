# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example holds no values and documents the settings; it is meant to be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local development data (reports submitted against the dev server)
/.data/

# Pipeline working state: per-company stage status and agent fragments.
# Local so a stopped run resumes on this machine; the batch lists below are
# the plan and ARE tracked.
pipeline/state/
pipeline/results/
# An entry assembled but not yet registered. Gated here so a wrong figure never
# reaches src/data/companies; deleted on a successful registration.
pipeline/staging/
