{
  // Cloudflare Workers: the public pages as static assets (the output of `npm run build:static`), served at
  // kigyo-hyakka.com (JCE-038). worker/index.ts only redirects the old workers.dev address and www. there.
  "name": "nihonkigyohyakka",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "kigyo-hyakka.com", "custom_domain": true },
    { "pattern": "www.kigyo-hyakka.com", "custom_domain": true }
  ],
  // Kept on so the old address can answer with its redirect: with routes set, wrangler would otherwise turn it off.
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_next/*"]
  },
  // Notifications for followed companies (JCE-059). The subscriptions (anonymous: push address, its keys, company ids)
  // live in D1; migrations/0001_push.sql. The VAPID key pair is set as Worker secrets (VAPID_PUBLIC_KEY,
  // VAPID_PRIVATE_KEY), never here; without them the feature reports itself off and the page offers nothing.
  "d1_databases": [
    { "binding": "PUSH_DB", "database_name": "kigyo-push", "database_id": "9790ec13-5ba6-417c-9c8e-d7d293953af1", "migrations_dir": "migrations" }
  ],
  // Every 30 minutes: announce what /updates.json newly lists (worker/index.ts › scheduled).
  "triggers": { "crons": ["*/30 * * * *"] },
  "ratelimits": [
    { "name": "PUSH_LIMIT", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
    // JCE-065: moving lists to another device — each address may send a few links and open a few per minute.
    { "name": "SYNC_LIMIT", "namespace_id": "3002", "simple": { "limit": 6, "period": 60 } },
    // JCE-069: e-mail notifications — per address and per recipient address, a few confirmations and changes a minute.
    { "name": "MAIL_LIMIT", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
    // JCE-100: plan checks against this site's own billing record — a reader's browser checks rarely; a guessed code costs one lookup.
    { "name": "BILLING_LIMIT", "namespace_id": "3004", "simple": { "limit": 30, "period": 60 } }
  ]
}
