{
  // Cloudflare Workers: the public pages as static assets (the output of `npm run build:static`).
  // The Worker name is the first part of the free URL: https://nihonkigyohyakka.<account>.workers.dev
  "name": "nihonkigyohyakka",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
