  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ニチアス理念「私たちは、『断つ・保つ』の技術で地球の明るい未来に貢献します。」のもと、長期ビジョン「『断つ・保つ』で明るい未来へ」を掲げ、2027年3月期を最終年度とする中期経営計画「しくみ・１３０」（2023年3月期～2027年3月期）を進めています。同計画では、2027年3月期の売上高を2,750億円とするイメージを示しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "1896年にわが国における保温・断熱分野のパイオニアとしてスタートし、「断つ・保つ」をコアとしたシール技術、断熱技術、防音技術、耐火技術、耐食技術、クリーン技術の6つの要素技術を用いた製品・サービスを提供しています。研究開発は浜松研究所、鶴見研究所の2研究所と各事業部門の技術開発部からなる体制で推進しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【研究開発活動】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高251,910百万円のうち、プラント向け工事・販売が79,503百万円と最大で、工業製品53,321百万円、自動車部品51,504百万円、高機能製品39,094百万円、建材28,487百万円と続きます。地域別では日本が200,070百万円と全体の約8割を占め、アジアが39,389百万円です。",
        "basis": "【セグメント情報】の外部顧客への売上高と【関連情報】の地域ごとの情報に印字された数値によります。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
