  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期ビジョンとして「『トータル・ケーブル・テクノロジー』の追求により、世界の安全・安心を支える」を掲げ、2025年3月期から2027年3月期の中期経営計画『TCTRX』では、重点育成事業への経営資源投入の強化、既存事業の競争力強化、全ステークホルダーにとって魅力ある会社作りの3つを基本方針として、事業基盤の維持と収益力の強化を図っています。2027年4月に創業140周年を迎えるにあたり、トータル・ケーブル・テクノロジーを追求することで世界の安全・安心を支える150年企業を目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ワイヤ、ワイヤロープ及び繊維ロープとそれらの派生商品を広範に手がけて技術を蓄積してきたことに加え、診断技術などのソフト面や、カーボンファイバーなど異素材の技術開発にも取り組んでいる点が特徴です。ケーブルに関して様々な対応が可能なサプライヤーとして、国内の生産拠点に加え、ベトナムや米国にも製造拠点を持っています。",
        "basis": "経営方針（会社の経営の基本方針における取扱製品と技術開発の記載）、事業の内容（各事業の担い手と製品）、主要な設備の状況（国内外の生産拠点）の記載に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "最大の事業は鋼索鋼線関連で、2026年3月期の外部顧客への売上高は28,229百万円と連結売上高の4割強を占めます。次いで開発製品関連が19,869百万円、エネルギー不動産関連が6,794百万円、スチールコード関連が4,750百万円、産業機械関連が4,451百万円です。地域別の売上高は日本が55,056百万円、中国が1,743百万円、その他が7,295百万円で、売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
