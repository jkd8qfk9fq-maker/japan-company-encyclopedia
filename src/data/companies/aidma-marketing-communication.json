  "businesses": [
    {
      "id": "integrated-sales-promotion",
      "name": "統合型販促支援事業",
      "shortName": "統合型販促支援",
      "description": "食品スーパーマーケットをはじめとする流通小売業に向けて、販売促進の企画・提案からデザイン、折込広告などの販促物の制作までをまとめて支える事業で、会社グループの唯一のセグメントです。有価証券報告書は、このサービスを「ARSS（Aidma Retail Support Systemの略称）」と呼んでいます。2026年3月期の売上高は4,761,878千円（前期比14.8％減）、営業利益は268,589千円（前期比25.3％減）でした。有価証券報告書は、物価の高騰で流通小売業が販売促進の費用を抑えたことと、リテールメディアなど広告の手段が広がって媒体が移ったことを、売上が減った主な理由に挙げています。単一セグメントなので、セグメント別の金額は書かれていません。",
      "products": [
        "マーケティングコンサルティング（マーケティングデータの分析、販売促進計画や広告コンセプトの企画・提案、競合店や競合市場の調査）",
        "デザイン制作・販促運営支援（折込広告、店舗内外のPOP広告、販促リーフレットなどのデザイン制作と、印刷・配布の手配）",
        "電子棚札・デジタルサイネージ・アプリを含むオールメディアプロモーション支援"
      ],
      "customers": [
        "株式会社バロー（有価証券報告書の主要な顧客に関する情報が、関連するセグメントに統合型販促支援事業を挙げる相手で、2026年3月期の売上高の25.9％）",
        "株式会社ライフコーポレーション（同じく主要な顧客で、2026年3月期の売上高の15.2％）"
      ],
      "children": [
        {
          "id": "marketing-consulting",
          "name": "マーケティングコンサルティング",
          "shortName": "マーケティング",
          "description": "クライアントごとの市場やエリアの特徴に合わせて、マーケティングデータの分析から販売促進の施策を立てるサービスです。有価証券報告書は、ビッグデータを集めて分析するだけでなく、流通小売業に詳しい社内の人材が、分析結果の読み解きから仮説づくりまでを担当すると書いています。具体的には、各種のマーケティングデータ・トレンドデータの収集と分析、セールスプロモーションのコンセプトや販売促進計画、広告対象商品の方針の企画・提案、競合店や競合市場の調査を挙げています。施策の立案・実行・評価・改善というPDCAサイクルを回すことが内容です。金額は独立して開示されていません。",
          "sourceIds": [
            "yuho-2026"
          ]
        },
        {
          "id": "design-production-support",
          "name": "デザイン制作・販促運営支援",
