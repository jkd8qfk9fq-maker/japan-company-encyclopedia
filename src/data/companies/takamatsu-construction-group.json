    {
      "year": 1965,
      "title": "株式会社髙松組を設立",
      "description": "株式会社髙松組を設立しました。",
      "significance": "法人としての出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "大阪証券取引所市場第二部に上場",
      "description": "大阪証券取引所市場第二部に上場し、公募増資を行いました。",
      "significance": "株式を公開し、成長の資金を集める道が開けました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "小松建設工業の株式を取得",
      "description": "小松建設工業（現 青木あすなろ建設）の株式を取得し、小松舗道も子会社にしました。",
      "significance": "土木分野に広がるきっかけになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "青木建設の株式を取得",
      "description": "青木建設の株式を取得し、青木マリーンを子会社にしました。",
      "significance": "海洋土木の力がグループに加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "青木あすなろ建設が発足",
      "description": "あすなろ建設と青木建設が合併し、青木あすなろ建設になりました。",
      "significance": "建築と土木の両方を営む中核の子会社が生まれました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "東京・大阪の市場第一部に指定",
      "description": "東京証券取引所と大阪証券取引所の市場第一部に指定されました。",
      "significance": "上場する市場の区分が上がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "金剛組の社寺建築事業を譲り受け",
      "description": "旧金剛組から社寺建築事業を全面的に譲り受け、新しい金剛組として始めました。",
      "significance": "社寺建築がグループの事業に加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "持株会社へ移行し商号を変更",
      "description": "吸収分割で持株会社に移り、建設事業を日本内装に引き継ぎました。当社は髙松コンストラクショングループに、日本内装は髙松建設に商号を変えました。",
      "significance": "今のグループ体制の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "米国に子会社を設立",
      "description": "米国ニューヨーク州にTakamatsu Construction Group USA,Inc.を設立しました。",
      "significance": "米国での不動産投資の拠点になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "青木あすなろ建設を完全子会社化",
      "description": "株式公開買付けと、その後の特別支配株主による売渡請求を経て、青木あすなろ建設を完全子会社にしました。",
      "significance": "グループの中核の一社を完全に傘下に収めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "大昭工業を子会社化",
      "description": "髙松建設が大昭工業の株式を取得し、同社とその子会社のTSKハウジングを子会社にしました。",
      "significance": "建築と不動産の事業の幅が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "東京証券取引所の市場区分の見直しで、市場第一部からプライム市場へ移りました。",
      "significance": "現在の上場区分です。",
