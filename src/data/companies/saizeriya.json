  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「世界中の人々においしくて健康的なイタリアの家庭料理を、店舗で便利に楽しく食べられるようにすること」をロマン（目指す姿）とし、「世の中の人にとってなくてはならない店舗を10,000店つくること」をビジョン（目標）に掲げています。対処すべき課題として、生産・物流・購買のグローバルな再構築、コミッサリー機能による店舗作業の削減、DXの推進、マレーシアやオーストラリアに続く海外の新規進出国の調査などを挙げています。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内の5工場に加え、オーストラリアと広州にも食材の製造拠点を持ち、原料の調達から輸送、倉庫、店舗までを一貫して管理する体制を取っていることが、手頃な価格と品質の両立を支える基盤になっています。",
        "basis": "【事業の内容】に国内5工場での食材製造と物流、豪州・広州の子会社での食材製造が印字され、【経営方針、経営環境及び対処すべき課題等】の対処すべき課題に「原料調達から、発注・輸送・受入・品質管理・倉庫・店舗までを一貫して管理し、安定供給と原価管理ができる体制づくり」と印字されている。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は日本で、アジアがこれに続きます。中国を中心にアジアの店舗数が増え、2025年にはベトナムにも進出するなど、海外の店舗網を広げています。",
        "basis": "セグメント注記に2025年8月期の外部顧客への売上高（日本172,908百万円、アジア83,802百万円、連結売上高256,714百万円）が印字され、【事業の内容】にアジア各地の店舗数が印字されている。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
