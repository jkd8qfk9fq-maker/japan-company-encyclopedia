  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "エネルギーに関連する事業の分野において、事業者や一般家庭を対象として、導入メリットが明確で取扱いが容易な商品をコンサルティング営業により販売し、メリットを享受した顧客に対してさらに導入メリットがある商品・サービスをクロスセルすることで、顧客満足度の向上と収益機会の拡大を実現してきたとしています。今後もエネルギー関連の商品・サービスのラインナップを拡充すること、コンサルティングによる提案力を強化することにより、顧客基盤の拡大と収益基盤の強化、他社との差別化を図り、企業ブランドの確立に努めるとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成は小売電気事業19,242百万円、エネルギーソリューション事業14,693百万円で、電力の小売が過半を占めます。経営方針では、契約により継続的に得られるストック収益の拡充が重要な課題とされ、系統用蓄電所は1基目の運用が始まっています。",
        "basis": "セグメント情報のセグメント別外部顧客への売上高、関連情報（主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（MD&A）の事業別の状況の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電子ブレーカーによる電力基本料金の削減コンサルティングから、太陽光発電システムや蓄電池、省エネ設備の販売、電力の小売まで、エネルギーコストの削減に関わる商品・サービスを一つのグループで扱い、既存顧客への追加提案（クロスセル）につなげる体制を持ちます。小売電気事業では、独自燃調の適用や市場価格連動型契約への集約、発電事業者との相対取引、デリバティブ取引の活用により、電力調達価格の変動リスクを抑える工夫がされています。",
        "basis": "事業の内容の各事業の説明、経営方針、経営環境及び対処すべき課題等の経営戦略等と優先的に対処すべき課題の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはエネルギーソリューション事業と小売電気事業の2区分で、売上高の10％以上を占める主要な顧客はなく、本邦の外部顧客への売上高が連結売上高の90％を超えています。エネルギー価格の上昇傾向や脱炭素への関心の高まりを背景に、電力コスト削減への需要が拡大している事業環境にあります。",
        "basis": "セグメント情報の報告セグメントの概要と外部顧客への売上高、関連情報（地域ごとの情報・主要な顧客ごとの情報）、経営方針、経営環境及び対処すべき課題等の経営環境の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
