  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、事業ドメインである「物流サービスを中心とした事業活動の改善サービスの提供」に経営資源を集中的に展開する集中戦略を採用し、物流現場の運用ノウハウと倉庫管理システム「クラウドトーマス」等のソフトウエア資産を収益の柱へ転換する高付加価値モデル（Tech・BPaaS）への構造転換を進める方針です。受注から出荷までのバックオフィス業務全体を自動化するBPaaS型サービスの展開、アセット・ライト経営への投資シフト、生成AI及び自動化ツールの活用によるAI・DXの推進、Ｍ＆Ａによる事業拡大に取り組むとしています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年２月期の売上高構成は、物流サービス事業が17,310百万円と全体の9割超を占め、ITオートメーション事業は884百万円にとどまります。会社が掲げるTech・BPaaSへの構造転換は、物流サービスで培ったノウハウとソフトウエアを収益化する方向性であり、ITオートメーション事業の規模の拡大がその進捗を測る目安になります。",
        "basis": "セグメント情報等（報告セグメントごとの売上高）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2000年頃のインターネット通販の黎明期から蓄積した配送センター運営のノウハウを持ち、その改善活動の成果を倉庫管理システム「クラウドトーマス」やチェックリストシステム「アニー」等の新しいサービスとして顧客に提供する循環が特徴です。自社開発のシステムに現場ノウハウを機能として搭載し、物流自動化機器と連携させることで品質維持・改善と作業の標準化を図っています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "EC市場の拡大基調が続く一方で成長率は鈍化傾向にあり、物流業界では人手不足や輸送能力の不足を背景に倉庫運営の省人化・自動化と物流業務のアウトソーシングへの需要が高まっています。2026年２月期の主要な顧客ごとの情報では、株式会社ライフドリンクカンパニー向けが売上高の18.4％を占めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等（経営環境）、セグメント情報等の【関連情報】（主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
