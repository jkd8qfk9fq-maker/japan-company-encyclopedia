  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2036年に迎える創業100年へのありたい姿を「エネルギーとデジタルの未来を創るグローバル・ソリューションカンパニー」とし、そのマイルストーンとして中期経営計画「Transformation for Growth SWCC 2030」を2026年度から開始しています。投下資本の効率を軸にした経営を高度化し、事業ポートフォリオ改革と成長投資による事業成長を進める方針です。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
