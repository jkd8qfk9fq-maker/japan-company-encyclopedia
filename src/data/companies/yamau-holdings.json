    "strategy": {
      "disclosed": {
        "text": "2035年を目標年度とする「ヤマウグループ長期VISION2035」を策定し、パーパスを「インフラ整備の総合ソリューションパートナーとして、サステナブルで安心・安全な社会の実現に貢献する」と再定義しています。2024年４月から2027年３月までを計画期間とする中期経営計画「Plan C³」を、長期ビジョン実現に向けた１st Stage「変革と創造への挑戦」期と位置付け、グループの構造改革と成長戦略に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "買収による事業の取り込みを重ねてきた会社で、2008年に光洋システム機器株式会社、2012年に開成工業株式会社、2015年に大栄開発株式会社、2020年に中外道路株式会社を子会社化し、情報機器、水門・堰、地質調査、橋梁用伸縮装置の各事業をグループに加えています。2021年には新設分割で株式会社ヤマウを設立し、持株会社体制へ移行しました。",
        "basis": "【沿革】の子会社化の履歴と【事業の内容】の事業構成に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力のコンクリート製品製造・販売事業は外部顧客への売上高12,167百万円と連結売上高の中心で、土木製品・景観製品・レジンコンクリート製品の幅広い製品群を製造・販売しています。水門・堰の製造・施工・保守、橋梁用伸縮装置、地質調査・コンサルタント、コンクリート構造物の点検・調査・補修まで、インフラ整備の周辺領域をグループ内の子会社で担う構成です。",
        "basis": "セグメント情報の外部顧客への売上高と【事業の内容】の製品・事業構成に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要市場である九州の経済については、国が進める防災・減災、国土強靭化のための予算が配分される一方、中・長期的には公共投資の縮減により漸減する方向であると会社は見ています。当社グループの2026年３月期の連結売上高は21,243百万円でした。",
        "basis": "MD&Aの経営環境の記述とセグメント情報の外部顧客への売上高に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
