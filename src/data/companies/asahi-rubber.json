  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年を見据えた「AR-2030 VISION」の実現に向けて、2026年4月から2031年3月までを期間とする第15次中期経営計画を策定し、「Beyond 2030」をテーマに、基本方針を「ウェルネスブランディングで持続的な成長を目指す」としています。モビリティ（自動車）、医療、スポーツ・健康、生活の各市場で「ウェルネス」をキーワードとする領域に注力し、OEMからODMへの提案力の強化、事業間の技術やノウハウの融合、外部とのアライアンスによるビジネスモデルづくりを進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "研究開発は技術本部と子会社の朝日ＦＲ研究所が行い、シリコーン素材技術に光学設計技術を応用したASA COLOR LENSが国際宇宙ステーションに採用されるなど、独自技術を生かした製品の採用実績を重ねています。スポーツ分野では卓球ラケット用ラバーの受注増加が続き、2026年3月期は過去最高の売上となりました。",
        "basis": "【研究開発活動】に、研究開発は技術本部および子会社である株式会社朝日ＦＲ研究所により行われ、ASA COLOR LENSについて国際宇宙ステーション（ISS）にも当社シリコーンレンズが採用されたと印字され、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、スポーツ分野は需要拡大により受注増加が続き通期で過去最高の売上を更新したと印字されているため。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は7,852百万円で前期比2.8％増となり、医療・衛生用ゴム事業は採血用・薬液混注用ゴム栓の好調などにより過去最高の売上高を達成しました。売上高の約4分の3を工業用ゴム事業が占めています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、連結売上高は78億５千２百万円（前期比2.8％増）、医療・衛生用ゴム事業は過去最高の売上高を達成したと印字され、セグメント情報に工業用ゴム事業の外部顧客への売上高5,947,011千円と医療・衛生用ゴム事業の1,905,080千円が印字されているため。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
