  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2022年１月に、2026年11月期を最終年度とする５ヶ年の新中期経営計画を策定し、安定的かつ持続的成長に向けて施策を実行しています。永年蓄積してきた3PLのノウハウを駆使して個々のお客さまのニーズに応えることを強みとし、お客さまの物品を保管するのみならず、物流に関する課題解決に向けて『物流コンシェルジュ』的な役割を担い、ソリューション提案を引き続き実行するとしています。経営理念として「お客さまに完全な業務を提供する」「社業の発展を通じて市民生活の向上に貢献する」「人間尊重の経営に徹する」を掲げ、お客さまに選ばれる物流カンパニーを目指すとしています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年11月期の売上高の内訳は、物流事業が4,260百万円と全体の約86％を占め、不動産事業が670百万円でした。物流事業では埼玉県所沢市の新規倉庫と千葉県八街市の新規文書保管センターが稼働し、不動産事業では2025年に取得した東京23区内の賃貸マンション２棟が安定稼働するなど、両事業で収益基盤の増強が進んでいます。",
        "basis": "報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の施策の記載に基づく",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "首都圏の営業所と仙台営業所による倉庫拠点を長年運営し、保管・荷役から連結子会社による東北地区の運送までをグループで担える体制を持つため、荷主の物流課題に一貫して対応できます。",
        "basis": "事業の内容、主要な設備の状況及び関係会社の状況の記載に基づく",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "物流業界では保管残高が前年を上回る水準で推移する傾向がみられる一方、人手不足や諸物価の高騰によるコスト上昇と競争の激化が続いているとされています。そのなかで当社は東京証券取引所スタンダード市場に上場し、物流と不動産の２事業を営んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境の記載に基づく",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
