  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度までの3年間を対象とする第9次中期経営計画を推進します。2030年度に向けた長期ビジョンでは「テクノロジーと現場力で、お客様の未来を創造するロジスティクスパートナー」を目指す姿とし、「売上の拡大」「事業競争力の強化」「企業基盤の変革」の3つの重点施策に取り組みます。2026年度の連結売上高1,620億円の達成を目指します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "物流の共同化や標準化を進める中で、独自の現場対応でお客様に貢献します。DXの取り組みで自社内の省力化を図るとともに、データを蓄積する仕組みを整備し、そのデータを利用した提案で、物流の効率化だけでなく、生産や販売の効率化、高付加価値化をグローバルに提供します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "貨物自動車運送から港湾運送、倉庫業、通関業、梱包業まで物流の一連の工程をグループで対応できる体制です。国内の拠点に加え、米国や中国、東南アジアなど海外にも子会社や関連会社を持ちます。",
        "basis": "【事業の内容】の事業系統の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "物流事業が2026年3月期の売上高の87.0％を占め、国内の物流を中心とする会社です。本邦の外部顧客への売上高が連結売上高の90％を超えます。",
        "basis": "【セグメント情報】の売上高の構成比と【関連情報】の地域ごとの情報",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【セグメント情報】"
      }
    }
