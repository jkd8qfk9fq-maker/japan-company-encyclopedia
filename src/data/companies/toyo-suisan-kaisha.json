  "history": [
    {
      "year": 1953,
      "title": "横須賀水産として設立",
      "description": "築地魚市場内に横須賀水産株式会社を設立し、冷凍鮪の輸出と国内水産物の取扱いを始めました。",
      "significance": "水産物の取引が、現在の東洋水産の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1956,
      "title": "東洋水産株式会社に商号変更",
      "description": "魚肉ハム・ソーセージの生産を始め、同じ年の7月に東洋水産株式会社へ商号を変更しました。1955年には川崎市に冷蔵庫を取得し、冷蔵庫事業も始めています。",
      "significance": "水産物の売買から、食品をつくる会社へ広がる一歩になりました。冷蔵庫事業は今の冷蔵事業につながります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "即席麺の生産を開始",
      "description": "即席麺の生産を始めました。1962年にはマルちゃんマークの使用も始めています。",
      "significance": "即席麺は、現在の売上の中心となる事業の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "東京証券取引所市場第二部に上場",
      "description": "東京証券取引所市場第二部に株式を上場しました。1973年には東京・大阪・名古屋の各取引所の市場第一部に指定替えとなっています。",
      "significance": "株式を公開し、全国の投資家に開かれた会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "米国にマルチャン,INC.を設立",
      "description": "米国カリフォルニア州にマルチャン,INC.を設立しました。現在は連結子会社です。",
      "significance": "米州での即席麺事業の拠点になり、今では最も売上高の大きい海外即席麺事業を担う会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1975,
      "title": "生麺の生産を開始",
      "description": "生麺の生産を始めました。",
      "significance": "即席麺に加え、生ラーメンなど低温食品の分野へ広がるきっかけになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "フクシマフーズを完全子会社化",
      "description": "上場子会社だったフクシマフーズ株式会社を、株式交換によって完全子会社にしました。",
      "significance": "加工食品の製造を担うグループ会社を、100%の子会社に組み込みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "株式会社シマヤを子会社化",
      "description": "山口県周南市の株式会社シマヤを子会社にしました。現在は連結子会社です。",
      "significance": "国内即席麺事業や加工食品事業を支える製造会社が、グループに加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "ブラジルにマルチャン・ド・ブラジルを設立",
      "description": "ブラジルのサンパウロ市にマルチャン・ド・ブラジルを設立しました。現在は連結子会社です。",
      "significance": "米国・メキシコに続き、南米にも海外即席麺事業の拠点が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。",
      "significance": "現在の上場区分は、このとき決まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
