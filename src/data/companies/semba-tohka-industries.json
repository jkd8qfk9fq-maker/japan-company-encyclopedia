  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として、すべてのステークホルダーからの信頼を拡大し、ブランド力を向上させることを掲げています。中長期の経営戦略では、自社商材拡販、グループ経営力強化、海外市場開拓を基本の柱とし、市場ニーズの発掘と自社商材の新製品の素早い投入で中期的な収益拡大を図るとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、全社を挙げて顧客ニーズに合わせた新製品・高付加価値製品の開発強化を進める一方で、海外戦略の見直しを実施し、売上高は前年同期比3.9％増となりました。",
        "basis": "セグメント情報の製品及びサービスごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "カラメル、粉末、造粒、凍結乾燥、冷凍まで幅広い加工技術を持ち、スプレードライ技術の研究所を本社内に置く点、真岡の生産拠点に加えてベトナムと中国の生産・販売拠点を持ち、グループ内で製造から包装加工まで担う点が特徴です。",
        "basis": "事業の内容、主要な設備の状況、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "食品業界では物価上昇の長期化で消費者の節約志向が強まり厳しい経営環境が続くなか、本邦の外部顧客への売上高が９割を超え、東洋水産株式会社への販売が総販売実績の14.5％を占めるなど、国内の大手得意先との取引に支えられた位置にあります。",
        "basis": "セグメント情報の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
