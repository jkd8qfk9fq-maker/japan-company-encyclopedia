  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "会社は、自動車販売と自動車リサイクルを通じ、部門や企業の壁を超えた連携で商品やサービスの付加価値を最大化する「バリューチェーンクロス・ミックスビジネス」の強化を掲げています。自動車販売関連事業では既存顧客へのアフターサービスの充実と、複合店舗による新規出店の推進を課題とし、自動車リサイクル事業では知名度の向上と全部再資源化の推進を掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、自動車販売関連事業の外部顧客への売上高が375億13百万円と前期を上回る一方、自動車リサイクル事業は14億24百万円と前期を下回りました。自動車販売関連事業の堅調さが自動車リサイクル事業の落ち込みを補う形になっており、販売を中心にリサイクルが続く構成です。",
        "basis": "セグメント情報の外部顧客への売上高と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の事業別の売上高の説明に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は、下取車と買取車を中古車デポックスで一元管理し、車の種類や状態に合わせて商品化すること、ホンダ車専門や全メーカー向けなど3つの中古車業態とリサイクルセンターを持つことで市場価値が低い車両も買い取れること、複合商業施設オートモールを7箇所で展開して集客力の向上と新規出店費用の抑制を図ることを、自動車販売関連事業の特徴として挙げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "新車販売で得た下取車を中古車販売とリサイクルにつなげる流れがグループ内にあり、1台の車が販売から買取、再販や解体までグループ内で循環する構成になっています。店舗も単独ではなく複合施設で組み合わせる形が採られています。",
        "basis": "【事業の内容】の自動車販売関連事業の特徴と中古車デポックスの説明、複合商業施設オートモールの展開箇所の印字に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは自動車販売関連事業と自動車リサイクル事業の2つで、2026年3月期の外部顧客への売上高は自動車販売関連事業が375億13百万円、自動車リサイクル事業が14億24百万円です。売上高の10％以上を占める主要な顧客はないとされています。事業は主に三重県内で展開されています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（主要な顧客ごとの情報）、【事業の内容】の店舗展開地域の印字に基づきます。",
        "asOf": "2026-06-19",
