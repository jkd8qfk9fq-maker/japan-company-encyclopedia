  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「安心・安全・癒し・環境」をテーマに暮らしを提案し、100年以上続く企業を目指しています。中期経営計画（2026年9月期から2028年9月期）の戦略テーマは「管理拡大」「仲介拡大」「財務体質の強化」の3つで、達成状況を判断する指標として管理物件数と仲介件数を重視しています。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "賃貸仲介の基幹システム「バストレージ」を使うことで未経験者が短期間で戦力化でき、新規店舗もネットワーク接続で速やかに立ち上げられます。管理物件の入居者のうち約9割が自社の仲介によるもので、この仲介力が管理物件の高い入居率を支えています。",
        "basis": "【事業の内容】に、基幹システムとして賃貸仲介システム（バストレージ等）を駆使することにより未経験者が短期間で戦力化でき、新規店舗の出店に際しても速やかな店舗立上げが可能になっていることが印字されている。また、管理物件の入居率は直近2連結会計年度において95％以上の水準を維持しており、自社管理物件の入居者のうち約9割が株式会社エリッツの仲介によるものであることが印字されている。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "不動産仲介事業が連結売上高の約半分を占める主力事業です。京都・滋賀を基盤に近畿圏で賃貸仲介店舗を68店舗展開し、管理戸数は28,685戸まで拡大しています。",
        "basis": "【セグメント情報等】に、2025年9月期の外部顧客への売上高は不動産仲介事業3,311百万円、不動産管理事業2,307百万円、居住者サポート事業767百万円、連結売上高6,385百万円が印字されている。【事業の内容】に、株式会社エリッツの営業店舗数は2025年9月期に68店舗、管理戸数は28,685戸であることが印字されている。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
