  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「次代の生活品質を高める 事業の創造者として 人びとの幸せを実現する」のもと、2031年の創立100周年を見据え、長期ビジョン「創造と刷新を続ける類いなき事業創造型商社」の実現を掲げています。中期経営計画“GSI CONNECT Phase2”（2025-2027）では、資本コスト経営の実践、グループ基盤強化・協働推進、ESG経営の推進の3つの重点施策を進めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "繊維事業と工業製品事業をあわせ持つ商社で、国内9拠点と海外27拠点で事業を展開しています。ファイバー事業が売上高の最大の区分で、香港の現地法人は連結売上高の10%超を占めています。",
        "basis": "【事業の内容】、【セグメント情報】及び【関係会社の状況】の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は188,677百万円で、地域別ではアジアが119,614百万円、日本が57,721百万円でした。主要な顧客はToray Industries (HK) Ltd.とPacific Textiles Limitedです。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
