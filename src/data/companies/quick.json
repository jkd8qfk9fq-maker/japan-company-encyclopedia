  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力事業である人材サービス事業の一層の強化を図り、人材紹介の旗艦サイト「アンドプロ」のリリースにより中長期的な事業成長の基盤作りに着手するとしています。海外事業では拠点体制を強化し、国際間の転職支援（クロスボーダーリクルートメント®）を進めて「世界の人事部®」構想の実現を目指すとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約7割を占める人材サービス事業を中核に、求人広告を扱うリクルーティング事業、北陸の地域情報サービス事業、人事ポータルを運営するHRプラットフォーム事業、7か国で展開する海外事業を組み合わせ、採用に関する顧客企業の課題を複数の経路で解決する体制を取っています。",
        "basis": "セグメント情報のセグメント別売上高、事業の内容の各セグメントの説明、MD&Aの経営成績の状況の概要",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "登録型人材バンクとしての転職希望登録者の獲得ノウハウと独自の営業網をグループの事業資産とし、建設・不動産、IT分野、製造業、看護師といった注力領域に専門性を持っています。人材紹介と人材派遣の双方の許可を持ち、紹介予定派遣まで一体で提供できることも特徴です。",
        "basis": "経営方針の目標とする経営指標（登録者獲得ノウハウと営業網の記述）、事業の内容の人材サービスの説明、経営方針の優先的に対処すべき課題（注力領域の記述）",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "本邦の外部顧客への売上高が連結売上高の90％を超える国内中心の構成で、構造的な人手不足を背景に企業の採用ニーズが旺盛な市場で事業を展開しています。海外では米国・英国で人材紹介と人材派遣、メキシコ・ベトナム・タイ・ドイツで人材紹介と人事労務コンサルティング、オランダで人材紹介を行い、日系企業を中心にサービスを提供しています。",
        "basis": "セグメント情報の地域ごとの情報（本邦が90％超のため省略の旨）、事業の内容の海外事業の説明、MD&Aの経営成績の状況の概要（雇用情勢の記述）",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
