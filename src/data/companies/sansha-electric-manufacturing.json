  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「パワーエレクトロニクスと創造力で、社会を前進させる。」のもと、中期経営計画「ＣＦ26」に基づき、商品開発の推進、販売力の強化、サービス体制の充実に取り組みます。中期のありたい姿として「Global Power Solution Partner」を掲げ、パワーエレクトロニクス関連技術を磨き、顧客の課題解決を通じて持続可能なクリーンエネルギー社会の実現への貢献を目指します。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高26,651百万円のうち、電源機器事業が20,283百万円と全体の約4分の3を占め、半導体事業は6,368百万円です。地域別では日本が19,943百万円、中国が3,593百万円、その他が2,437百万円、北米が677百万円で、日本向けの販売が中心です。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1933年の創業以来パワーエレクトロニクスの技術を培い、パワー半導体から小型のカスタム電源、大型の電源機器までを自社で開発・製造する品ぞろえを持ちます。製品の販売に加えて、据付・試運転から修理、保守、施工請負までをグループ内で担うサービス体制も備えています。",
        "basis": "事業の内容の事業構成と、経営方針に記載された技術の蓄積・製品群に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "経営方針では、創業以来の強みであるパワーエレクトロニクス関連技術を世界トップレベルまで磨くことを中期のありたい姿に掲げています。市場シェアや業界での順位は開示されていません。",
        "basis": "経営方針、経営環境及び対処すべき課題等の中期のありたい姿に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
