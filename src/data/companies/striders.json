    "strategy": {
      "disclosed": {
        "text": "企業理念として「挑戦する個人・企業を応援し、すべてのステークホルダーと感動体験を共有し、より良い世界を創造する」ことを掲げ、コーポレートスローガンに「Stride with Challengers（挑戦者達と共に闊歩する）」を掲げています。不動産事業は「豊かな居住空間の実現」、ホテル事業は「地域創生・地域活性化」、投資事業は「アジアの投資家・スタートアップとの連携」を重要テーマとし、当社が日本とアジアをつなぐゲートウェイとしての役割を担うとしています。前期に実施した事業ポートフォリオの見直しを経て、不動産、ホテル、投資の3事業を中核とする事業会社体制へ移行し、各事業の収益基盤の強化とグループ全体としての戦略的な連携を推進するとしています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、価格体系の見直しや業務の効率化に加え、人材投資およびAI活用の推進を通じて収益力の強化を図ったとしています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における記載に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "不動産事業の中核子会社である株式会社トラストアドバイザーズは、売上高が連結売上高の10％を超える主要な連結子会社であり、賃貸管理と建物管理、不動産売買を一体で手がけています。ホテル事業は、成田空港エリアと倉敷美観地区という観光資源のある立地でホテルを運営しています。",
        "basis": "関係会社の状況及び経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における記載に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高では、不動産事業が6,839百万円と連結売上高8,213百万円の8割超を占め、ホテル事業が1,310百万円、投資事業が61百万円となっています。",
        "basis": "セグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
