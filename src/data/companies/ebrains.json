  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "バックプレーンをコアに、ボードコンピュータや周辺デバイスを含めたユニット供給を中心に受託範囲を拡げ、事業ドメインの拡大を目指すとしています。新製品の開発とバリエーションの拡充、コストダウン、DX・5G・IoT等への対応、放熱技術の研究、中国子会社の活用、既存顧客との関係強化と新規顧客の開拓を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "バックプレーンの専業メーカーとして、顧客仕様に合わせたカスタム設計と、自社で設計・開発したプレスフィットマシンや検査装置を使う生産体制が強みです。新規格に準拠したバックプレーンの商品化を早期に進め、高品質なバックプレーンを短納期で提供してきたことが評価につながっていると会社は判断しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、新規格に準拠したバックプレーンの商品化の早期推進と自社製プレスフィットマシンによる短納期の提供が印字されています。【事業の内容】に、カスタム製品の販売が中心であることと、自動組立装置と検査装置を自社で設計・開発して生産に使用していることが印字されています。",
        "asOf": "2026-06-25",
