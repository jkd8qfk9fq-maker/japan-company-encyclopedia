  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業ミッション「Empower the Patients」のもと、PHRプラットフォームサービス事業とデータポータビリティプラットフォームサービス事業に経営資源を集中するとしています。各疾患領域でのサービスメニューを拡充し、まだアプローチできていない疾患領域への提案活動を推進する方針です。",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "各疾患別アプリの合計ダウンロード数は、2025年12月末時点で約123万回に達しています。Welbyマイカルテのユーザーが登録したかかりつけ医療機関は33,010施設あり、政府が運営するマイナポータルと連携して予防接種歴や薬剤情報、特定健診情報を取得・閲覧できることも特徴です。",
        "basis": "【事業の内容】及び【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、アプリの合計ダウンロード数が2025年12月末時点で約123万回である旨、ユーザーが登録したかかりつけ医療機関が33,010施設である旨、マイナポータルに接続して予防接種歴、薬剤情報及び特定健診情報の取得・閲覧が可能となった旨が印字されていることに基づきます。",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "超高齢社会を迎え、慢性疾患の増加や医療資源の不足を背景に、PHRを活用した患者の自己管理や遠隔モニタリングの必要性が高まる事業環境にあります。同社はPHRサービス事業協会に参画し、執行役を務めています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、超高齢社会や医療制度改革、医療資源の不足を背景にPHRサービスが社会的課題の解決策の一つとして認識されている旨と、PHRサービス事業協会に執行役として参画している旨が印字されていることに基づきます。",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
