  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「人々のライフスタイルを変革する」を掲げ、通販支援事業では自社開発商品の販売を行って売上高に占める自社商品の割合を高め、ストック型収益を積み上げることで業績の安定化を目指すとしています。通信販売事業では、大学教授との顧問契約を通じてアカモクの可能性を追求し、養殖の可能性を含めた販路の拡大や、第一次産業の振興、地方創生につなげることを成長戦略としています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "通販支援事業で長年蓄積した、どのような商品をどのような人にいくらで販売すれば売れるかという知見を持ち、月間約150万コールの架電を行うコールセンターでは全ての音声を記録して品質を管理しています。また、全国14,394店舗と契約する設置網を持ち、アカモクについては食品加工会社を通じて生産者と関係を築き、安定して仕入・製造・販売できる体制を持っています。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の内訳は、通販支援事業が1,947百万円と全体の約4分の3を占め、通信販売事業が683百万円です。通信販売を行う企業を支援する事業と、自ら通信販売を行う事業の両方を手がけている点が特徴です。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
