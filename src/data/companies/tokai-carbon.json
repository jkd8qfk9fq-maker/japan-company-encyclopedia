  "history": [
    {
      "year": 1918,
      "title": "東海電極製造として創立",
      "description": "黒鉛電極をはじめとする炭素製品を国内でつくれるようにすることを目的に、東海電極製造株式会社の名前で創立されました。",
      "significance": "黒鉛電極事業とファインカーボン事業の出発点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1941,
      "title": "カーボンブラックの製造を開始",
      "description": "九州若松工場でカーボンブラックの製造を始めました。",
      "significance": "現在、売上高が最も大きいカーボンブラック事業の始まりです。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京・大阪・名古屋の証券取引所に上場",
      "description": "東京、大阪、名古屋の各証券取引所に株式を上場しました。大阪と名古屋は2003年10月に上場を廃止しています。",
      "significance": "株式を公開する会社になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1975,
      "title": "東海カーボンに社名変更",
      "description": "商号を東海カーボン株式会社に変更しました。",
      "significance": "電極にとどまらない炭素製品の会社としての社名になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1983,
      "title": "等方性黒鉛材の生産技術を確立",
      "description": "田ノ浦工場で等方性黒鉛材の生産技術を確立しました。",
      "significance": "ファインカーボン事業の技術の土台になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1992,
      "title": "東洋カーボンと合併",
      "description": "東洋カーボン株式会社と合併し、滋賀工場、山梨工場、茅ヶ崎第二工場が加わりました。黒鉛電極とファインカーボンの事業が広がり、摩擦材事業も得ました。",
      "significance": "現在のその他事業の摩擦材につながる合併です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "カナダのカーボンブラック会社を子会社化",
      "description": "カナダのカーボンブラック製造販売会社Cancarb Limitedの全持分を取得し、完全子会社にしました。",
      "significance": "カーボンブラック事業の海外拠点が増えました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "米国の黒鉛電極会社を取得",
      "description": "黒鉛電極の製造販売会社であるSGL GEの米国子会社の株式を取得して完全子会社にし、社名をTOKAI CARBON GE LLCとしました。アジア・北米・欧州の3極体制になりました。",
      "significance": "黒鉛電極事業が世界3地域に拠点を持つようになりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "米国のカーボンブラック会社を取得",
      "description": "米国のカーボンブラック製造販売会社Sid Richardson Carbon, Ltd.（現Tokai Carbon CB Ltd.）と、そのグループ会社の全持分を取得し、完全子会社にしました。",
      "significance": "米国でのカーボンブラックの生産を手に入れました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "ドイツのCOBEXグループを取得",
      "description": "ドイツの炭素黒鉛製品グループであるCOBEX HoldCo GmbHと、そのグループ会社の全株式を取得して完全子会社にしました。これによりスメルティング＆ライニング事業を得ました。",
      "significance": "アルミ電解用カソードなどを扱う現在の事業が加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "フランスの炭素黒鉛製品メーカーを取得",
      "description": "フランスの炭素黒鉛製品メーカーCarbone Savoie SAS（現Tokai COBEX Savoie SAS）の持株会社の全株式を、Tokai COBEX GmbHと共同で取得しました。",
      "significance": "スメルティング＆ライニング事業の欧州の拠点が増えました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移りました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "米国の黒鉛加工会社2社を連結子会社化",
      "description": "Tokai Carbon U.S.A., Inc.を通じて、持分法適用会社MWI, Inc.の株式の59.8％を持つKBR, Inc.の全株式を取得し、KBR, Inc.とMWI, Inc.を連結子会社にしました。",
      "significance": "ファインカーボン事業の米国での加工体制が強まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "黒鉛電極の生産体制を再構築",
      "description": "黒鉛電極の生産体制を見直し、滋賀工場の生産を中止しました。6月にTOKAI ERFTCARBON GmbHの全出資持分をドイツのLenbach Equity Opportunities III. GmbH & Co. KGに譲渡しました。",
      "significance": "黒鉛電極事業の構造改革として行われました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "タイのカーボンブラック会社を取得",
      "description": "9月に、株式会社ブリヂストンと旭カーボン株式会社が持っていたBRIDGESTONE CARBON BLACK(THAILAND) CO.,LTD.の全株式を、連結子会社のTHAI TOKAI CARBON PRODUCT COMPANY LIMITEDと共同で取得して子会社にしました。社名はThai Tokai Carbon Product Rojana Co., Ltd.に変わりました。",
      "significance": "主力のカーボンブラック事業のタイでの生産拠点が増えました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
