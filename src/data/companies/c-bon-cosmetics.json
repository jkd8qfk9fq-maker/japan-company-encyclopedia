  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年3月期からスタートした中期経営計画の最終年度にあたる2026年3月期は、「美しさを共に奏でる」というビジョンのもと、「製品価値向上」「サロン価値向上」「新しい価値の創造」の3つの重点課題に取り組み、売上高の向上と顧客層の拡大に努めています。新しい価値の創造では、ヘア事業の拡大、海外販路の拡大、子会社の再拡大に注力しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社の工場で製造した化粧品を、自社の会員制サロンでカウンセリングしながら販売し、購入後もフェイシャルサービスを続ける一体の体制が特徴です。顧客一人ひとりの肌の状態を継続して確認できるため、その状態に合わせたスキンケアの提案ができます。",
        "basis": "【事業の内容】に、生産センターで製造した製品を通信販売及び会員制のフェイシャリストサロンで販売し、化粧品を購入した会員に対して肌の状態を確認し、カウンセリングに基づくスキンケアアドバイスとフェイシャルサービス等の各種アフターサービスを提供していることが印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "化粧品市場が回復する一方でブランド間の競争が激しくなる中、直営店舗事業を主力に据え、会員向けのアフターサービスで既存顧客との関係を保ちながら、新規顧客の獲得にも取り組む化粧品メーカーです。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、化粧品業界は外出機会の増加やインバウンド需要の回復により市場全体が活性化しているものの、ブランド間の競争は一段と激しさを増していること、主力事業である直営店舗事業の売上高は増加傾向となったことが印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
