  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "医局向けサービスの拡充、地方へのビジネスの拡大、グループ共有プラットフォームの活用を方針とし、医師会員登録数と医療機関登録数の増加、知名度・認知度の向上に取り組むとしています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "自治体と連携した地域医療の取り組みやベトナムでの医療人材プラットフォームの始動など、国内の医師紹介の枠を超えた展開が進んでいることが読み取れます。",
        "basis": "経営者による分析に、広島県福山市および和歌山県との連携の継続、徳島県でのコメディカル人材も対象とする「医療版ワーケーション」の展開、ベトナムでの資本業務提携の締結と現地の医療人材プラットフォーム「MRT HUB」の本格始動が記載されていることによる。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "医師の互助組織を母体として蓄積した医療分野の人材ネットワークと、免許確認を含む厳格な医師会員の管理が強みになっています。",
        "basis": "【事業の内容】に、設立経緯と業務経験・ノウハウの蓄積により確立した医療分野の人材ネットワークを強みとして事業基盤を確立していること、医師会員登録の際に医師免許を証する公的書類や経歴書の提出を義務付けていることが記載されていることによる。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "医師不足と地域偏在が続く中で、非常勤医師への需要が大きい市場に位置しています。",
        "basis": "【事業の内容】に、厚生労働省の調査で非常勤医師が医療機関に勤務する医師の18.3％を占めたこと（2010年６月１日時点）、医師の地域偏在や診療科目の偏りにより非常勤医師によるサポートが必要不可欠とされていることが記載されていることによる。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
