  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業100周年を迎える2032年3月期をターゲットとして連結売上高500億円以上を掲げ、中長期的な会社の経営戦略として「国内収益基盤の強化」、「海外収益基盤の強化」、「事業運営基盤の強化」の3つの方針を柱とする施策に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "3つの方針は、国内と海外の収益基盤をそれぞれ強化し、それを事業運営基盤の強化で支える構成になっています。当期は、海外事業における経営資源の選択と集中として、中国の連結子会社2社の全出資持分の譲渡を完了し、両社を連結範囲から除外しました。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中長期的な会社の経営戦略の記載、及び【重要な契約等】の持分譲渡契約と企業結合等関係の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "合成樹脂による漆器開発や紡績機器部品のプラスチックス化以来、成形と金型の技術を積み重ねてきました。研究開発では、独創的な成形・加工技術や差別化技術を強みとして、次世代自動車分野に加え航空機分野及び医療分野への進出に向けた開発を進めています。熱可塑性スーパーエンプラ複合材による航空機構造部品の量産化技術では、助成事業に採択され実証開発に取り組んでいます。",
        "basis": "【沿革】の合成樹脂開発と紡績機器部品のプラスチックス化の記載、及び【研究開発活動】の成形・加工技術と助成事業採択の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは、生産・販売体制を基礎とした地域別の日本、中国、東南アジアの3つです。2026年3月期の外部顧客への売上高は日本23,084百万円、東南アジア12,392百万円、中国6,000百万円でした。製品分野では車両分野が中心で、主要な顧客として本田技研工業株式会社が日本セグメントで開示されています。",
        "basis": "セグメント情報の報告セグメントの概要と外部顧客への売上高、及び主要な顧客ごとの情報の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
