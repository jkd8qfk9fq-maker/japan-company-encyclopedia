  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "人々に共感を持たれる新しい価値を創造し提供することにより、社会からその存在を認められ期待される「計測・制御のリーディングカンパニー」を目指す姿として掲げています。計測制御デバイス関連、電源パワー制御関連、環境エネルギー関連の3事業を柱として、独創技術を核とした競争力の高い製品を提供することで、設備投資の影響を受けにくいビジネスモデルの構築を目指しています。あわせて、国産量子コンピュータ関連製品の開発などの将来投資や、トータルソリューション営業体制の確立に取り組んでいます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期には、微小信号計測やインピーダンス計測の技術を応用した医用計測への領域拡大や、大電力変換技術を活かした産業用蓄電システムの体制強化など、既存の技術を新しい市場へ広げる取り組みが進められています。家庭用蓄電システムの事業整理の一方で、産業用蓄電システムや水素等の再生可能エネルギー活用市場に向けた事業再編が進められています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における当期の取り組みの記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "創業以来培ってきた独創技術を核として、特色のある製品を提供することによって、エレクトロニクス産業の発展とこれを通じた社会への貢献を目標に掲げています。家電、自動車、航空宇宙から電力などの社会インフラにいたる幅広い産業分野を対象に事業を展開しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "中核子会社の株式会社エヌエフ回路設計ブロックが開発、製造、販売を担い、山口県の子会社が電子デバイスや半製品の製造と機器の製造を担い、専門子会社が校正・修理を行うなど、開発から製造、販売、アフターサービスまでをグループ内で担う体制になっています。",
        "basis": "【事業の内容】および【関係会社の状況】における各子会社の役割の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
