  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年6月期から2028年6月期までを対象とする「ユビテック新３か年計画」を策定し、この３か年を自社SaaSサービスの成長期と位置づけています。基本方針として、インターロックシステムの早期拡販によるD-Driveの基幹事業への成長、社会ニーズに即したWork Mateの安定成長、自社サービス蓄積データの活用による第３軸の創出などを掲げています。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点事業と位置づけるD-DriveとWork MateはいずれもIoT事業に属し、IoT事業は2026年6月期の売上高の約8割を占める最大の事業であるため、経営方針は現在の売上構成の中心と重なっています。D-Driveの販売拡大に向けては、パートナー企業であるオリックス自動車との協業体制の深化を課題に挙げています。",
        "basis": "経営方針に新３か年計画の基本方針と、対処すべき課題としてオリックス自動車との協業体制の深化が印字されていることと、セグメント情報でIoT事業の外部顧客への売上高が1,024百万円と3事業の中で最大であること。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "車載機などのハードウェアとクラウドサービスを一体で提供できる体制を持ち、D-DriveとWork Mateを通じて蓄積したデータを新たなサービスに活用する取り組みを進めています。Work Mateの熱中症予兆検知機能については特許を取得しており、機能面の裏付けがあります。",
        "basis": "セグメント情報にハードウェア、ソフトウェア及びネットワークを融合したソリューションの提供と印字されていることと、沿革に2025年の熱中症予兆検知機能搭載技術の特許取得が印字されていること。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
