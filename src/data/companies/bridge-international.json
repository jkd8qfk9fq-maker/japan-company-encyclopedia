  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "B2B企業の売上成長に向けた改革を支援するEnd to Endのサービスを提供することを経営方針とし、対処すべき課題として、既存顧客との取引拡大と新規顧客の獲得による収益基盤の拡大、安定的な人材確保、ITネットワークの安全性確保、グループガバナンスの強化を挙げています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上構成はインサイドセールスアウトソーシング事業が4,630百万円と過半を占め、研修事業が2,381百万円、プロセス・テクノロジー事業が1,552百万円で、営業活動の代行を中核に、仕組みづくりと人材育成を組み合わせた構成であることが読み取れます。",
        "basis": "セグメント情報に、2025年12月期の外部顧客への売上高としてインサイドセールスアウトソーシング事業4,630,487千円、研修事業2,381,638千円、プロセス・テクノロジー事業1,552,745千円、合計8,564,871千円が印字されていること。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "2002年からインサイドセールスアウトソーシングを提供し、日本の営業慣行に合わせた標準モデルを確立してきたことや、インサイドセールスを担う人材が500名超在籍することを強みとして挙げています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "インサイドセールスアウトソーシング事業は既存顧客からの売上が9割以上を占めると印字されており、月額定額の業務委託が数年にわたり継続する取引構造であることが読み取れます。",
        "basis": "事業の内容に、サービスは月額定額で提供し、取引先との取引は数年にわたる継続がほとんどで、売上の9割以上は既存顧客が占める安定したストックビジネスであると印字されていること。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
