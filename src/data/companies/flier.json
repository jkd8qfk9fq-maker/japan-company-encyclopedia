  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "AI時代に求められる能力を獲得するためのサービスとして「flier business」を継続強化し、生成AI活用支援・組織開発支援を通じて統合的な人材育成プラットフォームを目指すとしています。生成AI等の活用支援事業を新たな成長の柱に据え、M&A等を積極活用する形で事業領域の拡大を進める方針です。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "全ての要約コンテンツは出版社や著者等の許諾を得て作成し、作成した原稿も出版社等に確認してもらっています。累計会員数130万人（2026年2月末時点）や提携出版社数190社超、4,200冊超の要約コンテンツといった資産が相互に作用して蓄積されることが強みとされています。エンタープライズ事業の解約率の指標は2024年3月から2025年2月までの平均で1.45％と低く抑えられています。",
        "basis": "【事業の内容】の要約作成の流れと強みの記載に基づきます。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "企業のDX推進や人的資本経営への関心の高まりと生成AI技術の進化・普及を背景に、SaaS市場およびAI関連市場の成長が継続している環境にあります。リスキリング需要の高まりにより、デジタル人材支援サービス市場は2026年度に約1.7兆円規模への拡大が予測されるとされています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記載に基づきます。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
