  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "MDM市場における成長機会に加えて、PCや業務専用端末を含むエンドポイント管理市場へ事業領域を拡大し、医療機関や官公庁など各市場に特化したアプローチを推進する方針です。OEM提供先である株式会社NTTドコモとの連携を強化し、連結子会社のワンビ株式会社が開発・提供するWindows PC向けセキュリティサービスのクロスセルを本格的に推進することで、モバイル端末とPCの統合管理ニーズへの対応を進める方針です。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ソフトウェアの開発、ライセンス販売、サービス運用、プラットフォーム管理、カスタマーサポートの全てを自社で一貫してコントロールする体制を持ち、運用やサポートで得た知見や顧客の要望を新たな開発や改善に迅速に反映させることができます。iOSデバイスの管理・活用に強みを持ち、AndroidではGoogleのパートナープログラムでGold Partnerとして認定されるなど、複数のOSへの対応力を備えています。",
        "basis": "【事業の内容】に、開発からカスタマーサポートまでを自社で一貫してコントロールする統合的な体制が強みである旨、運用やサポートで得た知見や顧客からの要望を新たなソフトウェア開発や改善に迅速に反映できる旨、Appleの各プログラムへの対応とAndroid Enterprise Partner ProgramにおけるGold Partner認定が印字されていることに基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "CLOMOサービスは、MDM市場（自社ブランド）において2011年度から15年連続でシェアNo.１を達成しており、2026年６月には医療分野及び官公庁などの公共分野においてもシェアNo.１を獲得しました。政府情報システムのためのセキュリティ評価制度（ISMAP）に登録されたサービスとして、政府が求めるセキュリティ水準を満たしています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、MDM市場（自社ブランド）シェアにおいて2011年度から15年連続でシェアNo.１を達成した旨、医療分野及び官公庁などの公共分野においてシェアNo.１を獲得した旨、CLOMOサービスがISMAPに登録された旨が印字されていることに基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
