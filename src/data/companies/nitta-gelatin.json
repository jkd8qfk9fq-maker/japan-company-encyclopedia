  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年11月に新たな長期経営構想を策定し、未利用資源と副産物を価値あるものに変えるアップサイクリングを存在意義として掲げました。ありたい姿は、ゼラチン・コラーゲン業界における売上高アジアNo.1を目指し世界に挑戦することとし、2033年3月期に売上高800億円を目指しています。基本戦略として競争力の強化、グローバル化の加速、新規事業への挑戦を進め、インドでは2027年7月の稼働に向けてゼラチンの生産能力の増強を進めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1918年に始めたゼラチン製造の蓄積を基盤に、ゼラチンからコラーゲンペプチド、食品材料、医療用素材までを一つのグループで手がけています。インドでは牛ゼラチンやコラーゲンペプチド、カナダでは豚ゼラチンというように、原料や製品に合わせた生産拠点を各国に持ち、研究開発・製造棟「みらい館」に各分野の研究者を集めて素材開発を進める体制が特長です。",
        "basis": "事業の内容における製品区分と主な担い手、関係会社の状況における各拠点の事業内容、研究開発活動における「みらい館」の記述に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "コラーゲン事業の単一セグメントで、製品区分別ではゼラチンが売上高27,410百万円と最も大きく、コラーゲンペプチド7,265百万円、食品材料3,002百万円、バイオメディカル369百万円と続いています。地域別では日本が19,413百万円と最大で、米国6,972百万円、インド6,249百万円、アジア3,000百万円、カナダ1,986百万円、その他426百万円です。売上高の10％以上を占める特定の顧客はありません。",
        "basis": "収益認識関係における製品区分別の売上高、セグメント関連情報における地域ごとの売上高と主要な顧客ごとの情報、経営成績等の状況の概要における製品区分別の販売概況に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
