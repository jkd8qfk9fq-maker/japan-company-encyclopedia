  "history": [
    {
      "year": 1954,
      "title": "京都で東洋電具製作所を創業し、抵抗器の開発・販売を開始",
      "description": "1954年12月、創業者の故佐藤研一郎が京都市上京区において個人企業として東洋電具製作所を創業し、炭素皮膜固定抵抗器の開発・販売を始めました。1958年9月に資本金2,000千円で㈱東洋電具製作所を設立しています。",
      "significance": "抵抗器から始まった会社です。抵抗器は現在も「その他」セグメントの製品として残っており、2026年3月期にも厚膜シャント抵抗器の新製品を開発しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1961,
      "title": "京都市右京区西院溝崎町に本社を移転",
      "description": "1959年9月に京都市右京区西院溝崎町21番地に西大路工場を建設し、1961年9月に同じ住所へ本社を移転しました。1966年8月には岡山県に製造会社「ワコー電器㈱」を設立し、以後国内各地に製造拠点を設けています。",
      "significance": "京都市右京区西院溝崎町21番地は現在の本店所在地です。本社には開発・製造・管理部門が置かれ、2026年3月31日現在で2,298人が働いています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1969,
      "title": "ＩＣの開発・販売を開始",
      "description": "1969年3月、ＩＣの開発・販売を始めました。1982年6月に半導体研究センター、1989年8月にＬＳＩ研究センター、1998年6月にＶＬＳＩ研究センターを開設しています。",
      "significance": "抵抗器のメーカーから半導体へ広がる出発点です。現在、最も売上高が大きい報告セグメントは、アナログ・ロジック・メモリ等をつくる「ＬＳＩ」です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1970,
      "title": "米国に販売会社を設立し、海外へ出る",
      "description": "1970年8月、米国カリフォルニア州に販売会社「ROHM CORPORATION」を設立しました。以後、世界各地に開発・製造・販売拠点を設けています。",
      "significance": "現在の子会社36社のうち29社が海外にあります。2026年3月期の売上高4,811億48百万円のうち、日本の顧客向けは1,451億44百万円で、残りは中国とその他の地域の顧客向けです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1981,
      "title": "商号を「ローム株式会社」に変更",
      "description": "1979年8月に商標をＲ．ｏｈｍ（アール・オーム）からＲＯＨＭ（ローム）に変更し、1981年9月に商号を㈱東洋電具製作所からローム㈱に変更しました。",
      "significance": "現在の商号です。英訳名はROHM COMPANY LIMITEDです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1989,
      "title": "東京証券取引所市場第一部に上場",
      "description": "1983年11月に大阪証券取引所市場第二部へ上場し、1986年9月に同第一部へ指定されたのち、1989年1月に東京証券取引所市場第一部に上場しました。",
      "significance": "2022年4月の東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行し、現在もプライム市場に上場しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2008,
      "title": "沖電気の半導体事業部門とドイツのサイクリスタル社を買収し、ＳｉＣへ進む",
      "description": "2008年10月に沖電気工業㈱から半導体事業部門を買収し、2009年7月にはシリコンカーバイド（ＳｉＣ）ウェハを製造するドイツのサイクリスタル社（現SiCrystal GmbH）を買収しました。2010年4月には、次世代の高効率半導体デバイスであるシリコンカーバイド製ショットキーバリアダイオードを開発して販売を始めています。",
      "significance": "サイクリスタル・ゲーエムベーハーは現在も連結子会社で、ローム取扱製品の原材料を製造しています。ＳｉＣパワーデバイスは現在の「半導体素子」セグメントの柱のひとつであり、同時に2026年3月期に1,936億円の減損損失を生んだ事業でもあります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2026,
      "title": "国内の製造子会社を前工程・後工程の2社に再編",
      "description": "2026年4月1日付で、ローム・アポロ㈱、ローム・ワコー㈱、ローム浜松㈱の3社を、前工程製造会社の「ローム・デバイス マニュファクチャリング㈱」と後工程製造会社の「ローム・アッセンブリ マニュファクチャリング㈱」の2社に再編しました。",
      "significance": "2025年11月に公表した第2期中期経営計画「MOVING FORWARD to 2028」で掲げた生産拠点再編の一環です。この再編は2026年3月期の期末後に行われたため、この年度の有価証券報告書の設備や関係会社の記載は再編前の3社のままです。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
