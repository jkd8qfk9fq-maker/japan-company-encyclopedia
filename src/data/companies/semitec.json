  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "センサとその関連製品の研究開発に注力し、市場の規模を考えて消費地に近い場所で生産する「消費地生産」と、コスト競争力を求めた「適地生産」による生産のグローバル化と、グローバルな販売網の構築を進めてきました。中長期的には、世界各国の独特なニーズを汲み取り新しいセンサを創造する「真のグローバル企業」を目指し、中期経営計画『Vision2026』を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "報告セグメントは販売地域別で、中華圏が外部顧客への売上高8,578百万円と最大です。関連情報の地域別売上高でも中国が7,762百万円で最大であり、MD&Aは売上高の8割以上が国外であり、生産の7割以上も国外で行われていると述べています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要による。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設計・生産（アッセンブル）・販売を一貫して行う体制を地域別セグメントの基盤としており、研究開発は千葉工場のワールドテクノロジーセンターが統括します。1954年のバリスタ開発以来のセンサ技術の蓄積があり、1992年には半導体薄膜技術を取り入れた薄膜センサの製造を始めています。",
        "basis": "報告セグメントの概要、研究開発活動、沿革による。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主力の温度センサ市場では標準化と価格競争が進む一方、高性能化や小型化に伴う個別ニーズも増え、二極化が進むと会社は見ています。2026年3月期の用途別では、自動車用途と医療関連が堅調だった一方、家電・住設とOA機器用途は需要の減少となりました。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の用途別要因による。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
