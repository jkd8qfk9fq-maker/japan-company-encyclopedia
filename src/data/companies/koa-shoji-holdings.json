  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年に向けての10カ年長期事業計画で、原薬販売事業は「原薬輸入商社から、医薬品専門商社へ」、医薬品製造販売事業は「注射剤を主としたジェネリック医薬品メーカーから、特長のある注射剤国内トップメーカーへ」を掲げています。原薬販売では海外で生産された医薬品の輸入販売の事業化やライセンスイン活動を推進し、製造販売では蔵王工場の生産能力強化と安定供給体制の推進に取り組みます。",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2つの事業テーマは、原薬の輸入販売という商社機能と、注射剤の製造販売というメーカー機能の双方を伸ばす方向でそろえられています。蔵王第二工場は2026年6月に竣工し、2027年3月の稼働に向けて準備が進められています。",
        "basis": "経営方針（中長期的な会社の経営戦略）、沿革、MD&Aの経営成績等の状況の概要に基づく",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "原薬の輸入販売を行う商社でありながら自社で分析機能を持ち、既存商品の安定提供に加えて顧客の研究開発段階からの提案・支援や、原薬メーカーへの品質改善の提案・新規製法の技術提供を行っています。原薬から製剤までの一貫した製造が可能な体制を持つことも特徴です。医薬品製造販売事業では、高度な技術と投資が必要な高薬理活性注射剤の生産設備を保有しています。",
        "basis": "事業の内容（事業の特徴・事業の体制）とセグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ジェネリック医薬品向けの原薬供給を中心に、国内外の医薬品メーカーと幅広く取引しています。セグメント情報では主要な顧客として扶桑薬品工業株式会社と東和薬品株式会社が開示されており、いずれも原薬販売事業の販売先です。",
        "basis": "セグメント情報の主要な顧客ごとの情報、関連情報（製品及びサービスごとの情報）、事業の内容（医薬品業界における位置づけ）に基づく",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
