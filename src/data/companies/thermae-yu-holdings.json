  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針として、温浴事業を柱として経営の効率化を図り、不動産事業、食品事業と併せて売上及び利益の拡大を目指すとしています。更なる事業の多角化やＭ＆Ａを視野に入れ、新たな収益源の開拓に努めるとしています。2025年７月１日付で「新・中期経営計画2028」を開示しています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "新宿・歌舞伎町と西麻布という都心の立地に温浴施設を２店舗持ち、西麻布店は温浴施設と宿泊施設が一体となった施設です。新宿店ではアウフグースのイベントや施設のリニューアルを重ねてリピーターの維持と新規顧客の取り込みを図っています。親会社が温浴施設の建物や土地を保有し、運営子会社に賃借する体制で、施設資産をグループ内に持っています。",
        "basis": "【事業の内容】に印字された温浴施設２店舗の運営体制と西麻布店の宿泊施設、【関係会社の状況】に印字された運営子会社が当社から建物・機械装置・土地等を賃借している関係、MD&Aに印字された新宿店のイベント・リニューアルによる集客の取組に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
