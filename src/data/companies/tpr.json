  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コーポレートメッセージは「『動く』をきわめ、社会を支える ＴＰＲ」です。2024年4月から3ヶ年の26中期経営計画に取り組み、エンジン部品のパワートレイン分野と、それ以外のフロンティア分野の両輪経営を進めています。2027年3月期の売上高目標は2,100億円です。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ピストンリング、シリンダライナ、バルブシートのエンジン部品を軸に、自動車外装部品や自動車純正用品まで手がけ、日本、アジア、北米、欧州、南米に生産と販売の拠点を持っています。",
        "basis": "【事業の内容】及び【セグメント情報】の記載",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は190,553百万円で、ファルテックグループが72,925百万円、ＴＰＲグループが117,627百万円でした。日本、アジア、北米、その他地域とファルテックグループの5つの報告セグメントで事業を行っています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
