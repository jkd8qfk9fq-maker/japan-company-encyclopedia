  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第7次中期経営計画の最終年度となる2027年2月期に向け、「Challenge for Future 未来への挑戦～2030年に向けて～」をスローガンに、2030年に向け持続的な成長を支える基盤構築に取り組むとしています。中核であるブランド事業においてブランド価値の更なる向上と収益力強化を図るとともに、アパレル事業にて出店拡大、既存店の成長を推し進めることで、強固な事業ポートフォリオの構築に取り組んでいくとしています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "優先的に対処すべき課題として、ブランド事業では「４℃」ファッションジュエリーの再成長に向けたMD改革の深化とチャネル戦略の推進、株式会社羅針における高額品の品揃え強化と「RASIN」のブランド化を掲げ、アパレル事業ではアスティグループの海外サプライチェーンの優位性と企画提案力の活用、株式会社アージュにおける年間10店舗の新規出店を掲げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営戦略と優先的に対処すべき事業上・財務上の課題の記載",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「４℃」ジュエリーの高いブランド力が強みであり、生産から店頭小売までの機能を有するSPAは、顧客満足を実現できる事業モデルであるとしています。そのほか高級ブランド時計専門のリユース事業、アパレルOEM事業、小売事業等の複数の事業モデルが存在し、幅広い市場に対応することができます。持株会社という組織形態は、経営資源の「選択と集中」の進展に有効に機能しています。",
        "basis": "会社の支配に関する基本方針における基本方針の実現に資する特別な取り組みの記載と、事業の内容における各事業の説明",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメント別の外部顧客への売上高は、ブランド事業45,346百万円、アパレル事業24,615百万円です。2026年2月期の連結売上高69,962百万円は前期比52.4％増であり、2024年12月に連結子会社化した株式会社羅針が通年寄与したことが主な要因です。本邦の外部顧客への売上高が連結売上高の90％を超えるため地域ごとの売上高は開示されておらず、売上高の10％以上を占める特定の顧客もありません。",
        "basis": "セグメント情報等における報告セグメントごとの外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）の記載、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における業績の記載",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
