  "history": [
    {
      "year": 1923,
      "title": "寺崎電機製作所として創業",
      "description": "大阪市此花区において、電気機械器具類の製造・販売を寺崎電機製作所の商号で開始しました。",
      "significance": "現在の寺崎電気産業グループの起源です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1946,
      "title": "株式会社寺崎電機製作所を設立",
      "description": "業容の拡大により、大阪府中河内郡加美村（現・大阪市平野区加美）に株式会社寺崎電機製作所を設立しました。現在の加美工場の地に当たります。",
      "significance": "製造拠点の基盤ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1955,
      "title": "旧・寺崎電気産業株式会社を設立",
      "description": "株式会社寺崎電機製作所の製造部門と販売部門を分離して分社化することとし、営業譲渡を受けて大阪市阿倍野区に旧寺崎電気産業株式会社を設立しました。",
      "significance": "販売を担う会社の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "英国に合弁会社を設立",
      "description": "欧州地域への機器製品の販売を目的として、英国グラスゴーにAutomat Engineering Glasgow Ltdとの合弁会社Terasaki Circuit Breaker Co.,(UK)LTD.を設立しました。",
      "significance": "海外販売拠点の第一歩です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "シンガポールに合弁会社を設立",
      "description": "船舶用配電システム製品等の製造販売拠点として、シンガポールに現地商社との合弁会社TERASAKI ELECTRIC CO.,(F.E.)PTE.LTD.を設立しました。",
      "significance": "東南アジアの海運・造船の中心への進出です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1980,
      "title": "現・寺崎電気産業株式会社を設立",
      "description": "配電盤、制御盤等の製造・販売を目的として、旧寺崎電気産業株式会社より営業譲渡を受け、大阪市阿倍野区に寺崎電気産業株式会社を設立しました。",
      "significance": "現在の提出会社の設立です。",
