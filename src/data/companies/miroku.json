  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として「誠実と正直こそ信頼への近道」を掲げ、会社に関わるすべての人々に比類のない喜びと感動を与えるため、高品質な製品とサービスを世界へ提供するとしています。猟銃事業ではOEM供給先であるブローニンググループとの協調体制を強化し、工作機械事業では加工部門を成長の核として営業活動を展開するとしています。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の8割超を猟銃事業が占め、その大半がブローニンググループ向けであるため、グループの業績は同グループからの受注動向に左右される構造になっています。工作機械事業とクラウドソリューション事業は規模が小さく、事業の柱は猟銃事業に集中しています。",
        "basis": "セグメント情報及び主要な顧客ごとの情報の記載に基づく",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1893年に始まる猟銃製造の歴史を持ち、ブローニング・アームズ・カンパニーとは1966年の提携以来の長期の関係があります。散弾銃及びライフル銃の契約品目を長期間供給する契約も結んでおり、OEM供給先との関係の深さが特徴です。",
        "basis": "沿革及び重要な契約等の記載に基づく",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "猟銃事業では世界的な銃ブランドであるブローニンググループのOEM供給先として、散弾銃やライフル銃を供給する位置にあります。工作機械事業では深穴加工機や深穴加工用工具などの専門分野を手がけています。",
        "basis": "事業の内容及び経営方針の記載に基づく",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
