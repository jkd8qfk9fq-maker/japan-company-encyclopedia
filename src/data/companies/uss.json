  "relatedCompanies": [
    {
      "companyId": "bike-o-and-company",
      "relationship": "business-partner",
      "description": "連結子会社のジャパンバイクオークションが運営するバイクオークションへの出品や、物流センター用地の賃貸などでの協力関係があります。2026年３月31日現在、その協力関係の維持・強化のため同社の株式を保有しています。2011年にはバイクオークション事業に関する業務・資本提携の基本合意を結んでいます。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【株式の保有状況】"
    }
  ],
