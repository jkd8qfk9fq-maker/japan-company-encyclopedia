  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 重要な後発事象として、2026年３月27日開催の取締役会において株式会社東日本板橋花きの全株式を取得して子会社化することを決議し、同日付で株式譲渡契約を締結し、2026年４月１日付で全株式を取得した旨が記載されています。株式の取得は当連結会計年度末（2026年３月31日）後の事象であるため、本登録は2026年３月期の構造で登録しています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月に子会社化した株式会社東日本板橋花きをグループ戦略上の重要な花き卸売市場と位置付け、首都圏需要をよりきめ細かく捉える体制を構築するとともに、サプライチェーン全体の最適化を推進してシナジーの最大化を図るとしています。戦略テーマとして、日本最大規模の花き取引所ビジネスの確立、鮮度保持機能の強化と効率的・合理的物流の実現、サプライチェーン全体を通じた相乗効果ビジネスの創出を掲げています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "大田市場での卸売を中核に、九州と東北の関連会社による地方の卸売・問屋業と、大田市場内の倉庫賃貸が補完する構成になっています。",
        "basis": "【事業の内容】および【関係会社の状況】に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本初のセリ下げ方式によるセリ機械、鮮度保持のための定温倉庫や自動搬送設備を備えた大田市場で卸売を行い、花保ちの比較試験を行う試験室や卸売市場総合情報システムを持つ点が特徴です。",
        "basis": "【沿革】に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "花き業界では、国内生産者の高齢化や後継者不足の進行に加え、気候変動に起因する異常気象の影響により生産の不安定化が進み、エネルギー価格や資材価格の高騰、物流の問題など、生産・物流・販売を取り巻く課題が重なっているとしています。",
        "asOf": "2026-06-26",
