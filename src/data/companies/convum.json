  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針「コンバム・パッドNo.1」を掲げ、主力製品である真空発生器（コンバム）と吸着パッドについて、パイオニアメーカーとして蓄積したノウハウと経験を活かして新製品の開発と拡販に取り組み、業界No.1を目指すとしています。中長期的な経営戦略では、各業界別にお客様のニーズを見極めた新製品開発によるシェア拡大、生産設備と人材への積極投資による最適な生産体制の構築、労働力不足を背景としたロボット導入の流れを受けたロボットハンドの事業拡大を挙げています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1972年に空気エジェクタ式真空発生器を「コンバム」の商標で発売したパイオニアメーカーであり、真空吸着機器に特化した研究開発を続けています。全ての製品の開発を自社で行い、産業用ロボットや協働ロボットの普及拡大に対応してロボット向け吸着ハンドのバリエーション拡充や新素材・新形状の吸着パッドの開発を進めています。",
        "basis": "【事業の内容】の製品開発の記載と【経営方針、経営環境及び対処すべき課題等】のパイオニアメーカーの記載に基づく",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "顧客の所在地を基礎とした2025年12月期の売上高は、日本が1,255百万円、アジアが644百万円、北米が65百万円、その他の地域が16百万円で、日本向けが中心です。製造・販売体制は日本（当社）、韓国（連結子会社）、タイ（連結子会社）の3か国に拠点があります。",
        "basis": "【関連情報】の地域ごとの情報と【事業の内容】のグループ構成の記載に基づく",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
