  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営計画[2025-2030]では、2030年に目指す姿「MLC2030ビジョン」の実現に向けた最終フェーズとして、５つの成長戦略を掲げています。物流事業の飛躍（トータルロジスティクスサービスの強化、カテゴリー戦略の推進など）、不動産事業の進化（資産回転型ビジネスの本格稼働、アセットマネジメント事業への進出、海外不動産ビジネスへの進出など）、海外事業の拡大（ASEAN、北米、インドを最重点領域とし、有力物流事業者とのパートナーシップで成長を加速すること）、先端技術の活用による業務プロセスの改善と新ビジネス創出、グループ経営基盤の強化です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "倉庫事業を中核に、陸上運送、国際運送取扱、港湾運送までを当社グループで一貫して担う体制が、事業の内容として説明されています。保管だけでなく、国内外の輸送と港湾での荷役までをまとめて引き受けられる点が特徴です。",
        "basis": "【事業の内容】の事業構成の説明",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは物流事業と不動産事業の２つで、2026年3月期の外部顧客への営業収益は物流事業が238,013百万円、不動産事業が35,432百万円と、物流事業が大半を占めています。海外にも米国、欧州、中国、アジア各国の子会社を持ち、地域ごとの営業収益では日本が最も大きくなっています。",
        "basis": "セグメント情報（報告セグメントごとの営業収益、地域ごとの情報、2026年3月期）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
