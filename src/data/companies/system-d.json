  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ユーザ志向、顧客優先、パッケージソフトによる最適なソリューション、特定業種・業務のソフトウェアに特化してデファクトスタンダードを目指すことを立脚点として事業を展開するとしています。中長期的には、新規及び追加のシステム提案によるフロービジネスを拡大するとともに、サポート及びクラウドサービス提供による安定的なストックビジネスを展開し、次世代を担うソフトウェアの新規開発や既存ソフトウェアのバージョンアップ開発を継続することで、市場におけるシェアを伸ばし、ストック収入を更に充実させるとしています。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "特定業種に特化することで、ユーザが必要な機能を網羅した密度の濃いシステムを提供しています。学園向けの『キャンパスプラン』シリーズは業界トップシェアを誇るとされ、公立小中高校向けの『School Engine』も都道府県向けでトップシェアを占めるとされています。ライセンス販売などのフロー収益に加え、サポートとクラウドサービスによるストック収益を積み上げる収益構造を持っています。",
        "basis": "【事業の内容】における業種特化の記載と、MD&Aにおける各ソリューションのシェアの記載に基づきます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "公会計パッケージソフト『PPP(トリプル・ピー) Ver.5 新統一基準対応版』は全国1000を超える自治体で活用され、公会計のデファクトスタンダードになったとされています。学園分野では少子化の影響が想定される一方、各学園が経営効率化のために情報化投資を進めていることなどから、ビジネスチャンスは拡大傾向にあると会社はみています。",
        "basis": "MD&Aにおける公会計ソリューションと学園ソリューションの記載と、【事業等のリスク】における少子化の影響の記載に基づきます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
