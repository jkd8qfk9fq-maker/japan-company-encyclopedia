  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "デジタルコンテンツ領域とWeb3領域を戦略的注力分野として位置付け、M&Aを含む事業構造の再編と収益基盤の強化に取り組むとしています。グループ内の資産と顧客基盤の活用による相乗効果の実現、ストック型収益の拡充、規制対応と内部管理の強化によって、中長期的な収益力の向上を目指すとしています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "2025年11月期は、株式会社ネクスデジタルグループの連結子会社化で暗号資産交換業の株式会社Zaifなどが加わる一方、IoTデバイスの製造販売を行う株式会社ネクスを株式交換で連結から外しており、公表した方針に沿って事業の入れ替えが実際に進んでいます。",
        "basis": "沿革と経営成績の概況に、2025年2月の株式会社ネクスデジタルグループの連結子会社化（株式会社Zaif、チューリンガム株式会社、株式会社ネクスソフトなどが加入）と、2025年10月の株式交換による株式会社ネクスの連結除外が印字されていること",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コミッションサービス『Skeb』は総登録者数が382万人（2025年12月現在）に達する日本最大級のコミッションプラットフォームで、暗号資産交換所『Zaif』は2016年からサービスを続ける老舗の交換業者です。個人の利用者が積み上がるサービスを複数持ち、継続的な利用が見込める顧客基盤を持っています。",
        "basis": "経営成績の概況に、『Skeb』の総登録者数382万人（2025年12月現在）と日本最大級のコミッションプラットフォームであること、Zaifが2016年から10年近いサービス展開をしてきた老舗プレイヤーであることが印字されていること",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
