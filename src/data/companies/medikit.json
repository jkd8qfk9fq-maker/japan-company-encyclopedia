  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年5月に公表した中期経営計画“NEXT 300 Neo”（2029年3月期まで）では、インターベンションを中心に自社製品の開発を進めて付加価値の高い製品を提供すること、欧米市場および中国市場を中心に海外販売を強化すること、生産の効率性を高めて原価の低減に取り組むことを重点課題としています。また、販売会社である当社と開発及び製造を行う東郷メディキット株式会社を別会社とする企業構造で、それぞれの役割を明確化しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製品の開発から生産、販売までをグループで一貫して手掛ける体制を持ち、販売と製造で会社を分けて役割を明確にしています。製造は宮崎県日向市の工場群とベトナム工場が担い、人工透析用留置針「ハッピーキャス」や静脈留置針「スーパーキャス」等の主力製品を持ちます。針刺し防止機構付きの留置針など、医療スタッフが安心して使える安全性に配慮した製品を開発し、市場に投入しています。",
        "basis": "事業の内容における品目別の製品の記載と、経営者による分析における品目別の販売実績と製品展開の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は前期比5.4％増の23,781百万円で、品目別では静脈留置針類が8,441百万円と最大でした。地域別では海外の売上高が4,246百万円あり、売上高の10％以上を占める単一の顧客はないため、顧客は分散しています。",
        "basis": "セグメント関連情報における地域ごとの売上高と主要な顧客ごとの情報の記載、経営者による分析における品目別の販売実績の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
