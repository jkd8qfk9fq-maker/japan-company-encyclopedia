  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "独自の製品・新技術の開発に努め、より高性能の商品・工法を提供することで顧客のニーズに応え、社会資本の整備と快適な環境の創造に貢献することを経営の基本としています。構築物の基礎支持力を提供するメーカーとして、高品質のコンクリートと施工技術・施工管理技術の研究に取り組み、他社との差別化を図ることを目標としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "企業価値の源泉として、高性能かつ安全な商品・工法を創造する最先端の技術開発力、お客様の高度なニーズにも対応するコンサルティング営業力と一気通貫の責任施工体制、高品質な商品を安定的に供給する全国的な製造販売体制の3点を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【会社の支配に関する基本方針】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の事業別売上高では、コンクリート二次製品関連事業が83,159百万円と全体の8割超を占め、情報関連事業が7,450百万円、その他事業が9,244百万円でした。売上は国内のみで、売上高の10％以上を占める主要な顧客はありません。コンクリートパイル業界全体の出荷量は、民間需要が増えた一方で官公需要が減り、前期比で0.2％減少しました。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報（地域ごとの情報・主要な顧客ごとの情報）、経営環境の記述に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
