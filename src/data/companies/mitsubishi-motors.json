  "history": [
    {
      "year": 1970,
      "title": "三菱重工業から自動車部門を譲り受けて営業開始",
      "description": "1970年4月に三菱重工業株式会社の全額出資により設立され、同年6月に同社の自動車部門を譲り受けて三菱自動車工業株式会社として営業を開始しました。あわせて京都製作所の一部、名古屋自動車製作所（現在の岡崎製作所）、水島自動車製作所（現在の水島製作所）などの移管を受けています。",
      "significance": "三菱重工業の一部門だった自動車事業が、独立した会社になった出発点です。このとき引き継いだ岡崎製作所・水島製作所・京都製作所は、2026年3月期でも国内の主要な生産設備として記載されています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1988,
      "title": "東京・大阪・名古屋の各証券取引所に株式を上場",
      "description": "1988年12月に東京・大阪・名古屋の各証券取引所の市場第一部に株式を上場しました。名古屋証券取引所は2003年11月、大阪証券取引所は2009年11月に上場廃止となっています。",
      "significance": "株式を公開した会社になりました。2022年4月の東京証券取引所の市場区分見直しを経て、現在の上場先は東京証券取引所プライム市場だけです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1997,
      "title": "タイの生産会社を子会社化",
      "description": "1997年8月にタイのMMC Sittipol Co., Ltd.の株式の過半数を取得しました。同社は2003年11月にMitsubishi Motors (Thailand) Co., Ltd.へ社名を変更し、2008年8月に全株式を取得しています。",
      "significance": "海外での生産の中心になる会社をグループに入れました。同社は現在も自動車の生産と販売を行っており、2026年3月期の有形固定資産は、地域別で日本に次ぐ1,159億37百万円です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2003,
      "title": "トラック・バス事業を分社化",
      "description": "2003年1月に会社分割によりトラック・バス事業を分社化し、三菱ふそうトラック・バス株式会社を設立しました。同年3月に同社株式の43％をDaimlerChrysler AGへ、15％を三菱グループ10社へ譲渡して所有比率が42％となり、2005年3月には当社が所有する全株式をDaimlerChrysler AGへ譲渡しています。",
      "significance": "トラック・バスの事業がグループから離れました。現在の自動車事業が扱う主要な製品は、電動車、SUV・ピックアップ、乗用車・ミニバン、軽自動車と、L300などの商用車です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2015,
      "title": "インドネシアに生産会社を設立",
      "description": "2015年3月に三菱商事株式会社との共同出資でPT Mitsubishi Motors Krama Yudha Indonesiaを設立しました。",
      "significance": "タイに続く海外の生産拠点になりました。同社は現在も自動車の生産を行っており、2026年3月期の有形固定資産は、地域別で日本・タイに次ぐ720億78百万円です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2016,
      "title": "日産自動車と戦略提携契約を締結",
      "description": "2016年5月に日産自動車株式会社と資本業務提携に関する戦略提携契約を締結しました。同年10月に日産自動車が第三者割当の引受により当社株式の34％を取得し、2024年11月に一部株式を当社へ売却しています。",
      "significance": "日産自動車と、購買、車両プラットフォームの共用、新技術の開発分担、生産拠点の共用などの面で協力する体制になりました。この提携は2026年3月期の有価証券報告書でも事業の内容として説明されています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2024,
      "title": "ロシアと中国での車両生産を終了",
      "description": "2023年12月にロシアのPCMA Rus LLCで、2024年2月に中国の広汽三菱汽車有限公司で、車両の生産事業を終了しました。PCMA Rus LLCは2010年4月にフランスのPeugeot Citroën Automobiles S.A.との合弁で、広汽三菱汽車有限公司は2012年9月に三菱商事株式会社との共同出資で設立した会社です。",
      "significance": "車両を生産する国が絞られました。2026年3月期の主要な設備で車両の生産設備が記載されているのは、日本の岡崎製作所と水島製作所、タイ、インドネシア、フィリピンです。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
