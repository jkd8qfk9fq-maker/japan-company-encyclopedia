  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「ファンつくり」を掲げ、お客様の立場に立つ「お客様立場主義」を追求しています。中期経営計画「IK WAY to 2028」では、韓国コスメを柱としたK-Beautyの展開、EC販路での売上シェアの拡大、得意先ブランドで商品を供給するODMの本格化を柱としてきましたが、計画と実績との乖離が生じたため同計画を取り下げ、新たに設置したグループ経営改革会議で、抜本的な成長戦略の再構築や組織再編を検討するとしています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1983年に愛知県生活協同組合連合会と口座を開設して以来の生協との取引の積み重ねがあり、生協・通販、店舗、海外と複数の卸売の販路を持つことが、販路の偏りを抑える土台になっています。",
        "basis": "【沿革】に1983年4月の愛知県生活協同組合連合会との口座開設と職域生協との取引開始が印字され、【事業の内容】にセールスマーケティング事業の卸売先として生活協同組合、通信販売会社、小売店舗、海外企業等が印字されていること。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年5月期は、卸売のセールスマーケティング事業が売上高の中心で、テレビ通販の縮小が続くダイレクトマーケティング事業を補う構図になっています。",
        "basis": "セグメント情報に、2026年5月期の外部顧客への売上高としてセールスマーケティング事業11,733,637千円とダイレクトマーケティング事業2,832,251千円が印字され、MD&Aにテレビ通販の売上が減少を続けていることが印字されていること。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
