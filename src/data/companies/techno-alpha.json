  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "重点課題として「半導体テストソリューションの強化」「FA装置分野の強化」「舶用機器販売の強化」「試験・計測システムインテグレーションの強化」「理化学機器の販売強化」の5つに取り組んでいます。エレクトロニクス事業では有望な商材である半導体テスターを中心とし、自社開発装置と輸入商材の相互補完を進めるとしています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商品・製品の販売と併せて、各事業領域の経験と知見に基づく専門的な技術サポートを提供している点が特徴です。エレクトロニクス事業では接合技術センターを本社内に置き、顧客向けデモンストレーションや試作支援、トレーニングを行っています。",
        "basis": "事業の内容に基づく",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の過半をエレクトロニクス事業が占め、マリン・環境機器事業が続きます。2025年11月期はマリン・環境機器事業が大きく伸び、舶用機器の納入が進みました。地域別の売上高は日本が中心です。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
