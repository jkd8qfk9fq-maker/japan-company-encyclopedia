  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2028年5月期を最終年度とする中期経営方針で、国内ブックオフ事業を安定した収益を獲得する「深化領域」と位置づけ、プレミアムサービス事業、海外事業や新たな事業を「探索領域」として経営資源とノウハウを投入し、事業ポートフォリオの変革を進めることを定めています。2026年2月に締結した伊藤忠商事との資本業務提携では、同社グループの事業基盤や顧客接点との連携による既存事業の強化と将来の事業機会の拡大を推進するとしています。",
        "asOf": "2026-08-21",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "国内ブックオフ事業では「BOOKOFF」の認知度の高さを強みとして挙げています。公式スマホアプリの会員は2026年5月に1,046万人を突破しており、アプリを基盤とした顧客との直接のコミュニケーションを通じて信頼関係を深めているとしています。",
        "asOf": "2026-08-21",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年5月期の売上高では、国内ブックオフ事業が112,665百万円と連結売上高130,123百万円の8割を超えており、国内の店舗事業が中心の構成です。国内の外部顧客への売上高が連結売上高の90％を超えていることも開示されています。",
        "basis": "セグメント情報の外部顧客への売上高（国内ブックオフ事業112,665百万円）と連結売上高130,123百万円の比較、および関連情報における地域ごとの売上高の記載省略の理由による。",
        "asOf": "2026-08-21",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
