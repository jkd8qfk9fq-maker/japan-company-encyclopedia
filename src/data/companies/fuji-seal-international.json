  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「包んで価値を、日々新たなこころで創造します。」を掲げ、「人と環境にやさしい価値を届ける」ことをビジョンとしています。2024年から2030年までの長期戦略「FSG.30（Fuji Seal Sustainable Growth 2030 Strategy）」では、2031年3月期の連結売上高3,500億円以上を目標とし、既存4事業の着実な強化、製品マーケット・ターゲットエリアの拡大、次世代に繋がる新たなビジネスモデルの創造の3つの基本戦略に取り組んでいます。",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "包装資材と包装機械の両方を手がけ、企画から開発、製造、販売、メンテナンスまでを一貫して提供できる体制を持っています。日本、米州、欧州、アセアンの4地域に製造・販売の拠点を持ち、顧客に近い地域で生産と供給を行っています。",
        "basis": "【事業の内容】・【関係会社の状況】の記載",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、日本が98,347百万円、米州が68,248百万円、欧州が33,178百万円、アセアンが17,978百万円で、日本以外の地域が半分以上を占めます。製品別ではシュリンクラベルが134,314百万円と、連結売上高の6割を超える中心製品です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
