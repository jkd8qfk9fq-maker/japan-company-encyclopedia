  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「人々の生活を支えるインフラ（社会基盤）となる」のもと、「EDLP（エブリディ・ロープライス）」と「ショートタイムショッピング」をコンセプトに、「ムリ・ムラ・ムダ」を省いたローコスト経営を徹底する方針です。IT、物流、製造のコストは自社で内製化し、JV商品やスポット仕入の強化、居抜き物件を主体としたローコスト出店で低価格を実現するとしています。2025年3月に子会社化したサンモールとは、相互供給による商品力の強化とシナジー創出に取り組みます。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年2月期の商品部門別の販売実績では、食料品が20,017百万円と売上高28,604百万円の大部分を占め、次いで日用品・家庭用品が5,703百万円でした。食料品と酒類は前期比で増えた一方、日用品・家庭用品と衣料服飾・インテリアは前期比で減っています。当期から加わったサンモールの食品スーパーは食料品部門に含まれます。",
        "basis": "商品部門別の販売実績と、MD&Aの経営成績の状況の概要に基づく",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発の商品自動補充発注システム「JIOS」とJPOSレジ、自社物流センターによる倉庫内作業と配送の内製化で、店舗作業と物流のコストを抑えています。返品商品や賞味期限間近の商品を仕入れて廃棄前に安価で販売する集荷の仕組みや、子会社が製造するオリジナル商品「尚仁沢の天然水」も、低価格販売を支える要素です。",
        "basis": "経営方針の経営戦略とサステナビリティの戦略に印字された内製化と集荷の記述、MD&Aの経営成績の状況の概要に基づく",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "関東6都県（千葉県、東京都、埼玉県、茨城県、群馬県、栃木県）にジェーソン117店舗とサンモール6店舗を展開しています。地域別の販売実績では千葉県が7,924百万円と最も大きく、東京都6,610百万円、埼玉県6,240百万円が続きます。",
        "basis": "地域別の販売実績と、MD&Aの経営成績の状況の概要（出店状況）に基づく",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
