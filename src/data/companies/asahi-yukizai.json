  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年度を最終年度とする中期経営計画『GNT2030』を策定し、3つの成長戦略を明確にして着実に実行すること、人的・知的・顧客といった無形資産を成長の原動力として強化すること、資本効率を高めつつ財務面から成長を支えることを基本方針としています。事業ポートフォリオは『強化拡大』『事業変革』『深化・安定成長』に分類し、それぞれに応じた施策で継続的な成長を目指します。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "専門性の高い独自の技術をもとに事業を展開し、お客様の課題解決に真摯に向き合うことで、ニッチトップ企業として成長してきたと説明しています。企業理念では存在価値を『信頼の品質と真摯な対応による安心の提供』と定め、グレートニッチトップ企業への飛躍を目指しています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
