  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「一人ひとりの多様な魅力、想い、能力の発揮を支援し、働く人が幸せを感じられる社会の持続的発展を可能にする」というパーパスのもと、グループのコア領域は人材開発事業にあると位置付け、同領域へ経営資源を集中させる方針です。「人的資本経営のプロデューサー」として、コーチングを中核に人事・組織課題をワンストップで解決する体制の強化を掲げ、2025年11月の株式会社日本経済新聞社との資本業務提携を通じて、人的資本経営の社会的浸透と“実行人財”創出の加速を図るとしています。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期は、1月に新設分割で事業子会社3社を設立して持株会社体制へ移行し、9月末にはDX事業を営むKDテクノロジーズの株式を譲渡するなど、開示された選択と集中の方針に沿った再編が進みました。同社が重要指標とする取引先1社当たりの平均売上高は5百万円（前期比26.6％増）となりました。",
        "basis": "経営方針及び経営成績の分析における記載に基づく",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ビジネスコーチングは、対象者が行動変容の必要性に気付き、実践して効果を確認し、継続・定着させて成果に繋げるプロセスを、コーチが意図的に実現させる行為であると定義し、エグゼクティブコーチングではコーチングの事前と事後にステークホルダーへのヒアリングを実施して、周囲からの評価を成果の指標とする方法を採っています。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "150名を超えるプロフェッショナルコーチが在籍し、業務委託のパートナーコーチ259名と契約する体制を整備しています。これまでの取引実績は300社を超え、その約7割は東証プライム上場企業及びそのグループ企業です。",
        "basis": "重要な後発事象及び優先的に対処すべき課題における記載に基づく",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "主要顧客であるプライム上場企業においては、人的資本への投資状況の開示が望まれる状況にあり、実効性のある人材開発投資が求められているとしており、人的資本経営に関連する様々な課題に対してワンストップで解決することを目指すとしています。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期の外部顧客への売上高の約8割は人材開発事業によるもので、期末時点の事業はコーチングを中核とする人材開発に一本化されています。",
        "basis": "セグメント情報の外部顧客への売上高の構成に基づく",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
