  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として、地域社会に対する貢献、企業の持続的成長、人的資源の尊重を掲げています。東京電力との連携強化による調達力の確保や異業種との協業を進めながら、ＬＰガスを主軸に都市ガス・電力も根幹に加えた「総合エネルギー事業」への進化を進めてきました。今後は、電気とガスを組み合わせ、ＡＩやＩｏＴで制御できるハイブリッド給湯器・蓄電池・太陽光パネル等を活用する「エネルギー最適利用」の提案（ＮＩＣＩＧＡＳ３．０）を広げ、垣根を超えた「総合エネルギー調整力」の構築を目指しています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ＬＰガス105万1千件、都市ガス60万9千件、電気40万4千件のお客さま基盤を持ち、ＬＰガスでは世界最大規模のハブ充填基地「夢の絆・川崎」をはじめとする自前の充填・配送拠点網を営業圏に持っています。自動検針システム「スペース蛍」など、保安や配送をデータ連携で最適化した仕組みを自社で持ち、他の小売事業者へのプラットフォーム提供にも展開している点が特徴です。",
        "basis": "【事業の内容】・【沿革】・経営成績の分析の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高のうちＬＰガス事業が90,829百万円と4割を超えて最大で、都市ガス事業66,268百万円、電気事業51,382百万円が続き、ガスと電気をあわせた総合エネルギーの小売事業者です。売上高はすべて国内の外部顧客からのもので、営業圏のお客さまは約100万世帯です。",
        "basis": "セグメント情報・【関連情報】・【経営方針、経営環境及び対処すべき課題等】の記載",
        "asOf": "2026-06-19",
