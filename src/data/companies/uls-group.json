  "history": [
    {
      "year": 2000,
      "title": "ウルシステムズとして設立",
      "description": "東京都港区虎ノ門に、システム開発、ビジネスモデリング及びITガバナンス・サービスを中心とする事業の展開を目的として、ウルシステムズ株式会社（現ＵＬＳグループ株式会社）が設立されました。",
      "significance": "現在のＵＬＳグループの起点です。設立時の資本金額は書いていません。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "経営陣が筆頭株主になる",
      "description": "WP Japan Holdings, L.L.C.が保有していた当社株式を、代表取締役の漆原茂を中心とする経営陣が買い取り、漆原茂が筆頭株主になりました。",
      "significance": "海外ファンドの資本から創業経営陣の経営へ移行した転機です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "ジャスダック証券取引所に上場",
      "description": "当社普通株式がジャスダック証券取引所に上場しました。",
      "significance": "上場会社としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "ピースミール・テクノロジーを子会社化",
      "description": "全国の自治体向け情報システムコンサルティングを展開するピースミール・テクノロジー株式会社を連結子会社化しました。",
      "significance": "公共分野への展開の基盤となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "経営統合しＵＬＳグループに商号変更",
      "description": "株式会社イーシー・ワンと経営統合を実施し、商号をＵＬＳグループ株式会社に変更しました。あわせて共同新設分割によりウルシステムズ株式会社（現ＵＬＳコンサルティング株式会社）を設立して連結子会社化し、ソフトウェア事業は株式会社イーシー・ワン（現株式会社ノーチラス・テクノロジーズ）に承継させました。",
      "significance": "持株会社体制への移行と、コンサルティング事業への集中を示す出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "株式会社HashPortと業務・資本提携",
      "description": "仮想通貨ウォレット管理システム開発の分野で、フレセッツ株式会社（現株式会社HashPort）と業務・資本提携を行いました。",
      "significance": "先端技術領域への投資の一例です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "株式会社アークウェイを子会社化",
      "description": "高度なITアーキテクチャ技術を有する株式会社アークウェイの発行済株式総数の80.0％を取得し、子会社化しました。",
      "significance": "ITアーキテクチャ領域の体制強化です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "監査等委員会設置会社へ移行",
