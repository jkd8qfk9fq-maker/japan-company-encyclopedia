  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "共通の理念として「お客様の次世代ビジネスの成功を先端IT技術でリードし、お客様とIT業界にイノベーションを起こす」ことを掲げています。事業戦略では、顧客企業の競争優位性を支える戦略的IT投資領域を事業ドメインとし、デジタル・IT戦略立案支援、業務・システム変革支援、プロジェクトマネジメント支援、アジャイル開発、AI駆動開発などのコンサルティング事業を安定成長の基軸事業としつつ、得られた知見をもとにソフトウェア開発や先端技術領域への投資で事業を拡大していく方針です。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "先端IT技術と独自のナレッジベース「ULBOK（ウルボック）」等を駆使し、顧客本位のIT戦略の立案とその実行を顧客サイドで一貫して支援する体制が強みです。プロジェクトの品質管理活動を重層的に徹底していることも、顧客からの信頼の土台になっています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、先端IT技術と独自のナレッジベース「ULBOK（ウルボック）」等を駆使し、顧客本位のIT戦略の立案とその実行を一貫して顧客サイドで支援すると印字されていること。あわせて【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、重層的な品質管理活動の徹底と不断の改善努力を続けていると印字されていること",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業ドメインであるDX（デジタルトランスフォーメーション）コンサルティング市場では旺盛な需要が継続し、AIの利活用へのニーズも高まっているとされています。同社はコンサルタント713名（2026年3月31日現在）の体制で、既存顧客の需要の継続と新規顧客の増加に対応しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、DXコンサルティング市場で旺盛な需要が継続し、AIの利活用に対するニーズが高まっていること、コンサルタント数が713名となったことが印字されていること",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
