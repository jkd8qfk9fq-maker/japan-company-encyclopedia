  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年5月に、2026年度から2028年度までの3か年を対象とする「2026中期経営計画」を策定・公表しました。基盤事業の再建と戦略事業の収益化を進め、資本効率と実行力を高めることで、持続的な企業価値向上を実現するとしています。また同じ月に、パーパス「想いをカタチにする力で 挑み 未来（あす）を 支えつづける」を定めました。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "海外鋼材事業については、ASEAN唯一の特殊鋼メーカーとしての強みを活かし、現地調達化が進展するASEAN・インドを中心に、高品質材の拡販と日系・現地系顧客での採用拡大を進めるとしています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "ばね事業は北米・アジアに多数の生産子会社を持ち、特殊鋼鋼材事業は日本製鉄と生産ラインを相互に活用する協業関係にあります。製品別の事業部制のもと、国内と海外に製造拠点を分散させています。",
        "basis": "【セグメント情報】の報告セグメントの概要、【関係会社の状況】の子会社一覧、【株式の保有状況】の日本製鉄に関する保有目的の記載",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
