  "history": [
    {
      "year": 1941,
      "title": "日本国際航空工業株式会社を設立",
      "description": "1941年7月、日本航空工業株式会社（1937年5月創立）と国際工業株式会社（1939年11月創立）が合併し、日本国際航空工業株式会社が設立され、航空機を製作していました。",
      "significance": "今の日産車体の起源です。",
