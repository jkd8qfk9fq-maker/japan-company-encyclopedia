  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年度にスタートした2023－2027中期経営計画では、目指す姿を「商用車とプレミアムカー、特装車、サポート事業で社会に貢献し、お客さまから頼られる唯一無二の存在となる」と定め、「持続可能な企業基盤」「魅力ある商品の創出」「独自性の進化と深化」の3つを重点課題として取り組んでいます。コーポレートパーパスは「人々の生活を豊かに。イノベーションをドライブし続ける。」です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "自社の強みである開発から生産まで一貫したモノづくり体制を活かし、市場の動向に柔軟に対応できる生産運営の構築に取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高のほぼすべてが親会社の日産自動車向けで、2026年3月期の日産自動車への販売額は396,706百万円と、売上高全体の98.2％を占めています。日産自動車から生産計画を受け、それに基づいて生産を行う体制です。",
        "basis": "【セグメント情報】の主要な顧客ごとの情報（日産自動車株式会社への売上高396,706百万円）と、経営成績の分析における販売実績の割合（98.2％）の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
