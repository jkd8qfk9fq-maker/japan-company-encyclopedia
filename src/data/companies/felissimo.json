  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年2月期を、前期に確立した収益基盤を土台に「増収増益の常態化」を実現する重要な実行年と位置づけ、「定期便事業の抜本的強化」と「次世代事業の創造」を両輪として成長軌道を牽引することを目指しています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "定期便事業ではのべ顧客数の回復による売上高の成長が次期への課題として残る一方、B2B・B2G分野や神戸ポートタワー事業などの新規事業領域を「第2の収益の柱」から中長期の成長を牽引する次世代事業へ位置づけを進化させ、外部パートナーとの共創による育成を進める方針が読み取れます。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績の状況と品目別の販売実績）",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商品を毎月1回届ける「フェリシモ定期便」という独自の継続購入の仕組みを持ち、注文受付から問い合わせ対応、情報処理、商品管理、注文品発送までを自社の受注・物流センターで集約して行う体制と、暮らしの提案を伝えるカタログの編集力が特徴です。",
        "basis": "事業の内容、主要な設備の状況",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "通信販売事業の単一セグメントで、本邦の外部顧客への売上高が連結売上高の90％を超える国内中心の事業構成です。品目別では服飾・服飾雑貨が販売実績の約3分の2を占めます。",
        "basis": "セグメント情報等（関連情報の製品及びサービスごとの情報・地域ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（販売実績）",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
