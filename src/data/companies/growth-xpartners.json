  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "既存のエンタープライズDX支援を着実に成長させながら、中長期では共創型事業によるスケーラブルな成長を目指す方針です。既存事業では顧客基盤の拡大とサービス提供力の拡大に取り組み、成長力の源泉としてグローバルDX人財の育成とDXテクノロジーアセットの蓄積を掲げています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高は4期連続で増加し、2025年8月期は5,086百万円です。エンタープライズ顧客数は21社、顧客維持率は86.6％で、既存の大手顧客との継続的な取引が収益の土台になっています。",
        "basis": "主要な経営指標等の推移と、事業の内容におけるエンタープライズ顧客数・顧客維持率の記載に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客の本社から切り離したDX推進組織を顧客と一体で作る「出島型アプローチ」と、既存IT資産のデータを活用する「データ駆動型プラットフォーム」の構築ノウハウが強みです。コンサルタント・エンジニア社員数は213名（2025年8月末時点）で、顧客企業のDX子会社の設立支援や役員派遣まで行う伴走体制を持ちます。",
        "basis": "事業の内容におけるDX支援の特徴（出島型アプローチ、データ駆動型プラットフォーム、コンサルタント・エンジニア社員数）の記載に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "会社は、DX支援サービスの多くが業務の周辺領域の改善やコスト削減にとどまる中で、組織とITの両面から変革に伴走できる支援者は限られていると認識し、出島型アプローチにより一般的なITコンサルティングファームやシステムインテグレータとは異なる位置づけを確立したと述べています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境と同社の位置づけの記載に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
