  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2022年3月に中期経営計画「UNISOL」を策定し、そのもとで経営基盤の強化と企業価値の向上に取り組んでいます。2025年度は計画の2ndステージ2年目として「成長加速化」を進め、最終年度である2026年12月期の定量目標を見直すこととしました。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年1月に機械・工具セグメントの中核会社としてユニソル株式会社を発足させ、統合による相乗効果の早期の最大化に取り組んでいます。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】と【沿革】",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "他にはない独自の解決策を生み出す「ユニーク・ソリューション・カンパニー」を目指し、それぞれの事業における利用者に最適な価値を提供する仕組みをプラットフォームとして、不足している機能や規模を補うプラットフォーム戦略を進めています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "フルサト工業の建設資材とマルカの機械・工具という異なる事業を持つ2社の経営統合により、製造業と建設業の両方に販路を持つグループになっています。",
        "basis": "【沿革】と【事業の内容】",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高は159,036百万円で、前連結会計年度に比べ2,679百万円減となりました。機械・工具セグメントが外部顧客への売上高104,904百万円と全体の3分の2近くを占め、建設資材セグメントが42,070百万円で続きます。",
        "basis": "【セグメント情報】に2025年12月期の外部顧客への売上高（機械・工具104,904百万円、建設資材42,070百万円、建設機械8,165百万円、IoTソリューション3,896百万円）と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に売上高159,036百万円と前期比2,679百万円減が印字されている。",
        "asOf": "2026-03-26",
