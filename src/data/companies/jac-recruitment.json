  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期的な経営ビジョン「JAC as No.1」の中で、人材紹介のプロフェッショナル集団としてサービス品質と収益性の両面で世界一になることを掲げ、サービス品質の向上に不可欠な人的資本の充実を中心とした成長投資を実施しています。国内人材紹介事業ではコンサルタントとマネージメントの増員と教育に取り組み、株式会社JAC Internationalとの相乗効果を活かして継続的な拡大を目指し、国内求人広告事業では前課金型から成功報酬型への事業モデルの転換をはじめとする事業構造の見直しを進め、海外事業では現地日系企業を軸に据えた注力市場の再構築と経営体制の強化を進めるとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳では国内人材紹介事業が41,660百万円と大半を占めており、開示された戦略も、国内のコンサルタントの増員と教育、戦略子会社との相乗効果を中心に組み立てられています。国内求人広告事業と海外事業については、国内人材紹介事業との連携を軸にした事業構造の見直しと再構築が課題として示されています。",
        "basis": "【セグメント情報等】の報告セグメントごとの外部顧客への売上高、【事業の内容】の人材紹介事業と求人広告事業の区分、【経営方針、経営環境及び対処すべき課題等】の中長期的な経営戦略と優先的に対処すべき課題によります。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "人材紹介事業では「Face to Face」の直接的なコミュニケーションを重視したコンサルティングを全社的に徹底して成約率の向上を図り、競合他社との差別化を進めるとしています。注力領域として、高額年収帯を中心に、エグゼクティブ領域、金融、コンサルティングのプロフェッショナル職などを担当する部署の強化を継続するとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "株式会社JAC Internationalを英語での交渉を要する国内外資系企業の中高額案件に特化した戦略子会社と位置づけ、海外のグループ各社を国際人材紹介の取次機関として使う体制が、専門性の高いポジションやグローバル人材のポジションを扱う基盤になっています。国内13拠点のオフィス網と海外のグループ各社が、その体制を支えています。",
        "basis": "【事業の内容】の株式会社JAC Internationalの位置づけと国際人材紹介の取次の記載、【主要な設備の状況】の国内支店網、【経営方針、経営環境及び対処すべき課題等】の経営環境によります。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "地域ごとの売上高は、日本が42,058百万円、アジアが2,645百万円、欧米が1,385百万円で、売上は日本に集中しています。経営環境として、中間管理職やスペシャリストの流動化は欧米諸国に比べて低い水準とされてきましたが、企業のグローバル化や人材流動化の推進などにより、即戦力となる人材の中途採用が進み、人材紹介業の役割が拡大していると説明されています。",
        "basis": "【セグメント情報等】の【関連情報】の地域ごとの情報と主要な顧客ごとの情報、報告セグメントごとの外部顧客への売上高、【経営方針、経営環境及び対処すべき課題等】の経営環境によります。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
