  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営基盤の確保と新規分野への展開を基本方針とし、金属製品事業、電子部品事業、化成品事業では、市場ニーズの把握により顧客のコスト削減に寄与できる技術の研究開発を進め、新製品の開発と品質管理力の確立で市場での優位性を築く方針です。生産管理体制の見直しによる製造原価の低減と顧客対応力の向上、市場のグローバル化に対応できる経営管理能力の確立にも取り組み、不動産事業では稼働率の確保による安定的な収益の継続を目指しています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "子会社の株式取得を重ねて事業を広げてきた会社で、2005年に三陽工業、2014年に株式会社LADVIK、2019年に株式会社山添製作所、2023年にヤマヤエレクトロニクスを取得し、2024年10月に持株会社体制へ移行しました。各事業を連結子会社に担わせるグループ経営の形がとられています。",
        "basis": "沿革と関係会社の状況に、三陽工業株式会社（2005年）、株式会社LADVIK（2014年）、株式会社山添製作所（2019年）、ヤマヤエレクトロニクス株式会社（2023年）の株式取得と、2024年10月の持株会社体制への移行・商号変更が印字されています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1917年の創業以来100年を超えてねじの製造を続け、米空軍の技術援助による精密ねじの生産や、海外メーカーとの特許権実施許諾契約による技術導入を重ねてきた締結部品の技術基盤があります。品質保証と環境保護の国際規格の認証も取得しています。",
        "basis": "沿革に、1917年の株式会社山科精工所の設立、1954年の米空軍の技術援助による精密ねじの生産、米国ILLINOIS TOOL WORKS INC.とのセムスねじの特許権実施許諾契約（1964年）や米国RESEARCH ENGINEERING AND MANUFACTURING INC.とのタップタイトねじの特許権実施許諾契約（1968年）、ISO9001（2001年）とISO14001（2003年）の認証取得が印字されています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は金属製品事業で、主要な取引先は自動車業界です。ねじなどの締結部品を自動車や産業機器のメーカーに供給する部品メーカーの位置づけにあり、タイにも製造・販売の子会社があります。",
        "basis": "セグメント情報に、2026年3月期の金属製品事業の外部顧客への売上高が8,273百万円で連結売上高12,725百万円の過半を占める旨、経営成績等の分析に主要取引先が自動車業界である旨、関係会社の状況にタイの連結子会社2社が印字されています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
