  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として、お客さま、保険会社及び代理店の「三者利益の共存」を掲げています。2026年６月期を初年度とする３か年計画では、更なる成長と資本効率の両立を基本方針とし、保険クリニックブランドでの来店型保険ショップ数、成約件数、顧客満足度などの更なる向上と、ＡＳシリーズを保険業界に特化したバーティカルSaaSとして確立するためのプロダクト開発を進めるとしています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発の『保険ＩＱシステム』が証券分析から商品の検索・比較提案、申込手続きまでを一つのシステムで担い、保険代理店として蓄積した保険データや募集人現場の意見を開発に反映している点、保険会社16社のシステムとのＡＰＩ連携を持つ点が特徴です。非定型帳票に対応する『スマートＯＣＲ』は、保険証券のデータ化から始めた経緯を持つ点も特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、『保険ＩＱシステム』が証券分析・ライフプラン作成・商品選択・比較提案・申込手続きまでを行う保険ワンストップ型販売システムであること、保険代理店として蓄積した保険データに基づく証券分析、現場の保険募集人の意見を反映した操作性、保険会社16社のシステムとのＡＰＩ連携により競争優位性を有していること、『スマートＯＣＲ』は保険証券という非定型の書類をデータ化するサービスから始めたため非定型帳票ＯＣＲとしての競争優位性を有していることが書かれています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "生命保険の加入経路では営業職員経由の比率が下がり、保険代理店経由の比率が上がる流れの中で、来店型保険ショップと代理店向けシステムの両方を持つ位置にあります。保険料収入全体の大きな増加は期待しにくい市場環境にあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、生命保険営業職員からの加入比率が2012年の約７割から2024年には56.7％に下落した一方、保険代理店からの加入比率は2024年の調査で15.7％と2012年から8.8％上昇したこと、高水準の保険加入率や高齢化・少子化を背景に保険料収入全体が大きく増加する状況は期待しにくいことが書かれています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
