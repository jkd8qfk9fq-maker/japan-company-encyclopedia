  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "多様な加工コア技術で開発試作品製作から製品量産製造に至る「一括一貫体制」を強みとして、新規市場であるホビー関連、半導体、EV、ヘルスケア／ウェルネス分野に引き続き注力するとともに、ロボット／フィジカルAI、環境／省エネ／再生可能エネルギー分野の領域拡大に取り組んでいます。安定収益層の拡大のため量産製品分野の受注拡大の施策を推進し、設備投資による生産力の増強を図るとしています。",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設計から金型製作、成形、加工、量産までの機能を自社グループで持ち、マグネシウム成形、金属射出成形、プラスチック成形、精密プレス加工、精密・微細板金加工、アルミホットダイカストなど多種多様な製作技術を備えているため、顧客は複数の協力企業への外注の手間を省け、市場への製品投入を早めることができます。微細化加工や多様な材料の加工、納期短縮に資する工程間調整にも対応しています。",
        "basis": "事業の内容及び経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
