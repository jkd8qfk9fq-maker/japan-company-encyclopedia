  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『中期経営計画2027』（2025年２月期から2027年２月期）に沿って経営を進め、「持続可能な社会の実現に貢献するコト作り企業として、創造的な発想と技術で人と社会のために必要なカタチを提供する」企業を目指すとしています。重点方針として、成長への組織改革と人的資本投資、事業ポートフォリオの再設定や標準化・自動化による業務改革、カーボンニュートラル社会に向けた技術開発と海外展開の拡大、ESG経営の体制構築を掲げています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、受託加工が売上高の97.0％を占める構造のもとで、伸長するガスタービン部品や防衛装備品、航空機エンジン部品の需要に生産能力の拡大で応えながら、自社製品であるデジタルサーボプレス、クロムフリー塗料、混合溶融機の拡販を進め、主要得意先への依存度を相対的に下げていくことです。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中期重点方針、経営成績の分析における主要得意先への対応と自社製品拡販の記述",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "一般の機械加工では切削できない超硬材や難削材を加工できる放電加工のノウハウをシステム化し、独自開発の専用機を駆使していることが強みです。金型では材料仕入れから製品までの一貫生産で精度と寿命を高め、表面処理では過酷な環境で稼動するエンジン部品向けの耐熱・耐食コーティングの技術を持ちます。",
        "basis": "【事業の内容】の放電加工・表面処理、金型の説明",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "大手メーカーの生産に組み込まれた受託加工の担い手という位置づけで、主要得意先４社グループで売上高の68.1％を占めています。三菱重工業株式会社はその他の関係会社として議決権の35.10％を保有し、放電加工・表面処理の受注先でもあります。",
        "basis": "【関係会社の状況】の三菱重工業株式会社の関係内容、経営成績の分析における主要得意先４社グループの売上高比率、【関連情報】の主要な顧客ごとの情報",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
