  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "個人・法人向けに幅広く商品・サービスを提供できる強みを活かして継続的かつ安定的に収益を確保できる体制を整備・推進し、既存商品の機能強化で顧客満足度を高めるとともに、新商品・サービスの企画、開発により顧客層を拡大し、継続的な事業拡大を目指すことを経営方針としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は売上高が前期比15.6％増の51,515百万円となり、法人向け事業の売上高が前期比34.8％増と伸びをけん引しました。MD&Aでは、当期及びそれ以前に提供を開始した新商品・サービスの寄与が説明されています。",
        "basis": "MD&Aの経営成績の概要、MD&Aの販売実績（市場別）、経営方針",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1979年の創業以来蓄積した日本語処理技術を基盤に、「ATOK」や「一太郎」といった長年の製品を持っています。サブスクリプション方式で提供するストックビジネスの売上高は367億76百万円にのぼり、継続的な収益の基盤となっています。",
        "basis": "沿革、MD&Aの経営成績の分析（ストックビジネスの売上高）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ソフトウエア関連事業の単一セグメントで、市場別では個人向け事業が33,173百万円、法人向け事業が18,342百万円です。本邦の外部顧客への売上高が連結売上高の90％を超えるため、地域ごとの情報の記載は省略されています。",
        "basis": "セグメント情報（関連情報）、MD&Aの販売実績（市場別）",
