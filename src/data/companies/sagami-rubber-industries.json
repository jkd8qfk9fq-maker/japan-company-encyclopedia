  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業者の掲げた理念を原点とし、コンドームメーカーの枠を超えた「Life Care Company」への進化を目指すとしています。ヘルスケア領域を中心とした事業基盤の強化、国内外でのブランド価値向上、デジタル技術の活用、新たな事業機会の創出に取り組むとともに、創業100周年を控えた現在を「第2の創業」の好機と捉え、事業ポートフォリオの最適化や成長領域への投資を推進するとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1934年にわが国で初めてラテックス製コンドームの製品化に成功し、1998年にはわが国初のポリウレタン製コンドーム「サガミオリジナル」を発売するなど、薄膜化をはじめとする製品開発の実績を長く重ねてきた点が特徴です。",
        "basis": "【沿革】に、1934年のアサヒラテックス化学研究所の創立とわが国最初のラテックス製コンドームの製品化、1998年のわが国最初のポリウレタン製コンドーム・サガミオリジナルの製造販売開始、2005年のサガミオリジナル0.02、2014年のサガミオリジナル0.01の発売が印字されている。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ヘルスケア事業が連結売上高の約8割を占める主力事業であり、コンドームを中心とするヘルスケア製品のメーカーとして事業を行っています。",
        "basis": "【セグメント情報】に、2026年3月期の外部顧客への売上高はヘルスケア事業4,675,714千円、プラスチック製品事業1,190,665千円、その他44,747千円、合計5,911,127千円と印字され、【事業の内容】にヘルスケア事業はコンドーム、医療用ゴム製品及び生活自助具等を製造・販売すると印字されている。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
