  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ソーシャルサポート、ゲームサポート及びアド・プロセスを収益の軸としつつ、サイバーセキュリティ事業の基盤強化や規模拡大、M&A等を活用した事業領域の拡大に取り組み、総合ネットセキュリティ企業として更なる飛躍を目指す方針です。BPO事業ではAIを活用した業務処理や分析サービスの高度化を進めるとしています。",
        "asOf": "2025-12-10",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "投稿監視やカスタマーサポート、広告審査といった運用業務から、脆弱性診断やWAFなどのセキュリティ技術サービスまで、インターネットの安心・安全にかかわる業務を一貫して提供できる体制を持っています。",
        "basis": "【事業の内容】に、インターネットセキュリティにかかわる事業を一気通貫で提供していることと、5つの業務区分の具体的な内容が印字されている。",
        "asOf": "2025-12-10",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2023年10月に株式会社チェンジホールディングスの連結子会社となり、同社グループの既存外注業務の移管や相互の顧客基盤を活用した共同提案による受注が生まれています。",
