  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本理念として「健全な価値観」「社会貢献」「個と組織の成長」を掲げ、高付加価値情報を創造・提供し、顧客の発展ひいては社会の発展に貢献することで「存在する意義のある組織」であり続けることを目指すとしています。コンサルティング事業では、事業や拠点を横断する体制で経営者に継続的に寄り添い、コンサルティングとM&Aの一体運営を推進する方針です。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "コンサルティング事業では顧客生涯価値の最大化を事業モデルの強みとし、総合的なコンサルティングのクロスセルで顧客との関係を深める方針が示されています。投資事業では、コンサルティング案件から生まれる投資機会に関与し、新たな収益機会の創出を目指す方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等とセグメント情報等の外部顧客への売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "税務・法務・財務の専門知識を持つ人材と事業面に詳しいコンサルタントが連携し、事業承継などの課題を網羅的に把握して複数の選択肢を提案できる体制が強みとして示されています。コンサルティングと投資の両事業を持つことで、案件から生まれる投資機会にも関与できる点も特徴です。",
        "basis": "経営方針、経営環境及び対処すべき課題等、事業の内容、セグメント情報等の外部顧客への売上高に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成はコンサルティング事業が79.2％、投資事業が20.8％で、経営者への継続的な伴走支援を軸とするコンサルティングがグループの基盤になっています。当期は投資事業の売上高が前期比130.2％増と大きく伸び、連結売上高の増加をけん引しました。",
        "basis": "セグメント情報等の外部顧客への売上高と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
