  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「計測で未来を測り、半導体で未来を創る」を掲げ、最先端技術を駆使した世界No.１商品を提供し続けることで高収益・高効率体質の確立を目指します。半導体社、計測社、業務会社の三つの社内カンパニー制と執行役員制により、顧客に機動的かつ迅速に対応します。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "精密測定技術と精密加工技術を活かし、半導体製造装置と計測機器の両分野で製品を展開します。半導体製造装置部門ではプローバやグラインダなどの加工・検査装置、計測機器部門では三次元座標測定機などを扱い、両部門のシナジー拡大に向けた新製品開発を進めます。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "半導体製造装置事業は、半導体業界の好不況のサイクルによる影響を受けやすく、技術革新のテンポが早い競争の激しい事業です。計測機器事業では、国内のものづくり関連投資が安定して推移し、航空・宇宙・防衛分野の事業機会を新たに獲得しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
