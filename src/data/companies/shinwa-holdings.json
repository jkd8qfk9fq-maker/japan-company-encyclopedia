  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "既存店については、「生つくね」などのオリジナル商品や北海道の食材、丁寧な接客で他社と差別化し、商品・サービス・クレンリネスを向上させて店舗収益力の維持・向上を図る方針です。新規出店については、主力の「炭火居酒屋　炎」と「美唄焼鳥・惣菜　炎」を中心に北海道内での展開を続け、出店エリアの拡大のため物件情報の取得や物件開発の人員確保など社内体制を強化するとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の98％超を飲食事業と物販事業の店舗事業が占めており、成長は新規出店の継続と既存店の客単価の向上に依る構成です。卸売事業は売上高の2％未満と小さいものの、自社工場の製造基盤を店舗向けと共用しています。",
        "basis": "セグメント情報に記載された報告セグメントごとの外部顧客への売上高の構成に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "食材の仕入れから自社工場（セントラルキッチン）での製造、店舗での販売まで一貫した体制を構築し、「生つくね」「塩ザンギ」などの主力商品を工場で一括して仕込むことで料理の質を均一に保っているとしています。店舗は直営を原則とし、特定地域に集中するドミナント出店で運営効率を高めているとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "居酒屋、焼肉、洋食バル、生ソーセージバル、惣菜、カレーのように業態を分けることで、来店客の好みの違いや感染症の流行のような外部環境の変化に対して、事業全体で受け止める構成になっています。",
        "basis": "事業の内容に記載された業態の構成と、複数業態によるリスクヘッジの説明に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
