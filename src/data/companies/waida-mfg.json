  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "精密工作機械製造技術・制御技術・研削加工技術を基盤とし、顧客との直接対話によって開発した独創的な工作機械を最良の品質と最善のコストで提供するとともに、技術と製品を継続的に進化させ、特殊研削盤分野でのトップメーカーを目指す方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "米国・欧州・アジアに販売子会社をそろえ、中国では上海の現地法人を設立するなど、海外市場での需要拡大に向けた販売・サポート体制づくりを進めていることが読み取れます。",
        "basis": "経営成績等の分析に、米国子会社WAIDA AMERICA INC.での活動拡充、ドイツ子会社WAIDA Europe GmbHへの営業・アフターサービス担当者の配置、上海現地法人の設立手続きの完了が印字されていることによる。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "超硬合金やセラミックスなどの硬脆材料を高精度・高能率・全自動で研削する特殊技術に特化し、全自動インサート研削盤では競合メーカーが世界で2社のみ、全自動溝入れインサート研削盤では世界で1社のみという、競合の少ない市場で高いシェアを獲得しています。",
        "basis": "経営方針の経営環境に、硬脆材料の研削という特殊技術に特化した特殊研削盤を開発・製造していることと、全自動インサート研削盤の競合メーカーは世界で2社のみ、全自動溝入れインサート研削盤は世界で1社のみで、ニッチな市場で高いシェアを獲得していると印字されていることによる。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "金型関連市場と切削工具関連市場の2つを主要市場とする研削盤のメーカーで、2026年3月期は金型関連研削盤が売上高の48.0％、切削工具関連研削盤が35.5％を占めました。世界でも限られたメーカーしか製造していない特殊な研削盤に特化する位置づけです。",
        "basis": "経営方針の経営環境に、主要な市場は切削工具関連市場と金型関連市場の2つであり、研削盤は世界でも限られたメーカーしか製造していない特殊な技術を要する機械であると印字されていることと、経営成績等の分析の品目別構成比による。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
