  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "健康寿命の８年延伸（+８Y）を目指し、予防医療を切り口としたヘルスケアDXを通じて、個人・法人・行政・医療施設をつなぎ予防医療をアップデートすることを掲げています。2025年４月に本格開始した法人予約を今後の成長領域と位置付け、事業拡大を図るとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「MRSO.jp」には2025年12月末日現在で1,906の医療施設の人間ドック・健診プランが掲載されており、医療施設の掲載数で国内最大規模の予約メディアを基盤に、医療施設向けの予約システム「MRS」と一体で提供している点が特徴です。",
        "basis": "【事業の内容】に、2025年12月末日現在で1,906の医療施設がプランを掲載していること、「MRSO.jp」が掲載医療施設数国内No.1の予約メディアであること（2022年11月～12月の調査に基づく注記あり）、および「MRSO.jp」と「MRS」を同時に提供するビジネスモデルを構築している旨が印字されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "健診・人間ドック市場は2023年度で9,810億円とされ、20歳以上の対象者のうち29.9％が未受診者であることから、受診のデジタル化と受診者拡大の余地が大きい領域に位置しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、健診・人間ドック市場規模が2023年度9,810億円（矢野経済研究所の調査）であること、人間ドック・健診の未受診者が29.9％（厚生労働省「2022年度国民生活基礎調査」）であることが印字されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
