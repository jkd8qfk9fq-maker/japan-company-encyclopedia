  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画『Yorozu Sustainability Plan 2026（YSP2026）』（計画年度2024～2026年度）では、電動化時代を支える存在となり、全てのステークホルダーから「選ばれる会社」になることを経営方針とし、6つの主要方策を柱に事業基盤と経営基盤の強化に取り組みます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自動車用サスペンション部品などを日本、米州、アジアの3地域で生産・販売しています。2026年3月期の外部顧客への売上高は米州が87,298百万円、日本が54,479百万円、アジアが34,551百万円です。日産グループ向けの売上高は112,443百万円です。",
        "basis": "2026年3月期のセグメント情報と得意先別売上高",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は176,330百万円で、親会社株主に帰属する当期純利益は2,075百万円です。従業員数は5,405人です。",
        "basis": "2026年3月期の連結経営指標",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
