  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは、「お客様の喜びが私たちの喜びです」を社是とし、中長期的な経営戦略として強い既存店づくり、成長投資、コストの最適化、ESGの取組み、コンプライアンスの強化を進め、基幹事業である回転寿司事業を安定的な成長軌道に戻すことで、持続的な成長と中長期的な企業価値の向上を目指しています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は、既存店の改装や注文専用高速レーン等の設備導入、新規出店のほか、韓国・インドネシアでの出店が進められており、掲げる既存店強化と成長投資の方針に沿った取組みが見られます。",
        "basis": "経営方針、経営環境及び対処すべき課題等における中長期的な会社の経営戦略の記載と、経営者による分析における回転寿司事業の取組みの記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内の直営店舗網と、切付マイスター・サービスマイスターの育成による調理・接客技術の標準化が店舗運営の強みです。また、コロワイドグループの業態間連携によるメニュー開発や共同調達を活用できる体制も強みです。",
        "basis": "経営方針、経営環境及び対処すべき課題等における強い既存店づくりとコストの最適化の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
