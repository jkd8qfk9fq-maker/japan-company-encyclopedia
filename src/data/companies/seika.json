  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン「VIORB 2030」と、2023年4月から2027年3月までの4か年の中期経営計画「VIORB2030 Phase1」を推進しています。「環境」をテーマに掲げ、エネルギー事業をベースとする事業基盤の強化と、脱炭素、省エネ・省人化、サーキュラーエコノミー、DXの4つの事業重点分野の推進による社会課題の解決と事業拡大を掲げています。取引先との共成長を目的とした戦略的事業投資による商権・商材の確保も進めています。",
        "asOf": "2026-06-05",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "旧三菱商事の機械部門を起源とし、発電設備の販売と保守で長年の実績を持ちます。三菱重工業の原子力事業の代理店を務めるなど、エネルギー分野の仕入と販売の関係が厚く、発電所の定期修繕工事などの保守需要を取り込んでいます。バルブや水中ポンプなどはグループ会社が製造・販売し、商社機能と製造機能をあわせ持つ点も特徴です。",
        "basis": "沿革、経営方針（対処すべき課題）、事業の内容、関係会社の状況に基づきます。",
        "asOf": "2026-06-05",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはエネルギー事業、産業機械事業、プロダクト事業の3つです。2026年3月期の外部顧客への売上高は、エネルギー事業が38,492百万円で最も大きく、産業機械事業が35,595百万円、プロダクト事業が34,397百万円です。地域別では日本が84,988百万円と大半を占め、海外売上高は売上高全体の21.7％です。外部顧客への売上高のうち10％以上を占める顧客はいません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの売上高、主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-05",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
