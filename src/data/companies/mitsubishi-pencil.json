  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業150年を迎える2036年に向けた長期ビジョン「ありたい姿2036」で「世界一の表現革新カンパニー」を掲げ、コーポレートブランドコンセプト（企業理念）を「違いが、美しい。」としています。その達成への足掛かりとして、2025年から2027年までの中期経営計画に基本方針「uni Advance」のもとで取り組んでおり、重点方針は筆記具事業の成長継続と多角化の推進、非筆記具事業分野における規模拡大、ステークホルダーと連携した成長基盤の強化の3つです。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "1887年の創業以来「最高の品質こそ 最大のサービス」を社是とし、「書く、描く」ことにこだわって品質向上と技術革新に努めてきたことを強みとしています。1958年に生まれた最高品質の鉛筆「ユニ」をはじめとする製品は、日本だけでなく世界100ヵ国以上のお客様に愛顧されているとしています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは2つで、2025年12月期の外部顧客への売上高は筆記具及び筆記具周辺商品事業が87,355百万円、その他の事業（粘着テープ・手工芸品）が2,458百万円です。地域別では日本が38,396百万円、欧州が17,184百万円、アジアが15,965百万円、米国が12,663百万円、その他が5,604百万円です。主要な顧客ごとの情報に該当事項はありません。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
