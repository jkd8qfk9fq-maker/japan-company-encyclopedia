  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2025年度～2027年度）のもと、カーボンゼロプリント、カーボンニュートラルプリント等の環境配慮型印刷の刷新と販路拡大、企画から発送まで自社内の一貫生産体制を活かした提案営業、デジタルマーケティングやダイレクトメールの提案力強化を進める方針です。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は4,830百万円で前期比2.2％増となりました。カーボンオフセット関連の売上が好調で、当初計画を上回りました。部門別では印刷と製品制作が増収となる一方、商品は大きく減少しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "長年製版で培った画像処理・印刷技術と、企画から発送までを自社内で完結できる一貫生産体制を持ちます。カーボンオフセットを組み合わせた環境配慮型印刷を、当社ならではの提案として打ち出しています。",
        "basis": "【事業の内容】と【経営方針、経営環境及び対処すべき課題等】に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主力の商業印刷業界は、印刷物のデジタル化や広告の減少、原材料価格の高騰などで厳しい経営環境が続いています。その中で環境貢献や業務負担の軽減につながる製品を求める企業が増えており、当社は環境配慮型印刷やデジタルとの連携で対応を進めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の業界動向に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
