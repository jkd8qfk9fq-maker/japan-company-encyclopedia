  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "研究支援事業を短中期的な事業の柱として推進し、中長期的な成長戦略として巨大市場が見込めるメディカル事業へ積極的に投資することで、当分野のマーケットリーダーを目指しています。米国、欧州、日本、インドの4拠点で事業を展開し、真のグローバル企業として成長することも基本方針としています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "遺伝子変異リスク等を抑えたRNAリプログラミング技術で臨床応用に適した高品質のiPS細胞を作製できる点と、ヒト生体試料の調達網とiPS細胞技術を統合した「ヒト細胞ビジネスプラットフォーム」を持つ点が特徴です。日米欧の拠点で販売・製造・研究開発の機能を持ち、各国の規制要件に準拠した臨床用iPS細胞を提供できます。",
        "basis": "【事業の内容】に、RNAリプログラミング技術により臨床応用に最適な高品質のiPS細胞を安全に作製できること、ヒト細胞ビジネスプラットフォームを構築していること、米国子会社のヒト生体試料バンクと日米欧の拠点体制が印字されているため。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "iPS細胞を病態解明や創薬研究に使う研究支援の分野では、試薬・細胞製品から受託サービスまでをそろえる専門企業です。再生医療の分野では、ステムカイマルなど4品目のパイプラインを開発する段階にあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、iPS細胞を病態解明や創薬研究に使用する事業を研究支援事業、再生医療をメディカル事業と位置づけていること、【事業の内容】に4品目のパイプラインが印字されているため。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
