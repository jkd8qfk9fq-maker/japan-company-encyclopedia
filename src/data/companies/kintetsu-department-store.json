  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年4月に中期経営計画（2025～2028年度）を策定し、長期ビジョン「くらしを豊かにするプラットフォーマー」のもと、「新たな価値創造事業会社」である「百“価”店」へと生まれ変わることを掲げています。旗艦店であるあべのハルカス近鉄本店のリモデルやあべの・天王寺エリアの魅力最大化、全社顧客戦略、地域店の進化などを進めるとしています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "店頭での接客力や、外商という顧客に寄り添う人的サービス、デジタル対応といった顧客接点を活かし、近鉄グループの力も活かしてモノ・コト・サービスを提供するとしています。また、地域に寄り添う「地域共創」を掲げ、地域産品を紹介・販売する「路（みち）シリーズ」の展開や、自社農場での大阪いちご「はるかすまいる」の生産・販売などに取り組んでいます。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の外部顧客への売上高は、百貨店業が103,168百万円と連結売上高125,450百万円の8割以上を占め、卸・小売業が15,024百万円、内装業が4,470百万円、その他事業が2,446百万円、不動産業が340百万円と、百貨店業への集中度が高い構成です。国内の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "【セグメント情報】の当連結会計年度の外部顧客への売上高と、【関連情報】の地域ごとの情報（国内の外部顧客への売上高が連結売上高の90％を超えるため記載を省略している旨）の比較による。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
