  "history": [
    {
      "year": 1961,
      "title": "日本フェンオールを設立",
      "description": "米国フェンオール社・三井物産株式会社・日本電熱株式会社の三社の出資により、各種制御装置及び火災探知装置の製造及び販売を目的として、日本フェンオール株式会社が東京都港区に設立されました。",
      "significance": "熱のコントロールを基礎技術とする、現在の防災・制御機器事業の出発点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1968,
      "title": "長野工場を建設",
