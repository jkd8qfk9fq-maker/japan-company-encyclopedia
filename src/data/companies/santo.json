  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「技術を社会に笑顔をあなたに」をモットーに、環境保全責任と地域社会への貢献などを基本方針に掲げています。建設従事者の高齢化や資材価格の高騰といった課題に対し、ＤＸの推進による業務効率化や施工現場の生産性向上にグループ一丸となって取り組み、地域密着の強みを活かした施工パートナーシップのもとで品質管理と合理的なコストプロセスを推進するとしています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "土木事業（公共工事が中心）と建築事業（民間工事が中心）が売上のほぼ半分ずつを占め、発注者の異なる2つの事業を組み合わせる構成です。環境開発事業は不動産の賃貸などを含む小規模な事業として位置付けられます。",
        "basis": "セグメント情報（報告セグメントごとの売上高）と事業の内容に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ＤＸの推進による業務効率化や施工現場の生産性向上にグループ一丸となって取り組み、地域密着の強みを活かした強固な施工パートナーシップのもと、品質管理と合理的なコストプロセスの推進に取り組んだとしています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "地盤改良のＪＳＴ工法や連続地中壁のＴＲＤ工法、岩盤を緑化するバイオ・オーガニック工法など、地下技術と特殊緑化の独自工法を持っています。滋賀県内に本社と本店を置き、同県の官公庁工事を継続して受注しています。",
        "basis": "事業の内容、沿革、セグメント情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "滋賀県を地盤とする地域密着型の総合建設会社です。2026年6月期の売上高は土木事業と建築事業でほぼ全てを占め、主要な顧客である滋賀県への売上高は全体の17.6％でした。",
        "basis": "セグメント情報（報告セグメントごとの売上高、主要な顧客ごとの情報）とMD&A（経営成績等の状況の概要）に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
