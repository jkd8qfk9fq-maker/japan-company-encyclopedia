  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2024～2029）では、既存事業を強化・拡大し、事業領域の拡大・変革と新たな事業の創出を進めるとともに、ESG経営及び人的資本の最大化に取り組むことを基本方針としています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の8割超を不動産ソリューション事業が占め、その中核は入居者を学生に限定した賃貸・管理の積み上がり型の収益です。当期の伸びは販売用不動産の売却が増えた不動産デベロップメント部門が押し上げましたが、安定的な収益基盤は管理物件235棟12,810戸の賃貸・管理業務にあります。",
        "basis": "セグメント情報、製品及びサービスごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "旅行業に端を発して学生とのネットワークを築いてきたことが特徴で、入居者を学生に限定することで卒業による退去の時期が読みやすく、前年の秋から募集を始めることで空室リスクを抑えています。開発の企画から設計、賃貸・管理、入居者募集までをグループで一貫して担う体制を持っています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "首都圏の学生向け賃貸住宅に特化した事業者で、不動産ソリューション事業が売上高の大部分を占め、学生生活ソリューション事業が旅行と人材のサービスを担います。主要な顧客である小田急電鉄株式会社向けが売上高の13.5％を占めています。",
        "basis": "セグメント情報及び主要な顧客ごとの情報、事業の内容に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
