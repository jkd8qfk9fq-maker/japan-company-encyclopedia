  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループの最上位概念「パーパス“Fun for All into the Future”」と中長期ビジョン「Connect with Fans」のもと、2025年4月から3カ年の中期計画を進めています。3つの共通テーマ（「さらなる事業規模の拡大」「新たな事業の柱の獲得」など）と、4つのキーテーマ「いいものつくる」「もっとひろげる」「そだてつづける」「みがきふかめる」を設け、IPの価値を最大化する「IP軸戦略」をグローバル市場でさらに強力に進めると述べています。重点地域は北米と中国内地です。中期計画の期間中に約6,000億円の成長投資を計画しており、2028年3月期の計数目標は連結売上高14,500億円（2025年2月公表）です。",
        "asOf": "2026-09-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "グループの強みとして「IP軸戦略」を挙げています。IPの世界観や特性を活かし、最適なタイミングで、最適な商品・サービスとして、最適な地域に向けて提供することでIP価値の最大化をはかるもので、各事業の連携で進めます。あわせて、多様なIPや幅広い事業カテゴリー・展開地域によるポートフォリオのバランスを重視し、安定した収益基盤を強くするとしています。また、グループの最大の財産であり強みはグループ社員だと述べています。",
        "asOf": "2026-09-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "disclosed": {
