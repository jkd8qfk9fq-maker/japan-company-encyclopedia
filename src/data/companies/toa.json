  "history": [
    {
      "year": 1914,
      "title": "鶴見埋築株式会社を設立",
      "description": "1908年に浅野総一郎が鶴見・川崎地先の埋立事業を神奈川県に出願し、この事業のために鶴見埋立組合がつくられました。1914年3月に組合を発展的に解消し、鶴見埋築株式会社を設立しました。",
      "significance": "海を埋め立てる事業が、同社の海上土木の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1922,
      "title": "請負施工にも進出",
      "description": "横須賀航空隊敷地造成工事を受注し、以後、請負による施工にも進出しました。",
      "significance": "自社事業の埋立から、工事を請け負う事業へ広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1944,
      "title": "東亜港湾工業株式会社に社名変更",
      "description": "港湾工業株式会社を合併し、東亜港湾工業株式会社に社名を変えました。",
      "significance": "現在の「東亜」を冠する社名の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に株式上場",
      "description": "1949年5月に東京証券取引所に株式を上場しました。1961年9月に再上場し、1969年1月には札幌証券取引所にも上場しました。",
      "significance": "株式を公開した出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "海外事業部を設置",
      "description": "海外事業部（現・国際事業本部）を設置し、翌1964年には東南アジアに営業所を置きました。",
      "significance": "海外での工事に取り組む体制の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "東亜建設工業株式会社に社名変更",
      "description": "株式会社留岡組の営業権を譲り受けて陸上土木・建築の分野に本格的に進出し、東亜建設工業株式会社へ社名を変えました。",
      "significance": "海上土木から、陸上土木や建築へ事業を広げた転機です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "本社組織を事業本部制に再編",
      "description": "本社組織を土木事業本部・建築事業本部・管理本部に再編しました。同じ年の12月には東亜地所株式会社を吸収合併しました。",
      "significance": "土木と建築を分けて統括する体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "新技術研究開発センターが完成",
      "description": "横浜市鶴見区安善町に新技術研究開発センターが完成しました。",
      "significance": "技術の研究開発の拠点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "監査等委員会設置会社へ移行",
      "description": "2019年6月に監査等委員会設置会社へ移行しました。4月には鶴見臨港鉄道株式会社が東亜地所株式会社を吸収合併し、東亜リアルエステート株式会社に社名を変えました。",
      "significance": "経営の仕組みと、グループの不動産関連会社の体制が変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "上場する市場区分が変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "インドネシアに現地法人を設立",
      "description": "PT TOA TUNAS JAYA INDONESIAを設立しました。現在は連結子会社です。",
      "significance": "インドネシアで現地法人が建設工事を行う体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "支店と本社組織を再編",
      "description": "2025年4月に西日本建築支店を分割して土木支店などに編入し、経営管理本部を設置しました。7月には東亜リアルエステート株式会社が東亜ビルテック株式会社を吸収合併し、東亜リアテック株式会社に社名を変えました。12月にはR2TOA CORPORATIONを設立しました。",
      "significance": "支店体制と、グループの不動産関連会社が整理されました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
