  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念のもと、「誰もが自分の人生をまっとうできる社会をつくる」を未来ビジョンとして掲げ、様々な企業との提携等を通して各種サービスを充実させるとともに、家賃保証に留まらない金融インフラとして企業価値を高める方針です。2027年３月期を最終年度とする中期経営計画は、主力事業の堅調な拡大やK-netのグループ化等により、2026年３月期に計画を１年前倒しで達成したと印字されています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "個人信用情報の利用に加え、蓄積してきた債権データやAI分析を用いた与信審査モデルによる精度の高い与信審査と、地域密着の営業体制が特徴です。2026年３月期には三重、山形、青森、秋田に支店を開設し41都道府県体制となっており、子会社K-netとの一棟保証サービスの共同販売など、不動産会社等との取引深耕を図っています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）、事業等のリスク（競合について）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（保証関連事業の経営成績の概要）に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "保証関連事業が売上高の大半を占め、2026年3月期の外部顧客への売上高は19,306百万円です。賃貸借契約における家賃債務保証会社の利用率は増加傾向にある一方、家賃債務保証業界は大小様々な競合他社が存在し、不動産管理会社による保証サービスの提供も行われるなど競争が激化していることが印字されています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）と関連情報（地域ごとの情報、主要な顧客ごとの情報）、事業等のリスク（市場リスク）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
