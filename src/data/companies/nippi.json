  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期を初年度とする中期経営計画（2026年3月期－2028年3月期）では、「成長事業への注力及び既存事業の収益力向上によるリターンの強化」「新たな資本政策の実施」「新中計を確実に実行するコーポレート・ガバナンス体制への進化」の3つを基本方針としています。成長事業への注力では、成長領域である健康・医療関連分野に注力し、バイオ関連事業及びゼラチン関連事業の伸長に取り組んでいます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "各事業の課題として、コラーゲン・ケーシング事業では製品銘柄の絞り込みなどによる生産性の向上、ゼラチン関連事業では由来原料や調達先の見直しと生産性の改善によるコスト競争力の強化、化粧品関連事業では商品構成の最適化と顧客基盤の拡充、皮革関連事業では新製品の開発や用途展開が挙げられています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の各事業における主な課題の記載によります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "研究開発は、コラーゲン・細胞外マトリックスにおける科学と技術を基盤として、バイオテクノロジー、メディカル、食品・ヘルスケアの各領域で、基礎科学から製品化を目指す応用開発までを行っています。皮革の生産過程で培われたノウハウと研究開発技術を土台に、ゼラチン、ケーシング、化粧品などコラーゲンを軸とする複数の事業を展開している点が特徴です。",
        "basis": "【研究開発活動】の記載と、【会社の支配に関する基本方針】における企業価値向上への取組みの記載によります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高47,252百万円の内訳は、ゼラチン関連事業12,585百万円、食品その他事業10,263百万円、コラーゲン・ケーシング事業9,236百万円、化粧品関連事業8,256百万円、皮革関連事業5,852百万円、賃貸・不動産事業1,058百万円です。地域別では日本が38,700百万円で最も大きく、次いで北米2,957百万円、その他アジア2,720百万円、タイ1,946百万円となっています。売上高の10％以上を占める主要な顧客はありません。",
        "basis": "【セグメント情報等】の報告セグメントごとの外部顧客への売上高と、【関連情報】の地域ごとの情報、主要な顧客ごとの情報によります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
