  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「世界に冠たる投資グループへ」をビジョンに、「ファンドの力で日本の今を変える」をミッションとしています。中長期的な経営戦略として、基幹ファンドであるバイアウトファンドのファンドレイズやSpring REITへの新規資産の組入れ、エネクス・インフラ投資法人などの新たな基幹ファンドの組成に注力し、基幹ファンドからの成功報酬の最大化、新ファンドの組成による管理報酬の底上げ、運営ファンドへの自己投資（セイムボート投資）の収益拡大を図る方針が示されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、バイアウト1号ファンドが保有株式の売却により成功報酬を計上する段階に入り、ファンド運用事業の営業収益が前期比19.6％増の4,637百万円となりました。同じファンドへのセイムボート投資を通じた自己投資事業の営業収益も前期比66.4％増の2,268百万円となり、営業収益全体の増加につながりました。",
        "basis": "MD&Aの経営成績の分析と、関連情報の製品及びサービスごとの情報に依拠します。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「クロスボーダー（国や地域を超えること、既存のビジネスの枠組みにとらわれずに挑戦すること）」をコンセプトに投資運用を行い、投資対象の性質により事業投資と資産投資に大別した複数の投資戦略を展開していることが示されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
