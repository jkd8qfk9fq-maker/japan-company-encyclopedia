  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-22",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営戦略（2024年12月期から2026年12月期）のもと、「持続可能な組織の実現」に向け、モノづくり、市場創出、技術の観点で取り組むとしています。市場創出では、新規事業に特化した新規事業創成本部を設置し、新しい事業の創出を加速するとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は25,385百万円と前期比0.7％増でした。照明機器事業は民間設備関連の産業用照明器具が増えて前期比3.9％増となった一方、コンポーネント事業は配線保護機材と配管保護機材の減少で前期比3.1％減、情報機器事業は前期比0.6％減と、事業ごとに動きが分かれました。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の経営成績の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "産業用照明機器では、防爆検定の第一号合格品となった実績を持ち、産業用照明機器の全シリーズで防爆エリアのオールLED化に対応できるラインアップをそろえています。コンポーネント事業では、10m法と3m法の電波暗室やシールドルームを備えたEMC Labを自社で運営し、部品の販売に加えて顧客の電磁両立性試験や対策支援まで一貫して提供できる体制を持っています。",
        "basis": "事業の内容における産業用照明機器と電磁波環境対策部品の記載と、沿革における防爆検定第一号合格の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客ごとの情報では、2025年12月期の主要な顧客として因幡電機産業（コンポーネント事業ほか）と東日本高速道路（情報機器事業ほか）が開示されています。配線保護機材の「カッチングダクト」は、1963年の発売以来、この業界で商品名が一般名称として使われていると事業の内容に記載されています。",
        "basis": "セグメント情報の関連情報における主要な顧客ごとの情報と、事業の内容における配線保護機材の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
