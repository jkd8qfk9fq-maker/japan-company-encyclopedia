  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2035年の長期ビジョン『建設プロダクトで、未来を築く』を定め、建設工業化のリーディングカンパニーを目指す姿としています。中期経営計画（2023年～2025年度）では「コア事業の強化・拡大」「グリーンイノベーションの推進」「経営基盤の強化・地域貢献」の3つの成長戦略に取り組み、自社工場での配管加工による、現場施工から工場製造へのトランスフォーメーションを進めています。2026年度を初年度とする中期経営計画も策定しています。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は、空調・衛生を中核とする設備工事の施工体制を工場製造へ移す工業化と、保守・メンテナンスや道の駅運営のような継続収益の積み上げです。新規受注を戦略的に抑制して品質・工期を優先する方針が示されており、量より収益性を重視する姿勢がうかがえます。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの経営成績の概況と受注方針の記載、経営方針の長期ビジョンと中期経営計画",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "受注方法別の比率では空調・衛生で特命が89.9％を占めるなど、指名による継続受注の比重が高いことが示されています。自社工場（総合設備工場・朝倉工場・プロダクトセンター）での配管加工を持ち、保守・点検は大和メンテナンスや埼玉ヤマト等のグループ会社が担う体制で、施工から維持管理までを一貫して提供しています。",
        "basis": "MD&Aの受注方法別比率と種類別売上高、事業の内容のグループ各社の役割、主要な設備の状況の自社工場の記載",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高54,327百万円のうち建設工事業が53,741百万円を占め、種類別では空調・衛生34,804百万円が最大です。売上は国内のみで、群馬県を中心とする北関東に支店網を持ち、官公庁と民間の双方から受注しています。商業施設運営業は585百万円と小さいものの、道の駅まえばし赤城は全国の道の駅評価で高い評価を得ています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域・主要顧客）、MD&Aの種類別売上高と道の駅の評価の記載",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
