  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2021年度に発表した「長期ビジョン2035」のもと、『オプティクス技術への貢献』『価値協創による新ビジネス創出』『価値創造力・効率性・収益力向上』の３つの経営方針を掲げ、既存事業の構造改革や新規事業の創出による企業価値向上に取り組んでいます。第116期（2024年10月期）に開始した中期経営計画（フェーズ２）では、経営基盤の強化、新規事業の探索、既存事業の深化を基本方針として、資本収益性の向上、ESG経営、新ビジネスの立ち上げに取り組んでいるとしています。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、1935年の創立以来続くガラス素材の生産技術と、光学ガラス素材の自社生産です。光学プレス品や光学ブロック品などの光学製品向け素材に加え、半導体露光装置向けの高均質光学ガラスや極低膨張ガラスセラミックス、石英ガラスといったエレクトロニクス向けの特殊ガラスも手がけており、二つの事業がともにガラス素材の技術を基盤としています。新規事業として、リチウムイオン伝導性ガラスセラミックス「LICGC」の製品ラインナップを持ち、電池メーカーへの採用拡大に取り組んでいます。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と収益の分解情報、事業の内容における事業区分と製品群の記載、沿革における創立の記載、経営方針における新規事業の記載に基づきます。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成は、光事業15,310百万円とエレクトロニクス事業13,585百万円の二つの事業が拮抗しています。地域別の売上高は日本が12,868百万円と最大で、中国、台湾、アジア、米国、ドイツなど海外にも販売しています。主要な顧客であるキヤノン株式会社への売上高は3,669百万円で、売上高全体の12.7％を占めています。",
        "basis": "セグメント情報における外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における販売実績の記載に基づきます。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
