  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針として、不動産・金融・アジアネットワークの結合をコアバリューとし、日本とアジアの国境を越えた資産運用と事業機会を創出することで、中長期的に成長・発展し続ける企業を目指すとしています。既存事業である不動産の管理、仲介、賃貸といった不動産サービス分野の規模拡大を図りながら、不動産販売事業と投資・アセットマネジメント・コンサルティング事業を新たな成長ドライバーとし、年度中に策定した中期経営計画に基づき投資・アセットマネジメント・コンサルティング事業の強化も進めるとしています。",
        "asOf": "2026-05-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、不動産販売事業でレジデンス物件の販売とマンションの買取再販が伸び、売上高は前期比35.5％増の4,541百万円となりました。基盤である不動産管理事業は安定的に推移し、新たに強化した投資・アセットマネジメント・コンサルティング事業も売上を計上し始めています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要と経営戦略の現状と見通しの記載に基づく",
        "asOf": "2026-05-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社分譲の投資用マンション「グリフィンシリーズ」を横浜・川崎エリアに集中供給してきたことで、エリア集中による賃貸管理業務の効率化と独自の入居者サービスを実現していると会社は述べています。あわせて、海外富裕層とのネットワークを活用した販売力を他社にない強みとして一層強化するとしています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の対処すべき課題と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営戦略の記載に基づく",
        "asOf": "2026-05-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "不動産業界では、住宅市場について建築費高騰に伴う販売価格の上昇の影響で購入需要から賃貸需要へのシフトが見られ、今後は建築資材の価格高騰や人件費の上昇に加えて金利上昇の影響が顕在化する可能性があるため、市場の動向に注視が必要と会社は述べています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の事業環境の記載に基づく",
        "asOf": "2026-05-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
