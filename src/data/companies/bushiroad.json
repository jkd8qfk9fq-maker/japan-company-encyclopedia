    "strategy": {
      "disclosed": {
        "text": "当社グループは、2025年8月に公表した「中期ビジョン2030」のもと、「自社IPの活性化および新規IPを創出する」「カードゲーム世界一を目指す」「海外進出を加速する」の3つのビジョンと、それを下支えする「もっと沢山体験してもらう」ことに取り組んでいます。2026年3月には、ビジョンとして「LIVE-MIXED ENTERTAINMENT」を掲げ、人と人とのリアルな接点が熱量を生むライブ体験を開発し続ける方針を示しています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "海外進出では、中国を中心とした東アジア及び北米を最重要地域と位置付け、Bushiroad EXPOを世界各地で開催して接点を広げており、2026年3月にはマレーシアに現地法人を設立するなど、海外拠点の整備が進められています。新規IPでは、2026年1月に発表した新規自社IP「ZERO RISE」に続き、2030年までに少なくともあと2本の立ち上げを目指す方針が示されています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の優先的に対処すべき課題における海外進出と新規IPの記載、【沿革】の海外現地法人設立の記載",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "IPの立ち上げからアニメやゲーム、音楽、MDといった多角的なコンテンツ展開までをグループ内でワンストップかつスピーディーに行える体制と、TCGの大会運営や音楽ライブ、プロレスの巡業など、人と人とのリアルな接点が熱量を生むライブ体験を創り出す力が強みとして示されています。「BanG Dream!」は、キャラクターの声を演じる声優が実際に楽器を演奏し生のライブ活動を行う発想から開発され、音楽活動、アニメ、TCG、モバイルゲーム、MDへ展開したIPとして説明されています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中長期的な会社の経営戦略における強みと「BanG Dream!」の記載、【事業の内容】のユニット構成",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "製品及びサービス別の外部顧客への売上高では、TCGが26,850百万円と最も大きく、次いでMDが9,144百万円、ライブエンタメが6,845百万円、スポーツが6,718百万円、デジタルゲームが5,990百万円となっています。地域別の売上高は日本が40,955百万円、米国が6,541百万円、アジアが8,221百万円、その他が2,105百万円であり、外部顧客への売上高の10％以上を占める主要な顧客はないとされています。",
        "basis": "セグメント情報等の関連情報における製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
