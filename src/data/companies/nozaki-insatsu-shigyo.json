  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「nozaki2024/2026“SHINKA”」を策定し、「進化」（アイデアと技術革新による新たな価値の創造）、「深化」（知識や技術に磨きをかけた組織・事業の成長）、「伸化」（時代の変化に対応した成長分野の市場開拓）の3つの「SHINKA」で企業価値の向上を目指すとしています。主な施策として、重点商品の売上成長、主力商品の競争優位性の強化、生産効率の改善によるローコストオペレーションの追求、人的資本の強化、資本効率の向上と資産効率の最適化を掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点は、包装資材及び紙器・紙工品と情報機器及びサプライ品という主力商品の売上成長に置かれ、「印刷×DX」や既存製品の高付加価値化によって価格競争やペーパーレス化の影響を抑える方向です。あわせて、生産現場の効率改善によるローコストオペレーションと資産効率の最適化を進めるとしています。",
        "basis": "経営方針に、中期経営計画の主な施策として重点商品の売上成長とローコストオペレーションの追求が掲げられ、財政状態及び経営成績の分析に「印刷×DX」や既存製品の高付加価値化の取り組みが記載されている事実に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "長年培った印刷技術に特殊加工や可変印字を付加することで、機能性に加えて意匠性やセキュリティレベルの高い商品を提供し、高付加価値の創出により既存事業の独自性・優位性を強化すると説明しています。可変印字や加飾技術の更なる向上や、産学連携の共同開発で生まれた秘匿性の高いオリジナル2次元コードを含むDX事業による付加価値の創出も掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "京都・関東・東北・北海道など全国に自社工場を持ち、製本・ラベル等の工程をグループ会社が担う分業体制があるため、商業印刷から包装資材、情報機器サプライ品までをグループ内で製造できる体制になっています。",
        "basis": "事業の内容に、連結子会社が製造・加工の一部を担う分業の位置づけが記載され、主要な設備に全国の工場の印刷・製版・製袋・製函設備が記載されている事実に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
