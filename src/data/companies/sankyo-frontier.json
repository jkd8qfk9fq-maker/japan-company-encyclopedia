  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期のビジョンとして「VISION2050」・「Mobile Spaceを世界の常識にし、ハピネスあふれる社会の実現に貢献する」を設定しています。サーキュラーエコノミーを実現できるモバイルスペースを世界中に提供すること、全国に200カ所を超える展示場とデジタルマーケティングを組み合わせた提案力のある営業体制の構築、トランクルームの店舗網の拡充とサービス開発に取り組んでいます。拡大するデータセンター需要に対応するコンテナ型データセンターなどの新製品の提供や、生産物流拠点の拡大による供給体制の強化も進めています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は、ユニットハウスの販売にレンタルやトランクルームなどの継続収益を積み上げることと、コンテナ型データセンターのような新しい用途の開拓です。展示場網とデジタルマーケティングを組み合わせた集客が需要の取り込みを支えています。",
        "basis": "経営方針の長期ビジョンと経営戦略等、MD&Aの経営成績の概況における店舗網拡充と新製品開発の記載、セグメント情報の事業構成",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社工場での生産から出荷整備・配送・建方・解体工事までをグループで担う一貫体制と、全国の工場・物流センター・展示場のネットワークが強みです。自社生産の一部をレンタル資産に振り替えて積み上げる方式で、販売とレンタルの双方に対応しています。",
        "basis": "事業の内容のグループ各社の役割、主要な設備の状況の工場・物流センター・展示販売場の記載、MD&Aの生産実績とレンタル資産増加実績",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高54,275百万円のうちユニットハウス事業が53,907百万円を占める単一セグメントの構成で、外部顧客への売上高は国内が90％を超えます。中国に原材料の製造子会社を持ち、ミャンマー、マレーシア、アメリカ、シンガポールに現地法人を置いて海外展開を進めています。",
        "basis": "セグメント情報（単一セグメントの旨）と関連情報（地域・主要顧客の省略基準）、MD&Aの販売実績、事業の内容の海外子会社の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
