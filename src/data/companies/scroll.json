  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業90周年となる2029年度までに達成すべき目標として中長期ビジョンを掲げ、ダイレクトマーケティング市場に限定せず事業領域の拡大に取り組むとともに、LPB（Logistics、Payment、BPO）に経営資源を集中し、「独自性を追求した収益力の強化」と「機動性のあるResponsibility経営の推進」を二大重点方針としています。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ソリューション事業では、ダイレクトマーケティングの事業運営に必要不可欠な機能をワンストップで提供できることを強みとし、物流代行での新規顧客の獲得、決済代行での貸倒リスクの低減に向けた取組み、SNSマーケティングを主軸とするマーケティングサポートの成長に取り組んでいます。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは通販事業、ソリューション事業、eコマース事業、グループ管轄事業の4つで、2026年3月期の外部顧客への売上高は通販事業が36,662百万円、ソリューション事業が36,418百万円、eコマース事業が15,179百万円、グループ管轄事業が288百万円です。主要な顧客は通販事業のコープデリ生活協同組合連合会で、売上高は9,616百万円です。地域ごとの情報は、本邦の外部顧客への売上高が連結売上高の90％を超えるため省略されています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報の主要な顧客ごとの情報・地域ごとの情報）の印字に基づきます。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
