  "history": [
    {
      "year": 1968,
      "title": "東亞医用電子として設立",
      "description": "1968年2月、東亞特殊電機が製造する血球計数装置の販売会社として、神戸市に東亞医用電子株式会社を設立しました。",
      "significance": "のちのシスメックスの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "医用電子機器の開発製造を譲り受け",
      "description": "1972年2月、東亞特殊電機の医用電子機器の開発製造部門の営業を譲り受けました。",
      "significance": "販売会社から、自ら開発・製造も行う会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1978,
      "title": "ブランドを「Sysmex」に変更",
      "description": "1978年2月、ブランド名を「Sysmex」（シスメックス）に変更しました。",
      "significance": "現在の社名につながるブランド名です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1980,
      "title": "ドイツに海外拠点を設立",
      "description": "1980年10月、ドイツに現地法人（現シスメックス ヨーロッパ エスイー）を設立しました。",
      "significance": "海外展開の最初期の拠点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1995,
      "title": "株式を上場",
      "description": "1995年11月に大阪証券取引所の市場第二部へ、1996年7月に東京証券取引所の市場第二部へ株式を上場しました。",
      "significance": "上場により資金調達と知名度の面で事業を広げる土台ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1998,
      "title": "社名をシスメックス株式会社に変更",
      "description": "1998年10月、社名をシスメックス株式会社に変更し、本社を神戸市中央区に移しました。",
      "significance": "ブランド名と社名がそろいました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "中国に拠点を設立し、東証・大証の第一部に指定",
      "description": "2000年1月に中国の上海に現地法人を設立し、同年3月に東京証券取引所と大阪証券取引所の市場第一部に指定されました。",
      "significance": "のちに主要市場となる中国への進出です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "遺伝子検査事業へ資本参加",
      "description": "2014年6月、個別化医療における遺伝子検査事業の発展のため、理研ジェネシスに資本参加しました。同社は2016年5月に追加取得して子会社になりました。",
      "significance": "検体検査機器・試薬に加え、遺伝子検査の分野へ事業を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東証プライム市場へ移行し、複数社を子会社化",
      "description": "2022年4月に東京証券取引所のプライム市場へ移行し、5月にアストレゴ ダイアグノスティックス（現シスメックス アストレゴ）、8月にピロート（現シスメックスピロート）を子会社化しました。",
      "significance": "買収により、診断の領域や事業の幅を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "東京に新たな研究開発拠点を開設",
      "description": "2023年10月、東京都江東区に研究開発拠点「ヘルスケア サイエンス ハブ トーキョー」を開設しました。",
      "significance": "神戸以外にも研究開発の拠点を持つようになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "インドに診断薬・機器の生産拠点を設立",
      "description": "2024年7月、インドに診断薬・機器の生産拠点を設立しました。",
      "significance": "アジア・パシフィックでの現地生産を進めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "グループ内の合併と生化学検査事業の承継",
      "description": "2026年4月、シスメックスメディカを吸収合併しました。また、日本電子の生化学検査事業を承継する新会社の株式を取得して子会社化し、シスメックス BioMajesty株式会社として事業を始めました。",
      "significance": "検査の分野を広げる動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
