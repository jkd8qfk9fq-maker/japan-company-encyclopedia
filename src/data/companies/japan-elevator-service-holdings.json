  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「何よりも安全のために。」「見えないからこそ手を抜かない。」「信頼を礎に。」のもと、特定メーカーの系列に属さない独立系のメンテナンス会社として、メーカー主導の価格体系を見直し「適正価格の実現」を目指すことを基本方針としています。中長期的な経営戦略として、地域ごとの事業子会社制とM&Aによるエリア拡大を含む保守・保全事業の推進、リニューアル事業の強化、人材の確保・育成、財務基盤の安定化の４つを掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "特定メーカーの系列に属さない独立系であるため、三菱電機ビルソリューションズ、日立ビルシステム、東芝エレベータ、日本オーチス・エレベータ、フジテックなど主要メーカー各社の機種を横断して保守できます。自社開発し特許を取得した遠隔監視システム「PRIME」と24時間365日体制のコントロールセンターによる監視体制に加え、地域ごとの事業子会社が拠点を置き、原則30分以内の到着を目標とするサービス体制を持ちます。",
        "basis": "【事業の内容】の保守・保全業務の体制（PRIME、コントロールセンター、対応メーカー）と、【経営方針、経営環境及び対処すべき課題等】の経営戦略に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のエレベーター等の設置台数は、マンション等のストック増加を背景に緩やかに増加しています。当社グループはメンテナンス事業の単一セグメントで、2026年３月期の売上高57,601百万円の内訳は、保守・保全業務が34,499百万円、リニューアル業務が21,801百万円、その他が1,300百万円であり、保守契約台数は約126,840台です。売上高の９割超が国内向けのため地域別の情報は省略され、売上高の10％以上を占める顧客はいません。",
        "basis": "MD&Aの経営成績の分析（売上高の種類別内訳、経営環境の記述）と、セグメント情報の関連情報（地域ごとの情報、主要な顧客ごとの情報の省略理由）に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
