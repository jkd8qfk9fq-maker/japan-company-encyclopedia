  "history": [
    {
      "year": 1935,
      "title": "関東重工業として設立",
      "description": "1935年3月、軍需品、自動車や航空機の部品、金属器の製造販売を目的に、東京市で関東重工業株式会社が設立されました。",
      "significance": "現在のフタバ産業の出発点です。1935年から1945年までの記録は戦災で失われ、詳細は分かりません。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1946,
      "title": "フタバ産業に社名変更",
      "description": "1946年2月に社名をフタバ産業株式会社に変更し、愛知県岡崎市で漁網機の製作とパイプ製家具の生産を行いました。",
      "significance": "現在の社名になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1948,
      "title": "自動車部品の生産を開始",
      "description": "1948年5月に自動車部品と溶接機の生産を始めました。",
      "significance": "後に主力となる自動車部品づくりに入った時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1986,
      "title": "東京・名古屋の市場第一部に上場",
      "description": "1986年9月に東京証券取引所と名古屋証券取引所の市場第一部に株式を上場しました。",
      "significance": "1968年の名古屋、1980年の東京の市場第二部上場を経た、第一部への上場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "米国に初の海外拠点を設立",
      "description": "1994年11月に米国イリノイ州でFICアメリカ株式会社を設立しました。",
      "significance": "この後、英国、カナダ、チェコ、中国、インドなどに生産拠点を広げていきます。",
