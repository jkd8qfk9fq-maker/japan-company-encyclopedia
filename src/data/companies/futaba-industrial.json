  "history": [
    {
      "year": 1935,
      "title": "関東重工業として設立",
      "description": "1935年3月、軍需品、自動車や航空機の部品、金属器の製造販売を目的に、東京市で関東重工業株式会社が設立されました。",
      "significance": "現在のフタバ産業の出発点です。1935年から1945年までの記録は戦災で失われ、詳細は分かりません。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1946,
      "title": "フタバ産業に社名変更",
      "description": "1946年2月に社名をフタバ産業株式会社に変更し、愛知県岡崎市で漁網機の製作とパイプ製家具の生産を行いました。",
      "significance": "現在の社名になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1948,
      "title": "自動車部品の生産を開始",
      "description": "1948年5月に自動車部品と溶接機の生産を始めました。",
      "significance": "後に主力となる自動車部品づくりに入った時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1986,
      "title": "東京・名古屋の市場第一部に上場",
      "description": "1986年9月に東京証券取引所と名古屋証券取引所の市場第一部に株式を上場しました。",
      "significance": "1968年の名古屋、1980年の東京の市場第二部上場を経た、第一部への上場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "米国に初の海外拠点を設立",
      "description": "1994年11月に米国イリノイ州でFICアメリカ株式会社を設立しました。",
      "significance": "この後、英国、カナダ、チェコ、中国、インドなどに生産拠点を広げていきます。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "国内で菱和金属工業を買収",
      "description": "2004年3月に愛知県知立市の菱和金属工業株式会社を買収し、同年4月に株式会社フタバ知立へ社名を変えました。2006年4月には吸収合併して知立工場にしました。",
      "significance": "買収した会社は、のちに知立工場として会社に取り込まれました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "インドネシアに子会社を設立",
      "description": "2011年12月にインドネシアのブカシ県で株式会社フタバインダストリアルインドネシアを設立しました。",
      "significance": "アジアでの生産拠点の一つで、現在も連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "第三者割当増資を実施",
      "description": "2017年2月に第三者割当増資を行いました。同月、インドにフタバインダストリアルグジャラート株式会社を設立しました。",
      "significance": "資本金の変更と、インドの拠点の追加があった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "プライム市場・プレミア市場へ移行",
      "description": "2022年4月に東京証券取引所のプライム市場、名古屋証券取引所のプレミア市場へ移行しました。",
      "significance": "市場区分の見直しによる移行です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "情報機器事業から撤退",
      "description": "2024年3月に情報機器事業から撤退しました。",
      "significance": "1961年に新分野として始めた事務機器部品の生産に関わる事業から退きました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "フタバ須美を吸収合併",
      "description": "2025年4月に株式会社フタバ須美を吸収合併し、須美工場として再編しました。",
      "significance": "子会社を工場に取り込んだ国内の再編です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "天津双協機械工業を売却",
      "description": "2026年2月に中国の天津双協機械工業有限公司を売却しました。",
      "significance": "2002年に天津市で設立した会社の売却です。",
      "sourceIds": [
