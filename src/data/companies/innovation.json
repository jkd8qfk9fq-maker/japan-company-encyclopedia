  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションに「『働く』を変える」を掲げ、営業・マーケティング・テクノロジーのノウハウを活用して法人営業の新しいスタイルを創造することをコンセプトに事業拡大に努めています。既存事業の規模拡大に取り組むと同時に、顧客資産と蓄積したノウハウを活用して事業内容の多様化と収益基盤の拡大、認知度の向上を推進する方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「ITトレンド」は2026年3月31日現在で408のサービスカテゴリーに4,501社・8,377製品が掲載される比較サイトで、掲載企業は資料請求1件ごとの成果報酬で見込み顧客情報を入手できます。ITソリューション事業では、大規模企業向けの「SHANON MARKETING PLATFORM」と育成効率化向けの「List Finder」という機能と顧客層の異なる2つのマーケティングオートメーションツールをそろえています。",
        "basis": "【事業の内容】における「ITトレンド」の掲載状況と特徴、ITソリューション事業のサービス構成の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の過半をオンラインメディア事業が占め、ITソリューション事業は株式会社シャノンの連結子会社化により第2の柱に成長しました。金融プラットフォーム事業とVCファンド事業は規模は小さいものの、法人営業支援という中核領域の周辺で事業の多様化を担っています。",
        "basis": "セグメント情報の外部顧客への売上高の構成（2026年3月期）に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
