  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業ターゲットを世界に置き、新製品開発と既存製品のバージョンアップ開発に注力するとともに、海外での販売拡大を図り、世界市場をマーケットとしたグローバル企業を目指しています。中長期の経営戦略として、世界市場での販売拡大のためのサービス拠点の充実、新製品開発や事業提携・買収も視野に入れた事業領域の拡大、株主価値の向上を掲げています。",
        "asOf": "2026-07-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ハンドナットランナは、パルス制御技術（日本・米国で特許取得）により、高い締め付けトルクでも手にかかる反力を軽減し、手持ちの工具でナットランナと同等の締め付け精度管理を実現しています。ネジ締め付け理論に基づき、ネジが緩まない締め付け管理を行う点も特徴です。",
        "basis": "【事業の内容】のハンドナットランナの説明と用語説明（パルス制御技術、ネジ締め付け理論）の記載に基づく",
        "asOf": "2026-07-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "製品は生産設備の一部を構成するため、主な顧客である自動車産業の設備投資動向の影響を受けやすい事業です。2026年3月期は海外売上高が売上高全体の67.6％を占め、国内を上回っています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の対処すべき課題と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の地域別売上高の記載に基づく",
        "asOf": "2026-07-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
