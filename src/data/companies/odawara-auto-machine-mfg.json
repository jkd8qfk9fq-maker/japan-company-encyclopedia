  "history": [
    {
      "year": 1950,
      "title": "前身の有限会社小田原鉄工所が設立",
      "description": "富士写真フイルム株式会社の下請け事業として、補修用機械部品の製作や生産設備のメンテナンスを行う目的で、神奈川県小田原市に有限会社小田原鉄工所が設立されました。",
      "significance": "現在の小田原機器の前身となる会社です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1952,
      "title": "株式会社小田原鉄工所へ改組",
      "description": "有限会社小田原鉄工所が株式会社小田原鉄工所へ改組しました。",
      "significance": "株式会社としての事業体制が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "湘南興業から営業権を買取り、ワンマンバス機器の一貫体制が整う",
      "description": "神奈川中央交通株式会社の子会社でワンマンバス製品の販売会社である湘南興業株式会社から営業権を買い取り、ワンマンバス機器の設計、製造、販売の一貫体制が整いました。これに先立ち、湘南興業からの委託を受けて軟券式整理券発行機を開発し生産していました。",
      "significance": "主力であるワンマンバス機器事業が本格化する転機になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1971,
      "title": "硬貨循環式運賃箱を発売",
      "description": "運賃として投入した硬貨を両替用の種銭として再利用する、当時の類似する他社製品にはない構造を持った「硬貨循環式運賃箱」を発売しました。",
      "significance": "後の運賃箱事業の基礎を築いた製品です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1977,
      "title": "紙幣自動両替機付き運賃箱を発売",
      "description": "独自に開発した紙幣両替機の紙幣判別技術を運賃箱に応用した、業界初の「紙幣自動両替機付き運賃箱」を発売しました。",
      "significance": "紙幣、硬貨、カード関連の処理技術を蓄積する節目になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1979,
      "title": "株式会社小田原機器が設立",
      "description": "組織を効率的に運営するため、株式会社小田原鉄工所が機器事業部を分社化して株式会社小田原機器を神奈川県小田原市に設立し、当社は機器事業部の営業権の譲渡を受けてワンマンバス機器関連の事業を引き継ぎました。",
      "significance": "現在の小田原機器が発足した年です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "オーバルテックを設立",
      "description": "内製化の強化のため、神奈川県小田原市に100％子会社の株式会社オーバルテック（現連結子会社）を設立しました。",
      "significance": "グループ体制が始まり、現在のメンテナンスサービスを担う子会社が加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "ジャスダック証券取引所へ上場",
      "description": "ジャスダック証券取引所へ株式を上場しました。",
      "significance": "上場会社としての歩みが始まりました。",
