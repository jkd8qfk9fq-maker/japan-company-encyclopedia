  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「Vision2035」として、2035年にありたい姿を「人々の『清潔』で『健康』な暮らしを支えるインフラ企業として、“健康長寿社会”の実現に貢献する」と掲げています。2026年3月期から2028年3月期を計画期間とする中期経営計画では、この3年間を収益性向上と新たな価値創出に向けた種まきのフェーズと位置付け、事業構造の改革、新規事業の開発、グループシナジーの創出と最大化、人的資本への投資、バランスの取れた成長投資と株主還元を基本方針としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "レンタルで回収した商品を洗浄して再製品化する仕組みと、医療・介護の現場でリネンサプライや介護用品、給食、調剤など複数の事業を組み合わせて提供する点が強みです。",
        "basis": "【事業の内容】のレンタル事業の説明と、経営方針の複数の事業を有機的に結合させる旨の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "健康生活サービスが2026年3月期の売上高の約半分を占め、調剤サービスが4割近くを占めます。シルバー事業と寝具・リネンサプライ事業を成長けん引事業と位置付け、M&Aによる拡大を進めています。",
        "basis": "セグメント情報の外部顧客への売上高（2026年3月期）と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
