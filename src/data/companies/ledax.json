  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業セグメントの無限化・多様化・スピード化による成長戦略を掲げ、投資事業、金融事業、不動産事業、Ｍ＆Ａコンサルタント事業を積極的に推進するとともに、お客様から仕入れた良質な車両を次のお客様へ直接小売販売する「買取直販」の推進や、株式会社アガスタを通じた中古車輸出事業の拡大に取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客から買い取った車両を直接次の顧客へ販売する「買取直販」のモデルに加え、保証やメンテナンスパッケージなどの付帯サービスと、車検や保険など納車後のアフターサービスを通じて、購入後も継続的に取引する関係を築いている点が強みです。海外では子会社を通じた輸出網とオンラインの在庫連携を活用しています。",
        "basis": "経営成績等の状況の概要における自動車流通事業の取組と、経営方針における対処すべき課題の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の中古車登録台数は2026年3月期に約546万台と印字されており、当社グループの売上高の大部分は自動車流通事業で、2026年3月期の外部顧客への売上高は19,715百万円です。地域別では日本が15,945百万円、アジアが2,745百万円など、輸出を含む海外への販売も行っています。",
        "basis": "セグメント情報における外部顧客への売上高、関連情報における地域ごとの売上高、経営成績の分析における中古車登録台数の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
