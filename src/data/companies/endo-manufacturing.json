  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期の経営戦略として『事業ポートフォリオの再構築』『経営基盤の強化』『資本効率の向上』の3つのテーマを掲げ、新技術の導入やM&A、アライアンスの活用による新たな価値の創造、生産コストの最適化と品質の安定化による市場拡大に取り組むとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は日亜鍛工株式会社を連結子会社化したことでメタル事業が最大の事業となり、建設機械関連部品や発電用タービンブレードなどの大型鍛造品へ事業領域が広がりました。",
        "basis": "セグメント情報の外部顧客への売上高、関係会社の状況、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "鍛造製法と塑性加工技術を中核技術とし、ゴルフクラブヘッドで培った鍛造・機械加工・研磨の技術を、人工関節等の医療機器部品や航空機部品にも展開しています。タイに子会社3社の工場を持ち、海外生産を組み合わせた供給体制を築いています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等、主要な設備の状況の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ファインプロセス事業では住友ゴム工業とIHIが主要な顧客として開示され、両社向けの販売が売上高の2割強を占めています。メタル事業のメタルスリーブ製品は、日本を含むアジア地域を中心に販売されています。",
        "basis": "セグメント情報等の主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の相手先別販売実績、事業の内容の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
