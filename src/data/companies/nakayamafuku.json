  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年5月に策定した「中山福グループ 新中期経営計画 NFG2026」のもと、卸売事業の拡充、ものづくり事業の強化、EC事業の拡大、物流機能の強化の4つを経営戦略として推進しています。2025年3月の創業100周年を経て、事業持株会社体制の推進によるグループガバナンスの向上にも注力しています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の9割以上を家庭用品卸売事業が占め、製造・販売を行う3事業はいずれも小規模です。そのため戦略の中心は卸売事業の拡充にあり、ものづくり事業の強化は連結子会社を通じた自社オリジナル商品の拡大として位置づけられています。",
        "basis": "セグメント情報の外部顧客への売上高（家庭用品卸売事業39,486百万円／連結売上高430億52百万円）と、経営成績等の状況の概要における事業別の記述に基づきます",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "卸売事業の強みを再構築するため、全国における販売網と調達網から得られる情報の活用を掲げ、安定的に消費者へ商品を届けられる販売体制・物流体制の維持・構築を進めています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "本社が取り扱う商品について包括的な戦略を立案し、国内9ヶ所の支店・営業所が地域ごとに販売業務と物流業務を担う体制で、調理用品からヘルスケア・シニア・ベビー用品等まで8つの商品分類を幅広く取り扱っています。",
        "basis": "主要な設備の状況（国内9ヶ所の支店・営業所の印字）と、製品及びサービスごとの情報（8つの商品分類の印字）に基づきます",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "家庭用品の卸売が中心のグループで、2026年3月期は主要な顧客である株式会社ドン・キホーテ向けの売上高が家庭用品卸売事業の区分で開示されています。製造系の事業は、プラスチック日用品、インテリア用品、家庭用品の製造・販売の3つに分かれています。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報（株式会社ドン・キホーテ向け4,618,211千円の印字）、製品及びサービスごとの情報に基づきます",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
