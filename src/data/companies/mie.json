  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「顧客・市場から評価され得る経営品質の創造」「グループの成長・発展を目指す一体運営の実践」「株主・社員・社会への調和のとれた成果の還元」の3つを経営の柱としています。新中期経営計画「Harvesting the future ～成長を収穫し、未来を拓く～」のもと、「既存事業の強靭化」と「半導体分野などの成長分野への参入」を優先的に対処すべき課題に掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金属加工の原点であるプレス加工をはじめとする製造技術と品質管理体制を備え、技術力・品質力を生かしたモノづくりで、付加価値の高い受注品の獲得を目指しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等に印字された製造技術・品質管理体制と企業価値の源泉に関する記述",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ステンレス製管継手業界では、各業界において設備投資等が行われたことから需要は堅調に推移しましたが、調達価格は上昇傾向にあります。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営成績等の分析に印字された業界の需要と調達価格の記述",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
