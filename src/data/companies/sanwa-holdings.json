  "history": [
    {
      "year": 1956,
      "title": "三和シヤッター製作所を設立",
      "description": "兵庫県尼崎市に株式会社三和シヤッター製作所を設立し、シャッターの製作・販売を始めました。",
      "significance": "現在のグループの事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "合併し三和シヤッター工業に商号変更",
      "description": "株式額面の変更のため株式会社三和工業所に吸収合併され、商号を三和シヤッター工業株式会社に改めました。同年9月に東京証券取引所市場第二部に上場しました。",
      "significance": "実質上の存続会社である三和シヤッター製作所の営業を引き継ぎ、上場会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1974,
      "title": "ドアとオーバーヘッドドアの製造を開始",
      "description": "三和ドアー工業株式会社を吸収合併してドアの製造・販売を始め、8月にはオーバーヘッドドアの製造・販売も始めました。",
      "significance": "シャッターだけでなく、ドアにも製品を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1982,
      "title": "24時間フルタイムサービスを開始",
      "description": "24時間対応のフルタイムサービス（FTS）を始めました。",
      "significance": "取り付け後のサービスを、年中無休の体制で提供する取り組みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "米国でOverhead Door Corporationを買収",
      "description": "米国に持株会社Sanwa USA Inc.を設立し、Overhead Door Corporationを買収しました。",
      "significance": "北米事業の土台になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "欧州でNovofermグループを買収",
      "description": "欧州に持株会社などを設立し、Novoferm GmbHほかNovofermグループ9社を買収しました。",
      "significance": "欧州事業の土台になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "持株会社へ移行し三和ホールディングスに商号変更",
      "description": "会社分割により持株会社へ移行し、ビル商業施設建材事業、住宅建材事業、メンテ・サービス事業を三和シヤッター株式会社に承継しました。当社は三和ホールディングス株式会社に、三和シヤッター株式会社は三和シヤッター工業株式会社に商号を変更しました。",
      "significance": "現在の持株会社体制が始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "Wayne Dalton Corporationのドア事業等を取得",
      "description": "Overhead Door Corporationが、Wayne Dalton Corporationのドア事業等を取得しました。なお同年5月に大阪証券取引所市場第一部の上場を廃止しています。",
      "significance": "北米のドア事業を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "北米で自動ドア事業を強化",
      "description": "Overhead Door Corporationが新たに設立したDoor Services Corporationで、Automatic Door Enterprises, Inc.ほか5社の自動ドア事業を取得しました。",
      "significance": "北米で自動ドアの事業を強めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "監査等委員会設置会社へ移行",
      "description": "6月に監査役会設置会社から監査等委員会設置会社へ移行しました。",
      "significance": "経営の監督体制を変えました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "鈴木シャッターなどの株式を取得",
      "description": "9月に株式会社LIXIL鈴木シャッターほか2社の株式を取得しました（現 株式会社鈴木シャッター）。同年6月にはNovofermグループがRobust ABほか4社の株式を取得しました。",
      "significance": "国内とアジアの事業基盤、北欧・英国のドア事業を強めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "北米でGold Arc, Inc.を取得",
      "description": "5月にOverhead Door CorporationがGold Arc, Inc.の株式を取得し、北米の自動ドアサービス事業を強めました。",
      "significance": "北米のサービス事業の拡大が続いています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
