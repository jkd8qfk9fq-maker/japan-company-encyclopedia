  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「中長期ビジョン2028 ～期待の先をカタチに～」を掲げ、2026年3月期から2029年3月期までの「ステージⅢ」では、既存事業の収益拡大、防災周辺領域や隣接業界へのM&Aによる事業の拡大、新規事業の創出を重点施策とし、2029年3月期の連結売上高170,000百万円以上を目指しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「防災事業のパイオニアとしての使命に徹し、社会の安全に貢献する」ことを社是とし、研究開発からメンテナンスまでの一貫体制の下で、災害から生命・財産を守るための防災システムを提供し続けることを経営理念としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高では、火災報知設備が全体の約37％、消火設備が約34％、保守点検等が約26％を占めます。本邦の外部顧客への売上高が連結売上高の90％を超え、売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と、関連情報（地域ごとの情報・主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
