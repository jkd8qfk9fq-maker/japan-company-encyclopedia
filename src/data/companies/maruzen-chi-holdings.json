  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループビジョンは「知の生成と流通に革新をもたらす企業集団となる」です。中期経営計画では「グループ資産の活用促進」「成長領域の創出」「収益構造の転換」の3点を基本方針とし、2029年1月期の売上高1,850億円を目標としています。",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「丸善」「ジュンク堂書店」の書店網と、大学・図書館との取引基盤を持ちます。2026年1月末時点で店舗数は116店舗、図書館の受託館数は1,851館です。デジタルアーカイブシステム「ADEAC」など、図書館向けのデジタルサービスも手がけています。",
        "basis": "【事業の内容】及び【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年1月期の売上高は185,053百万円で、店舗・ネット販売事業が81,776百万円と最も大きく、文教市場販売事業が49,196百万円、図書館サポート事業が39,272百万円です。本邦の外部顧客への売上高が90％を超えています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
