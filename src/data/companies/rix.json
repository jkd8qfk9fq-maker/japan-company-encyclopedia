  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度から中期3ヵ年計画「GP2026（RIX Growth Plan）」に取り組んでいます。あるべき姿を「世界中のものづくりの課題解決屋になる」とし、ビジネス領域の拡大、収益性の向上、人材・組織の強化、ステークホルダーリレーションズの充実を4つの軸として、2026年度の定量目標に連結売上高600億円を掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "経営方針では、業績が国内製造業の設備投資と生産活動に依拠していることを示したうえで、国内市場の縮小に備えた海外での地産地消の推進や、メーカー商社を「協創型」と再定義する方向を示しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】における経営環境の認識と対処すべき課題の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "仕入販売を行う商社事業と、自社で製品を作る自社製品事業を併せ持つメーカー商社であり、トライボロジ技術と高圧・精密洗浄技術を核に、回転継手や高圧・精密洗浄装置などの自社製品を展開しています。販売だけでなく、修理・再生やメンテナンスにも対応していることが事業の内容と業界別の営業活動に示されています。",
        "basis": "【事業の内容】の商社事業・自社製品事業の記載と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の業界別の営業活動の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、鉄鋼向けが15,822百万円で最も大きく、自動車向けが12,179百万円、電子・半導体向けが7,858百万円と続いています。地域別では日本が49,054百万円と大半を占めています。主要な顧客ごとの情報には、日本製鉄が販売先として掲載されています。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高と、関連情報の地域ごとの情報及び主要な顧客ごとの情報",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
