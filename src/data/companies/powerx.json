  "updatedAt": "2026-11-22",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「永遠に、エネルギーに困らない地球」というビジョンのもと、「日本のエネルギー自給率の向上を実現する」というミッションを掲げ、再生可能エネルギーの主力電源化に伴って高まる調整力への需要に応える蓄電池製品とサービスを展開し、脱炭素時代を担う次世代型のエネルギー企業を目指すとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は前期比213.4％増の19,306百万円となりました。BESS事業の外部顧客への売上高が17,102百万円と全体の大部分を占めており、大型定置用蓄電システムの販売が成長を支えています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の主要な顧客ごとの情報、MD&Aの経営成績の概要",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "蓄電池製品の設計、製造、ソフトウエア開発、メンテナンスのすべてを日本で行い、蓄電池の運用管理プラットフォーム「Power OS」を自社で開発しています。「PowerX Mega Power」には最長20年間の容量保証が付帯するなど、販売後の保守や運用のサポートを含めた提供体制を整えています。",
        "basis": "事業の内容（国内での製造体制と自社開発プラットフォーム）、経営方針、経営環境及び対処すべき課題等の蓄電製品の説明、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "政府の第7次エネルギー基本計画では、2040年度に再生可能エネルギーを最大の電源とする指針が示されており、電力の安定供給に必要な調整力を担う蓄電池への需要の拡大が見込まれています。当社グループは、定置用蓄電池の市場が拡大する中で、大型から中型までの蓄電システムと、蓄電池を使った電力サービスを展開しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境と事業環境、MD&Aの経営成績の概要、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
