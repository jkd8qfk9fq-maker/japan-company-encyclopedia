  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年１月期からの３か年の中期経営計画を策定し、「いつもの毎日に、彩りとよろこびを。」をスローガンに、長期ビジョン「ファッションの力で、ライフスタイルの新たな可能性を開く。」の実現に向け、アパレルとライフスタイルの両輪で収益力の向上に取り組むとしています。アパレル卸売では専門店向け販売の拡大、機能性ファッション「クロスファンクション」の重点拡大、成長の柱としてのメンズ商品の育成を進め、小売では雑貨ショップの展開とアパレル店舗への雑貨比率の引き上げ、ＥＣではＳＮＳやライブコマースを活用した販促強化によるＥＣ売上の拡大を図るとしています。ライフスタイル卸売では、シーズン雑貨ブランド「Yoki」に加え、ビューティー分野でのネイルの新ブランド立ち上げや、ヘルスケア分野でのリカバリーウェア等の新商品開発を進めるとしています。",
        "asOf": "2026-04-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "婦人服業界トップクラスの企画・生産力を持ち、年間5,000万枚の商品を製造しているとしています。中国やアセアンの海外有力工場との取組みによる生産体制と、海外での検品と国内自社センターを連携させた物流ネットワークによるグローバルなサプライチェーンが事業を支えています。卸売に加えて直営店舗とＥＣの小売チャネルを持ち、グループ会社がメンズ衣料と化粧品で事業領域を補完しています。",
        "basis": "経営方針（経営戦略）および事業の内容の記載に基づく。",
        "asOf": "2026-04-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "セグメント情報の記載は省略されており、単一の製品・サービスの区分の外部顧客への売上高が連結売上高の90％を超え、本邦の外部顧客への売上高も90％を超えています。2026年１月期の部門別売上高はアパレル卸売44,202百万円、小売12,656百万円、ライフスタイル卸売2,577百万円、その他416百万円で、販売チャネル別では専門店27,536百万円、量販店20,956百万円、無店舗5,306百万円、ＥＣ3,244百万円です。最大の顧客は株式会社しまむらで、売上高は17,893百万円（構成比29.9％）です。アパレル業界は、残暑や暖冬の影響と、原材料価格の高騰を背景とした消費者の生活防衛意識の高まりにより、厳しい経営環境が続いているとされています。",
        "basis": "セグメント情報等（主要な顧客ごとの情報）、経営成績の分析（事業部門別・販売チャネル別の販売実績）および経営方針（経営環境）の記載に基づく。",
        "asOf": "2026-04-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
