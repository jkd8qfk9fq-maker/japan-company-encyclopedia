      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "クオリスケアセンターを開設",
      "description": "訪問介護と居宅介護を行う「クオリスケアセンター」を、大阪市城東区、生野区を含む6か所で開設し、うち3か所で居宅介護支援事業を開始しました。",
      "significance": "介護福祉事業の始まりです。",
      "sourceIds": [
