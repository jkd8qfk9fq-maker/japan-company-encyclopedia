    },
    {
      "year": 2007,
      "title": "人材派遣事業を開始",
      "description": "株式会社クオリスが人材派遣事業を開始しました。",
      "significance": "現在の人材派遣事業につながる開始です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "保育事業に参入",
      "description": "認可保育所「クオリスキッズ鴨居駅前保育園」（横浜市都筑区）を開設し、保育事業に参入しました。",
      "significance": "現在の主力事業である保育事業への参入です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "大阪市で株式会社による認可保育所を開設",
      "description": "大阪市では初となる、株式会社が設立する認可保育所「クオリスキッズ北梅田保育園」（大阪市北区）と、小規模認可保育所「クオリスキッズ中津三丁目保育園」（大阪市北区）を開設しました。また、兵庫県尼崎市に株式会社ダウインを設立し、株式会社クオリスから人材派遣事業を移管しました。",
      "significance": "保育事業の拡大と、人材派遣事業の子会社への移管です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "株式会社エルサーブを設立",
      "description": "介護事業を目的として、兵庫県尼崎市に株式会社エルサーブを株式会社クオリスの100％子会社として設立しました。",
      "significance": "介護福祉事業の展開体制の拡充です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "ＱＬＳホールディングスを設立し株式を上場",
      "description": "株式移転により、株式会社クオリスと株式会社ダウインを完全子会社とする純粋持株会社として、株式会社ＱＬＳホールディングスを大阪市阿倍野区に設立しました。同年、株式会社エルサーブが企業主導型保育事業の運営受託を開始して株式会社ＬＥＡを合併し、東京証券取引所TOKYO PRO Marketに株式を上場しました。",
      "significance": "現在の持株会社体制の成立と、株式の上場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "名古屋証券取引所ネクスト市場に上場",
      "description": "名古屋証券取引所ネクスト市場に株式を上場しました。また、株式会社ＱＬＳホールディングスが孫会社であった株式会社エルサーブの株式の100％を取得して子会社とし、株式会社和みと株式会社ふれあいタウンの株式の100％を取得して子会社としました。株式会社クオリスは、大阪市では株式会社として初となる公立保育所の民間委託を受けました。",
      "significance": "上場の拡大と、株式取得による介護福祉事業の拡大です。",
