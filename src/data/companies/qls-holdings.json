  "history": [
    {
      "year": 2005,
      "title": "有限会社クオリスを設立",
      "description": "介護事業を目的として、大阪市都島区に有限会社クオリス（現・株式会社クオリス）を設立しました。",
      "significance": "現在のQLSグループの起源です。",
      "sourceIds": [
