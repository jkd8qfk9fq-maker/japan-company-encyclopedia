  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年中期経営計画において、中長期ビジョンを「未来の社会生活基盤と地球環境を護る」とし、中期経営方針を「グループの変革と持続的成長により新たな価値を創出し、持続可能な社会に貢献する」と定め、「コア事業の収益力向上」と「付加価値創造に向けた経営基盤強化」の両輪で既存事業の強化と成長分野の伸長を目指すとしています。",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、2024年中期経営計画で定めた重点課題である販路拡大や研究開発に取り組みつつ、一部の工場の休止や製造ライン集約、より需要のある事業への転換等の生産体制の再整備を開始し、政策保有株式の縮減にも取り組んだと開示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における中期経営計画の記載、MD&Aにおける経営成績等の状況の概要の記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、コンクリート二次製品事業（26,906百万円）と基礎事業（22,013百万円）の2事業を軸に、パイル・ポール・土木製品の製造から杭打工事・地盤改良工事、製品の輸送までをグループで担える体制にあります。ＮＣ式コンクリートポールやＨｙｐｅｒ－ＭＥＧＡ工法など、独自工法の許容支持力について国土交通大臣認定を重ねてきた技術基盤も有しています。",
        "basis": "事業の内容における事業区分と構成会社の記載、セグメント情報における外部顧客への売上高の記載、沿革における工法認定の記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "地域別の売上高は本邦の外部顧客への売上高が90％を超えるため開示が省略されており、国内中心の構成です。コンクリートパイルの全国需要は低調であった前年同期と概ね横這いで推移し、コンクリートポールの全国出荷量は減少が続くなど、厳しい市場環境が継続していると開示されています。売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント情報等の関連情報（地域ごとの情報・主要な顧客ごとの情報）の記載、MD&Aにおける経営成績等の状況の概要の記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
