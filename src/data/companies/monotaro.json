  "history": [
    {
      "year": 2000,
      "title": "住商グレンジャー株式会社として設立",
      "description": "2000年10月、工場用間接資材の通信販売業を目的として、大阪市西区で住友商事株式会社とGrainger International, Inc.の共同出資により設立されました。",
      "significance": "現在のMonotaROの出発点で、のちに親会社となる米国Graingerグループとの関係もここから始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "インターネット通販を開始",
      "description": "2001年11月、インターネットによる工場用間接資材の通信販売事業を始めました。その後、取扱商品を広げています。",
      "significance": "店舗を持たず、ウェブで受注する現在の営業形態の始まりです。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "社名を株式会社MonotaROに変更、個人向けサイトを開設",
      "description": "2006年2月に社名を株式会社MonotaROに変更しました。同年6月には個人消費者向けの専用ウェブサイトを開き、個人への販売も始めています。このサイトは2020年9月に事業者向けウェブサイト「モノタロウ」に統合されました。",
      "significance": "現在のブランド名の社名が決まり、販売先が個人にも広がった年です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "東京証券取引所マザーズに上場",
      "description": "2006年12月に東京証券取引所マザーズへ株式を上場し、2009年12月に市場第一部へ変更しました。2022年4月には市場区分の見直しでプライム市場に移行しています。",
      "significance": "上場後、市場区分の変更を経て現在のプライム市場に至る流れです。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "W.W.Grainger, Inc.が親会社になる",
      "description": "2009年9月、Grainger Japan, Inc.による当社株式の取得で、W.W.Grainger, Inc.が発行済株式総数の過半数を間接的に所有することになり、親会社となりました。2019年3月のグループ内再編後は、Grainger Global Holdings, Inc.が過半数を直接保有しています。",
      "significance": "米国の間接資材販売大手が親会社となり、現在まで続く資本関係ができました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "韓国に子会社NAVIMROを設立",
      "description": "2013年1月、NAVIMRO Co., Ltd.（現 連結子会社）を設立しました。同月、株式会社K-engineの全株式を譲渡しています。",
      "significance": "海外展開の最初の拠点で、韓国での事業は現在も連結子会社が担っています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "インドネシアの会社の株式を取得",
      "description": "2016年8月、PT Sumisho E-Commerce Indonesia（現 PT MONOTARO INDONESIA）の株式を取得し、連結子会社としました。",
      "significance": "東南アジアに事業を広げた出来事です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "笠間ディストリビューションセンターを開設",
      "description": "2017年4月、茨城県笠間市に笠間ディストリビューションセンターを開設しました。翌月には多賀城ディストリビューションセンターを閉鎖しています。",
      "significance": "物流拠点の入れ替えを進め、出荷体制を整えた時期です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "インドの会社の株式を取得",
      "description": "2020年11月、IB MONOTARO PRIVATE LIMITED（現 連結子会社）の株式を取得しました。",
      "significance": "インドにも事業を広げました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "猪名川ディストリビューションセンターを開設",
      "description": "2022年4月、兵庫県猪名川町に猪名川ディストリビューションセンターを開設しました。2023年4月には2期の稼働を始めています。2022年12月には尼崎ディストリビューションセンターを閉鎖しました。",
      "significance": "主力の物流拠点が尼崎から猪名川に移った節目です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "本社を大阪市北区梅田へ移転",
      "description": "2023年11月、本社を大阪市北区梅田へ移しました。",
      "significance": "兵庫県尼崎市から大阪市中心部へ本社が移りました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "インドの開発会社・中国の調達支援会社・マスク製造会社を設立",
      "description": "2025年4月にMONOTARO TECHNOLOGIES INDIA PRIVATE LIMITED、同年11月に物太郎（上海）貿易有限公司と新三光マスク株式会社を設立しました。いずれも現在は連結子会社です。",
      "significance": "システム開発、海外調達の支援、呼吸用保護具の製造に事業の幅を広げました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
  ],
