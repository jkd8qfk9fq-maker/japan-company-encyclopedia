    {
      "id": "industrial-indirect-materials",
      "name": "工場用間接資材販売業",
      "shortName": "間接資材販売",
      "description": "当社グループ唯一の事業で、工場で日常的に使う消耗品や補修用品などの間接資材を、インターネットを基盤とした通信販売で国内外の事業者を中心とする顧客に売っています。国内外の卸業者・メーカーから仕入れた商品を自社ウェブサイトのウェブカタログと紙カタログに載せ、エンドユーザーに直接販売します。店舗は持たず、受注・発注・入出荷・コールセンターなどの機能を各拠点に集約しています。顧客の需要が高い一部の商品はプライベートブランドでも展開しています。2025年12月期の売上高は333,880百万円でした。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】"
    }
  ],
