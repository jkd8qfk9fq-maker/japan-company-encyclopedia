  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「夢・目標を共に実現し続ける組織に」のもと、「革新的なマーケティングにより、世界を牽引する企業になる。」ことをビジョンとし、ＬＴＶマーケティングを軸に成果報酬型マーケティング市場で事業を展開しています。対処すべき課題として、テクノロジーを駆使した効率的な管理とデータ解析・分析の自動化による収益性の向上、サブスクリプション型のサービス提供の拡大による特定の商材やクライアントへの偏りの解消、与信管理体制の強化、優秀な人材の育成と確保を挙げています。",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年4月期の売上収益は前期比2.1％減の50,579百万円でした。MD&Aでは、既存案件の拡大と新規案件の受注は堅調だった一方、一部の主要顧客における個別要因の影響を受けたと説明されています。",
        "basis": "MD&Aの経営成績の概要、セグメントごとの経営成績",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みとして、解約防止チャットボットで得るZero Party Dataなどの独自データの取得、集めたデータを機械学習で分析して行うＬＴＶ予測、データとテクノロジーを活用するコンサルティングの3点を掲げています。",
        "basis": "事業の内容（当社グループの強み）、経営方針",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはＬＴＶマーケティング事業のみで、外部顧客からの売上収益49,363百万円は連結売上収益50,579百万円の大部分を占めます。主要な顧客ごとの情報ではＤＭＭグループが11,493百万円、株式会社スタイル・エッジが6,109百万円、ＳＢＩグループが5,516百万円と印字されており、特定の顧客への集中が見られます。地域ごとの情報は、本邦の外部顧客からの売上収益がほとんどを占めるため記載が省略されています。",
        "basis": "セグメント情報（報告セグメントの情報、主要な顧客ごとの情報、地域に関する情報）",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
