  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として、誠意と新しい技術の創造によって、価値ある商品、サービスをグローバルに提供し、関わる人々の幸福を実現することを掲げています。2028年3月期を最終年度とする中期経営計画「Kasai Turnaround Aspiration」では、北米事業構造改革を中心とした収益改善、キャッシュ・コンバージョン・サイクルの改善によるフリー・キャッシュ・フロー創出、グローバル組織とグローバルプロセスの構築の三領域を柱に、主要経営課題の解決に取り組み、経営再建を果たすとしています。2027年3月期の連結業績予想では、売上高を200,000百万円としています。",
        "asOf": "2026-08-14",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独立系の内装トリムシステムサプライヤーとして、企画・開発・設計・実験から生産までを一貫して行う体制を持ち、特定の自動車メーカーに限らず幅広い車種に対応しています。世界各地に生産拠点があり、それぞれの地域に対応する開発機能を備えていることが、有報の記載から読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】・【事業の内容】の記載",
        "asOf": "2026-08-14",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、北米が108,823百万円と全体の半分以上を占め、日本が51,697百万円、アジアが21,251百万円、欧州が14,417百万円でした。販売高は日産自動車と本田技研工業の2社で総販売高の7割超を占めており、特定の自動車メーカーへの依存度が高い構成です。",
        "basis": "【セグメント情報】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-08-14",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
