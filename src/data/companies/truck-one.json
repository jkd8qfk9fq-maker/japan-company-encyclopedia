  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「人と環境の調和」を理念に、再利用可能な車両・パーツを活用し、「働く車」のライフサイクルについて高品質なサービスを提供するトータルサポート企業を目指しています。中古車両の確保が難しくなる環境への対応としてレンタル・リース事業に注力し、レンタアップ・リースアップ車両を中古車市場へ送り出して販売機会の増加を図るほか、子会社のSUN AUTO株式会社の海外販売網を活かして輸出にも注力するとしています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中古商用車の買取から、自社工場での点検・整備と顧客の希望に合わせた仕様変更、販売、レンタル・リース、販売後の整備までを自社グループで一貫して行える体制を持ち、全国8拠点で顧客を支えています。",
        "basis": "【事業の内容】の商用車関連事業の記載（自社工場での点検・整備、仕様変更、全国8拠点）に基づきます。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内では新車価格の上昇を背景に中古車市場の価格が上昇し、主力の商用車関連事業は国内販売を中心に販売台数が増加したとされています。一方で、新車の登録数の減少などが進めば良質な中古車両の確保が難しくなるおそれがあるともされています。",
        "basis": "経営成績等の状況の概要と経営環境及び対処すべき課題等の記載に基づきます。",
