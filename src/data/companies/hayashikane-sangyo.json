  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月からの2ヶ年を新中期経営計画「Challenge2028」の期間と位置付け、資本コストをより強く意識した経営への移行と事業ポートフォリオの選択と集中を通じて、株主還元の強化、収益性の向上、人的資本投資の強化を進める方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "外部顧客への売上高では飼料事業と食品事業がほぼ並んでおり、新しい計画で掲げる事業ポートフォリオの選択と集中は、この2つの報告セグメントを対象に進められる構成です。",
        "basis": "セグメント情報の外部顧客への売上高、経営方針、経営環境及び対処すべき課題等の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "飼料の生産から食品の販売までを取り扱う垂直型メーカーであり、グループで豚を肥育し、と畜した豚肉を主原料の一部に使う体制と、自社ブランド「霧島黒豚」を持っています。機能性素材では、食品加工を起点に培った研究の基礎とエビデンスを強みとしています。",
        "basis": "事業の内容、関係会社の状況、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における食品事業の記載",
