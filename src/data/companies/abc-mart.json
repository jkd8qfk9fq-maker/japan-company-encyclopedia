  "history": [
    {
      "year": 1985,
      "title": "前身の「株式会社国際貿易商事」を設立",
      "description": "靴、衣料の輸入販売を目的として、東京都新宿区早稲田に当社の前身である「株式会社国際貿易商事」を設立しました（資本金20百万円）。",
      "significance": "現在の社名になる前の出発点で、当初は靴・衣料の輸入販売会社でした。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1990,
      "title": "「ABC-MART」１号店を出店",
      "description": "靴、衣料の小売部門進出を目的として、上野地区に「ABC-MART」１号店（東京都台東区）、渋谷地区に「GALLOP」渋谷店（東京都渋谷区）など４店舗をオープンしました。",
      "significance": "現在の中核事業である小売店「ABC-MART」の第1号店で、ここから小売チェーンとしての歴史が始まりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2000,
      "title": "日本証券業協会に株式を店頭登録",
      "description": "2000年10月に日本証券業協会に株式を店頭登録しました。",
      "significance": "株式公開の第一歩で、2年後の証券取引所上場につながります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2002,
      "title": "「株式会社エービーシー・マート」に商号変更",
      "description": "2002年8月、商号を現在の「株式会社エービーシー・マート」に変更しました。",
      "significance": "現在の社名になった時期です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2002,
      "title": "韓国に「ABC-MART KOREA,INC.」を設立",
      "description": "2002年8月、韓国における靴の小売展開を目的として「ABC-MART KOREA,INC.」を設立しました（出資比率51.0％）。",
      "significance": "国内の小売チェーンだった当社が初めて海外に進出した事例です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2002,
      "title": "東京証券取引所市場第一部に上場",
      "description": "2002年11月、東京証券取引所市場第一部に上場しました。",
      "significance": "株式公開を経て、国内有数の靴小売企業として市場に認知される契機になりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2010,
      "title": "台湾に進出し「ABC-MART TAIWAN,INC.」に",
      "description": "2010年2月、台湾の「JOINT POWER INTERNATIONAL Ltd.」に資本参加して連結子会社化（出資比率55.0％）。同年8月、当社による株主割当増資で出資比率を70.0％に高め、社名を「ABC-MART TAIWAN,INC.」に変更しました。",
      "significance": "韓国に続く2か国目の海外展開で、台湾でも「ABC-MART」ブランドを展開するようになりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2012,
      "title": "米国「LaCrosse Footwear,Inc.」を子会社化",
      "description": "2012年8月、米国の靴製造販売業である「LaCrosse Footwear,Inc.」の株式を取得し、連結子会社化しました（出資比率100.0％）。",
      "significance": "小売中心だった事業に、米国での自社ブランド（Danner等）の企画・製造・販売機能が加わった転機です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2013,
      "title": "国内初の靴製造工場「ABC SHOE FACTORY」を設立",
      "description": "2013年3月、国内初の靴製造工場「ABC SHOE FACTORY」を石川県羽咋郡に設立しました。",
      "significance": "輸入・企画販売が中心だった当社が、国内に自社の製造拠点を持った出来事です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "「株式会社オッシュマンズ・ジャパン」を完全子会社化",
      "description": "2022年3月、「株式会社オッシュマンズ・ジャパン」を完全子会社化しました（出資比率100.0％。2023年3月に連結子会社化）。",
      "significance": "国内で取り扱うブランド・業態の幅を広げた動きです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "ベトナムに合弁会社を設立",
      "description": "2022年3月、ベトナム社会主義共和国に合弁会社「ABC-MART VIETNAM Co.,Ltd.」を設立し、連結子会社化しました（出資比率70.0％）。",
      "significance": "東南アジアへの新規の海外展開です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所プライム市場へ移行しました。",
      "significance": "東証の市場区分再編により、現在の上場区分（プライム市場）になりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2025,
      "title": "フィリピンに合弁会社を設立",
      "description": "2025年8月、フィリピン共和国に合弁会社「ABC-MART SONAK Philippines,Inc.」を設立し、連結子会社化しました（出資比率51.0％）。",
      "significance": "直近の海外展開で、2026年2月期末時点の海外店舗展開国（韓国・台湾・ベトナム・フィリピン・米国）が出そろいました。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
