  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本的理念に「誠実」「信用」「貢献」を掲げ、「お取引先様を最優先に思う心を常に忘れない会社」を目指すことを経営の基本方針としています。2030年11月期に向けた中長期ビジョン及び2028年11月期に向けた中期経営計画を推進し、更なる成長と企業価値の向上を目指す事業の運営を行っています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "顧客・取引先の課題解決に向けた様々なニーズに当社グループのあらゆる機能で応える「策揃え」を実現するため、既に持つビジネスをバリューチェーンが見通せる単位に事業を構成しています。ファインケミカル事業では、独自のペプチド合成法「Molecular Hiving™」を有し、中分子医薬品の開発需要の拡大が見込まれています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年11月期の連結売上高62,744百万円の内訳は、ファインケミカル事業22,333百万円、ＨＢＣ・食品事業18,190百万円、医薬事業12,429百万円、化学品事業9,732百万円、その他57百万円です。本邦の外部顧客への売上高が連結売上高の90％を超えており、外部顧客への売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報等の外部顧客への売上高、関連情報の地域ごとの情報及び主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
