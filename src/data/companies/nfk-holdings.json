  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年に向けてサステナブルグロウス（持続的成長）を実現するため、「事業基盤の強化」、「成長戦略を支える強固な経営基盤の構築」、「環境・社会・ガバナンスを重視した経営」の3つを基本方針に掲げています。対処すべき課題として、収益性・成長性を基準とした積極的なＭ＆Ａの継続によるポートフォリオの多角化、工業炉燃焼装置関連事業におけるメンテナンス・部品販売などのストック型収益の拡大による収益の安定化、水素・アンモニアなど次世代燃料対応における技術的優位性の確立、エレクトロニクス事業における新規顧客の開拓などを挙げています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中核の日本ファーネスは、工業炉やバーナなどの燃焼装置について設計・製造から据付、保守・点検、交換部品の供給までを一貫して手がけています。水素やアンモニアなどの次世代燃料に対応するバーナの開発も進めており、カーボンフリー燃料対応のバイフューエルバーナは販売を開始しています。",
        "basis": "事業の内容に、日本ファーネスが製品の設計・製造から据付・メンテナンスに至るまで一貫したサービスを提供していることが、研究開発活動に水素燃焼対応バーナの開発の状況が印字されているため。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
