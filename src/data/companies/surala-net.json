  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「教育に変革を、子どもたちに生きる力を。」を掲げ、教育格差を根絶することを使命としています。教材の開発・提供に加え、教育現場でのEdTech活用のためのコンサルテーションや、学習履歴等のビッグデータの活用、AIのさらなる活用など、新しい教材やサービスの開発・提供を加速し、独自のポジションを確立するとしています。また、「不登校」「発達障がい」「低学力」「貧困」の4つの社会課題に対してどのような効果をもたらしているかを測定・可視化し、発信しています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「すらら」は無学年式で、学年や学校種を超えて学習内容のさかのぼりや先取りができる特長を持ち、偏差値30～60と低学力層を含めた幅広いレンジの生徒が利用できます。一人ひとりの理解度に合わせて学習を進めるアダプティブラーニングの仕組みを持ち、学習管理機能によって教員の負担軽減にもつながります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に無学年式の特長と対象とする生徒の範囲が印字され、【事業の内容】に一人ひとりの理解度に合わせて進めることができる教材であると印字されていること。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の販売実績では、eラーニング関連事業が1,847百万円と売上高1,932百万円の大半を占め、受託開発事業とアプリ開発事業は合わせて84百万円です。2025年12月末時点の導入校数は3,278校、利用ID数は268,288IDです。",
        "basis": "MD&Aの販売実績に事業ごとの金額が印字され、【事業の内容】とMD&Aに2025年12月末時点の導入校数と利用ID数が印字されていること。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
