  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンに「人と産業の可能性を、解き放つ」を、ミッションに「あらゆる産業とFintechの融合」を掲げています。2024年8月に公表した2025年12月期から2028年12月期までの中期経営計画では、収益性を伴った事業成長に取り組むフェーズと位置づけ、サービスの拡大と高付加価値化、優秀な人材の採用と育成、クライアントの獲得と深耕の3点を主要な取組みとしています。祖業である決済に加えて銀行・証券・保険分野のコンサルタント体制を確立し、ITリスク・PMO支援分野では2025年12月期から収益貢献が始まっているとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "Fintech領域に特化して蓄積したノウハウとナレッジによる専門性の高いサービス、独立系としての中立性、戦略立案から設計・開発・運用まで分断なく一貫してプロジェクトをマネジメントできる体制を特徴として挙げています。また、シンガポールを中心とした海外拠点を持ち、日本とのクロスボーダー案件や海外顧客の日本での事業展開の支援など、国境を越えた案件に対応できることも特徴としています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "戦略立案から運用までを一貫して担う体制は、プロジェクトの継続・追加受注につながり、顧客とプロジェクトの積み上げによって収益が継続する形になっています。特定の製品やベンダーに縛られない独立系の立場で、顧客ごとにビジネスパートナーを選定できる点も、この一貫支援の形を支えています。",
        "basis": "事業の内容に記載されたサービスの特徴（一気通貫のプロジェクトマネジメントによる継続・追加受注の獲得と、ビジネスパートナーの選定支援）",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
