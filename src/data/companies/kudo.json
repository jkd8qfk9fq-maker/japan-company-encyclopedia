  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度を初年度とする中期経営計画（2024年度－2026年度）では、基本方針として「収益力の強化」「人財力の強化」「サステナビリティの推進」を掲げ、各施策を推進しています。介護事業では、DX・ICTの活用による業務効率化、介護負担の軽減及び生産性向上に取り組んでいます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当事業年度の建築工事の受注方法別比率では特命が86.7％を占めており、既存顧客との継続的な関係に基づく受注が中心です。建設事業、不動産事業（建物総合管理）、介護事業の3事業を横浜市を中心に展開し、建物の建設から管理、介護施設の運営までをグループで担っています。",
        "basis": "MD&Aの受注方法別比率と生産、受注及び販売の実績、事業の内容の記載に基づく",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の内訳は、建設事業15,008百万円、介護事業6,257百万円、不動産事業3,353百万円であり、建設事業が最大です。売上は国内のみで、主要な顧客ごとの情報には関電不動産開発株式会社と日鉄興和不動産株式会社が建設事業の相手先として印字されています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
