  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年10月に公表した長期ビジョン「MARUICHI 2030 VISION」で2030年度の売上高4,000億円を掲げ、そのファーストステージとして第7次中期経営計画（2024年度から2026年度まで）を進めています。国内コア事業では数量より収益性を重視し、サプライチェーンの強化やグループ間シナジーの活用を図り、海外コア事業では需要が拡大する地域での設備投資を進め、成長事業ではステンレス事業の拡大投資などによる海外シェアの拡大を目指すとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本では自社工場に加えて北海道・四国・九州の地域子会社が生産を担い、北米6社・アジア4社の現地法人が各地域で製造・販売する体制を持っています。構造用などの汎用鋼管に加え、ステンレス鋼管やBA精密細管、異形管といった付加価値の高い製品まで扱う幅広さが土台になっています。",
        "basis": "【事業の内容】と【関係会社の状況】に、国内の地域子会社と北米・アジアの現地法人の製造・販売体制が印字され、【セグメント情報】に各地域の主な製品が印字されている。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高243,764百万円の内訳は、日本が144,139百万円と約6割を占め、北米54,837百万円、アジア44,788百万円が続きます。製品別では鋼管が208,013百万円と中心で、表面処理鋼板27,988百万円が続きます。",
        "basis": "【セグメント情報】の外部顧客への売上高と、【関連情報】の製品及びサービスごとの情報に印字された金額に基づく。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
