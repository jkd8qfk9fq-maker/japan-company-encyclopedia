  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「Webマーケティングとセールステックを活用し、顧客、社会にとって有益なサービスを創る。」という企業理念のもと、Webマーケティング事業及びクラウドセールステック事業を中核として、企業の集客から受注・成約に至るまでのプロセスを一社完結で支援する体制の強化に取り組み、世の中になくてはならない会社となることを目指しています。AI技術の急速な進展を踏まえ、AI検索環境への対応（AIO/LLMO等）を含む新たなサービスの提供を開始するなどサービス領域の拡張を進め、M&Aを通じた非連続な成長戦略も推進しています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "SEO対策、Webサイト制作及びインターネット広告運用等を包括的に提供し、顧客のWebマーケティング活動を分析・診断することで、経営課題の解決に寄与する最適なソリューションの実現を支援しています。広告運用の実績は外部からも評価されており、「Google Partners プログラム」では2022年から2026年まで5年連続で最上位の「Premier Partner」に認定され、LINEヤフー株式会社からは2024年より「Sales Partner『Select』」の認定を受けています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "Webサイト制作で培ってきた使いやすさと見やすさのノウハウをクラウド業務支援ツールにも活用し、集客から商談管理、バックオフィス業務の効率化までを一社で支援できる体制が、両事業にまたがる強みになっています。",
        "basis": "【事業の内容】に、クラウドセールステック事業では「Webサイト制作」で培ってきたノウハウを活用して使いやすさと見やすさを重視したツールを提供している旨と、Web上における集客から商談管理、さらにはバックオフィス業務の効率化まで一社完結で支援する体制を構築している旨が印字されていること",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
