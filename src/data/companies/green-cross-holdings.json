    "strategy": {
      "disclosed": {
        "text": "安全・サイン・レンタルの融合のもと、総合的な提案営業を強力に推進し、従来市場である建設関連市場への深耕開拓はもとより、官公庁・学校・病院・一般企業等あらゆる市場領域に的確に応えていくことにより、より優位な拡販体制の構築など営業基盤の一層の拡充を進める方針です。",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年4月期には、仮設資材・保安用品のレンタルを行う三建リース株式会社と、消防用設備の設計・施工・点検・保守を行う株式会社千歳防災社をグループに迎え、安全機材の販売・レンタルに防災設備の施工・保守までサービス領域を広げています。",
        "basis": "MD&Aの経営成績等の状況の概要、【関係会社の状況】の子会社一覧",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中核の株式会社グリーンクロスは全国に営業拠点を展開し、鳥栖、関東、東海、東北、関西、四国などのロジスティクス拠点を持ち、販売とレンタルとサインメディアの製作をグループで一体的に提供しています。",
        "basis": "【主要な設備の状況】の国内子会社の設備一覧、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-07-27",
