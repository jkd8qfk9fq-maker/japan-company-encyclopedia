  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "持株会社体制のもとで、主力ブランド（銀座ダイヤモンドシライシ、エクセルコ ダイヤモンド）の浸透と価値向上によりブライダルジュエリー市場でのシェア拡大を目指すとしています。あわせて香港の食品事業など新しい分野への展開を進め、複数事業化による安定した経営とグループ間の相乗効果が発揮できる体制の構築を進める方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "ジュエリー事業では香港、台湾、シンガポールへの出店に続き米国進出の検討やUAEドバイでの原石調達体制の構築を進め、調達から販売までのバリューチェーン強化と海外拡大を図っています。並行して、香港の食品事業の子会社化、軽井沢のリゾート開発、オークション子会社の設立など、新規事業の育成による多角化を進める戦略とみられます。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営戦略等、MD&Aのセグメント別の業績概要、セグメント情報の報告セグメントごとの売上高",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1994年の創業以来ブライダルジュエリーに特化して築いた2つのブランドと全国の店舗網に加え、イスラエルの子会社によるダイヤモンド原石の調達など、調達・製造・販売をグループ内で担う体制が強みとみられます。",
        "basis": "事業の内容、沿革、MD&Aのジュエリー・アート・オークション事業の業績概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ブライダルジュエリー業界は婚姻件数の減少により市場規模の縮小傾向が続くと自ら認識する中、当期の連結売上高は前期比15.8％増となり、ジュエリー・アート・オークション事業が連結売上高の72.1％を占めています。海外では香港、台湾、シンガポールに展開し、アジアの売上高が8,623百万円あります。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境、セグメント情報の報告セグメントごとの売上高と地域ごとの情報、MD&Aの経営成績の分析",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
