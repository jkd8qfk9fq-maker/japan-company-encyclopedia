  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年に向けた長期ビジョン『2030ビジョン』を策定し、実現に向けた取り組みを3つのフェーズに分けて進めています。2025年度からはフェーズ2である『2027中期経営計画（2025年～2027年）』の目標達成に向けて、製品ポートフォリオ戦略、技術戦略、ならびに企業体質の強化に注力するとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "次世代モビリティ、AI関連、GX市場を注力市場とし、新製品を早期にデザインインして売上を拡大する経営戦略を掲げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における人的資本の戦略の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本では高度技術製品・高付加価値製品の生産を担い、アジアでは生産コスト面の有利性を生かした生産を行うなど、地域ごとに役割を分けた生産・販売体制を持っています。",
        "basis": "事業の内容における地域ごとの生産拠点・販売拠点の位置づけの記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子部品の外部顧客への売上高が連結売上高の90％を超えています。顧客の所在地を基礎とした売上高は、アジア28,656百万円、日本18,285百万円、ヨーロッパ13,815百万円、アメリカ11,530百万円で、売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報等の関連情報における製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
