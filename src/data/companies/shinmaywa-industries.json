  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンとして「グローバルな社会ニーズに応え、都市・輸送・環境インフラの高度化に貢献する価値共創カンパニーを目指す」ことを掲げています。長期経営計画［SG-Vision 2030］の第２段階にあたる中期経営計画［SG-2026］では、東南アジア・オセアニア・北米への海外展開の加速、戦略的M&Aの実施、DXの推進、新事業の創出を基本方針とし、パーキングシステム、産機・環境システム、流体を「成長力強化事業」、特装車と航空機を「収益力強化事業」と位置づけています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、産機・環境システムを除く全てのセグメントが増収となり、売上高は前期から7.0％増えました。成長力強化事業と位置づけるパーキングシステムと流体の売上高も前期を上回っており、拡大の段階にある計画の進み具合が売上高の動きに表れています。",
        "basis": "MD&Aの経営成績の分析とセグメント情報（2026年3月期）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "水陸両用飛行艇の開発・製造を通じて培った技術を、民間航空機の部品製造に生かしています。防衛関連事業については、これまでに培ってきた技術力や防衛関連製品に関する知見を生かし、取り組みをさらに強化していくとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "外部顧客への売上高は、特装車が最大で、駐車設備、航空機、流体、産機・環境システムと、社会インフラの異なる分野に分散しています。一つの分野の需要の変動が会社全体に及ぶ程度を抑える事業の組み合わせになっていることが、セグメント別の売上高から読み取れます。",
        "basis": "セグメント情報（2026年3月期の外部顧客への売上高）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
