  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「ファッション産業」という本業に徹するという基本方針のもと、主力のアパレル部門では、キャリアからミセスのベターアップゾーンに特化・集中し、高品質・高感度商品の提供や、適切な店頭展開とサービスの実施により、ブランドロイヤリティを向上させると共に、ショップ開拓やブランド開発にも注力し、ブランド間競争における優位性を確保しつつ、並行して生産コストの合理化や諸経費の効率的使用により、安定的な発展を目指すことを経営戦略の基本としています。対処すべき課題として、アパレル事業ではリブランディングと商品力強化、新ブランドの開発に取り組み、テキスタイル事業では既存事業の深化と新規販路の開拓、エステート事業では物件開発などを進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約８割を占めるアパレル事業の収益性改善に取り組みながら、エステート事業の安定した賃貸収益がグループ収益を下支えする事業構造になっています。",
        "basis": "セグメント情報に報告セグメントごとの外部顧客への売上高が印字され、経営成績の分析にエステート事業が安定的にグループ収益に貢献した旨が印字されていることから読み取れます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "素材・品質・着心地・ファッション性の全てにわたってハイクオリティを目指すベターアップ商品のクリエーション展開に特化し、独自性のある高付加価値商品を追求している点が特徴です。",
        "basis": "会社の経営の基本方針にベターアップ商品でのクリエーション展開への特化が印字され、経営成績の分析に独自性のある高付加価値商品の徹底追求が印字されていることから読み取れます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高はアパレル事業6,050百万円（全体の約77％）、エステート事業1,015百万円（同約13％）、テキスタイル事業768百万円（同約10％）の構成で、アパレル事業が中心の事業構造です。",
        "basis": "セグメント情報に報告セグメントごとの外部顧客への売上高が印字されていることから読み取れます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
