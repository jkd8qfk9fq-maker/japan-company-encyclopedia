  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「“働く”にもっと『楽しい』を創造する。」のもと、中期コーポレートビジョン「つくる人の“働く”を夢中にする、現場インフラ」を掲げ、特定の業務課題を解決するSaaS企業にとどまらず、現場のあらゆる課題を広く解決する現場インフラ企業へ進化することを基本的な経営方針としています。「SPIDER+」を統合管理ソフトウエア「SPIDER+ Workspace」へ進化させる標準化に、BPOサービスによる外部化、プロフェッショナルサービスによる高度化、AIを活用した自動化を組み合わせて提供する方針です。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "建設事業に従事してきた経験から培った現場業務への深い知識をもとにサービスを開発し、業界を牽引する大手ゼネコン・サブコンを中心とした顧客基盤を築いています。大手企業への導入が進むと、その協力会社群へ利用が波及する効果が生まれます。ソフトウエアに加えてプロフェッショナルサービスとBPOサービスを提供し、顧客の業務プロセスに深く入り込むことで、他社サービスへの乗り換えを防ぎ、1社あたりの提供価値を高めています。",
        "basis": "【事業の内容】の競争優位性と選ばれる理由の記述に基づく",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の建設投資額は2025年度の68兆円から2035年度には84兆円まで長期的に拡大すると見込まれる一方、2035年には129万人の建設技能労働者が不足すると予測されており、建設業界では施工力の確保と生産性向上が急務とされています。当社はこの市場で施工管理ソフトウエアを提供し、2025年12月末の契約社数は2,251社に広がっています。",
        "basis": "【事業の内容】の建設業界の市場見通しと主力サービスの指標の記述に基づく",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
