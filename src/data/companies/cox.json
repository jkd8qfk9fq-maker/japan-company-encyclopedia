  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「もっと、こころ動く日々へ。コックスは、お客さまのファッションやライフスタイルを彩る、本質的なゆたかさを提供し続けます。」を掲げています。2027年2月期に向けては『Beautiful Life Innovator（新生活提案企業）への深化』を掲げ、「店舗売上の拡大」「EC売上の拡大」「荒利率の維持・改善」の3つの重点施策を継続して進めることで安定成長を目指すとしています。店舗では雑誌タイアップ企画の拡大や好立地への移設等による坪効率の改善、接客では採用強化と販売力の向上に取り組み、ECでは自社ECのOMO強化や会員プログラムの刷新、外部モールでのWEB広告の進化を進めるとしています。調達面では直貿・直商流の推進や取引先の絞り込みで原価率の維持を図るとしています。",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "イオングループの専門店事業を担うチェーンとして、174店舗のうち113店舗がイオンリテール株式会社などグループのショッピングセンター内に出店しており、集客力のある商業施設の中に安定した販売の場を持っています。基幹ブランド「ikka」は事業部門別売上高13,079百万円と全体の8割超を占める主力で、店舗とECの両方で展開しています。",
        "basis": "【事業の内容】【主要な設備の状況】に記載された賃借店舗数と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に記載された事業部門別売上高",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "衣料品小売業の単一セグメントで、2026年2月期の売上高は14,955百万円、国内174店舗に上海の連結子会社の店舗を加えた体制です。イオングループの専門店事業を営む企業群に属し、カジュアル衣料の専門店チェーンとして事業を行っています。",
        "basis": "【セグメント情報】【主要な設備の状況】に記載された単一セグメントの旨、店舗数及び売上高",
        "asOf": "2026-05-20",
