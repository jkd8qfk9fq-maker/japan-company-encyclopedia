  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年７月に策定した「中期ビジョン2026」では、AI技術との融合による全社変革、創業以来培ってきた強みの有機的な結合によるグローバル成長モデル、これらを実現するための資本戦略の３つを柱に掲げ、気象情報を「第５の公共インフラ」として事業規模の拡大を進めるとしています。",
        "asOf": "2026-08-20",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "前期までの中期経営計画では、SaaSモデルによる新たな顧客層の開拓と、AI活用による運営モデルの確立を重点施策とし、サービスを継続提供するストック型の売上を積み上げる構成になっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）、セグメント情報等の関連情報（地域ごとの情報）に基づく",
        "asOf": "2026-08-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客や個人の参加者が観測・予測・コンテンツ展開の各過程に参加する価値共創型の仕組み（Join & Share型サービス）を持ち、参加者が増えるほどサービスの価値が高まる構成になっています。運営は日本のグローバルセンターと欧州・米州のサービスセンターによる世界３極体制で、24時間365日の提供を支えています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-08-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年5月期の地域別売上高は日本が184億4千3百万円で全体の約４分の３を占め、アジア、欧州、米州でもサービスを提供しています。個人向けでは、アプリが４年連続で予報精度の評価で首位となり、利用者数の評価でも首位を獲得したと印字されています。",
        "basis": "セグメント情報等の関連情報（地域ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-08-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
