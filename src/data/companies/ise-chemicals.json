  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年に創立100周年を迎えるにあたり、「かがくでつなぐ、地球の資源。」を掲げ、「持続可能な開発」「技術フロンティアへの挑戦」「安全と信頼」を次の100年に向けた「ありたい姿」としています。ヨウ素及び天然ガス事業では安全安定操業を最優先に設備の維持・更新と新規坑井の開発を続け、金属化合物事業では積層セラミックコンデンサ向けの需要拡大に沿って生産体制を確保するとしています。また、新用途・新商品開発と新規事業の創出のため、産学連携や外部機関・企業との提携を進めるとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の柱は、既存のヨウ素資源の供給能力を坑井開発と設備更新で長期的に維持しながら、用途開発と外部連携で需要の裾野を広げる構成になっています。財務目標については、キャッシュ・フローを重視した指標と資本効率の指標を掲げる方針が示されています。",
        "basis": "経営方針における「ありたい姿」と対処すべき課題の記載、経営目標の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、地下かん水からヨウ素を生産するブローイングアウト法の技術と、国内の工場群に米国の連結子会社を加えた生産体制にあります。ヨウ素の原料の賦存地域は世界的に偏在し、主要な産出国はチリ、日本、米国とされています。金属化合物では、抽出剤を使って不純物を取り除き、高品位の製品を生産する技術が特徴とされています。",
        "basis": "事業の内容におけるヨウ素の生産方法と産出国の記載、金属化合物事業の技術的特徴の記載、関係会社の状況における連結子会社の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心はヨウ素及び天然ガス事業で、2025年12月期の外部顧客への売上高は34,656百万円です。金属化合物事業は4,601百万円です。ヨウ素は国内並びに北米、欧州及びアジアへ販売され、塩化ニッケルは積層セラミックコンデンサ向け素材として、車載用途や通信用途の拡大による需要の成長が期待される分野に位置づけられています。",
        "basis": "セグメント情報におけるセグメント別外部売上高の記載、経営方針における経営環境の記載、事業の内容における販売地域の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
