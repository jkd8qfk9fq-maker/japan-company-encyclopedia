  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "縮小傾向にある国内市場で事業領域を拡大し、現場の省力化・省人化の要望や脱炭素などの社会課題に応える製品開発に取り組むことを掲げています。株式会社三木製作所とのシナジー効果を高めて市場シェアの拡大と収益力強化を図るほか、海外市場の開拓や、グループ全体での生産の最適化による原価低減にも取り組むとしています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "主力の建築関連製品で用途の拡大と新製品開発を進め、子会社化した三木製作所との連携で駐輪製品などの領域を広げる方針が読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、事業領域の拡大、社会課題に応える製品開発、株式会社三木製作所とのシナジー効果による市場シェアの拡大が印字されていることによる。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "開発・製造から販売までを一貫して行い、市場における顧客の声を製品に反映させる体制が特徴です。国内6工場の生産拠点と全国の営業拠点を持ち、建築金物からエクステリア製品、外装用建材まで幅広い製品を扱っています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、開発・製造から販売を一貫して行い、市場におけるお客様の声を製品という形にして届けることに注力すると印字され、【主要な設備の状況】に室蘭・成田・千葉・十三・兵庫・津山・岡山の工場と全国の支店・営業所が印字されていることによる。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建築金物やエクステリア製品を扱うメーカーで、建築関連製品が売上高の98.6％を占めています。新設住宅着工戸数が弱含む環境でも、建築現場の省力化や住宅の高機能化による需要が見込まれる事業環境にあります。",
        "basis": "【セグメント情報】に建築関連製品の外部顧客への売上高11,404百万円（構成比98.6％）が印字され、【経営方針、経営環境及び対処すべき課題等】に、新設住宅着工戸数は弱含みでも建築現場の省力化や住宅の高機能化から建築関連製品の需要は堅調に推移するとみていることが印字されていることによる。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
