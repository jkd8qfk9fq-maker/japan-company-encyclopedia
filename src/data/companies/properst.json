  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "付加価値を高められる素材としての不動産を取得し、最高レベルの企画を施して最も高い価値を実現できる方法で「作品」として提供することを経営方針とし、分譲開発、賃貸開発、バリューアップ、建築請負の4事業をバランスよく組み合わせて展開するとしています。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年5月期の売上高は賃貸開発事業が中心で、分譲開発事業は引渡物件がなく売上計上がなかった一方、子会社化した株式会社小川建設の建築請負事業が新たな売上の柱として加わりました。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメントごとの経営成績の説明に基づきます。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "プロジェクトごとに独立したコンセプトで空間デザインを創り出す企画力・デザイン力と、連結子会社である株式会社小川建設（総合建設業）との連携による技術・施工力を組み合わせていることが、グループの競争力の源泉として位置づけられています。",
        "basis": "事業の内容における企画・デザインの説明と、サステナビリティに関する考え方及び取組の人材戦略における競争力の源泉の記載、経営方針における中長期的な経営戦略の説明に基づきます。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高は本邦の外部顧客向けが大部分を占め、首都圏エリアを中心に事業を展開しています。開発事業に建築請負事業を組み合わせたグループ構成は、2025年10月の株式会社小川建設の子会社化で始まったばかりです。",
        "basis": "セグメント情報の関連情報（地域ごとの情報）において本邦の外部顧客への売上高が連結売上高の90％を超える旨の記載と、事業の内容における首都圏中心の展開の記載に基づきます。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
