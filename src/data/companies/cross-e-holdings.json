  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "市場の異なる建設及び機械設置工事事業とファシリティ・マネジメント事業に加え、類似又は近接市場を基盤とした事業領域・事業地域をM&Aによって加え、リスク管理された企業集団に拡充したい考えを示しています。北部九州エリアでの事業承継型M&Aを積極的に実施する方針です。",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成は、建設及び機械設置工事事業が3,790百万円（連結売上高の82.7％）、ファシリティ・マネジメント事業が791百万円（同17.3％）です。工事事業は顧客の発注に基づくため年度ごとの変動がある一方、施設管理は業務委託契約に基づく継続的な収益であり、収益構造の異なる2事業を組み合わせています。",
        "basis": "セグメント情報（報告セグメントごとの売上高）と事業の内容、事業等のリスク、MD&A（経営成績等の状況の概要）に基づきます。",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "廃棄物処理施設や下水処理施設の分野で、運転経験豊富なエンジニアと施工経験豊富な現場監督を有し、試運転段階の微調整や問題解決への対応の速さが施主や取引先の信頼につながっているとしています。施設管理では、ハウステンボスの開園準備から携わり、街全体の機能を24時間365日止めることなく一元管理してきたノウハウがあるとしています。",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "グループの起源はテーマパーク「ハウステンボス」の施設管理部門であり、開園当初から同施設の工事と管理に携わってきました。ハウステンボス株式会社とは場内施設の総合管理委託契約を結び、2027年9月まで契約を継続することを決定しています。",
        "basis": "沿革と事業の内容、重要な契約等、セグメント情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
