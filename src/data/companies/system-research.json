  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "独立系企業として顧客の企業系列や使用するハードウエアの制約を受けることなく、最適なソリューションを提供し続けることを基本方針としています。中長期目標『Next Vision 50th』を掲げ、AIの進化で受託開発中心のビジネスモデルに構造変化が生じる可能性を見据え、AIに代替できない「顧客の業務知識」や「PM（プロジェクトマネジメント）力」を強みとして発揮する方針です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高29,083百万円のうち、ソフトウエア開発業務が16,603百万円と過半を占め、SIサービス業務が10,890百万円で続きます。主要顧客であるトヨタグループとの取引が重要な位置を占める一方、特定顧客への偏りを避ける方針も併せて開示されています。",
        "basis": "セグメント情報【関連情報】の製品及びサービスごとの情報と主要な顧客ごとの情報、事業等のリスク（主要顧客との取引について）、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独立系のためメーカーに左右されずに機器やソフトウエアを最適に組み合わせて提案・構築できる点が事業の内容で強調されています。クレジット・電子マネー決済対応のPOS管理システム、自動倉庫と連携したWMS／WCS、カーディーラーシステムなど専門技術を要する分野の実績があり、ISO9001に基づく品質管理と継続的なリピートオーダーにつながっています。",
        "basis": "事業の内容（SIサービス業務・ソフトウエア開発業務の記述）に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス産業では、DX推進や基幹システム刷新を背景にIT投資需要が旺盛と会社は見ています。当社は東海地区を主要な商圏とし、トヨタグループとの取引が重要な位置を占める独立系のSI会社で、従業員数は1,569人です。",
        "basis": "MD&Aの経営成績の概要（情報サービス産業の環境）、事業等のリスク（主要顧客との取引について）に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
