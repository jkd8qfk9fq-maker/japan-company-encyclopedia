  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年9月に改訂した新中期経営計画（2027年7月期～2029年7月期）において、持続的成長シナリオの再定義と、アドネットワーク事業及びふるさと納税事業の実績を推進力とした再現性の高い事業創造を基本方針とし、「新たな収益を生み出す事業の創造」「地方創生を通じた社会課題の解決」「価値創造を加速させる経営基盤の強化」「価値創造を支える経営資本への投資」の4つを重要経営課題として掲げています。ふるさと納税事業では制度の安定的な持続と将来の収益基盤の構築の両立を図り、グリーンエネルギー事業を第三の事業として創造・育成するとしています。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "祖業のアドネットワークで培ったテクノロジーとマーケティング・ノウハウと、ふるさと納税事業で培った自治体及び会員との接点を事業間で相互に活用していること、アドネットワークはマルチデバイス対応で国内最大級の広告配信規模を持つことが強みです。",
        "basis": "事業の内容におけるアドネットワークの配信規模と事業間の相互活用の記載に基づきます。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ふるさと納税市場は、2025年度の受入額が1兆3,314億円と堅調に成長し、利用率は18.5％にとどまるため市場拡大の余地が大きいとされています。コンシューマ事業の外部顧客への売上高19,538百万円は、連結売上高22,146百万円の大半を占めます。",
        "basis": "経営成績等の状況の概要におけるふるさと納税市場の記載と、セグメント情報における外部顧客への売上高の記載に基づきます。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
