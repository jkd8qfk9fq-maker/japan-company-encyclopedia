    "strategy": {
      "disclosed": {
        "text": "企業理念として「フードビジネスのトータルサポート」と「お客様満足の創造」を掲げ、グループ各社の連携による生産・物流・設計・施工・営業・サービスの一貫体制の強化、地域密着の営業とアフターメンテナンスの徹底、取引先の拡大、安全性・衛生性・省エネ性に優れた製品の開発、海外部門の強化、ESG経営の推進に取り組んでいます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は474億3千6百万円と前連結会計年度比3.9％増でした。経営成績の概要では、インバウンド消費による需要と、省人化ニーズの高まりを受けた省人対応厨房機器の需要が順調に推移したと説明されています。",
        "basis": "セグメント関連情報の製品及びサービスごとの情報、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "厨房レイアウトのコンサルティングから厨房機器の開発・製造・販売・施工・保守までをグループの一貫体制で担い、地域密着型の直販体制と各拠点のアフターメンテナンス体制を組み合わせています。製造は国内（福岡県）と中国（上海）、ベトナムの3拠点で連携しています。",
        "basis": "事業の内容、経営方針・対処すべき課題、関係会社の状況",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業は業務用厨房機器の製造・販売及び保守修理の単一セグメントです。2025年12月期の製品及びサービスごとの外部顧客への売上高は、熱機器11,667百万円、冷機器10,299百万円、保守修理8,742百万円、サービス機器7,547百万円、その他4,821百万円、洗浄・消毒機器4,357百万円で、本邦の外部顧客への売上高が全体の90％を超え、売上高の10％以上を占める相手先はありません。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
