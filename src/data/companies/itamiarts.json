  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "取扱商品の拡充（事業の横展開）、集客数・成約率・リピート率の維持・向上、製造ライン全体のシステム化・自動化を進めるとともに、連結子会社との連携を通じて受注領域の拡大と生産体制の強化を推進する方針です。あわせて、ネット集客の強化と販売商品のバリエーション拡大による新規顧客の獲得と、リピートと顧客生涯価値の向上を売上拡大の有効策としています。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年１月期は、2025年６月に完全子会社化した東京ネオプリント株式会社を初めて連結し、同社の2025年７月から12月までの６か月分の業績を取り込みました。EC販売ではトランザクション数（注文件数）が352,120件（前年同期比20.6％増）に増え、売上高は4,761,203千円となりました。主要な顧客であるラクスル株式会社への売上高は774,041千円と、売上高の16.3％を占めています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）、セグメント情報等の製品及びサービスごとの情報と主要な顧客ごとの情報による。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企画から製造、出荷までを自社で行う製造直販のD2Cモデルにより、低価格と短納期を実現しています。ECサイト構築システム『DREAM-PACK』や製造管理システム『i-backyard』などの自社開発システムと印刷データ処理の自動化により、小ロット・多品種の注文でも効率的に処理できる体制が強みです。主要サイトでは検索キーワード『のぼり』『のぼり旗』で自然検索１位を獲得し、『のぼりキング』の売上構成の約75％がリピート注文となっています。連結子会社はシルクスクリーン印刷設備と法人顧客基盤を持ち、小ロット対応の当社と中ロット・大ロット対応の同社で補完関係にあります。",
        "basis": "事業の内容（事業の特徴、主なECサイトの概要）、経営方針、経営環境及び対処すべき課題等（経営戦略）による。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "企業間取引のデジタル化は進展しており、BtoB-EC市場規模は2024年に514兆4,069億円、EC化率は43.1％まで上昇しています。一方で商業印刷市場は2025年に１兆7,500億円と横ばいが見込まれるなか、短納期・小ロット・可変データへの需要を背景にデジタル印刷の導入が加速し、対応力の差が受注を左右する局面とされています。販促・広告関連ではプロモーションメディア広告費が堅調に推移し、『イベント・展示・映像ほか』が高い伸びを示しており、イベント会場装飾などを含む販促需要の取り込み余地があると同社はみています。",
        "basis": "経営方針、経営環境及び対処すべき課題等（経営環境）による。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
