  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "理念「共々の道」のもと、第20次中期経営計画『EXPLORER PLUS』の最終年度として、製造原価低減や業務効率化と価格適正化を進め、光触媒技術や自己修復性素材などの新商材の事業化と、EV化・ESG志向を踏まえた製品の拡販・投入に取り組む方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は前期比7.8％減の51,165百万円となりましたが、これは中国合弁会社の持分法適用関連会社化によるもので、中国を除くと前期比0.8％増とMD&Aに説明されています。日本と東南アジア／インドの両地域は増収でした。",
        "basis": "MD&Aの経営成績の概要、セグメント情報（地域別の外部顧客への売上高）、経営方針",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金属加工油剤の国内トップシェア企業として積み重ねてきた技術力と顧客へのソリューション提供力を掲げており、技術研究所を核とする研究開発体制と、1970年代から各地域に現地法人を置いて構築したグローバルネットワークを持ちます。",
        "basis": "経営方針、沿革、事業の内容（地域別の生産・販売体制）",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは生産・販売体制を基礎とした地域別で、南北アメリカ22,523百万円、日本19,643百万円、東南アジア／インド7,512百万円、中国1,486百万円です。製品別では金属加工油剤関連事業が49,181百万円と売上高の大半を占めます。主要な顧客ごとの情報は、特定の顧客への売上高が連結売上高の10％未満のため記載が省略されています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報の製品及びサービスごとの情報・地域ごとの情報・主要な顧客ごとの情報）",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
