    "strategy": {
      "disclosed": {
        "text": "3か年の中期経営計画を毎年更新するローリング方式で策定しており、現行計画（2026年12月期から2028年12月期）では、事業成長の追求、生産効率・競争力の強化、人材強化・企業文化の醸成、財務強化を基本方針に掲げています。事業面では、半導体分野のマテリアル製品の製造ライン増設と新素材開発、装置部品洗浄サービスの拡充、パワー半導体用基板の増産を進め、通信・自動車・バイオ／メディカル分野への展開や、業務提携・M&Aによる新規事業への参入にも取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "祖業である真空シールの製造で培った真空技術と精密金属加工を組み合わせた受託製造を手がけ、石英・セラミックス・シリコンパーツ・CVD-SiCなどの半導体用マテリアル製品を自社で開発・製造しています。ものづくりにおける要素技術を拡充し、高品質の製品を国際競争力のある価格で世界に送り出すことを経営方針に掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "半導体製造装置向けの部材を中心とするメーカーで、2026年3月期の外部顧客への売上高は半導体等装置関連事業が185,139百万円と全体の約6割を占めています。地域別の売上高は中国が161,289百万円と最大で、生産と販売の両面で中国への比重が高い構成です。",
        "basis": "セグメント注記の外部顧客への売上高（半導体等装置関連事業185,139百万円、連結売上高288,933百万円）と、関連情報の地域ごとの売上高（中国161,289百万円、2026年3月期）に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
