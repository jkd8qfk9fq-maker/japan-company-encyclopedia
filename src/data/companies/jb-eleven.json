  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 提出後の2026年４月20日開催の取締役会において、完全子会社である株式会社５５ｓｔｙｌｅを吸収合併存続会社、ＪＢシンフォニー株式会社を吸収合併消滅会社とする吸収合併（企業結合日は2026年７月１日の予定）が決議されています（重要な後発事象に記載）。本登録は2026年３月31日現在の体制（連結子会社５社）に基づいています。",
      "businessStructure: 提出後の2026年４月20日開催の取締役会において、完全子会社である株式会社５５ｓｔｙｌｅを吸収合併存続会社、ＪＢシンフォニー株式会社を吸収合併消滅会社とする吸収合併（企業結合日は2026年７月１日の予定）が決議されています（重要な後発事象に記載）。本登録は2026年３月31日現在の体制（連結子会社５社）に基づいています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年３月期を最終年度とする中期５か年経営計画「ＷＲ２０３０（ワールド・ラーメン・ニーゼロサンゼロ）」を進めています。株式会社５５ｓｔｙｌｅの子会社化による店舗網の拡大に加え、商品開発と調理訓練を担う「ＲＤセンター」の開設、直営店・フランチャイズ店のマネジャー等への技術理論教育機関「ＷＲＣ（ワールド・ラーメン・カレッジ）」の開校、既存店への改装投資に取り組んでいます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "名古屋センター、有松工場、神宮製麺所の自社工場で麺や店舗食材を製造し、グループの店舗へ供給する体制を持っています。ラーメン、中華、洋食、喫茶と複数の業態を持ち、直営店経営に加えてフランチャイズやプロデュースによる展開も行っています。",
        "basis": "【事業の内容】に、名古屋センターで店舗食材の一次加工、有松工場と神宮製麺所で麺の製造を行い、グループ子会社への販売および一部外部販売を行っていること、直営店・フランチャイズ店・プロデュース店の店舗数が印字されていること。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "店舗は東海地方を中心に展開し、2026年３月31日現在のグループ店舗数は162店舗です。当期に株式会社５５ｓｔｙｌｅを子会社化したことで60店舗が加わり、前期と比べて65店舗増えました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、当連結会計年度末のグループ店舗数が前期末比65店舗増加の162店舗（国内直営店94店舗・フランチャイズ店37店舗・プロデュース店28店舗・海外フランチャイズ店３店舗）と印字されていること。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
