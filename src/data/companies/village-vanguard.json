  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "店舗それぞれに独創的な空間を創出することを基本として、「商品を発掘する楽しさ」だけではなく「ドキドキ・ワクワクする体験」を提供することに取り組んでいます。店舗運営ではコンテンツやイベントと連携し、リアルでしか体験できない独創的な空間を創出するとともに、オリジナル商品の展開強化やオンライン販売の拡大などに継続的に取り組むとしています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "店舗ごとに独創的な空間を作り、画一的でない売場で「商品を発掘する楽しさ」と体験を提供できることが土台になっています。スタッフ一人一人の個性を生かした売場や企画の展開も、その土台の一つです。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略等に、店舗それぞれに独創的な空間を創出し「商品を発掘する楽しさ」と「ドキドキ・ワクワクする体験」を提供する事業活動が印字され、経営環境に、スタッフ一人一人の個性を融合し、顧客の知的好奇心に寄り添う売場や企画の展開が印字されていること",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "店舗は全国の都心部や郊外に出店しており、ショッピングモールやファッションビルなどの商業施設内の店舗と路面店があります。2026年5月31日現在の店舗数は232店舗です。",
        "basis": "【事業等のリスク】の出店戦略に、直営店・FC店を全国の都心部及び郊外に出店し、形態は商業施設に出店しているインショップ店と単独出店している路面店があり、当連結会計年度末の店舗数は232店舗と印字されていること",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
