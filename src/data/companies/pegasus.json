  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として、工業用環縫いミシンの専業メーカーとしての技術力により世界の「衣料文化」の発展に貢献することを掲げています。中長期の課題として、アパレルマシナリー事業では製品・サービス・品質の差別化、東南アジア・南アジア・アフリカへの販路拡大、中国とベトナムの両拠点で同一の生産が可能な体制整備を、オートモーティヴ事業では販路拡大と本社主導による品質・技術の標準化を進めるとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、中国やバングラデシュの主要市場が伸び悩む一方、インドの堅調な売上や中南米・エジプトなどでの市場拡大がアパレルマシナリー事業を支え、売上高は前期並みを維持しました。オートモーティヴ事業では米州市場を中心に新規顧客の獲得を進めましたが、中国の価格引下げ圧力などにより売上高が減少しました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績等の状況の概要に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "環縫いミシンでトップブランドとしての地位を築いていること、滋賀工場の一貫生産に加えて中国・ベトナムにミシンの製造拠点を持ち、デジタル制御ミシンやモーター一体型ミシンなどの開発を進めていることが特徴です。オートモーティヴ事業では中国・ベトナム・メキシコの世界３か国４拠点の生産体制を持っています。",
        "basis": "事業の内容（環縫いミシンの位置付け）、研究開発活動、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年３月期の売上高は、アパレルマシナリー事業が13,830百万円で63.9％、オートモーティヴ事業が7,827百万円で36.1％を占めています。地域別では中国が5,259百万円で最も大きく、バングラデシュ、インド、米国など世界各地に販売しています。売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報の報告セグメントごとの売上高、地域ごとの情報、主要な顧客ごとの情報に基づく",
        "asOf": "2026-06-22",
