  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度までの「中期経営計画2025-2027」を策定し、強力な存在感をもつ総合物流企業グループへの成長を掲げています。事業の成長戦略として、グループの輸送サービスに「ＬＮＪＥＸ」の名称を設定し、独自商品の拡販、国際物流事業、ＥＣ物流事業の拡充の4つの営業方針を中心に営業活動を推進するとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、大手取引先の取り扱い数量の増加などにより営業収益が78,008百万円（前期比1.0％増）となりました。一方で、東日本地区の株式会社ＬＮＪ小泉における取引関係見直しや、猛暑による農産物の取り扱い数量の減少が減収要因になったとされています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績の状況に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "全国を網羅した輸送ネットワークと、JRコンテナ輸送・トラック輸送・フェリー輸送など多様な輸送モードを活用できることが強みであるとし、労働時間規制や改正物流法への対応策として、モーダルシフトやスイッチ運行を提案していると説明しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "北海道に基盤を持つ札幌通運と本州の事業会社を地域別の会社に束ね、長距離輸送では複数の輸送モードを組み合わせることで、全国エリアで貨物の取り扱いを拡大する体制を取っています。",
        "basis": "事業の内容の地域別セグメント構成と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "営業収益の内訳は、東日本32,008百万円、北海道22,058百万円、西日本20,181百万円、その他3,761百万円で、本州の2地区が過半を占めています。製品及びサービスごとの情報は、単一の製品・サービスの区分が営業収益の90％を超えるとして記載が省略されており、地域ごとの情報も、本邦の外部顧客への営業収益が90％を超えるとして記載が省略されています。主要な顧客はアマゾンジャパン合同会社で、2026年3月期の同社への営業収益は19,356百万円でした。",
        "basis": "セグメント情報の外部顧客への営業収益と、関連情報の製品及びサービスごとの情報・地域ごとの情報・主要な顧客ごとの情報に基づく。",
        "asOf": "2026-06-25",
