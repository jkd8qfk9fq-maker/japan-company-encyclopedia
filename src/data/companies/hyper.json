  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「ユーザーニーズ実現企業」として、すべてのステークホルダーとの長期的に安定した共存共栄を目指すことを経営理念に掲げています。優先的に対処すべき課題として、既存事業の収益力の強化に注力するとともに、市場のニーズに呼応した新たな事業を展開し、新規事業や新たなサービスの早期収益化の体制を構築して、業績の向上を目指しています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "顧客開拓と関係強化、ストックビジネスの強化、ソリューション営業の強化、セキュリティサービスの開発、子会社との相乗効果の最大化に注力したとされています。企業のＩＴ部門に代わりＰＣやサーバーの調達、設置、設定、セキュリティ対策、運用管理をサポートする情報システムサービスを「ビジネスコアネクスト」としてブランド化し、拡販に注力しました。",
        "basis": "MD&Aの経営成績等の状況の概要に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "特定のメーカーに縛られず、さまざまな製品や技術から、顧客の課題や企業規模、業種に合わせて最適な商品・ソリューションを組み合わせて提供する点と、専任のＩＴコンシェルジュが商品の選定から導入支援まで対応する点を、コンピュータ事業の進め方として掲げています。",
        "basis": "【事業の内容】のコンピュータ事業の記述に基づく。",
