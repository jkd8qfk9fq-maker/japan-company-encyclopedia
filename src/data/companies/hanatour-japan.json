  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社の株式会社アレグロクスTMホテルマネジメントが運営する「Tマークシティホテル札幌」は2026年3月に営業を終了しました。本登録は2025年12月31日現在の事業構成（同ホテルを含む4ホテルの運営）に基づいています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "訪日外国人旅行客へのサービス提供を中心とした旅行事業に加え、バス事業、ホテル等施設運営事業の3事業を主力として事業展開し、旅行事業を基盤に訪日旅行市場におけるインフラの整備を進め、グループでワンストップサービスを提供する事業展開を進めるとしています。FIT（個人旅行）を含むインバウンド需要の獲得を成長ドライバーと位置付け、オンラインプラットフォーム「Gorilla」の商品拡充や海外旅行エージェント向け新プラットフォームの開発、社内業務のデジタル化による生産性向上にも取り組むとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳ではホテル等施設運営事業が最大となっており、旅行手配に加えてバス運行とホテル運営までグループで担う体制が読み取れます。韓国からの送客を軸にしながら、東アジア・東南アジアや欧米豪からの手配にも対象を広げています。",
        "basis": "セグメント情報でホテル等施設運営事業の外部顧客への売上高が最大であることと、【事業の内容】に韓国・東アジア・東南アジア・欧米豪からのインバウンド手配が書かれていること。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "親会社である韓国の大手旅行会社との業務提携により安定した送客を受けられることに加え、連結子会社の観光バスと自社ブランドのホテルをグループ内に持ち、手配から移動・宿泊までを一貫して提供できる点が強みです。",
        "basis": "【重要な契約等】に親会社HANATOUR SERVICE INC.との業務提携契約が、【事業の内容】に連結子会社によるバス運行とホテル運営が書かれていること。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
