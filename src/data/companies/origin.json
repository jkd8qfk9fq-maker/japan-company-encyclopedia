  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "3期連続の赤字を受けて「緊急経営改革2026」を開始し、2027年3月期の黒字化を最優先の目標に掲げています。市場別・製品別ポートフォリオの強化とスピード感を重視した顧客対応、聖域なきコスト改革、立案計画の精査と厳格な実行並びにガバナンス体制と人的資本の強化を3つの基本戦略とし、収益構造の抜本的な改革を推進します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電源機器、塗料、精密機構部品、半導体デバイスという異なる技術領域の事業を併せ持ち、最大のケミトロニクス事業では、国内市場でのシェア拡大と海外拠点・化粧品関連の伸長により増収を確保しました。",
        "basis": "【セグメント情報】の事業別売上高と【関連情報】の地域別情報、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における事業別の業績の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高は日本向けが中心で、中国向けがこれに次ぎます。塗料と精密機構部品では中国の子会社が製造・販売を担い、タイとインドネシアにも塗料の生産拠点を持つなど、アジアを中心に海外展開しています。",
        "basis": "【関連情報】の地域ごとの売上高と、【主要な設備の状況】及び【関係会社の状況】における国内外子会社の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
