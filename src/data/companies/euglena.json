  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-23",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社は、バングラデシュの栄養失調問題を解決したいという想いのもと2005年8月に創業し、「人と地球を健康にする」というパーパスのもと事業を展開してきました。創業15周年を迎えた2020年に当社グループのありたい姿として「Sustainability First」を掲げ、ユーグレナを重量単価の高い順にFood、Fine Chemical、Feed、Fertilizer、Fuelの各分野へ展開する「バイオマスの5F」を基本戦略として、研究開発や培養技術の蓄積に応じて付加価値の高い用途から順に事業化を進めています。2024年度からの執行体制の刷新に伴い、「原点回帰」「バイオマスの5Fと両利きの経営」「黒字体質への転換」の三点を重要課題として事業を推進しています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の連結売上高は前期比5.8％増の50,370百万円と過去最高になりました。MD&Aでは、ヘルスケア事業における直販事業の好調、前期に連結子会社化したサティス製薬グループの業績通期寄与及び受注拡大、キューサイグループの堅調な推移が寄与したと説明されています。",
        "basis": "MD&Aの経営成績の概要、セグメント情報（報告セグメントごとの売上高）",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2005年12月に世界で初めてユーグレナの食品用途屋外大量培養に成功した大量培養技術を核とし、独立栄養培養、従属栄養培養、光従属栄養培養の各培養方法を使い分ける技術を有しています。食品用途ユーグレナは59種類の栄養素を含むこと、細胞壁がないため栄養成分の消化率が高いこと、希少成分パラミロンを含有することが特徴として説明されています。培養・生産は石垣島の自社グループ拠点で行っています。",
        "basis": "事業の内容（微細藻類ユーグレナをはじめとする当社独自素材の概要及び当社の技術）",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントの外部顧客への売上高は、ヘルスケア事業47,018百万円、バイオ燃料事業1,092百万円、その他事業2,259百万円で、ヘルスケア事業が売上の大半を占めます。ヘルスケア事業の販売形態別の売上高は、直販34,049百万円、流通4,177百万円、OEM・原料・海外8,631百万円、その他159百万円と印字されています。地域ごとの情報は、本邦の外部顧客への売上高が連結売上高の90％を超えるため記載が省略され、主要な顧客ごとの情報も、売上高の10％以上を占める相手先がないため記載が省略されています。",
        "basis": "セグメント情報（報告セグメントごとの売上高の分解情報、関連情報の地域ごとの情報・主要な顧客ごとの情報）",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
