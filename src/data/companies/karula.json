  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「安全・安心で、健康的な美味しい食事」を「より価値のある価格で提供する」ことを理念に、「生産から販売までの一貫体制」の確立を進めるとしています。中長期的には、東北・北関東地区での店舗網のドミナントエリア構築、労働生産性の向上、店舗人材の確保・育成、新フォーマットの開発が重要な経営戦略であるとし、多店舗展開に向けてマニュアル遵守の徹底や業務プロセスの再構築による「仕組化」を最重点課題として推進しています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "そばつゆなどのスープ類、野菜類、魚介類を自社工場で製造加工し、その他の食材も本社で一括購入して物流センターから全店舗へ配送する一貫体制により、店舗での作業削減と品質の標準化を図っています。連結子会社の亘理ファームでは水耕栽培でレタスや水菜を生産しており、生産から販売までをグループ内で担う体制を持っています。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等に印字された自社工場・一括購入・物流センターの体制",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高のほぼすべてがレストラン事業によるもので、単一の製品・サービスの区分が外部顧客への売上高の90％を超えています。店舗は2026年2月28日現在で109店舗あり、県別の販売実績では宮城県が最も大きく、東北地方が中心で栃木県にも店舗があります。",
        "basis": "セグメント情報等の関連情報と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に印字された県別販売実績",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
