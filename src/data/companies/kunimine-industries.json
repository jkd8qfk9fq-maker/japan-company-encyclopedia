  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度を初年度とする3ヵ年中期経営計画を策定し、ベントナイト本来の性能を最大限に活かした高付加価値製品の開発、生産販売の省人化、DXの推進を通じて高収益な事業構造の構築を目指すとしています。脱炭素関連や国土強靭化関連の成長分野への注力、新規事業領域の拡大、海外市場展開、国内の新鉱区開発によるベントナイト原鉱の安定確保を具体的な戦略に掲げています。",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ベントナイト原鉱石の採掘から製品の製造販売までを自社グループで一貫して行う体制を持ち、精製ベントナイト「クニピア」のような高付加価値製品の開発にも取り組んでいます。",
        "basis": "【事業の内容】における子会社による原鉱石の採掘と当社による製造販売の分担の記載、【沿革】における精製ベントナイトの商品化の記載、【研究開発活動】の記載に基づく",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ベントナイト事業が2026年3月期の連結売上高17,075百万円のうち11,842百万円を占める主力事業で、次いでアグリ事業が3,444百万円、クレイサイエンス事業が1,788百万円です。本邦の外部顧客への売上高が連結売上高の90％を超えており、販売は国内が中心です。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報の省略理由）の記載に基づく",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
