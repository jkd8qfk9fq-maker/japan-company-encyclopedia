  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本理念は「『お客さまに喜ばれる製品・サービスの提供』を通じ豊かな社会の実現へ貢献する」です。長期ビジョンは「『食と農と大地』のソリューションカンパニー」です。2024年2月に公表した「プロジェクトＺ」では、生産最適化、開発最適化、国内営業深化の抜本的構造改革と、国内外の成長分野への経営資源の集中による成長戦略に取り組んでいます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
