      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "ハピネット・メディアマーケティングが発足",
      "description": "当社の映像音楽パッケージの卸売事業を株式会社星光堂マーケティングに承継し、社名を株式会社ハピネット・メディアマーケティングに変更しました。",
      "significance": "映像音楽事業の卸売を担う子会社です。",
