    {
      "year": 1991,
      "title": "株式会社ハピネットに商号変更",
      "description": "株式会社ダイリンと株式会社セイコーを合併し、商号を株式会社ハピネットに変更しました。",
      "significance": "現在の社名になった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "バンダイの関連会社になる",
      "description": "株式会社バンダイが当社の株式を追加取得し、当社は株式会社バンダイの関連会社になりました。",
