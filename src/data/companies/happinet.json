      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1998,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1997年8月の店頭登録を経て、東京証券取引所市場第二部に株式を上場しました。2000年3月には市場第一部に指定されました。",
      "significance": "株式公開会社として事業を広げる土台ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "物流子会社ハピネット・ロジスティクスサービスを設立",
      "description": "物流業務全般の受託を目的に、千葉県市川市で株式会社ハピネット・ロジスティクスサービスを設立しました。現在も連結子会社です。",
      "significance": "卸売の物流をグループ内で担う体制ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "バンダイナムコホールディングスの関連会社になる",
      "description": "バンダイの関連会社株式の管理業務の一部が会社分割で株式会社バンダイナムコホールディングスへ移り、当社は同社の関連会社になりました。",
      "significance": "資本でつながる相手が、バンダイナムコグループの持株会社に変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "ハピネット・ベンディングサービスが発足",
      "description": "アミューズメント事業を会社分割で株式会社サンリンクに集め、社名を株式会社ハピネット・ベンディングサービスに変更しました。現在も連結子会社です。",
      "significance": "玩具自動販売機などを扱うアミューズメント事業を担う会社です。",
      "sourceIds": [
