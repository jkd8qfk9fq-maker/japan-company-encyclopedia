  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年3月に、2028年3月期までの3ヵ年を計画期間とする中期経営計画を策定しました。従来の都立中・都立高受験に加えて私立中・私立高受験への取り組みを本格化し、「都立のena」から「都立も私立も合格できるena」への転換を進めます。東京都内での出校で蓄積した指導ノウハウを生かし、千葉県及び埼玉県での出校も本格化させる方針です。都立中受検で不合格となった生徒への授業料無料の仕組みや、卒業生向けの継続特典など、小・中・高の一貫した指導体制の構築にも取り組みます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "私立高校の授業料の実質無償化の拡充で、強みとしてきた都立中・都立高を目指す生徒が減る中、対策の軸足を私立受験にも広げ、出校地域を首都圏の近隣県へ広げることで、需要の変化に対応する方向性が読み取れます。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営成績等の分析における取組の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "都立中高一貫校や都立難関高の受験対策に早くから経営資源を重点配分してきたことが、都立中入試で全都立中高一貫校11校の合格者数が計1,097名となるなどの合格実績につながっていると開示されています。すべての授業に単方向映像授業を組み合わせた「ダブル学習システム」や、授業の様子を保護者がネットで確認できる「ネット授業参観」などの仕組みも整えています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営成績等の分析における合格実績と取組の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "学習塾業界は、少子化による学齢人口の減少という構造的な課題に直面し、参入障壁が低いことから新規開業と撤退、合併・統合が繰り返される競争環境にあると会社は見ています。一方で、首都圏を中心とする中学・高校受験のニーズは引き続き高いとも示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と事業等のリスクにおける業界環境の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
