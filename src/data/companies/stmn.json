  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "理念「一人でも多くの人に、感動を届け、幸せを広める。」のもと、ビジョン「人と組織で勝つ会社（Win as One）」を掲げ、「人と組織の力」と「テクノロジーの可能性」を活かしたサービスを展開しています。国内市場では売上高成長率の最大化を最優先とし、「TUNAG」「FANTS」の契約企業数や平均月額収益の成長を進める方針です。企業向けとコミュニティ向けの2つのエンゲージメント領域で培ったノウハウとテクノロジーを活かし、多面的な収益拡大を図るとしています。対処すべき課題として、人材の確保と組織力の強化、新規契約獲得力とアライアンスの強化を挙げています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「TUNAG」は、エンゲージメントサーベイによる現状の可視化、専属のカスタマーサクセス担当による社内制度の企画・設計の支援、社内制度を運用するクラウドツールまでをそろえたワンストップのサービスです。月額利用料などのストック収益が中心で、「TUNAG」の売上高ストック比率は高水準を維持しています。「FANTS」は「TUNAG」で培った組織運営のノウハウをコミュニティ向けに拡張したプラットフォームで、入退会・課金・投稿管理などの機能をワンストップで提供しています。",
        "basis": "【事業の内容】に、「TUNAG」がサーベイ・専属担当の支援・社内制度運用クラウドの3つのステップでワンストップサービスであることと、「FANTS」が「TUNAG」の機能をコミュニティ向けに拡張・再構築したものであることが印字されています。MD&Aに、「TUNAG」の売上高ストック比率が高水準を維持していることが印字されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "同社が属するHR Techサービス領域では、人手不足や人的資本経営への関心の高まりを背景に、組織課題の解決やDXへの需要が拡大しています。「TUNAG」の利用企業数は2025年12月末時点で1,344社、「FANTS」の運営コミュニティ数は566件と、いずれも前期末から増えています。両サービスともサブスクリプション型の料金体系への移行や契約形態の変更により、収益基盤の安定化を進めています。",
        "basis": "MD&Aに、HR Techサービス領域の需要拡大と、「TUNAG」の利用企業数1,344社（2025年12月末時点）、「FANTS」の運営コミュニティ数566件（同時点）が印字されています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
