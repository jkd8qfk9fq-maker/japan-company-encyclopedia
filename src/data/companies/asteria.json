  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「世界で通用するソフトウェアを開発し提供する」ことを使命とし、「『つなぐ』エキスパート」として社会的な価値を生み出すことを目指しています。受託開発ではなく自ら企画した製品を提供する形態を基本とし、投資と研究開発の重点領域を「４D」（Data、Device、Decentralized、Design）に置いています。製品のAIネイティブ化、フィジカルAIやデジタル通貨などの成長領域への展開、海外展開の強化、人材基盤の強化に取り組む方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "受託開発を行わず自社製品の開発に集中する事業形態と、ノーコードで使える製品づくりが強みです。主力の「ASTERIA Warp」は国内のEAI/ESB市場で長く首位を維持し、導入実績を積み重ねています。売上の中心はサブスクリプションとサポートによる継続的な収入です。",
        "basis": "【事業の内容】に、受託開発ではなく不特定多数向けのパッケージソフトウェアやクラウドサービスを提供する「製品開発」を行うこと、「ASTERIA Warp」が国内EAI/ESB市場で19年連続シェアNo.１を獲得し累計導入企業数が10,000社を超えていることが印字されています。経営成績の分析には、サブスクリプション売上とサポート売上を合わせたストック売上が売上の約７割を超えることが印字されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "データ連携ミドルウェアの国内市場で首位の地位にあります。売上収益は全てソフトウェア事業によるもので、販売のほとんどは日本国内向けです。投資事業は売上収益ではなく投資先の評価を通じて業績に寄与する位置づけです。",
        "basis": "セグメント情報で、外部顧客への売上収益はソフトウェア事業のみに印字され（投資事業は「－」）、地域別情報では売上収益の大部分が日本に区分されています。【事業の内容】には「ASTERIA Warp」の国内EAI/ESB市場における19年連続シェアNo.１が印字されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
