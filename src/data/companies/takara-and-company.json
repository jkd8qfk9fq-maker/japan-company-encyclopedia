  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年７月８日に策定した「新・中期経営計画2029」（2027年５月期から2029年５月期）では、コーポレートブランドメッセージ「Tech Driven Value for Growth」を掲げ、ディスクロージャー＆ＩＲ領域でOnly oneのTech Driven型ディスクロージャー＆ＩＲ企業群を目指すとし、成長戦略として、コアビジネス・中核事業であるWizLaboの進化、グループ連携＆シナジー、人的資本経営への取り組みを推進するとしています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "WizLaboへのＡＩ搭載と開示プロセスのコンサルティング・ＢＰＯの強化で制度開示の周辺領域を取り込み、ジェイ・トラストの連結化のようなＭ＆Ａで金融商品ディスクロージャーの商材を拡充する戦略とみられます。通訳・翻訳事業では、ＡＩ翻訳プラットフォーム等の新商材で、ＡＩによる業界の構造変化に対応する方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営戦略等、セグメント情報の報告セグメントごとの売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1952年の創業以来、開示書類の制作で蓄積した専門性と、WizLaboを中心とする書類作成支援の仕組みを持ち、2025年は新規上場会社の過半数の上場支援を手掛けたとＭＤ＆Ａに印字されています。通訳事業では高いリピート率を確保し、大型案件の受注が伸びているとされています。",
        "basis": "事業の内容、沿革、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の上場会社向け開示支援では、株主総会プロセスの電子化やサステナビリティ情報の開示、ＳＳＢＪ基準への対応など制度変更に伴う需要が続いており、ディスクロージャー関連事業が連結売上高の最大の事業です。通訳・翻訳事業は、国際会議や大型イベントの開催が需要を支えています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境、セグメント情報の報告セグメントごとの売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
