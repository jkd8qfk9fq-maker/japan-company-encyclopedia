  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基幹事業である土木用・建築用セメント製品事業を中心に、収益の確保を最優先とした事業展開を基本方針とし、提案・設計営業の強化や土木用大型コンクリート構造物のプレキャスト化の推進により、販売力の強化とシェアの拡大を図ることを重点方針としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "防衛省関連事業に対応する「防衛チーム」を組織化して全事業エリアに配置し、技術本部や製造部門と連携するなど、公共投資の動向に合わせた情報収集と体制づくりを進めていることが当期の開示から読み取れます。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要、セグメントごとの財政状態及び経営成績の状況）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "大型コンクリート構造物のプレキャスト化に関する技術提案力と設計力が差別化要因として開示されており、TSKJ工法やYPJ工法などの自社工法については同業他社への技術援助・部材納入契約も結んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等（課題に対する具体的な取組状況等）、重要な契約等",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成は土木用セメント製品が約6割、建築用セメント製品が約3割で、国土強靭化の施策や防衛省関連施設整備といった公共性の高い需要に支えられた構成です。熊本県内では半導体関連産業の集積に伴う産業用地や道路の整備需要も見込まれています。",
        "basis": "セグメント情報等（報告セグメントごとの売上高、関連情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
