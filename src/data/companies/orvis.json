  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「顧客満足・社員満足」です。中期経営計画「NEXT STEP 10」（2023年10月期から2027年10月期まで）のもとで事業の選択と集中を進め、不動産事業や不採算部門から撤退しました。木材事業では新市場・新規顧客の開拓や国産材への切り替え、生産効率の向上に注力し、ハウス・エコ事業では官公庁の学校施設関連の受注獲得と、設計力・製造力・営業力の強化に取り組みます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年10月期の売上高は12,639百万円と前期から増加し、ハウス・エコ事業の売上高は前期比134.0％と大きく伸びました。前連結会計年度に子会社化した寿鉄工株式会社の業績が期首から反映されたことが、ハウス・エコ事業の増収の主因として説明されています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に、売上高の金額と前期比、ハウス・エコ事業の売上高の前期比と増収理由（寿鉄工の通期寄与）が印字されていることに基づきます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "木材事業では、為替や船舶運賃に左右される外国産材から価格の安定した国産材へ切り替えを進め、福山工場で製材しています。ハウス・エコ事業では、Ｈグレード認定を取得した寿鉄工株式会社が加わったことで、軽量鉄骨と重量鉄骨の双方の製作が可能になり、提案力が高まったとされています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に、国産材への切り替えと国産杉の生産比率の向上、寿鉄工のグループ入りによる製作範囲の拡大が印字され、経営方針にＨグレード認定の取得が印字されていることに基づきます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
