  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年4月の創業100年を機に、「衣・健・住」を軸とした戦略的ビジネスモデルを推進する方針です。衣では子ども服のブランド価値の再構築と差別化、健では園児見守りに加えて高齢者向けの室内見守りへの拡大、住では賃貸、空き家の再生・再販売、不動産小口化商品、マッチングプラットフォームの4つの収益モデルで事業基盤を築くとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は2,533百万円で前期比44.1％増となりました。子会社の取得による収益の増加に加え、不動産事業の再販事業が大きく伸びたことが主な増収要因です。一方、アパレル事業の売上高は店舗閉鎖や既存店・ネット通販の低調で減少しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "不動産事業では、イストグループが持つリノベーションで中古物件の付加価値を高める進め方を強みとし、再販事業に注力しています。アパレル事業では、自社企画・設計による独自性と品質にこだわった製品づくりを掲げています。",
        "basis": "【事業の内容】と【経営方針、経営環境及び対処すべき課題等】に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "アパレル事業が向き合う子供服は少子化の影響を受ける分野です。会社はウェアラブル事業でも国内出生数の減少を構造的な課題と捉え、応用領域を高齢者福祉・介護分野へ広げる方向を示しています。不動産事業では中古住宅の再生・再販売を通じた空き家問題への対応を掲げています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
