  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「優れた技術と豊富な経験を活かし、高品質のサービスを提供することにより社会の発展に貢献するとともに、顧客・株主・社員の期待に応えること」を経営方針としています。2024年５月期から2028年５月期の中期経営計画では、技術力の向上を要諦とし、「まちづくり」を核としたコア業務を安定的に伸長させるとともに、社会課題の解決に向け、新市場・新規業務の開拓に挑戦する方針です。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "防災・減災や国土強靭化などの官庁需要と、産業用地・物流用地の開発などの民間需要を取り込みながら、土地区画整理の業務代行など従来のコンサルタント業務を超える領域へ収益機会を広げる戦略です。",
        "basis": "セグメント情報（単一事業の記載）、収益認識関係の業務別売上高、MD&A（経営成績等の概要）及び経営方針に基づきます。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "まちづくり業務の豊富な経験と実績を核に、測量から設計、業務代行までワンストップで対応できる総合力と、技術士やRCCMなどの技術資格保有者510名体制（2026年５月期）の技術力が強みです。",
        "basis": "事業の内容、MD&A（経営成績等の概要）及び経営方針に基づきます。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "総合建設コンサルタントとして単一事業を営み、売上高の４割強をまちづくり業務が占めます。顧客は官公庁が中心で、受注額の４～５割程度は民間企業との取引です。",
        "basis": "収益認識関係の業務別売上高、事業等のリスク及びMD&Aに基づきます。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
