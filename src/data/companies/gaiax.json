  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2022年11月に策定した中期経営方針（2023年12月期から2027年12月期までの５ヵ年）のもと、スタートアップスタジオとして新規事業の創出と投資先の企業価値向上を通じ、安定的な事業構造の構築を目指すとしています。事業を法人化して第三者資本を活用する独自の「カーブアウト・オプション制度」を持ち、重点領域としてソーシャルメディア、シェアリングエコノミー、web3/DAOにおける継続的な事業成長と収益性向上を挙げています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "SNSマーケティングを戦略立案から運用まで一気通貫で支援できる体制を持ち、35万人超の登録クリエイターを活かしたマーケティング支援を行っています。事業を法人化して起業家にストックオプションを付与するカーブアウト・オプション制度により、事業と起業家を連続的に生み出す仕組みも持っています。",
        "basis": "MD&Aにおけるソーシャルメディアサービス事業の記載と、経営方針におけるカーブアウト・オプション制度の記載に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "SNS活用をはじめとするデジタルマーケティング市場は、顧客企業によるDXへの投資を背景に堅調で、今後も安定的な成長が予想されています。注力するショートドラマでは自社IPの総再生回数が4億回を超え、2025年12月には株式会社テレビ東京と「IP創出プロジェクト」を始動しています。",
        "basis": "MD&Aにおける事業環境とショートドラマ事業の記載に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
