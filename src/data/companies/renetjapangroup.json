  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「ビジネスを通じて”偉大な作品”を創る」を掲げ、収益と社会性の両立を目指しています。小型家電リサイクル事業とソーシャルケア事業で環境と福祉が互いに作用し合う「ESモデル」の展開を加速し、小型家電リサイクルでは自治体との連携をさらに拡大し、ソーシャルケアでは中度・重度障がい者向けグループホームの直営展開と、福祉領域に特化した外国人材の送り出しを成長の軸にするとしています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "海外金融事業からの撤退を進める一方で、リユース・リサイクル事業とソーシャルケア事業に経営資源を寄せています。2025年9月期の営業収益は海外金融の収入がほぼ無くなったことで前期を下回りましたが、主力のリユース・リサイクル事業の営業収益は前期から増えています。",
        "basis": "セグメント情報における事業別の外部顧客への営業収益の推移と、事業の内容における海外金融事業からの撤退方針の記載に基づく",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "小型家電リサイクル事業は、小型家電リサイクル法の認定事業者として、2025年11月1日現在で全国748の自治体と連携し、行政サービスの一環として宅配回収を提供する独自の仕組みを持っています。リユース事業も小型家電リサイクル事業も実店舗を持たずインターネットと宅配便に特化しており、非対面で全国から集荷できる体制です。",
        "basis": "セグメント情報の概要における認定事業者と自治体連携数の記載と、事業の内容における宅配買取・販売サービスの記載に基づく",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
