  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「資源循環型パッケージングカンパニー」を目指して、「国内ビジネスの強化」と「海外ビジネスの拡大加速」を進めています。具体的な施策として、開発提案力の強化、圧倒的スピードの実現、WEBマーケティングの強化・確立を重要な課題として取り組んでいます。生分解性樹脂やバイオマス原料、リサイクル原材料を使った容器など、環境配慮型の新製品開発も推進しています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "容器の製造に必要な金型を自社で製作して保有し、顧客が金型製作の時間と費用を負担せずに利用できる仕組みにより、独自性の高い包装容器を短納期かつ小ロットから提供できます。2025年12月末時点で保有する金型は4,258型です。",
        "basis": "【事業の内容】に、当社グループが容器製造に必要な金型を自社で製作し、顧客が必要に応じて利用できる金型を4,258型（2025年12月末時点）保有していること、スタンダードボトルを活用して短納期かつ小ロットから提供できることが印字されています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "日本、中国、アメリカ、タイ、オランダ、インドの販売拠点から世界中で4,313社へ販売しています。インドの売上高は進出以来最高額となり、中国でも食品分野の開拓など営業面の見直しで新規案件の獲得が進んでいます。",
        "basis": "【事業の内容】に6か国の販売拠点から4,313社へ販売していることが、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】にインドの売上高が進出以来最高額となったことと中国の新規案件獲得が印字されています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
