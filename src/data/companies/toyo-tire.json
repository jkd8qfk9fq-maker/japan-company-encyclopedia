  "businesses": [
    {
      "id": "tire",
      "name": "タイヤ事業",
      "shortName": "タイヤ",
      "description": "乗用車用・ライトトラック用・トラック・バス用のタイヤと関連製品をつくって売る事業です。国内では㈱トーヨータイヤジャパンが販売し、福島ゴム㈱などが製造しています。海外ではToyo Tire U.S.A. Corp.やNitto Tire U.S.A. Inc.などが販売し、Toyo Tire North America Manufacturing Inc.（米国）、Toyo Tyre Malaysia Sdn. Bhd.、Toyo Tire Serbia d.o.o.が製造しています。2025年12月期の外部顧客への売上高は547,697百万円（前期は519,832百万円）で、前年度比5.4％増でした。会社は、北米で重点商品の販売量が堅調で値上げも浸透したこと、国内と新車用で値上げの効果があったことを挙げ、欧州は事業再編に伴うオペレーションの変更で販売量・売上高とも前年度を大きく下回ったと述べています。",
      "products": [
        "乗用車用タイヤ",
        "ライトトラック用タイヤ",
        "トラック・バス用タイヤ",
        "その他関連製品"
      ],
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "automotive-parts",
      "name": "自動車部品事業",
      "shortName": "自動車部品",
      "description": "自動車用の防振ゴムなどをつくって売る事業です。国内では東洋ゴム化工品㈱と綾部トーヨーゴム㈱が製造・販売し、海外ではToyo Tire North America OE Sales LLCが販売、東洋橡塑(広州)有限公司が製造・販売しています。2025年12月期の外部顧客への売上高は47,225百万円（前期は45,526百万円）で、前年度比3.7％増でした。会社は、自動車メーカーの需要が安定したことで売上高が前年度を上回ったと述べています。",
      "products": [
        "自動車用防振ゴム等の自動車部品"
