  "history": [
    {
      "year": 1945,
      "title": "東洋ゴム化工と平野護謨製造所が合併し、東洋ゴム工業を設立",
      "description": "1945年8月に、東洋紡績㈱がゴム工業の発展のために設立して育てた東洋ゴム化工㈱と、㈱平野護謨製造所が合併し、「東洋ゴム工業㈱」を設立しました。",
      "significance": "今のTOYO TIREの出発点です。2025年12月期の連結売上高は594,923百万円です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1953,
      "title": "自動車タイヤの生産のため伊丹工場を開設",
      "description": "1953年7月に、自動車タイヤを生産するため兵庫県伊丹市に伊丹工場を開設しました。伊丹工場は1998年12月に生産部門が桑名工場へ統合され、閉鎖されました。",
      "significance": "自動車タイヤ生産の始まりです。タイヤ事業は2025年12月期の外部顧客への売上高が547,697百万円で、連結売上高のほとんどを占めています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1955,
      "title": "株式を東京証券取引所に上場",
      "description": "1955年5月に株式を東京証券取引所に上場しました。2022年4月には東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分は、有報の表紙で東京証券取引所プライム市場と印字されています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1966,
      "title": "米国で自動車タイヤの販売会社を設立",
      "description": "1966年7月に、米国での自動車タイヤの販売を促進するため、業界に先駆けて「Toyo Tire (U.S.A.) Corp.」（現、Toyo Tire U.S.A. Corp.）を設立しました。",
      "significance": "海外展開の早い例です。Toyo Tire U.S.A. Corp.は現在も連結子会社で、2025年12月期の売上高（連結会社相互間の内部売上高を除く）は210,796百万円と、連結売上高の10％を超えています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1975,
      "title": "欧州にタイヤ販売会社を設立",
      "description": "1975年9月に、欧州に自動車タイヤの販売会社「Toyo Reifen GmbH」（現、Toyo Tire Holdings of Europe GmbH）を設立しました。",
      "significance": "欧州事業の拠点です。同社は2025年12月31日現在、議決権の100％を持つ連結子会社で、欧州の販売子会社を束ねています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1987,
      "title": "台湾の正新橡膠工業と合弁で自動車用防振ゴムの製造会社を設立",
      "description": "1987年3月に、正新橡膠工業（中華民国）と合弁で、自動車用防振ゴムの製造会社「洋新工業」を設立しました。",
      "significance": "洋新工業股份有限公司は2025年12月31日現在、議決権の50％を持つ持分法適用関連会社で、同社製品を仕入れています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "米国ジョージア州にタイヤ生産子会社を設立",
      "description": "2004年6月に、米国・ジョージア州に自動車タイヤの生産子会社「Toyo Tire North America,Inc.」（現、Toyo Tire North America Manufacturing Inc.）を設立しました。",
      "significance": "北米向けタイヤの現地生産拠点です。同社は現在も連結子会社で、同社製品を仕入れています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "国内のタイヤ販売会社10社を統合し、トーヨータイヤジャパンを設立",
      "description": "2007年4月に、国内の自動車タイヤ販売会社10社を統合して「㈱トーヨータイヤジャパン」を設立しました。同時に、国内の化工品販売会社2社を統合し、「東洋ゴム化工品販売㈱」（現、東洋ゴム化工品㈱）を設立しました。",
      "significance": "国内販売の体制を整理した出来事です。㈱トーヨータイヤジャパンは2025年12月31日現在、議決権の100％を持つ特定子会社です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "マレーシアにタイヤ生産子会社を設立",
      "description": "2011年4月に、マレーシア・ペラ州に自動車タイヤの生産子会社「Toyo Tyre Manufacturing (Malaysia) Sdn Bhd」（現、Toyo Tyre Malaysia Sdn. Bhd.）を設立しました。",
      "significance": "アジアの生産拠点です。同社は2025年12月31日現在、議決権の100％を持つ特定子会社です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "三菱商事と資本業務提携を締結",
      "description": "2018年11月に、三菱商事㈱と資本業務提携を締結しました。2019年2月12日を払い込み期日とする第三者割当で、三菱商事㈱が新株26,931,956株を引き受けました。",
      "significance": "三菱商事㈱は、2025年12月31日現在、議決権の20％を持つ「その他の関係会社」です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "社名を東洋ゴム工業からTOYO TIREに変更",
      "description": "2019年1月に、社名をＴＯＹＯ ＴＩＲＥ㈱に変更しました。",
      "significance": "社名の変更です。同じ2019年1月に米国に北米R&Dセンターを、11月にドイツに欧州R&Dセンターを開設しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "セルビアにタイヤ生産子会社を設立",
      "description": "2019年10月に、セルビア共和国・インジヤに自動車タイヤの生産子会社「Toyo Tire Serbia d.o.o. Beograd」（現、Toyo Tire Serbia d.o.o.）を設立しました。2024年12月には同じインジヤに販売会社「Toyo Tire Sales and Marketing Europe d.o.o. Indija」を設立しました。",
      "significance": "欧州向けの生産・販売拠点です。会社は、欧州では事業再編に伴いオペレーションを変更し、セルビア工場からの地産地消を進めていると述べています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
  ],
