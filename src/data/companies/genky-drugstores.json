  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「近所で生活費が節約できるお店」をコンセプトに圧倒的な安さの追求、「何でも揃うお店」を目指し医薬品や化粧品だけではなく生活必需品を幅広く取りそろえ青果や精肉等の生鮮食品の取扱いを強化、地域シェアを高めるためドミナントエリア構築や自社の物流拠点を活かしたローコストオペレーションの追求等を推進していく方針です。対処すべき課題として、完全標準化された300坪のＲ店の出店によるドミナントエリア構築、人材の確保と育成、店舗オペレーションの技術と管理レベルの向上、健全な収益管理とローコスト経営の深耕などを挙げています。経営理念として「われわれは、熱意を持って日本国の国家と国民に信頼されるチェーンストアを創り、地域の人々の生活向上に貢献します。」を掲げています。",
        "asOf": "2026-09-09",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "完全標準化された300坪のＲ店という店舗フォーマットと、地域に集中出店するドミナントエリアの構築により、人口の少ない商圏でも成り立つローコスト運営を目指している点が基盤です。自社の物流センターと、生鮮食品や弁当・惣菜を加工するプロセスセンターを持ち、店舗運営と一体で運営しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に完全標準化された300坪のＲ店の出店によるドミナントエリア構築とローコスト経営の深耕が印字され、【主要な設備の状況】に自社の物流センター（丸岡、岐阜安八ＲＰＤＣ、富山小矢部ＲＰＤＣ、滋賀甲良ＴＣ）が印字されている。MD&Aにも自社プロセスセンターを活用した生鮮食品・お弁当・お惣菜の品ぞろえ強化が印字されている。",
        "asOf": "2026-09-09",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の全てがドラッグストア事業（単一セグメント）によるものです。地域別の売上高は愛知県が79,640百万円、岐阜県が63,247百万円、福井県が37,740百万円、石川県が29,287百万円、滋賀県が10,722百万円と、中部地方に集中しています。商品別では食品が156,911百万円と最も大きく、医薬品の16,475百万円を大きく上回ります。会社は、ドラッグストア業界で業種・業態を超えた出店競争や価格競争が激化し、Ｍ＆Ａによる業界再編が加速していると認識しています。",
        "basis": "MD&Aの地区別売上高・商品別売上高（2026年6月期）と【経営方針、経営環境及び対処すべき課題等】の業界環境の記述による。",
        "asOf": "2026-09-09",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
