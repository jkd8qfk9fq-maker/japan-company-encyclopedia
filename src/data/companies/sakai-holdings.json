  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "再生可能エネルギー事業の増強、携帯ショップの総合的評価の向上と採算性の見直し、保険代理店事業の販売力と生産性の向上、葬祭事業における会員募集の強化と質的向上、ビジネスソリューション事業の販売力強化と提案の多様化に注力するとしています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "太陽光発電では自社エンジニアが発電所の運営管理を担い、発電所を全国各地に分散することで気候リスクの低減を図っています。携帯電話ショップでは対面サービスを地域のDXを支える拠点と位置づけ、有償サポートなど来店後のサービスにも力を入れています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）及びMD&Aにおける再生可能エネルギー事業・移動体通信機器販売関連事業の概況の記載に基づく",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "移動体通信機器販売関連事業が2025年9月期の連結売上高17,017百万円のうち12,110百万円を占める主力事業で、次いで再生可能エネルギー事業が2,387百万円、葬祭事業が1,030百万円です。主要な顧客であるソフトバンクへの販売が販売実績の28.7％を占めます。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）、関連情報の主要な顧客ごとの情報及びMD&Aの相手先別販売実績の記載に基づく",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
