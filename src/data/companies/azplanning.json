  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2025年２月期～2027年２月期）では、取扱物件の大型化と商品種別の多様化による不動産販売事業の規模拡大、一部の収益不動産の長期保有による内部成長と保有期間中の賃料収入の拡充、戦略的業務提携やＭ＆Ａなどの社外との連携を進めています。不動産賃貸事業と不動産管理事業は安定収益と位置付け、営業活動の強化とＩＴを活用した管理業務の効率化で受託戸数を拡大し、安定収益で固定費を賄えるまでの成長を目指しています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "収益の改善が必要な中古不動産について、物件エリアの市場環境や周辺の対抗物件を調査したうえで、リーシングやリノベーションを含む具体的な収益改善プランを作成・実行し、賃貸ニーズに合致する物件へ再生する「空室の改善力」を強みとしています。販売した物件の管理受託にもつなげ、販売・賃貸・管理を一体で手がけています。",
        "basis": "経営方針、経営環境及び対処すべき課題等及び事業の内容の記載に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "同社が取り扱う都心や首都圏の優良なオフィス・店舗ビルやレジデンスは、空室率や賃料が安定的に推移し、国内外の不動産投資家の需要が高いとされています。一方で、政策金利の段階的な引き上げによる借入コストの上昇が、不動産購入や不動産投資を抑制する可能性があるとされています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
