  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "官民協働をエンジンに地方創生を支援する「地方創生プラットフォーム構想」を掲げ、地域社会の情報発信や交流を支援する「コミュニケーション・プラットフォーム」と、地域社会のDXを推進する「ソリューション・プラットフォーム」の２つで構成します。行政情報誌『わが街事典』は1,100を超える自治体との協働発行を実現し、デジタルサイネージ『わが街ＮＡＶＩ』は官民協働で300を超える箇所に設置しています。あわせて、AI研修の導入など人的資本への投資による社員の能力・生産性の向上と原価低減・経費削減に取り組み、グループの事業とシナジー効果が期待される企業とのアライアンスやM&Aも検討・実施して事業領域の拡大をはかり、連結売上高の増加を目指しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、平成18年（2006年）に始めた官民協働型の行政情報誌という事業モデルを約20年にわたって積み上げ、全国約1,700の基礎自治体のうち1,100を超える自治体との協働発行の実績を持つことです。全国約40の営業拠点で地域事業者から広告を集める体制に加え、自社グループで情報誌の配布やDM発送まで担うため、発行から配布までを一貫して提供できます。創業以来70有余年にわたり電話帳を発行してきた地域密着の基盤も土台になっています。",
        "basis": "事業の内容における事業内容と連結子会社の位置づけの記載、セグメント情報等における報告セグメントごとの外部顧客への売上高の記載、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の状況の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "行政情報誌『わが街事典』は事業開始以来の共同発行自治体数が通算1,155に達し、改訂版を含めた発行版数は通算3,007、発行部数は通算約１億4,500万部です。デジタルサイネージ『わが街ＮＡＶＩ』の設置は通算310箇所です。売上高の構成は、DMソリューションを担うロジスティクス事業が最も大きく、次いで情報メディア事業が続きます。売上高の10％以上を占める特定顧客は存在しません。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における経営成績等の状況の概要とセグメント別の状況の記載、セグメント情報等の関連情報（地域ごとの情報・主要な顧客ごとの情報）の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
