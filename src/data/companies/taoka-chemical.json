  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度を初年度とする中期経営計画「TCG as one 2027」を策定し、コンプライアンスの徹底と安全・安定操業の継続を最優先に、収益力の向上、生産体制の拡充、研究開発の強化、DX推進、従業員エンゲージメントの向上、サステナビリティ製品の開発を基本戦略としています。長年培ってきた有機合成技術を基に、暮らしと環境のイノベーションに貢献することを使命としています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "計画の軸は、既存事業の深耕と新規開発品の早期上市で事業規模の拡大を図りながら、プラント再編や工場自動化で生産体制を作り替えることにあります。研究開発とDXをその土台に置く構成です。",
        "basis": "経営方針、経営環境及び対処すべき課題等（中期経営計画、対処すべき課題）、セグメント情報（報告セグメントごとの売上高）、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1922年に合成染料の製造に着手して以来の有機合成技術の蓄積が土台にあります。多目的合成工場や新多目的プラントなど、少量多品種の精密化学品に対応する生産設備を持ち、農薬中間体から電子材料まで幅広い製品を手がけています。",
        "basis": "沿革、事業の内容、経営方針、経営環境及び対処すべき課題等（中期経営計画）、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の98％超を化学工業セグメントが占めています。主要な顧客ごとの情報では三菱瓦斯化学株式会社が最大の販売先で、親会社の住友化学株式会社も主要な販売先です。地域別の売上高は日本が28,925百万円、中国が3,035百万円で、インドと上海の子会社を通じた海外供給も行っています。",
        "basis": "セグメント情報（報告セグメントごとの売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）、関係会社の状況、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
