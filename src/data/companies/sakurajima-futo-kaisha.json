  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "次世代に残せる事業構造への転換とサステナビリティ経営の推進を最重要課題とし、Visionのもとで第４次中期経営計画（2024年度～2026年度）「産業構造の変化に対応する次世代ビジネスへのStep2」を実践しています。基本方針は、中長期的視点に立った事業ポートフォリオの継続的改善と必要な投資の検討・実施、それを可能にする資本・財務政策の実施、サステナビリティ経営の一層の推進です。ばら貨物では汎用性の高いばら貨物倉庫の新設に着手し2026年度中の完工に向けて工事を進めており、液体貨物では石炭の需要縮小を見据えて野積場用地に石油化学品向けのステンレスタンクの新設を検討しています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、石炭など従来の取扱貨物の需要変化に対応して、ばら貨物では汎用性の高い倉庫への投資で新規貨物の誘致を図り、液体貨物では石油化学品向けタンクへの転換を進めるなど、貨物構成の変化に合わせて設備と用地の使い方を組み替えていくことです。",
        "basis": "経営方針の記載（中期経営計画の基本方針と両セグメントの進捗）に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、大阪港北部にあって内外の主要航路と内陸部への幹線道路網で結ばれ、京阪神の一大生産・消費地帯を背後に持つ立地と、高性能を誇る大型荷役機械、各種専用倉庫、約13万キロリットルのタンクと大型タンカーが接岸可能な岸壁といった設備を一体で備え、受入から保管、需要家納入までを一貫輸送体制で処理できることです。",
        "basis": "事業の内容の記載（立地条件、荷役機械・専用倉庫・タンクの設備、一貫輸送体制）に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "大阪湾ベイエリアにおける海陸の中継基地として、エネルギー源・原材料等の地場産業の基幹物資を取り扱う位置づけにあります。取扱貨物は輸入原燃料、化学工業製品、冷凍食品など多種に及び、ばら貨物・液体貨物・物流倉庫の3つの報告セグメントで事業を行っています。",
        "basis": "事業の内容及びサステナビリティ基本方針の記載（海陸の中継基地、地場産業基幹物資の取扱い、セグメント構成）に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
