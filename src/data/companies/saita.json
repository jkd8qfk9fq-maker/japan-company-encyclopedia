  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-21",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「企業の安定と成長」「従業員の幸福」「地域社会への貢献」を掲げ、その具現化を大きなテーマとしています。優先的に対処すべき課題として、建設事業では施工管理能力・技術提案力の向上と収益性を重視した安定的な受注の確保、人財確保・育成の推進を、建材事業では生産効率の向上と製造原価の低減、適正な販売単価交渉の推進を挙げています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約９割を建設事業と建材事業が占める構成です。2026年６月期は、建材事業の売上高が前連結会計年度から21.5％減少したことが、全体の減収の主な要因となりました。",
        "basis": "セグメント情報における外部顧客への売上高（建設事業3,282百万円、建材事業3,086百万円、酒類事業294百万円、その他372百万円）と、経営成績等の分析における事業別の売上高の増減率の記載に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "砕石場と生コンクリート工場をグループで保有し、建設工事に必要な資材をグループ内で供給できる体制を持っています。運搬もグループ会社が担い、採石から施工までを一貫して手がけられます。",
        "basis": "事業の内容における建材事業の構成（砕石の製造販売、生コンクリートの製造・販売、運搬業務）と、主要な設備の状況における砕石生産設備・生コン生産設備の記載に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "福岡証券取引所に単独上場し、本社は福岡県朝倉市にあります。朝倉市役所をはじめ地元の官公庁が主要な顧客であり、地域に根ざした事業基盤を持つ会社です。",
        "basis": "表紙の上場金融商品取引所名（福岡証券取引所）と、セグメント情報の関連情報における主要な顧客ごとの情報（朝倉市役所向け売上高742百万円、総売上高に対する割合10.5％）に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
