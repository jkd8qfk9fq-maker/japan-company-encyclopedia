  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年2月期から2028年2月期までの「中期経営計画2028」を掲げ、「新規顧客獲得人数の拡大」と「LTVの向上」を重要な成長戦略としています。新規顧客獲得の拡大では、商品企画マーケティングチームが販促活動を見据えた商品企画を担い、「ヒット商品の企画モデル」を開発フローに導入して商品ラインナップの拡充を図るほか、生成AIの活用により高品質なクリエイティブを量産できる仕組みを整備し、将来的には年間10商品の発売が可能な体制の確立を目指すとしています。LTVの向上では、購入フローを「申込・購入時」「商品のお届け時」「商品使用時」に分解した改良やCRMの強化により、顧客満足度と継続率の向上を図るとしています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社の広告運用で集客し自社ECサイトで販売するD2Cモデルにより、顧客の流入経路や購買履歴などの行動データを自社で直接取得・蓄積し、商品企画から販売までを一体的に最適化しています。広告最適化システムやLTV算定システムなどの主要システムを自社で開発・運用し、顧客データをもとに新規顧客獲得に使える広告宣伝費の上限を商品ごとに設定して日次で採算を検証する仕組みを持っています。加えて、約100名のWEBマーケティング部がクリエイティブの企画・制作から運用までを自社内で一貫して行っています。",
        "basis": "【事業の内容】に、主な販売を自社の広告運用による集客を通じて自社ECサイトで行うD2Cモデルを採用し、顧客行動データを自社で直接取得・蓄積して商品企画から販売までを一体的に最適化していること、広告最適化システムやLTV算定システム等を自社で開発・運用していること、約100名の従業員で構成されるWEBマーケティング部を擁していることが印字されていること。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主力商品のマイクロニードル化粧品『ヒアロディープパッチ』を含むディープパッチシリーズは、「美容用マイクロニードルスキンパッチ」における最大のブランドとして、売上世界一で6年連続ギネス世界記録に認定されています。",
        "basis": "【事業の内容】に、ディープパッチシリーズが売上世界No.１として６年連続でギネス世界記録に認定され、第一弾の『ヒアロディープパッチ』が「美容用マイクロニードルスキンパッチ」における最大のブランド（2019年３月～2025年２月）であることが印字されていること。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
