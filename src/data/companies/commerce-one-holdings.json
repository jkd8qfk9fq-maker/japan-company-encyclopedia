  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "テクノロジーを活用する人の力を最大化させるコマースプラットフォームであることをミッションに掲げ、導入企業数の拡大と、ソリューション間のクロスセルやAPI連携による顧客単価の向上、グループ内シナジーの追求に取り組むとしています。あわせて、生成AIを活用した次世代の統合型ECプラットフォームの開発や、持分法適用関連会社を通じた環境エネルギー事業への開発投資も進めています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ECサイトの表側であるサイト構築から、受注・在庫管理などの裏側の業務、サイトの信頼性を第三者が認証する仕組みまでをグループでそろえ、ECサイト運営に必要なサービスをワンストップで提供できる体制が強みです。",
        "basis": "【事業の内容】に、サイトインターフェースの構築、受注処理・在庫管理システムと複数店舗管理、運営サイトの信頼性第三者認証のそれぞれをワンストップで提供可能になった旨と、各連結子会社の運営する事業はECサイト運営支援の観点で密接に繋がっている旨が印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のBtoC-EC市場が拡大を続ける中で、国内中堅・中小のECサイト運営企業を主な顧客とし、EC業界のビジネスインフラとしての地位確立を目指して事業を展開しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、BtoC-ECの市場規模は2024年時点で約26.1兆円である旨と、対処すべき課題としてEC業界のビジネスインフラとしての地位確立のため幅広いEC事業運営者へのサービス導入を目指す旨が印字されているため。",
        "asOf": "2026-06-24",
