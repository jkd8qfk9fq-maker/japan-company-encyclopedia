  "history": [
    {
      "year": 1896,
      "title": "日本製粉株式会社を設立",
      "description": "東京深川扇橋に設立され、日本で初めて欧米式の機械製粉設備を採用して操業を始めました。",
      "significance": "現在のニップンにつながる創業です。",
