  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループミッションとして「地球の未来に『信頼と安心』を届ける」を掲げ、ビジョンとして「誠実に問題解決にとりくみ 新たな価値創造に挑戦しつづける」を掲げています。2025年3月期から2027年3月期までの「2026中期経営計画」では、事業拡大への挑戦、積極的な成長投資、盤石な事業・経営基盤の構築を推し進め、最終年度である2027年3月期の連結売上高の目標を2,000億円としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コア事業である配・分電盤やキャビネット等において、標準品から特注品まで幅広く対応できる製品ラインアップを持ち、全国を網羅する販売網と、最新の試験設備・評価技術に裏打ちされた生産体制を備えていることが、有報の記載から読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、電気・情報インフラ関連 製造・工事・サービス事業が119,877百万円と全体の6割を超え、流通事業が59,956百万円、電子部品関連 製造事業が15,949百万円でした。本邦の外部顧客への売上高が連結売上高の90％を超えており、国内市場が中心です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
