  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「快適で健康なヒューマンライフの創造に貢献する」のもと、健康・医療をメインテーマに事業を展開し、グローバルなメディカルカンパニーへと飛躍することを目指しています。現在はウォーターヘルスケア事業が連結売上高の87.5％を占めますが、電解水透析事業や再生医療関連事業を展開する医療関連事業を、新たな事業軸の一つとして構築していく方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "収益の柱であるウォーターヘルスケア事業では、整水器販売に加えて浄水カートリッジの継続販売が安定した収益基盤となっており、インドネシアのボトルドウォーター事業が成長を牽引しています。医療関連事業では、細胞バンクの保管検体数の増加が将来の継続収入につながる構造になっています。",
        "basis": "セグメント情報の事業別売上高、関連情報の製品及びサービスごとの情報、MD&Aの経営成績の分析に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "30年以上にわたり産官学共同研究を実施し、その成果を国際学術誌に論文として多数発表してきた科学的エビデンスの裏付けを掲げている点と、医療関連事業の展開そのものが整水器販売を中心とするウォーターヘルスケア事業への波及効果を生むと位置付けている点が特徴です。",
        "basis": "経営方針の研究開発に関する記載、事業の内容に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電解水素水整水器の製造販売を中核とし、連結子会社に上場会社の株式会社ステムセル研究所を持つ、健康機器と医療関連の複合企業です。地域別では日本が中心で、海外売上はインドネシアのボトルドウォーター事業が大半を占めます。",
        "basis": "事業の内容、関係会社の状況、セグメント情報の地域ごとの情報に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
