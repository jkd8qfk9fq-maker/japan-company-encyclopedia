  "history": [
    {
      "year": 1898,
      "title": "大師電気鉄道が創立",
      "description": "京急の前身のひとつ、大師電気鉄道株式会社が創立されました。1899年に六郷橋〜大師間で営業を始め、同年に京浜電気鉄道株式会社へ商号を変えています。",
      "significance": "京急の鉄道事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1925,
      "title": "湘南電気鉄道が創立",
      "description": "湘南電気鉄道株式会社が創立され、1930年に黄金町〜浦賀間などを開通しました。",
      "significance": "三浦半島方面の路線を築いた、もうひとつの前身です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1933,
      "title": "京浜電気鉄道と湘南電気鉄道が直通運転を開始",
      "description": "両社が相互に電車の直通運転を始め、品川〜浦賀間がつながりました。1941年には京浜電気鉄道が湘南電気鉄道を合併しています。",
      "significance": "現在の京急線の骨格がこの時期にできました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1948,
      "title": "東京急行電鉄から分離して京浜急行電鉄が創立",
      "description": "小田急電鉄、京王帝都電鉄とともに東京急行電鉄から分離し、京浜急行電鉄株式会社が創立されました。1949年には東京証券取引所に株式を上場しています。",
      "significance": "現在の京浜急行電鉄の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1968,
      "title": "品川〜泉岳寺間が開通し都心乗り入れを開始",
      "description": "品川〜泉岳寺間の開通で都心への乗り入れが始まりました。同じ年に京急油壺マリンパークも開業しています。",
      "significance": "都心と三浦半島を直接つなぐ路線網になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1998,
      "title": "羽田空港への乗り入れを開始",
      "description": "天空橋〜羽田空港間が開通し、空港ターミナルへの乗り入れが始まりました。2010年には羽田空港国際線ターミナル駅（現羽田空港第3ターミナル駅）が開業しています。",
      "significance": "空港アクセスは、いまも当社グループの戦略拠点のひとつです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "バス事業を京浜急行バスに完全分社化",
      "description": "京浜急行バス株式会社を設立し、自動車事業を同社に承継して完全分社化しました。",
      "significance": "バス事業をグループ会社が担う形になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "本社を横浜市に移転",
      "description": "本社を東京都港区から神奈川県横浜市に移し、京急グループ本社が完成しました。",
      "significance": "沿線の中心である横浜に本社を置く形になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "SHINAGAWA GOOSと京急油壺マリンパークが閉館",
      "description": "SHINAGAWA GOOSは2021年3月に、京急油壺マリンパークは同年9月に閉館しました。",
      "significance": "レジャー施設の見直しが進みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "京急アセットマネジメントが京急SMTBアセットマネジメントに商号変更",
      "description": "2024年7月に設立された京急アセットマネジメント株式会社が、2025年10月に京急SMTBアセットマネジメント株式会社へ商号を変更しました。",
      "significance": "不動産の運用を扱う会社が、グループに加わっています。",
      "sourceIds": [
        "yuho-2026"
      ],
