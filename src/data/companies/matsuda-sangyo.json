  "history": [
    {
      "year": 1956,
      "title": "卵白の販売を目的に松田産業を設立",
      "description": "東京都中野区に、卵白の販売を目的とする旧・松田産業を設立しました。現在の食品関連事業につながる最初の会社です。",
      "significance": "有報の沿革は、1951年設立の竹善商事（形式上の存続会社）を出発点とし、この会社を食品側の源流として記しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1957,
      "title": "金属の製錬・販売を目的にマツダメタル工業を設立",
      "description": "東京都練馬区に、金属の製錬と販売を目的とする旧・マツダメタル工業を設立しました。現在の貴金属関連事業の源流にあたります。",
      "significance": "食品と金属という2つの事業の流れが、この時期までにそろいました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1978,
      "title": "貴金属のリサイクル事業を目的にマツダ貴金属工業を設立",
      "description": "半導体・電子部品業界を対象とした貴金属のリサイクル事業を目的に、マツダ貴金属工業を東京都練馬区に設立しました。この会社が当社の実質上の存続会社にあたります。",
      "significance": "半導体・電子部品業界で出る貴金属を回収して再び資源にする、現在の主力事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1992,
      "title": "グループ会社を合併し、商号を松田産業に変更",
      "description": "マツダ貴金属工業を存続会社として、松田産業、マツダメタル工業、マツダプロセシングと合併し、商号を松田産業に変更しました。同年9月にはマツダ化学から産業廃棄物関連事業の全部を譲り受けています。",
      "significance": "分かれていたグループ会社が1社にまとまり、現在の社名と産業廃棄物関連事業が始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1999年12月に東京証券取引所市場第二部に株式を上場し、2001年9月に市場第一部に指定されました。2022年4月の市場区分見直しでプライム市場へ移行しています。",
      "significance": "上場を経て、海外拠点の設立を進める時期に入りました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "タイに貴金属含有スクラップ回収の会社を設立",
      "description": "貴金属含有スクラップの回収を目的に、Matsuda Sangyo (Thailand) Co.,Ltd.を設立しました。その後もフィリピン、シンガポール、マレーシア、ベトナム、台湾、韓国に貴金属関連の拠点を設けています。",
      "significance": "電子部品の生産が集まるアジアで、スクラップの回収から製錬までを現地で行う体制の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "食品専門商社のガルフ食品の株式を取得",
      "description": "食品の専門商社であるガルフ食品の株式を取得し、連結子会社としました。2012年以降、中国・タイ・ベトナム・インド・インドネシアに食品の輸出入と卸売を担う会社も設けています。",
      "significance": "食品関連事業を、国内の取扱から海外の輸出入・卸売へ広げる動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "リチウムイオン電池のリサイクル事業の拡大へ山陽レックなどの株式を取得",
      "description": "2025年2月、リチウムイオン電池のリサイクル事業の拡大などを目的として、山陽レックとフラップリソースの株式を取得しました。",
      "significance": "貴金属関連事業で、電池のリサイクルへ取扱の幅を広げる動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
