  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、コア市場であるヘルスケアウェア・ドクターウェアの深耕、手術ウェア・患者ウェアの周辺市場のシェア拡大、東アジアを中心とする海外ビジネスの開拓、感染対策商品の開発、国内・海外での生産施策の推進、企画・生産・販売の一貫体制の強化を掲げています。",
        "asOf": "2025-11-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社で企画・開発し、秋田県の製造子会社で生産する企画・生産・販売の一貫体制を持ち、高品質・高付加価値・短納期の商品供給体制の強化を掲げています。国内生産に加えて海外生産も組み合わせ、多品種小ロット生産に対応しています。",
        "basis": "【事業の内容】における製造子会社からの供給の記載、【経営方針、経営環境及び対処すべき課題等】における国内・海外での生産施策の記載、【主要な設備の状況】における製造子会社の生産設備の記載に基づく",
        "asOf": "2025-11-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "メディカルウェア等の製造・販売の単一セグメントで、2025年８月期の市場別の販売実績はコア市場11,996百万円、周辺市場4,763百万円、海外市場223百万円です。主要な顧客であるワタキューセイモア株式会社への売上高は3,287百万円で、連結売上高の19.4％を占めます。地域ごとの情報は、本邦の外部顧客への売上高が連結売上高の90％を超えるため省略されています。",
        "basis": "MD&A（経営成績等の状況の概要）の市場別の販売実績、セグメント情報の関連情報（製品及びサービスごとの情報・地域ごとの情報の省略理由、主要な顧客ごとの情報）の記載に基づく",
        "asOf": "2025-11-19",
        "sourceIds": [
