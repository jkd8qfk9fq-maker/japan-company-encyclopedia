  "updatedAt": "2026-11-22",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2050年を見据えた経営ビジョン「美しい京阪沿線、世界とつながる京阪グループへ」の実現に向け、長期経営戦略と3ヵ年の中期経営計画「真価を磨く 2028」（2026～2028年度）を策定しました。「くらしと観光を彩るまちづくり企業」として京阪沿線の価値を高め続けることを掲げ、長期経営戦略の主軸戦略は「沿線再耕」「体験価値共創」「地球環境保全」で、京阪版SDGsと位置づける「BIOSTYLE」を軸にした経営を推進するとしています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "沿線の拠点開発を着実に進めるとともに、沿線に息づく歴史・伝統・文化を発掘し、商品・サービスへ付加して事業を高付加価値化することで収益力の向上を図るとしています。また、全事業が連携して「くらし」と「観光」の両面で沿線価値を磨き上げ、エリア全体の価値向上を見据えた投資を続ける方針です。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "大阪・京都・滋賀を結ぶ鉄道網を基盤に、沿線の不動産開発・賃貸、百貨店やショッピングモール、ホテルまでを一つのグループで一体的に展開していることが特徴です。鉄道の利用者を沿線の商業や住まい、観光にもつなげる複合型の事業構成になっています。",
        "basis": "【事業の内容】と【セグメント情報】に記載された事業構成（子会社51社・関連会社6社、5つの報告セグメント）に基づく。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
