  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "どのような経営環境下においても常に安定した収益を確保できる経営体制の確立を目指し、当社の強みを生かせる製品・ノウハウを3つ以上の市場に提供することにより、景気変動や市場動向に柔軟に対応できる盤石な経営基盤を構築するとしています。自社製品の開発・販売と主要顧客からの受託開発・受託生産を事業の両輪とし、X線残留応力測定装置関連、ヘルスケア装置関連、光応用・特殊機器装置関連の3つの柱を中核事業と位置付け、新たな事業の柱となり得る新製品や新規事業の創出を目指すとしています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電子技術、精密機械技術、ソフトウェア、光波センシング技術の各要素技術を複合した製品開発を得意としており、ポータブル型X線残留応力測定装置などの当社独自のカタログ製品の開発に加え、優良顧客からの要請に基づく受託開発や共同開発にも積極的に取り組んでいます。パーパスに掲げるとおり、光に関する技術をコアコンピタンスと位置付け、見えないものを見える化する計測技術を強みとしています。",
        "basis": "研究開発活動に、電子技術、精密機械技術、ソフトウェア、光波センシング技術の各要素技術を複合した製品開発を得意とし、カタログ製品の開発と受託開発・共同開発に取り組むと印字され、経営方針のパーパスに「光」が当社のコアコンピタンスと印字されているため。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "1968年創業の計測・検査機器メーカーで、2000年に東京証券取引所市場第二部に上場し、現在はスタンダード市場に上場しています。製品の販売先は輸送機器、医療機器、半導体製造装置などの関連業界に広がり、米国子会社を通じて米国市場でも製品販売及び保守サービスを行っています。",
        "basis": "沿革に1968年の創業と2000年の東京証券取引所市場第二部への上場が印字され、経営方針に製品は輸送機器、医療機器、半導体製造装置等の関連業界を主な販売先とすると印字され、事業の内容にPulstec USA,Inc.が米国市場における製品販売及び保守サービスを行うと印字されているため。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
