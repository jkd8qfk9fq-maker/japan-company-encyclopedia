  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2022年11月1日付で普通株式1株につき2株の割合の株式分割を行っています。有報の連結経営指標等の株式数に係る数値は、この分割が2022年10月期の期首に行われたと仮定して算定されています。",
      "businessModel: 2025年10月31日の取締役会決議に基づき、2025年11月1日から2026年4月30日までを期間とする自己株式の取得を実施しています。2025年12月31日までに35,700株を取得済みです。取得期間は有報の提出日時点で終了しておらず、残りの取得は予定です。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年12月9日に2027年10月期を最終年度とする「泉州電業グループ中期経営計画」を策定し、連結売上高1,600億円の達成を目標としています。収益の長期安定化と継続的成長に向け、技術商社としての商品開発と加工部門の強化、営業・物流機能の拡充、産業機械向けＦＡケーブルの売上構成比の向上、海外での収益拡大など10の経営戦略を実行します。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "メーカーと共同で新たなオリジナル商品を開発し、加工部門を強化する技術商社としての体制と、全国の営業・物流拠点によるジャスト・イン・タイムの商品提供を強みとします。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年10月期の連結売上高135,591百万円のほぼ全てが電線・ケーブル事業によるものです。本邦の外部顧客への売上高が連結売上高の90％を超え、連結売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント情報と関連情報の印字に基づきます。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
