      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "株式会社ノーリツとの資本・業務提携",
      "description": "株式会社ノーリツとの資本・業務提携を締結しました。",
      "significance": "給湯機器メーカー同士の提携で、現在も相互に株式を保有しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "ウルトラファインバブル搭載給湯器の製造開始",
      "description": "ウルトラファインバブル搭載給湯器の製造を開始しました。",
      "significance": "快適さ・健康を追求した新しい給湯器です。",
