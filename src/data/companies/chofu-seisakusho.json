  "history": [
    {
      "year": 1954,
      "title": "株式会社長府製作所の設立",
      "description": "山口県経済農業協同組合連合会の長府工場を譲り受け、株式会社長府製作所を設立して農機具の製造を開始しました。",
      "significance": "当社の実質的な起源です。現在の事業は農機具から始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "全自動温水ボイラの開発とセントラルヒーティング部門への進出",
      "description": "全自動温水ボイラを開発し、セントラルヒーティング部門に進出しました。栃木県塩谷郡高根沢町に栃木工場を建設しました。",
      "significance": "現在の給湯・暖房事業につながる進出です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1974,
      "title": "ステンレス浴槽の製造開始",
      "description": "ステンレス浴槽の製造を開始し、住宅機器総合メーカーを目指すこととしました。",
      "significance": "農機具・ボイラから住宅機器全般へ広がる転機です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "家庭用ルームエアコンの製造開始",
      "description": "家庭用ルームエアコンの製造を開始し、滋賀工場を建設しました。",
      "significance": "空調機器への展開が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1979,
      "title": "吸収合併と太陽熱温水器の製造開始・広島証券取引所への上場",
      "description": "株式の額面変更のため、1950年に設立された株式会社長府製作所（旧商号は長府ボイラー株式会社）に吸収合併されました。あわせて太陽熱温水器の製造を開始し、広島証券取引所に上場しました。",
      "significance": "形式上の存続会社との合併で、実質上の存続会社は1954年設立の当社です。ソーラー機器と上場の始まりでもあります。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1984,
      "title": "ガス給湯器の製造開始",
      "description": "ガス給湯器の製造を開始しました。",
      "significance": "石油に加えてガス熱源の給湯機器が加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1991,
      "title": "システムバスの製造開始",
      "description": "システムバスの製造を開始しました。",
      "significance": "システム機器の中心製品が加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "東京証券取引所市場第二部への上場",
      "description": "東京証券取引所の市場第二部に上場しました。",
      "significance": "東京証券取引所への上場です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1998,
      "title": "東京証券取引所市場第一部への指定",
      "description": "東京証券取引所の市場第一部に指定されました。本社に研究棟（技術センター）を建設しました。",
      "significance": "上場市場における位置付けが高まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "エコキュートの製造開始",
      "description": "CO2ヒートポンプ給湯機（エコキュート）の製造を開始しました。香川工場を本社工場へ統合しました。",
      "significance": "ヒートポンプ給湯機が現在の製品群に加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "サンポット株式会社の全株式取得",
      "description": "サンポット株式会社の全株式を取得しました。潜熱回収型石油給湯器（エコフィール）の製造も開始しました。",
      "significance": "北海道の給湯機器メーカーがグループに加わりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "大規模太陽光発電の開始",
