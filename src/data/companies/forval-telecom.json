  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "親会社フォーバルの「社会価値創出企業」という目指す姿のもと、情報通信サービスの分野で、ユーザーの視点に立ったより良いサービスを創造し提供していくことで新たな社会価値の実現を目指すとしています。中長期的には、中小法人ユーザーを主要ターゲットとして、超高速通信インフラを利活用したサービスメニューを創出し、成長力の強化に努めていく所存であるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳は、ユーティリティ・ビジネスが10,851百万円と全体の45.3％を占めて最大で、IP ＆ Mobileソリューション・ビジネスが9,377百万円、コンサルティング・ビジネスが3,743百万円です。当期は連結子会社2社を親会社へ譲渡して連結範囲から除外したことにより売上高は前期比6.7％減となりましたが、電力・ガスの契約件数は堅調に伸びたとされています。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自ら構築した顧客データベースと課金・請求システムを持ち、顧客への請求と回収を自社で行う「ビリングプロバイダー」であることが土台になっています。通信設備は一部分を保有するのみで、保有していない設備によるサービスは電気通信事業者などから仕入れて提供するため、仕入先からは通信回線などを一括して卸売する大口ユーザーとして位置付けられるとされています。",
        "basis": "事業の内容のサービス提供形態とビリングプロバイダーの記述、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "親会社の株式会社フォーバルが2026年3月31日現在で議決権の70.15％を保有する上場子会社です。売上高の半分近くを電力・都市ガスの小売が占め、通信サービスと合わせて中小法人向けに複数のインフラサービスを提供しています。特定の顧客への売上高が連結売上高の10％以上を占める顧客はないとされています。",
        "basis": "大株主の状況、関係会社の状況、関連情報の主要な顧客ごとの情報、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
