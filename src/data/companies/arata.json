  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "会社は、「美と健康、清潔で快適な生活を創造する」を経営ビジョンとしています。2026年3月期を最終年度とする「中期経営計画2026」では売上高1兆円を達成した一方、コストコントロールと資本収益性に課題を残したとして、最終フェーズの「中期経営計画2030」を策定しました。テーマは「強さを磨き、未来を拓く」で、前半は成長投資によるコスト増が収益に影響するとみて「戦略的投資フェーズ」と位置づけ、卸事業の体質強化と成長戦略で後半にかけて収益改善を図るとしています。事業戦略には、独自性の強化によるインストアシェアの拡大、新たな成長ドライバーの確立、売上拡大を支える機能強化、グループ会社の収益性改善を挙げ、2030年3月期の売上高を含む定量目標を掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は、設立時から小売業の「店頭」を意識してきたことと、強みである独自の情報分析を生かして消費者の生活様式や購買意識の変化を捉えるカテゴリー戦略を、自社の特色として述べています。ペット関連商品ではペット専門卸商社であるジャペル株式会社の専門性を生かした提案を行い、専売・優先流通品の拡大でグループの独自性を強めているとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    }
