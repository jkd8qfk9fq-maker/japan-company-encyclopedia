  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年3月期から2027年3月期までを計画期間とした「中期経営計画2027」に基づき持続的な成長を目指し、上質な住まいづくりの追求、資本回転を意識した事業運営、分譲事業における安定した案件パイプラインの整備の3点に注力します。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "新築分譲マンションの開発・分譲から中古不動産の流通、管理、賃貸まで、住まいのライフサイクルに沿った事業をグループ内で一体的に手がけています。分譲したマンションの管理やリフォーム、購入者への住宅ローンまで自社グループで対応できる体制です。",
        "basis": "【事業の内容】の事業構成に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは分譲事業、流通事業、管理事業、賃貸事業の4つです。2026年3月期の外部顧客への売上高は、分譲事業55,196百万円、流通事業27,464百万円、管理事業6,656百万円、賃貸事業661百万円、その他130百万円です。海外の外部顧客への売上高はなく、売上高の10％以上を占める主要な顧客はいません。",
        "basis": "セグメント情報の報告セグメントごとの売上高と、関連情報の地域ごとの情報及び主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
