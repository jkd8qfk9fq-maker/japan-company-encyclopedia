  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「マーケティングソリューションで日本を代表する企業へ」というビジョンのもと、ソリューション事業では「Keywordmap」の新機能開発やカスタマーサクセス体制の強化による契約件数の拡大と、オプションプラン等による契約単価の引き上げを推進する方針です。アナリティクス事業ではコンサルタント及びセールスの採用と育成を進め、生成AI時代に対応したマーケティング支援サービスの販売・提供で新しい顧客基盤の拡大を図るとしています。M&A仲介事業では、マーケティングの知見やネットワークを活用してM&A機会を創出する役割を担うとしています。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業時から研究開発を続けてきたクローリングや自然言語処理、データベースの取扱技術を土台に、日本語キーワードのビッグデータを自社で保有し解析できる点が特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、創業時からデータ取得のためのクローリング、自然言語処理技術、データベース取扱技術の研究開発に関して強みを持っていることが印字され、【事業の内容】に、「Keywordmap」は当社が保有する日本語キーワードのビッグデータに対し、自然言語処理、機械学習、深層学習技術および統計学を用いた解析・分析を行い、マーケティングに活用可能なデータとして提供するプロダクトであることが印字されています。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "企業のマーケティング活動のデジタルシフトが続く環境で、DXコンサルティングやデジタルマーケティングを支援するサービスへの需要は拡大傾向にあり、生成AIの普及による検索行動の変化が企業に新たな対応を求めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、企業のマーケティング活動のデジタルシフトが続いていることから、DXコンサルティングや「Keywordmap」等のデジタルマーケティングを支援するサービスへの需要は引き続き拡大傾向にあること、生成AIプラットフォームの台頭により企業の消費者との接点に構造的な変化が生じていることが印字されています。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
