  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「人づくり、製品（物）づくりを通して広く社会に貢献する」を経営理念とし、顧客満足度を高め企業価値を向上させることを経営の基本方針としています。対処すべき課題として、選択と集中による経営基盤の再構築と収益力の改善に取り組むほか、新製品の展開、ASEANを中心とする海外事業の強化、人財の育成といった成長への投資を掲げています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本・マレーシア・中国の3地域に生産・販売体制を持ち、海外ではアジア・北中米・ヨーロッパを現地法人が担当する分担体制が、供給面の強みになっています。",
        "basis": "【事業の内容】と報告セグメントの概要に、国内は当社が、海外はアジア・北中米・ヨーロッパの各地域を当社とマレーシア・中国の現地法人が担当し、現地法人が生産と販売を分担する旨が印字されていること",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
