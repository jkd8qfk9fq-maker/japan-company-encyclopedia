  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社は、コンテンツ事業について、中期経営計画「アクセルプラン」に基づき獲得してきたコンテンツと数年来の構造改革による支出の適正化を土台に、国内の新規事業展開とベトナム・インドネシア・タイなどでの海外展開を積極的に進める方針です。グループの対処すべき課題として「東南アジアにおける事業の推進とグローバル化への対応」を掲げています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "連結の売上高はコンテンツ事業の単一セグメントで構成され、Digital Finance事業は持分法適用関連会社の事業として連結業績に影響する構造です。収益の拡大は、コンテンツ事業の受注とロイヤリティ収入の動向、東南アジアでの事業展開の進捗に左右されます。",
        "basis": "セグメント情報の単一セグメントの記載、主要な顧客ごとの情報、MD&Aの経営成績等の状況の概要、経営方針の記載に基づきます。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当社は、ゲームの企画開発、漫画やアニメ・ゲーム等のエンターテインメント関連の書籍及び電子書籍の企画編集、コンテンツを商品・イベント化する企画開発など、コンテンツ商品の企画開発分野で独自性を持って展開しているとしています。10年以上にわたる事業の選択と集中、生産性の改善とコストの適正化により、コンテンツ事業は長期的に業績の改善が進んでいるとしています。",
        "basis": "MD&Aのコンテンツ事業に関する認識及び分析・検討内容、【事業の内容】の記載に基づきます。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客ごとの情報では、2025年９月期の売上高のうち株式会社コナミデジタルエンタテインメントが28.1％、株式会社集英社が19.7％、株式会社バンダイが12.5％を占めており、大手ゲーム・出版事業者との取引が売上高の中核になっています。",
        "basis": "セグメント情報の主要な顧客ごとの情報、MD&Aの販売実績の記載に基づきます。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
