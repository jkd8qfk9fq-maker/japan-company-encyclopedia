  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョン「ペットライフをハッピーに」のもと、テクノロジーを活用してペットのQOLの最大化を目指すとしています。中期成長戦略では、従来のナショナルブランド中心・コマース主体の成長モデルから事業構造の転換を進め、既存ECの収益基盤の再構築、DTCブランドの拡大、M&Aを通じたメディアやケアなどのコト消費領域への展開、アライアンスを通じた新たな顧客接点と収益機会の創出に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社ECと複数の他社EC、オフラインを横断した販売を通じて、飼い主の顧客データに加え、ペットの種類や品種、ライフステージ、疾患や悩み、購買商品などのペットデータを蓄積しています。このデータを自社ブランド商品の企画開発やマーケティング、グループ会社への送客に活用しています。自社ECの売上高に占める定期購入の割合は2026年3月期で56％まで高まっています。",
        "basis": "事業の内容に、顧客データとペットデータの蓄積とその活用事例、自社ECにおける定期購入比率の推移（第22期で56％）が印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "動物病院で購入されることが一般的だった動物用医薬品や食事療法食などを、動物病院以外の販売経路で販売するペットヘルスケアの通販会社です。売上高に占めるオンライン店舗の割合は約90％で、オンライン店舗の売上高の約80％はリピート顧客によるものです。犬の飼育頭数が減少傾向にある一方で、犬猫の平均寿命の伸長やペット関連支出の増加を背景に、ヘルスケア分野の需要は拡大していると会社は捉えています。",
        "basis": "事業の内容に、ペットヘルスケア商品の販売経路、オンライン店舗の売上割合とリピート顧客の割合が印字され、経営方針に飼育頭数や平均寿命、ペット関連支出の動向が印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
