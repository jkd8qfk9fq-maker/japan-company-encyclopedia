  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から中長期経営計画「Go Beyond! next20」の3ヶ年フェーズを迎え、既存の事業分野の安全で信頼性の高い事業運営基盤から生まれる堅実な事業収益を、新たな顧客価値の提供に対する金銭及び人的投資に振り向けることを大きなポイントと捉え、各事業の経営環境を踏まえた新たな取り組みと、リスク・課題の優先順位を定めた着実な前進により企業価値の向上に取り組むとしています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "スチュワード事業ではスチュワード業務の確立と収益力の強化を重点課題とし、社内資格試験の刷新による従業員教育、DXやAI・ロボティクスといった先進技術の導入によるバックヤード変革の検討・実行、外国人スチュワードの採用・養成など、人材と技術への投資を進める構成になっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、セグメント情報（外部顧客への売上高）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1984年の設立以来ホテルの食器洗浄・衛生管理を中心に展開してきた実績を持ち、経営成績の分析では40年の実績と業界ナンバーワンのノウハウを武器に新規案件の獲得と既存顧客との契約更改管理を強化すると印字されています。給食事業と音楽・映像・音響・放送機器関連事業を傘下に加え、7社の事業会社からなるグループを形成しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
