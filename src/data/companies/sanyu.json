  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営戦略として、販売数量のシェアアップ、継続的設備投資の実施、社会的責任（ＣＳＲ）の強化、連結経営の強化、海外戦略の取り組みの５つの施策を掲げています。海外戦略では、中国及びタイ国に設立された日本製鉄株式会社を主体とする合弁会社への参加を通じて、現地日系自動車部品メーカーのニーズに対応するとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約３分の２を占めるみがき棒鋼部門を中心に、両部門での拡販と製品の高付加価値化、製品の三次加工分野への展開を進める方針です。労務費などのコスト上昇に対しては、鋼材値上げ分の製品価格への転嫁と持続可能な加工賃の是正を進めるとしています。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報）、経営成績等の状況の概要、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「クオリティー ファーストの追求」を品質方針に掲げ、豊富な在庫量と即納体制で多様化するニーズに対応できる製・販体制の構築を目指しています。みがき棒鋼の製造から精密機械加工までをグループで担い、枚方・八尾・九州の生産拠点と販売物流拠点を備えています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等、主要な設備の状況に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "みがき棒鋼及び冷間圧造用鋼線業界の2025年暦年の生産量は1,449千トンで前年比0.3％増でした。当社グループの2026年３月期の外部顧客への売上高は、みがき棒鋼部門が16,463百万円、冷間圧造用鋼線部門が9,108百万円で、日鉄物産株式会社が売上高の10.7％を占める主要顧客です。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報、主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
