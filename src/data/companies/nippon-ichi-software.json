  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業理念「ゲームは作品ではなく商品である」に基づき、ゲームという分野に限らず年齢・性別・地域を超えたすべての人々に楽しさを提供することを目指しています。中期的な経営計画として国内販売20万本を超えるIP（知的財産）を作り出すことを掲げ、「開発力の強化」「販売力の強化」「生産性の向上」に取り組むとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社でIP（知的財産）を開発して育てる開発体制に加え、北米子会社NIS America, Inc.による欧米向けのローカライズと販売、ベトナムなど海外の開発子会社を持つ体制により、国内タイトルを海外市場へ展開できる点が強みです。",
        "basis": "【事業の内容】及び【関係会社の状況】に印字された事業内容と連結子会社6社の構成（NIS America, Inc.が当社ソフトウェアを米国・欧州に販売し、各開発子会社が当社製品の開発を担う関係内容）に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の大部分をエンターテインメント事業が占め、地域別では米国向けの販売が最も大きく、海外販売への依存度が高い構成です。ゲーム業界ではeスポーツ市場の発展やモバイルゲーム市場の拡大、デジタル化の進展が続いているとの認識が示されています。",
        "basis": "セグメント情報の外部顧客への売上高（エンターテインメント事業3,485百万円、学生寮・その他事業120百万円）と地域ごとの情報、ゲーム業界の環境認識の記載に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
