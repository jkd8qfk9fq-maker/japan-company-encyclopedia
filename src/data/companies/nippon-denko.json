  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年11月に策定した中長期経営計画で、2030年の「あるべき姿」として「素材と環境で人々の暮らしを支え、より良い未来に向かって挑戦し続ける会社」を掲げ、事業活動を通じた社会課題の解決と持続的な成長を通じた企業価値向上の両立を基本方針としています。2024年から2027年までの第9次中期経営計画では、成長分野への積極的な戦略投資を進め、合金鉄の市況の影響を受けにくい事業構成の構築を目指すとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約6割を占める合金鉄事業は市況の影響を受けやすい一方、機能材料、焼却灰資源化、アクアソリューション、電力の各事業は2025年12月期にいずれも増収または前年並みの売上高で推移しており、合金鉄以外の事業の拡大が進んでいます。",
        "basis": "セグメント情報の外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "機能材料事業では、地政学リスクの回避に貢献する独自製品の拡販を進めるとしています。焼却灰資源化事業では、2030年までに焼却灰溶融炉を現在の4基から7基体制とすることを目指し、5号炉の新設などを決定したと説明しています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "主力拠点の徳島工場では合金鉄と機能材料の両方を生産しており、マンガン系の原料や技術を複数の事業で活用できる体制を取っています。",
        "basis": "主要な設備の状況と事業の内容に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高77,277百万円の内訳は、合金鉄事業48,440百万円、機能材料事業14,819百万円、焼却灰資源化事業8,886百万円、アクアソリューション事業1,656百万円、電力事業1,405百万円、その他2,069百万円です。最大の顧客は日本製鉄株式会社で、同社への売上高は43,759百万円と全体の過半を占めています。本邦の外部顧客への売上高が90％を超えるため、地域ごとの売上高の記載は省略されています。",
        "basis": "セグメント情報の外部顧客への売上高と、関連情報の主要な顧客ごとの情報・地域ごとの情報に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
