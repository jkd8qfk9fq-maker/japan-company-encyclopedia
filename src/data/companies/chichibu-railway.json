  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループ全社が一丸となり、事業基盤の保持・強化を図りつつ新たな事業構造の構築に向け、中期経営計画を策定して具体的な対策を計画・推進するとしています。公共交通機関として輸送の安全、無事故無災害の達成を最優先課題に掲げ、安全面の設備投資や従業員教育を強化するほか、改正地域交通法の枠組みを活用して関係自治体と連携した持続可能性の高い地域公共交通への再構築を検討し、長瀞への誘客促進や駅前不動産の有効活用、人財への投資を進めるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "羽生から三峰口までの沿線で唯一の鉄道路線を運営し、太平洋セメントの原料輸送という継続的な貨物需要と、長瀞・宝登山の観光資源を併せ持っている点が特徴です。",
        "basis": "事業の内容、セグメント情報及び関連情報における路線、主要な顧客並びに観光事業の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "埼玉県北西部を走る地域鉄道で、旅客人員は年間729万人です。沿線の居住人口が減少する中、通勤・通学輸送と観光輸送の双方を担う地域密着型の中小私鉄です。",
        "basis": "事業の内容及び経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における輸送実績の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
