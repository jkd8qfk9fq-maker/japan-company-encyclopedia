  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社会や市場のニーズに合致した商品・サービスを提供し、皆様により一層信頼される安全・安心ブランドへと確立・進化させていくことを基本方針とし、プリペイドカードシステムの普及を通してレジャー産業の健全な発展に貢献するとともに、新たな事業分野に進出することにより、継続的な企業価値の向上に取り組むとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "対処すべき課題として、原材料価格の高騰や調達難への対応に向けた調達プロセスの見直しと生産体制の強化、パチンコホールのコスト意識の高まりに対応するDX化の推進、開発投資の選択と集中、新規事業領域への挑戦（M&Aや資本業務提携等の継続的検討）を挙げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の対処すべき課題、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "機器の販売に加えて、カードの情報管理料やシステム使用料という、システムが使われ続けることで得られる収益を持つ複合型の収益構造です。研究開発はスマート遊技機対応ユニットの企画・開発が中心で、日本ゲームカードとジョイコシステムズの統合で生まれた事業基盤の上に成り立っています。",
        "basis": "事業の内容の取扱品目、研究開発活動、沿革による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業を展開する遊技業界は市場規模が縮小傾向にあり、2026年3月期はスマートパチスロの普及は底堅かった一方でスマートパチンコの普及が想定より低調で、ホール側の設備投資に慎重な姿勢が見られました。主要な顧客ごとの情報では、コスモ・イーシー株式会社が売上高の16.2％、株式会社エース電研が12.2％を占めています。",
        "basis": "セグメント情報の主要な顧客ごとの情報、経営方針、経営環境及び対処すべき課題等の経営環境、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
