  "history": [
    {
      "year": 1949,
      "title": "大阪市で設立",
      "description": "大阪市東成区に設立され、モーターなどの電気機器類の製造・販売を始めました。",
      "significance": "現在の電設資材の卸売りにつながる、会社の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1951,
      "title": "東京支店を新設",
      "description": "東京都港区に東京支店を新設し、東日本地区へ進出しました。",
      "significance": "全国に営業拠点を広げていく最初の一歩になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "事業部を分社",
      "description": "事業部を因幡産業機器、因幡電設資材など5社に分社しました。1988年にはこれらと因幡電工を合併しました。",
      "significance": "事業ごとに会社を分けたあと再び一つにまとめ、現在の事業の形が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1993年の大阪証券取引所市場第二部への上場に続き、東京証券取引所市場第二部に上場しました。1997年には東京・大阪の市場第一部に指定されました。",
      "significance": "株式を広く公開する会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "春日電機を設立し、タイの会社を連結子会社化",
      "description": "春日電機（現在のパトライト）を大阪市に設立しました。同社の事業譲受にともない、タイのSIAM ORIENT ELECTRICを連結子会社にしました。",
      "significance": "自社製品を海外でつくる体制の足がかりになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "パトライトを買収",
      "description": "表示灯や回転灯をつくるパトライトを買収しました。2017年には春日電機がパトライトを吸収合併する形で一つになりました。",
      "significance": "自社製品事業に表示灯・回転灯が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "新東京物流センターを新設",
      "description": "東京都江東区新砂に新東京物流センターを新設しました。",
      "significance": "商品を届ける物流の拠点を強化しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "米国に子会社を設立、プライム市場へ移行",
      "description": "2022年3月に米国にInaba Denko America Inc.を設立しました。同年4月には東京証券取引所の市場区分の見直しにより、プライム市場に移行しました。",
      "significance": "海外展開を進めながら、現在の上場市場区分になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
