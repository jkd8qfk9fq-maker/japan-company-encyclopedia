  "history": [
    {
      "year": 1941,
      "title": "帝都高速度交通営団が設立される",
      "description": "地下鉄の建設と運営を目的に、特殊法人の帝都高速度交通営団が設立されました。同年9月に営業を始め、設立時の営業キロは現在の銀座線の14.3キロでした。",
      "significance": "現在の東京地下鉄の前身です。",
      "sourceIds": [
