      ],
      "locator": "【沿革】(2) 営団の沿革"
    },
    {
      "year": 1954,
      "title": "丸ノ内線が開業する",
      "description": "営団として2番目の路線、丸ノ内線の運輸営業が始まりました。その後、日比谷線（1961年）、東西線（1964年）、千代田線（1969年）、有楽町線（1974年）、半蔵門線（1978年）が順に開業しました。",
      "significance": "地下鉄ネットワークが広がっていった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】(2) 営団の沿革"
    },
    {
      "year": 1991,
      "title": "南北線が開業する",
      "description": "南北線の運輸営業が始まり、2000年9月に全線が開通しました。",
      "significance": "営団最後の新線として、ネットワークがほぼ整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】(2) 営団の沿革"
    },
    {
      "year": 2004,
      "title": "営団が民営化され、東京地下鉄株式会社が設立される",
      "description": "東京地下鉄株式会社法に基づき、営団の財産を現物出資で引き継いで、2004年4月1日に設立されました。営団は解散しました。",
      "significance": "特殊会社として、完全民営化への第一段階になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】(1) 提出会社の沿革"
