  "businesses": [
    {
      "id": "transportation",
      "name": "運輸業",
      "shortName": "運輸",
      "description": "東京都区部を中心に9路線からなる地下鉄ネットワークを保有し、鉄道の運行・運営と鉄道施設などの保守管理を行う報告セグメントです。2026年3月期の外部顧客への営業収益は384,108百万円（前期は370,121百万円）で、最大の事業です。",
      "children": [
        {
          "id": "railway",
          "name": "鉄道事業",
          "shortName": "鉄道",
          "description": "当社が地下鉄の運行と運営を行う事業です。駅の清掃は㈱メトロセルビス、駅の運営管理は㈱メトロコマースが担います。この区分だけの金額は有報に載っていません。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
