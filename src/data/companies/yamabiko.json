  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念は「人と自然と未来をつなぐ」です。中期経営計画2028（2026年12月期－2028年12月期）では、世界中のプロフェッショナルな屋外作業に付加価値を創造する姿を目指し、売上の拡大、収益性の改善、経営基盤の強化に取り組みます。2028年12月期の売上高2,100億円を目標としています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力の小型屋外作業機械では、小型エンジンを鋳造から組立、検査まで一貫して自社開発し、軽量化と高出力化を実現しています。電動製品でもエンジン製品の開発で培った技術を活かし、高い環境性能と作業性を両立させています。グローバルな販売ネットワークと、代理店向けのサービススクールによるアフターサービスも強みです。",
        "basis": "経営方針の競合他社との競争優位性の説明",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高は1,740億20百万円で、前期比5.6％増です。親会社株主に帰属する当期純利益は144億44百万円で、同9.1％減です。地域別では米州の売上高が1,063億86百万円、欧州が183億38百万円で、海外売上高は1,295億47百万円です。従業員数は2,945人です。",
        "basis": "2025年12月期のセグメント情報と地域別売上高、連結経営指標",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【セグメント情報】"
      }
    }
