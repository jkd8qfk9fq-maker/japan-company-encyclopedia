  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「ユニークな発想で新しい価値を創造する」のもと、2030ビジョンとして“あらゆる表面のリノベーション＆イノベーションカンパニーへ”発展することを掲げています。2025～2027年度の中期経営計画では、環境対応を重視した事業拡大、人的資本を中核経営基盤と位置付けること、社会と顧客からの信頼獲得を基本方針とし、サステナビリティ基本方針とあわせて推進しています。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点課題として、低VOC塗料や低温焼付塗料などの環境配慮型製品の提供拡大、蒸留事業の拡大による循環型社会の実現、印刷技術のデジタル化に対応したインクジェット商材や電子材料・モビリティ分野での事業拡大を掲げています。研究開発では、塗料で培った4つの要素技術を組み合わせた製品開発を進める方針です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の優先的に対処すべき課題、セグメント情報の外部顧客への売上高、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "祖業の塗料事業で培ったポリマー合成技術、分散技術、コーティング技術、色彩技術の4つの要素技術が基盤です。同じ要素技術を塗料とファインケミカルの両事業に使えること、中国・フィリピン・ベトナムの生産子会社とタイの販売子会社を持つ海外体制があることが特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の研究開発に関する課題、【事業の内容】の事業系統、【関係会社の状況】の子会社一覧に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年10月期のセグメント別の外部売上高は、塗料事業14,295百万円、蒸留事業5,494百万円、ファインケミカル事業2,484百万円で、塗料事業が連結売上高の中心です。地域別では日本が18,831百万円、アジアが3,020百万円、その他が422百万円でした。最大の顧客であるニチハ向けは連結売上高の24.1％を占めています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント別の経営成績に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
