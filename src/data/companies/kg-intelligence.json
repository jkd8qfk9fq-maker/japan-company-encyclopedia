  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当面の対処すべき課題として、デジタルマーケティング戦略の深化と多角化と、人材採用・人材教育体制の強化の二点を挙げています。ＨＲソリューション関連情報では新機軸サービスの展開を加速し、生活関連情報では「家づくり学校」の展開加速と新規エリアへのアプローチを進めるとしています。",
        "asOf": "2026-03-09",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "紙媒体からインターネットサービスへのシフトが加速する中、自社求人サイトと大手ポータルサイトの連携や、検索流入の減少を上回る成約効率の改善によって、集客の変化に対応しながら収益を維持する構造です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の現状の認識及び具体的な取組み状況と、経営者による分析における事業別の取組みに基づきます。",
        "asOf": "2026-03-09",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1979年の創業以来、中国・四国地方を中心に支社網を築き、地域の求人・住宅情報を紙媒体とインターネットの両方で届けてきた基盤があります。「家づくり学校」はリアル校とオンライン校を合わせた16校体制で運営しています。",
        "basis": "【沿革】の支社設置の経緯、【主要な設備の状況】の事業所一覧、経営者による分析の「家づくり学校」の運営体制に基づきます。",
        "asOf": "2026-03-09",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは情報関連事業のみで、2025年12月期の営業収益27億３千６百万円のうち情報関連事業が22億３千９百万円を占めています。営業収益の10％以上を占める顧客はなく、岡山県・広島県・香川県を中心に各地のエリアへ展開しています。",
        "basis": "セグメント情報等（単一セグメントの旨と主要な顧客ごとの情報）及び経営者による分析の販売実績（エリア別を含む）に基づきます。",
        "asOf": "2026-03-09",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
