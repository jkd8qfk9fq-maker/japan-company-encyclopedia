  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年３月期は、パネトーネ種の特長を活かしたより付加価値の高い新製品の開発と原材料の見直しに注力し、新たな市場の開拓、販路の拡大、適正な価格による取引を図るとしています。あわせて、2026年３月期に決定した設備投資計画（2027年10月操業予定）の実施を着実に進めるほか、子会社の吸収合併等を含む業務の合理化にも努めるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
