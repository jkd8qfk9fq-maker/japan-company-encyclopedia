  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「festaria 2030」を策定し、「精神価値No.1のSPA企業」から「想いを未来につなぐコミュニティ企業」への変革を目指しています。重点方針は「戦略的人材育成による組織力向上」「強みを活かしたCRMの深化・実践」「コミュニティ基盤を支えるDXの推進」の3つで、共感型プラットフォーム「festaria ONE」の実装に向け、2026年春に新基幹システムを本格稼働させる予定です。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企画から製造、販売までを自社で行うSPAの体制を持ち、ベトナムの自社工場では3Dデジタルカスタマイズシステムを活用したオーダーメイド品の製造も行っています。実店舗での接客を土台にしたCRMと、会員制度「festaria Members Club」や販売スタッフが自ら商品を着用して発信する仕組みなど、店舗とECをつなぐ取り組みを進めています。",
        "basis": "事業の内容におけるSPAとベトナム生産工場の記述と、経営方針におけるCRMとDXの記述に基づく。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "宝飾業界では富裕層を中心に高額品の販売が堅調な一方、消費の二極化や節約志向の高まり、原材料費や人件費の上昇が重なる厳しい環境にあります。その中で同社は、国内75店舗と台湾9店舗（2025年8月31日現在）を構える宝飾品専門のSPA企業として位置しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における宝飾業界の環境の記述と、事業の内容における店舗数の記述に基づく。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
