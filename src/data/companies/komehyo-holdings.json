  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "MISSION（存在意義）に「つくる人に敬意をもち、つなぐ人に感謝し、手にする人に感動を提供することで、循環型社会の共感を創っていきます」を、VISION（目指す姿）に「リレーユースを『思想』から『文化』にする」を掲げています。2028年3月期を最終年度とする中期経営計画では「M＆Aによる事業拡大」を成長戦略の柱の一つとし、ブランド・ファッション事業では個人買取の強化とタッチポイントの多様化、販売チャネルの多角化とOMOの推進、法人取引・オークションのプラットフォーム拡大、グローバル展開の加速と「グローバルリユースチェーン」の構築に取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "買取センター・イベント買取・出張買取・宅配買取と、個人から直接買い取る窓口を多様に持つことが仕入の基盤です。買い取った商品は自社の店舗・ECで小売するほか、グループが運営する法人向けオークションで法人へ販売できるため、商品ごとに販路を選べます。アジアとアメリカに販売子会社を持ち、海外の販路へもつながっています。",
        "basis": "【事業の内容】に個人買取仕入の方法（買取センター、イベント買取、出張買取、宅配買取）とオークション運営、海外子会社による販売が印字され、MD&Aに自社オークションを通じた法人販売が好調だった旨が印字されている。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成はブランド・ファッション事業が215,146百万円と全体の約97％を占め、タイヤ・ホイール事業が6,523百万円、不動産賃貸事業が365百万円です。地域別では日本が中心で、アジア、アメリカ、ヨーロッパでも販売しています。リユース市場は拡大が続く一方、買取・販売の競争は激しくなっていると会社は認識しています。",
        "basis": "セグメント注記の外部顧客への売上高と【関連情報】の地域ごとの売上高（2026年3月期）、MD&Aのリユース業界に関する記述による。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
