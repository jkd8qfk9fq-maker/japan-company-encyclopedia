  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社TeraPower Technology Inc.は、2026年１月27日に台湾で新工場建設のための固定資産（土地及び建物）の取得を実施しました（重要な後発事象に印字）。設備の稼働開始時期は2027年１月の予定とされています。本登録は、取得前の2025年12月31日現在の拠点構成によります。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念の下、最先端テクノロジーを取り込み、半導体テスト技術の高度化と生産性向上を追求して付加価値の向上を図る方針です。ビジョンとして、日本と台湾から世界中へテストソリューションを届けることを掲げ、AI及び先端デバイスを中心とする成長分野への積極投資や日台両拠点における生産体制の最適化、スマートファクトリー化の推進といった重点施策に取り組むとしています。優先的に対処すべき課題として、業績の向上、生産性・品質の向上、人材の確保・育成、ESGへの取り組みを挙げています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点施策は、九州事業所と台湾の連結子会社という日台両拠点の生産体制を前提にしています。沿革ではTeraPower Technology Inc.の第３工場が2024年に竣工し、九州事業所の新事務棟が2025年に竣工しており、両拠点の整備が続いています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の重点施策と、【沿革】及び【主要な設備の状況】の日台両拠点の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "前工程のウエハテストと後工程のファイナルテストの双方を受託でき、蓄積したノウハウを利用したプログラム開発やプローブカード設計の受託、デバイスの評価から量産までの一貫サポート、テスト効率向上の提案まで行える点が特徴です。Powertech Technology Inc.やその他OSAT企業との連携により、後工程まで含めたターンキーサービスによるソリューションも提供しています。",
        "basis": "【事業の内容】のウエハテスト・ファイナルテスト双方の受託、プログラム開発やプローブカード設計、一貫サポート及びOSAT企業との連携によるターンキーサービスの記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "半導体テスト事業の単一セグメントで、製品別ではロジック製品が38,617百万円、メモリ製品が3,129百万円と、ロジック製品が大半を占めています。事業は九州事業所と台湾の連結子会社TeraPower Technology Inc.で行われ、日本と台湾の両拠点から受託しています。",
        "basis": "MD&Aの製品別売上高内訳と、【事業の内容】の事業を行う拠点の記載、セグメント情報の単一セグメントの記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
