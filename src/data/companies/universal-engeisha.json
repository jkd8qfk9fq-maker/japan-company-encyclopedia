  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "世界一の園芸会社となることを目指し、令和6年6月期を初年度とする中期経営計画で、令和10年6月期に売上高300億円・当期純利益30億円を達成することを掲げています。経営基本方針では、日本一の総合園芸会社にすることを目標の一つとしています。",
        "asOf": "2026-10-01",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年6月期のグリーン事業の外部顧客への売上高は15,482百万円で、連結売上高22,506百万円の中心です。国内のレンタルグリーンの契約が計画どおりに推移し、造園施工やディスプレイ施工の売上も伸びました。",
        "basis": "セグメント情報の外部顧客への売上高と、MD&Aの経営成績の状況の概要に基づく。",
        "asOf": "2026-10-01",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "レンタルグリーンでは、得意先の要望や設置場所の環境に合わせて植木を提案・納入したあとも、定期的に訪問して植木の交換や水遣り、清掃などのメンテナンスを行う仕組みがあります。受注は自社への直接の発注に加え、生花店やビルメンテナンス事業者など業務委託契約を結んだ元請会社経由の形態もあります。",
        "basis": "【事業の内容】のレンタルグリーン事業の記述と、セグメント情報に基づく。",
        "asOf": "2026-10-01",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "園芸市場は横ばい傾向で推移する中で、地球温暖化への意識の高まりや、企業のCSR活動における壁面緑化や屋上緑化への取組から、園芸業界への注目が高まっています。地域別の売上高は、日本が18,179百万円、米国が3,016百万円、その他が1,310百万円です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記述と、セグメント情報の地域ごとの情報に基づく。",
        "asOf": "2026-10-01",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
