  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、既存事業の成長、M&Aによる事業領域の拡大と組織力強化、持続的成長を可能にするサステナビリティ経営の推進を掲げています。建設機械事業では営業体制の再構築による営業活動の強化や新市場・新商品の開拓を、産業機器事業では成長分野における製商品への取り組み強化やASEAN地域を中心とした海外事業の強化を進めるとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は36,815百万円で、前期比0.8％増でした。建設機械事業の売上高は14,390百万円（前期比5.2％増）で、MD&Aではインフラの補修に関連する商品の販売強化や、レンタル部門での民間工事需要の取り込みが説明されています。産業機器事業の売上高は21,988百万円（前期比1.4％減）で、設備投資抑制の影響を受け設備機械の販売が減少したと説明されています。",
        "basis": "MD&A（経営成績等の状況の概要）、セグメント情報（外部顧客への売上高）",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当社グループは、建設機械と産業機器の販売に、建設機械のレンタルと産業機器・砕石の製造を組み合わせています。産業機器事業では、販売を行う当社と共栄通信工業株式会社に加え、製造・販売を行う子会社を複数持ち、上海、マレーシア、ベトナム、台湾の関係会社が国外で仕入・販売や販売の仲介を行っています。",
        "basis": "事業の内容、関係会社の状況",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは産業機器事業（外部顧客への売上高21,988百万円）、建設機械事業（同14,390百万円）、砕石事業（同436百万円）の3つで、産業機器事業が最も大きいです。地域ごとの情報では、本邦の外部顧客への売上高が全体の90％を超えるため内訳の記載が省略されています。主要な顧客ごとの情報では、売上高の10％以上を占める相手先はないとされています。",
        "basis": "セグメント情報（報告セグメントの概要、報告セグメントごとの金額に関する情報、関連情報）",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
