  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針として「会社の社会的責任」を掲げ、徹底したマーケティング活動を展開することにより「信頼をかち得る企業」を目指しています。中期的な経営戦略では、通信販売事業とデジタルマーケティング事業に経営資源を投下して既存事業の安定した黒字化を目指すとともに、イベントの受注やM&A、M&Aアドバイザリー、ファンド運営などを用いた事業で企業規模の拡大を目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "通信販売事業では、複数の顧客企業を集約して対応する体制から、顧客企業ごとのニーズに即した顧客密着型の営業体制へ移行したことが、放送枠販売の増加と安定的な収益の確保につながったとされており、顧客に寄り添った営業が収益の土台になっています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、通信販売事業で顧客密着型の営業体制へ移行した結果、顧客満足度の向上が図られ、放送枠販売が増加して安定的な収益を確保したと印字されていること",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
