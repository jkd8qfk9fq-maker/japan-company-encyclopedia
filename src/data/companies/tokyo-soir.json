  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年を最終年度とする中期経営計画のもと、「ウェルビーイングな商品・購入体験の拡充」の実現に向けて、①事業領域の拡大、②事業基盤の整備、③効率化の追求の3つの課題に取り組むとしています。フォーマル事業では、冠婚葬祭に限らない、人生の節目となる全てのライフイベントを「フォーマルライフ」と定義し、フォーマルライフのリーディングカンパニーを目指すとしています。ライフスタイル事業では、株式会社キャナルジーンを成長ドライバーと位置づけ、収益性の向上と規模の拡充を進めるとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約9割をフォーマル事業が占め、その中心は百貨店及び量販店への卸売です。直営店やEC、レンタル等の小売接点の拡大と、子会社化で加わったライフスタイル事業の育成により、卸売中心の構成を変えていく構造になっています。",
        "basis": "セグメント情報及び経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1971年から製品を「黒のフォーマルウェア」に特化してきた専門性を持ち、フォーマルウェアの製造から販売までを自社で手がけています。冠婚葬祭をはじめとする人生の節目に寄り添う商品展開が特徴です。",
        "basis": "沿革及び事業の内容の記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "婦人フォーマルウェアを専門とするメーカーとして、全国の百貨店及び量販店の売場を通じた販売基盤を持ち、直営店「フォルムフォルマ」等の小売業態も展開しています。",
        "basis": "事業の内容及び事業等のリスクの記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
