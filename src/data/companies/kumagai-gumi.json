  "history": [
    {
      "year": 1898,
      "title": "熊谷三太郎が土木建築請負業を開業",
      "description": "1898年1月、熊谷三太郎が個人経営の土木建築請負業を始めました。各地の鉄道工事や水力発電所工事に携わりました。",
      "significance": "現在の総合建設会社の出発点で、土木工事から事業が始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1938,
      "title": "株式会社に改組",
      "description": "1938年1月、株式会社に組織を改めました。",
      "significance": "個人経営から会社組織へ移り、近代的な経営の第一歩となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1945,
      "title": "建築部を発足",
      "description": "1945年10月に建築部を発足させ、建築の分野にも進出しました。",
      "significance": "土木に加えて建築も手がけるようになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "道路部を分離し熊谷道路を設立",
      "description": "1963年11月、道路部を分離独立させて熊谷道路㈱を設立しました。現在の連結子会社㈱ガイアートの前身にあたります。",
      "significance": "道路舗装の事業を子会社として切り出した出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "東京・大阪証券取引所市場第二部に上場",
      "description": "1970年4月に東京、大阪証券取引所の市場第二部に上場し、1971年2月に市場第一部へ移りました。",
      "significance": "株式を公開した会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "豊川工場を分社化しテクノスを設立",
      "description": "1996年4月、豊川工場を分社化して熊谷テクノス㈱を設立しました。2002年3月に商号をテクノス㈱に変更しています。",
      "significance": "建設用資機材の製造を担う子会社が生まれました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "不動産などの事業を新会社に承継",
      "description": "2003年10月、不動産事業、海外PFI等に係る投融資事業、債権の回収事業を、新設会社のニューリアルプロパティ㈱に承継させる会社分割を行いました。同年12月に大阪証券取引所の上場を廃止しています。",
      "significance": "建設以外の事業を分けて、本業に集中する形に整えました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "ガイアートクマガイが飛島道路と合併",
      "description": "2004年4月、㈱ガイアートクマガイが飛島道路㈱と合併し、㈱ガイアートＴ・Ｋに商号を変更しました。2016年10月に㈱ガイアートへ商号を変更しています。",
      "significance": "道路舗装の子会社が合併により事業を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移りました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "東京建築支店を開設",
      "description": "2024年4月に東京建築支店を開設しました。",
      "significance": "建築事業の拠点を東京に新設した出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
