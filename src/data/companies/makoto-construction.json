  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念である建築の技術者集団として「より良い家をより安く提供する」を基本方針とし、新しい価値を創造するトータルハウジングを目指すとしています。中長期的な経営戦略では、堺市を中心とした南大阪地区を地盤とする地元密着路線を貫き、品質重視、安全性に重点を置いた住宅創りに専念するとしています。建売住宅事業の分譲用地の仕入では、利益率並びに立地等を考慮して、中型開発物件のみならず小型開発物件の情報収集にも注力し、請負住宅事業が建売住宅事業と合わせて当社グループの2本柱となるべく事業拡大を図るとしています。不動産仲介部門では、自社物件のみならず他社物件の仲介にも注力するとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "堺市を中心とした南大阪地区を地盤に事業を展開し、土地の仕入、設備の調達、設計、施工、販売までを完結する一貫体制をとり、そこから生まれる「品質の良さ」と「価格の安さ」の住宅を提供する顧客第一主義に徹しているとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高3,130百万円の内訳は、戸建分譲住宅事業が3,093百万円（建売住宅事業3,053百万円、請負住宅事業39百万円）、不動産仲介事業が10百万円、不動産賃貸事業が26百万円であり、建売住宅事業が全体の97.6％を占めています。",
        "basis": "セグメント情報等の外部顧客への売上高に印字された金額に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
