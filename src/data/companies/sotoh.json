  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「感性技術で未来を拓く」を掲げ、優れた感性と技術で新しい「価値」を創造し、事業領域と輸出の拡大を図って安定的・持続的な成長の実現を目指すとしています。中長期的な経営戦略では、既存事業における安定的な収益基盤の確立を基本方針とし、染色加工事業における安定的収益基盤の構築と、染色加工事業と製品販売事業との連携による自社販売の強化を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "愛知県一宮市に第一工場・一宮工場・日化工場の染色加工拠点を持ち、ウール及び複合素材の染色に起毛・光沢等の表面加工や撥水・ウォッシャブル等の機能加工を組み合わせて素材の付加価値を高めています。染色加工と製品販売をグループ内で連携させ、素材から最終製品に至る領域を担う体制です。",
        "basis": "【事業の内容】に印字された染色加工の内容と両事業の連携の記載、【主要な設備の状況】に印字された一宮市の３工場のセグメント欄（いずれも染色加工事業）に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
