  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「人の数だけ、キャリアをつくる。」というミッションの下、キャリアデータを公開することで誰もが自由に働き方を選択できる社会を目指すとしています。今後もキャリアデータの更なる拡充を目指し、蓄積したキャリアデータを活用して求職者の採用支援と企業の採用活動・人事業務のDXを推進するサービスの開発を行うとしています。幅広い企業に利用されるために、適性検査や研修などの商品ラインナップの拡充や、営業戦略を通じた顧客基盤の拡大に経営資源を投下し、事業拡大を目指すとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、求職者から投稿される就職活動の体験情報を独自の審査部門が全件審査して品質を担保し、求職者の行動履歴データと合わせて独自のデータベースを構築している点にあります。就職活動期間を通じてサービスが利用されるため、応募時だけでなく活動期間全体の行動履歴が蓄積されます。",
        "basis": "【事業の内容】における体験情報の審査体制、行動履歴データの蓄積と独自データベースの構築の記載に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "HRマーケットでは少子高齢化による労働人口の減少を背景に企業の採用意欲が高水準で推移し、テクノロジーやデータを活用するHR Techの分野が拡大しつつあります。同社は2025年12月期末時点で求職者会員数232万人超、法人取引累計社数6,290社を有し、新卒採用領域を中心にキャリアデータを蓄積しています。",
        "basis": "【事業の内容】におけるHRマーケットの環境変化の記載と、会員数・法人取引累計社数の記載、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における採用市場の記載に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
