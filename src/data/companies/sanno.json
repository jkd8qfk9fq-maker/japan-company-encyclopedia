  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "先端製品分野を中心に受注拡大を図ること、成長戦略への取り組みと従業員エンゲージメントの向上を主要戦略として掲げています。今後の成長領域と考える自動車向け分野、通信向け分野、産業機器向け分野への設備投資を継続し、安定した収益基盤の確保に加えて、新規の事業領域を開拓することで、経営体質の強化に取り組むとしています。",
        "asOf": "2026-10-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "精密プレス加工と貴金属表面処理加工、インサート成形加工を一貫して行う能力を持ち、得意先の求める品質・価格・納期に対応できることが特徴です。金型の設計・製作を自社で行い、材料の厚さ0.05ミリメートル、ピッチ0.25ミリメートルの製品まで対応する微細加工の技術も有しています。",
        "basis": "事業の内容における、一貫して行う能力と得意先の品質・価格・納期への対応の記述、及び精密プレス加工工程の寸法管理レベルの記述に基づく。",
        "asOf": "2026-10-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
