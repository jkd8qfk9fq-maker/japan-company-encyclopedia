  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月に策定した中期経営計画2026-2028では、サービス区分を「アドプラットフォーム」と「デジタルマーケティング支援」に再定義し、広告配信プラットフォームから、クライアントのマーケティング全体を最適化する事業成長インフラへの転換を目指すとしています。AIエージェントによる広告運用の高度化やソニーグループとの連携の深化、新規事業の創出に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "主力のアドテクノロジーを軸に、支援の領域を広告配信からクライアントのマーケティング活動全体へ広げる戦略です。",
        "basis": "経営成績等の分析に、2026年4月に中期経営計画2026-2028を策定し、サービス区分の再定義と事業成長インフラへの転換を目指す旨が記載されていることによるものです。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発のAIによるターゲティングと入札の最適化に加え、膨大なオークション情報をミリ秒単位で処理するビッグデータ処理の基盤が強みです。",
        "basis": "事業の内容に、DSP「Logicad」の特徴として自社開発のAIを活用したターゲティング及び入札最適化機能と、大規模な広告配信リクエストを高速かつ安定的に処理する基盤が記載されていることによるものです。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "インターネット広告市場でDSPを運営する広告テクノロジーの会社で、売上高の大半をアドテクノロジーが占めています。",
