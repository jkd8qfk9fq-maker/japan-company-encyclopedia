  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社の菊水建材科技（常熟）有限公司は、2026年６月11日に同社の製造工場に係る建物・機械設備・借地権等の固定資産の譲渡契約を締結しています。譲渡の時期は現地当局の承認が得られ次第決定する予定であり、本登録は2026年３月31日現在の体制に基づきます。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "サステナビリティ方針「Repaint the future」を掲げ、「製品を通じた街づくり」「事業を通じて困りごとの解決」「安心して働ける環境づくり」「ガバナンスの強化と充実」をマテリアリティとして、改修市場を中心に環境に配慮した製品の普及と建物・構造物の長寿命化に取り組みます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "改修市場を中心に、環境対策、省エネ対策、美観回復、剥落対策、機能回復、漏水対策の6つの領域で、建物や構造物の困りごとを解決する製品と工事の提案に取り組んでいます。2026年3月期の売上高は前期比1.0％増の21,602百万円でした。",
        "basis": "【事業の内容】、セグメント関連情報の主要な顧客ごとの情報、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "下地調整塗材から仕上塗材までを一貫して扱う総合仕上材メーカーで、製品の製造・販売から改修工事までをグループで手がけます。水性塗料技術や無機材料技術を基に、ジオポリマー技術を活用した建築用仕上塗材など、環境に配慮した製品の開発に取り組んでいます。",
        "basis": "【事業の内容】【研究開発活動】と【経営方針、経営環境及び対処すべき課題等】に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建築仕上材の業界で改修市場を中心に事業を行い、主要な顧客の大和ハウスリフォーム向けの売上高が連結売上高の13.6％を占めます。高度経済成長期に建設された社会インフラの老朽化に伴うメンテナンス市場の拡大を、新たな事業領域と位置づけています。",
        "basis": "セグメント関連情報の主要な顧客ごとの情報、【経営方針、経営環境及び対処すべき課題等】、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
