  "history": [
    {
      "year": 1963,
      "title": "三住商事株式会社を設立",
      "description": "1963年2月、電子機器やベアリングなどの販売を目的に、三住商事株式会社を東京都千代田区に設立しました。",
      "significance": "現在のミスミのはじまりです。最初は電子機器やベアリングを売る会社でした。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1965,
      "title": "プレス金型用部品「ノックピン」を発売",
      "description": "1965年7月、プレス金型用の部品としてノックピンを発売しました。1977年1月には「プレス金型用標準部品」のカタログを創刊しています。",
      "significance": "金型部品を標準品としてカタログで売るやり方の出発点です。のちにFA用、プラスチック金型用などへカタログが広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "米国に現地法人を設立し、海外展開を始める",
      "description": "1988年2月、米国イリノイ州に現地法人MISUMI USA, INC.（現 連結子会社）を設立しました。1989年5月には株式会社ミスミに商号を変更し、台湾にMISUMI TAIWAN CORP.を設立しています。その後も韓国、ドイツ、中国などに現地法人を置きました。",
      "significance": "2026年3月期の地域ごとの売上高は、日本が177,221百万円、中国が91,947百万円、アジアが72,045百万円、アメリカが63,307百万円でした。売上の半分以上は日本の外です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1994年1月、東京証券取引所市場第二部に上場しました。1998年9月に市場第一部へ移り、2022年4月の市場区分の見直しでプライム市場に移っています。",
      "significance": "表紙が印字する現在の上場先は、東京証券取引所プライム市場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "持株会社体制に移り、ミスミグループ本社へ商号変更",
      "description": "2005年4月、商号を株式会社ミスミグループ本社に変更し、全事業を引き継ぐ株式会社ミスミを新たに設立しました。同月に駿河精機株式会社（現 株式会社駿河生産プラットフォーム）を買収しています。",
      "significance": "上場会社は持株会社になり、販売は株式会社ミスミ、生産は駿河生産プラットフォームという役割分担のもとになりました。2026年3月31日現在、グループは連結子会社60社、非連結子会社1社、関連会社3社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "米国の金型部品メーカーDayton Progress Corporationなどを買収",
      "description": "2012年11月、米国の金型部品メーカーDayton Progress Corporation（現 連結子会社）と、The Anchor Danly Companyの部品事業会社であるAnchor Lamina America, Inc.（現 連結子会社）を買収しました。",
      "significance": "金型部品事業の欧米での生産・販売拠点になった買収です。2026年3月期、金型部品事業の主要な子会社としてDayton Progress Corporationが挙がっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "「meviy」が「ものづくり日本大賞」の内閣総理大臣賞を受賞",
      "description": "2023年1月、デジタル機械部品調達サービス「meviy（メビー）」が、第9回ものづくり日本大賞の内閣総理大臣賞を受賞しました。2022年9月には株式会社ミスミと株式会社コアコンセプト・テクノロジーの合弁会社、株式会社DTダイナミクスを設立しています。",
      "significance": "meviyは、2026年3月期にFA事業の海外での需要獲得に効いた施策の1つとして、会社が名前を挙げているサービスです。",
