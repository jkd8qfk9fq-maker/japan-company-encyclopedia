  "history": [
    {
      "year": 1896,
      "title": "水野甚次郎が広島県呉市で水野組を発足",
      "description": "1896年4月、水野甚次郎が広島県呉市に水野組として発足しました。これが当社の起源です。その後、全国各地で主に土木工事を手がけました。",
      "significance": "今の五洋建設の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1950,
      "title": "株式会社水野組を設立（法律上の設立）",
      "description": "1963年6月に株式の額面を500円から50円に変更するため、1950年4月設立の株式会社水野組（本店・呉市）に吸収合併されました。このため当社の設立は1950年4月となっています。",
      "significance": "法律上の設立年が起源の1896年と異なる理由です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所市場第二部などに上場",
      "description": "1962年8月に東京証券取引所市場第二部・広島証券取引所に株式を上場しました。1964年8月には東京、大阪、名古屋の各証券取引所の市場第一部に昇格しています。",
      "significance": "株式を市場で取引できる会社になった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1967,
      "title": "社名を五洋建設株式会社に改称",
      "description": "1967年2月に社名を水野組から五洋建設株式会社（英文社名 PENTA-OCEAN CONSTRUCTION CO.,LTD.）に変更し、現在に至っています。",
      "significance": "現在の社名になった時です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "五栄土木と洋伸建設を子会社化",
      "description": "2001年5月に株式を取得し、五栄土木㈱と洋伸建設㈱を子会社にしました。両社は今も国内土木事業を営む連結子会社です。",
      "significance": "国内土木事業を担うグループ会社が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "海外事業の本社機能をシンガポールに移転",
      "description": "2015年4月にシンガポールに国際土木本部と国際建築本部を新設し、2019年4月に海外事業の本社機能をシンガポールに移しました。",
      "significance": "海外建設事業の拠点をシンガポールに置く体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "UG M&E社を連結子会社化",
      "description": "2020年6月に株式を取得し、UG M&E社を連結子会社にしました。同社は現在、海外建設事業で当社の工事の施工協力を行っています。",
      "significance": "海外建設事業の体制を広げた出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場、名古屋証券取引所プレミア市場に移行",
      "description": "2022年4月の市場区分の見直しにより、東京証券取引所の市場第一部からプライム市場に、名古屋証券取引所の市場第一部からプレミア市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
