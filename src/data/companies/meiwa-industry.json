  "history": [
    {
      "year": 1956,
      "title": "盟和産業を設立",
      "description": "東京都大田区入新井に盟和産業株式会社を設立し、ミシン加工及びウェルダー加工方式による自動車用塩化ビニール製フロアマットの製造販売を開始しました。なお、沿革は実質上の存続会社である被合併会社について記載されています。",
      "significance": "当社の創業です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1959,
      "title": "大船工場を新設",
      "description": "神奈川県鎌倉市に大船工場を新設し、塩化ビニールの原料からマットまでの一貫生産体制を確立して製造販売を開始しました。",
      "significance": "原料から製品までの一貫生産体制の確立です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1965,
      "title": "名古屋工場を新設",
      "description": "愛知県豊明町に名古屋工場を新設し、ポリウレタン注入発泡製品、塩化ビニール製マットの製造販売を開始しました。",
      "significance": "生産拠点の拡大と製品の多様化です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1981,
      "title": "東京証券取引所市場第二部に上場",
      "description": "株式を東京証券取引所市場第二部に上場しました。",
      "significance": "株式上場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "カネカと業務提携・資本提携",
      "description": "株式会社カネカと業務提携・資本提携し、自動車部材分野における製品開発の共同検討に着手しました。",
      "significance": "大手化学メーカーとの提携の開始です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "中国・大連のメーカーを子会社化",
      "description": "中国・大連の日系包装資材メーカーを子会社化し、大連盟和化工製品有限公司（現・盟和（大連）汽車配件有限公司）としました。",
      "significance": "海外進出の開始です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
