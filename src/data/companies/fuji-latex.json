  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第５次新中期経営計画（2024年3月期から2026年3月期まで）では「ものづくりの強化」を軸とした成長加速に取り組み、その過程でコンドーム製造事業の停止と老朽化した工場の統合を進めました。中長期的には、既存事業の強化、「ものづくり」の強化、各事業分野でオンリーワンの存在となり収益性の高い事業の集合体となることの3点を柱に、新市場の開拓を中心とした営業基盤の強化と、収益の改善と財務体質の強化を図ります。精密機器事業では総合緩衝器メーカーとしてグローバルなニッチ企業を目指し、工場の統合により2027年3月期に2大工場体制を確立する計画です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "世界最高水準のゴムの薄膜化技術と新素材を基にしたコア技術を持ち、独自の技術力とノウハウを生かしたゴム製品づくりを行っています。精密機器事業では、ハイレベルでユニーク、かつコストパフォーマンスに優れた独自の製品を生み出す技術力を強みとしています。食品容器事業では国内最大手のゴム製食品容器メーカーの地位にあります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の内訳では、緩衝器を中心とする精密機器事業が全体の過半を占める最大の事業であり、コンドームの製造を停止した医療機器事業はヘルスケア商品群やメディカル製品への移行の途上にあります。精密機器と医療生活用品の二つを基軸製品とする体制づくりが進んでいます。",
        "basis": "セグメント情報に、2026年3月期の外部顧客への売上高として精密機器事業4,401百万円、医療機器事業2,127百万円、食品容器事業182百万円、ＳＰ事業86百万円が印字され、経営成績の分析に精密機器と医療生活用品の二つを基軸製品とした2工場体制を進める旨が印字されているため。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
