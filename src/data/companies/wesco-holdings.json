  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「未来に残す、自然との共生社会」のもと、総合建設コンサルタント事業を社会インフラ、スポーツ施設運営事業を健康、水族館運営事業を社会教育の分野と位置づける企業集団として、地域社会への貢献と持続的な企業価値の向上を経営方針としています。2024年7月期から2026年7月期までの第一次中期経営計画では、この期間を事業基盤の再構築を行う期間と位置づけ、人材戦略、技術戦略、市場戦略を定めており、市場戦略では、防災・減災関連業務を重点事業展開分野として関東地方・九州地方の受注拡大や、スポーツ施設のフランチャイズ店舗の拡大、小規模都市型水族館の新規出店を掲げています。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "官公庁向けの総合建設コンサルタント事業を収益の柱に据え、水族館とスポーツ施設の運営で一般の利用者向けの事業も組み合わせる戦略です。",
        "basis": "セグメント情報に、総合建設コンサルタント事業の外部顧客への売上高が14,207百万円と連結売上高17,001百万円の大半を占めることが、関連情報に主要な顧客が国土交通省であることが記載されていることによるものです。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中核の株式会社ウエスコが1970年の設立以来積み重ねてきた技術と、測量、地質調査、環境アセスメントなど幅広い分野をグループの子会社で担う体制が強みです。",
        "basis": "沿革に株式会社ウエスコの1970年の設立と建設コンサルタント登録などの歩みが、事業の内容に子会社ごとの担当分野が記載されていることによるものです。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "岡山県を地盤とする総合建設コンサルタントのグループで、売上高の8割超を総合建設コンサルタント事業が占めています。",
        "basis": "セグメント情報の地域別の売上高で中国地方が最も大きいことと、セグメント別の外部顧客への売上高で総合建設コンサルタント事業が14,207百万円であることが記載されていることによるものです。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
