  "status": {
    "state": "needs-attention",
    "notes": [
      "businessStructure: 2025年10月3日開催の取締役会において、株式会社Kiralaの発行済株式の全部を取得し子会社化することを決議し、同日付で株式譲渡契約を締結し、2025年10月7日付で発行済株式の全部を取得しました。Kiralaはウォーターサーバー事業を行う会社で、2020年3月に当社グループが会社分割により分離し、全株式を売却した会社です。本登録は2025年9月30日現在のグループ構成に基づきます。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業ビジョンに「VITAL LIFE」を掲げ、BEAUTY、WELLNESSの領域で事業、ブランド、サービスを展開し、世界中の人々の健康で美しく生き生きとした人生の実現を目指しています。新商品開発やマーケティング、新規事業の立ち上げ、海外展開、事業提携を進めるとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "強みとして「ブランド開発システム」と「多彩な販路」を挙げています。ブランド開発システムは、Creation、Technology、Branding、Marketingの4つの要素を融合させ、自社だけでなく他の企業や大学の技術も取り入れて、商品やサービスをブランドとして生み育てる仕組みです。販路では、ECを中心とするダイレクトマーケティング、美容室やエステを通じたプロフェッショナル販売、百貨店・量販店などのリテール販売といった複数のチャネルで商品を届けています。商品の開発では、効能や効果に関する学術的な裏付けの取得にこだわっているとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年9月期の事業別売上高は、ダイレクトマーケティング事業が37,791百万円で最も大きく、リテールストア事業が30,387百万円、プロフェッショナル事業が24,757百万円、その他事業が3,863百万円、グローバル事業が1,471百万円、スマートリング事業が539百万円でした。地域別では日本が97,015百万円と大半を占め、アジアが1,725百万円、欧米が69百万円でした。売上高の10％以上を占める主要な顧客はいません。",
        "basis": "セグメント情報の外部顧客への売上高と、セグメント情報の関連情報（地域ごとの情報・主要な顧客ごとの情報）に基づきます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
