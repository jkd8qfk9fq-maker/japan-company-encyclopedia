  "businesses": [
    {
      "id": "osaka-organic-chemical-industry-group",
      "name": "大阪有機化学工業グループ",
      "description": "大阪市中央区に本店を置く化学メーカーで、当社と連結子会社3社、非連結子会社1社でグループを構成し、有機化学工業薬品の製造販売を主な業務としています。報告セグメントは電子材料事業、化成品事業、機能化学品事業の3つで、2025年11月期の売上高は362億６千５百万円、連結従業員数は467人です（2025年11月30日現在）。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "electronics-materials",
          "name": "電子材料事業",
          "description": "ディスプレイ・半導体向けを中心とした電子材料の製造販売を行う事業です。液晶ディスプレイパネル加工用フォトレジスト材料、半導体用フォトレジスト原料（アクリル酸エステル）や、その他電子材料向け機能性ポリマーを当社が製造販売しています。2025年11月期の外部顧客への売上高に当たる売上高は166億７千６百万円で、グループ最大の事業です。光碩（上海）化工貿易有限公司と韓国大阪有機化学工業株式会社がアクリル酸エステル等を販売しています。",
          "customers": [
            "ディスプレイ・半導体分野の電子産業の顧客",
            "電子材料を使う産業顧客"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "chemical-products",
          "name": "化成品事業",
          "description": "塗料・粘接着剤・インキ向け等の特殊アクリル酸エステル及びアクリル酸の製造販売を行う事業です。アクリル酸エステル、メタクリル酸エステル及びアクリル酸を当社が製造販売し、自動車・建築等の塗料、粘接着材、コーティング材やエレクトロ分野へのポリマー原料として使われます。2025年11月期の外部顧客への売上高に当たる売上高は133億２千６百万円です。光碩（上海）化工貿易有限公司と韓国大阪有機化学工業株式会社がアクリル酸エステル等を販売しています。",
          "customers": [
            "塗料・粘接着剤・インキ分野の顧客",
            "自動車・建築分野の顧客"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "specialty-chemicals",
          "name": "機能化学品事業",
          "description": "化粧品向け原材料、機能材料等の製造販売を行う事業です。頭髪用などの化粧品材料と機能材料を当社が製造販売し、連結子会社の神港有機化学工業株式会社が酢酸エステル、特殊溶剤等の製造販売をしています。2025年11月期の外部顧客への売上高に当たる売上高は62億６千３百万円です。光碩（上海）化工貿易有限公司と韓国大阪有機化学工業株式会社が化粧品材料等を販売しています。",
          "customers": [
            "化粧品分野の顧客",
