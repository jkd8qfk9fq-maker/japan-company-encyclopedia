  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是として「誠実（INTEGRITY）」を掲げ、2024年に策定した企業理念のもと、「素材とデザインを起点に、インテリアから文化をつくる企業」を目指す企業像としています。長期ビジョン「DESIGN 2030」の達成に向け、中期経営計画2029（2027年3月期から2030年3月期まで）では、インテリア事業の強化、空間総合事業とエクステリア事業の育成、海外事業の成長、次世代事業の探索・創出を基本方針とし、2030年3月期の連結売上高2,500億円を目指しています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "壁装材・床材・ファブリックの素材とデザインに、物流や施工までを組み合わせた「トータルインテリア」の提案力が強みです。主力の販売方法である見本帳は、顧客接点と受注を生む仕組みとして機能し、全国の供給インフラと長年築いたサンゲツのブランドがそれを支えています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】・【事業の内容】の記載",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高206,441百万円のうち国内インテリア事業が164,102百万円と約8割を占め、海外事業35,029百万円、国内エクステリア事業7,309百万円が続きます。地域別では日本が171,425百万円、北米が22,029百万円、シンガポールが8,848百万円で、海外売上高の比率は前期より高まっています。",
        "basis": "セグメント情報・【関連情報】の記載",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
