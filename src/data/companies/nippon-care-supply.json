  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「けあさぷVision2040」を2025年2月に公表し、社是「健康長寿社会への貢献」のもと、福祉用具サービスを中心に事業活動の拡大を図りつつ、高齢者やその家族への生活支援につながる高齢者生活支援サービスを数多く展開し、高齢者生活支援企業として社会に貢献できる企業を目指すとしています。2026年度も、市場成長を上回る福祉用具レンタルの売上拡大や高齢者生活支援サービスの更なる成長、人材育成とガバナンス体制の構築に継続して取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略は、全国の貸与事業者向けの福祉用具レンタル卸を軸に据えながら、食事サービスや訪問看護等の生活支援サービスで事業領域を広げる構成になっています。都市部を中心とした新規拠点の開設や既存拠点の移転による大型化と、デジタルを活用した業務効率化を並行して進める方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営方針と優先的に対処すべき課題の記載、MD&Aにおける拠点展開とサービス別の取組の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、メーカーと貸与事業者の間に立つレンタル卸の仕組みと、返却された福祉用具を洗浄・消毒・点検・補修して再び貸与する保守体制にあります。全国99拠点の営業網と大阪メンテナンスセンターのような保守集約拠点を持ち、電子受発注管理システム「e-KaigoNet」を事業者やメーカーに提供していることも、事業者との継続的な接点を支えています。",
        "basis": "事業の内容における福祉用具サービスの仕組みの記載、主要な設備の状況における拠点とメンテナンスセンターの記載、事業等のリスクにおける電子受発注管理システムの記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "グループは高齢者生活支援事業の単一セグメントで、サービス別の販売実績では福祉用具サービスが30,113百万円と大半を占め、高齢者生活支援サービスが4,816百万円です。高齢化の進展による市場拡大が見込まれる一方で、介護業界では事業者の統合の動きが活発化するなど、事業環境に大きな変化が見られるとされています。",
        "basis": "セグメント情報等における単一セグメントの記載、MD&Aにおける販売実績（サービス別）と経営環境の記載、経営方針における経営環境の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
