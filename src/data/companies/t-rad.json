  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「T.RAD-2026」では、2030年度の売上高2,000億円を目標とし、ナンバーワン熱交換技術とシェアの追求、マルチパスウェイ化に伴う需要の多様化と増大への対応、圧倒的な開発スピードとコスト競争力の追求、多様な顧客ニーズへのグローバル対応を基本戦略としています。",
        "asOf": "2026-06-05",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "自動車用が売上高の8割を占める一方で、建設産業機械用も2割弱あり、用途が広がっています。日本、米国、欧州、アジア、中国の5つの地域で生産販売する体制です。",
        "basis": "用途別の売上高は、自動車用130,271百万円、建設産業機械用27,518百万円です。報告セグメントは日本、米国、欧州、アジア、中国の5つです。",
        "asOf": "2026-06-05",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
