  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「世界に誇れるものづくりの技術」を掲げ、企業価値の向上を最重要課題としています。中長期的にはロボットを会社の中核として育て上げることを事業の運営方針とし、長期ビジョンのマイルストーンとして、海外事業の拡大による海外売上高比率60%を掲げています。今後は総合機械メーカーとしての独自性を活かし、ロボットを事業成長の中核に据えて、高付加価値のものづくりとソリューションを提供する方針です。",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ロボットを核に、工具、工作機械、ベアリング、油圧機器、そして特殊鋼事業をあわせ持つ総合機械メーカーとしての特長が強みです。1938年に製鋼所を設けて以来の素材から製品までの一貫生産の流れを持ち、富山の生産拠点に加えて、米州・欧州・アジアに製造・販売の子会社網を築いています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】・【沿革】・【関係会社の状況】の記載",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年11月期の売上高では、部品事業が147,255百万円と全体の約6割を占め、機械工具事業が73,407百万円、その他の事業が15,240百万円でした。地域別では日本が115,965百万円、アジアが73,923百万円、米州が34,912百万円、欧州が11,102百万円で、海外売上高が国内をやや上回っています。主要な顧客である岡谷鋼機株式会社への売上高は30,372百万円で、連結売上高の12.9%を占めています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
