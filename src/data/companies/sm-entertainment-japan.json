  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "韓流ビジネスを主軸としたメディアコンテンツ企業として、人々の生活をより楽しく、より豊かにし、社会貢献することを経営理念としています。中長期的には、日本拠点が主体となって市場を分析し、独自の価値を創出して世界へ発信する「能動的な経営体制」への転換を進め、自社オリジナルＩＰの発掘・育成へ経営資源を重点的に配分するとともに、音楽事業を核として商品販売、旅行事業、ライツ＆メディア事業といった周辺領域へ波及させる収益循環の確立を目指しています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、親グループのアーティストＩＰに依拠した運営から、日本発のオリジナルＩＰの育成へ広げることに置かれています。",
        "basis": "経営方針に、特定のアーティストの動向に依存しない持続的な成長のため能動的な経営体制へ転換すること、経営資源を国内マーケティングの強化や自社オリジナルＩＰの発掘・育成へ重点的に配分することが記載されています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ＳＭＥアーティストの日本における独占マネジメントを担い、豊富なアーティストラインナップを基盤に、コンサートからＣＤ／ＤＶＤ、グッズ販売までを一気通貫して行うことで、ロイヤリティの高いファンコミュニティを形成しているとしています。あわせて、原盤制作から配信・流通までの内製化を推進しています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "2025年12月期は計185のコンサートを開催して約143万人を動員しており、大型公演を継続して開ける運営力が事業の土台になっています。",
        "basis": "経営成績等の分析に、東京ドームで約10万人を動員した「ＳＭＴＯＷＮ ＬＩＶＥ」をはじめ、計185のコンサートを開催し約143万人を動員したことが記載されています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約８割をＳＭＥアーティスト関連のエンターテインメント事業が占め、残りを韓国コンテンツの権利・放送事業が占める構成です。主要な販売相手先３社への売上が全体の５割を超えており、相手先への集中が見られます。",
        "basis": "セグメント情報に、2025年12月期の外部顧客への売上高としてエンターテインメント事業7,816百万円とライツ＆メディア事業2,378百万円が、販売実績に主な相手先３社とその割合が記載されています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
