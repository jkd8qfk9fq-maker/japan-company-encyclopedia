  "businesses": [
    {
      "id": "welding-construction",
      "name": "工事施工事業",
      "description": "当社グループの主力事業で、2026年3月期の外部顧客への売上高は8,133百万円です。肉盛溶接技術を基盤に、ステンレス材・チタン材・ニッケル合金・耐摩耗材料・アルミ材など軟鋼以外の特殊材料を対象とした溶接施工を行い、各種産業の生産設備・装置の部品の製作、補修、再生を手がけています。鉄鋼・自動車産業の設備メンテナンスに関する溶接が主力です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "customers": [
        "製鉄・石油化学・セメント・自動車・家電・食品など製造業の生産設備の保全部門"
      ],
      "children": [
        {
          "id": "general-construction",
          "name": "一般工事",
          "description": "製鉄所の高炉周り・連続鋳造・圧延設備、セメント工場のキルン周辺や粉砕工程など、耐摩耗性や耐腐食性・耐熱性を求められる設備機器の溶接施工です。摩耗した部分を肉盛溶接で再生する工事が中心です。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】",
          "customers": [
            "製鉄・セメントなどの基盤素材産業の設備保全部門"
          ]
        },
        {
          "id": "top-plate",
          "name": "トッププレート",
          "description": "軟鋼に超耐摩耗合金を特殊肉盛溶接した耐摩耗用クラッド鋼板「トッププレート」の製品名で、姫路トッププレート工場と室蘭工場で製造しています。表面が滑らかで耐摩耗性に優れるため、製鉄所やセメント工場の投入シュートなど研削摩耗を受ける部分に使われます。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】",
          "customers": [
            "製鉄所・セメント工場などの設備保全部門"
          ]
        }
      ]
    },
    {
      "id": "welding-materials",
      "name": "溶接材料事業",
      "description": "工事施工で使用する特殊溶接用材料の仕入・製造・販売を行う事業で、2026年3月期の外部顧客への売上高は1,380百万円です。設備部品の新設時や補修・再生時の肉盛溶接に使われる材料を取り扱います。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "customers": [
        "肉盛溶接を行う製造業の設備保全部門や施工業者"
      ],
      "children": [
        {
          "id": "own-products",
          "name": "製品（自社製造品）",
          "description": "本社工場で生産するフラックス入りワイヤ（粉末材料を内蔵したパイプ状のワイヤ）が主力です。2026年3月期の売上高は597百万円とMD&Aに印字されています。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】",
          "customers": [
            "溶接材料を使用する製造業や施工業者"
          ]
        },
        {
          "id": "merchandise",
          "name": "商品（仕入品）",
          "description": "当社の技術標準に基づき製造委託する被覆アーク溶接棒のほか、アーク溶接棒、TIG・MIGなどの溶接用線材・粉末材を仕入れて販売します。2026年3月期の売上高は783百万円とMD&Aに印字されています。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】",
          "customers": [
            "溶接材料を使用する製造業や施工業者"
          ]
        }
      ]
    },
    {
      "id": "environmental-equipment",
      "name": "環境関連装置事業",
      "description": "省エネや作業環境改善を目的とした装置の製造・販売を行う事業で、2026年3月期の外部顧客への売上高は671百万円です。自動車関連の鋳造された粗材を冷却する強制冷却装置、鋳造機金型を電気ヒーターで加熱する金型加熱装置、自動搬送車（AGV）による搬送ライン装置、自動車用ギヤの加工・熱処理ラインなどを扱います。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "customers": [
        "自動車産業を中心とする製造業"
      ]
    },
    {
      "id": "other",
      "name": "その他",
      "description": "報告セグメントに含まれない事業で、2026年3月期の外部顧客への売上高は729百万円です。主に自動車産業向けに、アルミダイカストマシーン用部品（プランジャースリーブ、スプルブッシュ、プランジャーチップ、ラドル、ボアピン等）の仕入・製造・販売を行います。タイのTOKUDEN TOPAL CO., LTD.と中国の特電佐鳴（南通）機械製造有限公司の両連結子会社もこの部品の製造販売を行っています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "customers": [
        "自動車産業のダイカストメーカー"
      ]
    }
