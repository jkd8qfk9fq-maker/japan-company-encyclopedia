  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2031年2月期に向けた経営ビジョン「FURUNO GLOBAL VISION “NAVI NEXT 2030”」のもと、事業ビジョン「安全安心・快適、人と環境に優しい社会・航海の実現」を掲げています。2027年2月期から2029年2月期までの新しい中期経営計画（フェーズ3）は「過去最高業績の更新で得た力を将来成長に投じ、積極投資で成長基盤を築く3ヶ年」と位置づけ、市況変動に左右されない事業構造への変革を進め、最終年度の売上高1,500億円を目指します。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "超音波及び電磁波を中心としたセンサー技術を事業の土台とし、創立以来の海外展開で連結売上高のうち海外売上比率が7割を超え、世界100カ国以上に開発・生産・販売・サービスの拠点を持つ体制を強みとしています。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成は、舶用事業が約86％、産業用事業が約11％、無線LAN・ハンディターミナル事業が約2％です。地域別では日本が約29％、欧州が約29％、アジアが約26％、米州が約11％で、海外が7割超を占めます。",
        "basis": "セグメント情報の外部顧客への売上高（2026年2月期：舶用121,147百万円、産業用15,821百万円、無線LAN・ハンディターミナル3,305百万円、その他341百万円、合計140,616百万円）と、関連情報の地域別売上高（日本40,553百万円、米州15,543百万円、欧州40,094百万円、アジア37,086百万円、その他の地域7,339百万円）",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
