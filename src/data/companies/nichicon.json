  "updatedAt": "2026-11-14",
  "perspectives": {
    "competitiveAdvantage": {
      "analysis": {
        "asOf": "2026-06-26",
        "basis": "2026年3月期のセグメント情報と経営者による分析の記載に基づきます。",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "コンデンサ事業の売上高は102,748百万円で、NECST事業の66,976百万円を上回ります。AIサーバーやデータセンター向け、車載向けのコンデンサの需要が拡大しており、増産体制の整備を進めています。NECST事業では、家庭用蓄電システムの新製品であるトライブリッド蓄電システムの販売を始めています。"
      }
    },
    "industryPosition": {
      "analysis": {
        "asOf": "2026-06-26",
        "basis": "2026年3月期の地域ごとの情報と沿革の記載に基づきます。",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "1956年からアルミ電解コンデンサの製造を続けています。2026年3月期の海外売上高は86,113百万円で、売上高の50.7％を占めます。日本、米州、中華圏、アジア、欧州に販売先を持ち、国内外に生産拠点を置いています。"
      }
    },
    "strategy": {
      "disclosed": {
        "asOf": "2026-06-26",
        "locator": "【経営方針、経営環境及び対処すべき課題等】",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "経営理念「価値ある製品を創造し、明るい未来社会づくりに貢献します。」を掲げ、「モノづくりからコトづくり」「製造業から創造業への変革」を進めます。エネルギー・環境・医療機器、自動車・車両関連機器、白物家電・産業用インバータ機器、情報通信機器の4市場を重点分野と定めています。中期成長目標「Vision 2025」は2026年3月期を最終年度とする計画で、売上高2,000億円の目標には届きませんでした。"
      }
    }
  },
