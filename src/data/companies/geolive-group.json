  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループパーパスは「人と自然が共栄する、次代の生き方をつくる。」です。2027年3月期から2031年3月期までの5ヶ年の中期経営計画では、「Dynamic Capability 2.0 企業変革力を強化し、次代を切り拓く企業グループの基盤をつくる。」をテーマに、事業ポートフォリオの最適化に取り組んでいます。2025年8月には住友林業株式会社と資本業務提携契約を締結しました。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "合板、建材、住宅設備機器をそろえる品ぞろえと、建材販売店や住宅会社への販売網を持ちます。エネルギー関連商材や認証材の拡販、非住宅木構造分野への取組みを進めています。2026年1月には住友林業の子会社であった井桁藤とスミリンサッシセンターを完全子会社とし、事業基盤を強化しました。",
        "basis": "【事業の内容】及び【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
