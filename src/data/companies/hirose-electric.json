  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コネクタメーカーとして技術革新を推進し、多様化するニーズに適合した製品を開発・提供して、エレクトロニクス業界の発展に寄与することを使命としています。中期経営計画「G-WING」では、コンシューマ、産業用機器、自動車の強い3本柱を形成し、高収益体制を維持しながら中長期的に売上を伸ばす計画です。中期経営目標として、2029年度の連結売上収益2,900億円の達成を目指しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コネクタ専業として、開発から製造までをグループで担う体制を持ちます。国内では岩手・福島の生産子会社が製造を担い、韓国・中国・東南アジアにも生産拠点を持ち、米国・欧州・アジアの販売子会社を通じて世界各地の顧客に供給しています。高付加価値の新製品の開発・販売・生産体制の強化を進めています。",
        "basis": "【事業の内容】・【関係会社の状況】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上収益の約88%を多極コネクタが占める構成です。顧客の所在地別では中国が77,277百万円と最も大きく、日本は36,364百万円で、海外中心の販売構成です。業績はスマートフォン市場の動向の影響を受けやすく、会社は3本柱の強化でその依存度を相対的に下げる方針を示しています。",
        "basis": "【セグメント情報】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
