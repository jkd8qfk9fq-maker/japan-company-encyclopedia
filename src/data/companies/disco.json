  "businesses": [
    {
      "id": "precision-processing-systems",
      "name": "精密加工システム事業",
      "shortName": "精密加工システム",
      "description": "ディスコの報告セグメントは精密加工システム事業の1つだけで、2026年3月期の売上高4,368億89百万円はすべてこの事業のものです。会社は「高度なKiru・Kezuru・Migaku技術」をビジネステーマに定め、「切る」「削る」「磨く」という3つの技術領域から離れずに、[[term:semiconductor-manufacturing-equipment|半導体製造装置]]である精密加工装置と、その装置に取り付けて使う消耗品の精密加工ツールをつくって売り、あわせて保守・サービスを提供しています。",
      "customers": [
        "半導体や電子部品等の設計・製造に携わる企業（主にハイテク業界）",
        "Taiwan Semiconductor Manufacturing Company Ltd."
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "children": [
        {
          "id": "precision-processing-equipment",
          "name": "精密加工装置",
          "shortName": "装置",
          "description": "[[term:semiconductor|半導体]]などを加工する装置です。ダイシングソーとレーザソーは切断に、グラインダとポリッシャは研削・研磨に使う装置として開発されてきました。2026年3月期は、生成AI向けのデータセンタ投資を背景に、高性能半導体向けの高付加価値製品を中心に出荷が好調でした。",
          "products": [
