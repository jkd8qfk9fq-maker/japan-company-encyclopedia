  "history": [
    {
      "year": 1937,
      "title": "工業用砥石をつくる第一製砥所を創業",
      "description": "工業用砥石を製造・販売する目的で、個人営業の第一製砥所を創業しました。1940年に有限会社、1958年に株式会社へと組織を変えています。",
      "significance": "砥石から始まった会社です。砥石応用製品は今も精密加工ツールの製品の1つで、「削る」「磨く」は現在のビジネステーマの技術領域でもあります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1969,
      "title": "米国に販売拠点を設立",
      "description": "米国販売拠点としてDISCO ABRASIVE SYSTEMS,INC.（現 DISCO HI-TEC AMERICA,INC.）を設立しました。同社は今も100%子会社として、ディスコがつくった半導体製造装置等の販売と保守点検を行っています。",
      "significance": "海外で売る体制の始まりです。2026年3月期の売上高は、顧客の所在地別に見ると日本の456億6百万円に対し、海外向けがその大半を占めています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1975,
      "title": "半導体用ダイシングソーを開発し、精密ダイヤモンド工具へ進出",
      "description": "半導体用ダイシングソーを開発して販売を始め、あわせて精密ダイヤモンド工具へ進出しました。1970年には精密切断装置を、1980年には精密平面研削装置を開発しています。",
      "significance": "装置と、そこに取り付ける消耗品の両方を持つという現在の形の出発点です。ダイシングソーは今も主要な精密加工装置、ダイシングブレードは今も主要な精密加工ツールです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1977,
      "title": "社名を「ディスコ」に変更",
      "description": "株式会社第一製砥所から、現在の商号である株式会社ディスコに変更しました。",
      "significance": "現在の社名です。1983年には本社を東京都大田区に移し、2004年に同区大森北の本社・Ｒ＆Ｄセンターへ移転しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1999,
      "title": "東京証券取引所市場第一部に上場",
      "description": "東京証券取引所市場第一部に株式を上場しました。1989年に日本証券業協会の店頭売買銘柄として株式を公開してから10年後のことです。",
      "significance": "2022年4月の市場区分の見直しにより、東京証券取引所プライム市場に移行しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2002,
      "title": "レーザソーを開発",
      "description": "精密切断装置としてレーザソーを開発し、販売を始めました。2003年には全自動グラインダ／ポリッシャ装置を開発しています。",
      "significance": "刃で切る装置に加えてレーザで切る装置を持ちました。レーザソーもグラインダ・ポリッシャも、現在の主要な精密加工装置です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2007,
      "title": "台湾に販売拠点を設立",
      "description": "台湾販売拠点としてDISCO HI-TEC TAIWAN CO.,LTD.を設立しました。1996年には中国サービス拠点として上海駐在員事務所（現 DISCO HI-TEC CHINA CO.,LTD.）を開設しています。",
      "significance": "この2社はいずれも特定子会社で、単体の売上高は台湾が1,036億73百万円、中国が1,260億19百万円です。2026年3月期の顧客の所在地別売上高も、中国と台湾が上位2つを占めています。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
