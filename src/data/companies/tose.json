  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "特定の資本系列下ではない独立系の開発会社として、ゲームソフトやモバイルコンテンツの企画提案から開発、運営まで幅広いサービスを提供し、蓄積した開発技術力を他のフィールドでも発揮していく方針です。2026年8月期のゲーム事業では、スマートフォンゲームよりも家庭用ゲーム機向けの開発依頼を優先し、マルチプラットフォーム展開の新規タイトル開発や既存タイトルのNintendo Switch 2向け適応に取り組むとしています。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設立以来の独立系ディベロッパー専業としての実績と、質・量ともにトップクラスの人的基盤を掲げ、開発人財が蓄積してきた開発技術と知見に裏打ちされた高い開発品質を強みと位置づけています。",
        "basis": "経営方針において、ディベロッパー専業としては質・量ともにトップクラスの人的基盤を構築し、高い開発品質を軸とする旨が述べられていることに基づきます。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "特定の資本系列に属さない独立系のデジタルコンテンツ開発会社として、ゲームソフトメーカーやコンテンツプロバイダをはじめ幅広い業種の顧客から受託を受けています。",
        "basis": "経営方針において、設立以来、特定の資本系列下ではない独立系のデジタルコンテンツ開発会社として幅広い業種の顧客にサービスを提供してきた旨が述べられていることに基づきます。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
