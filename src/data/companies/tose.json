  "history": [
    {
      "year": 1979,
      "title": "株式会社トーセを設立",
      "description": "株式会社東亜セイコーより分離独立し、京都市東山区に株式会社トーセを設立して、業務用ゲーム機の開発販売を開始しました。",
      "significance": "現在のトーセの起源です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1983,
      "title": "家庭用ゲーム分野へ戦略を変更",
      "description": "家庭用ゲーム分野に戦略変更し、パソコン用ソフトの開発に着手しました。翌1984年にはファミコン用ソフトの開発にも着手しました。",
      "significance": "業務用ゲームから家庭用ゲームへ軸足を移した転機です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1993,
      "title": "中国・上海に現地法人を設立",
      "description": "優秀なソフト開発者の確保を目的に、中国上海市に現地法人「東星軟件(上海)有限公司」を設立しました。",
      "significance": "海外開発拠点の第一歩です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "大阪証券取引所第二部などに株式を上場",
      "description": "事業規模拡大に対応するため京都本社を開設した同じ年に、大阪証券取引所第二部及び京都証券取引所に株式を上場しました。",
      "significance": "資本市場への第一歩です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "東京証券取引所第二部に上場",
      "description": "東京証券取引所第二部に株式を上場しました。また、携帯通信端末用コンテンツの企画・開発やウェブサイトの企画・運営の事業に進出しました。",
      "significance": "東証への上場とモバイルコンテンツへの進出が重なった年です。",
      "sourceIds": [
