  "history": [
    {
      "year": 1944,
      "title": "関東電気工事株式会社を設立",
      "description": "1944年9月に、電気工事業整備要綱により㈱協立興業社ほか7社が統合し、関東配電㈱が参加して、電気工事会社として関東電気工事株式会社を東京都赤坂区に設立しました。神奈川・埼玉・千葉・群馬・栃木・茨城・山梨・沼津の8支店を置いて営業を始めました。",
      "significance": "現在の関電工の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1961年10月に、東京証券取引所市場第二部に上場しました。同年7月には應用電気㈱（現、関工商事㈱）に資本参加しています。",
      "significance": "上場により株式が市場で売買されるようになりました。應用電気は、現在は電気機器販売業を担う関工商事㈱で、当社に電線などの電材を納めています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "東京証券取引所市場第一部に指定",
      "description": "1970年2月に、東京証券取引所市場第一部に指定されました。同じ年に、仙台・信越・札幌に支社を置いています。",
      "significance": "関東以外にも拠点を広げた時期にあたります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1984,
      "title": "株式会社関電工に商号変更",
      "description": "1984年9月に、関東電気工事株式会社から株式会社関電工に商号を変更しました。",
      "significance": "現在の社名になった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "各県のケイテクノ会社を設立",
      "description": "1997年10月に㈱茨城ケイテクノ・㈱栃木ケイテクノ・㈱群馬ケイテクノ・㈱山梨ケイテクノ（現、㈱多摩ケイテクノ）・㈱静岡ケイテクノを、1998年7月に㈱神奈川ケイテクノ・㈱千葉ケイテクノ・㈱埼玉ケイテクノを設立しました。",
      "significance": "現在も当社が電気工事等を発注している、地域ごとの施工会社の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "川崎設備工業㈱に資本参加",
      "description": "2008年4月に、川崎設備工業㈱（名古屋証券取引所市場第二部上場）に資本参加しました。",
      "significance": "同社は現在、議決権の50.1％を当社が持つ連結子会社です（2026年3月31日現在）。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【関係会社の状況】"
    },
    {
      "year": 2012,
      "title": "銚子風力開発㈱に資本参加し発電事業を開始",
      "description": "2012年10月に銚子風力開発㈱に資本参加し、発電事業を始めました。その後、2013年3月に嘉麻太陽光発電㈱、2015年6月に前橋バイオマス発電㈱を設立しています。",
      "significance": "設備工事に加え、風力・太陽光・バイオマスで電力を販売する事業が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "パワーテクノ各社の設立と佐藤建設工業㈱への資本参加",
      "description": "2016年4月に㈱神奈川パワーテクノ・㈱埼玉パワーテクノを設立し、2017年7月には㈱千葉パワーテクノ・㈱茨城パワーテクノ・㈱栃木パワーテクノ・㈱群馬パワーテクノ・㈱西関東パワーテクノ・㈱静岡パワーテクノを設立しました。2016年10月には佐藤建設工業㈱に資本参加しています。",
      "significance": "ケイテクノ各社に続く、地域ごとの施工会社の整備にあたります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "2022年4月に、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
