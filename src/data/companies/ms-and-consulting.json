    "strategy": {
      "disclosed": {
        "text": "顧客企業におけるサービス・プロフィット・チェーン（ＳＰＣ）経営の実現を支援し、「精神的に豊かな社会の創造」に貢献することをミッションとし、「社員第一主義」「顧客中心主義」「社会的に価値ある事業を行う」の3つを経営指針としています。対処すべき課題として、サービスの顧客ニーズへの適合度向上や、会社全体のＣＸ向上・ブランディング強化への支援の進化などに取り組むとしています。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、継続性のあるＭＳＲで収益を計上するストック型の基盤を保ちながら、チームアンケートやコンサル、店舗集客支援などＭＳＲ以外のサービスを広げることです。ＭＳＲ以外の売上構成比はコロナ禍前の13.7％から25.5％に高まっており、2025年4月には株式会社Ｗｉｚと業務資本提携を結び、同社の営業力を活用したサービス販売の拡大も進めています。",
        "basis": "【事業の内容】のストック型のビジネスモデルとＭＳＲ以外の売上構成比の記述、【重要な契約等】の株式会社Ｗｉｚとの業務資本提携契約の記述",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、規定どおりのサービスが行われているかのチェックを目的とした調査ではなく、自由記入のコメントを多用した調査票と、専門の教育を受けたレポートチェッカーによる確認によって、店舗スタッフの働きがいを高める消費者目線のレポートを提供することです。日本全国に62万人の登録モニターを確保し、離島を含む全国の店舗への調査に対応しています。",
        "basis": "【事業の内容】のサービスの特徴（調査票、レポートチェッカー、モニター基盤）の記述",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
