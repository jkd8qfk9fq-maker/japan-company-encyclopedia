  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「すべての産業の新たな姿をつくる。」「テクノロジーとビジネスを、つなぐ。」をミッションに、新規製品・サービス創出やビジネスモデル変革などのバリューアップ型AIテーマをメインターゲットとし、研究開発型産業分野と社会基盤・生活者産業分野に重点的に取り組み、専門人材の育成と再利用可能な技術的資産の蓄積で組織能力を構築するとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "AI技術とビジネス双方の知見を持つ独自のAIコンサルタントとエンジニアが、通算400を超えるプロジェクトで培った手法体系「ソリューションデザイン」を用い、フルカスタムとセミカスタムの開発を使い分けながら、蓄積したソリューションや技術基盤を次のプロジェクトに応用する仕組みが強みです。",
        "basis": "【事業の内容】に、ソリューションデザインの手法体系、通算400を超えるプロジェクトの事例の共有と手法体系としての整理・拡張、ソリューション開発ノウハウ・ハードウェア一体型基盤・AI開発フレームワークとして蓄積し応用することが印字されています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "新規製品・サービス創出やビジネスモデル変革を目的とするバリューアップ型AIテーマに注力する、カスタムAI開発と導入コンサルティングの専門会社という位置づけです。",
        "basis": "【事業の内容】と【経営方針、経営環境及び対処すべき課題等】に、業務効率化などを目的とするSaaS型ソリューションや受託開発とは一線を画し、企業の構造転換に踏み込むサービスへの需給ギャップが拡大すると考え、バリューアップ型AIテーマ市場を大きな市場機会と捉えていることが印字されています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
