  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「リアルなＩＴコミュニケーションで豊かな社会形成に貢献する」ことを掲げ、一部の先進企業だけでなく全ての企業にすぐれたＩＴのメリットを提供することを目指しています。中長期の戦略として、2030年までに国内グループウェアのトップブランドとしての地位と評価の確立を目指し、クラウドサービスとサポートサービスのストック型ビジネスを基盤に、エンタープライズ向け製品・サービスのシェア拡大、AI機能の開発・実装の推進、システム開発サービス事業とのシナジーの追求や海外子会社による新たな収益事業の立ち上げに取り組む方針です。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力のdesknet's NEOのクラウドサービスは解約率が月0.35％と低く、１社あたり平均85ユーザーが利用する形で定着しています。2024年９月の価格改定後もクラウドサービスの売上は伸び続けており、2026年１月末時点の販売累計ユーザー数は539万ユーザーに達しています。",
        "basis": "MD&Aにおける desknet's NEOクラウドの解約率と１社あたり平均ユーザー数、経営方針における販売累計ユーザー数の記述に基づく。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高の４分の３超をソフトウエア事業が占め、その中心はグループウェアのクラウドサービスです。システム開発サービス事業がこれに次ぎ、海外事業はASEAN地域での販売・サポートの段階で、連結売上高に占める割合はまだ小さい構成です。",
        "basis": "セグメント情報における事業別の外部顧客への売上高の構成に基づく。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
