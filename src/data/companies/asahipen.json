  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是である「誠意を貫く 信用第一主義」「不可能を可能にする 積極経営」「高収益・高賃金を実現する 生産性向上」を基本精神とし、「暮らしを彩り 住まいをまもる」をトータルコンセプトに、優れた製品とサービスをお客様に提供し、住生活の質的向上と充実のために貢献することを経営理念としています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "家庭用塗料の分野で、水性塗料や脱フロンのエアゾール塗料など、環境に配慮した製品を国内で早くから発売してきた開発の蓄積が土台です。",
        "basis": "沿革に、1973年に水性塗料「住宅用7」を発売し家庭塗料の水性化の先鞭をつけた旨、1990年に日本で初めて脱フロンの新型水性エアゾール塗料を開発・発売した旨、1991年に水性塗料8品種が家庭塗料で初めてエコマーク認定を受けた旨が印字されていることによります。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "家庭用塗料を主力とし、ＤＩＹ用品やペット用品、時計用品へと、住まいと暮らしの周辺領域に事業を広げてきたメーカーです。",
        "basis": "事業の内容に、塗料、ＤＩＹ用品及びペット用品の製造及び販売を主な事業とし、当連結会計年度より時計用品事業を主な事業として追加した旨が印字されていることによります。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
