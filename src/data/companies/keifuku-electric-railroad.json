  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営ビジョンとして「沿線深耕～私たちのまちをさらに楽しくにぎやかに～」を掲げ、京都地区では鉄軌道事業を、福井地区ではバス・タクシー事業を中心とした交通インフラを核に、地域と協働して沿線の魅力を高めることで企業価値の向上を図るとしています。2026年６月に定めた「京福グループ中期経営計画2028」（2026年度～2028年度）では、安全・安心に関する取り組みの継続、沿線地域との連携によるにぎわいづくり、一定規模の不動産投資を継続的に行う不動産賃貸事業の展開などを基本戦略としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、嵐山線で観光利用が堅調だった運輸業に加え、新たに取得した賃貸物件からの賃料収入やボートレース三国の施設賃貸収入が寄与した不動産業が伸び、営業収益は前期比2.9％増の14,881百万円となりました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要の記載に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "京都エリアではインバウンドを中心に観光客のさらなる増加が見込まれ、福井エリアでは北陸新幹線の金沢・敦賀間延伸開業後の環境変化が今後も続くと会社は見ています。一方で、人口減少・少子高齢化の進行やバス・タクシー事業での運転士不足といった課題にも直面しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
