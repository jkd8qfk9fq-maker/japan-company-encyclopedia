  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第42期（2027年2月期）は、既存店の強化と収益拡大、プライベートブランド商品の開発強化と他の小売業会社等への卸しやWeb販売による新たな収益基盤の拡大、堅実な店舗展開、人財の確保と育成、衛生管理体制の徹底の5点を重点課題とし、新規デベロッパー開拓を積極的に進める方針です。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2023年度から2025年度までの中期経営計画「魚喜ビジョン2025」の最終年度にあたる2026年2月期は、既存店の強化と、EC事業・卸事業の販路拡大に取り組んだことが述べられています。次期の重点課題にも、他の小売業会社等への卸しとWebによる販売チャネルの追加が掲げられています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析と、経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "鮮魚専門店として「鮮度・技術」に関して妥協せず、店舗ごとに顧客に合わせた品揃え、商品規格、価格、質を追及して競合との差別化を図る方針を掲げています。食の安全のため専門部署の食品衛生部を設置し、HACCPに沿った衛生管理と店舗への巡回指導を行っています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の売上高9,492百万円のうち、鮮魚事業が8,199百万円と大半を占めています。同社が事業の主体を置く水産小売業界では、海外での水産物需要の増加や原料相場の上昇、配送費の増加などにより、厳しい経営環境が続いているとされています。",
        "basis": "セグメント情報と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
