  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年1月16日に、株式会社フジコー（パッケージ事業、剥離フィルム事業、転写印刷フィルム事業、撥水・撥油紙事業）の全株式を取得し、連結子会社としました（2025年12月12日の取締役会で取得を決議）。登録は2025年12月31日現在の体制に基づきます。"
    ]
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営ビジョン「Next10(2030)」では「事業ポートフォリオの深化」を掲げ、2030年のありたい姿を「要素技術を通じて、新たな価値を創造し、お客様から選ばれるソリューションパートナー」としています。2025年度を初年度とする中期経営計画(2027)は「事業領域拡大」のステージと位置づけられ、成長市場・分野である「情報電子」「プロセス機能材料」「環境・エネルギー」「ライフサイエンス」へ重点的に投資する方針です。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "研究開発の基本方針では、グループの強みを押出・延伸等のプラスチック加工技術とし、この要素技術を基礎に、より競争力のある製品を生み出すとしています。研究開発はR＆Dセンターを中心に各事業部門と連携して進められ、液晶ポリマー（LCP）フィルムや太陽電池・バッテリー向け機能性フィルム、細胞培養関連部材などの開発に取り組んでいます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【研究開発活動】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは合成樹脂事業、新規材料事業、建材事業の3つで、2025年12月期の外部顧客への売上高は合成樹脂事業が52,671百万円と全体の6割超を占め、新規材料事業が18,928百万円、建材事業が13,185百万円、その他が1,872百万円です。地域別の売上高は日本が77,371百万円、アジアが9,273百万円（うち中国が8,814百万円）、その他が12百万円で、売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）と関連情報（地域ごとの売上高、主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
