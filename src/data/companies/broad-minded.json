  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスとして「金融の力を解き放つ」を、ミッションとして「金融に倫理を、人生に自由を」を掲げ、自らを「フィナンシャルパートナー」と位置づけ、一つの業態にとらわれずに金融サービスを開発し、ライフプランを実現するためのコンサルティングプロセスの品質と、お客様の金融リテラシー向上に資する金融知識や情報の提供を価値提供の源泉として、お客様にとって最適なサービスを提供するとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約91％をフィナンシャルパートナー事業が占め、その中でも生命保険契約に係る代理店手数料がグループ売上高の71.6％を占める構成のため、事業の中心は生命保険を入口とした個人向けのコンサルティングにあります。",
        "basis": "セグメント情報等に印字された2026年3月期の外部顧客への売上高（フィナンシャルパートナー事業4,810百万円、不動産販売事業478百万円）と、事業の内容に印字された生命保険契約に係る代理店手数料の売上高構成比71.6％から読み取れます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "保険代理店業を出自としながら、金融商品仲介業、貸金業、銀行代理業の各業の登録又は認可を取得し、顧客のライフプランに応じたソリューションを業横断的にワンストップで提供できることを掲げています。また、他事業会社との業務提携と自社コールセンターにより見込み客を安定的に獲得できる仕組み（見込み客提供の実績がある提携先は2026年3月期で30社以上）と、ファイナンシャルプランナーを育成する独自の教育プログラムを特徴として挙げています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    }
  },
