  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョン「映像から未来をつくる」のもと、映像・クラウド・AI技術とAPIを通じたオープンプラットフォームの構築で現場DXを支援すること、中・大規模の施設でのシェア拡大に向けて既設カメラのクラウド移行を進めること、AI開発・運用プラットフォーム「Safie AI Studio」で業界特化型のAIソリューションを量産し現場AXを推進すること、専門子会社の設立で成長基盤を強化することを掲げています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、エンタープライズ顧客への課金カメラの導入が大きく増え、スポット収益とリカーリング収益の双方が伸びました。2026年2月にはAI開発・運用プラットフォーム「Safie AI Studio」の提供を開始し、既設カメラのクラウド移行に対応する「Safie Trail Station」を投入しています。",
        "basis": "MD&Aの経営成績の概況における売上高の増減説明と新規サービスの投入に関する記述、セグメント情報（単一セグメントの印字）に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発のソフトウエアをカメラに組み込み、デバイスの制御やデバイス上での画像処理までをクラウドと連携させる仕組みを持ちます。2025年12月末時点で課金カメラ台数は35.4万台に達し、2024年のクラウドモニタリング・録画サービス市場では稼働台数ベースで約55.3％のシェアを得ています。",
        "basis": "事業の内容における製品・技術と市場シェアの記述、経営方針、経営環境及び対処すべき課題等における強みの記述、MD&Aの経営成績の概況における課金カメラ台数の記述に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "映像プラットフォーム事業の単一セグメントで、売上高の10％以上を占める主要な顧客はありません。連結子会社7社（ベトナムとタイの販売子会社を含む）と持分法適用関連会社1社を持ち、従業員数は548人です。",
        "basis": "セグメント情報と関連情報（主要な顧客ごとの情報は該当事項なし、地域ごとの情報は本邦の割合が高いため省略している旨の印字）、関係会社の状況、経営指標等の従業員数に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
