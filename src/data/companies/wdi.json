  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念は「ダイニングカルチャーで世界をつなぐ」で、「ホスピタリティ」「本物志向」「チャレンジスピリッツ」「グローバル」をキーワードに、安心・安全を基盤とした個性ある食事の楽しみ方を提供し続け、持続的な成長と中長期的な企業価値の向上を目指すとしています。2025年度からは「信頼されるブランド創り」を重点テーマに掲げ、各ブランドの独自性を高める施策に取り組んでいます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は国内でカプリチョーザ3店舗、ウルフギャング・ステーキハウス1店舗、ティム・ホー・ワン1店舗、サラベス2店舗など新規出店が相次ぎ、日本セグメントの売上高は前期比12.8％増の26,358百万円となりました。一方で海外は、北米が6,600百万円（前期比6.5％減）、ミクロネシアが1,212百万円（前期比5.5％減）と縮小し、アジアは346百万円（前期比44.5％増）と小さいながら伸びています。成長の中心は国内の出店にある構成です。",
        "basis": "セグメント注記の外部顧客への売上高、MD&Aのセグメントごとの経営成績と新規出店の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "自社の強みとして、国内及び海外で多種多様なブランドを幅広く展開していることを挙げ、この強みを活かして成長性を高めていくとしています。あわせて「各ブランドらしいQ.S.C.A（クオリティ、サービス、クレンリネス、アトモスフィア）の向上」などの施策に取り組んでいます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "ブランド別では、ウルフギャング・ステーキハウス事業部が売上高10,069百万円で全体の29.2％を占めて最大であり、カプリチョーザ事業部が7,095百万円で続きます。単一ブランドへの依存ではなく、複数のブランドに売上が分散している構成です。",
        "basis": "MD&Aの事業部別の販売実績（売上高と構成比）",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外食産業は参入障壁が比較的低く競争が激しいと会社自身が認識するなかで、WDIは直営97店舗とフランチャイズ60店舗の計157店舗を展開し、連結従業員数は2,386人（2026年3月31日現在）です。店舗の所在地別の売上高では日本が26,358百万円、米国が7,813百万円、その他が346百万円で、海外売上は米国のハワイ州などの店舗が中心です。",
        "basis": "MD&Aの経営成績の分析（市場動向の認識）、【事業の内容】の店舗数、セグメント関連情報の地域ごとの売上高、【従業員の状況】の従業員数",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
