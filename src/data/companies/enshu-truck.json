  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として、ミッション（使命）、ビジョン（経営目標）、バリュー（従業員行動指針）の3項目を定めています。経営戦略では、中継輸送（ｅ－ｃｈａｎｇｅ）プラットフォームを活かした輸送ネットワークの拡充、EC物流の拡大、共同配送網の拡充、調達物流の進化を掲げ、DXの推進や人的資本への投資を行うとしています。2026年度を初年度とする5年間の中期経営計画では、事業投資330億円を行い、計画最終年度の2031年3月期に営業収益610億円とする計画を公表しています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "対処すべき課題として、運賃や作業料の適正な価格転嫁の推進と、賃上げによる労働力の確保を第一に挙げています。乗務員不足で困難になる長距離輸送の問題には中継輸送をさらに推進して対応し、化学品や食品などの共同配送とEC関連の強化、調達物流の進化に取り組むとしています。投資面では基幹システムの再構築や自動搬送ロボットの導入などのDX投資と、健康経営をはじめとする人的資本投資を進めるとしています。",
        "basis": "経営方針、経営環境及び対処すべき課題等（経営環境及び対処すべき課題）",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "関東・関西の中間に拠点をもつ立地を活かし、業界に先駆けて中継拠点を設置して、乗務員が日帰り運行できる中継輸送の仕組みを構築している点が特徴です。浜松には中日本高速道路株式会社と共同で中継物流拠点「コネクトエリア浜松」を開設しています。また、ビジョンでは安全・品質を向上させながら当社車両と乗務員、作業員で運営する自社輸送体制を堅持するとし、静岡県・関東圏・中京圏に拠点網を持ち、共同配送に取り組んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等（経営方針のビジョン、経営環境及び対処すべき課題）、沿革、事業の内容",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは物流事業の1つで、外部顧客への営業収益は49,776百万円、その他（不動産事業等）は170百万円です。地域ごとの情報では本邦以外の外部顧客への営業収益はないとされ、主要な顧客ごとの情報ではアマゾンジャパン合同会社への営業収益11,831百万円が印字されています。MD&Aでは、物流業界は燃料費の高止まりや乗務員の時間外労働の上限規制の強化により従前どおりの運行が難しくなるなど、経営環境は厳しい状況が続いていると説明されています。",
        "basis": "セグメント情報（報告セグメントごとの営業収益、関連情報の地域ごとの情報・主要な顧客ごとの情報）、MD&Aの経営成績の分析",
        "asOf": "2026-06-17",
