  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「ASKA VISION 2035」と、2026年4月から始まる中期経営計画2028を策定し、持続的成長と社会課題の解決の両立を目指すとしています。中期経営計画2028では「5本の柱」として、国内医療用医薬品事業におけるスペシャリティ領域の拡充、創薬事業におけるグローバル展開の推進、ベトナムの新工場稼働によるグローバル事業の基盤強化、アニマルヘルス事業の拡大、検査・アラウンドピル事業の展開を掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "中期経営計画2025については、最終年度となる2025年度に掲げた目標を達成したと開示しています。新しい中期経営計画2028の柱は医薬品、アニマルヘルス、海外、その他の各事業に対応しており、ベトナム子会社の新工場の稼働を海外事業の基盤強化の軸に据えています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における中期経営計画の達成状況の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "内科・産婦人科・泌尿器科の3領域に注力し、産婦人科領域では子宮筋腫・子宮内膜症治療剤「レルミナ」や月経困難症治療剤「ドロエチ」、内科領域では甲状腺ホルモン剤「チラーヂン」などの重点品目を持ちます。産婦人科等のスペシャリティ領域でリーディングカンパニーを目指し、研究開発と導出入活動を進めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、研究開発活動と、経営者による分析におけるセグメント業績の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメント別の外部顧客への売上高は、医薬品事業58,927百万円、アニマルヘルス事業7,334百万円、海外事業4,640百万円、その他225百万円です。主要な顧客である武田薬品工業株式会社への売上高は57,155百万円と、連結売上高の大きな割合を占めています。本邦の外部顧客への売上高が連結売上高の90％を超えるため、地域ごとの売上高は開示されておらず、有形固定資産は日本とベトナムに所在します。",
        "basis": "セグメント情報等における報告セグメントごとの外部顧客への売上高と関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）の記載",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
