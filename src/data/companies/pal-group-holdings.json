  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是として「常に新しいファッションライフの提案を通じて社会に貢献する」を掲げています。2029年2月期の連結売上高3,000億円の達成に向け、OMO施策の進化とファン・コミュニティの深化による収益基盤の強化に取り組んでいます。自社EC「PAL CLOSET」から得られる購買・行動データの解析と活用、店舗の大型化、4週間を1シーズンとする4週間MDの徹底などを進めています。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "総フォロワー数2,400万人を超える規模に拡大した社員インフルエンサーによるSNS発信と、自社ECの購買・行動データの解析結果を各ブランドに提供することで、トレンドの早期捕捉と精度の高い需要予測を行っている点が強みです。雑貨の「3COINS」は、ショッピングセンターにおける集客の核となるキーテナントとしての地位を確立しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の売上高の内訳は、衣料事業が144,840百万円で全体の約6割を占め、雑貨事業が89,552百万円です。本邦以外の外部顧客への売上高は連結売上高の10％未満で、国内中心の事業構成です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
