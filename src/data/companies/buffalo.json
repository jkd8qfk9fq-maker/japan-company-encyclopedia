  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年3月期から2029年3月期までの5か年を対象とする「中期経営計画2024」を進めています。オートバックス事業では、接遇・接客力とピットサービスの技術力を土台に地域ナンバーワン店を目指し、2029年3月期までに5店舗の出店による20店舗体制を計画しています。飲食事業では、イタリアンレストラン「ＰＩＳＯＬＡ」の出店を通じて飲食事業を本格化させ、オートバックス事業とともに経営の柱へと構築する方針です。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "出店計画の中心は既存のオートバックス事業であり、飲食事業は新しい柱として育てる位置づけです。2つの事業を並行して広げる方針であることが分かります。",
        "basis": "中期経営計画2024の基本方針と出店戦略の記載に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業時から接客販売を基本とした固定客づくりを実践し、接遇・接客への取り組みを続けています。また、「クイック・エコ・リペア」などのピットサービスメニューを他社に先駆けて開発・導入した実績があり、オリジナルメニューの開発を競争力の強化につなげています。",
        "basis": "経営方針における競合他社の状況及び優位性の記載に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "オートバックス事業は埼玉県南西部から東京都北部に店舗エリアを集約しており、統一した事業運営が可能になっています。飲食事業は「焼肉ライク」5店舗と「ＰＩＳＯＬＡ」5店舗の合計10店舗で、オートバックス事業の15店舗と並ぶ店舗網を持つ段階にあります。",
        "basis": "経営環境における企業構造の記載と、主要な設備の状況における店舗の所在地に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
