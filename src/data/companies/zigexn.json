  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第3次中期経営計画「ZIGExN Matching Agent」のもと、AIと人を最適に配置して顧客への提供価値を高め、従来の集客・送客の先にある業務プロセスにも介在することで収益基盤を強固なものにするとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上収益は、Vertical HRが13,576百万円、Life Serviceが8,040百万円、Living Techが6,933百万円と、人材領域を中心に構成されています。",
        "basis": "セグメント情報における製品及びサービスごとの外部顧客への売上収益と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における経営成績の概要に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "複数のインターネットメディアの情報を統合するアグリゲーションメディアの運営力と、データに基づく高精度なマッチングの仕組みをグループ各社で共有していることが、競争力の源泉として位置づけられています。",
        "basis": "事業の内容におけるアグリゲーションメディア事業と特化型メディア事業の説明と、経営方針におけるマッチングテクノロジーの記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上収益は本邦の外部顧客向けが大部分を占め、売上収益全体の10％を超える単一の外部顧客はないと開示されています。",
        "basis": "セグメント情報の関連情報における地域ごとの情報と主要な顧客に関する情報の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
