  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「未来のソフトウエアを形にする」をコーポレートミッションに掲げ、アルゴリズム領域の技術を用いた「各種ソフトウエア・ハードウエアを知能化する技術」の研究開発と社会実装を通じて、社会問題を解決し価値を創造していくとしています。成長戦略としては、顧客基盤の拡大と、AI Research & Solution事業とAI SaaS事業の両輪での事業拡張を目指すとしています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期の外部売上収益はAI Research & Solution事業が12,889百万円、AI SaaS事業が8,881百万円で、月額ライセンスを中心とするSaaS型のプロダクト販売が売上収益の約4割を占める構成になっています。両事業とも前期から売上収益を伸ばしています。",
        "basis": "セグメント情報の報告セグメント別外部売上収益、MD&Aの経営成績の概要に基づく。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "業界のリーディングカンパニーとの事業提携により大規模な教師データを用いてソフトウエアを開発し、そこから得た汎用性のある技術やノウハウをモジュール化して提供していることが強みとされています。利用が進むほどデータがアルゴリズムに蓄積されて精度が向上する構造から、一般的なソフトウエアに比べて高い継続利用率を維持できるとされています。",
        "basis": "【事業の内容】の事業の特徴（パートナーシップ戦略、アルゴリズムソフトウエアの継続率）の記述、MD&Aの経営成績の概要に基づく。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "深刻化する人材不足とAIの技術進化を背景に顧客ニーズが高まる中、AI Research & Solution事業ではソリューション案件数を、AI SaaS事業ではプロダクトの導入社数を着実に積み上げたとされています。市場規模や市場シェアの数値は印字されていません。",
        "basis": "MD&Aの経営成績の概要、セグメント情報の外部売上収益に基づく。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
