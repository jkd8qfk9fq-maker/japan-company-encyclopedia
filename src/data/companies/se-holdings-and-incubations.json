  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "会社の経営の基本方針として、情報産業をはじめとする市場の成長に積極的に寄与することで社会に貢献しながら自らも成長していくことを目標とし、対象市場を活性化して新しいプレーヤーの参加を喚起するため事業者のインキュベーションを積極的に行うとしています。また、対象市場全体にわたって事業基盤を構築することで個別事業のリスクを減少しつつ全体の成長効率を向上させるという方針のもと、常に最適な事業会社群の構成を目指すとしています。中長期的な経営戦略としては、既存事業の成長に加えて新規事業を積極的に展開するとともに、企業への戦略的投資や育成、M&Aも積極的に活用して事業を拡大し、グループの全体価値の向上を図るとしています。グループの重点課題として、事業会社各社の再建、新規収益基盤の創出、事業会社経営人材の拡充と育成、収益基盤の質の多様性による長期成長基盤の充実の4点を掲げています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成は出版が約6割を占め、残りを教育・人材、ソフトウェア・ネットワーク、コーポレートサービス、投資運用の4事業が分ける構成で、単一事業への依存を避ける多角化が図られています。",
        "basis": "【セグメント情報等】の記載に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "出版事業は、最新のテクノロジーを中軸にエデュケーション、ビジネス・カルチャー、パーソナルコンピューティング・デザイン、Eコマースの4つのテーマで質の高い実用コンテンツの制作・提供に特化し、電子書籍やWebメディア、イベントなどのオンライン媒体において強いコンピタンスを有すると会社は説明しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年の出版市場（紙と電子出版の合計）の規模は1兆5,462億円で前年比1.6％減と4年連続のマイナス成長となり、紙の出版が縮小する一方で電子出版が伸長していると会社は説明しています。その中で当社グループは、デジタルトランスフォーメーションの潮流と親和性のあるコンテンツ提供を続けることで競争力の維持・向上が可能と考えています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
