  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションに「わたしたちが創造するモノを通じて世界の人々をハッピーにすること」を掲げています。成長戦略として、「駅メモ！」への広告投資を増やしてユーザー基盤のさらなる拡大を図り、ユーザーの移動を通じて新たな経済圏の形成を目指すほか、M&Aを視野に入れた協業の検討や、AI技術の活用による全社的な生産性向上を進める方針です。",
        "asOf": "2026-03-13",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力の「駅メモ！」は2014年のリリースから10年以上運営が続く位置情報連動型ゲームで、鉄道駅を他人と奪い合う競争要素、実際に訪れた場所が履歴として残るライフログ要素、取得済の駅や路線、称号等を集めるコレクション要素を組み合わせています。地方自治体や鉄道事業者と協業した取組みなど、現実の移動と連動した企画も行っています。",
        "basis": "【事業の内容】における位置情報連動型ゲームの特徴と運営期間の記述に基づく。",
        "asOf": "2026-03-13",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期はモバイルゲーム事業が連結売上高の大部分を占め、位置情報連動型ゲームが業績を牽引して連結売上高は過去最高を更新しました。一方、コンテンツ事業は着メロサービスの課金会員数が緩やかに減少しています。",
        "basis": "セグメント情報と経営者による分析における事業別の売上高と記述に基づく。",
        "asOf": "2026-03-13",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
