  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「PRODUCE NEXT ～しあわせな未来を、共に拓く。～」をMISSIONに掲げ、経営の基本方針は、クライアントバリューの最大化に拘り、「ピュアコンサルティングタイムの最大化」と「社員のケイパビリティの最大化」のバランスを重視しながら、「企業価値の向上」と「PRODUCE NEXTの実現」を達成することとしています。今後は、既存のコンサルティング事業を軸としながらも、収益モデルの多角化やシナジーを生む新規事業を創出するといったチャレンジを続け、持続的な企業価値向上を目指すとしています。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年４月に中期経営計画を策定し、伴走型の経営支援サービスを軸に、戦略策定、業務改革、IT導入、DX推進等のあらゆる側面からの支援を提供していくとしています。2026年２月期はコンサルタント人員数の増加により売上収益が拡大した一方、若手を中心としたメンバー層の増加による人員構成の変化で稼働率が低下したと分析されています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客に伴走するHands-on Style、あえて明確なスコープを設定しないScopeless、報告書よりも実行支援に注力するMore than Reports、厳選採用したプロフェッショナルによる支援という４つの手法を独自の特徴としています。特定の領域に限定せずプロジェクトにアサインされるワンプール制と専門組織制の併用、マネージャー以下は原則１人１顧客を受け持つ仕組みにより、高い稼働率の実現を図る構造を持ちます。",
        "basis": "事業の内容及び経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内企業ではDXを活用した業務効率化やビジネスモデルの変革に向けた取り組みが活発化しており、企業活動へのコンサルティング支援に対する需要は今後さらに高まっていくと同社は見ています。同社は2023年９月に東京証券取引所グロース市場に上場した総合コンサルティング会社で、株式会社ＮＴＴデータ及び株式会社ＳＨＩＦＴとの資本業務提携を有しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等並びに経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
