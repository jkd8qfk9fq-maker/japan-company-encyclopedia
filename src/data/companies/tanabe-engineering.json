      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "優位性は、企画から設計、開発、調達、施工、メンテナンスまでを一貫して対応できる「総合力」と、自社の従業員で構成される直営部隊による迅速できめ細かな対応の「機動力」にあります。1921年に化学会社の工場構内で生産設備の保全から始めた技術の蓄積が基盤となっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等におけるコア・コンピタンスの記載、事業の内容における事業区分、沿革における創業以来の記録",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "設備工事業界は受注産業であり、公共投資が底堅く推移し民間設備投資に持ち直しの動きがある一方、受注・価格競争は厳しい状況にあります。当社グループは独立系のエンジニアリング会社として、主要な顧客であるデンカ株式会社向けの完成工事高が全体の2割を占め、アセアン域内に設備工事と表面処理の拠点を持っています。",
        "basis": "セグメント情報の主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における業界動向と相手先別の完成工事高の記載、関係会社の状況",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
