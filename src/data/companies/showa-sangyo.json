  "history": [
    {
      "year": 1936,
      "title": "会社を創立",
      "description": "肥料・小麦粉・植物油脂などをつくって売るため、2月18日に創立しました。続けて飼料・水あめなども事業に加えました。",
      "significance": "現在の食品と飼料の事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1948,
      "title": "ぶどう糖の本格発売",
      "description": "ぶどう糖の製造販売を目的に加え、本格的に発売しました。",
      "significance": "現在の糖質カテゴリにつながる製品です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に上場",
      "description": "5月に東京証券取引所市場第一部に上場しました。",
      "significance": "上場企業としての歩みが始まった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1953,
      "title": "販売会社の昭産商事を設立",
      "description": "グループの販売網をつくるため、昭産商事㈱を設立しました。",
      "significance": "現在も当社製品を購入して販売する会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "本社の現社屋が完成",
      "description": "5月に本社の現社屋が完成し、一部を賃貸して不動産の賃貸事業を本格化しました。",
      "significance": "食品・飼料以外の事業が広がった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "九州の配合飼料会社を設立",
      "description": "九州産業㈱と九州昭産飼料㈱を合併し、九州地区の配合飼料の製造販売を目的に九州昭和産業㈱を設立しました。",
      "significance": "九州での飼料の製造販売を担う現在の子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1991,
      "title": "鶏卵事業を開始",
      "description": "鶏卵の購入販売を目的に昭和鶏卵㈱を設立しました。",
      "significance": "飼料事業の中で鶏卵を扱う事業の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "パン製造の会社を設立",
      "description": "パンの製造販売を目的に㈱スウィングベーカリーを設立しました。",
      "significance": "コンビニエンスストア向けのパンなど、川下の事業に広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "製粉会社へ相次いで資本参加",
      "description": "2009年に奥本製粉㈱（関西）、2014年にセントラル製粉㈱（中京）へ資本参加しました。1990年代には木田製粉㈱（北海道）と㈱内外製粉（中京）にも資本参加しています。",
      "significance": "各地の製粉会社との連携で、小麦粉の生産体制を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "植物油と糖化品の会社へ資本参加",
      "description": "7月に植物油の製造販売会社ボーソー油脂㈱とその子会社5社へ、12月に糖化品・乳酸菌の製造販売会社サンエイ糖化㈱へ資本参加しました。",
      "significance": "製油カテゴリと糖質カテゴリのグループ生産体制を強めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東証プライム市場に移行",
      "description": "4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "ベトナムに子会社を設立",
      "description": "4月、ベトナムでプレミックスと調製糖を製造販売するため、Showa Sangyo International Vietnam Co., Ltd.を設立しました。",
      "significance": "海外での製造に取り組む動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "東葛食品を完全子会社化",
      "description": "9月、中華まんじゅう・中華惣菜などをつくる東葛食品㈱の株式を追加で取得し、完全子会社にしました。",
      "significance": "冷凍食品などの加工食品の事業を広げました。",
      "sourceIds": [
