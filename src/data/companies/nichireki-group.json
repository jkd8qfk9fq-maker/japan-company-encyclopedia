  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度から5か年の中期経営計画『のびやか２０３０』を進めています。顧客基盤の強化、組織力の強化、茨城県つくばみらい市で建設中の生産・物流基地『つくばビッグシップ』による事業基盤の強化、サプライチェーン・マネジメントの高度化、経営基盤の強化を重点施策とし、低炭素・長寿命・リサイクルなどの性能を持つ環境配慮型製品・工法の提供を広げ、持続可能な企業グループの構築を目指します。計画の数値目標は将来に関する目標であるため、ここには記載しません。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "優れた機能とコストを満足する道路舗装材料と工法の提供、道路を見守る高度なコンサルティング、顧客から信頼される施工技術を完全に一体化した『道』創りのビジネスモデルを掲げています。製品の製造・販売を行うニチレキ株式会社を中核に、全国各地の子会社が工事を担うことで、材料や工法の開発から施工までをグループで一貫して提供できます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは道路舗装事業とアスファルト応用加工製品事業の2つで、2026年3月期の外部顧客への売上高は、道路舗装事業が50,827百万円、アスファルト応用加工製品事業が24,721百万円、その他（不動産賃貸、損害保険代理業など）が304百万円です。海外売上高は連結売上高の10％未満で、売上高の10％以上を占める主要な顧客はいません。需要は、防災・減災や国土強靱化対策などの公共投資に支えられています。",
        "basis": "【セグメント情報等】の報告セグメントごとの売上高と関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の事業環境の記述に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
