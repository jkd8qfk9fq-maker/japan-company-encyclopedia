  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "金属関連部品事業では、既存客先へのさらなる浸透を基本戦略とし、EVを含めた電動車等を中心とした製品分野への対応強化を重点課題として、技術開発重視の「真にお客様に求められるものづくり」を目指すとしています。樹脂関連部品事業では、樹脂部品単体のみならず樹脂と金属の複合部品の拡販を進め、新たな事業の柱として育てるとしています。その他事業では既存品のグローバル市場での拡販を基本戦略とし、海外拠点については北米・アジア地域への直接販売の強化を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金属関連部品事業の競争力の源は、製品の具現化力と量産化力の高さにあり、簡単に形にできてすぐに良品が量産できる製品では強みが発揮できない分、高難度部品・高付加価値部品で競争力を有していると会社は位置付けています。また、様々な客先と取引していることが、個々の客先の事情による業績変動を和らげる要素になっています。生産拠点は国内のほか米国、ベトナム、インドネシア、中国、タイに広がっています。",
        "basis": "MD&Aの経営戦略の現状と見通し、事業の内容、関係会社の状況の記載に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
