  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度を初年度とする３ヵ年の第５次中期経営計画（2027年３月期～2029年３月期）を策定し、2030年及び2035年に向けた成長の土台を固める３年間と位置付けています。重点施策として事業強化と組織強化を推進し、持続的な成長基盤の確立を図るとしています。計画最終年度の売上高目標は1,950億円としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は、ＡＩ関連投資に伴う半導体・データセンター需要の取り込みと、テストソリューション事業の供給体制の強化、通信・車載・産業機器向けコネクタの拡販です。第４次中期経営計画では最終年度目標の売上高500億円を超える526億円を達成しており、第５次計画ではその基盤の上に事業強化と組織強化を進める構えです。",
        "basis": "経営方針、経営環境及び対処すべき課題等の第５次中期経営計画の記載、経営者による分析の第４次中期経営計画の目標達成と事業別の状況の記載、セグメント情報の事業別売上高",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、半導体検査工程のバーンインソケットとテストソケットで培った機構部品の技術を、高速伝送用コネクタやＹＦＬＥＸへ展開している製品群の幅と、フィリピン・韓国・ドイツに製造拠点、米国・シンガポール・香港・上海などに販売拠点を持つグローバルな供給・販売体制です。主要顧客であるQualcomm Technologies Inc.向けの販売が連結売上高の20.8％を占めるなど、大手半導体メーカーとの取引基盤を有しています。",
        "basis": "事業の内容の３事業の製品と製造・販売体制の記載、関係会社の状況の海外子会社一覧、セグメント情報の主要な顧客ごとの情報",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子部品業界の中で、半導体検査用ソケットとコネクタを主力とする機構部品メーカーに位置します。2026年3月期の売上高52,698百万円のうち、テストソリューション事業が26,424百万円、コネクタソリューション事業が24,742百万円、光関連事業が1,531百万円です。地域別売上高はアメリカが16,753百万円と最大で、日本は4,689百万円と、海外向けが大半を占める構成です。",
        "basis": "セグメント情報の事業別売上高と地域ごとの情報、主要な顧客ごとの情報、経営者による分析の経営成績の状況",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
