  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "3か年中期経営計画「New Frontier 2026」（NF2026）のもと、「ステークホルダーの最高満足に向けて新たな価値創造に邁進する」ことを掲げています。2027年3月期は同計画の完遂を目指す年度と位置づけ、地政学リスクに対応したサプライチェーンの改革と強靭化、デジタルイノベーション加速による新たなAI／ITソリューション事業のマネタイズなどを基本方針としています。シール製品事業では半導体などの先端産業市場で製品供給体制の最適化と生産力強化を進め、機能樹脂製品事業では先端産業市場を最重点領域として資源投入と供給網の整備を推進するとしています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "シールエンジニアリングを核となる技術として、1952年にふっ素樹脂製品を日本で初めて製品化して以来の素材・加工技術の蓄積を持ちます。奈良工場やM・R・Tセンターなどの研究・生産拠点を国内に持ち、韓国・台湾・ベトナム・タイなどアジアを中心に海外の製造・販売拠点を展開していることも特長です。",
        "basis": "【沿革】の製品化の歩み、【主要な設備の状況】の拠点構成、【事業の内容】のグループの事業範囲に基づきます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "シール製品事業と機能樹脂製品事業の2つの報告セグメントで展開しています。2026年3月期の外部顧客への売上高は、シール製品事業が43,858百万円、機能樹脂製品事業が14,697百万円でした。地域別では日本が39,551百万円、アジアが15,968百万円、米国が2,906百万円、その他が130百万円で、売上高の10％以上を占める主要な顧客はいません。",
        "basis": "セグメント情報（報告セグメント別の外部顧客への売上高）と関連情報（地域ごとの情報、主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
