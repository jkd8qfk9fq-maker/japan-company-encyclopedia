  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年11月期を初年度とする第5次中期経営計画で、重点戦略として『ライフクリエイティブ事業ユニットでのサービス・事業開発と事業形態の変革』、『期待を上回る「顧客体験」を通じてブランド価値を高める』、『グループ内外との「共創」による事業創造』、『既存事業分野の収益力向上』、『「自ら考え、行動する」人が集う組織風土への変革』への取組みに注力してきました。同計画の最終年度となった2025年11月期は、グループ内外との連携・共創や積極的な成長投資による新しい価値の創造を進めるとともに、リフォーム事業をはじめとする住まい、暮らしの事業領域の成長に向けた施策に取り組みました。中期経営計画の数値目標は本文には書いていません。",
        "asOf": "2026-02-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "愛知県東三河や静岡県浜松を中心とする地域で都市ガスやLPガスの供給基盤を持ち、エネルギー供給から住宅の建築・リフォーム、設備工事、暮らしのサービスまでをグループ内で提供できる体制を持っています。",
        "basis": "【事業の内容】が、エネルギー＆ソリューションズ事業（都市ガス、LPガス、石油製品、電気供給、暮らしのサービス等）、ハウジング事業（注文住宅の請負、リフォーム請負等）、エンジニアリング＆メンテナンス事業（設備工事等）をグループの事業としていること、【関係会社の状況】がサーラエナジー、サーラ住宅、株式会社中部などの地域の事業会社を列挙していることによります。",
        "asOf": "2026-02-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約半分をエネルギー＆ソリューションズ事業が占め、残りを住宅、設備工事、動物用医薬品、自動車販売、不動産などが分け合う構成です。売上高はすべて日本国内で得ています。",
        "basis": "セグメント注記の2025年11月期の外部顧客への売上高（エネルギー＆ソリューションズ事業120,870百万円、ハウジング事業44,853百万円、エンジニアリング＆メンテナンス事業35,264百万円、アニマルヘルスケア事業23,416百万円、カーライフサポート事業17,955百万円、プロパティ事業7,347百万円、その他1,621百万円、連結売上高251,533百万円）と、【関連情報】の地域ごとの情報で本邦以外の外部顧客への売上高がないとされていることによります。",
        "asOf": "2026-02-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
