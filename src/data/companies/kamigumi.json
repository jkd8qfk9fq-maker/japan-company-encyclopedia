  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "存在意義（パーパス）と、2035年にありたい姿「日本と世界で物流の未来をデザインする総合物流カンパニー」を掲げる「長期ビジョン2035」を定め、その達成に向けた当初の5年間の計画として「中期経営計画2030」を進めています。基本方針は、国内基盤事業のシェア拡大・強靭化、収益基盤としてのグローバル事業の確立、新たな物流ニーズに対応した事業拡大、ポートフォリオ経営を支える経営管理への移行、全社最適な人材マネジメントの実践、DXを通じた業務の効率化と提供価値の拡張・高度化の6つです。構造改革と成長事業への積極投資を通じて、成長性と資本収益性の向上を図ります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "上組は、創業以来培ってきた「現場力」と充実した物流アセットを武器に、港湾領域で確固たるポジションを築いてきました。神戸港をはじめ全国の主要港に拠点を持ち、港湾運送から倉庫、国内輸送、国際輸送までをグループで一貫して担える体制が特徴です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への営業収益では、物流事業が260,849百万円と全体の約9割を占め、その他事業は33,908百万円でした。物流事業では飼料や穀物、青果物の取扱量が堅調に推移し、コンテナの取扱量も増加しました。倉庫や国内運送でも、スポット案件が寄与して入出庫作業と輸送の取扱量が増えています。",
        "basis": "セグメント注記の外部顧客への営業収益（2026年3月期）と、MD&Aのセグメント別の記述に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
