  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: ＷＤＢ工学株式会社は、2026年４月１日にＷＤＢ株式会社を存続会社とする吸収合併により解散しております（事業の内容・関係会社の状況に印字）。本登録は2026年３月31日時点のグループ構成（当社、連結子会社14社）で行います。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「新たなスタンダードを創出し、社会を変える」のもと、人材サービスとCROサービスをプラットフォームを通じて提供し、より利便性の高いサービスをより低いコストで提供することに挑戦しています。人材戦略では「人材派遣会社としての価値最大化」「プラットフォーム運営会社への転身」「AIと共存するCROモデルの確立」を掲げ、プラットフォームによる仲介業務の自動化と、削減した販管費の派遣スタッフへの還元を進めています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は前期比1.6％減の50,304百万円でした。MD&Aでは、理学系派遣・工学系派遣に対する需要は引き続き底堅い一方で、需要に応えるための求職者確保が課題であり、2022年4月以降の派遣スタッフの待遇改善の継続に加え、営業体制の強化、シニア層やパートタイムを希望するスタッフの提案活動、地域限定の正社員型派遣スタッフの採用を行った結果、受注率と退職率がいずれも改善したと説明されています。",
        "basis": "MD&Aの経営成績の概要、セグメント情報（報告セグメントごとの売上高）",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "経営方針では、理学系研究職派遣で働く人の3人に1人が当社グループより就業するまでになったと印字されており、バイオ・化学分野の研究職人材に特化した事業基盤を持ちます。MD&Aでは、2025年5月に公開した派遣サービスプラットフォーム「ドコ１」の契約数が順調に増加し、さらなる事業展開のために新しいプラットフォームの開発も複数進めていると説明されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、MD&Aの経営成績の概要",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは人材サービス事業（外部顧客への売上高43,547百万円）とCRO事業（同6,757百万円）の2つで、人材サービス事業が連結売上高の86.6％を占めます。人材サービス事業の販売実績は理学系研究職34,305百万円、一般事務職5,066百万円、工学系技術職3,246百万円の順です。地域ごとの情報は本邦の外部顧客への売上高が90％を超えるため省略され、売上高の10％以上を占める主要な顧客はいないと印字されています。",
        "basis": "セグメント情報（報告セグメントごとの売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）、MD&Aの販売実績",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
