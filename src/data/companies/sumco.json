  "history": [
    {
      "year": 1999,
      "title": "300mmウェーハの開発・製造を目的に設立",
      "description": "住友金属工業（現 日本製鉄）と三菱マテリアルグループが50％ずつ出資し、株式会社シリコン ユナイテッド マニュファクチュアリングとして設立されました。",
      "significance": "のちに2社のシリコン事業を統合する、SUMCOの出発点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "300mmウェーハの生産を開始",
      "description": "設立の目的だった300mm口径のシリコンウェーハの生産を始めました。",
      "significance": "現在の主力である300mmウェーハ事業の始まりです。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "住友金属工業と三菱マテリアルシリコンの事業を統合",
      "description": "住友金属工業からシリコン事業（シチックス事業本部）の営業を譲り受け、三菱マテリアルシリコンと合併して、商号を三菱住友シリコン株式会社に変更しました。",
      "significance": "両社のシリコンウェーハ事業が完全に統合され、各種シリコンウェーハの専業メーカーになりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "商号をSUMCOに変更、東京証券取引所に上場",
      "description": "8月に商号を株式会社ＳＵＭＣＯに変更し、11月に東京証券取引所市場第一部に上場しました。",
      "significance": "現在の社名になり、株式を公開しました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "コマツ電子金属を子会社化",
      "description": "株式の公開買付けにより、コマツ電子金属株式会社（現 SUMCO TECHXIV株式会社）を子会社にしました。同社は2008年に株式交換で完全子会社になっています。",
      "significance": "ウェーハ製造の拠点と技術が加わり、事業の規模が広がりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "ジャパンスーパークォーツを吸収合併",
      "description": "ジャパンスーパークォーツ株式会社を吸収合併し、同社は当社のJSQ事業部になりました。",
      "significance": "シリコン単結晶の製造に使う石英ルツボの事業を社内に取り込みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "監査等委員会設置会社に移行",
      "description": "3月に監査等委員会設置会社へ移行しました。",
      "significance": "経営の監督の仕組みを変えた出来事です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移りました。",
      "significance": "市場区分の再編に伴う変更です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "三菱マテリアルの半導体用多結晶シリコン事業を取得",
      "description": "3月、三菱マテリアルが新設した高純度シリコン株式会社に、同社の半導体用多結晶シリコン事業や関連会社の株式を引き継がせたうえで、高純度シリコン株式会社の株式を取得しました。",
      "significance": "ウェーハの原料である多結晶シリコンの製造も、グループで手がけるようになりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
  ],
