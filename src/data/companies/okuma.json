  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "存在意義（Purpose）として「『ものづくりサービス』の力で、社会に貢献する」を掲げ、2030年ビジョンとして、2030年度までに連結売上高3,000億円を目指しています。2026年度から2028年度までを対象とする中期経営計画2028では、「顧客起点の価値創造」と「事業基盤の改革」を方針とし、2028年度に連結売上高2,700億円の達成を目標として、収益成長ステージへの移行を推進するとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "工作機械を制御する数値制御装置（NC装置）を自社開発する世界有数の総合工作機械メーカーであり、機械技術から制御技術まで、ハードウエアからソフトウエアまで、ビフォアセールスからアフターサービスまで工作機械に関わる全てを自社で担う体制を持ちます。自社のスマートファクトリーで実証した自動化や知能化のノウハウを、顧客向けのソリューションとして提供できることも特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】・【研究開発活動】の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、日本が117,355百万円、米州が68,495百万円、欧州が34,351百万円、アジア・パシフィックが15,686百万円で、売上全体の約半分が日本、残りが海外という構成です。顧客の所在地別では日本向けが63,095百万円、中国向けが53,046百万円、米国向けが61,030百万円でした。海外売上高比率は2025年度に73.3%でした。",
        "basis": "【セグメント情報】・【経営方針、経営環境及び対処すべき課題等】の記載",
        "asOf": "2026-06-22",
