  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コーポレートスローガン『あなたのオフを、もっとスマイルに。』を価値基準とし、長期方針として『人にやさしい』『社会にやさしい』『地球にやさしい』の3つの『やさしい』の実現を掲げています。ホテル・ゴルフ場・リゾートなどの施設運営を主軸に、ウェルビーイングとソリューションビジネスの領域で多角的に事業を展開し、事業間シナジーを発揮しながらサステナビリティ経営を推進し、企業価値の向上を図る方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、訪日外国人旅行者数の増加とコト消費への転換を背景にインバウンド需要の取り込みを強化し、ホテル運営事業が増収をけん引しました。ゴルフ運営事業ではクーラー付きカートの導入や会員権販売、リソルの森事業では稼働率と客単価の改善と企業研修需要の回復が寄与しています。新規運営ホテルの開業準備や別荘シェア利用事業『リソルステイ』の拡充など、施設と商品のラインアップ拡大も進めています。",
        "basis": "MD&Aの経営成績等の状況の概要（セグメント別の経営成績の説明を含む）及び【経営方針、経営環境及び対処すべき課題等】の経営戦略等",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ホテル、ゴルフ場、リゾート施設の運営受託と再生を長年手がけてきた運営ノウハウが基盤です。主力ブランド『リソルホテルズ』の専任スタッフ『サービスコーディネーター』によるコンシェルジュサービスや、福利厚生代行『ライフサポート倶楽部』とリソルカード会員などの会員基盤を通じたグループ内の送客が特徴で、三井不動産株式会社やコナミグループ株式会社との事業協力関係も活用しています。",
        "basis": "【事業の内容】、【経営方針、経営環境及び対処すべき課題等】の経営戦略等、【関係会社の状況】及び【重要な契約等】",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期のセグメント別外部売上高では、ホテル運営事業が16,433百万円と連結売上高の過半を占め、ゴルフ運営事業が8,551百万円、リソルの森事業が4,235百万円と続きます。外部顧客への売上高はすべて国内で、本邦以外に所在する有形固定資産もありません。売上高の10％以上を占める主要な顧客はなく、顧客は多数の利用者と導入企業に分散しています。",
        "basis": "セグメント情報（外部顧客への売上高）及び関連情報の地域ごとの情報・主要な顧客ごとの情報、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
