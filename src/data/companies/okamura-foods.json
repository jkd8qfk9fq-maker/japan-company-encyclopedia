  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年2月に公表した中期経営目標2030で、国内養殖量の拡大と海外卸売事業の売上の拡大を最重要課題としています。国内養殖では中間養殖場の確保や給餌用バージ船の導入などで規模と効率を高め、海外卸売では日本食需要の大きい地域を中心に進出先を増やす計画です。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "外部顧客への売上高が最も大きいのは海外卸売事業の15,271百万円で、次いで国内加工事業の10,505百万円です。会社が最重要課題とする二つの領域のうち、海外卸売はすでに最大の売上区分になっており、養殖事業は7,529百万円で、国内養殖量の拡大が今後の売上構成を左右する位置づけにあります。",
        "basis": "セグメント情報の外部顧客への売上高、経営方針における経営戦略と対処すべき課題の記載",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、サーモンを中心に養殖から加工、海外卸売までを自社グループでつなぐ垂直統合の体制にあります。デンマーク子会社の大規模養殖のノウハウを国内養殖に活用し、養殖事業の一部でASC認証を取得していること、シンガポールで自社保有の超低温倉庫による温度管理と配送を行うコールドチェーンを持つことも特徴です。",
        "basis": "事業の内容における養殖・加工・海外卸売の各事業の記載、経営方針における経営戦略の記載",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "世界では一人当たりの食用魚介類の消費量が増加傾向にあり、持続可能な水準で漁獲される水産資源の割合が下がる中で養殖の重要性が高まっています。サーモン類の養殖収穫量は1990年から2024年で約11倍に拡大したと説明されており、同社はサーモンの養殖とアジア圏での日本食材販売を組み合わせて、この需要の拡大に対応する位置にあります。",
        "basis": "経営方針における経営環境の記載、セグメント情報の地域ごとの売上高の記載",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
