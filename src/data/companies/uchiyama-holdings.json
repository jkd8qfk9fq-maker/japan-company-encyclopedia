  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社である株式会社さわやか倶楽部は、2026年5月19日開催の取締役会において、株式会社さくらライフコミュニケーション（北海道旭川市で介護施設等を運営）の発行済株式の全てを取得し子会社化することを決議し、2026年5月30日付で株式譲渡契約を締結しました（重要な後発事象に記載）。企業結合日は2026年6月30日とされています。登録は2026年3月31日現在の体制（連結子会社2社）で行っています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月20日に公表した中期経営計画（2026年3月期から2028年3月期）では、「成長戦略」と「持続可能な成長への基盤作り」をテーマの中心に置き、既存事業の充実に加えて、介護事業を中心としたM&Aや新規事業の開発などを積極的に検討するとしています。介護事業では、有料老人ホームの年間200床の開設を目標に掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳では介護事業が24,457百万円と全体の8割以上を占め、収益の中心は介護事業です。カラオケ事業は4,110百万円で前期から減少し、飲食事業も581百万円と縮小しています。",
        "basis": "セグメント情報の外部顧客への売上高とMD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "介護事業では、有料老人ホームなどの入居型施設にデイサービスや訪問介護などの事業所を併設し、入居者が必要とする介護サービスを組み合わせて提供しています。一部施設を除いて入居一時金を受領しない料金形態を採用しており、既存施設の平均入居率は2026年3月期で93.9％と安定しています。",
        "basis": "事業の内容とMD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
