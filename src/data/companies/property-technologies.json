  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2024年11月期から始まる3か年）では「仕組みを磨き込み理想実現の基盤を築く」をテーマに、仲介会社ネットワークの拡大、業務支援SaaSサービスとiBuyerの展開による仕入情報の拡大、AI査定の精度向上とデータベースの拡充によるコアコンピタンスの強化を進める方針です。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "経営上の目標の達成状況を判断する指標として売上高と、価格査定数、物件仕入額・物件販売額、仲介会社営業員数などのプラットフォームのKPIを重視するとされ、2025年11月期の価格査定数は36,427件、仲介会社営業員数は31,969名と印字されています。情報量の拡大が仕入と販売の質的向上に結びつく構造が示されています。",
        "basis": "経営方針（経営上の目標の達成状況を判断するための客観的な指標等）、MD&A（経営成績に重要な影響を与える指標の進捗状況）",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "全国15拠点から不動産仲介会社約7,500社、仲介会社拠点約11,200拠点、仲介会社営業員約32,000人（いずれも2025年11月末現在）のネットワークを持ち、2025年11月期に約36,400件の価格査定を行った実績データベースにビッグデータを用いるAI査定を掛け合わせ、査定のスピードと精度で仕入につなげる体制を築いています。株式会社ホームネットの中古区分所有マンションの販売実績は、2011年12月以降で累計約9,000件です。",
        "basis": "事業の内容（取引ネットワーク、AI査定、販売・査定実績）、経営方針（経営環境及び経営戦略）",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "KAITRY事業の単一セグメントで、製品及びサービス別では中古住宅再生が最大の区分です。主要な顧客ごとの情報では、外部顧客への売上高の10％以上を占める相手先はないとされています。中古マンションの市場規模は2025年に3.6兆円、このうち中古住宅買取再販事業の市場規模は1兆400億円と見積もられています。",
        "basis": "セグメント情報等の関連情報（製品及びサービスごとの情報、主要な顧客ごとの情報）、経営方針（経営環境）",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
