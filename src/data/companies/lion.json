  "history": [
    {
      "year": 1891,
      "title": "小林富次郎商店が石鹸の製造販売を開始",
      "description": "初代小林富次郎が東京・神田柳原河岸の店舗で、石鹸・燐寸の原料と石鹸の製造販売を始めました。",
      "significance": "のちのライオン歯磨とライオン油脂につながる、創業の出発点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1980,
      "title": "ライオン歯磨とライオン油脂が合併し、ライオン株式会社が発足",
      "description": "1980年1月1日、ライオン歯磨株式会社とライオン油脂株式会社が対等合併し、ライオン株式会社として発足しました。",
      "significance": "ハミガキなどのオーラルケアと、油脂・洗剤を源流とする二つの会社が一つになり、今のライオンの形ができました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1993,
      "title": "アンネ株式会社を吸収合併",
      "description": "1993年1月、アンネ株式会社を吸収合併しました。",
      "significance": "合併後の事業拡大の一つとして沿革に記されています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "化学品事業を統合し、ライオン・スペシャリティ・ケミカルズが発足",
      "description": "2015年7月、当社の化学品事業、一方社油脂工業株式会社、ライオン・スペシャリティ・ケミカルズ株式会社を統合し、ライオン・スペシャリティ・ケミカルズ株式会社として発足しました。同年9月にはSouthern Lion Sdn. Bhd.を子会社化しました。",
      "significance": "現在の産業用品事業と海外事業の体制につながる再編です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "ライオン流通サービス株式会社を吸収合併",
      "description": "2020年1月、ライオン流通サービス株式会社を吸収合併しました。",
      "significance": "グループの国内の販売・流通機能を当社に取り込んだ出来事として沿革に記されています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所のプライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "本社を東京都台東区蔵前に移転",
      "description": "2023年1月、本社を東京都台東区蔵前に移転しました。同年5月には、研究開発子会社の獅王（上海）創新科技有限公司を設立しました。",
      "significance": "現在の本店の所在地です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "Merap Lion Holding Corporationを完全子会社化",
      "description": "持分法適用関連会社だったMerap Lion Holding Corporationの全株式を2025年7月に取得し、完全子会社にしました。同年8月に商号をMerap Lion Holding Limited Liability Companyに変更しました。同年12月には、保有する株式会社ジャパンリテールイノベーションの全株式を株式会社資生堂に譲渡しました。",
      "significance": "ベトナムでの事業を持分法適用関連会社から連結子会社に切り替えた出来事です。",
