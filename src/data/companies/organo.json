  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「オルガノは水で培った先端技術を駆使して未来をつくる産業と社会基盤の発展に貢献するパートナー企業としてあり続けます」です。中長期経営計画“ORGANO 2030”では、2030年度の売上高2,600億円を目指し、先端半導体市場での事業機会に対応するため、グローバルでのエンジニアリング体制を拡充し、コア技術の深化と新たな価値の創出を目指した技術開発を加速します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "水処理エンジニアリング事業の売上高は151,961百万円で、全体の85.5％を占めます。台湾、米国、欧州で大型の半導体向けプロジェクトを受注し、2026年3月期の地域別売上高は日本が111,128百万円、台湾が44,220百万円です。設備保有型サービスやメンテナンスなどのソリューション事業も好調に推移しています。",
        "basis": "2026年3月期のセグメント別売上高と地域別売上高、MD&Aの受注・売上の説明",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は177,654百万円で、前連結会計年度比8.8％増となり、過去最高となりました。従業員数は2,658人です。主要な顧客であるTaiwan Semiconductor Manufacturing Company, Ltd.への売上高は44,818百万円で、売上高の25.2％を占めます。",
        "basis": "2026年3月期の連結経営指標と主要な顧客ごとの情報",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
