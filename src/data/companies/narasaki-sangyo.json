  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年4月より2026年度を最終年度とする中期経営計画“NSクリエーション2026”を推進しています。「創業130年に向けた次世代のナラサキを創り上げる足固めの3ヵ年」と位置付け、成長戦略の推進、部門間連携の強化、経営基盤の強化、サステナビリティの推進を基本方針としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "電機、機械、建設・エネルギー、海運という広範な事業領域と事業内容を持ち、各事業セグメントが密接不可分な関係で有形無形にシナジー効果を発揮していることが強みです。セグメント間の情報共有化と連携・協業体制により、グループとしての総合力を発揮し、真の価値あるソリューションを提供します。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、建設・エネルギー関連事業が629億83百万円で最も大きく、電機関連事業が318億24百万円、海運関連事業が160億5百万円、機械関連事業が94億69百万円となっています。本邦の外部顧客への売上高が連結売上高の90％を超え、売上高の10％以上を占める相手先はありません。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報によります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
