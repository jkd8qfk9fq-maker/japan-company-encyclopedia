  "businesses": [
    {
      "id": "sk-electronics",
      "name": "株式会社エスケーエレクトロニクス",
      "description": "京都市上京区に本社を置き、大型フォトマスクの設計・製造・販売を主事業とする会社です。2001年に株式会社写真化学のエレクトロニクス事業部門の会社分割により設立されました。連結子会社は、頂正科技股份有限公司（台湾）、SKE KOREA CO., LTD.（韓国）、愛史科電子貿易(上海)有限公司（中国）、アサヒテック株式会社（愛知県瀬戸市）の4社で、いずれも完全子会社です。従業員数は2025年9月30日現在で437人（連結）です。東京証券取引所スタンダード市場に上場しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "large-photomask",
          "name": "大型フォトマスク事業",
          "description": "液晶パネルや有機ELパネルの製造に必要な原版である大型フォトマスクの設計・製造・販売を行う主力事業です。フォトマスクは、液晶や有機ELの制御回路やカラーフィルターのパターンを基板に転写するために使われる原版です。2025年9月期の外部顧客への売上高は28,776百万円です。製造は京都工場・滋賀工場と台湾の頂正科技股份有限公司が担い、中国・韓国の子会社が販売を行っています。",
          "customers": [
            "液晶パネルメーカー",
            "有機ELパネルメーカー"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "screen-metal-mask",
          "name": "スクリーンマスク・メタルマスク事業",
          "description": "2025年9月期にアサヒテック株式会社の全株式を取得して連結子会社としたことに伴い、新たに報告セグメントとして追加された事業です。車載ガラスや電子部品の印刷工程に使うスクリーンマスクと、半導体パッケージなどのはんだペースト印刷工程に使うメタルマスクを製造・販売します。2025年9月期の外部顧客への売上高は326百万円です。",
          "customers": [
            "車載ガラスメーカー",
            "電子部品メーカー",
            "半導体パッケージ事業者"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "solution",
          "name": "ソリューション事業",
          "description": "RFID分野とヘルスケア分野に取り組む事業です。2025年9月期の外部顧客への売上高は84百万円です。",
          "customers": [
            "RFID機器の導入事業者",
