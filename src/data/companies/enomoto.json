  "businesses": [
    {
      "id": "enomoto",
      "name": "株式会社エノモト",
      "description": "山梨県上野原市に本社を置く電子部品メーカーで、子会社4社（連結子会社3社、非連結子会社1社）とグループを構成しています。事業はプレス加工品関連事業の単一セグメントで、製品群別にパワー半導体用リードフレーム、オプト用リードフレーム、コネクタ用部品などを製造・販売しています。国内4工場、海外2工場（フィリピン、中国）に展開し、2026年3月期の連結従業員数は1,293人です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "connector-parts",
          "name": "コネクタ用部品",
          "description": "電子回路や光通信で配線を接続するコネクタ用部品と、その製造に使う精密金型・周辺機器の製造・販売です。スマートフォンやウェアラブル端末向けの極小コネクタ部品が中心で、金属プレス加工技術と樹脂成形加工技術を融合させ、設計から製造まで一貫生産しています。自動車向け部品の販売量も増えています。2026年3月期の外部顧客への売上高は14,411百万円で、製品群のうち最も大きくなっています。",
          "customers": [
            "スマートフォンやウェアラブル端末向けの部品メーカー",
            "自動車部品メーカー"
          ],
          "sourceIds": [
