  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "Mission、Vision、Yamato SPIRITのもと、海外事業を成長の源泉として安定・発展・拡大させ、姫路の工場を海外展開を支えるマザー工場として基盤強化を進めます。2030年ありたい姿に向け、形鋼事業の強靭化と、新たな鉄・インフラ・グリーン事業領域への進出に取り組みます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、鉄鋼事業（タイ）が68,520百万円で最大の拠点となり、鉄鋼事業（日本）の52,981百万円を上回っています。タイとインドネシアを合わせた海外の鉄鋼事業の売上高が日本を上回り、海外が業績の中心になっています。",
        "basis": "2026年3月期の外部顧客への売上高は、鉄鋼事業（タイ）68,520百万円、鉄鋼事業（日本）52,981百万円、鉄鋼事業（インドネシア）25,033百万円、軌道用品事業9,674百万円です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内姫路の工場をマザー工場とし、タイ・インドネシア・米国・ベトナム・韓国に生産・販売拠点を持つ地産地消型の事業展開があります。米国の持分法適用関連会社は安定した高収益を確保し、連結業績を牽引しています。",
        "basis": "マザー工場である国内事業を基盤に、需要が堅実な市場やインフラ投資の伸びが期待できる新興国に生産・販売拠点を持つ地産地消型の事業活動を展開しています。米国事業は堅調な需要に加え、政府による関税強化措置を背景とした市況上昇により安定した高収益を確保し、引続き連結業績を牽引しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
