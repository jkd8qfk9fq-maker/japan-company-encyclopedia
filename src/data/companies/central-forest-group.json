  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループビジョンとして「食の最適流通を目指して『流通の森』を創造し、最も信頼される地域密着の卸グループとして、お取引先様と社会の発展に貢献します」を掲げています。2026年12月期から2030年12月期までを期間とする長期戦略（第2次）を始動し、2030年に向けた長期ビジョン「『卸』を変える。」のもと、新たな成長領域への取り組みを通じて収益性の高いビジネスモデルへの転換を図るとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "販売戦略と物流戦略の両輪で取り組みを進めるとしています。スーパーマーケットでは重点地域を愛知三河・静岡・三重エリアとし、地域ごとの得意先のニーズや消費者の嗜好の変化を踏まえた商品開発・提案や、惣菜部門への提案を強化しています。ドラッグストアでは、得意先と共に収益改善に取り組むとともに、当社グループが受託する物流エリアの拡大を進めています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
