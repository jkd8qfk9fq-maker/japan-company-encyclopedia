  "history": [
    {
      "year": 2007,
      "title": "大丸と松坂屋ホールディングスが株式移転で当社を設立し、上場",
      "description": "2007年4月9日に株式会社大丸と株式会社松坂屋ホールディングスが株式移転で共同の持株会社を設立することを取締役会で決議し、5月24日に両社の定時株主総会で承認されました。9月3日に株式移転で当社が設立され、普通株式が東京、大阪、名古屋の各証券取引所に上場しました。11月1日には株式会社松坂屋ホールディングスを吸収合併しています。",
      "significance": "百貨店の大丸と松坂屋が、持株会社の下で一つの企業集団になった出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "松坂屋が大丸を吸収合併し、株式会社大丸松坂屋百貨店が発足",
      "description": "2010年3月1日に株式会社松坂屋が株式会社大丸を吸収合併し、社名を株式会社大丸松坂屋百貨店に変更しました。",
      "significance": "二つの百貨店会社が一つの事業会社にまとまり、現在の百貨店事業の中心会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
