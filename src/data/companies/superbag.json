  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年5月10日に公表した第2次中期経営計画『環境と共に歩む次世代パッケージ企業～創業120年の誇りを胸に～』のもと、『成長戦略の追求と環境経営基盤の構築』を基本方針とし、紙製品事業への注力、新規事業開拓、環境偏差値向上、人的資本・ガバナンス強化、経営基盤戦略に取り組むとしています。最終年度の2026年度は、収益構造改革の推進と財務体質の強化を引き続き目標としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は、紙製品事業が15,248百万円と過半を占め、用度品・消耗資材の一括納品を行うその他事業が7,161百万円、ポリ袋等の化成品事業が5,752百万円と続きます。来店型店舗向けの包装資材需要と紙製宅配資材の販売が堅調だったと開示されています。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメントごとの経営成績に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1953年にわが国初の角底自動製袋機を導入した製袋業界のパイオニアであり、角底袋の商標「スーパーバッグ」が社名になっています。所沢工場と鶴ヶ島工場、北海道の連結子会社による自社製造体制を持ち、紙袋の製造から用度品の一括納品まで包装まわりを幅広く担えることが特徴です。",
        "basis": "沿革における角底自動製袋機の導入と商標命名の記載、事業の内容における製造体制の説明、主要な設備の状況における工場の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の90％超が本邦の外部顧客向けで、売上高の10％以上を占める単一の外部顧客はないと開示されています。経営理念では、わが国製袋業界のパイオニアとしてパッケージ関連事業を軸に展開するとしています。",
        "basis": "セグメント情報の関連情報における地域ごとの情報と主要な顧客ごとの情報、経営方針における経営理念の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
