  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月から始めた「中長期経営計画 2026-2035」では、中長期ビジョン「高速ファンづくり チャレンジ 2035 to be a good company」を掲げ、顧客満足度の向上や重点領域の拡大、M&Aの推進、シナジーの最大化などに取り組むとしています。事業上・財務上の重要課題として、本部・営業支援部門の強化、DX等による業務改善、人材育成・働き方改革、新ビジネス・新商品開発への挑戦、新規顧客の開拓・深耕、グループシナジー効果の発揮を挙げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "主力とする食品軽包装資材は生活必需品であることと、中食市場の拡大によって食品軽包装材の需要が拡大していることを強みとして挙げ、新規開拓と既存のお客様への販売拡大を進めて成長を持続するとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "包装資材等製造販売事業の単一セグメントで、2026年3月期の商品グループ別の販売実績では食品容器が最も大きく、フィルム・ラミネート、機械・設備資材・消耗材が続きます。海外への売上高はなく、売上高の10％以上を占めるお客様もないため、幅広いお客様への販売で構成されています。",
        "basis": "【経理の状況】（セグメント情報等）の単一セグメントの注記と関連情報（地域ごとの情報・主要な顧客ごとの情報）、および【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の商品グループ別販売実績によります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
