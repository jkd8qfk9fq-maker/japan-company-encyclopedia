  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "さまざまな自然災害に対する国土の防災と豊かな自然環境の保全を目指し、新技術・新工法の開発と普及に取り組み、快適な未来社会の創造に貢献することを使命としています。消波根固ブロック工法の技術を核に、型枠貸与事業と製品販売事業で既存事業の収益拡大を図り、付加価値のある新事業・新製品の開発、既存事業製品の選択と集中、協力会社ネットワークの維持強化と新たな協力・提携関係の構築を課題に挙げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "自社工場を持たず協力工場に製造を委託する製品販売と、自社で保有する鋼製型枠を貸し出す型枠貸与を組み合わせ、防災・減災という公共需要に特化した事業を展開しています。",
        "basis": "主要な設備の状況に記載された鋼製型枠の保有と、経営者による分析に記載された製造委託の形態",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "創立以来一貫して培ってきた消波根固ブロック工法の技術を核とすることを経営戦略に掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "1964年の「３連ブロック」以来、護岸・河川・海岸向けの工法と製品を長年にわたり自社開発してきた実績が、製品群の厚みにつながっています。",
        "basis": "沿革に記載された1964年以降の製品・工法開発の積み重ね",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "型枠貸与事業の市場規模は社会基盤整備の進捗によりピーク時の約３分の１となり停滞してきましたが、防災・減災に対する機能の強化と強靭化への社会的要求の高まりから、中長期的には事業機会が再び漸増していくと想定しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "港湾、漁港、海岸、河川、砂防分野における国の防災・減災対策事業へ製品と工法を提供する、土木資材分野の専門メーカーとして位置付けられます。",
        "basis": "経営者による分析に記載された事業の基本姿勢（対象分野と提供内容）",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
