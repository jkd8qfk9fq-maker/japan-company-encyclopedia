  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「テクノロジーで、住宅を変え、世界を変えていく。」という経営理念のもと、土地から選べるアパート経営「robot home」を継続的にアップデートし、不動産オーナー向けの物件供給から賃貸管理の受託、売却・再投資を経てプラットフォーム内の流通が拡大する好循環成長サイクルを生み出して安定的にストック収入を拡大する方針です。あわせて、プロパティマネジメント領域のDXプラットフォームの強化、IT人員の採用と育成、データドリブンによる革新的サービスの創出を進めるとしています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高は2021年12月期の4,090百万円から2025年12月期の24,068百万円へ拡大し、従業員数も169人から244人へ増えています。2025年12月期の売上高はrobot home事業が23,161百万円、AI・IoT事業が906百万円で、robot home事業が中心です。物件供給などのフロー領域と賃貸管理などのストック領域を同じプラットフォームでつなぐ構造です。",
        "basis": "経営指標等の売上高と従業員数、セグメント情報の外部顧客への売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績の概要による。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社で培った不動産のリアル領域のノウハウと、IoT機器の開発を行う連結子会社を持つテクノロジー領域の知見を併せ持ち、入居者、オーナー、メンテナンス会社、賃貸仲介会社、賃貸管理会社を一つのプラットフォーム上でつないでいます。賃貸管理ではRPAシステム「robot home for PM」で業務を効率化し、家賃保証やメンテナンスまで自社グループで担う体制を持っています。",
        "basis": "事業の内容と関係会社の状況による。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
