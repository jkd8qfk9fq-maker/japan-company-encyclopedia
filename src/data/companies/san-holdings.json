  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2032年の創業100年に向けた「10年ビジョン」において「葬儀事業の拡大」と「ライフエンディングサポート事業の拡大」を掲げ、葬儀会館数は2031年度にグループ全体で550会館を目指します。2025年度からの中期経営計画（2025年度～2027年度）では、Growth（成長）、Quality（品質）、Change（変革）、Sustainability（持続可能性）の4つの重点テーマに取り組み、家族葬ブランドの自社展開の加速やM&Aの活用、株式会社きずなホールディングスとの経営統合の推進を進める方針です。",
        "asOf": "2025-06-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "営業収益の内訳は公益社グループが約6割、きずなグループが約2割を占め、関西圏と首都圏を地盤とする公益社グループと、家族葬ブランドを全国展開するきずなグループの2グループが事業の中核となっています。売上はすべて国内であり、本邦以外の外部顧客への売上高はありません。",
        "basis": "セグメント情報のセグメント別売上高、関連情報の製品及びサービスごとの情報、地域ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2025-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1932年創業の前身以来の葬祭事業の実績を持ち、全国16都道府県に267会館を展開して年間およそ33,000件の葬儀を取り扱う規模が特徴です。家族葬ブランド「エンディングハウス」の自社出店に加え、株式会社きずなホールディングスの連結子会社化で得た家族葬のノウハウをグループの品質向上に活用する方針です。",
        "basis": "事業の内容の記述、沿革の記録、MD&Aの経営成績の概要に基づく",
        "asOf": "2025-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "葬儀業界では、高齢者人口の増加を背景に葬儀の潜在需要が2040年まで増加すると見込まれる一方で、家族葬や一日葬の広がりにより葬儀施行単価が下落し、葬祭会館の新規出店やインターネットによる葬儀紹介会社との競争が激化しています。当社グループは、全国規模の会館網を持つ葬儀事業者として出店拡大で対応しています。",
        "basis": "セグメント情報のセグメント別売上高、関連情報の製品及びサービスごとの情報、地域ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2025-06-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
