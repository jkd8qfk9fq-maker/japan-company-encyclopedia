  "businesses": [
    {
      "id": "petroleum",
      "name": "石油関連事業",
      "description": "ガソリン・灯油・軽油・重油などの石油製品を、特約店（元売会社と契約して販売する店）や大口の需要家に売る事業です。石油元売会社から頼まれて、石油製品の保管や出荷も行います。子会社のキグナス石油㈱が販売と油槽所の運営を、三愛リテールサービス㈱などがガソリンスタンドでの小売を担い、運送の子会社が油槽所の管理や配送を行います。2026年3月期の外部顧客への売上高は516,413百万円（前期は560,251百万円）で、最も大きい事業です。",
      "products": [
        "ガソリン・灯油・軽油・重油",
        "石油製品の保管・出荷の受託",
        "ガソリンスタンドでの小売"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "gas",
      "name": "ガス関連事業",
      "description": "LPガス、天然ガス、都市ガスとガス器具を売る事業です。当社が子会社へLPガスを卸し、子会社がLPガスの特約店や大口の需要家への販売、一般家庭への小売、配送や充填作業を行います。当社は天然ガスの大口販売とパイプラインの運営も行い、佐賀ガス㈱と伊万里ガス㈱は都市ガスを一般消費者へ届けます。2026年3月期の外部顧客への売上高は58,468百万円（前期は61,303百万円）です。",
      "products": [
        "LPガス",
        "天然ガス",
        "都市ガス",
        "ガス器具"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "aviation",
      "name": "航空関連事業",
      "description": "航空会社や石油元売会社から頼まれて、航空燃料の保管と、飛行機への給油を行う事業です。当社は国内7空港の給油施設を持ち、貸し出しも行っています。2026年3月期の外部顧客への売上高は16,748百万円（前期は14,430百万円）です。",
      "products": [
        "航空燃料の保管",
        "航空機への給油",
        "空港の給油施設の賃貸"
      ],
      "sourceIds": [
