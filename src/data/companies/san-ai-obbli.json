  "history": [
    {
      "year": 1952,
      "title": "三愛石油として発足し、羽田空港で航空機への給油を始める",
      "description": "1952年6月に、石油製品の販売を目的として、三愛石油株式会社の名で、スタンダード・ヴァキューム石油会社の代理店として発足しました。同年10月には羽田空港内での営業を許可され、航空機への給油事業を始めました。",
      "significance": "石油製品の販売と航空燃料の給油は、現在の石油関連事業と航空関連事業につながっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "川崎油槽所でLPガスの充填を始める",
      "description": "1960年9月に、神奈川県川崎市に川崎油槽所を開設し、LPガスの充填業務を始めました。",
      "significance": "LPガスは、現在のガス関連事業の中心の一つです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "東京証券取引所第二部に上場",
      "description": "1961年10月に、東京証券取引所第二部に上場しました。1968年8月には第一部に指定替えとなっています。",
      "significance": "2022年4月の市場区分の見直しで、プライム市場に移行しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "研究所を設置し、泡消火剤などの開発に着手",
      "description": "1969年7月に、東京都日野市に研究所を設置し、泡消火剤、防かび剤、防錆剤などの開発・製造・販売に着手しました。",
      "significance": "化学品関連事業の始まりにあたります。1998年8月には、化学製品の製造・販売会社である東洋理研株式会社（現・三愛理研株式会社）を買収しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "佐賀ガス㈱を合弁で設立",
      "description": "2002年10月に、佐賀市ガス局の民営化に伴い、佐賀市営ガス事業を譲り受けて運営するため、佐賀ガス株式会社を合弁で設立しました。",
      "significance": "佐賀ガス㈱は、2026年3月31日現在の連結子会社で、当社の議決権所有割合は78.57％です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【関係会社の状況】"
    },
    {
      "year": 2004,
      "title": "キグナス石油㈱の全株式を取得",
      "description": "2004年12月に、石油元売会社であるキグナス石油株式会社の全株式を、東燃ゼネラル石油株式会社とニチモウ株式会社から取得しました。2017年5月には、コスモエネルギーホールディングス株式会社との資本業務提携契約の締結に伴い、同社の株式20％をコスモエネルギーホールディングス㈱へ譲渡しました。",
      "significance": "キグナス石油㈱は石油関連事業の中心となる連結子会社で、2026年3月31日現在の議決権所有割合は80％です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【関係会社の状況】"
    },
    {
      "year": 2008,
      "title": "國際油化㈱（現・三愛リテールサービス㈱）の全株式を取得",
      "description": "2008年7月に、石油製品などの販売会社である國際油化株式会社（現・三愛リテールサービス株式会社）の全株式を、三井物産株式会社から取得しました。",
      "significance": "三愛リテールサービス㈱は、ガソリンスタンドでの小売を担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【事業の内容】"
    },
    {
      "year": 2022,
      "title": "商号を三愛オブリ株式会社に変更",
      "description": "2022年4月に、商号を三愛石油株式会社から三愛オブリ株式会社に変更しました。同月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の社名です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
