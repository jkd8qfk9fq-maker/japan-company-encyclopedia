  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「世界を驚かすサービスを創出する」という理念のもと、将棋などの頭脳ゲームAIの開発で培った技術力と、グループ会社に蓄積されたSaaS関連技術・セキュリティ関連技術を活かして、AI革命を起こし、未来を創っていく集団であり続けることを基本方針としています。HEROZ3.0として「AI BPaaS」を掲げ、生成AIやAIエージェントを活用してAIが業務全体を自律的に遂行する価値提供を目指し、課題の分解から解決策の実行までを自律的に行う「Meta Agent」の実現に取り組むとしています。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、将棋AIの開発で培った機械学習や深層学習の技術力と、会員数800万人以上を有する将棋ウォーズの利用者基盤にあります。バリオセキュアは、セキュリティ機器の開発から設置、監視・運用までをワンストップで提供し、全国7,651拠点にセキュリティBPOサービスを提供しています。",
        "basis": "【事業の内容】における将棋AIへの機械学習の適用、将棋ウォーズの会員数、バリオセキュアのワンストップ提供と設置拠点数の記載に基づく。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "AI市場では生成AIの活用が実証実験から本格導入の段階へ移り、自律的に判断・実行するAIエージェントへの注目が高まっています。同社は将棋の分野でAIが現役プロ棋士に勝利した実績を持ち、生成AIアシスタントSaaS「HEROZ ASK」の累計契約顧客数は2026年4月末時点で約430社まで拡大しています。",
        "basis": "【事業の内容】および【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】におけるAI市場の動向、将棋AIの対プロ棋士戦績とHEROZ ASKの累計契約顧客数の記載に基づく。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
