  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "リースファンド・不動産ファンド（国内・海外）分野でリーディングカンパニーとしての地位を維持・獲得し、第4の柱を構築することを事業運営方針としています。成長を支える体制の強化、DXの推進、FPG証券やFPG信託などグループ各社のリソースを活用した新たな商品サービスの創出、SDGsへの取り組みを進めます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "企業理念「金融で未来を拓く」のもと、「小口化」という仕組みによる新たな投資の選択肢を提案し、多くのお客さまに価値ある資産を届けます。FPG証券、FPG信託などFPGグループ各社のリソースを活用した新たな商品サービスを創出します。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年9月期の外部顧客への売上高では、国内不動産ファンド事業が95,988百万円と全体の約74％を占め、リースファンド事業が29,842百万円、海外不動産ファンド事業が3,516百万円です。本邦の外部顧客への売上高が全体の90％を超え、連結売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の記載による。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
