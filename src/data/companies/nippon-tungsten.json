  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2028年度を最終年度とする中期経営計画を推進し、サステナビリティを軸とした経営のもとで、目指すべき姿として「ビジョン2028」を掲げています。全社戦略として、希少資源を通じた価値最大化と働きがい・創造力の向上を中心に、ＤＸ、アライアンス、財務戦略を一体で進め、事業の選択と集中によりコア事業の収益基盤を強化しながら成長事業への投資を加速するとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1931年の設立以来、タングステンをはじめとする希少金属の粉末冶金技術を蓄積してきたメーカーで、衛生用品製造設備向けのＮＴダイカッターや、データセンターで使われる大容量ハードディスクドライブ向けの磁気ヘッド基板など、用途に特化した製品を持っています。使用済み製品の買い取りやリサイクル粉末の活用の検討など、希少資源の循環にも取り組んでいます。",
        "basis": "沿革に1931年の設立が印字され、研究開発活動に粉末冶金技術を基盤とすることが、経営方針に約100年にわたり磨き上げてきた素材と加工の技術（マテリアル力）があることが、経営成績の分析にＮＴダイカッターとＨＤＤ用磁気ヘッド基板が注力商品であることが印字されているため。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "タングステンやモリブデンなどの希少金属の加工を手がけるメーカーで、顧客は衛生用品、半導体・電子部品、自動車、医療、産業機器など幅広い製造業にわたります。2026年3月期に売上高の10％以上を占めた顧客は、株式会社プロテリアルだけでした。",
        "basis": "事業の内容にタングステン・モリブデン製品の製造販売が印字され、主要な顧客ごとの情報に、2026年3月期の株式会社プロテリアルへの売上高が全体の10.5％を占め、10％以上を占める顧客は同社のみであることが印字されているため。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
