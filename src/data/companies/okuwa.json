  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「わが社の成長発展こそがお客様の生活文化の向上を促し、社会への大きな貢献となることを念願し、チェーンストア業界の名門としての地位を永遠に確立する」を掲げています。中期経営計画（2026年度を最終年度）については、市場環境の変化や施策の進捗、直近の営業成績を鑑み、計画最終年度における達成が困難であると判断し、目標数値を取り下げました。資本政策・店舗戦略・商品戦略・販売促進施策等の中長期戦略に変更はなく、引き続き注力するとしています。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "地盤の和歌山県に48店舗と最も厚い店舗網を持ち、農産物の加工・配送を担う連結子会社をグループ内に抱えることで、生鮮品の供給体制を自前で整えています。",
        "basis": "【主要な設備の状況】に和歌山県48店舗（スーパーセンターオークワ南紀店他47店舗）と印字され都道府県別で最多であり、【事業の内容】に連結子会社の株式会社サンライズが主に農産物等の加工及び配送業務を行うと印字されている。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはスーパーマーケット事業のみで、単一の製品・サービス区分の外部顧客への売上高が連結売上高の90％を超えています。店舗は和歌山県を中心に近畿・東海の7府県に153店舗あります（2026年2月20日現在）。",
        "basis": "【セグメント情報】に報告セグメントはスーパーマーケット事業のみと印字され、【関連情報】に単一の製品・サービス区分の外部顧客への売上高が連結損益計算書の売上高の90％を超えると印字されている。店舗数は【主要な設備の状況】の都道府県別の店舗数の合計。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
