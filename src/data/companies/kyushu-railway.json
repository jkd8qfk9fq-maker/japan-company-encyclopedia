  "history": [
    {
      "year": 1987,
      "title": "日本国有鉄道改革法により設立",
      "description": "1987年4月、日本国有鉄道改革法に基づいて会社が設立されました。",
      "significance": "国鉄の分割・民営化で生まれた旅客鉄道会社の一つとして、九州での鉄道事業を引き継ぎました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "宮崎空港線が開業",
      "description": "1996年7月に宮崎空港線（田吉～宮崎空港）が開業しました。",
      "significance": "鉄道網が宮崎空港まで伸びました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "九州新幹線が開業",
      "description": "2004年3月に九州新幹線が開業しました。あわせて、鹿児島本線（八代～川内）は肥薩おれんじ鉄道㈱へ移行しました。",
      "significance": "九州の主要都市を結ぶ新幹線網づくりの最初の区間です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "九州新幹線が全線開業、JR博多シティが開業",
      "description": "2011年3月に九州新幹線が全線開業し、同時にJR博多シティが開業しました。",
      "significance": "新幹線と駅ビルの開業が重なり、鉄道と不動産・流通を組み合わせた事業の広がりを示す出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "完全民営化し、東京証券取引所と福岡証券取引所に上場",
      "description": "2016年4月にJR会社法の適用対象から除外され、同年10月に独立行政法人鉄道建設・運輸施設整備支援機構が持つ普通株式160百万株の売却により完全民営化しました。同月、東京証券取引所本則市場第一部と福岡証券取引所本則市場に上場しました。",
      "significance": "国が関わる会社から、株式を公開する民間企業になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "キャタピラー九州の株式を取得",
      "description": "2017年10月にキャタピラー九州㈱の株式を取得し、子会社としました。",
      "significance": "建設機械の販売・レンタルが、現在のビジネスサービスの柱になっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "西九州新幹線が開業、東証プライム市場へ移行",
      "description": "2022年4月に東京証券取引所の市場区分の見直しでプライム市場へ移行しました。同年9月に西九州新幹線が開業し、長崎本線の鉄道施設の一部を一般社団法人佐賀・長崎鉄道管理センターに譲渡して上下分離方式へ移行しました。",
      "significance": "新幹線が2路線になり、一部区間では施設の保有と運行を分ける方式を採りました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "ホテル運営会社3社を合併し、JR九州ホテルズアンドリゾーツに",
      "description": "2024年10月にJR九州ホテルズ㈱、JR九州ハウステンボスホテル㈱、JR九州ステーションホテル小倉㈱がJR九州ホテルマネジメント㈱を存続会社として合併し、JR九州ホテルズアンドリゾーツ㈱に商号変更しました。",
      "significance": "グループのホテル運営を1社にまとめました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
