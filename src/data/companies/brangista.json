  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「CONNECT with COMMUNITY」を企業理念に掲げ、電子雑誌や各種ソリューションサービスを中心としたプロモーションをワンストップで提供し、地方創生に貢献することをミッションとしています。プロモーション支援事業では地域金融機関との連携拡大と自治体への利用促進、メディア事業では自治体とのタイアップ広告の拡充と電子雑誌「旅色」への予約機能の追加、ソリューション事業では「TikTok Shop」運用支援サービスの拡大に取り組むとしています。",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "電子雑誌の媒体力と、タレント起用型のプロモーション支援、EC支援を組み合わせ、企業と自治体の双方に販促支援を提供する戦略です。",
        "basis": "経営方針、経営環境及び対処すべき課題等に、プロモーション支援事業における地域金融機関との連携拡大、メディア事業における自治体タイアップ広告の拡充、ソリューション事業におけるTikTok Shop運用支援サービスの拡大が、優先的に対処すべき課題として記載されていることによるものです。",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2007年の創刊以来発行を続ける電子雑誌「旅色」の媒体資産と、著名タレントの写真・動画を初期費用不要の月額定額制で使える仕組み、新規顧客の開拓からリピーター化までを一社で担うワンストップ体制が強みです。",
        "basis": "事業の内容に、電子雑誌「旅色」をはじめとする複数の電子雑誌の発行、初期費用不要かつ月額定額制で著名タレントの写真・動画が使えるプロモーションツールの提供、新規顧客の開拓から顧客のリピーター化までを当社一社で提供することが記載されていることによるものです。",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子雑誌メディアと企業プロモーション支援を主力とする会社で、メディア事業とプロモーション支援事業の2事業で売上高の約8割を占めています。",
        "basis": "セグメント情報に、メディア事業の外部顧客への売上高が2,060百万円、プロモーション支援事業が2,055百万円（連結売上高5,196百万円）であることが記載されていることによるものです。",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
