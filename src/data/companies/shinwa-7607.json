  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第４次中期経営計画「Change！ Shinwa moving forward 2026」のもと、成長市場におけるビジネスの拡大、生産・開発体制の拡充、グローバルビジネスの拡大と体制整備、経営基盤の強化、株主還元の拡充を基本方針としています。",
        "asOf": "2025-11-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "金属接合を事業の核とする製造部門を持つエンジニアリング商社として、溶接機器・材料や産業機械、ＦＡシステム関連商品の販売に加え、肉盛溶接・溶射加工やろう付加工、メンテナンス工事を自社で手がけています。",
        "asOf": "2025-11-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当社グループは、製造業における生産設備および資材の製造、販売、メンテナンスを主な事業としており、単一の製品・サービス区分の外部顧客への売上高が連結売上高の90％を超えています。2025年8月期の売上高は86,146百万円で、外部顧客への売上高は日本67,160百万円、米州8,650百万円、アジア・パシフィック5,675百万円、中国4,156百万円、その他506百万円です。地域ごとの売上高は日本58,962百万円、米国9,690百万円、その他17,493百万円です。主要な販売先はトヨタ自動車とデンソーです。当社グループの経営成績は、自動車関連産業、なかでもトヨタ自動車グループの設備投資動向に影響を受ける可能性があります。",
        "basis": "セグメント情報（報告セグメントごとの売上高、関連情報の製品及びサービスごとの情報、地域ごとの情報及び主要な顧客ごとの情報）及び経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（販売実績）の印字に基づきます。",
        "asOf": "2025-11-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
