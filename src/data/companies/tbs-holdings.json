    {
      "year": 1955,
      "title": "テレビ本放送を開始",
      "description": "1955年4月に東京都港区赤坂でテレビの本放送を始めました。1960年9月にはカラー本放送も始めています。",
      "significance": "ラジオに加えてテレビが事業の柱になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "東京証券取引所に上場、商号を東京放送に変更",
      "description": "1960年10月に東京証券取引所に株式を上場し、同年11月に商号を「株式会社東京放送」、略称を「TBS」に変更しました。",
      "significance": "「TBS」の名前がここから使われています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "BSデジタル放送が始まり、分社化を進める",
      "description": "2000年3月に分社化の一環としてラジオ、エンタテインメント、スポーツの3社を設立しました。同年12月には出資先のビーエス・アイがBSデジタル放送を始めました。",
      "significance": "放送を分社で担う、今のグループ体制につながる動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "地上デジタル放送を開始",
      "description": "2003年12月に地上デジタル放送を始めました。2011年7月には地上波テレビがデジタルに完全移行しました。",
      "significance": "放送がアナログからデジタルへ切り替わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "TBSテレビが発足",
      "description": "2004年10月に、ティ・ビー・エス・エンタテインメントがスポーツ・ライブの2社を吸収合併し、商号をTBSテレビに変更しました。",
      "significance": "テレビ事業を担う中核の子会社が形になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "赤坂再開発が終わり、スタイリングライフを連結化",
      "description": "2008年2月に「赤坂再開発工事」が終わり、赤坂サカスが営業を始めました。同年7月にはスタイリングライフ・ホールディングスの株式を取得し、同社と関係会社を連結グループに加えました。",
      "significance": "不動産事業と、放送以外のライフスタイル事業が広がった時期です。",
