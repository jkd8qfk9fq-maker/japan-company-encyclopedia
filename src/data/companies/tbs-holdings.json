  "history": [
    {
      "year": 1951,
      "title": "ラジオ東京として設立、ラジオ本放送を開始",
      "description": "1951年5月に関東地区で最初の民間放送局として、商号「株式会社ラジオ東京」で設立されました。同年12月にラジオの本放送を始めました。",
      "significance": "現在のTBSグループの出発点です。",
