  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションとして「かかわる“Ｃ”に次のステージを提供し、笑顔になっていただく」を掲げています。中核事業のローカルビジネスDX事業では、「C-mo」の機能強化やサポート体制の充実を進めるとともに、直販体制の強化及びアライアンス企業との連携拡大により、顧客満足度の向上と市場シェアの拡大を重点課題としています。グルメ、ビューティー、トラベルの各業界に加え、その他業界へのサービス拡大や、マーケティング以外の領域における新たなソリューション創出も視野に入れ、事業領域の拡大を図るとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ローカルビジネスに特化し、「C-mo Pro」によるコンサルティングを通じて蓄積してきたデータとノウハウを活かして支援を行う点に特徴があります。自ら飲食店を運営するリアル店舗事業で得られる実践的知見や運営ノウハウは、ローカルビジネスDX事業に還元され、提供サービスの付加価値向上に活かされており、両事業は相互に補完し合いながら成長を実現しているとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年9月期の売上高3,178百万円のうち、ローカルビジネスDX事業が2,732百万円と大半を占め、リアル店舗事業が281百万円、その他が165百万円です。同社が支援するグルメ、ビューティー、トラベル業界だけでも120万店舗以上の店舗が存在するとされる一方、多くの事業者は中小企業であり人手やノウハウが不足していることから、業界全体としてDX化の進展は限定的であると説明されています。",
        "basis": "セグメント情報に印字された外部顧客への売上高と、経営環境の説明に基づきます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
