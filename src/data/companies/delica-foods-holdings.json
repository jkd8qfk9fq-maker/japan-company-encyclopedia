    "strategy": {
      "disclosed": {
        "text": "2024年５月に、長期ビジョンとして「野菜の総合加工メーカーとしてのポジションを確立」「持続可能な農業の実現」「個人の幸福と会社の繁栄の両立」を掲げ、その実現に向けた第五次中期経営計画「keep on trying 2027」を策定しました。基本方針として、事業・顧客・商品の各種ポートフォリオの変革、青果物サプライチェーンの構造改革、研究部門・開発部門への投資拡大に取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "カット野菜の販売ではリーディングカンパニーとして事業を行っており、ホール野菜からカット野菜、真空加熱野菜、ミールキットまでを一貫して扱っています。物流では温度記録の掲示などを行うスーパーコールドチェーンを構築し、研究開発・分析では抗酸化力やビタミンＣ、糖度などの約45,000検体に及ぶ青果物のデータベースを持っています。",
        "basis": "事業の内容（カット野菜、物流事業、研究開発・分析事業）の記載に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業の中心は青果物事業で、2026年３月期の外部顧客への売上高は青果物事業が60,968百万円、物流事業が1,201百万円、研究開発・分析事業が49百万円で、持株会社には外部顧客への売上高がありません。青果物事業の販売高はカット野菜部門が27,210百万円、ホール野菜部門が24,529百万円、その他が9,228百万円です。売上高はすべて国内であり、売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報）および経営成績の分析（販売実績）の記載に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
