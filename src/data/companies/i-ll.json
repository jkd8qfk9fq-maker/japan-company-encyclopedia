  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基幹システム（リアル）とWebサービス（Web）の製品・サービスを単体ではなく「製品群」として相互にリンクさせて提案する「CROSS-OVER」戦略を基本戦略とし、労働集約型から知識集約型ビジネスモデルへの転換とストック型ビジネスの強化により、経済環境に左右されない安定的・継続的な収益性の実現を目指すとしています。",
        "asOf": "2026-10-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "営業とSEを同一組織に配置する製販一体体制を導入し、見積時の要件の見極めによる案件精度の向上やプロジェクトマネジメント体制の強化、納品品質の向上による稼働後のアフターサポート工数の削減を進めています。継続的な大型案件の受注とストック売上高の積上げにより、2026年7月期の売上高は前期比8.3％増となりました。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の製品及びサービスごとの情報、MD&Aの経営成績の概況と売上高の分析に基づく。",
        "asOf": "2026-10-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "基幹システムとWebサービスを製品群として組み合わせる複合提案ができること、業種別に特化したパッケージのバリエーションと豊富な導入事例を持つこと、販売後も保守・運用サポートを自社で継続提供するストック型の体制を持つことが、他社との違いとして読み取れます。",
        "basis": "事業の内容におけるCROSS-OVER戦略と業種別パッケージ、保守・運用サポートの記述と、関連情報の製品及びサービスごとの情報に基づく。",
        "asOf": "2026-10-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "単一セグメントで、2026年7月期の製品及びサービスごとの外部顧客への売上高は、システムソリューション事業が18,409百万円、Webソリューション事業が2,479百万円です。連結子会社はファッション業向けシステムの株式会社ウェブベース1社で、従業員数は1,076名です。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の製品及びサービスごとの情報、関係会社の状況、連結経営指標等の従業員数に基づく。",
        "asOf": "2026-10-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
