  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「良品づくり」を基礎とした新たな価値・市場への挑戦をテーマとする中期経営計画（2026年3月期から2030年3月期）を策定し、販売戦略、コスト戦略、サステナビリティ戦略、財務戦略の4つを基本戦略としています。販売戦略では、冷凍事業の拡大や生協向けの宅配弁当、カフェチェーン向け商品など販売領域の拡大と新規市場の開拓を進めます。コスト戦略では、主要食材の調達方法の見直しや機械化・省人化、DXの推進による原価低減に取り組みます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "定温・チルド・冷凍の3温度帯にわたる幅広い製品ラインナップを強みとし、「手作り感」「出来立て感」を重視した商品づくりと、食材や製法にこだわった商品リニューアル、内製化の推進による差別化を進めています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高61,974百万円は、すべて国内の販売によるものです。品目別では弁当類が21,291百万円で最も大きく、おにぎり類が18,873百万円で続きます。主な相手先である株式会社ファミリーマートへの販売が全体の47.4％を占めており、一つの相手先への販売の比重が大きい構成です。",
        "basis": "セグメント情報等における単一セグメントの開示、関連情報の地域ごとの情報、及び経営成績等の状況の概要に記載された販売実績と主な相手先別の販売実績の割合に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
