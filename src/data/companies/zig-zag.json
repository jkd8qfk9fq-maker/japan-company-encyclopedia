  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期の成長戦略として、国内ECサイトへのサービス浸透、海外カスタマーとECサイトを繋ぐバリューチェーンに沿った機能拡充、業務オペレーションのスケール化とテクノロジーを活用した最適化・効率化、海外ECサイトへの展開やエンタメ・ホビー商材の強化によるターゲット市場の拡大を掲げています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ECサイトにJavaScriptタグを１行追加するだけで最短１日で越境対応が始められる導入の容易さと、ECサイトと正式に契約した公認サービスとしてECサイト内で購入が完結する体験を持っています。",
        "basis": "【事業の内容】に、ECサイト側は当社が発行するJavaScriptタグを１行追加するだけで導入でき最短１日で世界228の国と地域への販売が可能になること、「WorldShoppingBIZ」はECサイトと正式に契約を締結している公認サービスであることが印字されています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
