  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業価値は来店した顧客が感じる「驚き」と「感動」で決まるという考えのもと、「良いものを安く、早く、清潔に、最高の雰囲気で」という「お客様への四つの誓い」を基本理念としています。中長期の経営戦略として、消費者のニーズに対応した形で付加価値を高めるとともに店舗オペレーションの効率化を推進し、来客数の向上と店舗の収益基盤の強化を進めるとしています。対処すべき課題として、小型店舗の新規出店の促進や既存の大型店舗における複数ブランドの展開による小型店舗化、既存店舗の業態転換、テーブルオーダーシステム等のシステム改善、プライベートブランド商品の拡大とセントラルキッチンにおける開発強化による小売りルートの開拓などを掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "大型の居酒屋中心だった店舗構成から、大衆食堂「てんぐ大ホール」が店舗数で最大の業態になるなど、昼間需要も取り込む小型・食堂型の業態へ転換を進めている点が読み取れます。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に業態別の店舗数が印字され、対処すべき課題に既存店舗の業態転換や小型店舗化が印字されていることから読み取れます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "埼玉県日高市のセントラルキッチンで食材の加工を内製化していることと、居酒屋から食堂まで時間帯や客層の異なる７業態を使い分ける店舗ポートフォリオを持っている点が特徴です。",
        "basis": "事業の内容に７業態の店舗運営が印字され、生産実績にセントラルキッチンにおける品目別の製造が印字されていることから読み取れます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外食産業の単一セグメントで、2026年３月期の売上高は12,093百万円、2026年３月期末の店舗数は102店舗です。地域別では東京都内の店舗が59店舗と最も多く、首都圏を中心に店舗を展開しています。",
        "basis": "セグメント情報に単一セグメントである旨が印字され、主要な設備の状況に地域別の店舗数が印字されていることから読み取れます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
