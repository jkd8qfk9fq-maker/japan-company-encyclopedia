  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、物流テクノロジーを駆使した3PL物流の推進、海外ネットワークの拡充とグローバルな業務の強化、所有不動産等の活用による不動産関連事業の拡大を掲げています。具体策として、情報収集力とDX化の強化による提案型の営業力向上、教育研修の充実による社員の成長と能力の底上げ、災害やサイバー攻撃への予防体制と対応力を高める経営体制の強化に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "名古屋港地区をはじめとする倉庫・物流施設を自社保有し、荷役・運送を担う連結子会社と一体で、保管から港湾荷役、陸上運送、通関、国際輸送までを一貫して提供できる体制を持ちます。中国・タイ・米国の現地法人が海外ネットワークを形成し、認定通関業者や特定保税承認者の認定、トランクルームや書類保管センターなどの専門サービスも備えています。",
        "basis": "【事業の内容】の事業区分と事業の系統図、【沿革】の海外展開と子会社の変遷、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント別概況に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結営業収益30,161百万円の内訳は、物流事業29,545百万円、不動産事業615百万円です。物流事業の内訳は陸上運送業11,654百万円、倉庫業7,320百万円、港湾運送業3,127百万円、その他7,442百万円で、主要顧客のユニリーバ・ジャパン株式会社向けが3,384百万円と全体の11.2％を占めます。",
        "basis": "セグメント情報の外部顧客への営業収益と【関連情報】の主要な顧客ごとの情報、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント毎の営業収益内訳に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
