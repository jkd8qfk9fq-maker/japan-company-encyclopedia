  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「信用・奉仕・地域社会に貢献」を柱に掲げ、働き方、市場動向、ライフスタイルの変化を的確に捉え、事業ポートフォリオの見直しを通じて経営資源を最適に配分し、採算性の向上と収益基盤の強化に努めるとしています。また、デジタル技術の活用とDXの推進により、業務効率化と顧客体験価値の向上を図るとしています。",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "サマンサタバサグループでは、店舗・ブランドの効率化をはじめとする抜本的な構造改革に着手し、主力のファッション事業では、軽装化・カジュアル化への対応や新規顧客層の獲得に取り組む方針が示されています。",
        "basis": "MD&A（経営成績等の状況の概況）におけるファッション事業とサマンサタバサグループの取り組みの記載",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当社411店舗、グループ全体607店舗の店舗網を持ち、SPAを採用した「SUIT SELECT」やオーダー専門店「DIFFERENCE」など複数の業態を展開しています。冷感技術に注目した機能性シャツなど、素材技術を用いた商品開発も行っています。",
        "basis": "MD&Aの店舗数と商品の記載、【沿革】における新業態の記載",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年9月期の売上高の内訳は、ファッション事業が52,310百万円、フードサービス事業が2,161百万円、教育事業が1,015百万円で、ファッション事業が全体の大半を占めています。ファッション事業の商品別では重衣料が22,463百万円、服飾雑貨が14,421百万円、軽衣料が9,753百万円、中衣料が4,920百万円です。本邦の外部顧客への売上高が連結売上高の90％を超えており、売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と収益の分解情報、【関連情報】の地域ごとの情報と主要な顧客ごとの情報",
        "asOf": "2025-12-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
