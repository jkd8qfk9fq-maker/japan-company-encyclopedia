  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度からの5ヵ年を「構造改革」期とする新中期経営計画を策定し、「稼ぐ力の再構築 2.0」「筋肉質な経営基盤の構築」「無形資産（知的財産・人財）の戦略的活用」の3つの事業戦略を掲げています。高度情報化（デジタル）領域や環境調和（グリーン）領域などの次世代成長市場で、営業が捉えた潜在ニーズを研究開発につなぎ、高付加価値製品の早期事業化を進めることで、ファインケミカル主導の事業構造への転換を目指しています。2030年の経営ビジョンとして「Be the best SPICE!」を掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "前中期経営計画の最終年度にあたる2026年3月期には、堺工場の閉鎖を決定するなど生産拠点の集約を進める一方、樹脂成型の生産効率向上に寄与する「RiKACRYSTA®」の自動車部品での採用や、バイオマス由来原料を使った「RiKANATURA®シリーズ」「グリーンサイザー®シリーズ」といった新製品の開発・市場展開を進めています。",
        "basis": "MD&Aの経営成績等の状況の概要（中期経営計画の取組、主要製品の概況）",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "天然油脂と石油化学という2つの原料系統の製品群を持ち、当社と国内子会社の工場に加え、マレーシアと台湾の持分法適用関連会社でも製造する体制を備えています。1919年の創業以来、油脂を原料とする製品づくりを続けてきました。",
        "basis": "【事業の内容】の製品と製造・販売の役割分担、【関係会社の状況】の製造拠点、【沿革】の創業",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の地域別売上高は、日本が27,500百万円と全体の8割超を占め、アジア・オセアニアが3,468百万円、欧州が740百万円、米州が395百万円です。同連結会計年度は、外部顧客への売上高の10％以上を占める相手先はありませんでした。",
        "basis": "セグメント関連情報の地域ごとの情報（売上高）及び主要な顧客ごとの情報",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
