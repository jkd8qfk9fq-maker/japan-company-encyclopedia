  "history": [
    {
      "year": 1994,
      "title": "中古車買い取り業の会社を福島県郡山市に設立",
      "description": "1994年10月に株式会社ガリバーインターナショナル・コーポレーションを福島県郡山市富田町に、中古車買い取り業を目的として設立しました。",
      "significance": "現在のIDOMの事業の出発点です。1996年4月に商号を株式会社ガリバーインターナショナルに変更しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1998,
      "title": "ドルフィネットシステムの本格運営を開始",
      "description": "1997年9月にドルフィネットシステムを試験的に導入し、1998年2月に本格的な運営を始めました。沿革では、1996年2月にフランチャイズチェーンの拡大に伴って東京本社を開設したことも記されています。",
      "significance": "沿革にはシステムの内容までは書かれていません。1997年の試験導入から約5か月で本格運営に進んだことが分かります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "東京証券取引所市場第二部に上場",
      "description": "2000年12月に東京証券取引所市場第二部に上場しました。2003年8月には市場第一部に指定されています。",
      "significance": "株式を公開した会社になりました。現在の上場先は、表紙に印字された東京証券取引所プライム市場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "米国子会社のGulliver USA, Inc.を設立",
      "description": "2004年11月に全額出資の子会社としてGulliver USA, Inc.を設立しました。",
      "significance": "同社は現在も米国で中古車の売買を行っており、報告セグメント「その他」の事業にあたります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "東京マイカー販売の全株式を取得",
      "description": "2013年11月に東京マイカー販売株式会社の全株式を取得し、完全子会社にしました。",
      "significance": "同社は現在も中古車の売買を行う連結子会社で、当社が100.00％を所有しています（2026年2月28日現在）。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "商号を株式会社IDOMに変更",
      "description": "2016年7月に商号を株式会社IDOMに変更しました。翌8月には、月額定額でクルマを乗り換えられるサービス「NOREL」を始めています。",
      "significance": "ガリバーの名前を冠した会社から、現在の社名になりました。自動車のリースとレンタルは、現在は子会社の株式会社IDOM CaaS Technologyが行っています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "人材紹介の子会社を設立",
      "description": "2025年6月に100％出資の子会社として株式会社IDOM Career Connectionsを設立しました。関係会社の状況によると、設立日は2025年6月23日で、連結の範囲に含まれています。",
      "significance": "同社は人材紹介事業を行っています。報告セグメントは日本とその他の2つで、同社は日本に含まれます。",
      "sourceIds": [
        "yuho-2026"
      ],
