  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「子どもから高齢者まで全世代が繋がり、お互いを支え合う地域づくりに貢献する」をパーパスとし、「少子高齢化社会の課題に挑戦し、地域社会を明るく元気にする」をミッションとしています。医薬、子育て支援、介護の3事業の連携により「地域包括ケアシステム」を推進し、中期経営計画（2025年3月期から2027年3月期）では国の2大福祉政策である「子育て支援」と「高齢者支援」を地域に展開することを基本方針としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "3事業を同じ地域で組み合わせる展開を続けており、サービス付き高齢者向け住宅にクリニックや薬局を併設した複合拠点（ミアヘルサオアシス和光、ミアヘルサケアヴィレッジひばりが丘）を開設してきました。2023年8月には流山市にホスピス対応型ホーム（定員61名）を開設し、高齢者支援の受け皿を広げています。",
        "basis": "経営方針（中長期的な会社の経営戦略）、沿革、事業の内容に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "調剤薬局、保育、介護の3事業を1つのグループで持ち、サービス付き高齢者向け住宅や団地再生の拠点にクリニックと薬局を併設して、住まい・医療・介護を一体で提供できることが特徴です。首都圏に拠点を集中させることで、地域ごとに複数のサービスを組み合わせる展開をしています。",
        "basis": "事業の内容、経営方針（中長期的な会社の経営戦略）、沿革に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上の中心は子育て支援事業（10,294百万円）と医薬事業（9,947百万円）で、介護事業（3,538百万円）が続きます。いずれも対価の多くが公的保険や自治体の給付・補助金に基づく仕組みで、特定の顧客への依存はなく、連結売上高の10％以上を占める相手先はありません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報（主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
