  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2025年５月期～2027年５月期）を推進し、基本方針「エンパワーメントの促進とイノベーションの醸成」に基づき、事業基盤の強化、新たな顧客獲得による事業規模拡大、ソリューションの拡充による市場拡大、新たなビジネス機会の創出に向けた提案力の強化、社会課題を起点としたビジネスの創出の５つの戦略に取り組んでいます。2030年５月期における目指す姿として「『人を想う』事業やサービスを通じて社会的課題を解決し、人や社会、未来に貢献する企業グループ」を掲げています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ServiceNowについてコンサルティングから導入・運用までを一貫して提供できること、オラクル社のクラウド基盤「Oracle Cloud Infrastructure」やクラウド型ERP「Oracle NetSuite」「Oracle Fusion Applications」に強みを有すること、DX診断からデータ分析やシステム開発までを一気通貫でリードできることが強みです。",
        "basis": "【事業の内容】に、ServiceNowに関するコンサルティング・導入・運用までをend to endでサービス提供すること、オラクル社のクラウドとクラウド型ERPに強みを有すること、DXコンサルティングで診断から具体的な解決策までを一気通貫でリードできることが強みである旨が印字されています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年５月期の売上高のうち、株式会社NTTデータ向けが21.1％、株式会社NTTデータグループ向けが11.2％、株式会社野村総合研究所向けが10.4％を占めており、大手SI事業者をはじめとする特定の顧客との取引が売上の中心となっています。2011年には株式会社エヌ・ティ・ティ・データのビジネスパートナー認定を受けています。",
        "basis": "MD&Aの相手先別売上高と【セグメント情報等】の主要な顧客ごとの情報に、３社向けの売上高と総売上高に対する割合が印字されています。また【沿革】に、2011年に株式会社エヌ・ティ・ティ・データのビジネスパートナー認定を受けたことが印字されています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
