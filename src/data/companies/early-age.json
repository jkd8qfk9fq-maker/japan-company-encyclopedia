  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "自社所有物件やサブリース物件の賃貸運営を行う運営管理事業を中核事業として安定的かつ持続的に成長することを目指し、賃貸市場の二極化に備えて都心部に焦点を合わせた開発を行うとしています。経営方針として徹底したお客様中心主義を掲げています。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "運営管理事業の仲介活動を通じて入居希望者の多様なニーズや賃料の傾向を把握でき、その情報を企画開発に生かせる点と、自社所有やサブリースによるストック型の運営管理が売上の大半を占める点が強みです。",
        "basis": "事業の内容に、仲介活動がユーザーのニーズや賃料傾向を把握する重要な役割を担うと印字されていること、運営管理事業の外部顧客への売上高2,880百万円が連結売上高3,289百万円の大半を占めることに基づきます。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主たる事業エリアである都心部では、人口の転入超過を背景に住宅賃料が上昇基調で需要は底堅い一方、不動産価格の高騰や建築コストの増加、金利上昇が懸念される環境で事業を行う不動産会社です。",
        "basis": "経営環境として、都心部での人口転入超過と住宅賃料の上昇基調、不動産価格の高騰や建築資材の供給制約に伴う建築コストの増加、金利上昇への懸念が印字されていることに基づきます。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
