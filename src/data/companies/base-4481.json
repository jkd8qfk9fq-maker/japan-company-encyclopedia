  "businesses": [
    {
      "id": "system-development",
      "name": "システム開発",
      "description": "金融・流通・製造分野におけるオープン系システム開発を、要件定義から基本設計、詳細設計、プログラム設計、プログラミング、各種テスト、移行・リリース作業、サービス開始後の運用保守までトータルで提供するサービスラインです。証券、銀行、クレジットカード会社など金融系のシステム開発に実績があります。顧客の新規システム又は既存システムの運用保守（顧客先への常駐を含む）と、システム開発に付随する社員支援（顧客先への派遣）も行います。中国の連結子会社である貝斯（無錫）信息系統有限公司とともに、日本人技術者と中国人技術者が協働する体制を整えています。",
      "customers": [
        "証券、銀行、クレジットカード会社などの金融機関",
        "流通・製造分野の企業",
        "富士通株式会社、株式会社野村総合研究所などの大手ＳＩｅｒ"
      ],
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "solution",
      "name": "ソリューション",
      "description": "ＥＲＰ関連のソリューションを対象とし、高いシェアを占めるＳＡＰ ＳＥの製品を中心に、ＥＲＰ、ＣＲＭ、ＢＡＳＩＳの３領域でサービスを提供するサービスラインです。新規導入案件やアップグレード、マイグレーション案件において、導入コンサルティングから開発・運用保守まで幅広く対応します。ＳＡＰ ＳＥ以外のソリューション製品についてもサービス提供を行っています。",
      "customers": [
        "ＥＲＰを導入・刷新する企業"
