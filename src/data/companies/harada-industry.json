  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期の目指す姿として、車載アンテナのトップ企業であり続け、CASE（コネクテッド、自動運転、シェアリング、電動化）及びモビリティの多様化に積極的に対応し、周辺事業・新規事業を拡大させて収益基盤を確立するとしています。足元では、CASEへの対応等によるトップラインの拡大、コスト構造改革によるコスト体質の強靭化、B/Sのスリム化を進める収益構造改革に集中して取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "地域別の外部売上高では日本が185億37百万円と最も大きく、北中米、アジア、欧州が続き、販売と生産を4地域に広げた体制で自動車メーカーに製品を届けています。研究開発は日本、独国、米国、中国（上海）の部門が連携する体制で進められています。",
        "basis": "セグメント情報における地域別の外部顧客への売上高、研究開発活動における研究開発部門の設置地域の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自動車ラジオ用アンテナを中心に、ポールタイプやシャークフィンタイプなど形状の異なるアンテナ、中継ケーブル、アンプ類まで自動車関連機器を幅広くそろえています。同軸ケーブルを自社でつくる強みを活かした軽量同軸ケーブルや、高速データ伝送ケーブルの開発と量産も進めています。",
        "basis": "事業の内容における主要製品の記載、研究開発活動における同軸ケーブル内製の強みと高速データ伝送ケーブルの記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "自動車関連機器の単一の事業を地域別に展開する会社で、外部売上高は日本185億37百万円、北中米123億43百万円、アジア68億45百万円、欧州44億66百万円の順です。主要な顧客ごとの情報に印字される顧客はトヨタ自動車株式会社で、日本セグメントに関連しています。",
        "basis": "セグメント情報における地域別の外部顧客への売上高、関連情報における主要な顧客ごとの情報、事業の内容における事業区分の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
