  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "人的投資の拡大を起点として事業を拡大する方針で、採用活動への投資や給与水準の向上などの人的投資を継続的に強化してコンサルティング体制を増強し、顧客の需要を取り込むことで収益の拡大と継続的な企業価値の向上を目指しています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンサルタントが顧客先に常駐して実務の実行まで担う提供形態と、計数系の業務から人事制度やシステム導入までＣＦＯ領域全般をカバーする幅広さが強みです。",
        "basis": "事業の内容に、常駐型の実務実行支援という形でサービスを提供することが当社の特徴であると印字され、予実管理体制構築支援から人事制度構築支援、システム導入支援までＣＦＯ領域全般のコンサルティングを提供すると印字されているため。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "独立系のコンサルティングファームとして、国内に加えてベトナムやフィリピンなどアジア各国の子会社を持ち、日本企業の東南アジア進出支援まで手がける位置にあります。",
        "basis": "関係会社の状況にベトナム・フィリピンの連結子会社が印字され、事業の内容に海外進出支援コンサルティングサービスがサービス区分として印字されているため。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
