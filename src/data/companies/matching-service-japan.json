  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "設立以来関わってきた士業と企業の管理部門の領域で蓄積したデータベースとネットワークを活用し、人材関連事業に限らず同領域の人々の課題解決となるサービスを提供することを基本方針としています。人材サービスでは「MS Career」へのプラットフォーム統合を進め、蓄積データの利活用やAI技術によるマッチング精度の向上を図り、メディアでは「Manegy（マネジー）」の利用者資産を人材サービスへ誘導する相互連携を進めています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "管理部門職種と士業への専門特化により、求職者側と企業側の双方の専門的なニーズを細部まで把握する仕組みを持っています。新規登録者の獲得ではコンテンツマーケティングによる自社独自のルートを確立し、他社の人材データベースを通じたスカウトに依存しない運営を行っています。",
        "basis": "【事業の内容】に、人材紹介事業は特定領域への専門特化が特徴であること、キャリアカウンセラーとリクルーティングアドバイザーが同業界の知識を蓄積しやすい環境を整えていること、コンテンツマーケティングにより他社の人材データベースを通じたスカウト等に依存しない自社独自の登録者獲得ルートを確立していることが印字されています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高構成では、人材紹介売上高が4,294百万円と最も大きく、海外人材売上高が3,002百万円、メディア売上高が248百万円、DRM売上高が101百万円と続いています。地域別では日本が4,644百万円、オーストラリアが3,002百万円です。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の販売実績に、2026年3月期の人材紹介売上高4,294,835千円、海外人材売上高3,002,752千円、メディア売上高248,024千円、DRM売上高101,716千円が印字され、【セグメント情報等】の地域ごとの情報に日本4,644,576千円、オーストラリア3,002,752千円が印字されています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
