  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「『安心』・『安全』・『快適』をお届けすることで、お客様の豊かな暮らしを実現し、地域社会に貢献します」を掲げ、2030年度時点における“あるべき企業像”を示した長期経営ビジョン「神鉄グループみらいビジョン2030」（『暮らしに彩を添える地域の共創プラットフォーム』）を策定しています。その実行計画である「中期経営計画2026」（2023～2026年度）では、コロナ禍により落ち込んだ「収益力」をコロナ禍前の水準に回復させるとともに「財務の健全性」を着実に進展させることとし、事業戦略として、新しい時代に対応した収益構造の構築、沿線活性化、成長投資・新規投資による収益拡大、ステークホルダーへの貢献・還元を掲げています。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は、運輸業の外部顧客への営業収益が14,037百万円と連結営業収益の約6割を占め、2025年1月に実施した運賃改定の寄与や旅客人員の回復により増収となりました。中期経営計画が掲げる収益力の回復は、最大事業である運輸業の増収が牽引する形で進んでいます。",
        "basis": "セグメント情報の外部顧客への営業収益と、MD&Aの経営成績の状況の概要に基づく。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "鉄道・バス・タクシーをグループで一体的に運営し、沿線の移動手段を面的に担っている点が特徴です。加えて、食品スーパーや駅近接の保育・健康施設など沿線の生活サービスをグループで展開し、神戸市との連携事業による駅周辺の活性化など、沿線価値の向上と一体となった事業運営を行っています。",
        "basis": "事業の内容と、MD&Aの経営成績の状況の概要に基づく。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "神戸市北部から三田・有馬方面を結ぶ地域鉄道事業者で、営業キロは69.6キロ、2026年3月期の旅客人員は56,033千人でした。外部顧客への営業収益の10％以上を占める顧客はなく、不特定多数の利用客との取引で構成されています。",
        "basis": "MD&Aの提出会社の運輸成績と、セグメント情報の関連情報（主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
