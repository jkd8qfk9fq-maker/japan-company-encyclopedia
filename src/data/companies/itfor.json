  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンとしてFY2033構想「HIGH FIVE 2033」を掲げ、現在の事業基盤を活用して新しい領域へ展開し、地域内で経済が循環する「地域還流型ビジネス」を生み出す企業を目指しています。その実現に向け、2024年度から2026年度までの第４次中期経営計画「FLY ON 2026」では、既存事業を力強く発展させるとともに新規事業で飛躍的に成長するというテーマのもと、「事業戦略」「人財戦略」「企業価値向上戦略」の３つの戦略を掲げています。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "金融領域では、銀行本体に導入したシステムを系列のカード会社・リース会社・保証会社等へ横展開するグループ展開を進めています。公共分野では自治体情報システムの標準化への対応案件が拡大し、あわせて既存システムへのAI実装や、督促自動化サービス「Payコレクト」などの次世代プロダクトの投入、出資先の技術を取り込むエコシステムの拡張を進めています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "専門特化した独自ソリューションと外部パートナーとのエコシステム構築により、高い参入壁と成長性を両立させていると会社は説明しています。金融機関との強固な信頼関係を背景に、顧客の業務プロセスを深く理解するドメイン知識を活かした提案を行い、銀行本体での実績を系列会社へ展開する基盤を持っています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高ではシステム開発・販売が13,671百万円で売上高の59.2％、リカーリングが9,429百万円で40.8％を占めています。地域別の売上高の開示はなく、外部顧客への売上高の10％以上を占める主要な顧客もありません。",
        "basis": "セグメント情報等の外部顧客への売上高、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-12",
        "sourceIds": [
