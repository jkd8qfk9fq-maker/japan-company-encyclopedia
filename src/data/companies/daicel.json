  "history": [
    {
      "year": 1919,
      "title": "大日本セルロイド㈱として創立",
      "description": "1919年9月、大日本セルロイド株式会社として創立されました。",
      "significance": "現在のダイセルの出発点です。社名はのちに何度か変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1934,
      "title": "写真フィルム部を分離し、富士写真フイルム㈱を設立",
      "description": "1934年1月、写真フィルム部を分離して富士写真フイルム㈱（現 富士フイルムホールディングス㈱）を設立しました。",
      "significance": "セルロイドから始まった事業の一部が、別会社として独立しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1935,
      "title": "新井工場を設置し、有機合成事業を開始",
      "description": "1935年9月、新井工場（新潟県）を設置し、有機合成事業を始めました。",
      "significance": "化学品をつくる事業の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に上場",
      "description": "1949年5月、東京証券取引所に上場しました。",
      "significance": "上場会社としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1951,
      "title": "網干工場で酢酸セルロース事業を開始",
      "description": "1951年6月、網干工場（兵庫県、現 姫路製造所網干工場）で酢酸セルロース事業を始めました。1958年にはアセテート・トウの製造も始めています。",
      "significance": "現在のマテリアル事業で扱う酢酸セルロースやアセテート・トウの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "ポリプラスチックス㈱を米国Celanese Corporationとの合弁で設立",
      "description": "1964年5月、米国Celanese Corporationとの合弁会社としてポリプラスチックス㈱を設立し、ポリアセタール樹脂などの製造・販売を始めました。2020年10月に完全子会社になっています。",
      "significance": "現在のエンジニアリングプラスチック事業の中心となる会社の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1968,
      "title": "大日本化成㈱を吸収合併し、大竹工場とする",
      "description": "1968年6月、石油系有機合成事業を担っていた大日本化成㈱（1961年設立）を吸収合併し、その工場を大竹工場（広島県）としました。",
      "significance": "石油を原料とする有機合成の事業が本体に加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1977,
      "title": "協同酢酸㈱を合弁で設立",
      "description": "1977年7月、協同酢酸㈱を合弁会社として設立し、メタノール法による酢酸の製造を始めました。",
      "significance": "現在のマテリアル事業の酢酸を担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "ダイセル・セイフティ・システムズ㈱を設立",
      "description": "1988年10月、自動車エアバッグ用インフレータの製造を行うダイセル・セイフティ・システムズ㈱を設立しました。",
      "significance": "現在のセイフティ事業の出発点です。のちに米国・タイ・ポーランド・中国・インドにも拠点を設けました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1990,
      "title": "米国にChiral Technologies, Inc.を設立",
      "description": "1990年11月、米国にChiral Technologies, Inc.を設立し、光学異性体分離カラムの販売を始めました。",
      "significance": "現在のメディカル・ヘルスケア事業の光学異性体分離カラムを海外で売る拠点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "商号を株式会社ダイセルに変更",
      "description": "2011年10月、商号を株式会社ダイセルと改めました。1966年にダイセル株式会社、1979年にダイセル化学工業株式会社と改称したのち、現在の社名になりました。",
      "significance": "現在の社名になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "ポリプラスチックス㈱を完全子会社化",
      "description": "2020年10月、ポリプラスチックス㈱を完全子会社にしました。同年7月にはダイセルミライズ㈱が営業を始め、樹脂事業を再編しています。",
      "significance": "エンジニアリングプラスチック事業の経営を一体で進める体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "ダイセルビヨンド㈱が操業を開始",
      "description": "2022年10月、高機能フィルムの製造・加工を行うダイセルビヨンド㈱が操業を始めました。",
      "significance": "現在のスマート事業のうち、高機能フィルムを担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "ポリプラスチックス㈱の全事業を承継",
      "description": "2026年4月1日付で、ポリプラスチックス㈱の全事業（子会社・関連会社の株式の保有・管理事業を除く）を事業承継しました。同社は同日付で持株管理会社となり、商号をHPPホールディングス㈱へ変更しました。",
      "significance": "エンジニアリングプラスチックの事業を、ダイセル本体が直接担う形に変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
