  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な企業価値の向上を図るべく、今後の業績拡大が期待できるヘルスケア事業および学校ＤＸ事業に積極的に取り組んでいます。会社の対処すべき課題として、ＡＩ等の最新技術を活用した付加価値の高いソリューションやサービスへの活用、開発体制の整備と情報セキュリティの強化、グループ内シナジーの最大化を通じた新たなお客様開拓と付加価値創出、人材に対する投資と働き方改革の推進を掲げています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の過半をコンテンツ事業が占める一方、ヘルスケア事業と学校ＤＸ事業の売上高が伸びており、会社が注力分野と位置づける2事業の売上構成比が高まっています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンテンツ事業の有料会員数は2025年9月末時点で324万人に達し、キャリアショップ経由での入会など、通信事業者の販売経路を通じた会員獲得の仕組みを持っています。ヘルスケア事業ではクラウド薬歴の導入店舗数が2025年9月末時点で3,811店舗に広がっており、調剤薬局との継続的な取引基盤が育っています。",
        "basis": "MD&Aの経営成績の概要、事業の内容の記述に基づく",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客ごとの情報では、2025年9月期の株式会社ＮＴＴドコモへの販売が売上高の33.6％、ＫＤＤＩ株式会社への販売が12.7％を占めており、大手通信事業者との取引が事業の基盤になっています。両社とは情報提供サービスへのコンテンツ提供等に関する契約も継続しています。",
        "basis": "関連情報の主要な顧客ごとの情報、重要な契約等、MD&Aの販売実績に基づく",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
