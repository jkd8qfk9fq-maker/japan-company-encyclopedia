  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "理念「全国、全ての中小企業を黒字にする」に基づき、インターネット関連技術を活用した総合的な経営支援を展開するとしています。ＡＩソリューション事業では、主力サービスの実績を基盤に、ＡＩ活用研修、ＡＩエージェントパッケージ、ＡＩ　ＳａａＳ、ＡＩ運用代行（ＢＰＯ）、ＡＩ開発支援の5つの領域を中心に、人材育成から業務自動化、運用定着までを一貫して支援する新たな経営支援サービスの開発と提供を進めるとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、Ｊコンサル・Ｊシステム・ＪＤネットの主力3サービスから、ＡＩ領域の新サービスへ収益源を広げることです。2026年3月期はＡＩ領域サービスの受注が拡大した一方、主力サービスの売上が想定を下回り、連結子会社ＡＫＡＲＩの業績も低調で、グループ全体では減収となりました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のＡＩソリューション事業の記述と【事業の内容】のサービス構成の記述",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、ＤＸ化・ＡＩ化のサービス導入と、その資金負担を軽くするための資金確保策を併せて提案できることです。各専門領域の士業と連携して政府や地方自治体等の公的支援制度の活用を案内するため、資金に余裕のない中小・零細企業でも経営課題の解決に取り組みやすくしています。",
        "basis": "【事業の内容】のＪコンサルの強みの記述",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
