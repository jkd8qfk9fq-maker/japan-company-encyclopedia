  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ユーザーの要求する性能の製品を、タイミング良く、適切な価格で提供することを目指し、社是である「挑戦」のもとで多角的・グローバルな事業展開を積極的に行います。2023年2月13日に発表した「タツモグループ中期経営計画（TAZMO Vision 2025）」に基づき事業を展開してきました。半導体製造装置と搬送機器のプロセス機器事業を主体にしつつ、株式会社ファシリティと株式会社クォークテクノロジーの技術や設備を活用して半導体製造装置の共同開発とシナジー効果による成長を目指し、事業を見据えた研究開発に焦点を絞ります。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は前年同期比1.2％減の354億28百万円でした。生成AIに関連したサーバーへの設備投資が拡大し、アドバンスドパッケージ向けの半導体装置の需要が市場をけん引したと説明されています。",
        "basis": "MD&Aの経営成績の概要、セグメント情報（外部顧客への売上高）",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "研究開発はプロセス機器事業を中心に、塗布装置、先端パッケージ向け装置、枚葉洗浄装置などの半導体プロセス装置と、新規ウェーハ搬送機構やナノインプリント関連装置の開発を行っています。半導体事業と液晶から培ったコア技術を基盤に製造装置の開発を続け、ベトナムなど海外子会社の生産体制も活用しています。",
        "basis": "研究開発活動、事業の内容、経営方針、経営環境及び対処すべき課題等",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはプロセス機器事業（外部顧客への売上高27,475百万円）、表面処理用機器事業（同6,754百万円）、金型・樹脂成形事業（同1,198百万円）の3つです。地域ごとの売上高は日本17,015百万円、台湾12,929百万円、中国1,628百万円などです。主要な顧客ごとの情報では、Taiwan Semiconductor Manufacturing Co Ltdへの売上高10,918百万円がプロセス機器事業として印字されています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
