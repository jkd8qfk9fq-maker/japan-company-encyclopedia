  "businesses": [
    {
      "id": "tazmo",
      "name": "タツモ株式会社",
      "description": "岡山県岡山市北区に本社を置く製造装置メーカーで、連結子会社13社と持分法適用関連会社1社とグループを構成しています。報告セグメントはプロセス機器事業、表面処理用機器事業、金型・樹脂成形事業の3つで、2025年12月期の連結従業員数は1,150人です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "process-equipment",
          "name": "プロセス機器事業",
          "description": "半導体や液晶ディスプレイなどの電子デバイス製造プロセス機器とその周辺機器類の開発、製造、販売、メンテナンスを行う事業です。半導体装置部門では塗布装置、現像装置、先端パッケージ向け装置を扱い、主力製品は各種ウェーハに対応したウェーハ・サポート・システムです。搬送装置部門では半導体製造工程間でウェーハを搬送する産業用ロボットとそのユニットを、洗浄装置部門では枚葉式洗浄装置やバッチ式浸漬洗浄装置を、コーター部門ではTFTカラー液晶ディスプレイ向けカラーフィルター製造装置を扱います。2025年12月期の外部顧客への売上高は27,475百万円です。",
          "customers": [
            "国内外の半導体メーカーや研究機関",
            "半導体製造装置メーカー",
            "国内外のカラーフィルターメーカーや液晶デバイスメーカー"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "surface-treatment-equipment",
          "name": "表面処理用機器事業",
          "description": "プリント基板製造装置の製造・販売を行う事業です。主な製品はメッキ処理装置と回路形成装置です。連結子会社である株式会社ファシリティの子会社が製造し、富萊得(香港)有限公司を通じて中国国内やその他の国へ納入し、日本国内は株式会社ファシリティを通じて納入しています。2025年12月期の外部顧客への売上高は6,754百万円です。",
          "customers": [
            "プリント基板メーカー"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "mold-resin",
          "name": "金型・樹脂成形事業",
          "description": "樹脂成形用精密金型と樹脂成形品の製造、販売を行う事業です。主な樹脂成形品は電子機器向けコネクター類とエンボスキャリアテープです。子会社のプレテック株式会社が金型・樹脂成形品の製造を行い、当社が主として国内における販売を行い、海外では上海龍雲精密機械有限公司が樹脂成形品の製造・販売を行っています。2025年12月期の外部顧客への売上高は1,198百万円です。",
          "customers": [
            "電子機器向けコネクター類やエンボスキャリアテープの需要家"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        }
