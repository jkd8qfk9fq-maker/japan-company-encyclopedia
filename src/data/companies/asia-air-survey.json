  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン2033では、ミッションを「空間情報技術で社会をつなぎ、地球の未来を創造する」と定めています。その第1フェーズである中期経営計画2026では「事業ポートフォリオ経営の確立」と「多様な人財が集まる企業グループの形成」をテーマに、サステナブル経営とAAS-DXの思想を土台として、事業戦略と企業マネジメント戦略の両輪で取り組んでいます。",
        "asOf": "2025-12-17",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "中期経営計画2026の2年目にあたり、人的資本への投資とAAS-DXの推進に注力しながら、上下水道などインフラの老朽化への対応として、AIスタートアップ企業とともに水道GISと連携した音声漏水検知AIの共同開発に着手し、下水処理場での点検ロボットの実証や、上下水道の設計・維持管理を行う会社の子会社化を進めたことが読み取れます。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概況",
        "asOf": "2025-12-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1954年の設立以来、航空機使用事業の免許を受けて自社運航を行い、航空測量を起点に空間情報技術を蓄積してきたことと、各地の連結子会社が測量・調査作業等を受委託する体制を持つことが読み取れます。",
        "basis": "事業の内容、沿革、関係会社の状況",
        "asOf": "2025-12-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年9月期の売上高41,591百万円の事業区分別の内訳は、社会インフラマネジメント事業が25,222百万円、国土保全コンサルタント事業が12,893百万円、その他が3,475百万円です。主要な顧客は中央官庁、地方公共団体及び電力会社等の公益事業体各社で、売上高の10％以上を占める特定の顧客はなく、本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "事業の内容、セグメント情報等の関連情報、経営者による分析の受注及び販売の実績",
        "asOf": "2025-12-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
