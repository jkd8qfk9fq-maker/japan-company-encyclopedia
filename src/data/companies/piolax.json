  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2025～2027年度）に基づき、「自動車生産台数だけに頼らない経営推進」という方針を掲げ、需要変動下でも安定的に収益を確保できる組織構造への転換を最優先課題としています。商品戦略では金属・樹脂の高度な複合成形技術を活かした高付加価値品の創出、地域・顧客戦略では北米・中国・インドを重点地域として日系に加えて海外の自動車メーカーへの拡販、収益構造改革による収益力の改善を進めます。医療機器事業では、低侵襲治療を目指す製品の開発・製造・販売を通じて事業拡大を図ります。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1933年の創業以来のばね製造を起点に、金属と樹脂の両方に精通した独自の製品開発と製造技術を強みとし、金属・樹脂の高度な複合成形技術を活かした製品を自動車メーカーに供給しています。医療機器事業にも、自動車部品の開発で培った金属加工技術を活かしています。",
        "basis": "経営方針における企業理念と対処すべき課題（商品戦略）の記述に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高62,045百万円のうち、自動車関連等が56,770百万円、医療機器が5,274百万円です。地域別では日本が26,515百万円、中国が8,034百万円、その他アジアが10,633百万円、米国が9,072百万円です。主要な顧客は日産自動車で、売上高は6,813百万円です。",
        "basis": "セグメント情報における報告セグメントごとの売上高、地域ごとの情報及び主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
