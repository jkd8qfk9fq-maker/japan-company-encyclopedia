  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度から2028年度までの「DMW中期経営計画2028」を策定し、長期的に目指す姿として、技術力とお客様からの信頼を発揮しながら風水力機械で世界の顧客課題に応える“ソリューションリーダー”を掲げています。計画期間をその実現に向けた基盤確立フェーズと位置づけ、最重要課題のうち「既存事業領域の収益力強化」と「新規事業領域の拡大」を中心に取り組みます。既存領域では、アルミ合金インペラ採用の多段ターボブロワ「AM-Turbo」や減速機搭載型立軸ポンプ「ラムダ21」など競争優位性の高い製品の戦略的な提案営業と、部品供給・メンテナンスのP&Mビジネスの拡大を進めます。新規領域では、水処理設備用エネルギー回収装置「DeROs-E」の拡販と計画生産体制の確立、海外市場における戦略パートナーシップとネットワークの構築を進めます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "MD&Aの部門区分別の販売実績では、官需部門が18,919百万円と売上高の中心で、国内民需部門が3,820百万円、海外部門が5,449百万円でした。前期と比べると官需部門は減り、国内民需部門と海外部門が増えています。",
        "basis": "MD&Aの部門区分別の販売実績と経営成績の状況の概要に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "海水淡水化や水処理に使うエネルギー回収装置「DeROs」、減速機搭載型立軸ポンプ「ラムダ21」、アルミ合金インペラ採用の多段ターボブロワ「AM-Turbo」など、商標を持つ独自製品を持ちます。製造だけでなく、据付工事と保守・点検を担う子会社と、環境関連機器の子会社、インドの製造子会社をグループ内に持つ体制も特徴です。",
        "basis": "事業の内容の主要取扱製品と関係会社の状況、MD&Aの中期経営計画の取り組みに基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "風水力機器の製造・据付・販売の単一セグメントの会社で、製品別ではポンプが外部顧客への売上高19,355百万円と最も大きく、送風機が続きます。地域別では日本が22,985百万円と中心で、アジア（日本を除く）が4,897百万円です。有形固定資産は日本とインドにあります。",
        "basis": "関連情報の製品及びサービスごとの情報、地域ごとの情報と有形固定資産の内訳に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
