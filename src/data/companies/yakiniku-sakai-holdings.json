  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "既存業態については、日常利用型を前提に「大衆性」と「カジュアル性」を軸として商品、価格及びサービスを一体で再設計し、「大衆外食」をキーワードとしたボリュームゾーン業態としての戦略展開を進める計画です。国内ではM&Aも活用して展開エリアと事業規模の拡大を図り、海外ではフランチャイズチェーン方式でアジア圏を中心に出店を強化し、アメリカなど新たなエリアへの展開も図る計画です。人材の確保と育成の強化、DXによる店舗オペレーションの再構築で「次世代店舗」の確立も目指しています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "焼肉を中心に、寿司、居酒屋、日常食・ファーストフードなど多様な事業を運営する多業態の構成が強みです。直営店に加えてフランチャイズチェーン方式も用いるため、国内の出店と海外展開を併せて進められる体制を持っています。",
        "basis": "事業の内容（業態別の店舗展開の記載）と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（多様な事業を運営する強みと海外店舗数の記載）に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外食業界に属し、報告セグメントは外食事業の単一セグメントです。2026年3月期の総店舗数は448店舗（直営290店舗、フランチャイズ158店舗）で、焼肉事業を中心に寿司事業、居酒屋事業、日常食・ファーストフード事業を展開しています。",
        "basis": "セグメント情報（単一セグメントであることの記載）と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（直営店舗数と総店舗数の記載）に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
