  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度から2028年度までの5か年中期経営計画では、基本方針に「質を追求し、プレゼンスを高める」を掲げ、「コア事業における攻めと挑戦」「電動化に向けたコア商品の進化」「サステナビリティ経営の推進」の3つを骨子として取り組みを進めています。企業スローガンは「製造の先の創造へ。」で、ものづくりを通して人、車、機械を支える力であり続けることをミッションとしています。中期経営計画では、2026年3月期の売上高の目標を2,400億円としていました。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "フレーム、アクスル、建設機械用キャビン、パネルを「コア商品」と位置づけ、現行の生産設備を活用して電動車用の商品も生産できることが強みです。穴あけや成形から塗装までを一貫して行う生産ラインの構築など、技術開発・提案力とものづくり力の追求を掲げています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高202,167百万円のうち、自動車関連事業が166,558百万円と8割以上を占め、建設機械関連事業が32,664百万円、その他が2,943百万円です。地域別では日本が88,043百万円、タイが71,159百万円、米国が20,844百万円、その他が22,120百万円で、海外の売上高が半分を超えています。",
        "basis": "セグメント情報および【関連情報】の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
