  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「OILES 2030 VISION」（サステナブルな社会の実現を、摩擦・摩耗・振動の技術＋Ｘで貢献する）を掲げ、2024年度を起点とする中期経営計画2024-2026に取り組んでいます。中期経営方針は、成長市場への経営資源の集中、業務改革と生産技術の追求による生産性の向上、ステークホルダーへの貢献、資本効率性を意識した財務運営です。事業別では、一般軸受機器は半導体製造装置等の成長分野と再生可能エネルギー市場への戦略製品の展開、自動車軸受機器はEVの普及や自動運転化に対応した製品開発と中国・インドなど成長市場での非日系顧客の開拓、構造機器はインフラリニューアルや都市型データセンター向け大型製品のシェア拡大、建築機器はリニューアル・リフォーム市場への活動強化を掲げています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "トライボロジー（摩擦・摩耗・潤滑）とダンピング（振動制御）の2つの技術を中核に、給油が不要で摩擦や摩耗によるエネルギーロスを抑える自己潤滑性の軸受や、建物の地震対策となる免震・制震装置など、社会の課題に対応する製品群を持ちます。1939年の創設以来オイルレスベアリングを手がけてきた専業メーカーとしての開発と製造の蓄積があり、日本初の免震構造ビルに自社装置が使われた実績もあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の2つのコア技術と製品群の記載、【沿革】の創設と免震装置の開始の記載に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは自動車軸受機器、一般軸受機器、構造機器、建築機器の4区分と、その他の区分で、2026年3月期の外部顧客への売上高は自動車軸受機器34,221百万円、一般軸受機器15,949百万円、構造機器11,235百万円、建築機器5,765百万円、その他1,791百万円です。地域別では日本42,054百万円、アジア16,395百万円（うち中国8,576百万円）、北米6,310百万円、欧州3,638百万円、その他566百万円で、海外向けが全体の39.0％を占めます。売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と、関連情報（地域ごとの情報・主要な顧客ごとの情報）の記載に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
