  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年４月16日開催の取締役会において、株式会社スタイル（ソフトウェア開発を行い、社会インフラ分野に強みを持ち、茨城県を拠点とする）の全株式を取得し完全子会社化することを決議し、株式譲渡契約を締結しています。企業結合日は2026年５月18日、みなし取得日は2026年６月30日（予定）とされており、2026年３月31日現在の体制には含まれない期後の構造変化のため、本登録は2026年３月31日現在の体制に基づきます。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループパーパス「社会とITの未来をともにつなぐ（Connecting people one world）」の下、中期経営方針の3本柱「中核事業の拡大」「次期成長事業の創出」「事業基盤の強化」に取り組んでおり、中期経営計画では営業体制の強化、開発体制の強化、案件対応力の強化、デジタル化（DX）への対応、中長期を見据えた積極的な投資活動による事業基盤の強化を重点取組事項としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点取組事項は、既存のシステム開発・運用という中核事業の対応力強化とDX・クラウドへの対応に集中しており、子会社化のような投資活動も事業基盤の強化の手段として位置づけられています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中期経営方針・重点取組事項と、MD&Aの経営成績の分析に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独立系としてメーカー・ベンダー製品に依存しない中立的な立場から、システムのデザイン・開発・導入・保守まで一貫したサービスを提供できることと、第三者的な立場で業務要件の実現性やシステム品質の妥当性・操作性を検証する「システム検証サービス」を持つことが特徴です。",
        "basis": "【事業の内容】の事業概要と、セグメント関連情報の主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の情報サービス市場では企業のデジタル化（DX）需要が堅調に推移する中、同社は産業・サービス、社会公共・土木建築、情報・通信、金融・証券の4分野に顧客基盤を持ち、主要顧客の株式会社NTTデータ向けの販売実績が総販売実績の17.6％を占めています。",
        "basis": "セグメント関連情報の主要な顧客ごとの情報、【経営方針、経営環境及び対処すべき課題等】の対象分野の記述、MD&Aの市場環境の記述に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
