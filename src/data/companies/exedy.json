  "history": [
    {
      "year": 1923,
      "title": "大阪市生野区で創業",
      "description": "足立一馬が大阪市生野区で個人企業として創業しました。",
      "significance": "現在のエクセディにつながる、いちばん最初の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1950,
      "title": "株式会社大金製作所を設立",
      "description": "大阪市生野区に株式会社大金製作所を設立しました。",
      "significance": "個人企業から会社組織になり、事業を広げる土台ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "大阪証券取引所市場第二部に上場",
      "description": "大阪証券取引所市場第二部に上場しました。同じ年に北海道千歳市に湿式摩擦材をつくる合弁会社を設立し、のちのダイナックスの前身になりました。",
      "significance": "資金調達の道が開け、自動変速装置向けの摩擦材づくりにも踏み出しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1977,
      "title": "米国に販売会社を設立",
      "description": "米国カリフォルニア州に全額出資の販売会社ダイキンクラッチＵ.Ｓ.Ａ.を設立しました（2006年にエクセディグローバルパーツに社名変更）。",
      "significance": "海外で製品を売る体制づくりの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1995,
      "title": "商号をエクセディに変更",
      "description": "商号を株式会社大金製作所から株式会社エクセディに変更しました。同じ1995年には、オーストラリアに販売合弁会社、米国に自動変速装置用部品の製造会社、中国重慶にマニュアルクラッチの製造合弁会社を設立しています。",
      "significance": "現在の社名になり、海外展開を進める時期の節目となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "東京証券取引所市場第一部に上場",
      "description": "1996年9月の大阪証券取引所市場第一部への上場に続き、東京証券取引所市場第一部にも上場しました。",
      "significance": "上場市場が広がり、全国的な知名度と資金調達力が高まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "アイシン精機と業務提携",
      "description": "アイシン精機株式会社（現 株式会社アイシン）と、海外事業を中心とした業務提携契約を結びました。",
      "significance": "自動車部品の大手との提携で、海外での事業を強める後ろ盾を得ました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "衣川鋳鉄の株式を取得",
      "description": "京都府福知山市の衣川鋳鉄の株式を取得しました（2009年にエクセディ鋳造に社名変更）。",
      "significance": "部品の素材となる鋳造品を、グループ内でつくる力を強めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "メキシコに自動変速装置用部品の製造会社を設立",
      "description": "メキシコのアグアスカリエンテス州に、自動変速装置用部品を製造するエクセディダイナックスメキシコを設立しました。",
      "significance": "北米向けの自動変速装置用部品を、現地でつくる拠点が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "東京証券取引所の市場区分見直しにより、市場第一部からプライム市場に移行しました。同年1月には株式会社アスターと、新事業領域を開拓するための業務提携契約を結んでいます。",
      "significance": "上場市場の区分が変わり、あわせて既存の変速装置の外に事業を広げる動きも始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "PRE-EVモビリティなどを子会社化",
      "description": "8月に山形県山形市のPRE-EVモビリティ株式会社、10月に京都府京都市の株式会社WorldLink&Companyの株式を取得し、それぞれ子会社にしました。6月には米国のエクセディアメリカを完全子会社にしています。",
      "significance": "電動化など新しい分野に向けて、グループの顔ぶれが増えました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "Protean Electricを子会社化、イタリアに合弁会社を設立",
      "description": "2月に英国サリー州のProtean Electricの株式を取得して子会社にしました。3月にはイタリアのトリノに合弁会社EXEDY FRAPを設立しています。",
      "significance": "海外で電動化に関わる事業へ踏み出した動きとして、直近の沿革に載っています。",
