      "industryId": "semiconductors",
      "primary": true
    }
  ],
  "businesses": [
    {
      "id": "test-systems",
      "name": "テストシステム事業",
      "shortName": "テストシステム",
      "description": "[[term:semiconductor|半導体]]が設計どおりに動くか、求められる性能や耐久性を満たしているかを試験する「半導体テスタ」と、試験する半導体を運ぶ装置やテスタとつなぐ部分など、テスタの周りで使う製品をつくって販売しています。2026年3月期の売上高の90.3%を占める事業です。",
      "customers": [
        "半導体関連企業",
        "NVIDIAグループ",
        "Taiwan Semiconductor Manufacturing Co., Ltd."
      ],
      "sourceIds": [
        "yuho-2026",
        "official-semiconductor-test",
        "official-products",
        "tanshin-2027-q1"
      ],
      "children": [
        {
          "id": "soc-test-systems",
          "name": "SoCテストシステム",
          "shortName": "SoC",
          "description": "異なる種類の複数の回路を1つのパッケージにまとめた半導体（SoC）を試験する装置です。機能の違うカードやモジュールを組み合わせて、ロジック、アナログ、無線通信（RF）などの回路をテストします。",
          "sourceIds": [
            "official-soc",
            "official-semiconductor-test",
            "yuho-2026"
          ]
        },
        {
          "id": "memory-test-systems",
          "name": "メモリテストシステム",
          "shortName": "メモリ",
          "description": "データを記憶する半導体（メモリ）を試験する装置です。メモリには、高速で読み書きできるDRAMや、電源がなくてもデータを保てるNANDフラッシュなどがあります。メモリは少ない品種を大量に生産するのが一般的で、その量産工程に合わせて、たくさんの半導体を同時にテストできるようにつくられています。",
          "sourceIds": [
            "official-memory",
            "official-semiconductor-test",
            "yuho-2026"
          ]
        },
        {
          "id": "test-handlers",
          "name": "テストハンドラ",
          "shortName": "ハンドラ",
          "description": "[[term:back-end-process|後工程]]での半導体の試験を自動化する装置です。半導体を運び、試験のときに温度をかけ、テストの結果にもとづいて半導体を選り分けます。",
          "sourceIds": [
            "official-test-handler",
            "official-products",
            "yuho-2026"
          ]
        },
        {
          "id": "device-interfaces",
          "name": "デバイスインタフェース",
          "shortName": "インタフェース",
          "description": "試験する半導体とテスタをつなぐ部分（インタフェース）の製品です。",
          "sourceIds": [
            "yuho-2026",
            "official-products"
          ]
        },
        {
          "id": "system-level-test",
          "name": "システムレベルテスト",
          "shortName": "システムレベル",
          "description": "半導体が、システムや最終製品に組み込まれて実際に使われる環境で正しく動くかを試験します。半導体を単体で試験するテストを補うものです。",
          "sourceIds": [
            "official-system-level-test",
            "yuho-2026"
          ]
        }
      ]
    },
    {
      "id": "services-and-others",
      "name": "サービス他",
      "shortName": "サービス",
      "description": "サポート・サービスや、試験に使うインタフェースボードなどの消耗品の販売を行っています。サポート・サービスの売上は、アドバンテスト製品の設置台数が増えるにつれて伸びています。ナノテクノロジー関連の製品もこの事業に含まれます。",
      "products": [
        "サポート・サービス",
        "テスト用インタフェースボードなどの消耗品",
        "ナノテクノロジー関連の製品"
