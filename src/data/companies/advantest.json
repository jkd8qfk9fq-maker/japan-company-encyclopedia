  "history": [
    {
      "year": 1954,
      "title": "タケダ理研工業を設立",
      "description": "電子計測器の専門メーカーとして、愛知県豊橋市にタケダ理研工業株式会社を設立しました。創業のころは、電圧電流計や周波数カウンタといった電子計測器を開発・製造していました。",
      "significance": "現在のアドバンテストの出発点です。会社は、1954年の創業以来培ってきた電子計測技術で顧客の課題の解決に貢献し、半導体の進化を支えていると説明しています。",
      "sourceIds": [
        "yuho-2026",
        "official-history",
        "official-semiconductor-test"
      ]
    },
    {
      "year": 1972,
      "title": "半導体試験装置を発売",
      "description": "会社が「国産初」とする半導体試験装置「T-320/20」「T-320/30」を発売しました。会社は、1960年代末に半導体産業の発展を予測し、電子計測技術を活かせるテスト・システムの開発に「社運をかけて参入」したと説明しています。",
      "significance": "電子計測器から始まった会社が、半導体の試験装置を発売した年です。半導体テスタは、現在の会社の主力製品です。",
      "sourceIds": [
        "official-history",
        "official-semiconductor-test"
      ]
    },
    {
      "year": 1982,
      "title": "米国に子会社を設立",
      "description": "子会社Advantest America, Inc.を米国に設立しました。会社はこの年以降、世界各地に拠点を広げています。",
      "significance": "Advantest America, Inc.は今もテストシステムなどの開発・販売を担う子会社です。2026年3月期の海外売上比率は97.8%でした。",
      "sourceIds": [
        "yuho-2026",
        "official-history"
      ]
    },
    {
      "year": 1985,
      "title": "社名を「アドバンテスト」に変更",
      "description": "タケダ理研工業株式会社から、現在の社名である株式会社アドバンテストに変更しました。同じ年に、東京証券取引所市場第一部に上場しています。",
      "significance": "会社は、1980年代にテスト・システム事業が会社の「大黒柱」になったと説明しています。2026年3月期も、テストシステム事業部門が売上高の90.3%を占めています。",
      "sourceIds": [
        "yuho-2026",
        "official-history"
      ]
    },
    {
      "year": 2011,
      "title": "Verigy社を買収",
      "description": "半導体試験装置の会社Verigy Ltd.の普通株式をすべて取得し、完全子会社にしました。会社はこの買収を、第2の「社運をかけた一手」と呼んでいます。",
      "significance": "会社は、Verigy社の顧客基盤と、世界で事業を運営するノウハウが加わったことが、その後の成長の大きな礎になったと説明しています。",
      "sourceIds": [
        "yuho-2026",
        "official-history"
      ]
    },
    {
      "year": 2019,
      "title": "システムレベルテスト事業を譲り受ける",
      "description": "米国Astronics社のシステムレベルテスト事業を譲り受けました。",
      "significance": "システムレベルテストのソリューションは、現在テストシステム事業に含まれています。会社は、システムレベルテストやテスト周辺機器へと事業を広げてきたとしています。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    },
    {
      "year": 2024,
      "title": "第3期中期経営計画を発表",
      "description": "2018年に定めた中長期経営方針「グランドデザイン」を改定し、第3期中期経営計画（MTP3）を発表しました。同じ年、Douglas LefeverがGroup CEOに就任しています。",
      "significance": "MTP3は2024年度から2026年度までの3か年の計画で、現在の経営の計画です。会社は、最終年度の2026年度もMTP3で掲げた施策を進めるとしています。",
      "sourceIds": [
        "yuho-2026",
        "official-history"
      ]
    }
  ],
