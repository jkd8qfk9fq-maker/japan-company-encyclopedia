  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業ミッション「世界と自分をワクワクさせろ」のもと、基本方針として、モバイルオンラインゲーム事業の抜本的改革と再成長（競争力を持つS級IPを活用したタイトルの開発・運営と「少数精鋭主義」の開発体制）と、経営の多角化による新たな収益源の確立（「IP/エンタメ」「AI」「ブロックチェーン」の３つの領域を注力分野とし、多産多死戦略のもと新規事業を早期に複数確立すること）を掲げています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "マンガやアニメなどの有力IPを活用したタイトル開発を続けており、『BLEACH Brave Souls』が10周年の節目を迎えるなど長期運用の実績があります。開発ジャンルを得意なアクションRPGとスポーツシミュレーションに絞り、これまでの開発及び運営を通じて蓄積した知見を用いる方針です。",
        "basis": "経営成績の分析における既存タイトルの安定運用と10周年施策の記述と、対処すべき課題における得意ジャンルへの絞り込みと蓄積した知見の活用の記述に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "モバイルゲームの市場は主要地域において成熟段階に入りつつあり、日本市場では新作ゲームが取り得る市場規模が縮小する一方で、１タイトル当たりの開発・運営コストは増加傾向にあると会社は認識しています。日本発のアニメ、マンガ及びゲームキャラクター等のIPの世界的な人気の高まりを、中長期的な成長機会と位置づけています。",
        "basis": "経営方針における経営環境の記述（市場の成熟、日本市場の縮小と開発・運営コストの増加、日本発IPの世界的な人気）に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
