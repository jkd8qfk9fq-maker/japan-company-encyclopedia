  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "酒販事業と外食事業で経営資源を最適に組み合わせ、酒類関連市場でのシェア拡大を図ります。酒販事業では調達から販売までを一貫して行うワールドリカーシステムを活用し、酒類を中心とした嗜好品専門店の全国チェーンを作ります。外食事業では新規業態の開発にも取り組み、食を中心とした総合サービス産業を目指します。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "酒販事業が売上高の8割以上を占め、外食事業が残りを占める2つの事業で構成されています。全国に酒販店と外食店を展開し、酒類を軸にした事業です。",
        "basis": "2026年3月期の外部顧客への売上高は、酒販事業129,718百万円、外食事業29,400百万円です。2026年3月31日現在の店舗数は、酒販事業356店、外食事業598店です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "調達や輸入から店舗への供給や販売までを一貫して行う仕組みがあり、国内外の銘醸酒や食料品を幅広く扱っています。",
        "basis": "ワールドリカーシステムは、国内外の銘醸酒、優良な食料品等を調達・輸入から、店舗への供給・販売までを一貫して行う仕組みです。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "酒販事業を中核とし、居酒屋を中心とした外食事業をあわせ持つ会社です。イオンの持分法適用関連会社でもあります。",
        "basis": "2026年3月期の売上高は1,591億19百万円で、酒販事業が129,718百万円、外食事業が29,400百万円です。イオン株式会社は2026年3月31日現在19.1%の議決権を被所有するその他の関係会社です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
