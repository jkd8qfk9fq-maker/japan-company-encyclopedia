  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「IT技術を駆使して、価値を創造し、お客様とともに成長を続け、豊かな社会の実現に貢献する。」を理念とし、2026年12月期を最終年度とする中期経営計画「Segue300」を掲げて事業の拡大と企業価値の向上に取り組んでいます。対処すべき課題として、人材の確保・育成、収益力の強化、事業ポートフォリオとグループ組織体制の最適化、内部統制の継続強化を挙げています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は官公庁向けの大型案件やGSS（ガバメントソリューションサービス）の受注が売上高の伸びをけん引し、中期経営計画の数値目標は事業の進捗を踏まえて上方修正されました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析と、経営方針、経営環境及び対処すべき課題等による。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "海外メーカー製品の輸入販売と自社開発製品に、設計・構築、保守、ヘルプデスク、運用・監視までを組み合わせ、ITシステムを一貫して提供できる体制を持ちます。保守やヘルプデスクなどの継続契約によるストック型の収益も積み上がる構造です。",
        "basis": "事業の内容に記載された事業の区分と対応する子会社、ストック型ビジネスに関する記載による。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
