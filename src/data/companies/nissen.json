  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画の成長戦略として、独自の“コミュニティ発想”に基づく成長の実現を掲げています。有料の広告枠に依存せずに企業がマーケティングを推進できる状態づくりを支援する「事業成長・創造」と、有力クライアントやサービス、リソース、テクノロジーの獲得を目的とした「M&A・投資」の2つを軸とし、人的資本の強化とESG経営への取り組みがこれらを支えるとしています。独立系広告会社という立場から、メディアではなく「コミュニティ」をベースにブランドや事業の成長に貢献するマーケティング支援会社として進化していく方針です。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "全国のケーブルテレビ局向けの番組情報誌「チャンネルガイド」は、その品質・価格・ノウハウにより高い参入障壁を維持していると会社が述べています。プランナーやクリエイティブディレクター、デザイナー、映像ディレクターなど幅広い制作人材を社内に有し、顧客企業と直接取引をしながら企画から制作、運営まで一貫して担える体制も特徴です。住まい・暮らし業界では半世紀にわたり大手住宅メーカーのセールスプロモーションを提供してきました。",
        "basis": "事業の内容に、チャンネルガイドの品質・価格・ノウハウによる高い参入障壁の維持、社内の制作部門が有する幅広い人材、顧客企業との直接取引、住まい・暮らし業界で半世紀にわたり大手住宅メーカーのセールスプロモーションを提供してきたことが印字されているため。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
