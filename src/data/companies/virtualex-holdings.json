  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期的には事業規模及び事業領域の積極的な拡大を図り、企業価値の最大化を目指す方針です。主要な課題として、営業基盤の拡大、AI利活用によるコンタクトセンター変革の牽引、生成AIを用いた自社ソリューションの製品化・サービス化、AIコンタクトセンター総合プラットフォームの提供、デジタルマーケティングからCRMまでの一気通貫支援などを掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンサルティング（計画・設計）、テクノロジー（IT開発・導入）、オペレーション（業務実行）の3つのスキルを一気通貫で提供できる体制が強みとして読み取れます。",
        "basis": "経営方針に、1999年の創業以来CRM領域で培ってきた「コンサルティング（計画・設計）」「テクノロジー（IT開発・導入）」「オペレーション（業務実行）」の3つのスキルを一気通貫で提供できる独自の強みを最大限に活かし、市場変革を牽引する役割を担うと印字されていることによる。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
