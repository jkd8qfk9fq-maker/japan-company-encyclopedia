  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業以来、全食材から『四大添加物（化学調味料・人工甘味料・合成着色料・人工保存料）』を完全に排除した商品を提供することを理念とし、日本の食文化の代表である寿司を通して世界の人々の幸せに貢献できる企業を目指しています。2020年1月に公表した長期構想では、2030年度を最終年度とし、第二の創業期として日本国内と海外を両輪で拡大することで、全世界での売上高3,600億円以上、店舗数1,100店舗以上を目標値として設定しています。出店形態は直営店のみとし、蓄積してきたノウハウをもとに海外展開を加速するとしています。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "抗菌寿司カバー『鮮度くん』や皿の自動回収と連動した『ビッくらポン！』など、特許技術を含む独自の店舗システムを全店に導入していることと、出店を直営店のみとして品質とサービスを自社で管理する体制が、他社との違いを生む基盤になっています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に『特許技術である抗菌寿司カバー「鮮度くん」』と四大添加物の排除が印字され、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に『ビッくらポン！』が『当社を代表するシステム』と印字されている。中長期的な会社の経営戦略には『出店形態は直営店のみとし』と印字されている。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は日本で、2025年10月期は連結売上高245,109百万円のうち日本が176,407百万円を占め、北米42,103百万円、アジア26,598百万円が続きます。米国と台湾の子会社はそれぞれ現地の株式市場に上場しており、海外の店舗網を広げています。",
        "basis": "セグメント注記に2025年10月期の外部顧客への売上高（日本176,407百万円、北米42,103百万円、アジア26,598百万円、連結売上高245,109百万円）が印字され、【関係会社の状況】の注記にKura Sushi USA,Inc.のNASDAQ Global Market上場と亞洲藏壽司股份有限公司のTaipei Exchange上場が印字されている。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
