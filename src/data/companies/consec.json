  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「最高の信用」「最高の技術」「最高の品格」の企業理念のもと、安全性と生活環境に留意した新製品・新技術の開発とサービスを「最適提案」することを掲げています。「中期経営計画2029」（第59期から第63期）を基に「事業領域の拡大」と「選択と集中の推進」に取り組み、全社戦略として、公共工事を中心とした修繕維持工事市場の拡大を成長市場と捉えて特殊工事事業の受注領域を拡大し、顧客ニーズの高い新製品やエリアに経営資源を集中するとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "建設・生活関連品事業と切削機具事業の2事業で売上の約4分の3を占め、機器や資材の販売と、それらを使う特殊工事の請負を組み合わせた構成です。修繕維持工事の需要を特殊工事の受注拡大につなげることが、経営戦略の中心になっています。",
        "basis": "セグメント情報における外部顧客への売上高の構成と、経営方針における全社戦略の記載に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "アンカー工事の施工から始まった会社であり、工事に使う穿孔・切断機器を自社で開発・製造しているため、施工の現場の要望を製品に反映しやすい体制を持っています。台湾と中国に製造子会社を持ち、消耗品であるダイヤモンド工具の供給も自社グループで行っています。",
        "basis": "事業の内容における事業区分と関係会社の状況、沿革における創業事業の記載に基づく",
        "asOf": "2026-06-23",
