  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力のパチンコホール広告分野では、広告サービスの付加価値と生産性の向上を追求して収益を確保するとしています。あわせて、特定業種への依存度が高い現状を改善し収益の多様化を実現するため、パチンコホール広告以外の分野における市場開拓、集客施設におけるデジタルメディアの市場浸透、事業領域の拡大を戦略課題に掲げ、新たな事業機会の模索と積極的な事業開発に取り組む方針です。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、品目別の販売実績でインターネット広告が前期より伸びた一方、取扱高の大きい折込広告などの紙媒体広告は第３四半期以降に急減しました。会社は、高付加価値なＤＳＰ広告や自社保有サイト「パチ７」の拡販、フィットネス・住宅関連に加えたフランチャイズ業界への展開など、紙媒体からインターネット広告へ、パチンコ以外の分野へと収益の軸足を移す取組みを進めています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における品目別の販売実績と、経営方針に掲げる戦略課題による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1994年の創業以来、パチンコホール向け広告を専門に手がけてきた実績があり、本社と四ツ谷オフィスのほか、全国主要都市に10の営業拠点を置いています。自社保有サイト「パチ７」やＤＳＰ広告など、自社で提供できるインターネット広告の手段を持ち、映像・ウェブ・デザイン等の制作はグループ内の子会社でも担える体制があります。",
        "basis": "事業の内容、沿革、主要な設備の状況による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "広告事業が2026年３月期の売上高7,531百万円のうち7,431百万円を占め、その中心はパチンコホール向け広告です。パチンコホール以外の広告分野では、フィットネス施設や住宅関連の広告が主力であり、新たにフランチャイズ業界への展開を強化するとしています。不動産事業の売上高は99百万円で、広告事業に比べて小規模です。",
        "basis": "セグメント情報と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
