  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは「優れた製品を供給して社会に貢献する」ことを社是とし、「会社と社員の永遠の繁栄をはかる」ことを行動の基本方針としています。対処すべき課題として、製品の付加価値向上と生産能力の拡大、グループの連携強化とグローバルな視野に立った営業戦略の確立、高品質志向の次世代製品の投入強化、社会的要請事項への対応と企業価値の向上を挙げています。生産設備を内製している強みを生かし、生産能力の迅速な増強を図るとしています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の中心は、主力のPCBドリル等の高付加価値化と生産能力の拡大にあります。生成AI関連分野の需要拡大を見込み、内製の生産設備を生かした迅速な能力増強と、需要地に置いた製造拠点の連携強化、製品の作り分けや物流の連携による営業戦略の構築を進める方針が示されています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営方針・対処すべき課題の記載と、セグメント情報の外部顧客への売上高に基づく。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、切削工具を製造する設備自体を自社で開発・製造し、60年以上のノウハウを自社設備に集約していることにあります。PCBドリル分野では世界展開を果たしている企業グループであり、世界からの情報と内製技術の蓄積により、高付加価値製品を早く開発・製造できる体制を整えています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記載と、【事業等のリスク】のPCBドリルへの依存に関する記載に基づく。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約7割をPCBドリルが占め、製品区分では切削工具が37,400百万円、その他が2,764百万円です。顧客の所在地別では日本を含むアジア向けが中心で、2025年12月期は中国向け11,805百万円、台湾向け6,830百万円、日本向け10,215百万円でした。アジアの主要な顧客であるWus Printed Circuit(Kunshan)Co.,Ltd.への売上高は5,705百万円です。",
        "basis": "セグメント情報の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報と、【事業等のリスク】の記載に基づく。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
