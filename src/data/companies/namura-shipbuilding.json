  "perspectives": {
    "competitiveAdvantage": {
      "disclosed": {
        "asOf": "2026-06-19",
        "locator": "【会社の支配に関する基本方針】",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "企業価値の源泉は、国内外の顧客との長期的視野に立った緊密な相互信頼関係、舶用資機材供給者との中・長期的かつ安定的な取引関係、顧客ニーズを的確にとらえた高品質な製品を開発・受注・製造するための開発力・技術力および生産管理ノウハウ、地域社会との良好な相互関係にあるとしています。"
      }
    },
    "industryPosition": {
      "analysis": {
        "asOf": "2026-06-19",
        "basis": "セグメント情報に2026年3月期の報告セグメントごとの外部顧客への売上高（新造船事業125,643百万円、修繕船事業20,538百万円、鉄構・機械事業6,279百万円、その他事業6,575百万円、連結売上高159,035百万円）が印字されている。",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "売上高の中心は新造船事業です。2026年3月期の外部顧客への売上高は、新造船事業が125,643百万円と連結売上高159,035百万円の4分の3以上を占め、修繕船事業が20,538百万円、その他事業が6,575百万円、鉄構・機械事業が6,279百万円でした。"
      }
    },
    "strategy": {
      "disclosed": {
        "asOf": "2026-06-19",
        "locator": "【経営方針、経営環境及び対処すべき課題等】",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "既存事業のさらなる「深化」と、長期的な成長に向けた新たな事業展開による「進化」を基本戦略とし、成長投資を加速させています。新造船事業ではゼロエミッション船の国内建造シェアの拡大を図るとともに、2040年より前にゼロエミッション船建造比率100％体制の構築を目標としています。"
      }
    }
  },
