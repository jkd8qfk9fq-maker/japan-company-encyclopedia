  "businesses": [
    {
      "id": "imura-and-co",
      "name": "株式会社イムラ",
      "description": "大阪市中央区に本社を置く封筒メーカーで、連結子会社4社とグループを構成しています。パッケージソリューション事業とメーリング＆デジタルソリューション事業の2つの報告セグメントを展開し、2026年1月期の連結売上高は21,831百万円、連結従業員数は973人です。東京証券取引所スタンダード市場に上場しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "package-solution",
          "name": "パッケージソリューション事業",
          "description": "一般事務用、株主総会招集通知用、企業からの各種請求用、官公庁等の諸通知用などに使われる長形・角形・洋形の封筒や窓付き封筒（プラマド封筒、セロマド封筒）、ポストイン対応包装資材、紙製商品パッケージ、各種印刷物などを製造販売し、運送・倉庫業も行う事業です。2026年1月期の外部顧客への売上高は15,099百万円と最大の事業です。製造販売は当社が行い、連結子会社の株式会社イムラプリンティングが商業印刷物、株式会社ロジテックが運送・保管を担います。",
          "customers": [
            "請求書・株主総会招集通知などの封筒を使う企業",
            "諸通知・投票所入場券を発送する官公庁",
            "包装資材・商品パッケージを使う通販・小売などの事業者"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "mailing-digital-solution",
          "name": "メーリング＆デジタルソリューション事業",
          "description": "ダイレクトメールの企画・製作・発送代行、冊子類や販売促進用商品の封入・梱包とその発送代行、顧客リストの管理、データプリントサービス、キャンペーン事務局、ロジスティックサービス、コンピュータ機器の販売やソフトウエアの開発などを行う事業です。2026年1月期の外部顧客への売上高は4,549百万円です。",
          "customers": [
            "ダイレクトメールを発送する企業",
            "冊子類・販促品の封入・発送を委託する事業者",
            "顧客リスト管理やデータプリントを委託する事業者"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "other-businesses",
          "name": "その他",
          "description": "報告セグメントに含まれない事業で、医療機関用印刷物及び医療機関用諸物品の販売と、紙器・段ボール箱及び包装用品の製造販売を行っています。2026年1月期の外部顧客への売上高は2,182百万円です。連結子会社の東杏印刷株式会社と、ベトナムのSONGLAM TRADING AND PACKAGING PRODUCTION JOINT STOCK COMPANYが担います。",
          "customers": [
            "医療機関",
