  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンとして「高齢者が笑顔で居る未来を堅守する」を掲げ、家族が心の介護に向き合い、高齢者が笑顔で居る社会の実現を目指しています。シニアライフサポートサービスでは家族会議の実施を増やすことを目的に、Sales EnablementのPDCAサイクルで新人コーディネーターの早期立ち上がりとサービスの均質化を図り、全国のメディカルソーシャルワーカーへのリーチを広げてシェア拡大を推し進めるとしています。シニアホームコンサルティングサービスでは、「ケアサンク パートナーリース」で運営事業者の与信力を当社グループが担保することで、運営力はあるが事業拡大が容易ではなかった運営事業者の開設支援も強化するとしています。",
        "asOf": "2026-01-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "シニアホーム紹介サービスは、コーディネーターの専門性と、意思決定の主体者は入居検討者であるとする中立性を軸としています。提携するシニアホームは2025年10月末時点で10,758ホームに上り、コーディネーターが直接足を運ぶなどして得た詳細情報をもとに紹介を行います。入居対象者を支援するメディカルソーシャルワーカーやケアマネジャーを紹介パートナーとして直接営業し、継続的に紹介を受ける仕組みを築いています。",
        "asOf": "2026-01-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年10月期の営業収益1,872百万円のうち、シニアライフサポートサービスが1,549百万円と大半を占め、シニアホームコンサルティングサービスが323百万円です。介護業界では、在宅介護を担う介護家族が増える一方で介護家族への支援は不十分であり、シニアホームの入居検討においては適切な情報収集が困難なために入居を躊躇したり諦めたりするケースがあると説明されています。",
        "basis": "セグメント情報の外部顧客への営業収益及び経営成績等の状況の概要に印字された金額と業界環境の説明に基づきます。",
        "asOf": "2026-01-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
