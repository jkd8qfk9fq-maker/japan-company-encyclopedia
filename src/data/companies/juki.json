  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年から2029年までの5か年中期経営計画「Building Sustainable JUKI」を推進しています。基本方針は、2大事業を軸とした成長、コスト競争力と財務基盤の強化、ESG経営の実践の3つです。縫製事業ではIoTの融合によるソリューション提案でハイエンド顧客の囲い込みを加速し、家庭用ミシンの拡大も進めます。産機事業では産業装置事業が重点領域・地域を絞ったグローバルニッチ戦略に転換し、受託事業では当社の技術力を活かして第3の柱の探索を強化しています。中期経営計画は毎年見直す方針です。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "1938年の創業以来、工業用ミシンを中心に縫製技術を培ってきました。大田原工場を主力工場とし、中国・ベトナムなどの海外生産拠点と、米国・欧州・アジア・中国・インドなどの販売子会社によるグローバルな生産・販売体制を持ちます。工業用ミシンへのIoTの融合によるソリューション提案力と、産業装置事業の実装技術という、縫製と産機の2事業の技術基盤を強みとしています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは縫製事業と産機事業の2つで、2025年12月期の外部顧客への売上高は縫製事業が66,616百万円、産機事業が21,847百万円、その他が297百万円です。地域別では日本が15,175百万円、アジアが19,789百万円、中国が18,577百万円、米州が2,689百万円、アメリカが11,290百万円、インドが9,647百万円、欧州が10,124百万円、その他が1,466百万円です。主要な顧客ごとの情報に該当事項はありません。Wikipediaでは、同社の工業用ミシンのシェアは世界1位とされています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報）の印字と、Wikipediaの補足に基づきます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025",
          "wikipedia"
        ]
      }
    }
  },
