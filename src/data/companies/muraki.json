  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「人が好き、車が好き」を合言葉に「ヒューマンカーライフの創造を通じ社会に貢献する」こととし、サービスステーション（SS）との接点（取引）の維持・拡大、既存の事業にとらわれない分野への投資及び新規事業開発、人財の開発と育成、ESG経営の推進を施策に掲げています。中長期的な経営戦略では、カスタマイズ提案と定期訪問を基本営業として徹底しSS内での取引アイテム数の拡大を図るほか、CASEやMaaS等の新たな分野への投資及び新規事業開発に取り組み、将来の収益の柱となる中核事業の創出を目指すとしています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "石油元売会社等の自動車関連用品販売指定業者としての契約を複数の相手先と長期にわたり維持し、本社のほか全国7支店と物流センターを持つ販売・物流網でSSへ商品を供給できる体制が強みになっています。",
        "basis": "【重要な契約等】にアポロリンク株式会社、株式会社コスモトレードアンドサービス、株式会社デンソーソリューション、ENEOSトレーディング株式会社との自動車関連用品販売指定業者契約（1976年から2000年にかけて締結し1年毎の自動更新）が印字され、【主要な設備の状況】に全国の支店と関東物流センターが印字されていること",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
