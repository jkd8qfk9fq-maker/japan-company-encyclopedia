  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "顧客価値経営を推進し、情報システムではエレクトロニクス技術とシステム技術を活かして耐環境性と信頼性の高い防衛装備品を提供し日本の防衛に貢献すること、電子機器では接合の4工法や赤外線技術を活かしたソリューションの提供と海外展開の強化により受注・売上の拡大をはかることを掲げています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "情報システムは積み上がった受注に基づく生産計画の遂行を掲げ、実際に2026年3月期の情報システムの売上高は前期から大きく伸びています。電子機器でも、データサーバー等の需要増加や監視による未然防止への関心の高まりを背景に設備需要が増え、売上高が伸びています。",
        "basis": "セグメント情報に記載された報告セグメントごとの外部顧客への売上高と関連情報の主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に記載されたセグメント別の状況と売上高の増減による。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、防衛装備品に求められる耐環境性と信頼性を支えるエレクトロニクス技術とシステム技術、接合機器のマイクロ接合技術とメカトロニクス技術、熱を可視化する赤外線技術を核とする画像処理技術や波長制御技術です。",
        "basis": "経営方針、経営環境及び対処すべき課題等に記載された各事業の強みと技術、事業の内容に記載された製品の構成による。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報システムの需要の背景には高水準で推移する防衛予算があります。地域別の売上高は日本が25,674百万円と大半を占め、アジアやその他の地域向けも販売しています。主要な顧客は日本電気、住商エアロシステム、富士通の大手3先です。",
        "basis": "セグメント情報の関連情報に記載された地域ごとの売上高と主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に記載された経営環境による。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
