  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から始動した「GCIグループ中期経営方針2030」では、ありたい姿を、化学の力でグローバルにソリューションを提供し、社会の持続的成長に貢献する『Green Chemical Industry（GCI）』とし、基本方針として事業ポートフォリオの再構築、マーケティングによる事業領域の拡大、生産性向上と収益力強化、持続的成長を支える人材の育成とエンゲージメント向上を掲げています。目指す方向性として、電子材料分野を中心とする「高純度・先端材料」、Green分野としての「環境対応ケミカル」、「新事業創出（高機能糖ケミカル）」と「経営基盤強化」を挙げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "フェノール樹脂では工業用樹脂「レヂトップ」、特殊フェノール樹脂「ミレックス」、鋳物用粘結剤、高機能繊維「カイノール」など用途別の製品群を持ち、タイ、インド、米国の子会社が現地で製造販売する体制を備えています。食品事業では異性化糖、ブドウ糖、水あめ、オリゴ糖から化粧品原料まで澱粉糖類の製品群を持ち、化学品と食品の2事業で収益源を分けています。",
        "basis": "【事業の内容】の主要製品等の記載、【関係会社の状況】の海外子会社の記載、セグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高31,307百万円の内訳は、化学品事業26,496百万円、食品事業4,564百万円、不動産活用業247百万円です。地域別では日本20,704百万円、タイ3,922百万円、台湾3,226百万円、その他アジア2,826百万円、その他627百万円で、海外向けが約3割を占めます。売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と【関連情報】の地域ごとの情報・主要な顧客ごとの情報、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント別概況に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
