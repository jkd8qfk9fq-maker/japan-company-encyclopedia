  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「食を守り、ひとを育む」です。経営方針として人材育成、お客様第一主義、変化対応、本物の商品開発と技術の修得を掲げています。2026年7月期から2029年7月期までの中期経営計画では、新規出店の加速や独自の商品開発、内製化の推進に取り組み、2029年7月期の売上高目標は250,000百万円です。",
        "asOf": "2026-10-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
