  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度を初年度とする3か年の中期経営計画「顧客と並走する菱友」を推進し、新ビジネスの立ち上げ、既存顧客の深耕・接点の拡大、“人”の価値向上、業務運営体制の強化、菱友グループ強化・最適化を注力項目としています。新ビジネスではAIの業務適用や情報セキュリティの新サービスの提供を開始し、外部企業との業務提携も実施しました。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "解析・設計の分野では、得意とする流体解析と構造解析に加えて新たな解析分野への拡大に取り組んでおり、情報セキュリティやAIなどの新しい分野でもサービスの提供を始めています。システム開発から運用・保守、機器販売、情報処理までをグループで担える事業構成が土台になっています。",
        "basis": "事業の内容に印字された事業構成と、経営方針、経営環境及び対処すべき課題等に印字された解析・設計分野の取り組みに基づく分析",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービスの単一セグメントで事業を行い、2026年3月期の売上高は43,229百万円です。主要な顧客である三菱重工業株式会社への売上高は26,432百万円と印字されています。連結従業員数は2,006人で、連結子会社3社とともに事業を行っています。",
        "basis": "セグメント情報等の主要な顧客ごとの情報、販売実績の相手先別内訳、関係会社の状況、従業員の状況に基づく分析",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
