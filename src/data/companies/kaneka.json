  "history": [
    {
      "year": 1949,
      "title": "鐘淵紡績から分離独立して設立",
      "description": "1949年9月1日、鐘淵紡績株式会社（当時）の企業再建整備計画の認可に基づき分離独立し、繊維部門以外の全事業を譲り受けて設立されました。",
      "significance": "設立当初は、か性ソーダ、搾油、石鹸、食油、酵母、食品類、洋紙、和紙、エナメル電線、化粧品、澱粉など多岐にわたる事業を営んでいました。その後、か性ソーダ・食油・酵母以外を順次整理し、塩化ビニル樹脂などを開発して、合成樹脂を中核とする総合化学会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所等に上場",
      "description": "1949年10月に東京証券取引所等に上場しました。",
      "significance": "2022年4月に東京証券取引所の市場区分の見直しで、市場第一部からプライム市場へ移行しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1950,
      "title": "塩化ビニル樹脂の製造を開始",
      "description": "1950年7月に塩化ビニル樹脂の製造を始めました。",
      "significance": "塩化ビニル樹脂は、現在のMaterial Solutions Unitが扱う一般用塩化ビニル樹脂につながる製品です。塩化ビニル樹脂などの事業を開発して、合成樹脂を中核にしました。1953年には塩ビコンパウンド、1967年には塩ビ系特殊樹脂の製造も始めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1957,
      "title": "アクリル系合成繊維「カネカロン」の製造を開始",
      "description": "1957年7月に、アクリル系合成繊維「カネカロン」の製造を始めました。",
      "significance": "アクリル系合成繊維は、現在のQuality of Life Solutions UnitのPerformance Fibersの主要製品として挙がっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "モディファイヤーの製造を開始",
      "description": "1964年6月にモディファイヤーの製造を始めました。",
      "significance": "モディファイヤーは、現在のMaterial Solutions UnitのPerformance Polymers(MOD)の主要製品です。1979年には変成シリコーンポリマーの製造も始めています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
