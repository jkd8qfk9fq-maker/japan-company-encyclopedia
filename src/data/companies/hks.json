  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ブランド力の強化に努め、スポーツタイプ車両向け新商材の開発スピードを高めて市場投入のタイミングを最適化するとともに、新たなグローバル市場の開拓と新規販路の開拓を進める方針です。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "米国関税の影響が大きい環境のなかで、主力のアフターマーケット向け新製品の投入を早め、海外の販路を広げることで、特定の市場や受託事業の需要変動を補う方向性が示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等に記載された市場環境の認識と、優先的に対処すべき課題への対応に基づく",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "レース用エンジンの開発を起源として、エンジン部品やターボチャージャー等の開発から製造までを自社で手がけ、日本・英国・タイ・中国・米国に販売・生産・開発の拠点を置いています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
