  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "アパレルと雑貨による収益の二本柱体制の確立を最重要課題とし、アパレルでは既存店舗の活性化と気候変動に対応したMD改革を推進し、雑貨では競争力のある商品供給体制の構築と店舗特性に応じた最適な商品構成に取り組んでいます。新規出店に加えてECをはじめとする成長分野への投資を行い、Z世代向けブランドの拡充とOMO（オンラインとオフラインの融合）施策、CRMの活用、基幹システムの更新や新POSの導入も進めています。ガバナンスを強化した仕入及び在庫コントロールを継続し、物流子会社の機能を活用して店舗在庫の偏在解消にも取り組んでいます。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高は2022年2月期から4期連続で減少しています。2026年2月期は新規出店10店舗に対して退店が27店舗と店舗網の見直しが進む一方で、既存店の活性化とECなど成長分野への投資を組み合わせる方針が示されています。",
        "basis": "主要な経営指標等の推移における売上高の推移と、MD&Aにおける出店・退店の記載に基づく",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "レディースアパレルで、年齢層やテイストの異なる複数のブランド（PALEMO STORE、Ludic Park、Re-J&SUPURE、NOÉMIE、Hare no hi/木糸土）を複合展開し、プラスサイズ専門の「Re-J&SUPURE」のように特定の顧客層に絞ったブランドも持っています。雑貨の「illusie300」や「INCENSE」と合わせ、ショッピングセンターの中で幅広い品揃えを提供できる構成です。",
        "basis": "事業の内容におけるブランド構成の記載に基づく",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "専門店業界では、気候変動による夏の長期化を受けて各社がシーズンMDの見直しを進めており、物価上昇に伴う消費者の節約志向の高まりが売上に影響する環境にあります。当社グループは全国のショッピングセンター内に出店し、2026年2月20日現在の店舗数は227店舗です。",
        "basis": "MD&Aにおける業界環境と店舗数の記載に基づく",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
