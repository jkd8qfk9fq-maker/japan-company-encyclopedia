      "year": 1925,
      "title": "キユーピーマヨネーズの製造を開始",
      "description": "キユーピーマヨネーズの製造を始めました。",
      "significance": "今も会社を代表する商品の製造が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1957,
      "title": "キユーピー株式会社へ社名変更",
      "description": "社名を食品工業株式会社からキユーピー株式会社へ変更しました。",
      "significance": "商品名と同じ社名になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "東京証券取引所市場第二部に上場",
