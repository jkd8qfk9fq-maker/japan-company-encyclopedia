  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グランドビジョンに「21世紀で最も感動を与えた会社になる」を掲げ、「日本をDX・AXでアップデートする会社」として、ITフリーランス・グローバル人材のネットワークやデジタル人材育成といった事業アセットを活かし、戦略から現場への落とし込みまでを担うDX・AX実装支援を提供することを経営方針としています。成長戦略の一環としてM&Aも推進しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の6割強を占める国内IT人材事業を中核に、豪州のIT人材事業とSeed Tech事業を組み合わせ、IT・DX・AI人材の領域に特化した事業ポートフォリオを構成しています。",
        "basis": "セグメント情報の外部顧客への売上高、事業の内容、MD&Aの経営成績の状況に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ITフリーランスの集客とマッチングの仕組みとして、案件検索サイト「GEECHS JOB」を通じた営業代行や福利厚生プログラム「フリノベ」を備え、正社員とITフリーランスを組み合わせたハイブリッドチームによる伴走型支援まで提供範囲を広げています。国内に加えて豪州とフィリピンに人材・開発の拠点を持つことも特徴です。",
        "basis": "事業の内容（IT人材事業（国内）のマッチングと支援の仕組み、IT人材事業（海外）、Seed Tech事業の内容）に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "IT人材の領域に特化した人材サービス会社で、国内のITフリーランス向けマッチングが売上の中心です。豪州のIT人材事業が売上高の約3割半を占め、海外事業の比率の高さが特徴です。",
        "basis": "セグメント情報の外部顧客への売上高と地域別情報、事業の内容に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
