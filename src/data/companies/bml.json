  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第9次中期経営計画（2024～2028年度）を推進します。グループビジョンの実現に向けて「さらなる品質」「ソリューション」「相互の発展」をキーコンセプトとし、「10年先を見据えた事業拡大を確固たるものにする」ことを目標に、「次世代ラボ構築」を核とした6つの基本戦略フレームワークに基づき計画を進めます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "設立以来、迅速で精度の高い検査を提供してきました。検査領域は一般検査から特殊検査まで4,000項目以上に及びます。ISO9001と臨床検査室のマネジメントシステムであるISO15189を取得し、品質の向上を図っています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "全国のラボネットワークと共通のITシステムで検体の受付から結果報告、請求までをつなぎ、臨床検査から食品衛生検査、医療情報システムまでグループで対応できる体制です。",
        "basis": "【事業の内容】の事業系統の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    }
  },
