  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「社会性の追求」「公益性の追求」「公共性の追求」の3つを掲げ、事業コンセプトを「人々の喜びを創造する」としています。2024年5月に2025年3月期を初年度とする3年間の中期経営計画を策定し、2027年3月期の売上高の目標を2,000億円としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "紳士服チェーン「ＡＯＫＩ」と複合カフェ「快活ＣＬＵＢ」を柱に、ファッション、エンターテイメント、ブライダルの異なる3つの事業をポートフォリオ経営で組み合わせ、グループ全体で安定的な成長を目指す体制が、有報の記載から読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営方針及び【事業の内容】の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、ファッション事業が102,892百万円、エンターテイメント事業が76,762百万円、アニヴェルセル・ブライダル事業が12,436百万円、不動産賃貸事業が2,202百万円でした。売上はすべて国内で、本邦以外の外部顧客への売上高はありません。",
        "basis": "【セグメント情報】及び【関連情報】の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
