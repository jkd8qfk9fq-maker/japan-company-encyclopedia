  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業ドメインを従来の「価値ある道具（ツール）の提供」から「顧客に合わせた付加価値を提供」へ拡張することを掲げ、国内では先進テクノロジ提供戦略、段階的拡大（ランド・アンド・エクスパンド）の販売戦略、顧客専門チーム戦略を取っています。グローバル市場では、Atlassianエコシステムから自社開発プロダクトを展開する戦略です。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "Atlassian製品の販売を起点として、導入・運用支援のサービスと自社プロダクトへ収益の場を広げ、大企業の中で一度導入された基盤を足掛かりに利用範囲を広げていく展開です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、事業ドメインの拡張と三つの差別化戦略が記載されています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "日本で最も多くのAtlassian認定技術者を抱えており、高度な要望やAI等の先進的な要望に応えることが可能で、お客様が当社を選ぶ大きな理由の１つであるとしています。また、グローバル市場においてAtlassian社のパートナーランキング上位を維持しているとしています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "Atlassian製品に特化した技術者の厚みを持ち、ライセンス販売、導入支援、運用代行、自社開発の拡張製品までを同じ製品基盤の上で提供できる体制です。",
        "basis": "【事業の内容】に、認定技術者数と、ライセンス販売・SIサービス・マネージドサービス・自社プロダクトの提供形態が記載されています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "日本におけるアジャイル開発の浸透は海外と比較して５年程度のタイムラグがあるものと推察され、アジャイル開発が国内に浸透していく流れの中で、国内におけるAtlassian社のソフトウェア導入は今後も進展していくものと認識しているとしています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "アジャイル開発やDevOpsを支えるAtlassian製品の販売とサービス提供に特化し、大企業を中心とする顧客基盤を持つ事業者です。",
        "basis": "【事業の内容】に、Atlassian製品がアジャイル開発やDevOpsを支える管理システムであることと、当社グループの提供サービスが記載されています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
