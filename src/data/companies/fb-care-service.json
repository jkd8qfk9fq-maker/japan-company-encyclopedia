  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「人生の最終ステージを利用者様の幸せと満足で元気にする」をミッションとし、地域密着で24時間・365日対応し、すべては利用者様のために行動することを経営理念に掲げています。中期経営計画では、福祉用具レンタル品の提供価格の低減や介護技術・接遇の再習得によるサービスの質の維持と向上、需要が高まっているグループホームや訪問介護の拡大、重度の障がい者介護への進出、地方公共団体の公募への対応やM&Aによる提供地域の拡大を基本方針としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "福祉用具から入居系・在宅系の介護サービスまでを一つのグループでワンストップに提供でき、特定の地域に複数の事業所を集中させるドミナント展開により、満室時の他施設への案内やエリア内での人員の融通ができる点が特徴です。福祉用具では営業から納品・契約まで同一担当者が担う一貫専任制と、自社の商品管理センターでの消毒・洗浄・検査による品質管理も強みです。",
        "basis": "事業の内容における、ワンストップ提供、一貫専任制、商品管理センターの設置とドミナント戦略の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "介護保険サービスを総合的に提供する地域密着型の介護事業者で、信越・北関東エリアを地盤に南関東にも展開しています。2026年3月期の売上高は11,533百万円、事業所は117ヵ所、従業員数は993人で、業界内では中堅規模の事業者です。",
        "basis": "事業の内容と主要な経営指標等における、展開地域、事業所数と規模の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
