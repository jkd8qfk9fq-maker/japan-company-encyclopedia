  "businesses": [
    {
      "id": "die-casting",
      "name": "ダイカスト",
      "shortName": "ダイカスト",
      "description": "自動車などの部品になるダイカスト製品とアルミニウム鋳物をつくる事業で、グループの売上の大半を占めます。ダイカストとは、溶かしたアルミなどの金属を金型に流し込んで部品の形にする方法です。2025年12月期の外部顧客への売上高は274,310百万円で、前期より6.4％増えました。会社は、自動車生産の回復で生産量（重量）が増えたことと、原料のアルミ価格の影響で、国内も海外も増収になったと説明しています。リョービミラサカ㈱、リョービミツギ㈱、㈱東京軽合金製作所、生野㈱（アルミニウム二次合金地金）、豊栄工業㈱（アルミニウム鍛造製品）、富士工業㈱（ダイカスト製品の加工）などの国内子会社と、米国・メキシコ・英国・中国・タイの製造会社が担い、事業全体で当社を含め17社です。主な顧客はフォード・モーター（2025年12月期の売上高38,790百万円、総販売実績の12.5％）とゼネラルモーターズ（34,032百万円、11.0％）で、どちらもこの事業の顧客です。",
      "products": [
        "ダイカスト製品",
        "アルミニウム鋳物",
        "アルミニウム二次合金地金",
        "アルミニウム鍛造製品"
      ],
      "customers": [
        "フォード・モーター",
        "ゼネラルモーターズ"
      ],
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【セグメント情報】"
    },
    {
      "id": "printing-equipment",
      "name": "印刷機器",
      "shortName": "印刷機器",
      "description": "オフセット印刷機と印刷周辺機器をつくって売る事業です。2014年1月に三菱重工機械システム㈱（旧 三菱重工印刷紙工機械㈱）との合弁で創業したリョービＭＨＩグラフィックテクノロジー㈱（リョービの議決権60.0％）が担っています。2025年12月期の外部顧客への売上高は23,667百万円で、前期より1.9％減りました。会社は、国内は減収でしたが、海外は増収だったと説明しています。",
      "products": [
        "オフセット印刷機",
        "印刷周辺機器"
      ],
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【セグメント情報】"
    },
    {
      "id": "building-hardware",
      "name": "住建機器",
      "shortName": "住建機器",
      "description": "ドアクローザ（ドアを静かに閉める装置）、ヒンジ、建築金物などの建築用品をつくって売る事業です。当社と、中国の利優比建筑科技（大連）有限公司が担っています。同社は2024年8月に、持分法適用関連会社だった京瓷利優比（大連）机器有限公司を会社分割して建築用品事業を引き継いだ会社で、子会社になりました。2025年12月期の外部顧客への売上高は10,874百万円で、前期より1.5％減りました。会社は、国内も海外も減収だったと説明しています。",
      "products": [
        "ドアクローザ",
        "ヒンジ",
        "建築金物"
      ],
