  "history": [
    {
      "year": 1943,
      "title": "株式会社菱備製作所を設立",
      "description": "1943年12月、ダイカスト製品をつくることを目的に株式会社菱備製作所を設立しました。翌1944年2月にダイカスト製品の製造を始めました。",
      "significance": "現在の中心事業であるダイカストは、この創業時から続く事業です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "東京・大阪にも上場し、オフセット印刷機の製造を開始",
      "description": "1960年6月に広島証券取引所へ上場し、1961年10月に東京・大阪の両証券取引所へも上場しました。同じ1961年12月にオフセット印刷機の製造を始めました。",
      "significance": "ダイカストに続く柱として印刷機器事業が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "ダイカスト製ドアクローザの製造を開始",
      "description": "1963年4月にダイカスト製のドアクローザ（ドアを静かに閉める装置）の製造を始めました。",
      "significance": "現在の住建機器事業につながる製品です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "リョービ株式会社に社名変更",
      "description": "1973年9月に株式会社菱備製作所をリョービ株式会社に社名変更しました。",
      "significance": "現在の社名になった年です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "米国にダイカスト製造・販売会社を設立",
      "description": "1985年6月に米国でダイカスト製品の製造・販売会社シェラー・リョービCORP.（現 リョービダイキャスティング(USA),INC.）を設立しました。1990年には英国、2005年・2010年には中国、2007年にはメキシコ、2011年にはタイにもダイカストの会社をつくりました。",
      "significance": "ダイカスト事業が海外に広がる出発点で、現在は米国の子会社が主要な売上先を支えています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "園芸用機器・電動工具・釣具の事業を相次いで譲渡",
      "description": "2000年から2002年にかけて、米国の園芸用機器事業、電動工具の海外販売・製造会社、釣具事業、欧州・オセアニアの販売会社を、他社へ営業譲渡または譲渡しました。",
      "significance": "ダイカスト・住建機器・印刷機器へ事業を絞る転機になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "印刷機器の合弁会社リョービＭＨＩグラフィックテクノロジーを創業",
      "description": "2014年1月、三菱重工印刷紙工機械株式会社（現 三菱重工機械システム株式会社）との合弁で、印刷機器の製造・販売会社リョービＭＨＩグラフィックテクノロジー株式会社を創業しました。",
      "significance": "印刷機器事業は、この合弁会社が担う形になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "パワーツール事業を京セラへ営業譲渡し、アルミ鍛造のグループ会社を取得",
      "description": "2018年1月にパワーツール事業を京セラ株式会社へ営業譲渡しました。同年4月にはアルミニウム関連製品の旭テックアルミニウム株式会社の全株式を取得し、同社と、その子会社でアルミニウム鍛造製品をつくる豊栄工業株式会社を子会社にしました。同年6月に決算期を3月31日から12月31日に変更しました。",
      "significance": "電動工具から手を引き、アルミを使う製造に力を集める流れが進みました。決算期が12月になったのもこの年です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "中国の建築用品会社を子会社化し、アルミ加工の富士工業を取得",
      "description": "2024年8月、持分法適用関連会社だった京瓷利優比（大連）机器有限公司を事業ごとに会社分割し、建築用品事業を引き継ぐ会社を子会社にして、利優比建筑科技（大連）有限公司へ社名を変更しました。2024年10月にはアルミニウム製品の精密機械加工会社、富士工業株式会社の全株式を取得して子会社にしました。",
      "significance": "住建機器の中国での製造と、ダイカスト製品の加工を、グループの中に取り込みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "ギガキャストの試作工場を建設",
      "description": "2025年3月、菊川工場内に大型部品（ギガキャスト）の試作工場を建設し、試作サービスの提供を始めました。",
      "significance": "ダイカストで大型の部品をつくる試作を、サービスとして始めました。",
