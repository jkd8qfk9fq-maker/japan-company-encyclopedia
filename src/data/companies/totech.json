  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "存在意義「東テクグループはこころ豊かな快適環境を創造します。」のもと、長期ビジョン「ここちよいを、その先へ。」を掲げ、第二次中期経営計画（2031年3月期最終年度）では、人的資本経営の強化を軸に、高収益体質への転換と経営基盤の整備を基本方針としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商品販売事業の売上高は93,786百万円、工事事業は76,193百万円で、販売と工事、保守を一体で手がけています。2026年3月期のダイキン工業からの仕入金額は仕入金額全体の23.4％を占め、主要仕入先との販売代理店・特約店契約を結んでいます。",
        "basis": "2026年3月期のセグメント情報と重要な契約等の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は170,013百万円で、従業員数は2,855人です。データセンターや再開発案件などの需要を取り込み、商品販売事業は前期比4.0％増、工事事業は前期比16.8％増となりました。",
        "basis": "2026年3月期の経営成績の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
