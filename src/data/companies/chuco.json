  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「広告業を通して地域社会への貢献」を理念に、全国の家庭に地域の生活情報を届けるフリーメディアの展開を中長期の目標としています。当期は自社開発システムにAIによる広告制作機能を実装して本格運用を開始し、紙媒体の到達力とデジタルの利便性を組み合わせたハイブリッド広告を進めています。また、株式会社中広ワークインとの連携で求人・採用課題の解決に向けた提案体制を構築したとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "発行エリア内の各家庭へ毎月手配りで届けるフリーマガジンの配布網を持ち、地域の特集記事と生活に役立つ広告情報を組み合わせた誌面を発行しています。広告主には発行エリア内の世帯への高い到達を活かした広告媒体を提供し、求人メディアとの連携も進めています。",
        "basis": "事業の内容、セグメント情報、地域ごとの情報、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要による。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "広告メディア業界では情報伝達や広告手法の多様化が進み、世界的なITプラットフォーマーへのデジタル情報の集約が進んでいます。その中で同社は地域密着の強みとフリーメディアの配布網を活かした広告プラットフォーマーを目指すとしています。売上高は国内のみで、本邦以外の外部顧客への売上高はありません。",
        "basis": "事業の内容、セグメント情報、地域ごとの情報、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要による。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
