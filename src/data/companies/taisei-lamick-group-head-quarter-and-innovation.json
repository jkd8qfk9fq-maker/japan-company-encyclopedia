  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "国内の既存事業では液体小袋包装分野を軸に、付加価値の高い製品やサービスの提供、販売価格の最適化と徹底したコストダウンに取り組み、海外では既存の展開地域に資源を集中して事業基盤の拡大を進めます。あわせて、液体包装に関わる新しいサービスの創出や包装の新分野の研究、環境負荷の低減にも取り組む方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "液体包装フィルムと液体充填機の双方を提供する唯一の企業として、新素材による環境対応フィルムの開発と充填機械との親和性を課題とし、環境負荷の低減と生産性・機能性を両立するソリューションの開発を進めています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
  },
