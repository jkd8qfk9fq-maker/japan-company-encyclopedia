  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業パーパス「Activate Your Life」と経営ビジョン「世界中のお客様から最も信頼されるイノベーションカンパニー」のもと、2026年から2030年までの中期経営計画「INNOVATION30」を策定しました。基本戦略は、事業拡大と成長投資（化粧品事業の拡大、化学品のEHD領域への傾注）、財務・資本戦略の強化、サステナビリティ経営の3つで、2030年の売上高目標を700億円としています。",
        "asOf": "2026-05-01",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "INNOVATION25（2023年から2025年）の最終年度を終え、新計画では化学品のEHD領域と化粧品事業への成長投資に重点を置く方針が示されています。経営環境としては、環境規制の強化や健康・衛生への意識の高まり、AI・デジタル技術の発展による工程革新の加速が、技術力による社会課題解決の機会として挙げられています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の認識と経営戦略の記載、及び【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の概要",
        "asOf": "2026-05-01",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "界面活性剤を核とする界面科学の技術を持ち、繊維化学品では国内の繊維加工メーカーを販売先として取引関係を築いています。中国、韓国、台湾、東南アジアなどに生産・販売子会社を持ち、研究開発でも海外子会社の研究開発部門と連携する体制が示されています。",
        "basis": "【事業の内容】の事業内容と主要な会社、【関係会社の状況】の連結子会社の顔ぶれ、【研究開発活動】の記載",
        "asOf": "2026-05-01",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の外部顧客への売上高は、化学品事業が39,894百万円、化粧品事業が15,259百万円、その他が550百万円でした。地域別では日本が27,714百万円、中国が10,943百万円、その他アジアが9,254百万円、韓国が5,468百万円となっています。売上高の10％以上を占める主要な顧客はないとされています。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高と、関連情報の地域ごとの情報及び主要な顧客ごとの情報",
        "asOf": "2026-05-01",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
