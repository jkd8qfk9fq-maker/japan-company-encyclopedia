  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "成長期待分野を推進充実して経営基盤の安定を図り、優れた工事実績により顧客の信用を高めることを掲げています。新技術・新工法を研究して施工技術の向上を図り、県内における建設技術のトップリーダーを目指すとし、人材採用と人材教育を重要施策としています。主力の建設事業では、営業エリアの拡大と既存顧客・見込客への深耕営業、成長期待分野への参画を強化するとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "建築部門では、基盤的技術の習得と多能型技術社員の育成により品質面を安定させ、小回りのきく展開を図っています。土木部門では、中央官庁やその他の外郭団体から兵庫県及び兵庫県下の市・町に至るまで官公庁取引の窓口が広いことが特徴です。",
        "basis": "事業の内容の建築部門・土木部門の記載と、セグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の大部分は建設事業が占め、2026年3月期の外部顧客への売上高は建設事業22,486百万円、運輸事業267百万円でした。売上は国内のみであり、主要な顧客としてサムティ株式会社と兵庫県多可郡多可町が開示されています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
