  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「光産業を通じ、社会に貢献します」の下、光学製品の総合メーカ「光ソリューション・カンパニー」として、中長期経営方針「Great Reset」を推進し、成長戦略、ビジネスモデルの変革、事業継承・中核人材育成、社会貢献の4つの重点戦略を掲げています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "規格品のカタログ販売で幅広い研究・産業需要を取り込み、特注・OEMの受注生産と要素部品を組み合わせたシステム製品で需要を深掘りする構造になっています。",
        "basis": "事業の内容に、多品種の光学要素部品の規格品を冊子・ウェブのカタログで販売していること、一品特注品から中量産OEM品まで受注生産体制を整えていること、当社グループの光学要素部品を組み合わせたオリジナルの光学システム製品の提供も進めていることが記載されています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "競争力の源泉は、創業から一貫して培ってきた光学製造、機械加工、電気設計、ソフトウェア開発、システムアップ等の中核技術の融合により「光ソリューション」提案を生み出す、企画開発と生産技術が織りなす「ものづくり力」にあるとしています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "1977年の創業以来の光学技術の蓄積に加え、米国・欧州・東南アジア・中国の子会社による生産・販売ネットワークがグローバルな供給体制を支えています。",
        "basis": "関係会社の状況に、米国OptoSigma Corporation、フランスOptoSigma Europe S.A.S.、シンガポールOptoSigma Southeast Asia Pte. Ltd.、ドイツOptoSigma Germany GmbH、中国の上海西格瑪光机有限公司と上海西格瑪総合国際貿易有限公司の子会社6社が記載されています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の大半を要素部品事業が占める光学要素部品のメーカーで、システム製品事業がこれに続く構成です。",
        "basis": "セグメント情報に、2026年5月期の外部顧客への売上高11,439百万円のうち要素部品事業が9,808百万円、システム製品事業が1,631百万円であることが記載されています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
