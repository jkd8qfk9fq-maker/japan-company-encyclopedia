  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "6ヵ年の中期経営計画『Vista2027』の後半3ヵ年（2025年度～2027年度）であるStageⅡを進めています。最重要課題を新製品の創出とし、基本戦略は「現有事業の利益拡大」「2030年を見据えた新製品の開発」「事業基盤の強化」の3つです。成長が見込まれる機能性材料と農業化学品の2つのセグメントへ、M&Aを含めて経営資源を集中的に投下するとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "半導体製造の工程で使われる反射防止コーティング材や多層材料など、特定の工程に欠かせない材料を持っていることが読み取れます。2026年3月期は、半導体材料の好調が機能性材料事業の増収を牽引しました。",
        "basis": "【事業の内容】の製品構成と、MD&Aのセグメント別概況（半導体材料が大幅な増収）に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "農業化学品では、国内販売出荷金額ベースでシェア1位を堅持することを掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
  },
