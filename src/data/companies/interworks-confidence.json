    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、全事業領域で対象領域に特化したカテゴリーNo.1の集合体を目指すことを掲げています。ゲーム業界向けの人材派遣から人材紹介やアウトソーシングへサービスを循環させて深耕するモデルを他の領域へ展開することや、既存領域とその周辺領域を中心としたM&Aの活用を示しています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ゲーム業界に特化して人材派遣・受託・人材紹介を展開し、同じ業界の顧客に複数のサービスを提供できる体制があることが土台になっています。当連結会計年度には映像制作やWeb領域の会社を子会社化し、対象とする領域を広げています。",
        "basis": "【事業の内容】に主力のゲーム会社向け人材派遣サービスとゲーム会社を中心とした顧客からの受託サービスの展開が印字され、【関係会社の状況】に映像企画・制作事業やクリエイター専門の人材サービスを行う連結子会社が印字されていること",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
