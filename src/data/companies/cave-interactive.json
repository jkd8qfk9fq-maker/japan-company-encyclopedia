  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「身近な社員を幸せにすることでエンドユーザーも幸せにする」を掲げています。強固なIPの保有と育成、AIをはじめとする先端技術の活用により新規サービスを順次リリースできる体制を構築すること、グローバル展開を強化すること、製作委員会の仕組みなど複数社でコストや時間のリスクを分け合う方法でコンテンツのリッチ化に対応することなどを進める方針です。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "業務用シューティングゲームの時代から蓄積した自社IPと、スマートフォンゲームの長期運営の実績を持ちます。「ゴシックは魔法乙女」は2026年４月にリリース11周年、「キングダム 乱 -天下統一への道-」は2026年２月に８周年を迎えました。連結子会社の株式会社でらゲーが携わる「モンスターストライク」は人気IPとのコラボイベント等により好調に推移し、グループの収益に大きく貢献しています。",
        "basis": "経営者による分析における各タイトルの周年と運営状況、株式会社でらゲーと「モンスターストライク」の貢献の記述と、【沿革】における業務用シューティングゲーム発売の記録に基づく。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
