  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度にパーパス「Better being」を制定し、2024年4月から2027年3月までの中期経営計画では、あるべき姿を「お客様に愛される日本発・唯一無二のグローバルブランド」を創ることと定めています。重点戦略は、お客様満足度を高める商品・サービスによる新たな価値創造と、持続可能な成長を実現するための人材育成と強い事業基盤構築です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "グループ各社が領域ごとのブランドを持ち、個人向けのパソコン周辺機器から、産業機器向けストレージ、放送・受信関連機器、理美容家電まで、幅広い製品領域を一つのグループでカバーしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の製品・サービス別の外部顧客への売上高は、パワー&I/Oデバイス関連42,996百万円とBtoBソリューション42,909百万円がそれぞれ連結売上高の約3分の1を占め、周辺機器・アクセサリ31,291百万円、家電13,471百万円が続きます。本邦の外部顧客への売上高が連結売上高の90％を超えており、売上の中心は国内です。",
        "basis": "セグメント関連情報の製品及びサービスごとの情報（外部顧客への売上高）と、地域ごとの情報で本邦の売上高が連結売上高の90％を超えるとされていることによる。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
