  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「稼ぐ力」「働く環境の改善」「多様な人材の活用」の3本を経営方針の柱に据え、国土強靭化施策や公共インフラの維持・補修などの需要に対応しながら、高度・先端技術の活用による他社との差別化、コスト競争力と高品質、人材育成と技術者教育の強化に取り組む方針です。",
        "asOf": "2026-01-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "地質調査と建設コンサルタントで長年培った技術力を活かした提案力に加え、防災・減災対策や公共インフラの老朽化対策について調査から設計までを一貫して担える総合力と、環境分野も含む豊富な業務経験が強みです。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、地質調査業及び建設コンサルタント業で長年培った技術力を活かした提案力と、調査から設計までの一貫した総合力、環境分野も含む豊富な業務経験により受注の確保に努めた旨が印字されているため。",
        "asOf": "2026-01-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国や地方自治体などの行う社会資本整備の計画・調査や設計業務を創業以来続けてきた会社で、地域の業界におけるリーディングカンパニーとしての地位を確立してきたと自ら位置づけています。防災・減災対策やインフラ老朽化対策の需要が続く環境の中で事業を行っています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、創業以来、国や地方自治体などの行う社会資本整備の計画・調査や設計業務を行い、地域の業界におけるリーディングカンパニーとしての地位を確立してきた旨と、防災・減災対策や公共インフラの老朽化対策の需要が予想される旨が印字されているため。",
        "asOf": "2026-01-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
