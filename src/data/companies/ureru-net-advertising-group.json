  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年７月期を「グループの力で利益を生み出す一年」と位置付け、中期の方針「GROWTH STRATEGY 2027」で、①各事業セグメントの収益力向上、②グループシナジーの創出、③M&Aによる持続的な成長、④AI活用による生産性及び収益性の向上、⑤新たな成長事業の創出、の５つの重点戦略を推進するとしています。各事業の収益力向上、グループシナジーの創出及びコスト構造の改善を進めることが重要な経営課題であると認識しています。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "上場後はM&Aと新規事業への投資で事業領域を広げており、2026年７月期にはデジタルアセット・Web3事業を新しい報告セグメントに加え、中国の広告会社２社を子会社化するなど、４事業体制への拡大が続いています。一方で損失の計上が続いており、既存事業の収益性の改善と財務基盤の強化が課題として印字されています。",
        "basis": "【事業の内容】の４事業の構成、【沿革】の子会社化の履歴、セグメント情報の変更に関する記載に基づく。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「売れるD2Cつくーる」の最大の競争優位性は、創業以来実施した2,600回以上のA/Bテストの結果のうち、５社中４社以上で広告の費用対効果の改善があったノウハウが反映されているサービスであることだとしています。専門的な知識がなくても、10項目を入力することでランディングページ制作からフォロー配信までを実施できる機能も備えています。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "主力事業が属するインターネット広告市場は成長を続けており、一方で景品表示法や医薬品医療機器等法などの規制は厳しさを増し、より慎重な広告表現が求められる状況だとしています。法規制を遵守しながらA/Bテストを繰り返し、広告効率の向上に努めているとしています。",
        "asOf": "2026-10-26",
        "sourceIds": [
          "yuho-2026"
        ],
