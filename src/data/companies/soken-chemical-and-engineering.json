  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2032年のありたい姿として長期ビジョンを掲げ、2026年度を初年度とする3カ年の中期経営計画「Advance 2028」では、事業ポートフォリオの変革による新たな成長軌道の構築を目指しています。重点戦略は、ASEAN・インド地域での事業拡大（タイ拠点の機能強化とインド市場への本格展開に向けた販売体制の強化）、既存事業と親和性の高い事業領域への参入（アカデミア・スタートアップとの連携の強化）、既存事業領域の収益力強化（国内事業拠点の新設・再編や高付加価値製品の市場投入）です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1963年にアクリル系樹脂の生産を始めて以来の粘着剤を中心に、微粉体、特殊機能材、加工製品までを自社で製造・販売する製品の幅が特徴です。中国の蘇州、寧波、南京とタイに生産子会社を持ち、中国の子会社には製品開発組織も置いて、液晶ディスプレイ関連の中国市場で現地のニーズに対応する体制を整えています。",
        "basis": "事業の内容（ケミカルズの製品区分と担う連結子会社）、関係会社の状況（海外連結子会社の所在地と事業内容）、研究開発活動（中国の子会社に製品開発組織を置く旨）、MD&Aの概要（中国市場における技術対応力の強化）の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高の大部分はケミカルズで、2026年3月期の外部顧客への売上高は438億24百万円です。装置システムは41億43百万円です。地域別の売上高は中国向けが最も大きく、次いで日本向けであり、その他の地域向けが続きます。主要な顧客であるSojitz (Shanghai) Co., Ltd.向けは売上高の12.2％を占め、関連するセグメントはケミカルズです。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報、主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
