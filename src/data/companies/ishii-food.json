  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2022年度－2026年度）で ISHII VISION2030「農と食卓をつなぎ、子育てを応援する企業に」を掲げ、「子育て」をはじめとする様々なお客様の生活シーンを支え、ライフスタイル変革につながる食サービスの最大化を目指すとしています。中長期的には、地域の生産者や行政等との連携を深めて地域食材を活かした旬の季節商品を開発すること、消費者の食生活の課題を解決する商品を開発すること、不採算商品の終売やリニューアルを進めること、理念を共有する販売チャネルとの関係を強化すること、機械化・自動化・省力化への投資による生産性の向上などに取り組むとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "地域の生産者と連携して開発する「地域と旬」の商品群と、食肉加工品の主力商品を組み合わせ、子育て世帯をはじめとする生活シーンに向けた商品展開を進める方向です。",
        "basis": "経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "素材本来の味を活かす「無添加調理」の技術、自社の社員の目で確認する「厳選素材」、原材料の履歴情報を開示する「品質保証番号」の３つを原則として掲げています。京丹波工場内には食物アレルギー配慮食の専用工場を設けています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と沿革に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の86.7％を食肉加工品が占める構成で、量販店（スーパーマーケット他）向けが販売の中心です。2025年３月の価格改定後も主力商品の売上高は堅調に推移し、常温品のラインナップはローリングストックや外出時の利用など幅広い場面で取り扱いが広がったとされています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
