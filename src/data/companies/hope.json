  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年3月期を初年度とする3か年の中期経営計画では、適切な資源配分によるオーガニック成長の実現、堅実な投資による事業価値の創出、リスクマネジメント機能の強化、資本配分方針と財務の規律付け、攻守兼ね備えた強固なミドル層の構築に取り組むとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "広告事業を利益を生む基盤の事業、ジチタイワークス事業を成長をけん引する事業と位置づけ、企業版ふるさと納税支援事業と空き家対策関連事業アキソルを次の柱として育てる構成になっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等に、広告事業は利益創出事業、ジチタイワークス事業は成長をけん引する花形事業と位置づけ、企業版ふるさと納税支援事業とアキソルを次なる事業の柱とする旨が記載されていることによるものです。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2005年の創業以来、自治体の財源確保支援を続けて築いた自治体とのネットワークと取引のノウハウが、広告事業とジチタイワークス事業に共通する基盤になっています。行政マガジン『ジチタイワークス』を全国の自治体と地方議会議員に無償で届ける接点も、自治体との関係を保つ役割を担っています。",
        "basis": "事業の内容に、広告事業で培った自治体との関係をジチタイワークス事業に活用する旨と、行政マガジンを全国1741自治体と47都道府県、地方議会議員へ無償提供している旨が記載されていることによるものです。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "自治体の広告事業は、2004年度に横浜市が専門組織を立ち上げて全国へ広がった分野で、同社は2006年にSRサービスを開始した初期からの事業者です。",
        "basis": "事業の内容に自治体広告市場の立ち上がりの経緯が記載され、沿革に2006年のSRサービス開始が記載されていることによるものです。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
