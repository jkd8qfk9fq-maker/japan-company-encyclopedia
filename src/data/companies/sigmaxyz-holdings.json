  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「Create a Beautiful Tomorrow Together」、ミッション「企業のトランスフォーメーションを推進し、クライアント、パートナーと共にSDGsの達成に貢献する」のもと、デジタル経済下で企業が取り組むべき「3つの変革」の実現を目指しています。2030年3月期の「ありたい姿」に向け、クライアント企業の深耕力強化、顧客ポートフォリオの再編やオファリング開発への投資・資本提携等の戦略的パートナーシップ強化による事業モデルの進化、AI活用・投資による能力と生産性の向上を重点課題としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客にとっての「シェルパ」として、経営課題の解決に向けた戦略立案からビジネスモデルの設計、事業運営基盤の設計・構築・導入までを顧客と共に行う伴走型の進め方が特徴です。成果に必要な能力は自社、ビジネスパートナー、顧客企業や投資先を含む社内外のネットワークから集めて組み合わせる「アグリゲーション」でプロジェクトチームを組成します。コンサルタント数は2026年3月期に692名へ増加しました。",
        "basis": "【事業の内容】のシェルパ・アグリゲーションの説明、MD&Aの経営方針・経営戦略等の客観的な指標（コンサルタント数）",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "運輸、金融、情報通信、小売、商社、建設を中心に170社超の顧客へプロジェクトを提供しています。日本郵船株式会社の基幹システム導入支援は、2026年3月にSAPジャパンのパートナー表彰で最優秀賞「プロジェクト・オブ・ザ・イヤー」に選出されました。前期に売上高の13.4％を占めた主要顧客は当期は10％未満となり、当期は売上高の10％以上を占める顧客はありません。",
        "basis": "MD&Aの経営成績等の状況の概要、セグメント関連情報の主要な顧客ごとの情報",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
