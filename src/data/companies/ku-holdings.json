  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「信頼と安心を通じ豊かなカーライフの創造」を基本理念に、多様なメーカーの新車・中古車を取り扱う「トータルディーラー」を目指します。企業規模の追求ではなく、売上高の収益性と総資産の効率的な活用を意識した経営を志向します。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国産車販売事業と輸入車ディーラー事業の二つの事業を持ちます。輸入車ではメルセデス・ベンツ車やBMW車を中心に扱い、国産車では中古車販売を中心とします。子会社6社で販売と修理を行います。",
        "basis": "【事業の内容】と【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "自動車販売業界では、2026年3月期の新車登録台数は軽自動車を含め452万台で前期比0.9％減、中古車登録台数は649万台で同0.6％増、外国メーカー車の新車登録台数は23万台で同3.4％増でした。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
