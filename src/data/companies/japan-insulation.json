  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年6月に策定した中期経営計画（2024～2026年度）で「サステナビリティ経営の推進」を基本テーマに掲げ、需要家のカーボンニュートラル化への対応による事業拡大、耐火建材の機能向上や高耐熱製品の開発による防災まちづくりへの貢献、研究生産体制の整備や人的資本経営の推進などを重点方策としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の中心は、保温・断熱と耐火・耐熱という自社の材料技術を、顧客のカーボンニュートラル対応や建物の防災といった社会的な要請に結びつけて需要を取り込むことに置かれています。",
        "basis": "経営方針に、主たる事業である保温・断熱材、耐火・耐熱材の製造販売・施工はSDGsに貢献するものであり、会社の存在意義はサステナブルな社会の実現に貢献することにあると記載されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "1966年に世界で初めて1000℃の耐熱性を有するゾノトライト系けい酸カルシウム材の製造技術を開発して以来、耐火・耐熱分野で製品開発と用途開拓を進めてきた技術力を基盤としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "製品の製造だけでなく施工請負までを自社グループで担う一貫体制があり、現場の改善要望を製品設計へ戻せることが、品質の担保と受注の基盤になっています。",
        "basis": "事業の内容に、製造と施工を一貫して行うことで顧客の改善要望を製品設計に円滑に反映する体制を保持していると記載されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業はプラント関連と建築関連の2つの報告セグメントからなり、2026年3月期の外部顧客への売上高はプラント関連が全体の約3分の2を占めています。製品は高層建築物や石油化学プラント、火力・原子力発電所などで、耐火材、不燃材、保温材として幅広く使われています。",
        "basis": "セグメント情報に、報告セグメントは建築関連とプラント関連の2つで、2026年3月期の外部顧客への売上高はプラント関連9,278百万円、建築関連5,114百万円と記載されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
