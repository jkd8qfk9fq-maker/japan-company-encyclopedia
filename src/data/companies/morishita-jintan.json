  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業130周年を機に策定したパーパスのもと、仁丹から発展した球体技術や素材研究を基盤に製品・サービスを提供し、コンシューマー事業とソリューション事業を両輪としてバランスよく成長させることで、安定的かつ強固な収益基盤の構築を目指すとしています。2026年度は基盤強化と収益構造の再構築のための期間と位置づけ、大阪・中之島の新拠点への研究開発機能の集約や、シームレスカプセルの生産能力の増強を進めています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "シームレスカプセル製剤技術と仁丹以来の素材研究を自社製品と受託事業の両方で活かせることが強みです。コンシューマー事業で培った技術や知見が、ソリューション事業の受託や原料販売における差別化の要素になっています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、コンシューマー事業で培った技術や知見はソリューション事業におけるシームレスカプセル受託や原料販売において差別化の要素として活用されており、両事業の間で相互にシナジーを創出している旨が印字されているため。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "健康関連製品の市場では異業種を含む大手企業の新規参入が続き競合が激化する中で、1893年の創業以来のブランドと製剤技術を基盤に、自社製品の販売と事業会社向けの受託支援の両輪で事業を展開しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、異業種を含む大手企業の新規参入など更なる競合激化が続いている旨が印字されているため。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
