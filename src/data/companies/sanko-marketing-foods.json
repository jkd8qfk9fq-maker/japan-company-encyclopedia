  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "水産6次産業化について、全ての供給網を自社グループだけで抱える形から、漁業や水産加工など収益の変動が大きい一部の事業は縮小や撤退を進めて外部の提携先で補う形へ移し、経営資源を強みである飲食事業へ重点的に投入する方針です。あわせて、日常食であるうどん業態の展開やデリバリー売上の育成、商流と物流の整理による費用の低減を進めます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年6月期には、うどん事業「うどん 038」の譲受けや「アカマル屋」の新規出店が行われており、開示された方針にある日常食への展開と水産の供給網を活かす店舗の出店が実際に進められています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "飲食店舗の運営で培った経験に加え、豊洲市場の荷受けを行う綜合食品などのグループ会社を通じて産地から水産物を調達できる供給網を持ち、店舗で使う食材の調達と外販を一体で行える点が特徴です。",
        "basis": "事業の内容、関係会社の状況、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
