  "history": [
    {
      "year": 1949,
      "title": "前身によるコントロールケーブルの生産開始",
      "description": "実質上の存続会社の前身は、1949年1月から兵庫県宝塚市で宝塚索導管株式会社としてコントロールケーブルの生産販売を行っていました。",
      "significance": "現在の主力製品であるコントロールケーブルの事業は、この前身にさかのぼります。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "宝塚索導管株式会社を設立",
      "description": "東洋機械金属株式会社の宝塚索導管製作所と三田工場、東京・名古屋・広島の営業所を譲り受け、コントロールケーブルの製造販売を目的として、兵庫県宝塚市に宝塚索導管株式会社を設立し、営業を開始しました。",
      "significance": "現在のハイレックスコーポレーションの直接の起源です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "新製品HI-LEXの製造・販売開始",
      "description": "兵庫県氷上郡（現・丹波市）に柏原工場を新設し、新製品HI-LEX（プッシュ・プルケーブル）の製造と販売を始めました。",
      "significance": "製品名「HI-LEX」は、のちに社名にも使われました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1971,
      "title": "商号を日本ケーブル・システム株式会社に変更",
      "description": "商号を宝塚索導管株式会社から日本ケーブル・システム株式会社に変更しました。",
      "significance": "この商号は2006年まで使われました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "韓国TSK株式会社を設立",
      "description": "大韓民国慶尚南道馬山市（現・昌原市）に韓国TSK株式会社を設立しました。海外子会社の設立は沿革の中で最も早いものです。",
      "significance": "海外生産の始まりで、現在のアジア事業につながります。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1975,
      "title": "米国にHI-LEX CORPORATIONを設立",
      "description": "米国ミシガン州バトルクリーク市にHI-LEX CORPORATION（現・HI-LEX AMERICA INC.）を設立しました。",
      "significance": "現在の最大の地域セグメントである北米事業の起点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
