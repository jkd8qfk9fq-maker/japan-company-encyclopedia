    "strategy": {
      "disclosed": {
        "text": "自動車用ドアクロージャーシステム製品とモジュール製品で世界のトップサプライヤーとなることを目指しています。2025年11月にグループに迎えたハイレックスアクトとの技術の融合による新たな付加価値の創出をはじめ、提案力の向上や人財への投資など4つの重点課題を掲げています。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "力とエネルギーを最適に伝えて遠隔コントロールする機構と制御システムの開発力・技術力に加え、基幹部品の内製力、品質、供給能力、グローバルな事業展開力を強みとしています。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【重要な後発事象】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "自動車部品の専業メーカーで、生産と販売を日本・北米・中国・アジア・欧州・南米の6地域に広げています。主要な顧客である自動車メーカー4社向けの売上高は、いずれも全体の10％以上を占めています。",
        "basis": "セグメント注記の主要な顧客ごとの情報（起亜36,674百万円、現代自動車34,699百万円、トヨタ自動車34,525百万円、Stellantis N.V.31,627百万円）と、販売実績に対する割合（各社10％以上）、6つの地域別報告セグメントに基づく。",
        "asOf": "2026-01-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
