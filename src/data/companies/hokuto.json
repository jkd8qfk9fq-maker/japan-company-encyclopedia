  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として、健康食材であるきのこの研究、生産、販売を通じ、消費者の皆様、お取引先、地域社会、株主の皆様の信頼と期待に応えることを掲げています。経営ビジョン「きのこで健康を届けることを使命に市場と消費を拡大する」のもと、健康・美容・スポーツを３本柱とした「きのこで菌活」を提唱し、独自品種の霜降りひらたけの認知向上や、新中期経営計画に掲げた新規開拓、エリア戦略などを推し進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "新品種の開発から栽培、販売までを一貫して手がけ、きのこ総合研究所を中心に品種改良と栽培技術の開発を続けています。全国33ヵ所の生産センターから収穫翌日には店頭へ届ける供給体制を持ち、霜降りひらたけなど付加価値の高い独自品種を展開しています。きのこの培地原料の一部はインドネシアの子会社で生産し、原料調達の安定化も図っています。",
        "basis": "【事業の内容】における生産センターと供給体制の記述、【研究開発活動】における新品種開発・栽培技術開発の記述、経営成績等の分析における独自品種の取組に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内きのこ事業が連結売上高の約3分の2を占め、生鮮きのこの生産・販売が中核です。2026年3月期の外部顧客への売上高は、国内きのこ事業が560億77百万円、化成品事業が135億98百万円、海外きのこ事業が82億36百万円、加工品事業が80億３百万円です。連結売上高の10％以上を占める主要な顧客はなく、販売先は分散しています。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、関連情報の主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
