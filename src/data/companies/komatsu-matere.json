  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「KFW-2026」では、事業領域の拡大と基盤強化を基本方針とし、2027年3月期を最終年度としています。優先的に対処すべき課題として、海外事業の拡大、サステナブル商材・事業の推進、製品事業の推進、人材育成の強化とエンゲージメントの向上、製造環境の整備と福利厚生面の充実の5つを掲げ、売上高については420億円を目標としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "5つの課題は、海外販売の拡大と環境配慮型素材の拡充、製品事業の推進を、人材と製造環境の基盤整備で支える構成になっています。MD&Aでは、2025年10月に低膨潤高透湿防水ファブリックを、2026年2月に製品染めの新ブランドを発表したことが、新たな付加価値素材の開発と市場提案として述べられています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中期経営計画と優先的に対処すべき課題の記載、及びMD&Aの経営成績等の概要における新素材・新ブランド発表の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "絹・人絹織物の精練・染色加工から始まり、合繊織物の染色・捺染加工へ広げてきた加工技術が基盤です。研究開発では技術開発本部を核にグループ各社や産地協力企業、大学や公設試験場との共同研究を進め、環境配慮型素材群の開発を主軸としています。当連結会計年度末現在の特許及び実用新案の所有は113件、出願中は20件と述べられています。",
        "basis": "【沿革】の創業事業と合繊加工開始の記載、及び【研究開発活動】の体制と環境配慮型技術開発、特許及び実用新案の件数の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは繊維事業とその他の事業で、繊維事業の外部顧客への売上高41,063百万円が連結売上高41,563百万円の大半を占めます。地域別の売上高では日本が最も大きく、次いで中近東、北米、ヨーロッパの順で、海外販売が広い地域にわたっています。主要な顧客として東レ株式会社が、繊維事業に関連する顧客として開示されています。",
        "basis": "セグメント情報の外部顧客への売上高と、関連情報の地域ごとの売上高及び主要な顧客ごとの情報の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
