  "updatedAt": "2026-11-22",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「自己実現のための投資」という共通軸を持つ美容医療と学びの両事業領域に投資を続け、単に情報を届けるだけでなく、ユーザーの「なりたい姿」を伴走型で支援するサービスへ深化させることを使命としています。独自のデータ利活用によるマッチング精度の向上として「プラットフォームとしての信頼ブランド」を確立し、広告市場の動向に左右されない、独自の付加価値を源泉とした持続的成長の実現を目指しています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1999年12月にサービスを開始したポイントタウンをはじめとする自社メディアの運営で、集客してリピーターを作るノウハウを蓄積している点が特長です。そのノウハウを美容医療や学びの成長市場向けサービスや、社外メディアの収益化支援にも展開しています。",
        "basis": "事業の内容に、ポイント・ゲームプラットフォーム事業で培った集客してリピーターを作るノウハウを活かして成長市場に向けたサービスを展開していること、ポイントタウンは1999年12月にサービスを開始したことが印字されているため。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはメディア事業とソリューション事業の2つで、2025年12月期はメディア事業が売上高の中心を占めています。メディア事業の中ではポイント関連が基盤で、学び関連と美容医療関連を成長領域として展開する構成です。",
        "basis": "セグメント情報に、2025年12月期の外部顧客への売上高はメディア事業6,435,238千円、ソリューション事業679,787千円と印字され、事業の内容にメディア事業の内訳としてポイント関連事業、学び関連事業、美容医療関連事業が印字されているため。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
