  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営ビジョンを「独立系情報サービス企業として、持続的な企業価値向上と社会への貢献」と定め、2024年4月からの中期経営計画「Growing Value 2026」では、提供価値である品質・効率性・専門性・ノウハウを組み合わせたサービスの質を高めてカスタマーサクセスへ貢献することを基本方針とし、価値提供モデルへの転換、アセットベースビジネスの拡大、顧客基盤の強化、人材・組織力の強化、各社の強みや特徴を活かしたグループ経営の展開の5つを基本戦略に掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、SI分野の売上高が14,852百万円（前期比6.2％増）、DX分野が2,461百万円（前期比11.6％増）と、両分野とも増収になりました。DX分野では勤怠管理などの自社開発システム関連の販売や、データ活用基盤構築の受注が伸びています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（事業分野別の業績）に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金融・保険・公共など公益性の高い分野に長年にわたりシステム開発を提供し、顧客との信頼関係を築いてきました。社内に蓄積された多くのナレッジ・ノウハウを知的財産として位置づけ、プロジェクトで蓄積されるノウハウや技術をアセット化して再利用する取り組みを進めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等（対処すべき課題）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
