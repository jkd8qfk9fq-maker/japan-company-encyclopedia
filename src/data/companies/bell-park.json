  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期的な数値目標は掲げず、事業の方向性や成長戦略等の定性的な目標（中期定性目標）を掲げる方針です。優先的に対処すべき課題として、情報通信機器販売サービス事業の成長、多様な人材の採用と育成、働きがいのある職場環境の整備など4つの経営課題を挙げ、キャリアショップ事業で着実な成長を続けながら、法人ソリューション事業の拡大によりバランスの良い事業ポートフォリオの構築を目指しています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "当社の強みとして、人材育成力、店舗運営力及び強固な財務基盤を挙げています。料金体系が複雑化する中では、金融・決済サービスと連携した料金プランの分かりやすい提案や、利用状況に応じた有償サポートサービスの提案を強化しています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高の内訳は、商品売上高81,030百万円と受取手数料48,270百万円で、端末等の商品販売が過半を占めています。相手先別ではソフトバンク株式会社向けが44,369百万円と全体の34.3％を占めており、特定の通信事業者との関係が売上構成に大きく影響する事業です。",
        "basis": "販売実績（商品売上高・受取手数料の内訳）と主要な顧客ごとの情報（ソフトバンク株式会社向け売上高と割合）による。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
