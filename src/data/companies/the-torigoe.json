  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-20",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年12月期を初年度とする3カ年の中期経営計画「TTC150 Stage３」を策定し、その最終年度に当たる2026年12月期に向けて、製粉事業では顧客に選ばれる製品の創出と生産性や品質の向上につながる設備投資、食品事業では顧客ニーズを捉えたスピード重視の製品開発、精麦・飼料事業では原料と品質にこだわり鳥越グレインホールディングス株式会社傘下の精麦・飼料事業4社の強みを活かした体制の構築、デジタル技術を使った企業革新、IR強化と株主還元に取り組んでいます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製粉と精麦の両方を手がけ、精麦・飼料事業は鳥越グレインホールディングス株式会社を中間持株会社とする4社体制で運営しています。食品では、ドイツのCSM社（ウルマ・シュパッツ）との業務提携による商品の仕入れ販売など、海外企業との提携による商品調達も行っています。",
        "basis": "【関連情報】の製品及びサービスごとの情報、【事業の内容】の区分別の事業内容、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における区分別の状況の記載に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "単一セグメントの中で製粉が最大の区分であり、2025年12月期は業務用小麦粉の出荷数量が増加した一方、輸入小麦の政府売渡価格の引き下げに伴う製品価格の値下げで減収となりました。精麦は販売価格の上昇と食料用大麦の出荷数量の増加により増収となっています。",
        "basis": "【関連情報】の製品及びサービスごとの情報と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における区分別の状況の記載に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
