  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針では、1987年の創業以来、時代のニーズに合わせた商品・サービスを「企画力と営業力」を強みとして提供してきたこと、今後もこの強みを活かして新市場の創造に挑戦することを掲げています。対処すべき課題として、エンベデッド・ファイナンス事業では工業分野への進出と周辺領域の開拓、キュービクル式高圧受電設備の提供強化と電気工事部門の強化、公共工事等の大型案件への取り組み体制の整備を挙げ、メディア・プロモーション事業では「アクセルジャパン」の金融機関との連携強化や電子雑誌「旅色」の自治体タイアップ広告におけるSBIグループとの連携強化、新規事業の創出による成長の加速を掲げています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "報告セグメント別の外部顧客への売上高では、エンベデッド・ファイナンス事業が23,233百万円と全体の8割を超え、メディア・プロモーション事業が5,167百万円、その他事業が31百万円です。主要な顧客ごとの情報では楽天銀行が最大の販売先として開示されており、地方銀行や信用金庫との業務提携による紹介案件の増加がMD&Aで拡大要因として説明されています。",
        "basis": "セグメント情報の報告セグメントごとの売上高と主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本全国に30か所以上の営業拠点を設け、全国規模で展開できる提案型の営業力を強みとして経営方針とMD&Aの双方で説明しています。また、地方銀行や信用金庫をはじめとする提携金融機関を着実に増やし、提携先からの紹介による案件獲得の経路を広げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
