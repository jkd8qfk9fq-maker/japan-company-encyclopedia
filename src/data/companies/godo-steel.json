  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『持てる資源を最大限に活かし製造実力の向上で、ゆるぎないコスト競争力の確立、新たな商品価値の創造　資源循環の担い手としての企業価値の一層の向上を目指す』をスローガンに掲げています。2026年度からの「合同製鐵グループ中期ビジョン2030」では「Proactive×Challenge」を行動方針とし、成長投資の実現、人的資本投資の強化、サステナビリティの推進等により、収益力の復元・向上と財務体質の改善を図ります。売上高の目標は2,250億円としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電炉メーカーとして鉄スクラップを原料とする鉄鋼リサイクルシステムの一翼を担い、線材・形鋼・棒鋼などの多様な条鋼類を製造・販売しています。朝日工業、三星金属工業、トーカイを含めた６つの製造拠点をもつ事業所体制で、グループ全体の業務効率化と営業力強化を進めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略等の記載及び【事業の内容】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、鉄鋼事業が174,307百万円で連結売上高の9割以上を占め、農業資材事業が12,716百万円、その他事業が4,748百万円でした。本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
