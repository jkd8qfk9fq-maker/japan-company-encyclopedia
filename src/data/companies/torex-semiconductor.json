  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「Powerfully Small!」を製品づくりの目指すべき姿と定め、開発から営業まで電源用ＩＣに特化したアナログ技術のプロ集団として、低消費電力・小型化のための技術と提案能力を磨くとしています。重点分野と考える産業機器・車載機器の市場に向け、高付加価値製品の開発・販売に注力し、長期ビジョンとして「省エネ小型電源」のリーディングカンパニーを目指すとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の地域別内訳は、日本が17,373百万円で全体の69.3％を占め、アジアが5,677百万円、欧州が1,366百万円、北米が656百万円です。製品別ではディスクリートが14,315百万円と過半を占め、レギュレータ（ＶＲ）が4,714百万円、ＤＣ／ＤＣコンバータが3,466百万円、ディテクタ（ＶＤ）が1,811百万円、その他が764百万円となっています。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高、関連情報の製品及びサービスごとの情報、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "高度なＩＣ設計技術と、超小型・薄型のチップサイズパッケージが製造可能な自社開発のパッケージ技術「ＵＳＰ」を強みとしています。アナログ技術は技術者の能力への依存性が高く容易にコピーすることが難しいため、付加価値の高い分野と印字されています。製造は外部委託を原則とする一方、グループ内に前工程のフェニテックセミコンダクター株式会社と後工程のベトナム子会社を持ち、ファブレス企業と自社生産企業の双方のメリットを併せ持つ体制としています。",
        "basis": "事業の内容の製品内容と事業内容、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
