  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「空間から未来を描き、人と社会に丹青（いろどり）を。」のもと、こころを動かす空間づくりに取り組んでいます。2024年2月には、創業100周年にあたる2046年に向けた「私たちの未来ビジョン２０４６」を策定しました。中期経営計画（2025年1月期～2027年1月期）では、働き方と人的資本の基盤整備、マーケティングの基盤整備、サプライチェーンの基盤整備、サステナビリティ対応の基盤整備、新たな領域への挑戦を重点施策とし、直近の事業環境を踏まえて最終年度の財務目標を上方修正しました。事業別では、商業その他施設事業でエンターテイメント分野やホテル、スタジアム・アリーナの新改装需要の取り込み、チェーンストア事業で既存顧客のシェア拡大とメンテナンス分野の拡大、文化施設事業で地域創生や官民連携に関連した案件を中心とした受注拡大を掲げています。",
        "asOf": "2026-04-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "調査・研究から企画、設計、施工、監理までをグループで一貫して担える体制を持ちます。制作面は丹青TDCと丹青ディスプレイが施工を、ソフト面は丹青研究所が文化施設に関する調査・研究を、JDNがWebサイトを活用した情報提供サービスを担い、分業しながら連携しています。1970年の日本万国博覧会以来、つくば科学博、2005年日本国際博覧会、2025年の大阪・関西万博と、大型博覧会のパビリオンの展示・内装を繰り返し担当してきた実績があります。",
        "basis": "事業の内容、沿革、関係会社の状況に基づきます。",
        "asOf": "2026-04-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは商業その他施設事業、チェーンストア事業、文化施設事業の3つで、このほかに報告セグメントに含まれない「その他」があります。2026年1月期の外部顧客への売上高は、商業その他施設事業が72,154百万円（前期比32.6％増）で最も大きく、チェーンストア事業が25,619百万円（同5.4％減）、文化施設事業が8,929百万円（同10.0％減）、その他が519百万円（同12.3％増）です。本邦の外部顧客への売上高が連結売上高の90％を超えるため、地域ごとの情報は省略されています。売上高の10％以上を占める顧客はいません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づきます。",
        "asOf": "2026-04-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
