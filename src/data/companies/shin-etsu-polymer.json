  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年11月に、2030年3月期を最終年度とする中期経営計画「Shin-Etsu Polymer Global & Growth 2029」（略称SEP G&G 2029）を公表しました。事業戦略として、成長領域における新規用途の獲得と積極的な投資、基盤領域における独自製品の拡販と生産性の向上、海外売上比率の拡大を掲げています。財務・非財務戦略では、成長領域への重点的な投資の継続や株主還元の強化、ESGへの取組みの強化を進めるとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "技術展開の核となる基盤技術は、シリコーンや各種プラスチック、導電性素材をキーマテリアルとした「材料・配合」「設計」「加工プロセス」「評価・解析」であるとしています。これらの基盤技術を深耕・応用し、幅広い分野で顧客のニーズに応えることを研究開発の使命としています。精密成形品では、独自の精密加工技術と評価技術をベースに、次世代半導体ウエハー用の搬送容器や、次世代半導体パッケージに対応した搬送テープの開発に取り組んでいます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【研究開発活動】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は、精密成形品事業が59,773百万円と全体の過半を占め、電子デバイス事業が25,726百万円、住環境・生活資材事業が21,513百万円、その他が8,103百万円と続きます。地域別では日本が51,508百万円、中国が23,099百万円、その他の地域が40,507百万円で、海外向けが国内向けを上回っています。親会社の信越化学工業から原材料を仕入れ、同社グループの一員として、アジア・欧州・米国に生産・販売子会社を持つ体制で事業を展開しています。売上高の10％以上を占める特定の顧客はなく、顧客は分散しています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報、関係会社の状況に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
