  "businesses": [
    {
      "id": "fan-communications",
      "name": "株式会社ファンコミュニケーションズ",
      "description": "東京都渋谷区に本社を置き、当社と連結子会社3社でグループを構成しています。CPAソリューション事業と戦略事業の2事業を営み、2025年12月期の連結従業員数は356人です。東京証券取引所プライム市場に上場しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "cpa-solutions",
          "name": "CPAソリューション事業",
          "description": "アフィリエイト広告サービス「A8.net」と、スマートフォンアプリ向けCPI広告サービス「A8app」を運営する事業です。広告主のサイトで購買や会員登録などの成果が発生したときに、広告媒体となるパートナーサイトへ成果に応じた報酬を支払う仕組みで、各広告の成果の計算、広告主からの広告料の回収、パートナーサイトへの報酬の支払いを当社が担います。2025年12月期の外部顧客への売上高は5,660百万円です。",
          "customers": [
            "インターネット上でマーケティング活動を行う企業（広告主）",
            "広告媒体となるサイトを運営する企業や個人（パートナーサイト）"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "strategic",
          "name": "戦略事業",
          "description": "お笑いラジオアプリ「GERA」、オンラインコミュニティサービス「YOOR」、デジタルマーケティングプロセス最適化支援サービス「N-INE」などを運営する事業です。連結子会社の株式会社WANDがインフルエンサーマーケティングの「LUMOS BUZZ」を、株式会社ファンコミュニケーションズ・グローバルが海外広告主の日本市場進出の支援やゲームアプリ事業を手がけています。2025年12月期の外部顧客への売上高は1,435百万円です。",
          "customers": [
            "デジタルマーケティングを活用する企業",
            "アプリやオンラインサービスの利用者"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        }
      ]
    }
