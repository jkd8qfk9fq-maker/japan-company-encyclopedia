  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "太陽光発電所の仕入販売や売電などを継続的に推進するとともに、系統用蓄電所やポータブル蓄電池、低炭素冷媒事業といった新たな事業領域の開拓に取り組み、収益基盤の強化を図るとしています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
