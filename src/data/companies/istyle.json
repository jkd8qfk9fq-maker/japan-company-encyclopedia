  "history": [
    {
      "year": 1999,
      "title": "有限会社アイ・スタイルを設立し「@cosme」を開始",
      "description": "1999年7月、化粧品に関する消費者情報をデータベース化し、企業のマーケティング活動を支援することを目的として、有限会社アイ・スタイルを東京都世田谷区に設立しました。同年12月、インターネットのコスメ情報ポータルサイト「@cosme（アットコスメ）」をオープンしました。",
      "significance": "創業と@cosmeの開始が、現在のプラットフォーム事業の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "株式会社化し、メディア事業を開始",
      "description": "2000年4月に株式会社アイスタイルへ組織変更しました。同年6月に化粧品メーカーへの各種マーケティング支援サービスを本格的に始め、同年7月に「@cosme」で広告枠の販売を開始してメディア事業の運営を始めました。",
      "significance": "メーカー向け支援と広告販売が、現在のマーケティング支援事業の原型です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "EC事業を開始",
      "description": "2002年11月、化粧品オンラインショッピングサイト「cosme.com（コスメ・コム）」（現「@cosme SHOPPING」）をオープンし、EC事業の運営を開始しました。",
      "significance": "メディアに続いて小売へ進出し、現在のリテール事業につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "「@cosme STORE」第1号店をオープン",
      "description": "2007年3月、店舗支援業務で提携していた株式会社たしろ薬品出資の株式会社コスメネクストが、ルミネエスト新宿に「@cosme STORE（アットコスメストア）」第1号店をオープンしました。",
      "significance": "実店舗展開の始まりで、現在の店舗網の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "店舗事業を開始",
      "description": "2008年2月、EC事業を目的として株式会社コスメ・コムを設立しました。また、「@cosme STORE」の運営会社である株式会社コスメネクストに資本参加して連結子会社化し、店舗事業の運営を開始しました。",
      "significance": "ECと店舗の運営をグループ内に取り込み、リテール事業の体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "東証マザーズに上場し、海外展開を本格化",
      "description": "2012年3月に東京証券取引所マザーズ市場に株式を上場しました。同年5月に香港、8月にシンガポール、10月に中国に海外子会社を設立し、同年11月に東京証券取引所市場第一部へ市場変更しました。",
      "significance": "上場とアジア拠点の設立で、グローバル事業の基盤ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "投資育成事業と海外卸売を開始",
      "description": "2014年11月、投資育成事業の開始に伴い株式会社アイスタイルキャピタルを設立しました。同年12月、海外向け化粧品卸売事業の開始に伴い株式会社アイスタイルトレーディングを設立しました。",
      "significance": "投資育成と海外卸売が加わり、事業の幅が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "台湾と米国の会社を連結子会社化",
      "description": "2017年5月に台湾のi-TRUE Communications Inc.の株式を取得して連結子会社化し、同年7月に米国のMUA Inc.の株式を取得して連結子会社化しました。",
      "significance": "アジアに加えて北米にも拠点を持ち、海外展開が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "旗艦店「@cosme TOKYO」をオープン",
      "description": "2020年1月、東京都原宿に旗艦店「@cosme TOKYO」をオープンしました。",
      "significance": "旗艦店の展開が始まり、店舗事業の象徴的な拠点となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "リテール子会社を再編し、韓国へ進出",
      "description": "2021年7月、株式会社コスメネクストが株式会社コスメ・コムを吸収合併し、株式会社アイスタイルリテールに社名を変更しました。同年8月、韓国のGlowdayz, Inc.の株式を取得して連結子会社化しました。",
      "significance": "国内リテールの子会社が一本化され、韓国にも拠点が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東証プライム市場へ移行し、資本業務提携",
      "description": "2022年4月、市場の再編に伴い東京証券取引所プライム市場へ移行しました。同年8月、Amazon.com, Inc.及び三井物産株式会社と資本業務提携を結びました。",
      "significance": "両社との提携は、現在の株主構成と事業連携の基盤になっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "旗艦店「@cosme OSAKA」をオープン",
      "description": "2023年9月、大阪府の梅田に旗艦店「@cosme OSAKA」をオープンしました。",
      "significance": "旗艦店が関西にも広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "トレンダーズと資本業務提携",
      "description": "2024年2月、トレンダーズ株式会社と資本業務提携し、同社を持分法適用関連会社としました。",
      "significance": "マーケティング支援の領域で提携が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "データコンサルティング会社を設立し、旗艦店を拡大",
      "description": "2025年4月、データドリブンソリューションを行うアイスタイルデータコンサルティング株式会社を設立しました。同年6月に愛知県名古屋に旗艦店「@cosme NAGOYA」を、同年12月に香港の尖沙咀に海外初の旗艦店「@cosme HONG KONG」をオープンしました。",
      "significance": "データ活用の専門会社と国内外の旗艦店で、生活者との接点が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
