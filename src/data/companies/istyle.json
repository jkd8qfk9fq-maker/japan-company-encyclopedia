  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンに「生活者中心の市場の創造」を掲げ、「@cosme」を中核に、メディアのみならずEC運営・店舗運営・人材サービスなどを含む化粧品業界に関する総合的なプラットフォームとして成長してきました。最大の強みは、データを中心にメディア・EC・店舗が連携する独自のプラットフォームにあるとしています。対処すべき課題として、プラットフォームの強化と拡大（蓄積したデータの活用の深化、EC・店舗の連携による顧客基盤の拡大、情報セキュリティ体制の強化、AIとの共創による新たな価値創造）、インナーケアやエイジングケアなど、より幅広いBEAUTY領域への事業拡大、収益改善を最優先とする海外戦略の再構築（東アジアを中心としたBeauty経済圏の確立）、人材・組織・ガバナンスの整備による経営基盤の強化を挙げています。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "最大の特徴は、国内女性人口の3分の1を超える月間ユーザーに利用される「@cosme」を中心に、メディア・EC・店舗が連携し、創業以来蓄積してきたクチコミや行動データを事業に活かすプラットフォームにあります。生活者との接点を持つリテールと、その接点やデータを化粧品ブランド向けの広告やコンサルティングに活かすマーケティング支援が相互に結びついています。2025年4月にはデータドリブンソリューションを行う専門会社を設立し、AIクチコミ分析ツールなどデータ活用の体制を強めています。",
        "basis": "経営方針（プラットフォームとデータ活用の記載）、事業の内容、経営者による財政状態・経営成績の分析に基づく。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "リテール事業が最大の事業で、2026年6月期の外部顧客への売上高は616億95百万円と、連結売上高の4分の3を占めます。次いでマーケティング支援事業が120億83百万円、グローバル事業が57億57百万円、その他事業が22億72百万円です。地域別の売上高は日本が757億42百万円、アジアが59億71百万円、その他が94百万円で、売上の大半は国内です。売上高の10％以上を占める主要な顧客はいません。「@cosme」は国内女性人口の3分の1を超える月間ユーザーに利用されています。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）と経営方針の記載に基づく。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
