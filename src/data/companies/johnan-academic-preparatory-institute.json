  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営循環モデル「JOHNAN SUCCESS LOOP」に基づき、総合教育ソリューション企業として能力開発のLeading Companyを目指すとしています。2025年12月に公表した新中期経営計画（2026–2028）では、「日本が抱える社会課題への挑戦」「保育園事業の成長」「学習塾事業の深化」を重点戦略に掲げ、保育園事業を学習塾に続く「第2の柱」と位置づけています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の9割以上を教育事業が占め、その中でも児童教育部門と映像授業部門が中心であるため、保育園事業を広げながら教室事業の生徒数を保てるかどうかが成長の焦点になっています。",
        "basis": "セグメント情報に、2026年3月期の外部顧客への売上高5,621百万円のうち教育事業が5,252百万円を占め、教育事業の中では児童教育部門が1,881百万円、映像授業部門が1,733百万円であることが記載されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "保育園事業では「くぼた式育児法」のメソッドをグループ内の全保育園に導入し、0歳児への訴求力を強みとしています。学習塾事業では、総合型・学校推薦型選抜対策のWEBアプリ「推薦ラボ」など主力コンテンツを個別指導教室「城南コベッツ」で活用し、差別化を進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "乳幼児教室や保育園から、小学生向けの算数教室、中高生向けの個別指導や映像授業まで、年齢の移行に合わせて同じグループ内で学びを続けられる体制を持っています。",
        "basis": "【事業の内容】に、乳幼児教室「Kubotaのうけん/あたまGYM」、保育園、算数教室「りんご塾」、個別指導教室「城南コベッツ」、映像授業専門教室「河合塾マナビス」が並んで記載され、乳幼児から社会人まで幅広い層を対象とすることが記載されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "教育サービス業界では、少子化による受験競争の大幅な緩和、大学受験における総合型・学校推薦型選抜など選抜方法の多様化、グローバル化による英語教育の需要の増加で顧客ニーズが多様化し、AIを用いた教育関連の商品やサービスによる個別最適化が進んでいるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "少子化で受験生の母数が縮む環境の中で、推薦型選抜への対応や保育など、従来の受験対策以外の分野へ事業を広げている位置にあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境に、少子化による受験競争の大幅な緩和と選抜方法の多様化が記載され、重点戦略に保育園事業の成長と、総合型・学校推薦型選抜対策の「推薦ラボ」による差別化が掲げられています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
