  "history": [
    {
      "year": 1919,
      "title": "日本陶器からがいし部門を分離して設立",
      "description": "1919年に日本陶器㈱（現ノリタケ㈱）からがいし部門を分離独立させ、日本碍子㈱として設立されました。主に特別高圧がいしとがい管類の製造販売を始めました。",
      "significance": "現在のＮＧＫの出発点です。がいしは今もエネルギー＆インダストリー事業の主な製品の一つです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京・名古屋・大阪の証券取引所に株式を上場",
      "description": "1949年に東京・名古屋・大阪の各証券取引所に株式を上場しました。大阪証券取引所での上場は2011年6月に廃止されています。",
      "significance": "2026年3月期の有報の表紙では、東京証券取引所プライム市場と名古屋証券取引所プレミア市場に上場しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【表紙】"
    },
    {
      "year": 1971,
      "title": "電子工業用セラミックス製品の製造販売を開始",
      "description": "1971年に電子工業用セラミックス製品の製造販売を始めました。2002年には米国の半導体製造装置用モジュール製造会社FM INDUSTRIES, INC.に資本参加して子会社にしました。",
      "significance": "デジタルソサエティ事業で扱う製品につながる事業です。2026年3月期のこの事業の外部顧客への売上高は205,402百万円です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【セグメント情報】"
    },
    {
      "year": 1976,
      "title": "自動車用セラミックス製品の製造販売を開始",
      "description": "1976年に自動車用セラミックス製品の製造販売を始めました。その後、1985年のベルギー、1988年の米国、1996年のインドネシア、2001年の中国など、海外にも製造会社を設立しました。",
      "significance": "自動車排ガス浄化用部品を含むエンバイロメント事業の2026年3月期の外部顧客への売上高は399,469百万円で、3つの報告セグメントのうち最大です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】【セグメント情報】"
    },
    {
      "year": 2002,
      "title": "電力貯蔵用ＮＡＳ®電池を事業化",
      "description": "2002年に電力貯蔵用のＮＡＳ®電池（ナトリウム/硫黄電池）を事業化しました。2025年には、この電池の製造及び販売活動を終了することが決議されました。",
      "significance": "当社は2025年10月31日の取締役会で、ＮＡＳ®電池の新規受注を取らない方針を決めました。",
