  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループの基本理念として「一生涯を通じた幅広い『学び』の機会を提供することで、ともに人間力を高め、笑顔あふれる社会を実現する」を掲げ、ビジョン「人を創る、ともに創る」のもと、学びの場と生活支援の場を通じてサービスを提供しています。教育サービス事業では千葉県・茨城県・東京都東部を中心としたドミナントの強化と、映像学習システム「ウイングネット」による新しい学習モデルの推進に取り組み、介護福祉サービス事業では中核人材の採用・育成と質の高いサービスの提供を進めています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "教育サービス事業では、在籍生徒数を増やすために低学年向けコースの拡充や高校生の現役合格支援に力を入れ、2025年3月に収録・配信拠点「Ichishinデジタルベース」を開設して映像授業を強化しています。介護福祉サービス事業では、グループ介護事業推進本部を置いて人材の採用・育成と合同研修を進めています。",
        "basis": "セグメント情報（外部顧客への売上高）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の概況に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "学習塾では授業前後のコミュニケーションを徹底する「1対1対応」の手厚い指導を掲げ、保護者との面談や個人別カルテで情報を共有する体制を取っています。映像授業コンテンツ「ウイングネット」は自社で使うだけでなく外部の学習塾にも提供し、加盟校数・拠点数が伸長しています。千葉県・茨城県を中心に教室網を持つ地域密着の展開も特徴です。",
        "basis": "事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の概況に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
