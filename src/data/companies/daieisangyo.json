          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        }
      ]
    },
    {
      "id": "housing",
      "name": "住宅事業",
      "description": "新築一戸建ての分譲を中心とする報告セグメントです。分譲住宅、土地分譲、不動産流通、街づくり、リフォーム、住宅販売、分譲住宅建築、宿泊施設の各事業で構成され、2025年9月期の外部顧客への売上高は18,561百万円です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "housing-detached-sales",
