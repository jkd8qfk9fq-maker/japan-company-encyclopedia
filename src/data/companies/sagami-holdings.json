  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループビジョンである「No.1 Noodle Restaurant Company」の実現を目指し、各店舗がそれぞれの地域で一番店になるような企業集団を目指しています。2027年3月期には店舗数284店舗、売上高40,500百万円を目標としています。国内では主力業態である「和食麺処サガミ」「味の民芸」と小型業態の出店を進め、店舗オペレーションの作業面のDX化による省人化と生産性の向上にも取り組みます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期末のグループ店舗数は274店舗であり、会社が掲げる翌期の目標は284店舗です。新規出店による店舗網の拡大を続ける計画であることが分かります。",
        "basis": "経営方針の節に印字された目標とする経営指標と、MD&Aに印字された当期末のグループ店舗数",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "外食産業としての本質的な価値である「おいしさ」と「おもてなし」の向上に注力し、当社ならではの付加価値を創造するとしています。また、最大の経営資源である人財の「物心両面のゆたかさ」の実現を通じて、お客様への提供価値の向上に努めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "グループは愛知県海部郡飛島村と愛知県一宮市、埼玉県入間市に生産拠点を置き、保存麺やかえし類、そば粉などを自ら製造して店舗へ供給する体制を持っています。飛島村には物流センターも置いています。",
        "basis": "主要な設備の状況に印字された工場と物流センターの所在地と設備の内容、および生産実績の品目",
