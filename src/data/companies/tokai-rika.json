  "relatedCompanies": [
    {
      "companyId": "toyota",
      "relationship": "other-affiliated-company",
      "description": "東海理化の筆頭株主で、最大の販売先でもある会社です。2026年3月31日現在、トヨタ自動車株式会社は発行済株式（自己株式を除く）の34.38％（29,367千株）を持っています。関係会社の状況では「その他の関係会社」とされ、関連当事者の注記では議決権の被所有割合は直接34.3％です。東海理化は同社に自動車用部品を販売しており、相手先別の販売実績では、2026年3月期に同社1社への販売が総販売実績の21.6％にあたります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【関係会社の状況】、【大株主の状況】、【関連当事者情報】、【販売実績】"
    },
    {
      "companyId": "toyota-tsusho",
      "relationship": "business-partner",
      "description": "インドネシアの合弁会社トウカイリカインドネシア㈱の設立と事業活動に関する共同経営契約の相手方です。契約の対象は自動車用スイッチ、キーセット及びステアリングロックなどの製造・販売で、2011年5月6日から、当事者の合意解除等で終了する日までとされています。東海理化は、この合弁事業を続けるために豊田通商㈱の株式を保有しています。沿革では、天津東海理化汽車部件有限責任会社（2001年）や佛山東海理化汽車部件有限責任会社（2004年）も豊田通商との合弁として設立されています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【経営上の重要な契約等】、【株式の保有状況】、【沿革】"
    }
