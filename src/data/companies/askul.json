    },
    {
      "companyId": "alphapurchase",
      "relationship": "subsidiary",
      "description": "株式会社アルファパーチェスは、アスクルの連結子会社で、議決権の所有割合は61.6％です（2026年5月20日現在）。消耗品・補修用品などのMRO商材を中心に取扱商材の拡大を担い、アスクルとの間で商品の仕入れ・販売や役員の兼任があります。東京証券取引所スタンダード市場に上場しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【関係会社の状況】【事業の内容】"
    }
