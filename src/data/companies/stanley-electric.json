    },
    {
      "year": 1961,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1961年10月に東京証券取引所市場第二部に株式を上場し、翌1962年2月に市場第一部に指定されました。2022年4月には市場区分の見直しでプライム市場に移りました。",
      "significance": "上場企業として成長してきた流れを示します。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "高輝度発光ダイオードの製造を始める",
      "description": "1976年7月に高輝度の発光ダイオード（LED）の製造を始めました。",
      "significance": "のちのコンポーネンツ事業の中心製品につながります。",
