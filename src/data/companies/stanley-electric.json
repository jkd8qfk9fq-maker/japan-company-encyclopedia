    },
    {
      "year": 2021,
      "title": "紫外線製品ブランド「AℓNUV」を立ち上げ",
      "description": "2021年1月に紫外線製品のブランド「AℓNUV（アルヌーヴ）」を立ち上げました。同じ月に、車載用ランプシステム事業について三菱電機との業務提携契約を結んでいます。",
      "significance": "自動車用以外の光の用途にも広げた動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "本田技研工業と資本業務提携契約を結ぶ",
      "description": "2022年9月に本田技研工業株式会社と資本業務提携契約を結びました。",
      "significance": "完成車メーカーとの関係を強めた出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "Thai Stanley Electric Public Co., Ltd.を連結子会社に",
      "description": "2023年12月にタイの持株会社THPI Co., Ltd.を設立し、2024年4月にThai Stanley Electric Public Co., Ltd.の株式を追加で取得して連結子会社にしました。同年11月にはブラジルの生産拠点としてAngstrom Electric Ltda.を取得しています。",
      "significance": "タイとブラジルでの自動車用照明の体制が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "次世代ランプシステム事業の会社分割を実施",
      "description": "2026年3月に、スタンレーモビリティエレクトリック株式会社の事業開始に向けて、次世代ランプシステム事業に関する会社分割を行いました。同社は三菱電機モビリティ株式会社との合弁会社で、2026年4月1日に事業活動を始めています。また2026年4月23日には、岩崎電気株式会社の全株式を取得して連結子会社にしました。",
      "significance": "車載ランプシステムと電子事業を強める動きです。",
      "sourceIds": [
