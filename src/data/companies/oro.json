  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「より多くの人々に対してより多くの『幸せ・喜び』を提供する企業となる」ことを掲げ、「テクノロジー×クリエイティビティ」をスローガンに技術志向の企業として世界企業を目指すとしています。企業の経営効率化を支援するクラウドソリューション事業と、クライアント企業のマーケティング戦略を実行できるマーケティングソリューション事業の二つの事業を通じて、顧客企業の発展を支え続けるとしています。全社戦略では「事業」「人材」「環境」の3点を重要課題とし、事業を通じた社会課題の解決、人材の採用・育成・定着と多様性の推進、温室効果ガス排出量の削減に取り組むとしています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「ZAC」は、多数の業種で必要とされる機能をパラメータとしてあらかじめ搭載する「パラメータ設計」を採用しており、利用企業は個別開発を行うことなく自社の業務に合ったシステムを作り上げることができます。パラメータは利用企業からの要望等に応じて継続的に追加・拡充されます。加えて、企業の内側を強くする業務システムと、外側を強くするマーケティング支援の両方を持ち、企業のデジタルシフトをトータルに支援できる体制です。",
        "basis": "【事業の内容】に「ZAC」のパラメータ設計の仕組みと、内側・外側の両方のソリューションを持つことが当社グループの特長であると印字されていること。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の外部顧客への売上収益は、クラウドソリューション事業が5,664百万円と連結売上収益の約3分の2を占め、マーケティングソリューション事業が2,643百万円と続きます。連結売上収益は前連結会計年度比で5.2％増加しました。",
        "basis": "セグメント情報に各事業の外部顧客への売上収益が印字され、MD&Aに連結売上収益の前連結会計年度比が印字されていること。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
