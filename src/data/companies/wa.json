  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力ブランド「ORiental TRaffic」「卑弥呼」における顧客層の拡大を基本戦略とし、「MISCH MASCH」の吸収合併を契機としたアパレル事業への本格参入と2025年4月の「31 Sons de mode」の事業譲受でブランドポートフォリオを拡充しました。今後は各販売チャネルの特性に合わせたブランドポートフォリオの最適化、地域・ブランドに最適化した店舗フォーマットの戦略的店舗展開、オンライン販売の拡大に取り組む方針です。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商品企画担当者が販売員として店頭に立ち顧客の声を直接商品開発に反映させ、同じ担当者が生産工場を巡回して検品・品質管理と指導を行う体制で、企画開発から生産、品質管理、販売までを一気通貫で担う点が特徴です。既存のサプライチェーンの見直しで中間マージンの低減にも努めています。",
        "basis": "セグメント注記の外部顧客への売上高、【事業の内容】の企画開発・検査検品業務の記載、【経営方針、経営環境及び対処すべき課題等】の経営戦略等、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "靴業界全体の市場規模は減少傾向にある一方、スニーカーを中心としたカジュアル志向の靴や履き心地などの機能性を重視した靴は需要が拡大し、フォーマルシーンのオケージョン需要も回復傾向にあります。その中で当社グループの2026年1月期の売上高は23,327百万円で、婦人靴の企画・販売事業が20,347百万円と大半を占めます。",
        "basis": "セグメント注記の外部顧客への売上高、MD&Aの経営成績等の状況の概要と経営環境の記載に基づきます。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
