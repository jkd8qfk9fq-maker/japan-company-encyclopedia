  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として、不動産の販売を通じてお客様の幸福に貢献する「笑顔創造企業」を掲げています。不動産販売事業を主力事業としつつ、採算性を重視し安易な拡大路線を取らない方針のもと、関連事業の拡大や新規事業への進出も視野に、長期安定的な企業価値の創造に努めています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "開発・販売から分譲後の賃貸管理・建物管理までをグループで一貫して担うため、販売した物件の管理受託を継続的に積み上げられる体制を持っています。マレーシアでは管理戸数19,131戸まで建物管理の基盤を広げています。",
        "basis": "【事業の内容】に、不動産販売事業で「XEBEC」を企画・開発・分譲すること、不動産管理事業で分譲物件の賃貸管理・建物管理を行うこと、海外不動産事業でマレーシアの管理戸数が19,131戸に達していることが印字されています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "東京都への人口流入が続く都心の賃貸需要を背景に、東京23区の資産運用型マンションに特化した事業を展開しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、東京都の転入超過が続き20代の転入超過が最も多いこと、都内の賃貸物件への需要は安定的に推移し賃料も上昇基調にあることが印字されています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
