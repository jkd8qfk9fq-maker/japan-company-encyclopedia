  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「海上物流で、共に世界の今をつくる責任、未来へとつなぐ責任を果たす」をパーパスとして掲げています。2024年度から2027年度までの中期経営計画『FORWARD 2030 Ⅱ Challenge for innovation and further growth with U』では、2030年に向けたビジョンを「クリーンでサステナブルな海上輸送における必要不可欠な存在を目指し、ステークホルダーと協働して変革を続け、企業価値の更なる向上を図ります」と定め、事業戦略として「新規成長事業領域の拡大」と「既存中核事業領域の深化」を掲げています。2050年カーボンニュートラルに向けた環境ロードマップに沿い、2030年に温室効果ガスの年間排出量を2019年比で25％削減する目標も設定しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本製鉄をはじめとする主要荷主との長期契約による安定収益を基盤に、外航と内航の両方にわたる専門性と総合力を持つ海運会社です。2026年3月31日現在の船隊は、所有船と用船・受託船を合わせて211隻です。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】・【主要な設備の状況】の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
