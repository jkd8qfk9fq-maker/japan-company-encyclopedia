  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月2日に公表した中期経営計画（2026年3月期〜2028年3月期）では、最終年度となる2028年3月期の連結売上高1,319億円を目標に掲げています。中長期の戦略として、不動産事業の中での多角化によるバランス経営を図るとともに、土地有効活用事業や賃貸及び管理事業など賃貸収入を生むストック型ビジネスを拡大し、長期的な安定経営による「つぶれない会社づくり」を目指しています。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "新築戸建、分譲マンション、改装付中古住宅の販売、土地有効活用提案によるアパート建設、サービス付き高齢者向け住宅建設、個人投資家向け一棟売賃貸アパート販売、分譲マンション管理、賃貸管理、建設関連まで、住宅・不動産に関するあらゆる住まいのワンストップサービス企業であることを掲げています。新築戸建住宅では、炭の自浄作用を活用して外気からの有害物質を除去する独自の換気システム「炭の家/ピュアエア」を採用しています。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、分譲住宅事業が36,737百万円で連結売上高の約27％、住宅流通事業が35,122百万円で約25％、賃貸及び管理事業が33,864百万円で約24％、土地有効活用事業が30,969百万円で約22％を占め、主要な4事業がそろって増収となりました。売上はすべて国内で、売上高の10％以上を占める相手先はありません。",
        "basis": "セグメント情報（外部顧客への売上高）及び関連情報（地域ごとの情報、主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
