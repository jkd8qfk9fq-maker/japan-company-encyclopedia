  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年の企業ビジョン「VISION2030」の達成に向けた長期経営計画 “To zero, from zero.”（2021年度から2030年度）を進めています。国内土木・建築・建築リニューアル事業を「コア事業」、国際・不動産・新規事業を「戦略事業」と位置づけ、人材とデジタル技術を競争優位の源泉として、「脱炭素」「廃棄物ゼロ」「防災・減災」の3つの提供価値を軸とした5つの重点戦略を実行するとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "東急グループの一員として建設事業の分野を担い、東急グループ各社と連携しながら、東急ブランドの価値を競争力の一つとしています。あわせて、人材とデジタル技術を競争優位の源泉と位置づけています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は国内の建設事業です。2026年3月期の外部顧客への売上高は、建設事業（建築）が259,236百万円、建設事業（土木）が74,350百万円で、この2事業で連結売上高341,181百万円のほとんどを占めます。不動産事業等は7,593百万円とまだ小さく、会社は不動産や国際事業を成長させる「戦略事業」と位置づけています。",
        "basis": "セグメント情報に2026年3月期の外部顧客への売上高（建設事業（建築）259,236百万円、建設事業（土木）74,350百万円、不動産事業等7,593百万円、連結売上高341,181百万円）が印字され、【経営方針、経営環境及び対処すべき課題等】に国際・不動産・新規事業を「戦略事業」と位置づける記載がある。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
