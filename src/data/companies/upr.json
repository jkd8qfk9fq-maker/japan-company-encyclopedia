  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年9月に新たなパーパスを策定し、「中期ビジョン2030」の基本方針を「選択と集中を経て国内のみならずアジアエリアで積極的に事業を展開し更なる成長を目指す」と定め、選択と集中、統一戦略に基づいた営業活動、改正物流効率化法に沿ったサービスの開発・提供・拡販、海外（アジアエリア）での売上拡大の強化など5つの戦略を推進するとしています。今後の5年間を構造改革フェーズ（2年間）と収益拡大フェーズ（3年間）に分けて取り組むとしています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "パレットのレンタルを軸に、改正物流効率化法を背景としたパレット輸送の需要を取り込みながら、アジアでの展開とソリューションの拡販で成長を目指す戦略です。",
        "basis": "経営方針、経営環境及び対処すべき課題等に、中期ビジョン2030の基本方針と5つの戦略、構造改革フェーズと収益拡大フェーズの区分が印字されているため。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "国内14の営業所と約200か所のデポを展開し、レンタル用物流機器の保有枚数は約528万枚に達しているとしています。同じパレットを多くの利用者が相互に循環利用するパレットプールシステムにより、パレットの回収業務の負担軽減と流出防止の仕組みを提供しています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      }
    }
