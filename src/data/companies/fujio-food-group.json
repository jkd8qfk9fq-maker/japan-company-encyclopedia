    },
    {
      "year": 1999,
      "title": "株式会社フジオフードシステムを設立",
      "description": "1999年11月、大阪市北区において、飲食店の経営、フランチャイズチェーンシステムによる飲食店の加盟店の募集及び経営指導等を目的に株式会社フジオフードシステムを設立しました。「まいどおおきに食堂」のフランチャイズ加盟店募集も開始しました。",
      "significance": "現在の事業会社の前身が設立されました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "大阪証券取引所「ヘラクレス」に上場",
      "description": "2002年12月、大阪証券取引所「ヘラクレス」（現　東京証券取引所「ＪＡＳＤＡＱ」）に上場しました。",
      "significance": "株式を公開しました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "株式会社フジセイ・コーポレーションを吸収合併",
      "description": "2005年1月、株式会社フジセイ・コーポレーションを簡易合併方式により吸収合併しました。同年、「まいどおおきに食堂」は200店舗を達成し、グループ全体で400店舗を達成しました。",
      "significance": "グループの店舗網が広がりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "中国・上海に子会社を設立し海外1号店を出店",
      "description": "2006年6月、中国・上海市に子会社、上海藤尾餐飲管理有限公司（現連結子会社）を設立し、中国・上海に海外1号店を出店しました。同年、グループ全体で600店舗を達成しました。",
      "significance": "海外展開が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "持株会社体制へ移行し商号を変更",
      "description": "2020年7月、飲食事業を吸収分割により連結子会社である株式会社ホノルルコーヒージャパンに承継させ、持株会社体制へ移行しました。当社の商号を株式会社フジオフードグループ本社へ、株式会社ホノルルコーヒージャパンの商号を株式会社フジオフードシステムへ商号変更しました。",
      "significance": "現在の純粋持株会社の体制になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、東京証券取引所の市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場市場です。",
