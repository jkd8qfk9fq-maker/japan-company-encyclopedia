  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年３月25日開催の取締役会において、丸紅株式会社が保有する連結子会社タイ昭和パックス株式会社の株式の全株式を追加取得すること、及びMarubeni Thailand Co.,Ltdが保有する同社株式の全株式を連結子会社である山陰製袋工業株式会社が新規取得することを決議し、2026年５月15日に当該株式を取得しました。2026年３月31日現在のタイ昭和パックス株式会社に対する議決権の所有割合は当社90.0％であり、丸紅株式会社及びMarubeni Thailand Co.,Ltdの保有分は合わせて10.0％であったため、本登録は2026年３月31日現在の体制に基づきます。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2022年度を初年度とする中期経営計画『PAXXS Vision-2030』を２段階の構想で進めており、第１段階では『ニーズをカタチに』『品質の追求を』『仕事に自信を』の３つのプロジェクトに取り組み、東京工場の建替えにも着手しています。2030年までの第２段階では製品・サービスを拡充して顧客満足度を高めます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期の売上高は前期比1.1％増の23,563百万円でした。重包装袋が売上高の65.5％を占める主力事業であり、フィルム製品とコンテナーが続く構成です。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aのセグメント別業績推移表",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1935年の創業以来、重包装袋の製造販売で培った長年の経験と技術開発力を基盤に、国内の複数の工場とタイの子会社を含む生産体制で、石油化学から農産物まで多様な用途の袋やフィルムに応えています。",
        "basis": "沿革、経営方針、事業の内容、関係会社の状況",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "重包装袋の主力製品であるクラフト紙袋の業界全体の出荷数量は、2026年３月期に前年同期比1.4％減少しました。当社は重包装袋を主力とする産業用包装資材のメーカーとして、国内外で事業を展開しています。",
        "basis": "MD&Aの重包装袋セグメントの業績に関する記述、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
