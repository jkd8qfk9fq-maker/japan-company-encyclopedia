  "history": [
    {
      "year": 1939,
      "title": "日本軽金属が設立される",
      "description": "1939年3月に日本軽金属株式会社が設立されました。これは現在の持株会社の完全子会社で、事業の中心となる会社です。1940年10月には蒲原工場でアルミニウムの生産を、1941年9月には清水工場でアルミナの生産を始めました。",
      "significance": "アルミナからアルミニウム地金までをつくる流れが、このときに始まりました。アルミナ・化成品、地金は今もグループ最大の事業区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所などに株式を上場",
      "description": "1949年5月に日本軽金属が東京証券取引所などに株式を上場しました。",
      "significance": "日本軽金属は2012年9月に上場を廃止し、翌月からは持株会社の株式が上場しています。",
      "sourceIds": [
        "yuho-2026"
