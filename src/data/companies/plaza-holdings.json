  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンに『みんなの広場をつくる。』を掲げ、各事業の基盤強化とM&Aの推進で広場をつくる仲間を増やしていく方針です。中長期の戦略として、イメージング事業では新たなブランド創造と展開に向けて本部機能を強化し、経営リソースを製品開発とIT投資に集中させ、モバイル事業ではキャリアショップの出店と人材育成に加え、法人営業チャネルの強化を進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、モバイル事業で低価格機種から中位価格機種への販売に注力して販売単価が上昇し、販売後の利用サポートのサブスクリプション加入者も順調に増えました。イメージング事業では『なんでもダビング』への注文の集中やDIYキットの量販店向け販売が寄与し、連結売上高は前期比3.0％増となりました。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "写真プリント店『パレットプラザ』をフランチャイズ126店と直営17店で展開する店舗網と、携帯ショップ68店舗の運営基盤を持ちます。モバイル事業では販売後の利用サポートをサブスクリプション化して継続的な収入につなげており、イメージング事業では長年親しまれてきた年賀状プリントに加え、ダビングサービスやDIYキットなど新しい収益の柱づくりを進めている点が特徴です。",
        "basis": "セグメント情報の外部顧客への売上高、事業の内容、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "携帯端末の販売では、主要な顧客であるソフトバンク株式会社への販売が総販売実績の31.2％を占めており、特定の通信キャリアとの取引への依存度が高い位置にあります。写真プリントは年賀状需要の減少など生活スタイルの変化の影響を受けており、事業環境の変化への対応が進められています。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
