  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "新車並びに中古車市場を含めた自動車流通市場における総合商社を目指し、事業領域並びに市場エリアの拡大を事業戦略として掲げています。中長期の経営戦略として、中古車事業のグローバル化並びにIT化を加速するために積極的な投資を行い、中長期的な収益拡大を目指すこと、東南アジア諸国での需要拡大を見込んだ中古車輸出販売の推進と新たな成長市場の開拓、国内では顧客満足度の向上を通じて全国No1チェーンを目指すことを示しています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点は、主要マーケットである東南アジア諸国を中心とした中古車輸出の拡大と、国内の買取・販売で培った経営資源を生かした新たなビジネスモデルの構築を組み合わせることにあります。あわせてグループ会社との相乗効果を前提とした投資を進める方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等における中長期的な会社の経営戦略と中古車輸出販売・中古車買取及び販売の事業戦略の記載",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、東南アジア諸国等を中心に多国間の貿易ルートを確保していることと、中古車買取店「アップル」のフランチャイズ網を通じて、オークションの落札価格情報や在庫情報等から買取時の適正な価格情報を加盟会員へ提供できる体制にあります。輸出では補修部品の供給を含めたアフターケアの充実による差別化にも努めています。",
        "basis": "事業の内容における中古車輸出事業と中古車買取・販売事業の記載、MD&Aの経営成績の概要の記載、事業等のリスクにおける同業他社との競合への対応の記載",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高を顧客の所在地別に見ると、マレーシアが18,315百万円、日本が14,210百万円、タイ王国が6,875百万円でした。国内中古車登録台数は前期比で減少した一方、中古車輸出台数は前期比で増加した環境にあります。特定の外部顧客への売上高が連結売上高の10％以上を占める主要な顧客はいません。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）の記載、MD&Aのセグメント別の経営成績の記載",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
