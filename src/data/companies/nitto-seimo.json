  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2016年5月に設定した経営戦略では、チリとタイの現地法人を中心に中南米・東南アジアへの拡販を図ること、高付加価値製品・サービスの開発と販売、原反・消耗品の販売強化、連結グループ会社の一元管理体制の推進、業界のリーダーとしての提案を掲げています。対処すべき課題として、オリジナル商材の開発と差別化、漁網の拡販と仕立部門の強化、人材の確保・育成、販売価格の適正化、廃棄漁網のリサイクルを挙げています。",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1910年の創立以来、研究開発に力を入れ、社会に役立つ製品を合理的な価格で提供することを基本方針としてきました。多久製網や日東ネット、チリとタイの現地法人など、製造・仕立・防汚加工を担うグループ会社を持ち、定置網漁業を行う子会社を含む体制で事業を運営しています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の製品・サービス情報、事業の内容、関係会社の状況、MD&Aの経営成績等の状況の概要に基づく",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "漁業関連事業の外部顧客への売上高は17,785百万円と連結売上高の大半を占め、地域別では日本が19,679百万円と中心で、中南米・アジア・ヨーロッパなど海外にも販売しています。会社は、養殖業の重要性が今後ますます高まるとの認識を示し、漁獲量の確保や水産物の安定供給への対応を課題としています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の地域ごとの情報、経営方針・対処すべき課題、MD&Aの経営成績等の状況の概要に基づく",
        "asOf": "2026-07-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
