  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、①「成婚数」の最大化と市場シェアの拡大、②「総合ライフデザインカンパニー」としてのLTV向上、③社会課題解決への戦略的投資、④資本コストを意識した経営と株主還元の充実、の4つを柱に掲げています。独自の「IT×リアルサービス」を融合させたプラットフォームを展開し、業界最大級の会員基盤、成婚を生み出すシステム、仲介者の「成婚サポート力」という模倣困難な強みを軸に、競争優位性を確立するとしています。経営理念は「ご縁がある皆様を幸せにする」です。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、直営店事業と加盟店事業の婚活の中核が伸びたうえ、株式会社GROWBINGと株式会社デコルテ・ホールディングスの連結化でライフデザイン事業の売上高が前年同期比98.1％増となり、成婚後の周辺サービスへ事業を広げる戦略が数値に表れました。",
        "basis": "セグメント情報の外部顧客への売上高と製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本最大級の結婚相談所ネットワーク「IBJ」を基盤に、加盟店・直営店・アプリ・パーティーの複数の接点で出会いの機会を持ち、仲人による対面のサポートを組み合わせている点が強みです。成婚した後も住まい・保険・ウエディングへつなげる体制を持ち、顧客との関係を長く続けられます。",
        "basis": "【事業の内容】の事業の内容とグループ会社の位置づけ、【経営方針、経営環境及び対処すべき課題等】の中長期的な経営戦略、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の婚姻件数が減少傾向にあるなか、加盟店事業ではIBJ課金会員数とお見合い件数が伸びており、結婚相談所業界の大手に位置します。売上高の10％以上を占める主要な顧客はなく、本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
