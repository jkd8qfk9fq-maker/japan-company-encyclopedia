  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創立100周年を迎える2030年をゴールとした長期ビジョン「TOA STYLEをさらに磨き、社会から選ばれ続けるオンリーワン企業へ」を掲げ、2024年5月に策定した中期経営計画「TOA ROAD Sustainable Plan 2026」（2024年度から2026年度）を推進しています。基本方針は「挑戦・発想・実行で社会から選ばれ続ける企業に」で、「CSR経営への転換」と「持続可能な成長基盤の構築」の2つを柱とし、建設事業ではDX技術の導入による生産性向上や民需へのシフト、官民連携（PPP）事業・海外事業・鉄道事業の強化、製品事業では設備投資や舗装の長寿命化に資する製品の展開などに取り組むとしています。",
        "asOf": "2026-07-10",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1930年にわが国初のアスファルト乳剤の製造を始めて以来の材料技術を持ち、舗装工事などの建設事業と、アスファルト合材・乳剤の製造販売を一体で手がけています。全国に合材製造工場43工場と乳剤工場24工場を持ち、工事と材料の両面から道路インフラを支える体制です。",
        "basis": "【沿革】の設立経緯、【事業の内容】の事業構成、【主要な設備の状況】のアスファルト乳剤工場とアスファルト合材製造工場の数によります。",
        "asOf": "2026-07-10",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは建設事業と製造販売・環境事業等の2つで、2026年3月期の外部顧客への売上高は建設事業が74,298百万円、製造販売・環境事業等が47,028百万円と、建設事業が6割強を占めます。本邦の外部顧客への売上高が連結売上高の90％を超えており、主要な顧客は国土交通省（売上高8,139百万円）です。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高と、関連情報の地域ごとの情報・主要な顧客ごとの情報によります。",
        "asOf": "2026-07-10",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
