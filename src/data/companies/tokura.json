  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "建設事業を通じて、より暮らしやすい生活環境づくり、豊かな社会づくりに貢献することを目指しています。注力分野として「社会資本の維持・更新」「防災・減災」「エネルギー・環境」「医療」「ＰＰＰ・ＰＦＩ」等を掲げ、建設ＩＣＴ（情報化施工）やＡＩ（人工知能）を積極的に活用して省力化・労働生産性向上に努めるとともに、多様な人材が活躍できる企業を目指しています。第81期から第83期までの３か年を対象とする中期経営計画では、「お客様が真っ先に思い描く会社」（ファーストコールカンパニー）などを目指す姿とし、人材の確保・育成への投資を継続しながら、技術・品質・価格の総合的な競争力の向上に取り組んでいます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "公共投資の市場と民間設備投資の市場は補完的な関係にあり、当社グループは両者を事業領域として、国内景気が低迷する時期には公共工事、民間需要が活発な時期には民間工事の受注に注力する戦略をとっています。本店のある中部地区を地盤としながら、タイの連結子会社をはじめ中南米・東南アジアにも拠点を持ち、海外工事にも対応します。建設工事にとどまらず、ＰＦＩ事業として斎場や学校給食センターの運営まで手がけている点も特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記載、【事業の内容】のＰＦＩ事業の記載、【沿革】の海外拠点の記載に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは建築、土木、不動産の３つと、その他です。2026年３月期の外部顧客への売上高は建築44,909百万円、土木22,057百万円、不動産624百万円、その他585百万円で、建築と土木が連結売上高68,177百万円の大半を占めています。地域別の売上高は日本63,898百万円、中南米1,284百万円、東南アジア2,995百万円です。外部顧客への売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報等に印字された報告セグメントごとの外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報の記載に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
