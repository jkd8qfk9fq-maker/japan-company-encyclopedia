    "strategy": {
      "disclosed": {
        "text": "中長期ビジョンとして「世界をフィールドに豊かなビール体験、顧客体験を創造する企業」を掲げ、基軸ブランドへのマーケティング投資や外食事業を中心とした顧客接点の拡大、ノンアルコールなどのより健康的な選択肢の提供、海外での協業、不動産事業への外部資本導入で得る資金を活用した成長投資などを進めるとしています。また、2026年7月に事業持株会社体制へ移行する予定です。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「サッポロ」と「ヱビス」の商標を受け継ぐビール事業を中核に、国内と北米・アジアに生産拠点を持ち、飲料・食品のポッカサッポロと、ビヤホールなどを経営するサッポロライオンという、お客様と直接つながる飲食の接点をあわせ持つ構成が特徴です。",
        "basis": "【事業の内容】と【沿革】の記述",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上収益506,861百万円のうち、酒類事業が400,244百万円、食品飲料事業が106,609百万円です。売上収益の地域別では日本が383,977百万円、北米が86,644百万円、その他が36,241百万円となっています。",
        "basis": "セグメント情報（事業セグメント・地域別情報）",
