  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "百貨店事業を中核とし「地域の交流拠点として賑わいを創出し、市場顧客の生活文化向上に寄与する」ことを経営理念として、石川・富山地区では当社にしかできない商品の品揃えと魅力ある営業企画の推進により地域顧客の期待に応えるとともに、経費構造の見直しや業務の効率化を促進し、収益基盤の強化につなげるとしています。中長期的には、「新しい商品と企画」の開発強化、文化性の高い美術催事の開催、物産催事における本物志向の商品開発、地域の有力企業や生産者との取組みの拡大による地域密着営業の推進に取り組み、グループ各社は「自主自立経営」の確立を目指すとしています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年2月期の売上高は15,983百万円で前期の16,434百万円から減少しました。百貨店業はインバウンド関連売上の減少や大型寒波の影響もあり減収となった一方、出版業は増収となり、当期から報告セグメントとなった人材サービス業は規模が拡大しています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメントごとの状況の記載に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1923年の創業以来金沢市片町を拠点とし、石川県と富山県に百貨店を展開する地域に根ざした営業基盤を持ちます。友の会の運営を通じた固定客の基盤に加え、両店で開催する食品物産催事や地域では同社にしかできない商品・企画の開発を強みとしています。",
        "basis": "事業の内容、沿革、経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "百貨店業界は、国内消費が堅調に推移した一方で前年度に急伸したインバウンド需要の反動減により伸びに欠ける商況が続いています。同社は北陸地区で金沢・富山の２店舗を展開する地域百貨店で、2026年2月期の売上高の84％を百貨店業が占めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析、セグメント情報に基づく",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
