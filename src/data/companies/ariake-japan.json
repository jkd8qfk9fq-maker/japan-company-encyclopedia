  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として、天然調味料の生産を通して健康で豊かな食文化に寄与することと、顧客第一主義を掲げています。中期的な経営戦略では、天然調味料の専業メーカーから総合調味料メーカーへ事業を広げること、国内マーケットの徹底した追求による需要拡大と世界マーケットの開拓をポイントとし、日本と海外子会社の生産拠点による「世界7極体制」で最適地生産を実現するとしています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "競争優位の源泉として、中国・ヨーロッパをはじめ海外に生産拠点を有し良質で廉価な原料調達ができること、コンピューター生産方式による大規模工場を確立していること、約50年の歴史の中で蓄積された経験曲線や工程の「カイゼン」が生きていることの3点を挙げ、これらによって高品質な製品を安価で生産する仕組みができていると説明しています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業は天然調味料事業の単一セグメントで、2026年3月期の売上高66,957百万円の地域別の内訳は日本48,456百万円、アジア10,039百万円、欧州8,461百万円です。欧州は前期比16.3％増と伸びが大きく、アジアは前期比3.2％減でした。売上高の10％以上を占める主要な顧客はなく、販売実績が最も大きい相手先は三井物産流通グループ株式会社で、総販売実績に対する割合は9.2％です。",
        "basis": "セグメント情報（天然調味料事業の単一セグメントであること）、関連情報の地域ごとの情報と主要な顧客ごとの情報、MD&Aの地域別の売上高に基づきます。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
