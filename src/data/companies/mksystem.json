  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「人にやさしいシステムの提供で社会に貢献する」を掲げ、「人事労務領域総合サービスの提供」を経営方針として、社会保険・労働保険・給与計算等の手続き業務に加え、年末調整、経費精算、人材育成などの周辺領域へサービスの対応範囲を拡大する方針です。主な取り組みとして、主力製品・サービスの安定提供と品質向上、ストック収益基盤の維持・拡大、収益性と事業運営体制の強化を進めています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "月額料金のASPサービスが社労夢事業の売上の大半を占め、継続的に収益が積み上がるストック型の事業構造を持つ点が特徴です。設立以来、社会保険・労働保険の手続き支援に特化してサービスを積み重ねてきました。",
        "basis": "【事業の内容】に、社労夢事業のクラウドサービスがASPサービスの利用料などの月額料金で構成されることが印字されていること。【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、社労夢事業の売上高2,419百万円のうちストック収益であるASPサービス売上高が2,264百万円であることが印字されていること",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
