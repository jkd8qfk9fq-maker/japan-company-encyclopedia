  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年から2026年度までを対象期間とする中期経営計画を公表し、命題を「現在の深化と未来の創造」として、「既存事業強化」と「成長分野の取込みと創出」の２つの成長戦略に取り組んでいます。既存事業では主力の段ボール事業の収益力強化や、商品・顧客ポートフォリオへの組み換えを進め、成長分野ではＭ＆Ａの積極的な実施や国内・海外の生産拠点の拡充を掲げています。計画の目標数値は将来に関する事項のため、ここには転記していません。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「トータルパッケージング・ソリューション・プロバイダー」として、段ボール、印刷紙器、軟包装材および紙製緩衝材などの各種商品群を取り揃え、お客様のニーズに合わせた商品開発、製造および販売まで総合的に手がけていると説明しています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【セグメント情報等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高67,083百万円の内訳は、報告セグメントの外部顧客への売上高で包装材関連事業が66,717百万円、不動産賃貸事業が365百万円です。製品及びサービスごとでは段ボールが49,191百万円、軟包装材が8,078百万円、印刷紙器が6,699百万円、その他が3,114百万円となっています。地域ごとでは日本が51,469百万円、ベトナムが12,238百万円、東南アジアが1,904百万円、中国が1,471百万円で、売上高の10％を超える特定の外部顧客はありません。",
        "basis": "セグメント情報等の報告セグメントごとの外部顧客への売上高と、関連情報の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-03-26",
