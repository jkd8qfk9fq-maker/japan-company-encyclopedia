  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「21世紀の人づくりを通じて社会に貢献する教育と文化の創造企業をめざそう」を掲げ、現場第一主義の姿勢を堅持するとしています。経営戦略では、新しいタイプの教材の開発、教具の商品企画の充実と販路拡充、紙とデジタルを融合させたハイブリッド型教材や教師の業務負担を軽減するソフトウエアの開発・販売、独創性の高い教材・教具の権利化、連結経営の効率化、誰もが利用しやすい教材づくりの6項目に重点を置くとしています。また、教材会社から教育総合サービス会社への転換を図るとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成は出版が約7割、教具が約3割で、テスト・ドリル等の出版物を中核とする事業構成になっています。",
        "basis": "【セグメント情報等】の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力のテスト・ドリル等の出版物は、文部科学省が定める学習指導要領や教科書に準拠する必要があり、教科書の定期的な改訂に合わせて内容を見直す編集を継続しています。小学校の教科書改訂は2024年度に実施され、改訂に対応した教材を提供できるかどうかが売上に影響すると会社は説明しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
