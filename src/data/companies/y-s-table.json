  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "高付加価値化を最優先課題として、食材にこだわり上質な空間で料理を提供する店舗作りを進めます。和食事業を重点領域として強化し、カジュアルイタリアン事業では収益性を重視した新規出店と既存店の収益性改善に取り組み、収益構造と財務基盤の強化を進める方針です。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年２月期は、前の年に新規出店した店舗が通期で貢献し、両グループとも売上高が前期を上回りました。カジュアルレストラングループでは新規出店と直営化による改装が行われ、デリバリーの件数も外部サービスの活用で増えており、開示された方針に沿った店舗展開が進められています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「XEX」のような複合型の高級レストランと、「PIZZA SALVATORE CUOMO」のようなカジュアルなイタリアンという価格帯の異なるブランドを併せ持ち、カジュアルレストランではフランチャイズ方式でも店舗網を広げられる点が特徴です。",
        "basis": "事業の内容と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外食業界の中で、高級レストランとカジュアルレストランの両方を展開し、インバウンド需要の取り込みや和食事業の強化に取り組むレストラン運営会社という位置づけにあります。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-05-27",
