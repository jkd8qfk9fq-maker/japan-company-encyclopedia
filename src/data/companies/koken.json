  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『クリーン、ヘルス、セーフティ』を事業領域とし、オリジナリティの高い技術をベースとした製品を供給することを経営の基本方針としています。「世の中にない」「真に役立つ」を研究開発の出発点として、規模の大きさではなく、世界にない当社にしかできない「オンリーワン」「ナンバーワン」の技術・製品を持つ「技術立社」を目指すとしています。分野別の取組みとして、クリーン分野ではISOクラス1を実現できるオープンクリーンシステム「KOACH」の普及、ヘルス分野では感染対策用N95マスク「ハイラック350型」の市場シェアの拡大、セーフティ分野では電動ファン付き呼吸用保護具「ブレスリンク」シリーズなどの開発を掲げています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の中心はマスク関連事業で、2025年12月期は9,564百万円と全体の約8割を占めています。環境関連事業は1,939百万円まで拡大し、2025年12月期の増収の中心となりました。",
        "basis": "セグメント情報に報告セグメントごとの外部顧客への売上高が印字され、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に各事業の売上高の増減が印字されていることから読み取れます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「他社に追随しない」「徹底的に研究する」という研究開発の理念を掲げ、技術専門能力を評価するマイスター制度や、技術開発員と取締役全員が参加する月例研究発表会などの独自の仕組みを運用しています。技術開発の拠点として先進技術センターを置き、清浄度ISOクラス1を実現するオープンクリーンシステムなど、独自技術の製品を生み出しています。",
        "basis": "経営方針の「技術を育てる」の項に、研究開発の理念とマイスター制度・月例研究発表会の仕組み、先進技術センターが技術開発拠点であることが印字されていることから読み取れます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "防じん・防毒マスクのメーカーとして、産業現場向けに加え、自衛隊向けの防護マスクや医療機関向けの感染対策用マスクも供給しています。医療用マスクの売上はコロナ禍前の約3倍の水準を維持していると開示されています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に、自衛隊向け防護マスクの売上が3期連続で前年実績を上回ったことと、医療用マスクの売上がコロナ禍前の約3倍の水準を維持したことが印字されていることから読み取れます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
