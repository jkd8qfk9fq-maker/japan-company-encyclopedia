  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "地方都市圏を中心に自前での新規出店を年間３店舗程度見込む出店戦略、「スタッフの幸福の最大化の追求」を人事基本方針とする人材戦略、SNS等を活用したデジタルマーケティングによる集客の強化、内製化した婚礼周辺サービスの外販の強化を掲げています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "2025年12月期は、施行組数と施行単価の増加によりブライダル事業の売上収益が伸び、レストラン特化型事業も新規出店の寄与で大きく伸びています。出店面では、2026年３月に静岡市の登録有形文化財の洋館を再生した婚礼施設の開業が予定されるなど、再生型の施設展開も進めています。",
        "basis": "セグメント情報のセグメント収益および業績、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績の状況に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
