  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社のLECIP THAI CO., LTD.は2025年7月に解散し、2026年3月31日時点で清算手続き中ですが、連結の範囲に含まれています。本登録は2026年3月31日現在の体制（同社を含む連結子会社7社の体制）に基づきます。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「VISION2030」の実現に向けて、モノ（モノづくり）＋コト（サービス）への事業構造の変革、エネルギーマネジメントシステム事業の育成、北米・ASEANを中心とする海外市場における事業拡大の3つの経営戦略に取り組んでいます。中期経営計画「RT2026（Reach our Target 2026）」では、海外事業の確立、新規領域の拡大などを基本戦略としています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長戦略は、国内バス市場の更新需要が一巡する中で海外市場の拡大を図ることと、エネルギーマネジメントシステム事業を輸送機器事業に次ぐ柱に育てることに重点が置かれています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略・基本戦略の記述と、セグメント情報のセグメントごとの外部顧客への売上高、MD&Aの経営成績の分析に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "バス用運賃箱やワンマン機器、車載用照明灯具、バッテリー式フォークリフト用充電器など、ニッチな市場でトップシェアを持つ製品を多く持ち、インバータ技術を基盤とする電力変換技術と、バス用電装機器のトータルサプライヤーとしての総合力が特徴です。",
        "basis": "【事業の内容】の事業概要と【経営方針、経営環境及び対処すべき課題等】の経営環境の記述、セグメント情報の関連情報（製品及びサービスごとの情報）に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内ではバス・鉄道向け電装機器のニッチ市場で高いシェアを持ち、海外では米国向けの販売が地域別売上高の中心です。2026年3月期の地域別の売上高は日本が20,370百万円、米国が2,993百万円で、単一の顧客への集中はありません。",
        "basis": "セグメント情報の関連情報（地域に関する情報、主要な顧客に関する情報）と、MD&Aの経営成績の分析に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
