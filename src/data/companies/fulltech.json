  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン「ビジョン2030」と中期3ヶ年経営計画の達成に向け、新規物件では選別受注を強化して収益性の高い案件に注力し、収益基盤であるストック市場ではリニューアル受注の拡大と保守契約率の向上に取り組むとしています。ストック市場では、エントランス周りのリノベーション事業へ本格参入するほか、顧客が使用する自動ドアの情報にアクセスできるプラットフォーム「顧客マイページ」の提供により、自動ドアユーザーとの接点を強化するとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "営業・設計・施工・保守を社内一貫体制で受注でき、施工を外注委託せず主に内製で行う体制を整えています。主要拠点のすべてに設計要員を置き、原則として最長でも車で2時間以内にすべての顧客へ到達できる拠点網と、24時間365日のアフターサービス体制を備えています。国家検定である自動ドア施工技能士の有資格者は、2026年2月末現在で266名です。",
        "basis": "事業の内容に、営業から保守サービスまでの流れと社内一貫体制・内製施工の方針、拠点網と到達時間の目安、技能士の有資格者数が印字されていること",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
