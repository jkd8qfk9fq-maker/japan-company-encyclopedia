  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030ビジョンで「エンジニアリングがつなぐ人とインフラ」をありたい姿とし、メーカーとして築いてきた事業基盤の上にデジタルを活用したエンジニアリングサービスを展開して、国内外の防災、インフラの整備・維持管理に幅広く貢献する企業を目指すとしています。中期経営計画2023-2025は既存事業の土台固めと未来に向けた種まきの期間と位置付けられ、発電事業への先行投資やESCON事業の収益化、BIM/CIM設計支援事業の定着を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上の中心である建設用資機材事業は公共投資の動向に左右されるため、防災・減災や国土強靭化、高速道路リニューアルなどの需要を取り込む一方、補修・補強工事業や建設コンサルタント事業といった維持管理・サービス分野を伸ばすことが、収益の柱の多様化につながる構造です。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの経営成績の分析、経営方針・経営環境の記載に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "アンカーや落橋防止装置など、創業以来培ってきたケーブル製品のコアテクノロジーと、技術審査証明を取得した独自工法の蓄積が強みです。建設コンサルタントや補修・補強工事の子会社を持ち、資材の製造販売から設計支援、施工、維持管理までをグループで担える体制も特徴です。",
        "basis": "事業の内容、沿革、関係会社の状況、セグメント情報に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建設用資機材では地すべり防止や橋梁の耐震・落橋防止といった防災・インフラ分野に特化した専業メーカーです。建設コンサルタント事業では、フランス語圏のアフリカ諸国をはじめとする海外ODA市場での実績を強みとしています。",
        "basis": "事業の内容、MD&Aのセグメント別の経営成績、セグメント情報に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
