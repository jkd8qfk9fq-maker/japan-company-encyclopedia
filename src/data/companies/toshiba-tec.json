  "history": [
    {
      "year": 1950,
      "title": "東京芝浦電気から分離独立し、東京電気器具を設立",
      "description": "1950年2月、企業再建整備法により東京芝浦電気（現・東芝）から分離独立し、東京電気器具の商号で発足しました。本店は静岡県田方郡大仁町でした。",
      "significance": "現在の東芝テックの出発点です。2026年3月31日現在、東芝は当社の親会社で、議決権の50.5％を間接保有分も含めて所有しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1962年11月、東京証券取引所市場第二部に上場しました。1969年8月に市場第一部に指定されました。",
      "significance": "上場会社としての歩みの始まりです。2022年4月にプライム市場へ移行し、現在に至ります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1966,
      "title": "東芝事務機を吸収合併",
      "description": "1966年10月、東芝事務機を吸収合併しました。",
      "significance": "事務機器の事業を取り込んだ出来事です。現在の事業は、POSシステムなどのリテールと、複合機などのワークプレイスの2本です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "テック電子と合併し、商号を「テック」に変更",
      "description": "1994年10月、テック電子と合併し、商号を㈱テックに変更しました。",
      "significance": "テック電子は1972年に、国内リテール事業の販売部門を分離独立させた会社です。販売を再び当社に統合しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "商号を東芝テックに変更し、東芝から複写機事業を譲り受け",
      "description": "1999年1月、商号を東芝テックに変更しました。同時に、東芝から複写機に係る事業を譲り受け、照明に係る事業を東芝ライテックに譲渡しました。",
      "significance": "現在の社名が定まり、複写機（現在の複合機）が事業に加わった節目です。2026年3月期、複合機の外部顧客への売上高は224,458百万円でした。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "東芝アメリカビジネスソリューション社を設立",
      "description": "1999年10月、米国に東芝アメリカビジネスソリューション社を設立しました。",
      "significance": "現在はワークプレイスソリューション事業の連結子会社で、当社の議決権の50.1％を所有しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "家電に係る事業を譲渡",
      "description": "2007年6月、東芝家電製造（現・東芝ライフスタイル）に家電に係る事業を譲渡しました。",
      "significance": "照明（1999年）に続き家電からも離れ、POSシステムと複合機に事業を絞っていく流れの一つです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "IBMからグローバルコマースソリューション事業を譲り受け",
      "description": "2012年8月、International Business Machines Corporation（IBM）からグローバルコマースソリューションに係る事業を譲り受けました。これにより東芝グローバルコマースソリューション社などが事業を始めました。",
      "significance": "海外のPOSシステム事業の基盤になった出来事です。東芝グローバルコマースソリューション社は現在、リテールソリューション事業の連結子会社で、売上高が連結売上高の10％を超える会社の一つです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場に移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、プライム市場へ移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東芝から東芝オーストラリア社を譲り受け",
      "description": "2022年10月、東芝から東芝オーストラリア社を譲り受けました。",
      "significance": "現在はワークプレイスソリューション事業の連結子会社で、製品の販売とソフトウェアの開発を担います。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "複合機等とインクジェットヘッドの事業を承継させる",
      "description": "2024年7月、エトリア㈱に複合機及びオートIDシステムの開発・製造に関する事業を、理想テクノロジーズ㈱にインクジェットヘッド事業を承継しました。1月には東芝テックビジネスソリューション中国社を設立しています。",
      "significance": "複合機などの開発・製造を外に承継した後も、当社は複合機を販売・保守する事業を続けています。2025年3月期の従業員数は15,509人で、前期の19,093人から減りました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
