  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "顧客満足度・株主満足度・社員満足度を最大限に実現し、新たな価値を創造して社会に貢献できる企業を目指すことを経営の基本方針とし、「他社ではできない製品と他社の追随を許さない高い技術力」を追求するオンリーワン企業を目指しています。2022年度からの中期経営戦略「ＣＨＡＮＧＥ～ニチノベーション 2026～」では、VSOP精神での顧客価値創造、社員が輝き続ける会社づくり、持続可能な社会への貢献を掲げ、コア技術の応用と進化による提案力の強化、グローバル戦略の強化、新事業・新分野への展開を進めています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "冷間鍛造金型で培ったコア技術を応用し進化させる提案力と、差別化戦略のもとで品質・納期・コストの順に対応する姿勢に特徴があります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、コア技術の応用と進化による提案力強化が掲げられ、当社は差別化戦略をとっていることからQDCの順に表記していることが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高では、金型事業が4,467百万円と最も大きく、精密部品事業が4,244百万円、フィルタ事業が2,280百万円と続いています。主要な顧客である三菱重工グループへの売上高が、売上高全体の26.9％を占めています。",
        "basis": "【セグメント情報等】に、2026年3月期の報告セグメントごとの外部顧客への売上高として金型事業4,467,834千円、精密部品事業4,244,738千円、フィルタ事業2,280,324千円、合計10,992,897千円が印字され、【関連情報】の主要な顧客ごとの情報に三菱重工グループへの売上高2,960,364千円が印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
