  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月からを初年度とする3か年の第9次中期経営計画では、「暮らしと産業の未来を支えるロジスティクス・パートナー ～Stronger Together～」をテーマに掲げ、基本方針として、既存業務の深化・多角化によるコア事業の拡大と新たな派生事業領域への進出、納期・温度帯等の要件に柔軟に対応できる安定した輸送体制の構築、デジタルを取り入れたオペレーティング・モデルの再設計、海外展開や新領域の拡張を支える人材の育成を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "輸出入手続きにおける検疫、検査、保税運送、輸出入通関までの一連の業務を自社グループで一貫して担える体制を持ち、東京税関からAEO認定通関業者の認定を受けています。取扱いの中心は食品で、畜産物・水産物・農産物といった温度管理や検疫が関わる貨物の取扱いを積み重ねてきました。",
        "basis": "事業の内容とセグメント情報における輸出入貨物取扱事業の業務範囲の記載、沿革におけるAEO認定通関業者の認定取得の記載、経営成績の分析における取扱品目別の売上高の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "営業収益の約7割は輸出入貨物取扱事業が占め、鉄鋼物流事業、その他事業、海外事業、国内不動産賃貸事業が続きます。本邦の外部顧客への営業収益が連結の営業収益の90％を超えており、事業の中心は国内にあります。有形固定資産は日本、シンガポール、中国に所在します。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への営業収益と、関連情報における地域ごとの情報（本邦の外部顧客への営業収益が90％を超えるため記載を省略、有形固定資産の所在地別金額）の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
