  "updatedAt": "2026-11-08",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「KOKUSAI ELECTRIC Way」を掲げ、コーポレートスローガン「技術と対話で未来をつくる」に則って事業を行っています。半導体製造プロセスの前工程における「成膜」工程に注力し、バッチALD技術やプラズマトリートメント技術を生かした高付加価値製品の販売拡大と研究開発、装置のライフサイクル全体にわたるサービスの拡充に取り組むとしています。中期経営計画は2026年5月に見直し、2029年3月期までに売上収益3,300億円以上を達成することを目標としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "難易度の高い成膜と高い生産性を両立するバッチALD技術が強みです。2025年のバッチALD対応装置市場と、枚葉プラズマトリートメント装置が属する市場では、いずれも売上高世界シェア1位となっています。富山と砺波の生産拠点に加え、韓国子会社でも製造し、顧客の製造拠点に近い場所にサービス拠点を置く体制も特徴です。",
        "basis": "【事業の内容】・【主要な設備の状況】の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上収益235,079百万円の地域別内訳は、中国が90,597百万円、韓国が57,570百万円、台湾が43,149百万円、日本が22,796百万円などで、海外向けが全体の9割を超えています。主要な顧客2社への販売が売上収益の約35%を占めています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
