  "history": [
    {
      "year": 1904,
      "title": "台湾南部で塩水港製糖会社が創立され、赤糖の生産を開始",
      "description": "1904年2月、台湾南部の塩水港庁岸内庄（現・台南県）に「塩水港製糖会社」が創立され、赤糖の生産を開始しました。これが当社の起源です。",
      "significance": "会社の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1950,
      "title": "塩水港倉庫株式会社として新たに発足し、塩水港精糖株式会社へ商号変更",
      "description": "戦後の1950年7月、塩水港倉庫株式会社として新たに発足し、同年8月に社名を「塩水港精糖株式会社」に変更しました。",
      "significance": "現在の会社の再出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1951,
      "title": "精糖事業を復活",
      "description": "1951年1月、精糖事業を復活させました。",
      "significance": "製糖会社としての事業を再開しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "東京証券取引所市場第２部に上場",
      "description": "1961年10月、東京証券取引所市場第２部に株式を上場しました。",
      "significance": "上場企業としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "大洋漁業株式会社と資本提携し、「パールエース印」ブランドが誕生",
      "description": "1964年8月、大洋漁業株式会社（現Umios株式会社）と資本提携し、「パールエース印」ブランドが誕生しました。",
      "significance": "現在の主力ブランドの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1966,
      "title": "横浜工場が竣工",
      "description": "1966年3月、横浜工場が竣工し、同年11月に本社を横浜市大黒町へ移転しました。",
      "significance": "国内生産体制の基盤ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1973,
      "title": "大阪工場が竣工",
      "description": "1973年1月、大阪府泉佐野市に大阪工場が竣工しました。",
      "significance": "西日本にも生産拠点を持ちました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1983,
      "title": "東洋精糖株式会社と業務提携し、共同生産会社の太平洋製糖株式会社を設立",
      "description": "1983年10月、東洋精糖株式会社と業務提携し、共同生産会社として太平洋製糖株式会社を設立しました。また、大阪工場でサイクロデキストリンの生産を開始しました。",
      "significance": "同業との共同生産とバイオ事業の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1990,
      "title": "乳糖果糖オリゴ糖の生産を開始",
      "description": "1989年10月に糖質研究所が竣工し、1990年11月に乳糖果糖オリゴ糖の生産を開始しました。",
      "significance": "オリゴ糖事業の本格化です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "「オリゴのおかげ」の全国販売を開始",
      "description": "1994年11月、乳糖果糖オリゴ糖を主成分とする新製品「オリゴのおかげ」の全国販売を開始しました。1995年10月には同シリーズ全製品について特定保健用食品の表示許可（整腸作用）を取得しました。",
      "significance": "バイオ事業の主力製品の発売です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "太平洋製糖株式会社において三社による共同生産を開始",
      "description": "2001年10月、横浜共同生産工場（太平洋製糖株式会社）において、塩水港精糖株式会社、東洋精糖株式会社、フジ日本精糖株式会社（現フジ日本株式会社）の三社による共同生産を開始しました。",
      "significance": "共同生産の体制が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "関西製糖株式会社を設立し共同生産を開始、本社を日本橋へ移転",
      "description": "2002年3月、大日本明治製糖株式会社（現ＤＭ三井製糖株式会社）、大東製糖株式会社との三社出資により関西製糖株式会社を設立し、同年7月に共同生産を開始しました。また、本社を東京都中央区日本橋へ移転しました。",
      "significance": "西日本での共同生産体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "三菱商事株式会社と資本提携し、株式会社パールエースを子会社化",
      "description": "2005年3月、マルハ株式会社との資本提携を解消し、三菱商事株式会社と資本提携しました。総発売元である株式会社パールエースを子会社とし、新たな生産・販売体制をスタートさせました。",
      "significance": "販売体制をグループ内に取り込んだ転機です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "東京証券取引所市場第１部に指定",
      "description": "2014年1月、東京証券取引所市場第１部に指定されました。",
      "significance": "市場区分が上がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所スタンダード市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しによりスタンダード市場へ移行しました。",
      "significance": "現在の市場区分への移行です。",
      "sourceIds": [
        "yuho-2026"
      ],
