  "businesses": [
    {
      "id": "heiwa-paper",
      "name": "平和紙業株式会社",
      "description": "東京都中央区に本社・東京本店を置く会社で、連結子会社3社からなるグループです。2026年3月31日現在の従業員数は188人で、東京証券取引所スタンダード市場に上場しています。事業は、和洋紙卸売業と不動産賃貸業の2つの報告セグメントで構成されています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "paper-wholesale",
          "name": "和洋紙卸売業",
          "description": "木材などの原料から製造された紙や紙加工品を販売する事業です。高付加価値の特殊紙が主力で、ファンシーペーパー、ファインボード、高級印刷紙、ベーシックペーパー、技術紙などの商品区分があります。当社と連結子会社の株式会社辻和、平和紙業（香港）有限公司が販売を担い、連結子会社の平和興産株式会社がグループの商品の物流、保管、紙加工業務を担っています。2026年3月期の外部顧客への売上高は15,786百万円です。",
          "customers": [
            "印刷会社や紙製品メーカー",
            "パッケージや出版などの紙を使う事業者"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "real-estate",
          "name": "不動産賃貸業",
          "description": "不動産の売買、賃貸借、管理及び仲介を行う事業です。当社が平和興産株式会社や取引先に不動産を賃貸しているほか、大阪事務所ビルや名古屋の賃貸マンション、時間貸駐車場などを賃貸しています。2026年3月期の外部顧客への売上高は10百万円です。",
          "customers": [
            "事務所や住戸、駐車場の賃借先"
          ],
