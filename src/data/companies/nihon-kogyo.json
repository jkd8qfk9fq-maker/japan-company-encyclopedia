  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年4月に中長期経営計画「Nikko Revolution Towards 2033」を策定し、「美しく豊かな環境作りを通じてサステナビリティ実現に貢献する日本興業グループ」を基本方針に掲げています。「グループ成長戦略」「サステナビリティ取組強化戦略」「人的資本活性化戦略」「経営基盤強化戦略」の4つの戦略を柱に、持続的成長による企業価値の向上を目指すとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "豊富な製品ラインナップと特注対応力を活かした提案営業に加え、3次元データなどのデジタル技術を使った高付加価値製品の拡販に取り組んでいます。低炭素型コンクリート「Necoコンクリート®」や自己治癒コンクリート「バジリスク」などの脱炭素製品も拡充しています。",
        "basis": "経営成績の分析に、特注対応力を活かした製品の提案、高付加価値製品の拡販、脱炭素製品の拡充への取組みが印字されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
