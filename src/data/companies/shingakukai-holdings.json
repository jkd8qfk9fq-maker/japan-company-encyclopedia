  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "教育関連部門では、高校受験指導を柱としながら、大学受験（現役高校生）部門及び中学受験部門の生徒層の獲得にも努め、採算の効率化を中期的な目標として、新規地域への進出及び不採算地区からの撤退を含めた教室のスクラップ＆ビルドを積極的に推進する方針です。日本全国どこでも受講が可能なオンライン塾「Go・Kaku」を開設し、会場による展開とは異なる形でのエリア拡大も進めています。スポーツ部門では、幼稚園や小学校からのスイミング授業の受託など、時世に合った営業活動を進める方針です。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "生徒数の確保が課題となる教育関連事業では、対象年齢層の拡大とオンライン塾によるエリア拡大で集客の間口を広げつつ、不採算会場の撤退で教室網の採算を高める方向性が読み取れます。提携各社とのアライアンスの強化により、指導法や教材開発、募集活動等のノウハウの共有を図ることも示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営成績等の分析における取組の記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "札幌市内の各地区に本部ビルを構え、旭川・帯広など北海道内に教室網を持つ地域密着の展開と、自社で教育ソフトや教材を開発できる体制が、強みを支える仕組みとして開示されています。スポーツクラブを学習塾の施設に併設する複合展開も行っています。",
        "basis": "事業の内容及び主要な設備の状況における教室網と事業体制の記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "教育関連業界では、少子化による企業間競争と淘汰が進み、厳しい環境が続いていると会社は見ています。入試制度改革や公立高校の無償化など教育に関する情勢の変化に対応できるサービスの開発や質の向上が求められていることも示されています。",
        "basis": "経営成績等の分析における業界環境の認識の記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
