  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「Raito2027」を掲げ、「技術×信頼×人財で、次世代の成長へ」を基本方針としています。防災・減災分野におけるブランド力の確立と社会課題の解決、特殊土木分野における国内外でのプレゼンス拡大、成長分野および人財への積極的な投資、成長投資と株主還元の4つを重点テーマとし、最終年度である2027年度の連結売上高1,350億円を目標としています。創業100周年を見据えた中長期ビジョンは「サステナブルな社会実現に向けて、人と技術の力で世界に貢献する」です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "経営理念「新たな価値に挑戦し、創造し続ける」のもと、常に時代の最先端技術に挑戦し、建設業にあって特殊土木という独自の企業分野を創造してきたとしています。2018年にはR&Dセンターを開設し、技術開発を続けています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高の99.9％を建設事業が占めます。工種別では基礎・地盤改良工事が約45％、斜面・法面対策工事が約28％、建築工事が約15％です。地域別では日本が123,181百万円と約88％を占め、北米が11,358百万円、その他が4,676百万円です。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの売上実績（工種別）と関連情報の地域ごとの売上高の印字に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
