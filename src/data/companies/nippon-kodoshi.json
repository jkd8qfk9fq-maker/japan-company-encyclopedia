  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "エレクトロニクス産業に不可欠な部材であるアルミ電解コンデンサ用セパレータおよび機能材を安定供給することにより顧客満足度を高め、エレクトロニクス産業の発展に寄与することを経営方針としています。3ヵ年中期事業計画（2025年3月期～2027年3月期）では、新規事業創出による事業ポートフォリオの転換、成長分野における重点的取り組みと新製品開発の強化、ESG経営基盤の強化、DXの推進、人的資本への投資の5つを基本戦略に掲げています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、生成AIの普及にともなうAIサーバー関連等の需要が好調で、アルミ電解コンデンサ用セパレータの売上高は前期比14.5％増の14,024百万円となりました。機能材も電気二重層キャパシタ用セパレータの需要が増え、前期比21.6％増の4,600百万円となり、売上高は前期比16.2％増の18,624百万円、親会社株主に帰属する当期純利益は2,642百万円でした。",
        "basis": "MD&Aの業績等の概要と、セグメント情報等の関連情報（製品及びサービスごとの情報、主要な顧客ごとの情報）による。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1943年から電解コンデンサ用セパレータの生産を続けてきた専門メーカーで、自社工場に複数の抄紙機を備えています。研究開発では、AIサーバー関連向けの中高圧コンデンサ用、車載向けの低圧コンデンサ用、ハイブリッドコンデンサ用、導電性高分子固体コンデンサ用など、用途ごとに求められる性能に合わせたセパレータの開発を進めています。",
        "basis": "沿革、研究開発活動、主要な設備の状況による。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "セパレータ事業の単一セグメントで、売上高は本邦の外部顧客への売上高が90％を超えています。最大の顧客は王子エフテックス株式会社で、2026年3月期の売上高の64.2％を占めており、1972年の業務提携以来の継続的な売買関係があります。",
        "basis": "セグメント情報等の関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）と、重要な契約等による。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
