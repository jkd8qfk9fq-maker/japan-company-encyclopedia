  "businesses": [
    {
      "id": "high-purity-chemicals",
      "name": "高純度化学化合物事業",
      "description": "半導体等製造用高純度化学化合物事業並びにこれらの付帯業務の単一セグメントです。主として半導体メーカー向けに、CVD材料、ドライエッチング材料、拡散材料の高純度化学薬品の開発・製造・販売を行います。地域ごとの売上高は中国8,116百万円、台湾8,060百万円、日本4,499百万円、韓国2,206百万円、その他1,000百万円です。当社と連結子会社１社（三化電子材料股份有限公司、台湾）、持分法適用関連会社３社（SK Tri Chem Co., Ltd.、株式会社エッチ・ビー・アール、安徳拓化 (安徽) 電子材料有限公司）、非連結子会社１社（上海特李化学科技有限公司）の６社でグループを構成し、相互に連携しながら事業を行います。2026年１月期の従業員数は313人です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "customers": [
        "半導体メーカー",
        "太陽電池メーカー",
        "光ファイバーメーカー"
      ],
      "children": [
        {
          "id": "cvd-materials",
          "name": "CVD材料",
          "description": "化学材料の蒸気を熱等により分解し、ウェハ上に絶縁膜や金属・導体膜・半導体膜などの薄膜を堆積させるCVD（化学気相成長）法に用いられる化学材料です。誘電率の低い膜が得られるlow-k材料、逆に誘電率の高い膜が得られるhigh-k材料、金属窒化膜材料など、新たなニーズに対応する材料を提案・供給します。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "dry-etching-materials",
          "name": "ドライエッチング材料",
          "description": "腐食による化学反応により、CVD法で堆積させた膜等の不要な部分を削り取り、ウェハ表面を凹凸に加工する技術に供される材料です。取り扱い製品の一つである臭化水素は、環境問題・微細化といった問題をクリアーする材料とされています。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "diffusion-materials",
          "name": "拡散材料",
          "description": "ウェハ上にトランジスタを形成する際、不純物を注入する技術（イオン打ち込み法と熱拡散法）に用いられる材料です。Ⅲ族元素であるホウ素・ガリウム・インジウム等と、Ⅴ族元素であるリン・ヒ素・アンチモン等に関わる材料をラインナップし、顧客の細かな要求に対応した容器に封入し出荷します。光ファイバーでも光の拡散を制御する目的でゲルマニウムに代表される不純物を使用します。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "ancillary-services",
          "name": "付帯サービス",
          "description": "製品の高付加価値化のため、化学薬品用容器の設計販売（化学関連法規等をクリアーした化学薬品輸送用タンクの設計及び販売）、化学薬品の受託合成（新規薬品の受託合成）、受託実験（共同開発高純度化学薬品の開発並びに薬品を用いたCVDに関わる受託実験）、化学薬品の物性調査や分析等のその他付帯サービスを行います。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        }
      ]
    }
