  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "３年間の中期経営計画（毎年見直すローリング方式）に基づき、生産性の向上や生産開発能力強化へ注力し、新規エッチング材料等の生産拠点である南アルプス事業所での大量生産に向けた各種評価、設備増強、認証取得等の取り組みを推進するとしています。あわせて品質管理体制の継続的な強化、環境負荷低減・作業安全性向上、サステナビリティの追求、事業継続計画の改善等にも引き続き取り組むとしています。",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "売上高は2022年１月期の11,574百万円から2024年１月期の11,246百万円まで伸び悩んだ後、2025年１月期の18,905百万円、2026年１月期の23,883百万円と大きく拡大しました。経営成績の分析では、生成AIの普及に伴う先端ロジック・メモリ半導体の高い需要やデータセンター投資の拡大を受けて化学材料の出荷が増加したとされています。",
        "basis": "経営指標等の売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績の概要による。",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "材料工学・応用化学の観点から、半導体の微細化に伴う材料変更の要求に対して新しい材料をいち早く提案し安定供給する開発提案力が中核です。既存製品の販売にとどまらず、新規化学薬品の受託合成、顧客が実際に使用する条件下で性質・性能を評価する受託実験、化学薬品用容器の設計販売といった付加作業を組み合わせて製品の高付加価値化と差別化を図っています。台湾の連結子会社、韓国・中国の持分法適用関連会社を通じた海外の開発・製造・販売体制も持っています。",
        "basis": "事業の内容と関係会社の状況による。",
        "asOf": "2026-04-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
