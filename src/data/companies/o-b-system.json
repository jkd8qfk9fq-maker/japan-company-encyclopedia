  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画では、クラウドや生成AI、ビッグデータなどのDX関連事業とAIの活用を成長の柱とし、業務システム開発力と人材の一層の強化、業務提携拡大による事業拡大の加速、資本業務提携（M&A）による事業拡大の推進を基本戦略としています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "大口顧客との継続案件を土台としながら、人材の強化と提携・M&Aによる開発体制の拡大で事業を広げる戦略です。",
        "basis": "中長期的な経営戦略に、全てのサービスラインにおいて売上の半数以上を長年の開発実績を有する同一の大口顧客である元請システムインテグレーター企業からの継続案件や運用保守案件が占めることと、業務システム開発力・人材の強化、業務提携の拡大、資本業務提携（M&A）の推進が掲げられていることによるものです。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "株式会社日立製作所及びBIPROGY株式会社と40年以上、三菱電機ソフトウエア株式会社と30年以上にわたってシステム開発の実績を積み重ねており、全てのサービスラインで大口顧客からの継続案件と運用保守が売上の半数以上を占める、安定した受注基盤を持っています。",
        "basis": "事業の内容に、株式会社日立製作所及びBIPROGY株式会社と40年以上、三菱電機ソフトウエア株式会社と30年以上にわたりシステム開発実績を積み重ねて大口取引先となっていることと、中長期的な経営戦略に、全てのサービスラインで売上の半数以上を同一の大口顧客からの継続案件や運用保守案件が占めることが記載されていることによるものです。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス業界では、DXの実現に向けた企業のIT投資による需要拡大が続く一方、システムエンジニアなどのIT人材の不足が続いています。その中で当社は、エンドユーザや元請システムインテグレーターから受託開発と運用保守を受けるシステムインテグレーターとして事業を行っています。",
        "basis": "経営環境に、DXの実現に向けた企業の旺盛なIT投資による需要拡大が続き、システムエンジニア等のIT関連の人材不足が続いていることと、足元の国内情報サービス市場は過去最高水準を更新し中長期的にも市場規模の拡大が期待されることが記載されていることによるものです。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
