  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年4月1日付で、子会社のＮＳＤ‐ＤＸテクノロジー(株)はＮＳＤ ＡＩテクノロジー(株)に、(株)ステラスは(株)ＮＳＤデジタルソリューションズに商号変更し、(株)アートホールディングスは完全子会社である(株)アートテクノロジーを存続会社とする吸収合併により消滅しました。本登録の内容は2026年3月31日現在のグループ構成に基づいています。"
    ]
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期的に目指す姿として「人とＩＴの未来」を提案する会社を掲げ、システム開発事業における持続的な成長の達成、ＤＸやＡＩ分野への一層の注力、コンサルティング事業の強化、ソリューション事業における規模の拡大などを主要戦略としています。2027年3月期から2029年3月期までの中期経営計画を公表し、ＤＸ・ＡＩソリューション事業への取り組みを加速して、より付加価値の高い企業体質への変革を図る方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "創業以来、金融業をはじめとする幅広い業種の顧客との長年の取引を通じて技術力と業務知識を深め、「顧客業務プロセスの知見」を蓄積してきました。厚い自己資本と、社内に多くの優秀なシステムエンジニアを確保していることにより、安定的で効率的な経営基盤を構築しているとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは、システム開発事業の金融ＩＴ、産業ＩＴ、社会基盤ＩＴ、ＩＴインフラと、ソリューション事業の5つです。2026年3月期の外部顧客への売上高は、金融ＩＴが35,073百万円（連結売上高の29.8％）、産業ＩＴが27,671百万円（23.5％）、社会基盤ＩＴが24,147百万円（20.5％）、ソリューション事業が17,707百万円（15.0％）、ＩＴインフラが13,214百万円（11.2％）です。本邦の外部顧客への売上高が連結売上高の90％を超え、売上高の10％以上を占める特定の顧客はありません。グループは当社と子会社14社、関連会社3社で構成され、連結の従業員数は4,555人です。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高と、関連情報の地域ごとの情報・主要な顧客ごとの情報、事業の内容のグループ構成、連結経営指標等の従業員数によります。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
