  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2022年に策定した北ガスグループ経営計画「Challenge 2030」のもと、「エネルギーと環境の最適化による快適な社会の創造」の実現に向け、総合エネルギーサービス事業の進化による分散型社会の形成、カーボンニュートラルへの挑戦、デジタル技術の活用による事業構造変革の3つの主要施策に取り組みます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "都市ガス、電力、熱を組み合わせた総合エネルギーサービスを北海道全域に展開しています。石狩LNG基地や北ガス石狩発電所などの供給拠点を持ち、取付メーター件数は2026年3月末現在で606,177件です。",
        "basis": "有報の事業の内容とセグメント情報、経営者による分析に印字された供給拠点と取付メーター件数です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は174,519百万円、親会社株主に帰属する当期純利益は11,525百万円で、従業員数は1,641人です。東京証券取引所プライム市場と札幌証券取引所に上場しています。",
        "basis": "有報の連結経営指標等に印字された2026年3月期の数値と表紙の上場取引所です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
