  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2029年の創立100周年に向けて3ヵ年の「2027中期経営計画」を策定し、創立100周年の「ありたい姿」の実現に取り組んでいます。電力分野ではデータセンターの急増や半導体工場の新増設による電力需要の伸びとカーボンニュートラルに向けた取り組みによる需要を見込み、通信分野では5Ｇ基地局の資機材や通信鉄塔の延命化工事の受注に取り組み、交通等インフラ分野では老朽化した道路関連設備の更新の受注と無電柱化の提案に取り組む方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "送電・配電・通信の設備材料の製作・販売から、通信鉄塔や道路・地中線の設備工事、表面処理までを、当社と製品販売を担う連結子会社が一体となって電力・通信・交通の公共インフラ向けに提供できる体制が特徴です。",
        "basis": "セグメント注記の外部顧客への売上高、【事業の内容】に記載の事業内容、【関係会社の状況】の子会社の役割、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高23,747百万円のうち電力・通信インフラ事業が19,589百万円と大半を占め、最大の販売先である東京電力パワーグリッド向けが総販売高の31.1％を占めるなど、電力会社向けの販売が中心の事業構成です。",
        "basis": "セグメント注記の外部顧客への売上高、【関連情報】の主要な顧客ごとの情報、MD&Aの販売実績に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
