  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コンテンツ事業の中長期的な成長を目指し、2023年3月期からコンシューマーゲーム及びスマートフォンゲームへの研究開発費を大幅に増額して、成長をけん引する柱となる新しいコンテンツの創出に取り組むとしています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1986年の設立以来ゲーム開発を続けてきた実績があり、「Fit Boxing」や「メダロット」などの自社シリーズに加え、版権元から使用許諾を得たキャラクターコンテンツも展開しています。連結子会社の株式会社SoWhatがスマートフォンゲームの開発を担い、企画開発体制をグループで持っている点が強みです。",
        "basis": "【沿革】に1986年の設立と「Fit Boxing」「メダロット」などの発売が、【事業等のリスク】に版権元から使用許諾を得て展開するサービスがあることが、【関係会社の状況】に株式会社SoWhatがスマートフォンゲームの開発を行う連結子会社であることが印字されていることに基づきます。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主軸のモバイルコンテンツ市場は変化が速く競争も激しい環境にあり、売上は任天堂やNTTドコモ、Apple、Googleなどの特定のプラットフォーム・販売先に依存する構造になっています。",
        "basis": "【事業等のリスク】にモバイルコンテンツ市場の変化の速さと競争の激しさ、特定事業者への依存が、【セグメント情報等】の主要な顧客ごとの情報に任天堂・NTTドコモ・Apple・Googleへの売上が印字されていることに基づきます。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
