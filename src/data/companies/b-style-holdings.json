  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 当社は、2026年4月1日付で普通株式1株につき2株の割合で株式分割を行っています。主要な経営指標等の株式関連の指標は、当該分割が第4期の期首に行われたと仮定して算定して印字されています（主要な経営指標等の推移の注記に記載）。本登録はこの算定後の数値に基づいています。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力事業を強化するとともに事業領域を広げることを事業戦略の方向性とし、人材の採用支援、育成・定着支援、業務支援をワンストップで提案するとしています。労働力の供給面では「しゅふJOB」の強みを活かしてしゅふの活躍を支援し、派遣・紹介事業では集客の強化と「スマートキャリア」のリブランディングを進めるとしています。メディア事業では認知度を高める投資とエリア拡大を進め、労働需要そのものを減らす取り組みとしてDX推進による工数削減にも注力するとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "しゅふ層に絞った求人メディアと派遣・紹介サービスを組み合わせ、求人数に占めるパートタイム派遣の比率を約82％（2026年3月期）と高く維持していることが特徴です。",
        "basis": "【事業の内容】に、約20年間にわたる事業運営の中で培った豊富な求人情報と膨大な求職者データベースにより、求人数に占めるパートタイム派遣の比率を約82％（2026年3月期）に維持していることが印字されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "人材派遣市場の中で、しゅふ層を主な対象とする領域に絞って事業を展開しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、日本の人材派遣の市場規模は9兆9,005億円（厚生労働省2024年労働者派遣事業報告）であり、当社グループがターゲットとする「しゅふ」層に類する有効市場は1兆1,689億円と試算していることが印字されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
