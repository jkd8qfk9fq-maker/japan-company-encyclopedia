  "history": [
    {
      "year": 1952,
      "title": "大伸化学株式会社を設立",
      "description": "1952年12月、東京都港区芝新橋（現東新橋）において、シンナーの製造販売を目的として大伸化学株式会社を設立しました。",
      "significance": "当社の創業であり、有機溶剤専業メーカーとしての起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "越谷工場を設置",
      "description": "1970年５月、埼玉県越谷市に越谷工場を設置し、同時に草加工場（1960年設置）は閉鎖して売却しました。",
      "significance": "現在の主力生産拠点の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "米国デュポン社と提携し家庭塗料の国内総発売元となる",
      "description": "1976年４月、米国デュポン社と提携し、同社の家庭塗料の国内総発売元となりました。提携先は1985年にベルギーデュポン社へ変更され、1990年、同社の生産中止により当社も販売を中止しました。",
      "significance": "海外メーカーとの提携による事業展開の事例です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "兵庫工場を設置",
      "description": "1985年５月、西日本の生産拠点として兵庫県神崎郡福崎町に兵庫工場を設置しました。",
      "significance": "越谷工場と並ぶ現在の二大生産拠点がそろいました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1995,
      "title": "株式を店頭売買有価証券として登録",
      "description": "1995年10月、当社株式を日本証券業協会の店頭売買有価証券として登録しました。",
      "significance": "株式公開の第一歩です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "台湾に連結子会社を設立",
      "description": "1997年７月、台湾に連結子会社、台湾大伸股分有限公司を設立しました（出資比率51％、その後93.25％まで引き上げ）。同社は2002年１月に清算結了しました。",
      "significance": "海外生産拠点の設置と撤退の経緯です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "EMIシールド事業より撤退",
      "description": "2001年３月、1997年に事業本部を設置して進出していたEMIシールド事業（プラスチック筐体の電磁波シールド加工）より撤退しました。",
      "significance": "有機溶剤専業への回帰を示す判断です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "ジャスダック証券取引所に上場",
      "description": "2004年12月、株式会社ジャスダック証券取引所に株式を上場しました。その後、取引所の統合等を経て東京証券取引所ＪＡＳＤＡＱ（スタンダード）に上場し、2022年４月の市場区分の見直しによりスタンダード市場へ移行しました。",
      "significance": "現在の上場市場の経緯です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "山崎梱包運輸株式会社を完全子会社化",
      "description": "2022年10月、山崎梱包運輸株式会社の全株式を取得し完全子会社化しました。",
      "significance": "現在唯一の連結子会社であり、東日本地域における当社製品の配送を担います。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "東京支店を本社に統合",
      "description": "2025年４月、埼玉県越谷市に置いていた東京支店を本社に統合しました。あわせて同年９月には台湾の大勤化成股分有限公司の株式を追加取得し、出資比率を10％としました。",
      "significance": "販売体制の再編と台湾提携先への出資強化です。",
