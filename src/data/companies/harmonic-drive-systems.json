  "history": [
    {
      "year": 1970,
      "title": "ハーモニック・ドライブ・システムズを設立",
      "description": "1970年10月、株式会社長谷川歯車と米国法人ユーエスエムコーポレーション（USM社）との合弁契約に基づき、東京都大田区に株式会社ハーモニック・ドライブ・システムズが設立されました。長谷川歯車から、USM社との技術提携契約によるハーモニックドライブ機構の営業権を受け継ぎ、同年11月に松本工場でハーモニックドライブ減速機の製造を開始しました。",
      "significance": "波動歯車装置の技術を日本で事業化する出発点となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1977,
      "title": "FA機器（現メカトロニクス製品）の製造・販売を開始",
      "description": "1977年11月、FA機器（現在のメカトロニクス製品）の製造・販売を開始しました。",
      "significance": "減速装置単体にとどまらず、応用製品へ事業を広げる起点となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "新歯形（IH歯形）の減速機を発売",
      "description": "1988年6月、新しい歯形であるIH歯形のハーモニックドライブ減速機の製造、販売を開始しました。",
      "significance": "主力製品の性能を高める技術的な節目となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1989,
      "title": "新会社への営業譲渡で事業を継承",
      "description": "1989年2月、旧会社の100％子会社として新しい株式会社ハーモニック・ドライブ・システムズが設立され、同年3月に旧会社から営業の譲渡を受けました。旧会社は同年4月に株式会社光電製作所に吸収合併され、新会社はその100％子会社となりました。",
      "significance": "現在の会社が事業の実質を引き継いだ経緯であり、沿革の記載は実質上の存続会社である旧会社について行われています。",
      "sourceIds": [
