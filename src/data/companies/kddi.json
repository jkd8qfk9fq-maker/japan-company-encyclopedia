  "history": [
    {
      "year": 1984,
      "title": "第二電電企画株式会社を設立",
      "description": "電気通信事業法の施行を前に、民間の電気通信会社として第二電電企画株式会社が設立されました。翌1985年に商号を第二電電株式会社に改めています。",
      "significance": "有価証券報告書が「当社の前身」と記す会社で、現在のKDDIの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1987,
      "title": "セルラー電話会社の設立を開始",
      "description": "関西セルラー電話株式会社を子会社として設立し、以後、九州・中国・東北・北陸・北海道・四国・沖縄と各地にセルラー電話会社を設立していきました。",
      "significance": "これらの会社は2000年に合併して株式会社エーユーとなり、現在のパーソナル事業の移動通信サービスにつながっています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2000,
      "title": "KDD・日本移動通信と合併",
      "description": "KDD株式会社および日本移動通信株式会社と合併し、商号を株式会社ディーディーアイに変更しました。同年11月には沖縄セルラー電話を除くセルラー電話会社7社が合併し、株式会社エーユーとなりました。",
      "significance": "現在のKDDIの直接の母体となった合併です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2001,
      "title": "KDDI株式会社に商号変更し、エーユーと合併",
      "description": "4月に商号をKDDI株式会社に改め、3月に株式交換で完全子会社としていた株式会社エーユーと10月に合併しました。",
      "significance": "現在の社名になり、移動通信を含む事業を1社で担う体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2007,
      "title": "東京電力の光ネットワーク事業を承継",
      "description": "東京電力株式会社の社内カンパニーである光ネットワーク・カンパニーに係る事業を、会社分割により承継しました。",
      "significance": "固定通信の設備と事業を自社に取り込み、現在の固定通信料収入につながる基盤となりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2013,
      "title": "株式会社ジュピターテレコムを子会社化",
      "description": "2010年に持分法適用関連会社としていた株式会社ジュピターテレコムの株式を一部取得し、連結子会社としました。",
      "significance": "同社を引き継ぐJCOM(株)は、現在もパーソナル事業とビジネス事業の主要な連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2019,
      "title": "金融各社をauフィナンシャルホールディングスに集約",
      "description": "株式会社じぶん銀行、KDDIフィナンシャルサービス株式会社、株式会社ウェブマネーなどの株式を、会社分割によりauフィナンシャルホールディングス株式会社に承継しました。同年12月にはau損害保険株式会社やライフネット生命保険株式会社なども同社に移しています。",
      "significance": "同社はパーソナル事業の主要な連結子会社であり、通信と組み合わせて提供する金融サービスの中核です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2024,
      "title": "株式会社ローソンを持分法適用会社化",
      "description": "株式会社ローソンの株式を一部取得し、持分法適用会社としました。",
      "significance": "現在はパーソナル事業の持分法適用共同支配企業として、通信以外の顧客接点を担っています。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
