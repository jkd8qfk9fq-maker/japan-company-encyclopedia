  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "設立以来、中高年男性をターゲットにした「付加価値訴求型通販」を展開し、「新しさ」「夢」「面白さ」などを基本コンセプトとする「ウォンツ商品」で日本一のウォンツ創造企業を目指すとしています。商品戦略ではウォンツ商品の開発強化とブランド化、顧客戦略では中高年男性層の拡大に加えて女性市場も視野に入れた新しい顧客の拡大に注力するとしています。不動産事業では賃貸収入の増加と販売用不動産の売却の検討、通所介護事業では利用者数の増加と業務の効率化を課題としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "カタログを眺めて欲しいものを見つける楽しさを訴求する品揃えと、電話を通じた顧客対応を行うコールセンター機能が、通信販売の強みとして読み取れます。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期は、販売用不動産の売却により不動産事業が最大のセグメントとなりました。主要な顧客として、通販小売事業と不動産事業の相手先である株式会社ピコイと、不動産事業の相手先であるフリージアソリューション株式会社が開示されています。",
        "basis": "セグメント情報等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
