  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「店はお客様の満足を得るために存在する」ことです。「安全・安心で、おいしさを追求した価値観のある商品」と「高い付加価値のサービス」を提供することを基本方針としています。“みんなの食卓でありたい”をスローガンに、新規出店、既存店改装、人材投資に取り組んでいます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "牛めし「松屋」を中心に、とんかつ、ラーメン、鮨、カレーなど多様な業態を展開し、フランチャイズ店を含め1,573店舗を運営しています。セントラルキッチン方式で工場・生産物流センターから店舗へ食材を供給しています。",
        "basis": "多業態の展開と店舗数が有報に記載されており、セントラルキッチン方式による食材の加工・供給も有報に記載されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は1,844億74百万円で前期比19.6％増、親会社株主に帰属する当期純利益は37億72百万円で前期比72.6％増となり、いずれも過去最高益です。国内直営店売上が売上高の94.0％を占めています。",
        "basis": "売上高・当期純利益と前期比、国内直営店売上の構成比が有報に記載されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
