  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『メディアの革新を通じて情報革命を実現し、社会に貢献する』を企業理念とし、ITを中心とした専門性・信頼性の高い情報をインターネット経由で提供するとともに、社会的知識基盤としての情報コミュニティを提供することを経営の基本方針としています。テクノロジーの進化とともにメディアのあり方を革新し続け、ユーザーからの信頼をもとにしたコミュニケーション機会を顧客企業に提供し、企業価値の継続的な向上に努めるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "特定分野に精通した専門編集記者が提供する情報の質と量、速報性によりメディアとしての信頼感とブランドを築き、運営サイトのユニークブラウザ数は月間約6,000万、ページビュー数は月間約３億5,000万に達しています。広告モデルに加えて、見込み客の情報を獲得するリードジェネレーションのモデルを確立し、リードジェン会員数は139万人で、収益の過半がリードジェンモデルからもたらされています。",
        "basis": "事業の内容、セグメント情報、地域ごとの情報、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要による。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
