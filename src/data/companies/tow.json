  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス「新しい時代の体験を創る」のもと、2026年2月に中期事業成長ビジョンを策定し、「プロモーションとリアルエンタメを横断するエクスペリエンス・パートナー」を目指す姿として掲げました。成長戦略として掲げる「クライアントの拡張」と「領域の拡張」の2軸による事業拡大を推進し、エンタメ体験市場（リアルエンターテインメント）を成長領域と位置付けています。AI活用の基本方針「AI for Experience Partner」を掲げ、業務プロセス全体へのAIの組み込みも進めています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、売上の中心であるリアルイベントの拡大と、プロモーション領域からリアルエンタメ領域への事業領域の拡張の両立です。リアルイベントが伸長する一方でハイブリッドイベントと統合プロモーションは縮小しており、カテゴリー構成の変化への対応と、連結子会社の取得による領域拡張を並行して進めています。",
        "basis": "セグメント情報に代わる関連情報の主要な顧客ごとの情報と、MD&Aに記載のカテゴリー別売上高及び経営成績等の状況の概要に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企画から実施制作・効果検証までを一貫して担うプロデュース体制と、制作・運営・演出、映像制作、デジタルコンテンツを担う連結子会社群によるグループ内製の体制が特徴です。大型の式典・博覧会案件の受託実績を重ねており、広告会社との継続的な取引関係が受注の基盤となっています。",
        "basis": "セグメント情報に代わる関連情報の主要な顧客ごとの情報と、MD&Aに記載のカテゴリー別売上高及び経営成績等の状況の概要に基づきます。",
        "asOf": "2026-09-24",
