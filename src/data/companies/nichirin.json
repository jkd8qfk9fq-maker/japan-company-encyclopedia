  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年を初年度とする中期経営計画「NICHIRIN Flow Engineering Challenge 2030」を策定し、既存価値の極大化、成長ドメインの創出、グローバル深耕の3つの経営戦略と、DX・人材・サステナビリティ・財務資本の4つの基盤戦略からなる7つの全体戦略を遂行する。EV用部品の販売拡大や、住設・インフラなど非自動車領域の製品群の拡大にも取り組む。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "高分子設計技術と、社会と共創する開発姿勢を核とし、部品の提供にとどまらず顧客製品の性能向上とユーザーの安全・快適性を追求する。1914年の創立以来100年以上にわたる信頼を礎に、コア技術であるフローエンジニアリングを軸に行動する。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の報告セグメント別の外部顧客への売上高は、アジア22,697百万円、日本19,407百万円、北米14,633百万円、中国9,061百万円、欧州7,868百万円で、5地域に生産・販売拠点を持つ。製品は自動車用各種ホース類が中心で、売上高の90％を超える。売上高の10％以上を占める主要な顧客はない。",
        "basis": "セグメント情報等の報告セグメント別外部顧客への売上高と、関連情報（製品及びサービスごとの情報・主要な顧客ごとの情報）に基づく分析",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
