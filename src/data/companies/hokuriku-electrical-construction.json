  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「アクションプラン2027」を策定し、『一段高い成長路線を進み、変化に強い企業集団へ』をテーマに、SDGs最終年となる2030年度と創立100周年を迎える2044年度に描いた「目指すべき姿」からバックキャストした計画として実行しています。基本方針として「収益力の向上」と「高度な専門性・技術力をもつ人材の育成と組織力の向上」を掲げ、設備工事業では受注の確保を最優先課題に、北陸地域でのシェア拡大と大都市圏での営業基盤の強化に取り組んでいます。なお、計画の数値目標は転記していません。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "北陸3県をはじめ各地に支店・支社・営業所の体制を持ち、地域に根ざした営業・施工基盤があります。配電線工事では北陸電力送配電との工事委託契約に基づく受注が中心であり、電力供給設備に係わる電気工事を北陸電力グループから継続して請け負っています。経営理念のもと、安全と高い技術力で地域に貢献することを掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは設備工事業のみです。2026年3月期の設備工事業の完成工事高は588億69百万円、その他の事業の売上高は21億59百万円でした。主要な顧客ごとの売上高は、北陸電力送配電が17,009百万円、北陸電力が2,012百万円です。売上高はすべて国内であり、本邦以外の外部顧客への売上高はありません。",
        "basis": "セグメント情報の関連情報における主要な顧客ごとの情報と地域ごとの情報、経営成績等の分析におけるセグメントごとの経営成績に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
