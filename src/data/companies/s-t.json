  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社会に対するSERVICE（奉仕）とTRUST（信頼）を信条とし、社是「誠実」のもとでパーパス「こころに響くアイデアで、ふとした瞬間を、ふふっと笑顔に。」を掲げています。2024年4月からスタートした3ヵ年の中期経営計画「SMILE 2027」のもと、高収益な企業を目指してブランド価値経営を推進し、経営環境の変化に左右されない強い事業基盤の構築を目指しています。当期は「原価高騰対策」「ロスの削減」「価値の創造」「経営基盤の強化」に注力しました。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "単一セグメントの生活日用品事業の中で、エアケア（消臭芳香剤）が売上高の44.5％を占める主力カテゴリーです。2026年3月期はエアケアの高付加価値品と新製品が伸長し、前期に事業を取得したペットケア（猫用トイレ用品）や、米の価格高騰を背景に需要が増えたホームケアのフードケア商品も増収に寄与しました。",
        "basis": "セグメント関連情報の製品及びサービスごとの情報、MD&Aのカテゴリー別売上高と経営成績の分析、経営方針の中期経営計画",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「消臭力」「ムシューダ」「ドライペット」「オンパックス」など、カテゴリーごとに長年展開してきたブランド群を持ちます。福島・埼玉・九州・栃木の国内工場とタイ・台湾の生産拠点を持ち、新宿区のエステーＲ＆Ｄセンターを中心とする研究開発体制で新製品を継続的に投入しています。",
        "basis": "事業の内容のカテゴリーと主要製品、主要な設備の状況の事業所一覧、沿革の工場と研究開発拠点の記録",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "生活日用品の製造販売を行うメーカーです。主要な顧客は日用品卸売業者で、2026年3月期の販売実績は株式会社PALTACが16,751百万円（34.5％）、株式会社あらたが12,842百万円（26.5％）です。本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "セグメント関連情報の主要な顧客ごとの情報と地域ごとの情報、MD&Aの主な相手先別の販売実績",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
