  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "成長戦略として、インターネットインフラ事業における安定したストック型収益基盤の拡大、インターネットインフラ事業とインターネット広告・メディア事業のシナジー創出、GMO GPUクラウドなどの新規事業の創出、買収や合弁事業による規模拡大の4点を掲げています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は78,548百万円で、前連結会計年度の12,997百万円から拡大しました。インターネットインフラ事業の既存サービスは堅調に推移し、2024年11月から提供を開始したGPUホスティングサービス「GMO GPUクラウド」は第4四半期に単体での黒字化を達成しました。インターネット広告・メディア事業は広告主のマーケティングのインハウス化の影響を受けましたが、組織体制の見直しにより回復しました。",
        "basis": "MD&Aの経営成績の状況と、経営方針の経営戦略等の記載に基づく。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ドメイン、クラウド・レンタルサーバー、インターネット接続などのインフラサービスは、高い知名度を有するGMOブランドと、継続課金型の商材を背景に強固な収益基盤を持っています。2025年12月末における各サービスの国内契約件数は1,263万件で、ドメイン登録・販売やクラウド・レンタルサーバーでは国内で高いシェアを、インターネット接続では顧客の高い満足度を有しています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "インターネットインフラ事業では、ドメイン、レンタルサーバー、インターネット接続といった既存サービスが継続課金型のビジネスモデルを背景に堅調に推移しました。GPUホスティングサービス「GMO GPUクラウド」は立ち上げ期の先行投資を経て収益構造が安定化し、第4四半期に単体での黒字化を達成しました。",
        "basis": "事業の内容の各事業の記載と、MD&Aの経営成績の状況に基づく。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはインターネットインフラ事業、インターネット広告・メディア事業、その他の3つで、2025年12月期の外部顧客への売上高はインターネットインフラ事業65,864百万円、インターネット広告・メディア事業12,490百万円、その他193百万円です。本邦の外部顧客への売上高が全体の90%を超え、2025年12月期に売上高の10%以上を占める外部顧客はありません。前連結会計年度はLINEヤフー株式会社が2,227百万円、株式会社エポスカードが1,404百万円の主要な顧客でした。",
        "basis": "セグメント情報の報告セグメントごとの売上高と、地域ごとの情報及び主要な顧客ごとの情報の記載に基づく。",
