  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションとして「UPGRADE JAPAN」を掲げ、産業の価値源泉に深く入り込み、その潜在力をデータ・AI・テクノロジーで解き放つことを目指しています。大手企業との長期パートナーシップを前提とする戦略的なアライアンスをベースにした共同研究開発（Joint R&D）や、積極的な人材採用と育成による三位一体のチーム体制の強化を進め、AIエージェントやPhysical AIといった成長領域での最先端AI技術の社会実装を加速させる方針です。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "売上高の構成では、連結子会社化したメールカスタマーセンター株式会社が担うマーケティング支援事業が2026年6月期の外部顧客への売上高17,930百万円と最も大きく、会社が成長領域と位置づけるAIソリューション事業は4,508百万円で前期から大きく伸びています。事業構成の中心はなおダイレクトメール関連の事業にあります。",
        "basis": "報告セグメントごとの外部顧客への売上高（セグメント情報）と、セグメント別の販売実績（経営成績の状況の概要）に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ビジネス、データサイエンス、開発の三位一体のチーム体制で、産業課題の掘り起こしからAIアルゴリズムの開発、システム実装までを一貫して支援しています。東京大学の教授陣を顧問や社外取締役に迎え、共同で特許権を取得するなど学術面の知見を取り込んでいるほか、大手企業との共同開発を通じて各産業の非公開のデータにアクセスできる立場にあり、開発したAIソリューションやアルゴリズムの所有権は当社が持つため、複数の顧客への横展開ができます。",
        "basis": "事業の内容における当社グループの特徴と優位性の記載に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当連結会計年度に売上が発生した顧客のうち、4四半期連続で売上が発生した継続顧客の割合は約6割と印字されており、単発の受託開発ではなく継続的な関係を築いている顧客が多い構成です。単一の外部顧客への売上高は連結売上高の10％未満であり、特定の顧客に依存しない構成と印字されています。",
        "basis": "事業の内容における一気通貫支援の記載と、セグメント情報の関連情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
