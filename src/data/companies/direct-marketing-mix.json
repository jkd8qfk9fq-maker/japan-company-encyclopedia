  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営戦略として「持続的成長基盤の確立」を掲げ、新規顧客については小口の試験的な取引から本契約への移行により獲得を続け、既存顧客については営業・マーケティング機能全体の代替、提供する業務範囲の拡張、取引部署の横展開により取引を拡大し、高い顧客継続率の実現に努めると印字されています。主力3ドメインであるアウトバウンド、ハイブリッド、DXフルフィルメントの売上比率を高め、不採算案件の整理による収益性の改善も図っています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上収益は2022年12月期の34,673百万円をピークに2024年12月期に20,952百万円まで減少した後、2025年12月期に22,694百万円へ回復しました。マーケティング事業の外部収益は21,158百万円と前期の18,870百万円から増えた一方、オンサイト事業の外部収益は1,535百万円と前期の2,082百万円から減っており、回復はマーケティング事業が牽引しています。",
        "basis": "セグメント情報の外部収益と主要な顧客ごとの情報、地域ごとの情報、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンタクトセンターで日々収集されるエンドユーザーの生の声という情報資産と、独自の採用・育成により早期に戦力化した営業・マーケティングのプロフェッショナル人材のプールが強みです。アウトバウンドを中核チャネルとしつつハイブリッド業務やDXフルフィルメントへ展開し、大手顧客企業への価格転嫁も実施したと印字されています。",
        "basis": "事業の内容、セグメント情報の報告セグメントの概要、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
