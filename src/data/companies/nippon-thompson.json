  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年４月から３年間の「ＩＫＯ中期経営計画2026 Connect for Growth ～Ｉ・Ｋ・Ｏでつなぐ、革新の未来～」を進めており、当社の『強い領域』を集中的に強化し、『グローバル体制』の再構築を進めることで成長性を高め、長期ビジョン「ＩＫＯ ＶＩＳＩＯＮ 2030」の実現につなげるとしています。販売では顧客へのソリューション製品と技術サービスの提供、製品開発ではオープンイノベーションの推進と新成長領域への製品開発、生産では工程改善・自動化と最適地生産に取り組むとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1956年に針状ころ軸受の研究開発に着手して以来の軸受技術の蓄積を持ち、ＩＫＯブランドで製品を展開しています。当連結会計年度には、ラック＆ピニオン内蔵形クロスローラウェイや軽量形クロスローラベアリング、低断面・高推力のリニアモータテーブルなど新製品11品目を発表するなど、高付加価値製品の開発を続けています。",
        "basis": "沿革（針状ころ軸受の研究開発着手とブランドの商標登録）および経営成績の分析（新製品の発表品目）の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業は軸受等ならびに諸機械部品の製造・販売の単一セグメントです。2026年３月期の製品別売上高は軸受等が56,533百万円と連結売上高の約９割を占め、諸機械部品が6,497百万円です。地域別では日本が28,527百万円、中国が11,185百万円、米国が9,395百万円、欧州が6,689百万円、その他が7,234百万円で、海外売上高比率は54.7％です。売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の関連情報（製品およびサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
