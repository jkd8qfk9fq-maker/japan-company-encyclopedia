  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループミッション2030として「世界中の人々の楽しく健やかな暮らしをクリエイトするDyDoグループへ」を掲げています。5カ年（2023年1月期～2027年1月期）の「中期経営計画2026」では、「国内飲料事業の再成長」「海外飲料事業戦略の再構築」「非飲料領域の強化・育成」を3つの基本方針として、取り組みを進めています。",
        "asOf": "2026-04-14",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内飲料事業では、商品の製造や物流を外部に委託し、自社の経営資源は商品の開発と自販機オペレーションに集中させています。ダイドードリンコとアサヒ飲料株式会社の自販機直販事業を傘下に置くダイナミックベンディングネットワーク株式会社により、自販機による直販事業を一体的に運営する体制をとっています。",
        "basis": "【事業の内容】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-04-14",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年1月期の連結売上高241,236百万円の内訳は、国内飲料事業が142,532百万円と約6割を占め、海外飲料事業が65,341百万円で続きます。顧客の所在地別の売上高は、日本が175,764百万円、トルコが45,695百万円、ポーランドが14,301百万円、その他が5,474百万円です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-04-14",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
