  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年10月に、2028年3月期を最終年度とする中長期経営計画「炎のスクラム」を策定しました。ビジョンに「車と家を地球環境に資するものづくりでつなぐ」を掲げ、三事業の横断的な販売の強みを活かして、カーボンニュートラル社会の実現に向けた技術・製品開発を進めています。目指す姿として、自動車機器事業では点火コイルの世界シェア首位、エネルギーソリューション事業では住宅用蓄電システムの国内シェア首位の堅持、電子機器事業では国内インバーターエアコン用リアクター市場のシェア首位を掲げています。新規事業では、アンモニア燃焼技術などの次世代燃料の点火燃焼技術、熱電発電システム、地域脱炭素・マイクログリッド、バッテリー診断技術の確立に取り組んでいます。",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自動車用点火コイルは創業以来の主力製品で、点火コイルなどの内燃機関向け部品と、太陽光発電用パワーコンディショナなどの定置型エネルギー機器の両分野に製品を持っています。製造拠点は日本、米国、ハンガリー、中国、インド、タイ、インドネシア、ベトナム、メキシコなどに広がり、自動車メーカーの海外展開に沿った供給体制を持っています。アンモニア燃焼などの次世代燃料向けの点火技術の開発も進めています。",
        "basis": "事業の内容、主要な設備の状況、経営方針に基づく。",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは自動車機器事業、エネルギーソリューション事業、電子機器事業の3つです。2026年3月期の外部顧客への売上高は、自動車機器事業が40,468百万円と最も大きく、電子機器事業が30,956百万円、エネルギーソリューション事業が24,142百万円でした。地域別では日本が39,529百万円で、米国、中華人民共和国、インドなど海外の売上も広がっています。電子機器事業の主要な顧客はダイキン工業株式会社で、売上高全体の10％を超える最大の販売先です。",
        "basis": "セグメント情報（報告セグメントの外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-07-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
