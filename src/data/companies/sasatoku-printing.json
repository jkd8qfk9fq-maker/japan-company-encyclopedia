  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本理念の一番に「お客様の信頼第一」を掲げ、企業スローガンを「Good Communication, Good Partner」としています。2026年7月から2030年6月までの中期経営計画では、ビジョンに『「想いをカタチに」「包む」と「伝える」でソリューションを提供するパートナーへ』を掲げ、基本方針として「コア事業の更なる強化と拡大」「生産体制の拡充と最適化」「サステナビリティ経営の推進」の３項目を定めています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製造工程の異なる紙器・軟包装・プリントメディアを、各工場が完成品までの生産体制を備える「一環生産体制」で手がけています。国内の製造拠点はいずれも高速道路のインターチェンジから車で５分以内の立地にあります。",
        "basis": "【事業の内容】における一環生産体制と製造拠点の立地の記述に基づく。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年6月期はパッケージング分野が売上高の７割超を占め、自動車用品及び菓子・食品向けの受注が増えた一方、家庭用品向けは低調でした。コミュニケーション分野は、情報媒体のデジタル化が進むなかでプリントメディアの数量の減少と価格競争の激化もあり低調に推移しましたが、販促のイベント企画や動画・ドキュメント制作の受注は堅調でした。海外では中国の子会社がパッケージの製造・販売を、インドネシアの子会社がパッケージの販売を行っています。",
        "basis": "経営者による分析における商品分野別の売上高と概況の記述に基づく。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
