  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年3月期から2029年3月期までの3年間を計画期間とする中期経営計画を策定しています。事務系人材サービス事業では、主力のBPO関連事業部門で地方自治体取引の事業展開地域と業務領域のダブル広域化を進め、民間企業向け取引でも事業拡大に取り組みます。製造系人材サービス事業では、派遣業務主体からの脱却に向けて請負業務と人材紹介業務を拡大し、営業拠点の充実を図ります。新規事業開発として、事務系では民間企業向けBPOの業務領域拡大、製造系では高スキル外国籍スタッフを軸とした新規業務領域への参入を推進し、AIの活用などによるDXやインフラ整備、高スキル人材の採用に積極的に投資するとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の中心は事務系人材サービス事業であり、その中でもBPO関連事業部門が26,715百万円と最も大きく、地方自治体や企業向けの企画提案型の案件が主力であることが事業部門別の売上高から読み取れます。",
        "basis": "セグメント情報の外部顧客への売上高とMD&Aの事業部門別売上高、【事業の内容】の事業部門の説明に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "BPO関連事業部門では、経験豊富なスーパーバイザーをリーダーとするチーム派遣を行っています。就業スタッフ1,000名を超える大型案件でも、受注からスタッフ供給、事前研修、体制構築、業務開始までを1ヵ月程度で整えられることが特徴であるとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "BPO関連事業部門は地方自治体との取引を広げており、取引地方自治体数は206となっています。マイナンバー関連案件に加えて戸籍法改正関連案件や市民窓口案件など業務領域を広げ、既存の取引先からの受注を積み重ねる形で事業を拡大しています。",
        "basis": "【事業の内容】のBPO関連事業部門の説明と、MD&Aに印字された取引地方自治体数（206地方自治体）に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高44,642百万円の内訳は、事務系人材サービス事業35,534百万円、製造系人材サービス事業8,855百万円、その他（自動車管理事業）252百万円です。売上はすべて本邦の外部顧客に対するもので、本邦以外の外部顧客への売上高はありません。主要な顧客である株式会社ＤＮＰコアライズへの売上高は7,817百万円で、全体の17.5％を占め、事務系人材サービス事業に関係します。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）、MD&Aの相手先別販売実績の印字に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
