    {
      "year": 2024,
      "title": "NETSEAとaucfan.comが「1688.com」とAPI連携",
      "description": "連結子会社のNETSEAが、中国最大級、アリババグループのBtoBマーケットプレイス「1688.com」とAPI連携し、相場検索サイトaucfan.comも同サイトとAPI連携しました。",
      "significance": "中国の卸売プラットフォームとのデータ連携・流通連携が進みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "OEM自社ブランド「AP LAB」の販売とライブコマース「NETSEA MallLive」を開始",
      "description": "中国商品のOEM自社プロダクト「AP LAB（エーピーラボ）」の販売を開始し、ライブコマース事業「NETSEA MallLive（ネッシーモールライブ）」を開始しました。一方、不採算事業の整理により「NETSEAオークション」のサービスを終了し、Amazonセラー専用アプリ「Amacode」は第三者へ譲渡しました。",
      "significance": "D2Xコマースへの事業転換と不採算事業の整理が進みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "D2Xコマースの拡大に向け新物流センターを開設",
      "description": "多様な中華圏商品をtoC、toSmallB、toBに提供するD2Xコマース（Direct to X）を成長事業とし、埼玉県新座市に新物流センターを開設しました。アパレル新ブランド「KACHIKA（カチカ）」の販売も開始しました。",
      "significance": "決算期末後の出来事ですが、沿革に印字されているため記載しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
  ],
