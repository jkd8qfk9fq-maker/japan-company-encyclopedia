  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中核戦略として「BtoB取引市場のDX化」を掲げ、BtoB卸モール「NETSEA」などを通じて国内流通構造のデジタル化に取り組んでいます。今後は、OEM自社ブランド販売「AP LAB」とライブコマース「NETSEA MallLive」によるD2Xコマース領域を新たな成長ドライバーと位置づけ、事業ポートフォリオの再構築と選択と集中を進めています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "『aucfan.com』には、サイト開設から2025年９月末時点で700億件を超える商品情報及び価格情報のデータが蓄積されており、この流通相場データとAI技術が、相場検索や出品支援などのサービスの基盤になっています。",
        "basis": "【事業の内容】に、aucfan.comの商品情報及び価格情報についてはサイト開設から2025年９月末時点で約700億件を超えるデータを蓄積していると印字され、【経営方針、経営環境及び対処すべき課題等】では、膨大な売買データとAI技術を活用して流通の可視化・効率化を推進してきたと印字されています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のBtoB取引市場は約300兆円規模と推定され、そのうちEC化されていない取引は約200兆円に上るとされており、同社はこの未開拓領域のデジタル化を成長の機会と位置づけています。",
        "basis": "【事業の内容】及び【経営方針、経営環境及び対処すべき課題等】に、国内のBtoB取引市場は約300兆円規模と推定され、そのうちEC化されていない取引は約200兆円に上ると印字されています（経済産業省2025年８月26日発表の電子商取引に関する市場調査に基づく推察として注記されています）。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
