  "relatedCompanies": [
    {
      "companyId": "tokyo-gas",
      "relationship": "business-partner",
      "description": "当社は、2024年4月1日付で東京瓦斯株式会社と資本業務提携契約を締結し、業務提携等の関係にあります。同社は第三者割当増資により当社普通株式11,877,600株を引き受け、2026年3月31日現在で発行済株式の13.02％を保有する大株主です。業務提携では、国内の陸上風力発電事業の開発、小規模分散型のNon-FIT太陽光発電事業の電力の販売、バイオマス発電事業における燃料・オペレーション、蓄電事業での協業を進めています。また、グループの持分法適用会社であるアールスリー蓄電所合同会社は、北海道石狩市の蓄電所について同社とオフテイク契約を締結しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【重要な契約等】"
    },
    {
      "companyId": "sumitomo-forestry",
      "relationship": "major-shareholder",
      "description": "住友林業株式会社は、2026年3月31日現在、当社の発行済株式の8.07％（7,360,000株）を保有する大株主です。連結子会社の苅田バイオマスエナジー株式会社は、バイオマス燃料の国内未利用材について、住友林業グループとの間で長期間にわたり数量を固定し上限価格を定めた調達契約を締結しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【大株主の状況】"
    }
  ],
