  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年度を最終年度とする中期経営計画のもと、WAFを起点としたプロダクトラインの拡充、運用サービスを統合した提供価値の深化、AIセキュリティへの集中投資、M&Aによる成長の加速という4つの戦略を推進するとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「攻撃遮断くん」の開発・運用・販売・サポートを自社で一貫して担い、日々蓄積する攻撃データと脆弱性情報をAIの学習やシグネチャの精度向上に生かす体制を持つことが強みです。脆弱性情報の蓄積は「SIDfm」で20年以上にわたります。",
        "basis": "事業の内容における、攻撃遮断くんの一貫提供とAIを活用した検知の印字、およびSIDfmが20年以上にわたり脆弱性管理の情報ベースとして活用されている旨の印字に基づく。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "導入実績で国内首位のWebセキュリティメーカーと位置づけられており、米国子会社を通じてAWS Marketplaceで世界中のAWS利用者にルールセットやサービスを販売する、海外販売の経路を持つ事業者です。",
