  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画（2025～2027年度）を推進し、「電気化学センサ技術を用いて『環境』に貢献する企業」を中長期の将来像として、全社戦略、国内事業戦略、海外事業戦略、社会課題解決への挑戦、サステナビリティの深化の５つの重点戦略に取り組む方針です。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "環境規制の強化や半導体設備投資の継続で拡大が見込まれる計測機器市場に向け、成長分野へ経営資源を移し、国内ではソリューション提供、海外では自社ブランドの浸透を進める戦略です。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、セグメント情報（計測機器事業の製品別売上高）及びMD&Aの経営成績の分析に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電気化学センサ技術を核とする分析機器の開発力と、電極・標準液の供給から保守・修理までを自社グループで担う体制が強みです。2026年３月期は電極・標準液、保守・修理部品、その他の売上高の合計が9,585百万円と、計測機器事業の半分以上を占めています。",
        "basis": "事業の内容と、セグメント情報の製品及びサービスごとの情報、MD&Aの分野別売上高に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "水質や大気などの環境計測とプロセス計測の分野で、上下水道や電力などの社会インフラ向けに分析機器を供給する専業メーカーです。販売は国内が中心で、2026年３月期の地域別売上高は日本が15,440百万円、中国が827百万円、その他海外が1,541百万円です。",
        "basis": "事業の内容と、セグメント情報の地域ごとの情報に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
