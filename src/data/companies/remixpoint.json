  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年12月9日に公表した中期経営計画（2027-2029）では、各事業が独自に成長戦略を描き、他社との業務提携や資本提携、M&A等を含めてスピード感をもって新たな取り組みを推進し、自立的に強化・拡大していく方針です。事業別では、ビットコインを中心とする暗号資産の取得及び運用とWeb3.0関連事業への参入、電力小売における相対電源の確保や需要家の開拓、FIP転化事業や系統用蓄電池の推進などを掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高の構成は、エネルギー事業の外部顧客への売上高21,092百万円が連結売上高17,751百万円を上回り、デジタルアセットマネジメント事業のマイナス分を電力小売が補う形になっています。蓄電ソリューション事業は2,392百万円と前期から増えており、電力小売を軸に蓄電池事業を伸ばし、暗号資産の運用を組み合わせる構成であることがうかがえます。",
        "basis": "セグメント情報等（報告セグメントごとの外部顧客への売上高）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（セグメント別の業績）、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電力小売では、市場連動型・固定単価型・両者のミックス型など多様な料金プランを備え、卸電力市場価格の変動が収益に与える影響を抑える体制を整えています。蓄電池事業では、蓄電池システムの設計・施工・運営・保守をワンストップで提供し、FIP転化や系統用蓄電池まで手がけています。",
        "basis": "事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（セグメント別の業績）に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電力小売では、販売代理店網の強化により高圧需要家の総契約容量が増え、低圧の法人・個人需要家の契約口数も増えています。一方で、卸電力取引価格の水準や容量拠出金の負担など、市場制度の影響を受ける事業環境にあります。主要な顧客ごとの情報では、売上高の10％以上を占める相手先はないとされています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績とセグメント別の業績）、セグメント情報等の【関連情報】（主要な顧客ごとの情報）に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
