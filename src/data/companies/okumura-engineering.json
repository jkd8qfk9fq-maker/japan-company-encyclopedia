  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月に公表した第2次中期経営計画（2026年3月期から2028年3月期）では、「既存領域の拡充」「海外市場の展開」「新領域への挑戦」の3つを基本戦略に掲げています。既存領域では脱炭素関連製品と高付加価値化で国内市場を深掘りし、海外では船舶排ガス用バルブやLNG用バルブを軸にグローバル展開を加速し、海外売上高比率の向上を図るとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "船舶排ガス用バルブでは、IMOのNOx3次規制で搭載が義務付けられた舶用排気ガス処理装置について、市場占有率約90％を占める世界的なライセンサー2社から製造販売認証を取得しています。また、型式、サイズ、部品、材質、制御方法といったカスタマイズの組み合わせにより10万種類を超える製品を取り扱い、標準製品では対応できないニッチ市場を開拓しています。",
        "basis": "【事業の内容】の船舶排ガス用バルブとカスタマイズバルブの記載に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上構成比は舶用が57.8％、陸用が42.2％で、舶用が陸用を上回っています。海外売上高比率は約2割で、主に韓国や中国向けに船舶排ガス用バルブを販売しています。",
        "basis": "【事業の内容】の市場区分別の売上構成比と、【関連情報】の地域別売上高の記載に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
