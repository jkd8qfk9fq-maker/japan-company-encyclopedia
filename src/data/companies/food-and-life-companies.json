  "history": [
    {
      "year": 1984,
      "title": "株式会社すし太郎を設立し、豊中市に1号店を出店",
      "description": "1984年10月に、前身の株式会社すし太郎（のちの旧株式会社あきんどスシロー）を設立し、大阪府豊中市に1号店を出店しました。",
      "significance": "現在の「スシロー」の事業の出発点として、有報の沿革はここから書き始めています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "1皿100円均一の第1号店を出店",
      "description": "1996年9月に、1皿100円均一の第1号店となる高司店を兵庫県宝塚市に出店しました。",
      "significance": "1991年に出店方針を直営店主体へ切り替えてからの店づくりを、価格の面で形にした出来事として沿革に記されています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2000,
      "title": "商号を株式会社あきんどスシローに変更",
      "description": "2000年12月に、商号を株式会社あきんどスシロー（旧株式会社あきんどスシロー）に変更し、本社を大阪府摂津市に移しました。",
      "significance": "現在のブランド名「スシロー」を社名に使い始めた時期です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "東京証券取引所市場第二部に上場",
      "description": "2003年9月に、東京証券取引所市場第二部に株式を上場しました。",
      "significance": "この上場は2009年4月に、公開買付けを経て廃止されました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "公開買付けにより、エーエスホールディングスの子会社になる",
      "description": "2008年11月に、エーエスホールディングス株式会社による旧株式会社あきんどスシローへの公開買付けが完了し、発行済普通株式の65.19％とすべての新株予約権を同社が保有して子会社になりました。",
      "significance": "翌2009年に吸収合併され、同年4月に上場を廃止しました。2008年には四国・東北・九州・北海道へも出店しています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "韓国に子会社を設立",
      "description": "2011年4月に、韓国ソウル市に子会社のSushiro Korea,Inc.を設立しました。",
      "significance": "海外展開の始まりとして沿革に記されています。2017年以降は台湾・シンガポール・香港・タイ・中国などにも子会社を設立しました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "株式移転で持株会社体制に移行",
      "description": "2015年3月に、単独株式移転で株式会社あきんどスシローホールディングスを設立し、持株会社体制に移行しました。同年10月に商号を株式会社スシローグローバルホールディングスに変更しました。",
      "significance": "現在のFOOD & LIFE COMPANIESの直接の前身にあたる持株会社が、この時に生まれました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "東京証券取引所市場第一部に上場",
      "description": "2017年3月に、東京証券取引所市場第一部に株式を上場しました。",
      "significance": "2022年4月には市場再編に伴い、プライム市場に移行しました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "FOOD & LIFE COMPANIESに社名変更し、京樽を子会社化",
      "description": "2021年4月に、社名を株式会社スシローグローバルホールディングスから株式会社FOOD & LIFE COMPANIESに変更しました。同月に株式会社京樽の全株式を取得し、子会社にしました。",
      "significance": "スシロー1ブランドから、持ち帰りすしなど複数の業態を持つグループへ広がった時期です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "米国とインドネシアに子会社を設立",
      "description": "2023年6月に米国にFOOD & LIFE COMPANIES USA, Corpとその子会社を、同年7月にインドネシアにPT. Indonesia Sushiro Restaurantsを設立しました。同年10月には中国に北京寿司郎餐飲有限公司を設立しました。",
      "significance": "海外スシロー事業の対象地域を広げる動きとして沿革に記されています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "マレーシアに孫会社を設立",
      "description": "2024年4月に、マレーシアに孫会社のSushiro Malaysia Sdn. Bhd.を設立しました。",
      "significance": "有報の沿革に載る最も新しい出来事です。現在は海外スシロー事業の子会社として、同事業に含まれています。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
