  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年5月に中期経営計画（2027年3月期～2029年3月期）を策定し、「本気でやる子を育てる」という教育理念の徹底実践を起点に、成績向上と志望校合格を実現する「合格実績戦略」を基本戦略としています。事業戦略の3本の柱は、標準校舎のさらなる伸長、大学受験部門と個別指導部門の強化による顧客生涯価値の最大化、インオーガニック領域の拡充促進です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は前期までの中期経営計画の最終年度にあたり、個別指導部門はフランチャイズ校を含めて76校体制となり、2026年3月に個別指導本部が新設されました。東進衛星予備校は9校体制となり、大学受験部門での新領域の開拓が進められています。",
        "basis": "経営方針の経営環境と経営戦略等と、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "強みの源泉として難関上位校への合格実績を挙げています。今春の中学入試では御三家中学の合格者数が過去最高を更新し、高校入試と大学入試でも合格者数が大きく伸長したことで、ブランド力と集客力が高まる好循環が生まれていると説明しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "少子化が進む中でも期中平均塾生数は50,837人と前期比4.0％増となり、小学部は30,666人と前期比4.9％増で全体を牽引しました。合格実績の伸長と塾生数の増加が連動する構造が、開示された実績から読み取れます。",
        "basis": "MD&Aの経営成績等の状況の概要と販売実績に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "教育関連事業の単一セグメントで、本邦の外部顧客への売上高が連結売上高の90％を超えています。売上高の10％以上を占める主要な顧客はありません。2026年3月期の学部別の販売実績は小学部22,896百万円が最大で、中学部12,521百万円、高校部1,976百万円が続きます。",
        "basis": "セグメント情報等の関連情報と、MD&Aの販売実績に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
