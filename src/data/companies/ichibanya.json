  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「経営を通じ人々に感動を与え続け、地域・社会に必要とされる存在となること」をミッションに掲げ、「会社にかかわるすべての人々と幸福感を共有すること」を経営目的としています。2030年までの長期ビジョン「壱番屋長期ビジョン2030」では、目指す姿を「食のエンターテイメント企業」とし、第8次中期経営計画（2025年2月期～2027年2月期）では、国内CoCo壱番屋を成長エンジンとして1店舗当たりの売上高と店舗数の増加を目指すこと、海外ではアジア・北米を中心にFCシステムによる店舗網の拡大を進めること、国内子会社事業ではM&Aを活用して新たな業態の展開を進めることを掲げています。米の仕入価格の高騰や人件費・物流費の増加を受け、中期経営計画は見直されています。計画の目標数値は将来に関する事項のため、ここには転記していません。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "国内1,205店（2026年2月28日現在）の「カレーハウスCoCo壱番屋」の店舗網を有し、「世界で最も大きいカレーレストランのチェーン店」としてギネス世界記録に認定されています。社員の独立を支援するのれん分け制度「ブルームシステム」を基盤にFC展開を進めてきたほか、愛知・栃木・佐賀の自社工場を持ち、全工場でFSSC22000認証を取得しています。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【沿革】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当社グループは飲食事業の単一セグメントで、2026年2月期の販売実績の内訳はカレー事業が60,031百万円、新業態事業が5,487百万円です。製品及びサービスごとでは、直営店売上高が24,647百万円、FC向売上高が39,773百万円、その他が1,097百万円と、FC向が最大です。地域ごとでは日本が55,043百万円、海外が10,474百万円で、売上高の10％以上を占める特定の顧客はありません。",
        "basis": "事業部門別販売実績と、セグメント情報の関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-05-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
