  "businesses": [
    {
      "id": "restaurant-business",
      "name": "飲食事業",
      "description": "当社グループは、飲食事業及びこれらの付帯業務の単一セグメントです。カレー専門店「カレーハウスCoCo壱番屋」を中心とするカレー事業と、カレー以外の飲食業態を展開する新業態事業とで構成されます。2026年2月期の事業部門別販売実績は、カレー事業が60,031百万円、新業態事業が5,487百万円です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "curry-business",
          "name": "カレー事業",
          "description": "「カレーハウスCoCo壱番屋」を直営店とフランチャイズ加盟店（FC店）で国内外に展開する事業です。FC店に対しては店舗経営の指導を行うとともに、店舗で使用する食材、消耗品ならびに店舗設備等の商製品を販売し、その他、食品メーカー等への商標の貸し出しも行っています。2026年2月期の販売実績は60,031百万円です。2026年2月28日現在のCoCo壱番屋の国内店舗数は1,205店（直営店118店、FC店1,087店）です。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "new-format-business",
          "name": "新業態事業",
          "description": "あんかけスパゲッティ専門店「パスタ・デ・ココ」、「旭川成吉思汗 大黒屋」、「麺屋たけ井」、「博多もつ鍋前田屋」、「らーめん小僧」、夜パフェ専門店「パフェテリア パル」など、カレー以外の飲食業態を展開する事業です。地域で支持されている繁盛店の運営会社の株式取得を通じて業態を拡げています。2026年2月期の販売実績は5,487百万円です。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        }
      ]
    }
