  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "“SECURE THE FUTURE”をスローガンに、社会の安全・快適・エコロジーに貢献することを責務とし、世界トップレベルの「開発力」「提案力」「総合力」を強みに、経営基盤の強化を進めるとしています。振動に係る試験装置や計測装置の開発・製造・販売と試験受託、振動問題に対するコンサルティングを行い、さらなる事業成長と顧客満足の向上のためにグローバルな展開を行うとしています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "地域ごとの売上高は、日本9,905百万円に対し、欧州3,802百万円、アジア1,817百万円、米国1,933百万円、その他481百万円で、海外の売上高が全体の約45％を占めています。欧州・アジア・米国に販売と修理・保守を行う連結子会社を置き、タイとベトナムでは受託試験も行う体制が、開示された地域別の売上高に表れています。",
        "basis": "【関連情報】の地域ごとの売上高、【関係会社の状況】の海外子会社の事業内容、【事業の内容】の地域別の役割の記載に基づく",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "振動シミュレーションシステムとメジャリングシステムの開発・製造・販売に加え、受託試験と振動問題へのコンサルティングまでをグループで一貫して手がけています。当社製品の組立・加工を行う子会社と、世界各地で修理・保守を担う子会社を持ち、販売後の保守まで含めた体制があります。",
        "basis": "【事業の内容】の事業部門の記載、【関係会社の状況】の子会社の関係内容、【経営方針、経営環境及び対処すべき課題等】の経営戦略等の記載に基づく",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
