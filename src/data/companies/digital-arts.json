      "locator": "【事業の内容】",
      "children": [
        {
          "id": "web-security",
          "name": "Webセキュリティ",
          "description": "主力製品「i-FILTER」は、ホワイトリスト方式のデータベースを利用し、登録のない脅威URLへのアクセス遮断やカテゴリ別の閲覧制御を行うWebフィルタリング製品です。標的型攻撃対策やWebアクセス制御、アクセスログ監視等に用いられます。クラウド版「i-FILTER@Cloud」も提供しています。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "mail-security",
          "name": "メールセキュリティ",
          "description": "「m-FILTER」は、メールフィルタリング、メールアーカイブ、アンチスパム機能から成り、標的型攻撃メール対策、誤送信防止、スパムメール対策等に用いられます。安全な送信元を格納したホワイトリスト方式のデータベースで送信元の安全性を判定します。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "file-security",
          "name": "ファイル暗号化・データ保護",
          "description": "「FinalCode」は、電子ファイルを追跡・リモート制御できるパスワードレスの暗号化サービスで、閲覧者指定や権限変更、リモートでのファイル削除が可能です。「f-FILTER」は、重要情報を安全に転送するデータ保護・ファイル転送ソリューションです。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "authentication-network",
          "name": "認証・ネットワークセキュリティ",
          "description": "「a-FILTER」は、シングルサインオンや多要素認証、ID同期、ログ管理等を提供する統合認証プラットフォームです。「Z-FILTER」は、ID認証、端末制御、通信制御、クラウドサービス利用の可視化等を一つの管理画面で提供するネットワークセキュリティソリューションで、2025年11月に正式販売を開始しました。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "cloud-security",
          "name": "クラウドセキュリティ",
          "description": "「DigitalArts@Cloud」は、Web・メール・ファイルを網羅したクラウドセキュリティで、外部攻撃対策と内部からの漏洩対策の両方をカバーし、統合レポート画面で横断的に状況を表示できます。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
