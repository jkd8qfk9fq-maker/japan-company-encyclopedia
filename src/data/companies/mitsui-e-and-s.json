  "history": [
    {
      "year": 1917,
      "title": "三井物産の造船部として創業",
      "description": "三井物産株式会社の造船部として、宇野仮工場で創業しました。",
      "significance": "現在の三井E&Sにつながる、造船と機械づくりの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1926,
      "title": "デンマークのBurmeister & Wainと技術提携",
      "description": "デンマークのBurmeister & Wain社と、B&W型の舶用ディーゼル機関について技術提携しました。",
      "significance": "舶用エンジンを手がける事業の土台になった提携です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1937,
      "title": "三井物産から分離独立",
      "description": "三井物産から分離独立し、株式会社玉造船所を設立しました。",
      "significance": "独立した会社としての始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1942,
      "title": "三井造船株式会社に商号変更",
      "description": "商号を三井造船株式会社に変更しました。1949年には東京証券取引所と大阪証券取引所に株式を上場しています。",
      "significance": "長く使われた社名で、造船会社として知られるようになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "PACECO CORP.を設立",
      "description": "三井物産との共同出資で、米国のコンテナクレーン会社PACECO CORP.を設立しました。2009年に三井物産の保有株式を買い取り、共同出資を解消しています。",
      "significance": "物流システム事業の海外拠点の一つで、現在も連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "TGE Marine AGを子会社化",
      "description": "TGE Marine AGの株式を取得して連結子会社にしました。同社は2016年にMES Germany Beteiligungs GmbHと合併しています。",
      "significance": "二元燃料エンジン向けのガス関連の技術を取り込みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "持株会社体制に移行",
      "description": "持株会社体制に移行し、商号を株式会社三井E&Sホールディングスに変更しました。船舶・艦艇、機械・システム、エンジニアリングの3事業を、それぞれ新しい会社に引き継ぎました。",
      "significance": "事業ごとに会社を分け、その後の事業の入れ替えを進めやすくした転機です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "新造船事業から撤退",
      "description": "3月に千葉事業所での新造船事業を終了しました。10月には三井E&S造船の株式の49％を常石造船に譲渡し、艦艇事業を三菱重工業に譲渡して、玉野事業所での新造船事業も終了しました。",
      "significance": "創業以来の造船から離れ、機械とエンジニアリングを中心にする大きな方向転換です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "商号を株式会社三井E&Sに変更",
      "description": "4月に三井E&Sマシナリーなどを吸収合併し、商号を株式会社三井E&Sに変更しました。同じ月に、IHI原動機の舶用大型エンジン事業を承継した新会社を取得し、三井E&S DUとしています。",
      "significance": "ホールディングスの名を外して事業会社に戻り、舶用エンジン事業を強めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "三井E&S造船の全株式を譲渡",
      "description": "6月に、持分法適用関連会社だった三井E&S造船の全株式を常石造船に譲渡しました。譲渡後、同社は常石ソリューションズ東京ベイに商号を変えています。",
      "significance": "造船に関わる事業から、グループとして退く最終段階です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
