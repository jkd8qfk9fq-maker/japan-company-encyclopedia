  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン『BGI 2032』で、「Sauce」を極める世界ブランドへの成長を掲げ、国内戦略・海外戦略・VC（バリューチェーン）戦略の3テーマを基本戦略としています。国内では家庭用と業務用の両市場での拡大を、海外では輸出の拡大と上海の現地法人を中心とした現地化を、VC戦略では原料の安定供給と生産性の向上を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期の販売構成では家庭用ソースがなお中心である一方、業務用ソースと輸出、上海の現地法人が伸びており、会社が掲げる業務用と海外の拡大が数字の上でも進んだ期といえます。",
        "basis": "経営成績の分析における販売区分別の売上高と増減の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "生産の中心であるTATEBAYASHIクリエイションセンターに、生産だけでなく商品に関わる機能を集約し、生産性向上の取組みを続けています。グループには「イカリソース」など地域に根ざしたブランドを持つ子会社もあり、家庭用では人気キャラクターとのコラボキャンペーンなど店頭とSNSを連動させた販促も行っています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における生産体制と販促活動の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "1902年の創業、1905年のソース製造開始以来、ウスター、中濃、とんかつなどのレギュラーソースを主力とするソース専業の調味料メーカーとして事業を続けており、ソースメーカーとしての存在感の確立を掲げています。",
        "basis": "沿革における創業とソース製造開始の記載と、経営方針における位置付けの記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
