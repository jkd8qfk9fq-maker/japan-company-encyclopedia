  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2050年を見据えた「長期経営ビジョン2050『未来をつつむ』」とマテリアリティを基本に、2026年度から5か年の「中期経営計画2030」を2026年5月に策定しています。成熟事業領域と成長事業領域のそれぞれに事業戦略を定め、成熟事業領域から成長事業領域へ人材をシフトさせるため、人的資本の充実と変革、デジタル技術を駆使した業務の効率化、組織風土改革に取り組みます。あわせて、エンジニアリング・充填・物流事業、鋼板関連事業、機能材料関連事業などの成長分野に経営資源を投入し、国内の包装容器事業を中心に適正な売価転嫁と、不採算事業領域・拠点の再構築を進める方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "あらゆる素材を取り扱うグループのシーズをもとに開発した、多岐にわたる斬新で革新的な製品・サービスによって、競合他社との差別化を図るとしています。また、これまで培ってきた素材開発、成形加工、エンジニアリング等の技術・ノウハウを活用し、オープンイノベーションやIoT・DXを推進するとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業等のリスク】"
      }
    }
  },
