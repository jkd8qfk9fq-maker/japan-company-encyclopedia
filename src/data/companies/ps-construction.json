  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「中期経営計画2025」（2025年度～2027年度）に基づき、長期的なありたい姿として「PC技術を中核とした高度な技術力により、地球にやさしく安全で快適な社会の実現」を掲げています。土木事業では高速道路会社の大規模更新・修繕工事を中心に安定した受注の確保に努め、建築事業では選別受注と原価管理の徹底による安定した事業運営に取り組むとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "土木・建築の主力2事業が売上の大半を占め、とりわけ土木事業は高速道路の大規模更新・修繕という継続的な需要に支えられています。主要な顧客の上位2社はいずれも高速道路会社で、土木事業の受注基盤の中心であることが読み取れます。",
        "basis": "【セグメント情報】の報告セグメントごとの売上高・主要な顧客ごとの情報及び【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "プレストレスト・コンクリート（PC）技術を中核とした高度な技術力により、地球にやさしく安全で快適な社会を実現することを、長期的なありたい姿として掲げています。",
        "asOf": "2026-06-19",
        "sourceIds": [
