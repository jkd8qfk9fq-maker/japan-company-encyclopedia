  "history": [
    {
      "year": 1952,
      "title": "ピー・エス・コンクリート株式会社を設立",
      "description": "東日本重工業（現三菱重工業）が数年にわたり試作・研究を行ってきたプレストレスト・コンクリート製品の製造を本格的に企業化するため、同社の七尾造船所の諸施設と従業員を引き継ぎ、ピー・エス・コンクリート株式会社を設立しました。本社は東京都千代田区、七尾工場は石川県七尾市に置きました。",
      "significance": "プレストレスト・コンクリート（PC）製品の製造から始まった、当社の起源です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所市場第二部に上場",
      "description": "当社株式が東京証券取引所市場第二部に上場しました。",
      "significance": "株式上場の起点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1991,
      "title": "社名を株式会社ピー・エスに変更",
      "description": "社名をピー・エス・コンクリート株式会社から株式会社ピー・エスに変更しました。",
      "significance": "事業の広がりに合わせた社名変更です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "東京証券取引所市場第一部に上場",
      "description": "当社株式が東京証券取引所市場第一部に上場しました。",
      "significance": "第一部上場により、市場での位置づけが高まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "三菱建設と合併し、株式会社ピーエス三菱に社名変更",
      "description": "三菱建設株式会社と合併し、社名を株式会社ピー・エスから株式会社ピーエス三菱に変更しました。合併により、康和建設株式会社、菱建商事株式会社、菱建基礎株式会社などが関係会社となりました。",
      "significance": "合併により工事請負と関係会社の体制が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "PC製品事業を分社化し、ピー・エス・コンクリート株式会社を新設",
      "description": "北上、茨城、滋賀、兵庫、水島などの工場で営むPC（プレストレスト・コンクリート）製品の製造・販売等の事業を分社化し、新設したピー・エス・コンクリート株式会社に承継しました。",
      "significance": "PC製品の製造販売を担う中核子会社が生まれました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
