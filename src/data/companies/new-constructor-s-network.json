  "history": [
    {
      "year": 1996,
      "title": "セブン工業と日商岩井の合弁会社として設立",
      "description": "1995年の阪神・淡路大震災の悲劇を繰り返さないために、日本に安心・安全な木構造を普及させ、資産価値のある住宅を提供する仕組みをつくることを目的として、岐阜県美濃加茂市において、セブン工業株式会社と日商岩井株式会社（現双日株式会社）の合弁会社として設立されました。",
      "significance": "会社の起源です。設立の目的は現在の経営方針にも受け継がれています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1997,
      "title": "ＳＥ構法の大臣認定を取得し販売を開始",
      "description": "ＳＥ（Safety Engineering）構法木質フレームシステムについて、建築基準法第38条の建設大臣認定を取得し、ＳＥ構法の販売を開始しました。",
      "significance": "主力事業である木造耐震設計事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "ＳＥ住宅性能保証制度を開始",
      "description": "瑕疵保証制度に先駆けて「ＳＥ住宅性能保証制度」を開始しました。あわせて大阪支店を開設しました。",
      "significance": "構造に関する保証を提供する体制の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "株式会社MUJI HOUSEの前身会社へ資本参加",
      "description": "株式会社良品計画との合弁子会社「ムジネット株式会社」（現株式会社MUJI HOUSE）へ資本参加し、関係会社化しました。",
      "significance": "ハウスメーカー対応の展開につながる関係会社の設立です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "環境設計サービスを開始",
      "description": "環境設計サービス（現一次エネルギー消費量計算サービス）を開始しました。また、ＳＥ構法を含むシステムが国土交通省の2010年度「長期優良住宅先導事業」に採択されました。",
      "significance": "環境設計分野の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "ＳＥ住宅ローンサービス株式会社を設立",
      "description": "貸金業の代理業務及び金融商品の仲介業等を目的として、ＳＥ住宅ローンサービス株式会社を設立しました。",
      "significance": "登録施工店から紹介を受ける住宅ローンの取次を行う関係会社です。",
