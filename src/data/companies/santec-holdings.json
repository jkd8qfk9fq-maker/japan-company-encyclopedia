    "strategy": {
      "disclosed": {
        "text": "経営ビジョンに「Creating OPTOPIA（光の理想郷の創造）」を掲げ、基本方針を「Photonics Pioneer（光の先駆者）」と定めています。2027年3月期の基本課題として「コア技術（中核技術）とグループシナジーを通じた新たな顧客価値の創造」を目標に掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は基本方針を「高付加価値の新製品開発と市場牽引」とし、北米における光モニタ及び光通信用光測定器の販売好調により、売上高は前期比31.1%増の31,507百万円となりました。",
        "basis": "MD&Aの経営成績の概要、セグメント情報の外部顧客への売上高、関連情報の地域ごとの売上高と主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2008年に世界初の波長走査型OCT方式診断装置向け光源装置の供給を始めるなど、独自の光技術の開発実績があります。開発・製造を担う事業子会社と地域ごとの販売子会社を組み合わせ、北米・欧州・アジアで販売する体制を持っています。",
        "basis": "沿革、事業の内容、関係会社の状況に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客は眼科医療機器のAlcon, Inc.で、2026年3月期の売上高5,572百万円は連結売上高の17.7%を占めます。地域別では米国向けの売上高が10,387百万円と最も大きく、北米市場への依存度が高い構成です。",
        "basis": "関連情報の主要な顧客ごとの情報と地域ごとの売上高に基づきます。",
