      ],
      "locator": "【沿革】"
    },
    {
      "year": 1927,
      "title": "合資会社エヌチーエヌ製作所を設立",
      "description": "1927年3月に合資会社エヌチーエヌ製作所を設立し、1934年3月に株式会社に組織変更しました。1937年1月には東洋ベアリング製造株式会社に商号変更しています。",
      "significance": "会社としての形が整った時期です。のちの商号変更を経て、現在の社名につながります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "大阪証券取引所と東京証券取引所の市場第一部に上場",
      "description": "1949年5月に、大阪証券取引所市場第一部と東京証券取引所市場第一部に上場しました。",
      "significance": "現在は2022年4月に移行した東京証券取引所プライム市場に上場しています。",
