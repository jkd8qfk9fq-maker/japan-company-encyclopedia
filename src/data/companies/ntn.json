  "history": [
    {
      "year": 1918,
      "title": "三重県桑名町の西園鉄工所でボールベアリングの研究製作を開始",
      "description": "1918年3月に、三重県桑名郡桑名町の西園鉄工所でボールベアリング（玉軸受）の研究製作を始めました。",
      "significance": "今のNTNの出発点です。桑名市は現在も、桑名製作所や子会社の製作所がある地域です。",
