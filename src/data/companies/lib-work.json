  },
  "updatedAt": "2026-11-21",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションは「サステナブル＆テクノロジーで住まいにイノベーションを起こす」です。2026年8月に公表した新中期経営計画「Lib Earth Shot 2029」では「住宅産業を再発明し、地球に新しい住まいの供給システムを実装する」をビジョンに掲げ、住宅を一棟ずつ建てて販売する会社から、需要創出・設計・販売・建設・居住・再流通までを統合する「HOUSE TECH PLATFORM COMPANY」への進化を目指しています。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "デジタルマーケティングによる集客を軸に戸建住宅事業の販売チャネルを多角化する一方、プラン検索サービス「My Home Robo」とIPライセンスのライセンス数・加盟企業数の拡大を図り、ストック型収益を育てる戦略です。3Dプリンター建設事業の海外展開に向けた準備も進めています。",
        "basis": "セグメント情報（単一セグメント及び関連情報の製品及びサービスごとの情報・地域ごとの情報・主要な顧客ごとの情報）とMD&A（経営成績等の状況の概要、経営戦略の現状と見通し）に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "土地検索サイト「e土地net」と登録者数15万人を超えるYouTubeチャンネルによる自前の集客で、集客コストを抑えられる点が強みです。連結子会社の幸の国木材工業により木材の仕入れから加工、販売までを一貫して行う垂直統合の体制があり、生成AIを活用して10,000を超えるプランを検索できる「My Home Robo」のサービス基盤も持っています。",
        "basis": "事業の内容、セグメント情報（関連情報の製品及びサービスごとの情報・主要な顧客ごとの情報）とMD&A（経営成績等の状況の概要）に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "新設住宅着工戸数が3年連続で減少するなど住宅市場が弱含む環境の中で、熊本県を地盤に九州各県と千葉県・神奈川県に展示場や店舗を展開しています。売上高の中心は戸建住宅事業で、住宅プラットフォーム事業と3Dプリンター建設事業を成長領域と位置づけています。",
        "basis": "主要な設備の状況、セグメント情報（関連情報の地域ごとの情報）とMD&A（経営成績等の状況の概要）に基づきます。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
