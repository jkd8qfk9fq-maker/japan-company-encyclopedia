  "history": [
    {
      "year": 1910,
      "title": "大連で翠苔号を創立",
      "description": "1910年2月、旧満州の大連市で、測量製図器械と事務用品を扱う満鉄御用商として翠苔号を創立しました。",
      "significance": "現在の内田洋行につながる事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1946,
      "title": "計算尺部を設置し学校市場へ進出",
      "description": "1946年11月、学校での理数教育のために計算尺部を設置し、学校市場に進出しました。1948年には科学教材部も設置しています。",
      "significance": "教育分野を主な市場とする現在の事業の原点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "電子計算機事業に参入",
      "description": "1962年に電子計算機製造のウノケ電子工業に出資し、電子計算機事業部を設置して電子計算機「USAC」を発売しました。",
      "significance": "文具・教材の会社が、情報システム分野へ広がるきっかけになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "東京・大阪の証券取引所の市場第二部に上場",
      "description": "1964年1月に東京証券取引所と大阪証券取引所の市場第二部に上場し、1969年12月には市場第一部銘柄に指定されました。",
      "significance": "上場企業としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "富士通㈱と業務提携",
      "description": "1972年3月に富士通㈱と業務提携しました。",
      "significance": "ICT事業を広げる上での協力関係の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1981,
      "title": "コンピュータ教育システムTESを発表",
      "description": "1981年11月にTES（コンピュータ教育システム）を発表し、教育の情報化に着手しました。",
      "significance": "現在の教育ICT事業につながる取り組みです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "㈱ウチダシステムズに商号変更",
      "description": "2013年7月に㈱東京ウチダシステムを存続会社として連結子会社2社と非連結子会社1社を合併し、㈱ウチダシステムズに商号変更しました。2014年7月にも、㈱内田洋行ITソリューションズと㈱内田洋行ビジネスエキスパートで子会社同士の合併がありました。",
      "significance": "グループ内の会社を整理し、体制をまとめました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "プライム市場に移行、ウチダエスコ㈱を完全子会社化",
      "description": "2022年4月に東京証券取引所のプライム市場に移行しました。同年7月にはウチダエスコ㈱株式の公開買付けと株式併合で、同社を完全子会社にしました。",
      "significance": "ICT機器の納入設置・保守を担う会社を完全子会社にし、グループの体制を固めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "Open Assessment Technologies S.A.の全株式を取得",
      "description": "2023年5月に、ルクセンブルクに本社を持つOpen Assessment Technologies S.A.の全株式を取得しました。",
      "significance": "ソフトウェア開発・保守の担い手として、非連結子会社に位置づけられている会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
