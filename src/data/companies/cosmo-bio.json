  "businesses": [
    {
      "id": "life-science-trading",
      "name": "ライフサイエンス研究用試薬・機器等の販売事業",
      "description": "当社グループは単一セグメントで、ライフサイエンスに関する研究用試薬、機器及び受託サービスの仕入販売を主たる業務としています。国内外の仕入先から調達した商品と自社開発・製造品、そして創薬支援をはじめとする受託サービスを扱っています。連結子会社のビーエム機器株式会社はライフサイエンス研究用の機器類・消耗品の輸入商社であり、COSMO BIO USA,INC.は日本で製造した試薬・機器類の日本以外への販売と米国の新規仕入先の探索を行っています。2025年12月期の売上高は10,766百万円でした。",
      "customers": [
        "大学等の教育機関の研究者",
        "公的研究機関の研究者",
        "企業の研究者"
      ],
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "research-reagents",
          "name": "研究用試薬",
          "description": "抗体、抗原、ホルモンなどの生体内物質や培地添加剤などの汎用試薬と、遺伝子解析やタンパク質発現の研究で用いられるキット、生体内物質や環境汚染物質の検出定量キットなどの応用試薬です。品目別の販売実績では、2025年12月期は8,558百万円でした。",
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "instruments-and-consumables",
          "name": "機器・消耗品",
          "description": "遠心機、遺伝子導入装置、PCR装置、超音波破砕装置、細胞・遺伝子操作機器などの研究用機器・機材と、ピペットチップ、PCRチューブ、細胞培養シャーレ・プレート、手袋などの消耗品です。品目別の販売実績では、2025年12月期は2,207百万円でした。",
