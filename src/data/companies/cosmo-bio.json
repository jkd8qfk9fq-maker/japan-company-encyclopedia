    "strategy": {
      "disclosed": {
        "text": "ビジョンとして「ライフサイエンス（生命科学）の力で次代の価値を共創する」を掲げ、2026年度からの新たな中期経営計画では、ポートフォリオの転換、マーケティング機能の進化・強化、新規事業の本格展開、グローバル販売の強化、事業運営の最適化と強化の5つを重点戦略として推進するとしています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "世界各地の約500社の仕入先から1,000万品を超える商品を取り扱い、膨大な商品と多種多様な研究者のニーズをマッチングさせる機能を持ち、既存の商品で充足できないニーズには自社製品の開発・製造や受託サービスで応えています。",
        "basis": "【事業の内容】に、世界各地にある約500社の仕入先から1,000万品を超える商品を導入していること、専門知識を要する膨大な種類の商品と多種多様なエンドユーザーのニーズを効率的にマッチングさせることがビジネスの特徴であること、既存の商品で充足できないニーズには自ら製品を作りサービスを提供することが印字されています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
