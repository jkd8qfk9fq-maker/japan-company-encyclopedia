  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「世のため人のため」の下、フランチャイジーとして展開している業態についてはＦＣ本部との連携を深めながら店舗の拡大と個々の店舗力の強化を図り、自社で開発した業態のウエイトを上げていくことで経営基盤の安定化を図るとしています。リユース事業では福岡県内を中心にリアル店舗の出店を加速させ、フードサービス事業ではモスバーガー事業の出店を行える体制づくりを進め、地方創生事業では経営資源を将来性の高い事業へ重点的に投入するとしています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「ＨＡＲＤ ＯＦＦ」「ＯＦＦ ＨＯＵＳＥ」「ＢＯＯＫ ＯＦＦ」の３業態を複合したエコタウンタイプの店舗形態を持ち、リユース・飲食・地方創生の３事業を四国を地盤に展開している点が特徴です。",
        "basis": "【沿革】の今治デパートの沿革に、「ＢＯＯＫ ＯＦＦ」「ＨＡＲＤ ＯＦＦ」「ＯＦＦ ＨＯＵＳＥ」の３業態を複合したエコタウンタイプ１号店の開店が印字され、【事業の内容】に３事業の店舗数と出店地域（リユース事業は四国・九州・沖縄と海外、フードサービス事業と地方創生事業は四国）が印字されています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "リユース業界とフードサービス業界はいずれも成熟期にあり、その中でフランチャイジーとしての店舗展開と自社開発業態の組み合わせで事業を行う位置づけです。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、リユース業界、フードサービス業界ともに成熟期にあり、差別化戦略が決め手になると考えていることが印字されています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
