  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「ドラッグストア世界一へ向けて、日々革新し、向上しつづける経営」と、「お客様が健康で豊かな暮らしを実現するため、『普段の生活の拠点』を提供する」ことを掲げ、専門性と利便性を融合させたメガ・ドラッグストアを基本とした店舗展開を図る方針です。あわせて調剤薬局の併設を積極的に進め、「最も身近なヘルスケアセンター」の実現を目指しています。",
        "asOf": "2026-06-10",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "売場面積400坪以上のメガ・ドラッグストアを標準の店舗形態とし、主要生活道路沿いの立地、店舗前面の広い駐車場、段差のないバリアフリーのワンフロア店舗を特長としています。「ファーマシー・モア」のコンセプトのもと、医薬品にとどまらない幅広い商品構成で、短時間で買い物ができる利便性の高い生活密着型ストアを目指しています。",
        "asOf": "2026-06-10",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "店舗数は386店舗で、うち160店舗に調剤薬局を併設しています。地区別の売上高は関東地方が最も大きく、東北地方、甲信越・東海地方が続きます（2026年3月期）。北関東と東北を地盤とする地域密着型のドラッグストアチェーンです。",
        "basis": "MD&Aに店舗数（調剤併設数を含む）と地区別売上高が印字され、関東地方が最大で東北地方が続くことが読み取れる。",
        "asOf": "2026-06-10",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
