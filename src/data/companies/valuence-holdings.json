  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-25",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年8月期を最終年度とする3か年の中期経営計画「To the Next Stage: For 2030 Revival Vision」を進めています。構造改革を進めて収益性の向上を図るとともに、小売の拡大や海外での仕入拡大に投資を厳選し、仕入、オークション、小売、海外、領域拡大、サステナビリティの6つを基本戦略として、2030年に「Circular Design Company」の実現を目指しています。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社オークション「STAR BUYERS AUCTION」は、買い取った商品の販売先であると同時に、パートナーの商品の委託出品を受け付けるプラットフォームにもなっており、2025年8月期のオークション委託比率は38.3％まで高まりました。買取では国内139店舗、海外49店舗の店舗網とWEBマーケティングによる集客を組み合わせ、蓄積した買取・販売データを使う自社システムで査定の標準化を図っています。",
        "basis": "【事業の内容】の買取方法とオークションの仕組み、【経営方針、経営環境及び対処すべき課題等】の経営戦略、経営成績等の分析における店舗数とオークション委託比率の記載に基づく。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のリユース市場規模は2030年に4兆円へ到達すると見込まれています（リフォーム産業新聞社の推計）。販売面では、主要な顧客である日本マテリアル株式会社への販売高が全体の13.76％、株式会社ネットジャパンへの販売高が10.49％を占めています（2025年8月期）。売上高の海外比率は21.4％で、海外ではアジアや中東を中心に展開しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の市場規模の推計、セグメント情報等の関連情報における主要な顧客ごとの情報、経営成績等の分析における国内・海外売上高の記載に基づく。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
