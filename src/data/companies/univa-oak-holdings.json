  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月に策定した第2次中期経営計画に基づき、再生可能エネルギー、ビューティー＆ヘルスケア、トレーディング、成長支援の各事業を中核に据え、グループ事業を横方向に広げる拡大と、縦方向に深掘りする拡充を通じて、持続的な成長と強固な経営基盤の構築、価値共創の実現を進めます。経営指標の数値目標は掲げていますが、ここでは金額を示しません。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "漁網・紡績から投資へと業態を変えてきた長い歴史を持ち、エネルギー、美容・健康、卸売、デジタル、証券と異なる分野の子会社を束ねることで、グループ内の連携による相乗効果を狙う体制をとっています。再生可能エネルギーでは低圧から高圧や系統用蓄電池へ、トレーディングでは香港の卸売免許の取得を起点に中国市場へ、と各事業で領域の拡大が進んでいます。",
        "basis": "事業の内容におけるグループ構成と沿革の記述、セグメント情報における各事業の内容の記述に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "脱炭素社会への移行を事業機会と捉える再生可能エネルギー分野や、中国のEC市場向け卸売、キャッシュレス決済など、成長が見込まれる分野へ子会社の新設や株式取得で参入を広げている持株会社です。一方で、2019年3月期から8期連続で損失を計上しており、各事業の収益基盤の強化が課題となっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境と継続企業の前提に関する重要事象等の記述に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
