  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期経営ビジョン「NITTAN Challenge 10」を掲げ、2030年の目標として連結売上高1,000億円以上を目指しています。VISIONⅠ（ICE領域）で既存事業の付加価値を高め、VISIONⅡ（xEV・異業種領域）で電動化や異業種への新規事業化に挑戦するほか、2025-2029年度のグローバル中期経営方針では「基盤強化」「永続的発展」「企業風土改革」を柱としています。",
        "asOf": "2026-08-07",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、舶用部品事業の火災影響からの回復と北米拠点の収益正常化が進む一方、中国市場の冷え込みや歯車事業の減速という課題に直面しました。電動化の進展が地域で一様でない中、内燃機関部品の高付加価値化と電動化領域の開発を並行して進める構成です。",
        "basis": "経営方針の対処すべき課題、MD&Aの経営成績の概要、セグメント情報",
        "asOf": "2026-08-07",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "長年培ってきた鍛造・盛金・接合・加工の4つのコア技術を駆使し、中空エンジンバルブ等の高付加価値製品を展開しています。台湾・米国・中国・タイ・ポーランド・ベトナム・インドに生産拠点を持ち、現地で製造販売するグローバルな供給体制が基盤です。",
        "basis": "事業の内容、沿革、経営方針のコア技術に関する記載",
        "asOf": "2026-08-07",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメント別の外部顧客への売上高は、小型エンジンバルブ41,476百万円、舶用部品5,045百万円、その他3,324百万円、歯車1,830百万円で、小型エンジンバルブが売上の約8割を占めます。地域別では日本18,466百万円、アジア18,070百万円、北米9,352百万円、欧州5,761百万円、その他25百万円です。主要な顧客ごとの情報では、Honda Development and Manufacturing of America, LLC, Anna Engine Plantが最大の販売先として開示されています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報、MD&Aの経営成績の概要",
        "asOf": "2026-08-07",
