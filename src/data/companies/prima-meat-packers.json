  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「おいしさと感動で、食文化と社会に貢献」を目指す姿とし、中期経営計画では「持続可能な経営基盤の強化」「外部環境の変化に対応した収益基盤の構築」「成長投資とグローバル展開」を基本方針に位置づけています。営業力・開発力・商品力の強化により売上と利益の規模と質を高め、サステナビリティを重視した経営を推進するとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "肉豚の生産・肥育から食肉の処理・加工、加工食品の製造・販売までをグループ内で一貫して行う体制を持っている点が特徴です。コンビニエンスストア向けに調理パンや惣菜を製造・供給するベンダー事業も持ち、販売の経路が多様です。",
        "basis": "【事業の内容】と【関係会社の状況】の記述",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
