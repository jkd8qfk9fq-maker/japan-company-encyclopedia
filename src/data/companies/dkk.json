  "history": [
    {
      "year": 1938,
      "title": "国際電気通信株式会社が設立",
      "description": "1938年3月、それまで対外無線電信業務と無線電話業務を営んでいた日本無線電信株式会社と国際電話株式会社が特別法のもとに合併し、国際電気通信株式会社が設立されました。",
      "significance": "現在の電気興業の前身にあたる国策会社で、国の内外にわたる通信業務の拡充と運営を担いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1950,
      "title": "電気興業株式会社が設立",
      "description": "1950年6月、旧会社の施設財産の一部を継承し、通信施設の設計、製作、建設、改修並びに施設の賃貸を事業目的とする現在の電気興業株式会社が設立されました。",
      "significance": "現在の会社の創立です。通信施設の設計から製作、建設、改修、賃貸までを担う会社として出発しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1952,
      "title": "高周波事業を開始",
      "description": "1952年5月、東京都大田区に羽田工場を新設し、高周波応用機器の製造及び高周波熱処理受託加工業務を開始しました。愛知県刈谷市に依佐美出張所も開設しました。",
      "significance": "現在の高周波関連事業の起点です。電気通信と並ぶもう一つの柱がこの年に始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "川越工場を新設",
      "description": "1960年9月、埼玉県入間郡大井町（現・ふじみ野市）に川越工場を新設し、無線鉄塔、鉄構等の製造を開始しました。同工場内にアンテナ製作を業務とする子会社も設立しました。",
      "significance": "鉄塔や鉄構の製造体制が整い、電気通信関連事業の生産基盤が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1961,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1961年10月、株券を東京証券取引所市場第二部に上場しました。",
      "significance": "株式公開の節目です。これに先立つ1959年7月には店頭登録銘柄として公開していました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "鹿沼工場をアンテナ専用工場として新設",
      "description": "1972年2月、栃木県鹿沼市に鹿沼工場を新設し、川越事業所のアンテナ製造部門を移転して、マイクロ波アンテナをはじめとする各種アンテナの製造業務を開始しました。",
      "significance": "アンテナ製造を専用工場に集約した体制づくりです。現在の鹿沼工場につながります。",
