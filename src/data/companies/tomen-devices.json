  "history": [
    {
      "year": 1992,
      "title": "半導体の販売を目的に設立",
      "description": "1992年3月、サムスングループ製半導体の販売を目的に、旧トーメンエレクトロニクスの半導体部門の一部を分離・独立させる形で設立されました。旧トーメン、旧トーメンエレクトロニクス、旧三星電子ジャパンの3社が共同で出資しました。",
      "significance": "設立以来、サムスングループの半導体と電子部品を中心に扱う会社として続いています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "上海に現地法人を設立、株式を店頭登録",
      "description": "2002年6月、中国の上海に上海東棉半導体有限公司を設立しました。同じ月に、日本証券業協会（現JASDAQ（スタンダード））に株式を店頭登録しました。",
      "significance": "沿革に最初に出てくる海外の拠点です。2026年3月期は、海外セグメントが外部顧客への売上高の大半を占めています。",
