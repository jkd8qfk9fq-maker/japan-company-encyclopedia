  "history": [
    {
      "year": 1980,
      "title": "日鐵コンピュータシステムが設立される",
      "description": "東京都千代田区で、情報処理サービス業などを目的とする「日鐵コンピュータシステム」が、新日本製鐵の全額出資で設立されました。通称はニックスです。",
      "significance": "鉄鋼会社のシステム子会社として生まれたことが、今のグループの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "新日鉄情報通信システムに社名変更",
      "description": "新日本製鐵の「情報通信システム部門」の事業を譲り受け、社名を「新日鉄情報通信システム」（通称ENICOM）に変更しました。同じ年に、伊藤忠商事、日立製作所、日本アイ・ビー・エムとの合弁会社が設立されています。",
      "significance": "鉄鋼以外の企業ともつながる、システム会社としての幅が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "新日鉄ソリューションズが発足する",
      "description": "新日本製鐵のエレクトロニクス・情報通信事業部の事業を譲り受け、社名を「新日鉄ソリューションズ」に変更しました。このとき増資も行いました。",
      "significance": "システムの会社と、製品・サービスの事業部が一つになり、現在の会社の形ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "東京証券取引所第一部に上場",
      "description": "東京証券取引所第一部に上場し、増資を行いました。同じ年に、中国・上海に新日鉄軟件（上海）有限公司を設立しています。",
      "significance": "上場により資金調達の道が広がり、海外拠点づくりも始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "アジア・欧米へ拠点を広げる",
      "description": "2011年12月にシンガポールにNS Solutions Asia Pacific Pte. Ltd.を設立しました。その後、2013年にタイと英国、2014年にインドネシアにも子会社を設立しています。米国には2006年に駐在拠点を開設しています。",
      "significance": "国内の顧客を支えるだけでなく、海外でも事業を行う体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "新日鉄住金ソリューションズに社名変更",
      "description": "新日鐵住金の発足に合わせて、社名を「新日鉄住金ソリューションズ」に変更しました。",
      "significance": "親会社の再編に合わせて社名を変えた出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "新日鐵住金のシステム業務をすべて受託",
      "description": "アイエス情報システムの従業員の当社グループへの移籍を完了し、新日鐵住金のすべてのシステム業務を当社が受託する体制になりました。同じ年の1月には、ネットワークバリューコンポネンツを株式交換で完全子会社にしています。",
      "significance": "親会社のシステムを一手に担う立場が固まりました。",
      "sourceIds": [
        "yuho-2026"
