  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、国内事業の収益基盤強化、海外事業の成長拡大、新事業の創造、経営基盤の強化の4つを重点課題としています。国内では認知拡大や非住宅・リフォーム・リノベーション領域の集客拡大、ECプラットフォームの刷新に取り組み、海外では既進出国を中心にブランドの浸透を図るとしています。新事業では、ASOLIEネットワークの拡大に加え、「シェア」「知財」「人材」の3軸でシナジーが見込める領域でのM&Aを推進するとしています。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "売上高の約8割を占めるオリジナル商品（自社開発商品と国内で独占的に販売できる海外輸入商品）と、購入者の属性にかかわらず同一条件・同一価格とする「ワンプライス」の仕組みが特徴です。インターネット通信販売で流通プロセスを簡素化し、現物を確認できるショールームを主要都市と無人型で合計8拠点開設してECの弱みを補っています。",
        "basis": "事業の内容及び経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "住宅業界では建築コストの高水準や新設住宅着工戸数の減少傾向が続く一方、中古住宅やリフォーム市場は堅調に推移しているとされています。会社は、自社の事業規模に比べて業界の市場規模は巨大で、認知度はまだ低いことから収益獲得の余地は大きいと認識しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等及び経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
