  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "唯一無二の価値を創造し、驚きと感動のエンタテインメントで世界中を笑顔にすることを目標に掲げています。その実現のため、既存技術の向上と新技術の研究開発に重点を置き、海外での販売や開発に強みを持つ会社と連携する方針です。対処すべき課題として、受託開発では海外営業を含む新規クライアントの開拓と既存クライアントとの関係強化、遊技機分野では外注管理と品質管理の徹底を挙げ、完全子会社化した株式会社アクアプラスの保有するIPを活用した協業で、グループ全体のシナジー創出を図るとしています。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ゲーム開発で長年培ってきた技術力を強みに、独自に開発したリアルタイム演出技術「ALiS ZERO」を持ち、ゲームにとどまらずXR分野のリアルタイムライブ制作にも事業を広げています。2025年８月に完全子会社化した株式会社アクアプラスの保有するIPと企画力を取り込み、自社開発（パブリッシング）の領域も広げています。",
        "basis": "経営方針における「長年培ってきた技術力」の記述と、経営者による分析における「ALiS ZERO」を活用したリアルタイムライブ制作への参画、株式会社アクアプラスの完全子会社化による自社開発（パブリッシング）機能の獲得とIP保有の拡大の記述に基づく。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "デジタルコンテンツ事業の単一セグメントで、売上高の９割超は本邦の外部顧客向けです。2026年１月期の販売実績では、株式会社セガ向けが16.7％、アイレムソフトウェアエンジニアリング株式会社向けが8.7％を占めています。",
        "basis": "セグメント情報の地域ごとの情報（本邦の外部顧客への売上高が売上高の90％超）と、経営者による分析における主な相手先別の販売実績の印字に基づく。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
