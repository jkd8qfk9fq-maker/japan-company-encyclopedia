  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本理念として「より良い食品を通じて食文化の向上と健康増進に貢献する」を掲げ、安全・安心な商品の提供などを経営方針としています。中長期の重点施策として、資本効率化、新基盤の構築、自社販売力の強化、提携企業先との関係強化などの連携推進、市場需要に合わせた商品開発体制の構築、当社の強みへの集中と新たな強みの育成を進めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の4割強を占める食肉部門と食肉加工品部門がグループの中核です。輸入牛肉や輸入豚肉など輸入原材料への依存があるため、仕入先の多様化や規格変更による調達リスクの低減が、MD&Aで掲げる施策の中心になっています。",
        "basis": "セグメント情報（関連情報）の製品及びサービスごとの外部売上高、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（MD&A）の概要に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1986年からイタリア式生ハムの生産を続けるなど生ハムづくりの技術を持ち、1976年にはオランダの国際食肉ハムオリンピックで日本初の金メダルを受賞しています。マイスター直伝の技術で製造した製品の商品化や、FSSC・ISO活動を活用した品質安定の取組が商品面の強みです。",
        "basis": "沿革、研究開発活動、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "食肉及び食肉加工品の製造・販売を単一セグメントとする食品メーカーで、ハム・ソーセージ等の食肉加工品と食肉の取扱いが売上の大半を占めます。業務提携を結んだプリマハム向けのプライベート商品の開発にも取り組むなど、同業大手との連携も事業の一部になっています。",
        "basis": "セグメント情報（関連情報）の製品及びサービスごとの外部売上高、事業の内容、研究開発活動に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
