  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業以来の社是として「世界の人々に役立つ製品をつくる」「互恵互善の理念に徹し相互の利益をはかる」「平等の精神を基本とし働く者の楽園を築く」を掲げ、経営指針の柱に「Save energy. Save earth. Save life.」を置いています。2025年3月に公表した中期経営計画については、電動車市場の成長やレガシー半導体市場の回復の遅れを踏まえて目標を見直し、2028年1月期の売上高目標を2,630億円としています。",
        "asOf": "2026-04-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金型を自社で開発・生産し、その金型を使ってモーターコアやリードフレームを量産する一貫した体制を持っています。超精密加工技術を核に、アジア・米州・欧州に生産拠点を置くグローバルな供給体制を整えています。",
        "basis": "【事業の内容】・【経営方針、経営環境及び対処すべき課題等】の記載",
        "asOf": "2026-04-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年1月期の売上高の内訳は、電機部品が154,649百万円と全体の約7割を占め、電子部品が59,567百万円、金型・工作機械が4,112百万円です。顧客の所在地別では日本が109,582百万円と約半分を占めています。主要な顧客であるトヨタ自動車への売上高は69,421百万円で、全体の約3割です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-04-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
