  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年12月期からを第３創業期と位置づけ、通販DX事業、異業種へ展開するマーケティングDX事業、自社事業（新規事業）の３軸からなる成長戦略のもと、ブランド価値創造企業として成長を目指す方針です。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "800社以上のマーケティング支援で蓄積したデータとAIを搭載した「RESULTシリーズ」を持ち、新規顧客の獲得単価を保証するKPI保証型でサービスを提供できることが特徴です。",
        "basis": "事業の内容に、800社以上のマーケティング支援におけるノウハウや独自のデータ蓄積を基にしたDMPとAIを搭載した独自開発のソリューション「RESULTシリーズ」と、新規顧客の獲得単価を当社が保証する「KPI保証」が印字されていること",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "EC支援事業の単一セグメントで、2025年12月期のサービス別販売実績はECマーケティングテックが13,867百万円と全体の大半を占めています。主要な顧客は第一三共ヘルスケアダイレクト株式会社で、売上高3,004百万円、割合19.1％です。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の販売実績に、ECマーケティングテック13,867,864千円、広告マーケティング686,459千円、その他1,176,874千円が、主要な顧客ごとの情報に第一三共ヘルスケアダイレクト株式会社3,004,159千円（19.1％）が印字されていること",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
