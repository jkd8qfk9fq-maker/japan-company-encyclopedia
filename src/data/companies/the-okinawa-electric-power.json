  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月に公表した「おきでんグループ経営ビジョン」で、2050年に向けたありたい姿として「EMPOWER ＆ COLLABORATE：沖縄に活力を与え、ステークホルダーと未来を共創する」を掲げています。2030年までを「未来基盤創造フェーズ」と位置づけ、サプライチェーン毎の安定供給と収益力強化、AXによる業務オペレーション改革、低炭素化に向けた沖縄エリアのジャスト・トランジションの推進、沖縄の成長と連動した事業領域の展開を経営テーマとしています。2050年カーボンニュートラルに向けては、2040年度に2005年度比48％削減を中期目標とするトランジション計画を公表しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "沖縄県を供給区域として発電から供給までを担い、グループには電力設備の工事や保守点検、電気機械設備の運転、情報通信、再生可能エネルギー、ガス供給などを担う会社がそろって、電気事業を補完・支援する体制が整っていることが特徴です。",
        "basis": "【事業の内容】のグループ構成と【関係会社の状況】の各社の役割",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
