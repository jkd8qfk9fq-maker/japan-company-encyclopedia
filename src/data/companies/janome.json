  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンは「つくる歓びを伝える会社」で、2026年3月期から2028年3月期までの中期経営計画「Move! 2027」では「これからの100年に向けた持続可能な成長」を基本方針としています。家庭用機器事業ではブランドアイデンティティの確立・強化と、製品投入によるシェア拡大を掲げ、産業機器事業では重要市場への注力と高付加価値製品の販売強化、ＩＴ関連事業では他事業との連携強化と既存事業の収益性維持を掲げています。中期経営計画には最終年度の業績目標も定められていますが、本文の規則のため数値はここには書きません。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "中期経営計画の初年度にあたる2026年3月期は、売上高が前期を上回りました。家庭用機器事業では北米で中・高級機種の販売が堅調だった一方、アジア市場では前期好調の反動減がありました。産業機器事業では中国を中心としたアジア市場の設備投資需要を背景に受注が堅調で、インドで事業を開始した販売子会社でも受注が増えています。",
        "basis": "セグメント情報の外部顧客への売上高と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の事業別の説明に基づきます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は、自社の強みは創業以来培ってきた「信用」であり、それを支えているのは製品の「品質」への評価だとしています。国産初のミシンメーカーとして技術の改良を重ね、ミシンで培った技術を応用・発展させて産業機器分野の高機能・高性能の商品開発も実現してきたとしています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "家庭用機器は当社と台湾・タイの生産子会社が開発・製造し、北米・欧州・オーストラリアなどの販売子会社が販売する体制で、生産と販売の両方に海外拠点を持っています。産業機器事業はミシンで培った技術の応用として位置づけられ、家庭用機器に次ぐ第二の柱とされています。",
        "basis": "【事業の内容】の事業ごとの開発・製造・販売の担い手の印字と、【経営方針、経営環境及び対処すべき課題等】の生産管理・研究開発の説明に基づきます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは家庭用機器事業、産業機器事業、ＩＴ関連事業の3つで、2026年3月期の外部顧客への売上高は家庭用機器事業29,787百万円、産業機器事業6,155百万円、ＩＴ関連事業2,896百万円、その他128百万円です。売上高の10％以上を占める主要な顧客はないとされています。家庭用機器の地域別では、北米と欧州向けが大きな部分を占めています。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
