  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「PROGRESS 2026」の方針をベースに、100周年（2041年）に向けた成長基盤の確立を目指し、エネルギー新時代に即した「グローバルな総合配線システムメーカー」の実現に向けて、成長戦略、生産戦略、経営基盤強化と資本コストを意識した経営を着実に実行し、事業構造の変革を図るとしています。成長戦略では部門ごとの重点成長戦略と脱炭素社会の実現に貢献する取り組みの強化、生産戦略では国内生産拠点の強化とグローバル生産拠点戦略、「グローバル同一品質」の構築を掲げています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電線で培った生産技術力、民生機器用・産業機械用・車載用ワイヤーハーネスで培ったグローバルでの生産・販売体制、太陽光発電配線ユニットや監視システムなどの新エネルギー関連製品で培った製品開発力、ハーネス加工用機械・部品で培った技術開発力を併せ持つ点が、読み取れる強みです。日本、中国、アメリカなど8ヶ国21社のグローバルネットワークの強化拡充を進めるとしています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に印字された生産技術力・生産販売体制・製品開発力・技術開発力とグローバルネットワークの記述、【事業の内容】のグループ構成と製造販売の役割分担、セグメント情報の地域区分に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上は日本が中心で、2025年12月期の外部顧客への売上高は日本24,000百万円、欧米11,905百万円、アジア（日本を除く）8,536百万円でした。部門別ではワイヤーハーネス部門の売上高30,368百万円が最も大きく、次いでハーネス加工用機械・部品部門7,917百万円、電線部門3,245百万円、新エネルギー部門2,910百万円です。売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の主要な顧客ごとの情報、MD&Aの部門別売上高に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
