  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第８次中期経営計画（2025年度～2027年度）では「TAFCO Reform ＆ Advance」を掲げ、利益率の改善・安定を目的としたReform戦略と、成長投資を適切に組み合わせて管理・実行していくことを目的としたAdvance戦略を柱に取り組んでいます。経営理念である「顧客第一」「合理追求」「人倫遵守」を実践し、売上高と利益の成長を志向して経営資源の拡大を目指します。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンクリートパイルの製造・販売から付随工事の請負までをグループで担い、主力商圏の関東及び静岡県に生産拠点と営業体制を持つことが強みです。",
        "basis": "事業の内容に、パイルの製造・販売と諸工事の請負を当社が行い、連結子会社が出荷・構内作業と原材料の仕入れを担う分担が印字され、経営成績の分析に主力商圏が関東及び静岡県であることが印字されているため。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の内訳では、コンクリートパイルを中核とする基礎事業が全体の98％超を占め、不動産賃貸事業は安定的な収益を担う位置づけにあります。",
        "basis": "セグメント情報に、2026年2月期の外部顧客への売上高として基礎事業11,492百万円、不動産賃貸事業198百万円が印字され、経営成績の分析に不動産賃貸事業が安定した業績で推移した旨が印字されているため。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
