  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度から３カ年の中期経営計画をスタートさせ、『恒久的な企業価値の創出を目指して』を基本テーマに、課題の見える化を最優先として、次世代に向けた利益創出の仕組みづくりと人材育成に取り組んでいます。最終年度の2026年度は「利益の可視化に向けた構造改革の実践」を基本テーマとしています。また、中長期的な事業戦略「企業価値向上への事業戦略 Over3,000」では、2030年を見据えて売上高3,000億円超の達成を目指し、「さらなる成長戦略」「資本効率の向上」「ポートフォリオの再構築」「さらなる株主還元の充実」「非事業資産の整理」を図るとしています。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製造から販売、保守点検・修理までをグループで一貫して担える体制が強みです。国内には小山・掛川・姫路などの自社工場と全国の支店網があり、保守・修理は連結子会社の文化シヤッターサービス株式会社が担っています（同社の売上高は36,961百万円で、連結売上高の10％を超えています）。海外でもベトナムに生産拠点を持ち、オーストラリアとニュージーランドではガレージドアの製造・販売会社を傘下に置いています。",
        "basis": "【主要な設備の状況】に国内工場と全国の支店網、【関係会社の状況】に文化シヤッターサービス株式会社の売上高36,961百万円と連結売上高に占める割合が10％を超える旨、海外子会社の事業内容が印字されている。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【関係会社の状況】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高の内訳は、シャッター関連製品事業が94,193百万円、建材関連製品事業が93,511百万円と拮抗し、サービス事業が32,596百万円、リフォーム事業が6,940百万円、その他が9,040百万円です。地域別の売上高は日本が209,997百万円と大半を占め、オーストラリアが22,022百万円、その他が4,261百万円です。",
        "basis": "【セグメント情報】の外部顧客への売上高と【関連情報】の地域ごとの売上高（2026年3月期）が印字されている。",
        "asOf": "2026-06-15",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【セグメント情報】"
      }
    }
  },
