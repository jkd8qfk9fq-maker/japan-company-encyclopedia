  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として、医薬品開発のあらゆる場面で常にプロフェッショナルとしての質を提供し、ステークホルダーである製薬会社、医療機関、患者ならびに株主、従業員の幸せを追求することを掲げています。その実現のため、アンメット・メディカル・ニーズが高く開発難易度の高いがん、中枢神経系、免疫疾患などの特定疾患領域に注力し、2028年3月期を最終年度とする中期経営計画のもと、日本を含むアジア、米国及び欧州で国際共同治験を実施できる体制を整え、海外拠点を拡充することで国内同業他社との差別化を図り、日本発のグローバルCROを目指しています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の地域構成は日本が約4割で、残りはアメリカ、スイス、その他地域の海外顧客が占めます。当期は米国と欧州の大型案件の終了と新規案件の開始遅延で売上高が前期比17.0％減少しており、海外の大型案件の開始時期が業績を左右する構成です。",
        "basis": "セグメント情報（地域ごとの情報、主要な顧客ごとの情報）とMD&A（経営成績等の状況の概要）に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "大手製薬会社と対等の立場で医薬品開発を実行・支援できる知識・技術・経験を有し、がん・中枢神経系など開発難易度の高い疾患領域や新たな創薬モダリティにも対応できることを掲げています。医師・アカデミアが主導する臨床研究や、これから日本や海外に進出しようとする新興バイオテック企業にはきめ細かいサービスを提供し、大口顧客を抱えリソースに制限のある大手グローバルCROとの差別化を図っています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "米国、欧州の10か国、韓国、中国、台湾、シンガポール、オーストラリアに100％出資の連結子会社を持ち、臨床試験計画の段階からすべてのフェーズまで、臨床試験に関わる様々なサービスをグローバルにワンストップで提供できる体制があります。",
        "basis": "関係会社の状況と事業の内容に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "日本発のグローバルCROとして、2008年の米国進出以来、欧州・アジア・オーストラリアに拠点を広げてきました。主要な顧客にはPFIZER, INC.など海外の企業が含まれ、売上高の約6割は海外の顧客から得ています。",
        "basis": "沿革とセグメント情報（地域ごとの情報、主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
