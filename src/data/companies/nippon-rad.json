  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年4月から2027年3月までの3か年の中期経営計画で、「“人”で稼ぐから“アセット”で稼ぐ企業への構造変換」を基本方針に掲げ、ＳＩ・ＩｏＴ分野で培ったノウハウをプロダクト化してデータハンドラー・アセンブラーへ成長遷移していく計画です。自社プラットフォーム「Ｄｅｒｅｖａ」をコアサービスと位置づけ、選択と集中による収益力強化、ノウハウのアセットへの昇華、Ｍ＆Ａを含む将来成長に向けた戦略的投資の3つを柱としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは「人材育成力」「ＳＷ／ＨＷを繋ぐコア技術」「ＥＲＰ／ＣＰＭ／ＩｏＴでの幅広い経験」の3点で、ソフトウェアの受託開発とハードウェアを起点としたシステム製品の双方を手がけられることが特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、当社グループの強みとして「人材育成力」「ＳＷ／ＨＷを繋ぐコア技術」「ＥＲＰ／ＣＰＭ／ＩｏＴでの幅広い経験」の3点が印字されているため。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "1971年の創業以来、半世紀以上にわたり受託開発などのＳＩ事業を続けてきた会社です。製造業向けＤＸの分野では、自社ＩＰである「Ｄｅｒｅｖａ」プラットフォームやエッジプロダクト群が評価され、継続的な利用や追加導入につながる関係を築いています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】にＳＩ領域で半世紀以上培ってきたソフトウェアエンジニア育成ノウハウの印字があり、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のＩｏＴインテグレーション事業の項に、「Ｄｅｒｅｖａ」プラットフォームおよびエッジプロダクト群の競争力により継続的な利用や追加導入につながる好循環が形成されている旨が印字されているため。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
