  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「健康づくりで世のため人のために尽くす」のもと、『健康』をキーワードに事業展開を行っています。スポーツクラブ事業では既存店の収益力回復に経営資源を集中し、ホテル事業では駅前や主要インターチェンジを重点地区として開発を進め、不動産事業では名古屋地区を重点地域に賃貸マンションの新規開発を進める方針です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度はスポーツクラブ4店舗を閉店し、賃貸マンション1棟を売却する一方、ホテル2店舗を新規開業し、テナントビル「ＴＯＳＨＯ　ＢＬＤＧ豊田」の営業を開始しました。成長するホテル事業への資源配分と、既存施設の収益力回復を同時に進める構成になっています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "建設業を発祥母体とし、費用対効果の高い建築ノウハウを持つことが特徴です。スポーツクラブはジュニア用スイミングスクールを併設しない大人専用の広い施設とし、エクササイズを月会費のみで利用できる料金体系や23時までの営業で差別化を図っています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "スポーツクラブ事業は全国37都道府県に95店舗、ホテル事業は38店舗を展開し、売上高はスポーツクラブ事業12,562百万円とホテル事業12,274百万円が拮抗しています。不動産事業は愛知県内に賃貸マンション51棟2,040室を所有し、3事業が近接した地域で施設を開発・運営する構成です。",
        "basis": "セグメント情報（外部顧客への売上高）、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-24",
