  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「健康とおいしさ（健康民主主義、おいしさ民主主義）」を掲げ、長期ビジョン達成のため「マネジメントイノベーション」「戦略イノベーション」「マーチャンダイジングイノベーション」「業務イノベーション」の4つのイノベーションに取り組んでいます。香川県を中心とする北四国の地場スーパーマーケットとして商圏シェアを高め、「健康とおいしさ」を追求した「マルヨシクオリティ」の維持向上を目指しています。店長による店舗経営管理体制の導入や、四国戦略として店舗の改装を進めています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期は四国戦略の第二号店として椿店（愛媛県松山市）を2025年7月に改装オープンし、第一号店の三加茂店（徳島県三好郡）は当初の計画を上回って推移したとされています。また、株式会社イズミとのシステム、仕入、物流の統合が2024年6月から本格稼働し、店舗運営と仕入・物流を一体で進める体制が取られています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略と、MD&Aの概要に記載された四国戦略の店舗改装および株式会社イズミとの統合の取り組みに基づきます。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "食品製造を担う株式会社フレッシュデポと物流センター運営を担う株式会社レックスを連結子会社に持ち、製造と物流をグループ内で担う体制があります。生鮮商品では「健康とおいしさ」をキーワードとした差別化や「味Ｇメン」による味と品質のチェックが行われ、自社ブランド「オリジナルＢＯＸ」を始めとする差別化商品の開発も進められています。",
        "basis": "【事業の内容】と【関係会社の状況】のグループ構成、【経営方針、経営環境及び対処すべき課題等】の商品施策とMD&Aの概要に基づきます。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは小売事業のみで、その他は重要性が乏しいため記載が省略されています。2026年2月期の販売実績は小売事業が40,655百万円、その他（レストラン）が99百万円でした。単一の製品・サービスの外部顧客への売上高が連結売上高の90％を超え、本邦以外の外部顧客への売上高はなく、売上高の10％以上を占める相手先もありません。スーパーマーケット店舗は34店舗です。",
        "basis": "セグメント情報と関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）、MD&Aの販売実績、【主要な設備の状況】の店舗数に基づきます。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
