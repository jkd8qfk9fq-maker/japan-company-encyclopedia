  "history": [
    {
      "year": 1935,
      "title": "東京プレス工業を設立",
      "description": "東京都江東区大島町に東京プレス工業株式会社を設立し、プレス加工を中心に製罐・鈑金も手がけました。",
      "significance": "現在のプレス関連製品事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所第二部に上場",
      "description": "神奈川県相模原市に東邦興産を設立し、同じ年に東京証券取引所市場第二部へ株式を上場しました。",
      "significance": "東邦興産は現在も輸送事業を担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1968,
      "title": "冷凍・冷蔵車業界へ進出",
      "description": "冷凍・冷蔵車の業界に進出しました。1970年には空調機器の業界にも進出しました。",
      "significance": "自動車部品以外に事業を広げ、のちの定温物流関連事業につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "東プレ株式会社に商号変更",
      "description": "東京プレス工業から東プレ株式会社へ商号を変更しました。",
      "significance": "現在の社名になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1991,
      "title": "トプレックが冷凍・冷蔵車の販売を担当",
      "description": "ティー・シー・コーポレイションをトプレックに商号変更し、冷凍・冷蔵車と冷凍・冷蔵庫の販売の営業を譲渡しました。",
      "significance": "製造は東プレ、販売はトプレックという現在の分担ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "米国にTopre Americaを設立",
      "description": "米国アラバマ州にTopre America Corporationを設立しました。",
      "significance": "北米での自動車用プレス部品の生産の拠点になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "中国・タイに海外拠点を設立",
      "description": "中国の佛山にプレス部品の会社を、タイにTOPRE (THAILAND)を設立しました。",
      "significance": "アジアでの海外生産が広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "襄陽の会社とメキシコの会社を設立",
      "description": "中国の襄陽に会社を、メキシコにTopre Autoparts Mexicoを設立しました。",
      "significance": "北米と中国で生産体制が増えました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "東プレ東海を連結子会社化",
      "description": "三重県員弁郡東員町の自動車機器工場を譲り受け、東プレ東海を連結子会社にしました。",
      "significance": "国内のプレス部品の生産能力が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "三池工業を連結子会社化",
      "description": "神奈川県横浜市の三池工業と資本提携を行い、連結子会社にしました。",
      "significance": "プレス関連製品事業を担う子会社が増えました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
