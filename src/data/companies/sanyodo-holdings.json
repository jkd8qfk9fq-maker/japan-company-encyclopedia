  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "新本と古本を併売するハイブリッド型書店を核として、顧客のニーズの変化に合わせて様々な販売部門やサービス部門を積極的に導入するとともに、スマート無人営業やスマートフォンを活用したサービスを提供する「スマート・ブックバラエティストア」業態の展開を進め、成長部門の拡大や新部門の導入を通じて業態の進化を図ることを、中長期的な経営戦略としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "縮小が続く書籍や映像・音楽ソフトの市場への依存を下げ、トレカや中古ホビーなどの成長部門と無人営業による効率化で収益構造を組み替える戦略です。",
        "basis": "セグメント情報（単一セグメントの記載）、MD&A（経営成績等の状況の概要と部門別売上高）及び経営方針、経営環境及び対処すべき課題等に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "新本と古本を併売するハイブリッド型書店に、トレカ館や駿河屋などの専門フォーマットを組み合わせる複合店舗の運営と、顔認証入店によるスマート無人営業を32店舗に導入した省人化の仕組みが強みです。",
        "basis": "事業の内容、MD&A（経営成績等の状況の概要）及び沿革に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "書店チェーンを中心とする小売サービス事業者で、売上高の約半分を書店部門が占め、店舗は東海北陸に58店舗と地域に集中しています。",
        "basis": "MD&A（部門別・地域別の販売実績）とセグメント情報に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
