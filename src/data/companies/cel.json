    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン「ビジョン2030」で、企業価値の極大化と物心両面の「しあわせ」の実現をありたい姿とし、アパート専門メーカーとしてニッチトップの実現と、本業の付加価値を高めるための本業および本業周辺ビジネスの多面的経営の展開を目指すとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンサルティングから設計、自社工場での構造部材の製造、自社施工、入居者の募集や建物の管理までをグループ内で一貫して担う体制と、平面に高さを加えた立体的な空間設計による差別化した商品の提供が強みです。主要構造材には日本製鉄株式会社と共同開発した独自工法「セレZ」を用いています。",
        "basis": "【事業の内容】における事業の内容と、【経営方針、経営環境及び対処すべき課題等】における経営戦略等の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業エリアを東京圏の1都3県に絞り込み、25歳から35歳を中心とした若者の単身者向けアパートに特化しています。賃貸経営事業は最大のセグメントで、2026年2月期の外部顧客への売上高は10,522百万円、2026年2月28日現在の管理戸数は12,612戸です。",
        "basis": "セグメント情報における外部顧客への売上高と、経営成績の分析における管理戸数の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
