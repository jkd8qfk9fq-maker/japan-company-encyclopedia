  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様第一主義」を基本理念とし、包装の機能を高め続けることで人類の豊かな生活に貢献することを使命としています。営業面では、「掴めるくん®」「吸湿くん®」などの機能包材や環境対応品「MARUTOエコプロダクツ」の提案を進め、原材料価格の高止まりに対しては価格改定に継続的に取り組み、生産面ではコスト管理や生産プロセスの最適化と、協力会社と連携した安定供給体制の強化に努めるとしています。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "単体フィルムの製造から印刷、製袋までを自社工場で一貫して行う生産体制を持ち、「掴めるくん®」「吸湿くん®」「楽チンさん®」など、使い勝手の改善や乾燥剤不要といった機能で差別化したブランド包材をそろえている点が特徴です。",
        "basis": "事業の内容における製造販売の記載、沿革における和白工場での一貫生産の記載、経営成績の分析における機能包材の製品名と提案活動の記載に基づきます。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "包装資材事業の単一セグメントで、2026年2月期の売上高18,775百万円のうち複合フィルムが13,451百万円と約7割を占めます。地域別では日本が16,048百万円、中国が1,444百万円、その他が1,282百万円で、売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報等の関連情報における地域ごとの情報と主要な顧客ごとの情報の記載、経営成績の分析における品目別の販売実績の記載に基づきます。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
