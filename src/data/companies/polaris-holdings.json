  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年5月13日に策定した「中期経営計画2030」では、ホテル運営プラットフォームのさらなる拡大を軸に、新規出店を成長の主軸とし、リブランド案件の獲得やホテル投資、M&Aを組み合わせた成長戦略を推進するとしています。スポンサーであるスターアジアグループとの連携を活用し、運営受託を中心としたアセットライト型の事業モデルを基盤としながら、既存ホテルの収益性向上と運営ホテル数・客室数の拡大を目指す方針です。ブランド面では「KOKO HOTELS」を軸としつつ、ホテル形態の多様化に対応したブランド展開を進めるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は、2024年12月の株式会社ミナシアとの経営統合による事業規模の拡大に加え、新たに8ホテルの運営を開始し、「KOKO HOTELS」へのブランド統合に向けたリブランドも進めました。2026年5月13日に策定した新中期経営計画の達成に向け、ホテル運営プラットフォームのさらなる拡大を推進するとしています。",
        "basis": "MD&Aにおける経営成績等の状況の概要の記載、経営方針における中期経営計画2030の概要と成長戦略の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "スポンサーであるスターアジアグループとの連携を活用できることが強みです。2018年10月25日にはStar Asia Management LLCとの間で、スターアジアグループ各企業との人的・物的リソースの有効活用による両社の企業価値の向上に向けた取組みに係る業務提携契約を締結しています。日本とフィリピンの両地域でホテルを運営し、2026年3月期の地域別売上高は日本が45,455百万円、フィリピン共和国が3,014百万円です。",
        "basis": "重要な契約等における業務提携契約の記載、経営方針における経営方針の記載、セグメント情報における地域ごとの情報の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ホテル運営事業が連結売上高のほぼ全てを占め、2026年3月期の外部顧客への売上高はホテル運営事業が48,434百万円、ホテル投資事業が34百万円です。国内ホテル事業では客室稼働率90.2％、平均客室単価（ADR）12,954円、RevPAR11,682円を記録し、インバウンド比率は51.7％でした。訪日外国人旅行者数の増加や国内旅行需要の回復を背景に宿泊需要は堅調に推移しているとされています。",
        "basis": "セグメント情報における報告セグメントごとの売上高と地域ごとの情報の記載、MD&Aにおける経営成績等の状況の概要と経営者の視点による分析の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
