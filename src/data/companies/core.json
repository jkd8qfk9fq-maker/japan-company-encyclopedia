  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年3月期から2029年3月期の「第15次コアグループ中期経営計画」を新たに策定し、新たな旗印として「ソリューションプラットフォーマー」を掲げています。基本方針は、ソリューションを起点としたストックビジネスの展開、事業規模の拡大を意識した生産性の向上、企業活動にAIを活用するAIファーストの3つです。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "メーカー系列に属さない独立系のITサービス会社として、IoT（AI）やGNSSなどの特化技術を持ち、最大の産業技術ソリューション事業では、IT点呼システムや製造業向けソリューション、半導体関連装置や音響機器などの開発案件が伸長しました。",
        "basis": "【セグメント情報】の事業別売上高と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における事業別の業績の記載、【経営方針、経営環境及び対処すべき課題等】における独立系としての位置付けの記載に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "3つの事業のうち産業技術ソリューション事業が売上高の過半を占めます。公共・エネルギー分野を中心とする未来社会ソリューション事業が伸長する一方、顧客業務インテグレーション事業は、金融分野と流通分野の開発案件の縮小により減収となりました。",
        "basis": "【セグメント情報】の事業別売上高と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における事業別の業績の記載に基づきます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
