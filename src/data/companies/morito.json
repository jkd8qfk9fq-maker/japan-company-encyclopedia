  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年1月にアップデートした第8次中期経営計画に基づき、「小さなパーツで世界を変え続ける」をキーワードに、グローバルニッチトップ企業として存在価値を示すことを掲げています。収益力の向上では、付加価値のある新商品の開発や設備投資、高品質商品のグローバル調達と現地生産・現地調達を含めた販売網の整備、BtoC事業領域の拡大とECプラットフォーム事業の活用に取り組むとしています。",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当社グループは、日本・アジア・欧米の3地域に現地法人を置き、服飾資材から自動車内装部品までを製造・販売する体制を持っています。廃漁網を100％使用した糸「MURON®」の本格販売や、縫製工場のはぎれなどを活用した混抄紙「ASUKAMI®」の開発・販売など、サステナブルな商品づくりにも取り組んでいます。",
        "basis": "【事業の内容】及び【関係会社の状況】のグループ構成と、MD&Aに印字されたRideeco®の取組（MURON®・ASUKAMI®）に基づきます。",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当社グループの売上高は日本が中心で、2025年11月期の地域別売上高は日本41,310百万円、アジア8,280百万円、欧米7,275百万円です。分野別ではアパレル関連が最も大きく、顧客との契約から生じる収益はアパレル関連32,337百万円、プロダクト関連17,701百万円、輸送関連6,457百万円でした。売上高の10%以上を占める主要な顧客はありません。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高と収益の分解情報）及び関連情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-02-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
