  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「『驚き』と『感動』を世界に届ける新しいエンターテイメントの創造」です。多彩なエンターテイメントコンテンツをあらゆる事業領域において様々なデバイス向けに展開する「マルチコンテンツ・マルチユース・マルチデバイス」戦略を基軸とし、強力なIPの確立に向けたブランディング戦略・アライアンス戦略・グローバル戦略を推進しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "対処すべき課題として、自社コンテンツ（IP）の新規創出と育成を最重要課題とし、技術開発力の向上とグローバル展開の推進を挙げています。グローバル展開では、米国、英国、シンガポールにおける子会社と中国・上海の駐在拠点を軸に事業展開を進める方針です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境と対処すべき課題の記載と【関係会社の状況】の連結子会社一覧から読みました。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ゲーム、アミューズメント、音楽映像という幅広い事業領域を持ち、生み出したコンテンツを事業領域の中で最適化して広く展開できる体制が示されています。デジタルコンテンツ事業では蓄積された高度な開発技術を背景に業界他社のゲームコンテンツの開発受託も行い、アミューズメント事業では強力なIPとのアライアンスを推進しています。",
        "basis": "【事業の内容】と【セグメント情報】の事業説明、【経営方針、経営環境及び対処すべき課題等】の対処すべき課題の記載から読みました。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
