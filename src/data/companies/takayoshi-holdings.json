  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンとして「安心と笑顔が広がる世界をつくる」を掲げ、「わくわく広場」の運営を通じて、他のお店では買うことのできない商品を取りそろえ、お客様が目指して来店するデスティネーションストアの構築を生産者と共に目指すとしています。プラットフォーム成長の鍵は「場」である店舗数と「ユーザー」である登録生産者数の拡大であると認識し、地域ドミナントの深化と未出店エリアへの拡大による出店、生産者が出品しやすい仕組みづくりによる登録生産者数の拡大を通じて、流通総額の拡大を図る方針です。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年９月期は16店舗を新規出店する一方で22店舗を閉鎖し、期末店舗数は182店舗と前期末の188店舗から減りました。不採算店舗のスクラップ＆ビルドや既存店の改装を進めた結果であり、「場」の拡大は出店の質を見直す段階にあります。他方、登録生産者数は前期末から2,248件増えて33,906件となり、「ユーザー」の拡大は続いています。",
        "basis": "経営成績等の状況における店舗数と登録生産者数の増減の記載に基づく",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、生産者が出品した商品について当社グループが在庫リスクを負わない委託販売の仕組みにあります。生産者は登録料・保証金を負担せず設備投資も不要で、「いつ・何を・いくつ・いくらで」出品するかを自由に決められるため、小規模な生産者でも集客力のあるモールの売場を使えます。店舗周辺の生産者による供給網（ローカルサプライチェーン）が漸次形成され、店舗の売上が積み上がっていく傾向があるほか、店舗設備が平台や冷蔵ケース、レジなどに限られ、運営がシンプルでローコストな点も特徴です。",
        "basis": "事業の内容における事業の特徴の記載に基づく",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "農産物直売所を通じた農業生産関連事業の販売金額は成長してきた一方、スーパーマーケットが野菜の産直コーナーを展開する店舗も増え、競争は厳しくなっていると説明されています。当社グループは青果に限らず、弁当・惣菜・パン類や加工品など地域の食品を幅広く集める「地域を結ぶ直売広場」として位置づけを図っており、営業収益7,982百万円、全国182店舗を展開する直売所運営の中堅プラットフォームです。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境の記載と経営成績等の状況の概要に基づく",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
