  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "LSI事業ではグラフィックスLSIとメモリモジュールを中核製品として製品の多様化と開発支援環境の整備を進め、AI事業ではハードウェア開発の知見を生かせるAIコンピューティング領域に注力して早期の収益化を目指すとしています。新規事業の確立による事業ポートフォリオの多様化を推進し、パチンコ・パチスロ機の市場環境に過度に依存しない持続安定的な企業体質を構築することを目標に掲げています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高はLSI事業が13,793百万円、AI事業が862百万円で、売上は依然としてパチンコ・パチスロ機向け製品に大きく偏っています。AI事業の売上高は前期の440百万円から増えており、多様化は進みつつある段階にあることが読み取れます。",
        "basis": "セグメント情報に、2026年3月期の外部顧客への売上高としてLSI事業13,793百万円、AI事業862百万円が、2025年3月期のAI事業の売上高として440百万円が印字されていること。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "パチンコ・パチスロ機市場で圧倒的な市場シェアと強固な顧客関係、継続的な開発力を有するとし、構造変化を競争優位を確立する機会と捉えています。研究開発力をコア・コンピタンスと位置付けています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "主要な販売先である緑屋電気株式会社との販売代理店契約は2000年の締結以来自動更新で継続しており、販売面での結びつきが長く続いていることが読み取れます。",
        "basis": "重要な契約等に、緑屋電気株式会社との日本国内における非独占的な販売代理店契約（2000年12月締結、1年ごとの自動更新）が印字されていること。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
