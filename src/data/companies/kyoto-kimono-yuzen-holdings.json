  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「記憶に、そして心に。」をグループの存在意義と位置付け、人生の節目に関わる和装事業で、商品の品質に加えて接客や提案、アフターフォローを通じて顧客とその家族の記憶と心に残る価値を提供することを基本方針としています。2025年3月期を「再生フェーズ」、2026年3月期を「実行フェーズ」と位置付けて構造改革と販売改革を進めており、2027年3月期を「成長フェーズ」として、既存事業の収益基盤の強化、顧客導線全体の最適化、ビジネスモデルの見直し、成長投資に取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "前期までの構造改革と販売改革の成果として、2026年3月期は売上高が前期比15.3％増の5,951百万円となり、親会社株主に帰属する当期純利益は黒字に転換しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "振袖の販売とレンタルに加えて、写真撮影スタジオの併設やオンラインストアをグループで運営し、友の会の積立による販売促進の仕組みを併せ持つ点が特徴です。",
        "basis": "【事業の内容】に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
