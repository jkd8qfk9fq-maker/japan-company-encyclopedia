  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-20",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "“Purpose”「『やればできる』の記憶をつくる」を起点として、子どもたちの自立を支援する教育事業会社から、幼児からシニアまであらゆる人々の可能性をひらく『総合的な人材支援グループ』へ進化し、“Vision”「人の可能性をひらく企業グループとなり輝く未来を実現する」の実現を目指しています。2025年８月期を初年度とする３ヵ年の中期経営計画『MEIKO Transition』では、３ヵ年を投資期間と位置づけ、『Business Transition』と『Human Transition』の２つを断行して成長基盤を構築し、その先の100年企業を目指します。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年８月期は、明光義塾直営事業の売上高が前期比8.6％増、その他の事業が同25.1％増と伸び、人材サービスや福祉など周辺事業の育成が進みました。一方で、売上高の約８割はなお明光義塾事業（直営・フランチャイズ）と日本語学校事業が占めており、打ち出している人材支援グループへの移行は途上です。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "直営476教室とフランチャイズ1,184教室を合わせた1,660教室の全国展開と、生徒の学力に応じて取り組むべき問題が分かる『明光式特許10段階学習法』などの指導ノウハウが基盤です。教室運営では、独自の学習管理システム『ClaMaS（クラマス）』やアプリによる教室運営のＤＸも進めています。",
        "basis": "MD&Aの経営成績等の状況の概要",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "『明光義塾』は小学生・中学生・高校生・既卒生の全学年を対象とし、全国47都道府県すべてに教室を展開する業界シェアトップの個別指導塾チェーンです。一方で、少子化の進行や競合他社の事業拡大、他業種からの新規参入により競争は激しくなっています。",
        "basis": "事業等のリスクの業界動向の記述、セグメント情報の外部顧客への売上高",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
