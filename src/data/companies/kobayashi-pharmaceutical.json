  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「人と社会に素晴らしい「快」を提供する」を掲げ、パーパスを「見過ごされがちなお困りごとを解決し、人々の可能性を支援する」とします。2026年12月期から2028年12月期までの中期経営計画では、「将来の持続的成長を実現するために、未来につながる土台を築く」をテーマに、信頼の再構築と持続的な成長に向けた企業変革に取り組みます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「あったらいいなをカタチにする」をコーポレートスローガンに、お客様自身も気づいていないお困りごとを見つけ、ニッチでユニークな製品を数多く展開します。ヘルスケア製品と日用品の幅広い製品群を持ち、国内と海外の両方で販売します。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内ではインバウンド需要の増加が売上に寄与する一方、原材料価格の高騰やエネルギーコストの上昇が続いています。国際事業では米国と東南アジアで売上が伸びる一方、中国では需要の落ち着きにより売上が減少しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-03-25",
