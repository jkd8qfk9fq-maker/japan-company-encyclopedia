  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年9月に、2030年7月期を最終年度とする中期経営計画「DCX2030」を策定しました。創業50周年を迎える2027年を一つの節目と捉え、第二創業期としての変革を推進する計画です。AI等の利活用によるソフトウェア開発の生産性と品質の向上、自社クラウドサービスやスマート農業分野への成長投資、パートナー企業との協業によるソリューション提案の拡大、人的資本への積極投資を軸にしています。クラウドサービスやスマート農業などの注力領域は、受託開発に並ぶ収益の柱へと育成・拡大していく方針です。",
        "asOf": "2026-10-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ソフトウェア開発プロセスの国際的なモデルであるCMMIで最高位の成熟度レベル5を達成している開発プロセスの成熟度と、受託開発からSaaS型サービス、保守までをグループ内で一貫して提供できる体制が強みです。",
        "basis": "【沿革】にCMMI V3.0で成熟度レベル5を達成したこと（2024年）が印字されていることと、【事業の内容】に受託開発・設計・開発・導入・保守とSaaS型ソフトウェアサービスの双方が事業として印字されていること",
        "asOf": "2026-10-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス産業では、DX推進や働き方改革、人手不足への対応に向けたシステム投資需要が堅調に推移しているとされています。同社の売上高はソフトウェア開発関連事業が全体の4分の3以上を占めています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、情報サービス産業において企業のIT投資意欲が底堅く、システム投資需要が堅調に推移したと印字されていることと、セグメント注記の外部顧客への売上高でソフトウェア開発関連事業が2,467百万円と全体3,239百万円の大半を占めること",
        "asOf": "2026-10-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
