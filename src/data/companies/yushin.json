  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "対処すべき課題として、取出ロボットではグローバル営業展開の強化と商品力の強化による販売拡大を掲げ、スウェーデンのWEMO Automation ABを足がかりに欧州でのシェアアップを図るとともに、顧客工場の自動化でより高い付加価値を提供する商品開発を継続するとしています。特注機では自動化ニーズを受けて社内体制の強化を進め、保守サービスではグローバルネットワークの更なる強化を図るとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高は2022年3月期の20,874百万円から2025年3月期の26,126百万円まで拡大した後、2026年3月期は23,101百万円に減少しました。製品別ではロボットがアジアを中心に堅調で14,947百万円と増えた一方、特注機は欧州のメディカル関連大口案件の減少で3,161百万円と大きく減り、部品・保守サービスは稼働台数の増加で4,992百万円と伸びています。",
        "basis": "セグメント情報の地域別売上高と関連情報の製品及びサービスごとの情報、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1978年に高速自動小型取出ロボットを発売して以来の取出ロボット専業の蓄積に加え、日本・米国・アジア・欧州の4地域に現地法人を置き、製造・販売・アフターサービスを各地域で担う体制を持っています。部品・保守サービスは世界の稼働台数の増加に伴って伸びており、販売後も継続する収益の柱になっています。",
        "basis": "事業の内容、セグメント情報の報告セグメントの概要、関連情報の製品及びサービスごとの情報に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の地域構成は日本が最大で、アジア、米国、欧州が続きます。欧州では2023年にWEMO Automation ABを買収して開発・製造拠点を持ちましたが、2026年3月期は欧州のメディカル関連大口案件の売上が大幅に減少し、欧州セグメントの外部売上高は2,692百万円と前期の5,480百万円から半減しました。",
        "basis": "セグメント情報の地域別売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
