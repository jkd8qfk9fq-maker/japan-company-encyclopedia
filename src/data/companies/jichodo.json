  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「揃わなければユニフォームとは言えない」というユニフォームの基本に立ち返り、「揃う自重堂」の復活に向け、生産体制の再整備・強化に注力して顧客からの信頼を取り戻し、販売機会ロスの低減と業績回復に努めます。「働く人を応援する」という基本理念に基づき、ワークウェアとしての機能性とデザイン性を兼ね備え、価格訴求力のある商品や、ＳＤＧｓ・サステナビリティに対応した商品など、「働く人」が求める商品の開発・販売を強化します。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "需要予測のもとメーカー自身が製品在庫を保有し、販売代理店経由の注文に即納品する備蓄型の体制により、サイズ・品番の「揃う」品揃えを強みとしています。製織・縫製の自社工場と子会社の縫製工場を持ち、企画から製造、販売までを一貫して行う体制も備えています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析と事業の内容の記載に基づく",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
