  "history": [
    {
      "year": 1972,
      "title": "兵庫県伊丹市でリード電機を創立",
      "description": "1972年3月、現在の取締役名誉会長である滝崎武光が兵庫県伊丹市でリード電機を創立し、自動制御機器、電子応用機器の開発、製造販売に着手しました。1974年5月に株式会社へ改組し、兵庫県尼崎市にリード電機株式会社を設立しています。",
      "significance": "「自動制御機器、計測機器、情報機器および関連する電子応用機器、オプトエレクトロニクス機器並びにこれらのシステムを開発、製造、販売している」という現在の事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1973,
      "title": "工場自動化用の各種センサの製造販売を開始",
      "description": "創立の翌1973年4月、工場自動化用の各種センサを開発し、製造販売を始めました。",
      "significance": "現在も主力の商品です。会社はファクトリー・オートメーション向けのセンサ、測定器、画像システム機器、レーザマーカに加え、研究開発向けのマイクロスコープ、物流・小売向けのコードリーダへと、市場の変化に応じて企画開発の範囲を広げてきたと説明しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1985,
      "title": "アメリカに現地法人を設立し、大阪に製造子会社をつくる",
      "description": "1985年3月にアメリカの現地法人KEYENCE CORPORATION OF AMERICAを設立し、同年9月に大阪府高槻市へ製造子会社クレポ株式会社（現 キーエンスエンジニアリング株式会社）を設立しました。",
      "significance": "KEYENCE CORPORATION OF AMERICAは現在も100％子会社として北米・中南米の販売を担い、キーエンスエンジニアリング株式会社は現在もキーエンス商品の製造を行っています。2026年3月期の売上高1兆1,692億89百万円のうち、海外は7,792億22百万円です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1986,
      "title": "社名を株式会社キーエンスに変更",
      "description": "1986年10月、ブランドと商号の統一を図るため、社名をリード電機株式会社から株式会社キーエンスに変更しました。",
      "significance": "現在の商号です。有価証券報告書の表紙にも会社名「株式会社キーエンス」、英訳名「KEYENCE CORPORATION」と記載されています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1990,
      "title": "東京証券取引所および大阪証券取引所の市場第一部に上場",
      "description": "1987年10月に大阪証券取引所市場第二部、1989年12月に東京証券取引所市場第二部へ上場したのち、1990年9月に東京証券取引所および大阪証券取引所の市場第一部へ上場しました。同月、大阪府高槻市に生産管理センターを設立しています。",
      "significance": "2022年4月に東京証券取引所の市場区分が見直されるまで、東京証券取引所市場第一部に上場していました。有価証券報告書の表紙に記載されている上場金融商品取引所は、現在は東京証券取引所プライム市場のみです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1994,
      "title": "大阪市に新本社・研究所を竣工し、本社を移転",
      "description": "1994年8月、大阪市に新本社・研究所を竣工し、本社を移転しました。2007年11月には大阪府高槻市にロジスティクスセンターを、2009年7月には大阪市にクオリティ・ラボを設立しています。",
      "significance": "本店の所在地は大阪市東淀川区東中島1丁目3番14号で、本社・研究所には製造・研究開発・貿易・管理業務の設備が置かれ、2026年3月20日現在で672人が働いています。高槻市のロジスティクスセンターは帳簿価額469億70百万円と、設備のなかで最も大きいものです。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2001,
      "title": "中国に現地法人を設立",
      "description": "2001年9月、中国に現地法人KEYENCE (CHINA) CO.,LTD.を設立しました。その後もブラジル（2011年）、インド（2011年）、インドネシア（2013年）、ベトナム（2014年）などに現地法人を設けています。",
      "significance": "KEYENCE (CHINA) CO.,LTD.は現在も100％子会社で、アジアの11社とともに販売を担っています。2026年3月期の中国での売上高は1,865億50百万円でした。会社は、海外市場では市場規模と比べ商品の浸透度がまだ小さく、大きな成長余地があるとして、国内と同様に直販体制の推進を図るとしています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、東京証券取引所市場第一部からプライム市場へ移行しました。",
      "significance": "現在の上場市場です。有価証券報告書の表紙には、上場金融商品取引所名として「東京証券取引所プライム市場」と記載されています。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
