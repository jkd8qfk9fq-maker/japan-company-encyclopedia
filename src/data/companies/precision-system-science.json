  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年９月30日公表の中期経営計画に基づき、独自の自動化プラットフォーム（PSSプラットフォーム）の浸透による関連試薬・消耗品の売上拡大（リカーリングビジネス）、大館試薬センターの稼働率向上とコスト低減による収益力の改善、生産性向上と安定供給の確保を課題に掲げ、事業の運営体制全般の見直しを進めるとしています。",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は、PSSプラットフォームの装置販売が欧州大手顧客向けを中心に堅調に推移し、過年度からの累計出荷台数の蓄積に伴って試薬・消耗品の売上高が前期比32.5％増と大きく伸びました。事業再編と構造改革による費用抑制の効果も表れ、親会社株主に帰属する当期純利益は394百万円と黒字に転じています。",
        "basis": "MD&Aにおける製品区分別の売上高の記載と、経営方針における中長期的な経営戦略の記載に基づく",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独自技術「マグトレーション・テクノロジー」について日本・米国・欧州等の世界各国に特許を出願し、核酸自動抽出の基盤技術として確立しています。主要なODM契約はいずれも当社が独占的に供給する内容であり、グローバル大手との長期契約で装置の設置台数を積み上げることが、そのまま試薬・消耗品の継続的な販売につながる構造です。",
        "basis": "沿革におけるマグトレーション・テクノロジーの記載と、重要な契約等におけるODM契約の記載に基づく",
        "asOf": "2026-09-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
