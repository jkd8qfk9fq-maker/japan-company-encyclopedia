  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「すべての人に最高の余暇を」のもと、IPを取得・保有・創出し、その多元展開でコンテンツを育成します。2027年3月期を初年度とする3ヵ年のグループ中期経営計画では、国内コンテンツ市場の開拓と新たなビジネスモデルの構築、中国市場における事業基盤の盤石化と収益の維持拡大、「IP成長プラットフォーマー」としての確立、アミューズメント機器事業におけるファン層拡大と開発加速に取り組みます。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「ウルトラマン」のアジア圏における強固なファン基盤と、円谷プロダクションを中心とするIPの保有・創出、国内最大規模のCG・VFX映像制作を手掛けるデジタル・フロンティア、遊技機の企画・開発・流通を担うフィールズをグループに持ちます。2026年3月期の遊技機販売台数は約27.4万台です。",
        "basis": "有報の経営方針、事業の内容、経営者による分析に印字されたファン基盤、グループ各社の役割、遊技機販売台数です。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は174,142百万円、親会社株主に帰属する当期純利益は13,050百万円で、従業員数は1,774人です。東京証券取引所プライム市場に上場しています。アミューズメント機器事業が売上高の大半を占めます。",
        "basis": "有報の連結経営指標等に印字された2026年3月期の数値、セグメント情報、表紙の上場市場です。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
