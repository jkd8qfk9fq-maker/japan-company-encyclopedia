  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業100年を迎える2027年9月期を節目に、「景観産業」に「環境保全」の役割を加えた「環境創造企業」への進化を目標として掲げています。2030年に向けた成長戦略では、職人型現場力による付加価値の高い造園緑化施設の提供、新たなイノベーションの創出、ＳＤＧｓへの貢献とサステナビリティ経営の推進を3つの基本戦略とし、ガーデンエクステリアとランドスケープの両領域で創業以来の造園技術を活かした空間づくりを進めるとしています。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業者・小栗弥一が京都「植治」七代目小川治兵衛の下で修業して培った造園技術を受け継ぎ、工事監督やデザイナーもいざとなれば自ら手を動かせる「職人型現場力」を強みとしています。富裕層向けの高級案件など難易度の高い外構造園を手掛け、住宅分譲地では指定業者として全棟のガーデンエクステリアを任されることが多い点も特徴です。営業から施工、完成後のメンテナンスまでを一貫して行える体制を持ち、積水ハウスとは2020年に資本業務提携契約を締結しています。",
        "basis": "【事業の内容】の製品及びサービスに関する情報（ガーデンエクステリア・ランドスケープの受注形態と施工体制）、【重要な契約等】の資本業務提携契約、MD&Aの経営成績の概要に基づきます。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
