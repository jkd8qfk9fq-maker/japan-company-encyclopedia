  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、基幹システムA-COMSの機能追加に取り組み、乗り換えによるアトラ請求サービスの会員の増加に注力するとしています。あわせて、リバース・エイジング提供のためのプラットフォームの拡大、アトラアカデミーのコンテンツの充実やセミナーの開催、オリジナル機材の開発、HONEY-STYLEの会員と利用院の増加、ほねつぎデイサービスの加盟店開発、アトラストアの利用会員の増加、玩具販売店ペリカンの収益改善に取り組むとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は、A-COMS事業が2,357百万円、玩具販売事業が1,569百万円で、全体では3,927百万円でした。A-COMS事業の中では、アトラ請求サービスとHONEY-STYLEの売上高が前期を上回りました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント別の売上高の記載に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "基幹システムA-COMSは拡張性を備えており、サービス内容の追加を容易に行うことができるとしています。また、A-COMSは療養費の不正請求を防止する仕組みとしても機能し、鍼灸接骨院業界で遅れていたIT化を推進するシステムであるとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "アトラ請求サービスでは、開設届の作成への対応から、療養費支給申請書の点検と提出、返戻への対応、入金と送金の処理、データの保管、コールセンターでの問い合わせ対応までを担う体制を整えています。あわせて、療養費の入金までの期間の資金繰りを支えるA-COMSファイナンスサービスも提供しています。",
        "basis": "【事業の内容】のアトラ請求サービスの記載に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "企業理念として「世界中の人を健康にしたい。」を掲げ、提供するサービスが鍼灸接骨院のインフラとして機能するよう注力するとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "鍼灸接骨院業界では療養費が減少傾向にあり、自費施術と物販の拡大が課題となっています。同社は、基幹システムを核とした経営支援の事業で、この課題に対応しています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の業界環境の記載に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
