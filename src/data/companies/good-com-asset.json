  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "Purposeとして『不動産を安心と信頼のできる財産としてグローバルに提供し、社会に貢献する』を、Visionとして『21世紀を代表する不動産会社を創る』を掲げています。成長戦略として不動産ファンド事業及びＭ＆Ａを推進し、当連結会計年度は私募ファンド2案件（総額約270億円）を組成し、Ｍ＆Ａにより2社の株式を取得しました。",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "当連結会計年度は、主要顧客であった公務員の方々への販売戸数の減少等により連結売上高が前期比8.7％減となる一方、ファンド組成とＭ＆Ａによる事業拡大が進められ、Livenup Groupの連結子会社化により戸建・再販分野が新たに加わりました。",
        "basis": "セグメント情報等の外部顧客への売上高、主要な顧客ごとの情報及びMD&Aの経営成績等の状況の概要に基づく",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "『GENOVIA』シリーズは、壁面緑化デザイン『green veil』等の統一仕様、最寄駅から徒歩10分圏内の立地選定、防犯設備の標準装備を特徴とします。販売後も賃貸管理・建物管理・家賃債務保証までグループ内で担う体制が強みです。",
        "basis": "【事業の内容】のGENOVIAシリーズの主な特徴及び事業概要に基づく",
        "asOf": "2026-01-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
