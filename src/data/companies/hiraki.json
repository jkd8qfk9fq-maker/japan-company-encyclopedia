  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『2026中期経営計画（2024～2026年度）』では自社企画開発商品（オリジナル商品）の開発強化を第一義に据えています。次期は「ローコスト経営の徹底」と「未来への土台づくり」を基本戦略とし、通信販売事業では開発体制の見直しによるリードタイムの短縮とECへのシフト、店舗販売事業では靴専門店モデルの標準化と継続的な出店、卸販売事業では大手小売店との取引増加とODM営業の強化に取り組む方針です。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は『2026中期経営計画（2024～2026年度）』の最終年度にあたります。会社は次期の基本戦略として、固定費の削減や業務効率化によるローコスト経営の徹底と、商品・サービスの見直し、新市場の開拓、人材育成など将来の成長につながる投資を掲げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の中期経営計画と対処すべき課題の記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "開発・生産から販売まで一貫した体制を持ち、自社企画開発の商品を主に海外へ生産委託し、上海の連結子会社が調達を担いながら、店舗・通信販売・卸販売の3形態で販売しています。品質を守りながら気軽に買える価格設定で商品開発を行うことを掲げています。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "会社は、コア事業である靴・履物市場の拡大は期待できないと認識しています。その中で、総合ディスカウントストア「靴のヒラキ」の岩岡本店で販売足数日本一の靴売場を目指し、京阪神エリアでは靴専門店を2026年3月31日現在18か店展開するなど、靴を軸にした店舗展開を続けています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の中長期的な取り組みの記載に基づく",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
