  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「超高齢社会の地域包括ケアをクラウドで支える」ことを掲げ、成長戦略「カナミックビジョン2030」のもとで、介護業務全般を支援するAI搭載クラウド介護ソフトの提供などプラットフォームサービスの拡大と、シンガポールのＴＨＥ ＷＯＲＬＤ ＭＡＮＡＧＥＭＥＮＴを子会社化したことを起点とする海外展開に取り組んでいます。ITサービスとリアル店舗の双方を包括したヘルスケアプラットフォームの構築を推進する方針です。",
        "asOf": "2026-10-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "カナミッククラウドサービスは介護保険制度が始まった2000年から提供が続くストック型のサービスで、有料ユーザーID数は2025年9月末時点で221,822、無料を含めた合計は339,319に達しています。多職種が医療介護情報を共有するシステムに関する特許権を保有し、自治体や医師会における地域連携の基盤として使われています。",
        "basis": "事業の内容におけるユーザーID数の推移と特許権の記述、MD&Aにおけるストックビジネスの記述に基づく。",
        "asOf": "2026-10-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
