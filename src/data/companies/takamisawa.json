  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な戦略として「収益基盤の拡充」を最重要課題に掲げ、各社のコア事業の育成、キャッシュ・フロー重視の経営による財務体質の強化と改善、提案営業による営業力の強化、新しい事業の開発の模索などに取り組みます。中期重点目標として、持続的成長に向けた事業基盤の再構築（セグメント制の特性を活かした事業ポートフォリオの継続的な見直し）、DX活用による労働生産性・資本生産性の向上、人的資本への投資、サステナビリティ経営への取組とステークホルダー価値の向上を掲げています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "最大の電設資材事業を中心に収益基盤を拡充しつつ、セグメント制のもとで事業ポートフォリオを見直し、成長性と収益性の両立を図る方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等の中長期的な戦略と中期重点目標の記載",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "長野県を地盤に、電設資材の販売からコンクリート製品の製造、石油・自動車、食品、不動産まで幅広い事業を持ち、地域の公共・民間の需要に複数の事業で応えられる体制があります。建設関連事業では、高炉スラグ微粉末を用いた低炭素型コンクリート「ロカコン」の開発、ブランド化を推進しています。",
        "basis": "事業の内容と、経営方針、経営環境及び対処すべき課題等における低炭素型コンクリート「ロカコン」の記載",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高では電設資材事業が41,765百万円と過半を占め、カーライフ関連事業17,109百万円、建設関連事業8,592百万円、その他事業8,193百万円と続く構成です。本邦の外部顧客への売上高が連結売上高の90％を超える国内中心の事業で、連結売上高の10％以上を占める特定の顧客はないと開示されています。",
        "basis": "セグメント情報等の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報に基づく",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
