  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針として「付加価値を創出し、成長し続けることで、未来のグローバル社会へ貢献します」を掲げています。既存事業では見える化や改善に加えて戦略的に成長投資を行い持続的な成長を目指し、加えてグローバルを含む新規事業領域にも投資と買収後の統合（PMI）を行い、新しい成長領域の創出にも挑戦するとしています。投資する地域は、環太平洋地域（東南アジアや北米、豪州）や東京など大都市部を主に考え、事業の付加価値を見える化してPDCAサイクルを回すTQM活動に取り組んでいます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企業向けの卸売りから消費者向けサービスまで3つの事業領域を持ち、子会社150社を通じて建設資材、エネルギー、情報システム、通信、介護など幅広い分野をグループで担っていることが特徴です。",
        "basis": "【事業の内容】に、当社グループが当社及び子会社150社、関連会社16社で構成され、情報システム関連事業、企業サプライ関連事業、生活・地域サービス関連事業の3セグメントで構成されることが印字されている。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "福井県福井市に本店を置く総合商社で、北陸を地盤としながら東京にも本社を置き、シンガポールなど海外の子会社を通じて海外事業も展開しています。",
