  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2020年に策定した「VISION2030～新たな価値づくりへの挑戦～」のもと、従来の架線金物事業に留まらず、新分野・新需要に対応した研究を推進し、新規マーケットおよび新規ビジネスの開拓を積極的に進めて、事業領域の拡大を通じて持続的な成長を実現するとしています。あわせて、カーボンニュートラルの実現や国土強靭化、スマートシティの実現といった社会的要請に応える製品の提供に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "電力・通信分野の設備更新需要を既存の架線金物で取り込みながら、防衛関連の無線システム装置や再生可能エネルギー関連など、周辺分野へ事業を広げる方針が読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に「VISION2030～新たな価値づくりへの挑戦～」のもとで新分野・新需要への研究推進と新規マーケットの開拓が印字され、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に再生可能エネルギー関連の営業展開や防衛関連の無線システム装置等の受注への取組みが印字されていることによる。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "支線棒や自在バンドなどの製品が、電力会社や通信事業者の仕様として長年にわたり採用されてきた実績と、国内の工場と全国の支店網による供給・販売体制が特徴です。中国の子会社を含むグループの製造体制も持っています。",
        "basis": "【沿革】に、中部電力や東京電力、関西電力などで支線棒や自在バンド各種が仕様化されたことが印字され、【主要な設備の状況】に松戸の工場群と札幌・仙台・名古屋・大阪などの支店が印字されていることによる。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電力、通信、信号、放送、鉄道用の電気架線金物を専門に製造販売するメーカーです。単一セグメントで、需要は電力会社の高経年化設備の更新工事や通信事業者の光ネットワーク工事など、社会インフラへの投資に連動しています。",
        "basis": "【事業の内容】に、電力、通信、信号、放送、鉄道用各種電気架線金物及びコンクリートポール用品等の製造販売が主な事業であり、事業区分は単一セグメントであることが印字され、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に電力分野で高経年化設備の更新工事が進められたことが印字されていることによる。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
