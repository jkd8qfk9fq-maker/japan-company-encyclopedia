  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「食の喜びをすべての人へ」を掲げ、「築地食堂源ちゃん」を始めとした店舗がお客様にとっての「食のインフラ」となることを目指しています。中長期的な経営戦略として、新店開発の強化（商業施設への出店に加え、路面店やロードサイドへの出店チャンネルの拡大）、人財育成の強化、シナジー効果を生み出すＭ＆Ａの積極的な検討、主要ブランドのフランチャイズ化の検討を進めるとしています。",
        "asOf": "2025-11-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "市場から直送する鮮魚の仕入体制と、36ブランドを持つ店舗開発力が強みと考えられます。",
        "basis": "【事業の内容】に、仕入本部が主に東京豊洲市場を始め全国の各市場で買い付けを行い、その日の漁獲量等に応じた仕入商品の変更と、それに応じた日替わり商品の提供を行う体制が整備されていること、商業施設のニーズに合わせた出店を行いディベロッパーとの関係を構築していることが書かれているため。",
        "asOf": "2025-11-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年8月期の売上収益は11,288百万円で前期比10.1％増となり、店舗数は126店舗まで増えています。",
