  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年4月19日に、連結子会社の富士チタン工業株式会社の神戸工場で火災事故が発生し、排ガス設備が被災して操業停止中です（有報の「重要な後発事象」に記載）。人的被害はありませんが、業績への影響は調査中で、当火災に関連した損失等の金額を合理的に見積もることは困難な状況とされています。"
    ]
  },
  "updatedAt": "2026-11-09",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「Vision 2030」と、それに基づく中期経営計画（2024～2026年度）「Vision 2030 Stage II」に取り組んでいます。有機化学事業では「顧客の価値向上に直結する独自製品を世界中に供給し、人々の食、健康、生命を支える」ことを、無機化学事業では「酸化チタンで培った技術をベースとした新たなる価値を創造する」ことを事業方針としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "パーパスを「化学技術でより良い生活環境の実現に貢献し続ける」とし、コアコンピタンスである「化学技術」を中心として、「独自の技術開発力」「品質・環境対応力」「グローバルな協業力」の3つを強みとして掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "農薬は欧州・米州・インドなどに事業を統括する子会社を持ち、地域ごとに製剤・販売まで行う体制です。四日市工場には有機化学事業と無機化学事業の両方の生産設備と研究開発設備が集まっています。",
        "basis": "【事業の内容】の海外子会社の位置付けと【主要な設備の状況】の四日市工場の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
