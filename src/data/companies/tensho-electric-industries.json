  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「ものづくりを通じて豊かな社会を創造しよう」のもと、品質・価格・納期により顧客満足を提供し、ステークホルダーとの信頼構築に努めることを経営方針としています。今後とも自動車部品、機構品部品、物流産業資材等の自社製品の成形分野を中心として企業活動を推進してまいります。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、三甲アメリカコーポレーションが連結範囲から外れたことで売上高が前期から大きく減りました。一方で日本成形関連事業は自動車業界における生産調整の影響の解消に伴い回復基調となり、売上高の大部分を国内の成形事業が占める構成になっています。",
        "basis": "セグメント注記の外部顧客への売上高（日本成形関連事業21,041百万円、中国成形関連事業551百万円、不動産関連事業284百万円）と、MD&Aの経営成績の概要にアメリカ成形関連事業の除外と日本成形関連事業の回復基調が述べられていることを根拠としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "技術部門がお客様の開発部門と緊密な連携・協力関係を保ち、製品設計の段階から積極的な提案活動を行っていることや、最新の成形技術・塗装技術等の取得に向けて情報収集を続けていることが、受注活動を支えています。",
        "basis": "【研究開発活動】に、技術部門とお客様の開発部門との連携・協力関係、製品設計段階からの提案活動、成形技術・塗装技術等の取得に向けた情報収集が印字されていることを根拠としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高の大部分は日本成形関連事業によるもので、主要な顧客ごとの情報には株式会社ＳＵＢＡＲＵやトヨタ紡織株式会社が販売先として印字されています。自動車業界の生産計画の変更により受注が大きく動く可能性があることが、対処すべき事項として述べられています。",
        "basis": "セグメント注記の外部顧客への売上高と主要な顧客ごとの情報、MD&Aの経営成績に重要な影響を与える要因についての記述を根拠としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
