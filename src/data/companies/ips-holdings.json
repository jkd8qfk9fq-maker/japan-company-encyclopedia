  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "SAP ERPの導入支援を通じて顧客の経営革新とビジネス革新を支援することを基本方針とし、導入品質・コスト・納期と顧客に対する付加価値を顧客満足の要素としてより高い次元で提供すること、先進的な技術を背景に独自のサービスを追求すること、研究開発に全社を挙げて取り組むことを掲げています。持株会社体制のもとで統治体制と事業執行体制を分離し、若手経営幹部の登用による事業体制の構築とグループ経営の効率化を進めるとしています。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、年商100億円から2,000億円規模の中堅・準大手企業に特化して蓄積したSAP導入のノウハウと、20年以上にわたる導入実績や独自開発プログラムを集約した自社テンプレート「EasyOne」にあります。SAPジャパン株式会社のパートナーとして最上位クラスのプラチナパートナーに認定されており、顧客のグローバルな事業活動を支えるためUnitedVARsに参画し、約70か国のSAPベンダーと連携できる体制も築いています。",
        "basis": "【事業の内容】における当社グループの特徴（対象とする顧客規模、EasyOneテンプレート、プラチナパートナー認定、UnitedVARsへの参画）の記載に基づく。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "SAP導入の元請け企業は厳しい競争と峻別を経て、現在は20社程度の代表的な企業が残る市場となっており、同社はその代表的な一社と位置づけられています。売上高は2022年6月期の2,728百万円から2026年6月期の3,775百万円へ推移し、連結従業員数は163人です。",
        "basis": "【事業の内容】におけるSAP導入元請け企業の状況の記載と、主要な経営指標等の推移における売上高と従業員数の推移に基づく。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
