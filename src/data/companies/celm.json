  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期的な経営重点テーマとして、顧客基盤の一層の拡充、既存顧客企業における連結グループ企業及び人事以外の各部門との取引拡大、好循環サイクルと顧客リピートの維持、プロフェッショナルタレント基盤の拡充を掲げています。また、大企業顧客に対する組織・人材開発支援を主力領域としつつ、M&Aを積極的に推進し、グループ企業間のシナジーの最大化を図る方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "約1,700名の外部プロフェッショナルタレントのネットワークを持ち、顧客の課題に応じて最適な人材を組み合わせるテーラーメード型の支援を行う点が特徴です。業務委託契約の活用により、タレントへの費用は稼働したときにのみ発生する体制で、プロジェクトごとにチーム編成を入れ替えながら幅広いソリューションを提供しています。",
        "basis": "【事業の内容】の注記に、外部プロフェッショナルタレントは大手戦略コンサルティングファームの元パートナーや上場企業の元CXO経験者など約1,700名（2026年3月現在）のハイエンド人材の外部ネットワークであり、業務委託契約を活用することで稼働したときのみ費用が発生する体制であること、各プロジェクトに最適な人材を組み合わせ、テーラーメード型ソリューションを提供することが書かれています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
