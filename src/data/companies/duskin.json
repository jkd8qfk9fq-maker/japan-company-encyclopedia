  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスは「人に社会に寄り添い、安心と喜びのある豊かな明日を創造します。」、ビジョンは「人と人、人と社会、人と明日をつなぐ笑顔の環を届けます。」です。長期戦略「Ｄｏ-Ｃｏｎｎｅｃｔ」と「中期経営方針2028」（2026年3月期～2028年3月期）のもと、新たな事業への「新化」、周辺事業への「進化」、既存事業の「深化」と経営基盤の強化に取り組んでいます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "フランチャイズ方式で全国に事業を展開し、レンタルしたマット・モップを回収して洗浄し、再び供給する循環の仕組みを持っています。清掃用品のレンタルに加え、ミスタードーナツを中心とする飲食店も展開しています。",
        "basis": "事業の内容とセグメント情報の印字から、フランチャイズ方式とレンタル商品の循環の仕組み、2つの報告セグメントを読みました。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の全国チェーン店お客様売上は466,795百万円で、訪販グループが273,273百万円、フードグループが147,114百万円でした。海外では台湾、中国、マレーシア、香港、シンガポール、インドネシアでミスタードーナツ事業などを展開しています。",
        "basis": "経営者による分析の全国チェーン店お客様売上の表と、沿革の海外展開の印字から読みました。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
