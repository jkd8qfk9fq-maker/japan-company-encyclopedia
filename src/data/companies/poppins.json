          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        }
      ]
    },
    {
      "id": "professional",
      "name": "プロフェッショナル事業",
      "description": "保育や乳幼児教育のノウハウを活かした教育研修と調査研究の事業です。2025年12月期の外部顧客への売上高は693百万円です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "training",
          "name": "教育研修事業",
          "description": "保育士キャリアアップ研修や子育て支援員研修などを、こども家庭庁や自治体、企業・団体、個人に向けて提供しています。ハーバード大学やスタンフォード大学、英国ノーランドカレッジと連携した海外研修も行っています。",
          "sourceIds": [
            "yuho-2025"
