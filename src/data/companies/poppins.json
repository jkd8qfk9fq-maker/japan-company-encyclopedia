        {
          "id": "licensed-childcare",
          "name": "認可保育事業",
          "description": "国の設置基準を満たして都道府県知事の認可を受けた認可保育所と、教育と保育を一体的に行う認定こども園を運営しています。保育料は区市町村が徴収し、グループは国や自治体から施設型給付を受けて運営します。",
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "unlicensed-childcare",
          "name": "認可外保育事業",
          "description": "東京都の認証保育所、企業・大学・病院の事業所内保育所と企業主導型保育所、学童保育や児童館、商業施設内・ホテル内保育所、アクティブラーニングスクールやインターナショナルスクールなどを運営しています。自治体や各機関からの委託料、利用者からの保育料で運営します。",
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【事業の内容】"
        }
      ]
    },
