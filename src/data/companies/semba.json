  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年12月期から2027年12月期までの3か年を対象とする「中期経営計画2027」を策定し、スローガンとして“Create More Fun and More Fans!”を掲げ、①未来を創る人材の育成と獲得、②“Good Ethical Company”のファンベース構築、③サービス領域の拡大と提供価値の向上、④持続的成長を支えるサプライチェーン、⑤グローバル市場の深耕の5点を重点テーマとして定めています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、商業施設で培った空間づくりの実績を、注力分野と位置づけるオフィス・余暇施設等へ広げ、サービス領域の拡大と提供価値の向上につなげることです。海外では台湾・シンガポール・中国・ベトナム・マレーシアの各拠点が商業施設の内装を手がけており、グローバル市場の深耕も重点テーマに掲げています。",
        "basis": "セグメント情報等の関連情報（地域ごとの情報、主要な顧客ごとの情報）、【事業の内容】の市場分野の区分と各社の役割、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "調査・分析から企画・コンサルティング、デザイン・設計、監理、施工、デジタル技術を活かした空間演出までを一貫して手がけ、店舗什器の製作や陳列用具の設計・製作・販売を担う連結子会社も擁するため、売り場づくりをまとめて受託できます。国内では大型複合施設や百貨店の改装、オフィス関連施設で受注が拡大し、海外では台湾の長期にわたる大型開発案件が進捗しています。",
        "basis": "【事業の内容】の業務内容と当社グループ各社の位置付け、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "企業の好業績やインバウンド需要により、商業領域以外にもオフィスやホテル、インフラ施設などあらゆる空間づくりにおける設備投資は好調に推移し、マーケットは活性化しています。当社は商環境創造事業の単一セグメントで、2025年12月期の売上高32,831百万円のうち国内が28,887百万円、海外が3,944百万円です。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要、セグメント情報等の関連情報（地域ごとの情報）",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
