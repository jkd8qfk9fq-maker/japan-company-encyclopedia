  "history": [
    {
      "year": 1944,
      "title": "京都で創業し、セラミックコンデンサの製造を開始",
      "description": "村田昭が京都市に個人経営の村田製作所を創業し、セラミックコンデンサの製造を始めました。",
      "significance": "創業のときからの製品であるコンデンサは、今も最大の製品区分です。2026年3月期のコンデンサの販売実績は9,364億18百万円で、全体の51.1%を占めました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1950,
      "title": "株式会社に改組し、株式会社村田製作所に商号変更",
      "description": "資本金1百万円の株式会社に改組し、商号を株式会社村田製作所に変更しました。1961年には本社を現在の京都府長岡京市に移しています。",
      "significance": "現在の商号です。本店は今も京都府長岡京市東神足にあります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1962,
      "title": "福井村田製作所に資本参加",
      "description": "㈱福井村田製作所に資本参加しました（現在100%所有）。その後も富山（1982年）、出雲（1983年）、金沢（1984年）、岡山（1992年）と、国内の生産会社を設立しています。",
      "significance": "本体が半製品をつくり、生産会社が完成品まで加工するという現在のつくり方の土台です。㈱福井村田製作所や㈱出雲村田製作所は今も重要な生産会社です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1965,
      "title": "米国に販売会社を設立",
      "description": "米国に販売会社（現 Murata Electronics North America, Inc.）を設立しました。1973年には中国にMurata Company Limitedを、1978年には欧州で初めての販売会社をドイツに設立しています。",
      "significance": "海外で売る体制の始まりです。Murata Electronics North America, Inc.は今も重要な販売会社で、2026年3月期の売上収益は南北アメリカが3,038億49百万円を占めています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1972,
      "title": "シンガポールに生産・販売会社を設立",
      "description": "シンガポールに生産・販売会社Murata Electronics Singapore (Pte.) Ltd.を設立しました。その後もタイ（1988年）、マレーシア（1993年）、フィリピン（2011年）と、アジアに生産拠点を広げています。",
      "significance": "海外生産の始まりです。同社は今も重要な生産会社で、コンポーネントとデバイス・モジュールをつくっています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1994,
      "title": "中国に生産会社を設立",
      "description": "中国にWuxi Murata Electronics Co., Ltd.を設立しました。翌1995年には販売会社Murata Electronics Trading (Shanghai) Co., Ltd.を、2005年には深圳の生産会社と中華圏の販売統括会社Murata (China) Investment Co., Ltd.を設立しています。",
      "significance": "現在いちばん大きい市場である中華圏の拠点です。2026年3月期の顧客の所在地別売上収益は、中華圏が8,650億7百万円で全体の約47%を占めました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2014,
      "title": "米国のpSemi Corporationを買収",
      "description": "米国の開発・生産及び販売会社（現 pSemi Corporation）を買収しました。2012年にはルネサスエレクトロニクス㈱のパワーアンプ事業を譲り受け、2016年にはフランスの現 Murata Integrated Passive Solutions SASを買収しています。",
      "significance": "部品を組み合わせた製品を扱うデバイス・モジュール事業を広げた買収です。pSemi Corporationは現在100%子会社として、デバイス・モジュールの製造販売と開発を担っています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2017,
      "title": "ソニーの電池事業を譲り受ける",
      "description": "ソニー㈱及びそのグループ会社の電池事業を譲り受けました。",
      "significance": "リチウムイオン二次電池はデバイス・モジュール事業のエナジー・パワー区分の製品になっており、中国のMurata Energy Device Wuxi Co., Ltd.などが製造しています。",
      "sourceIds": [
