  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是「特性ある仕事をして社会に貢献する」と「飼は食を司る」との使命感のもと、独立系の配合飼料の総合メーカーとして、特性ある飼料の開発、製造及び安定供給に取り組んでいます。2025年3月期を初年度とする中期経営計画2024では、「収益力向上と規模拡大により強い収益基盤を構築する」「資本コストを意識した経営を実践する」という基本方針のもと、飼料セグメントの収益力向上と規模拡大、その他セグメントの事業成長の加速、成長する収益基盤を支えるサステナビリティ経営の推進の3つを基本戦略としています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独立系メーカーとして自社一貫生産設備を活かし、製造・販売・研究が一体となった取組みを進める体制です。大府研究所や加茂研究所、大分試験場などの研究・試験拠点を持ち、差別化飼料の開発や、試験漁場を持つ強みを生かした水産飼料の新製品開発を行っています。",
        "basis": "【事業の内容】・【経営方針、経営環境及び対処すべき課題等】・【主要な設備の状況】の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の大部分は飼料セグメントが占め、本邦の顧客への売上高が連結売上高の90%を超える国内中心の構成です。配合飼料は原料の90%以上を輸入穀物によって生産しており、価格は四半期ごとに改定されるため、穀物相場や為替の変動の影響を受けやすい構造です。",
        "basis": "【セグメント情報】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
