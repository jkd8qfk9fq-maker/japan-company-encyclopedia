  "updatedAt": "2026-11-24",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営戦略として、「CCT-DX Method」や「Orizuru」の熟成と機能拡充に努め、あらゆる産業の企業からDX実現のパートナーとして選ばれることを目指すとしています。また、「Ohgi」のパートナーを東京都以外へも広げてネットワークの拡大を図るほか、DX支援の強化を目的として、上流工程の協業が可能な企業や業界知見を有する企業などを対象にM&Aを積極的に進める方針です。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、DX支援とIT人材調達支援の両サービスが増収となり、売上高は前期比8.9％増の20,878百万円となりました。会社は既存顧客のフォローに注力した結果と説明しています。",
        "basis": "MD&Aの経営成績の状況（サービス区分別の売上高と増収理由の記述）と【事業の内容】の受注経路の記述に依拠します。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製造業の現場に関するものづくりの知見と、形状認識・3Dグラフィックス・AIなどの技術力を併せ持つ点が特徴です。また、「Ohgi」に登録する中小IT企業のエンジニアを活用することで、自社の従業員数を超えるデリバリー体制を組むことができ、売上高に占める外注費の比率は約６割とされています。",
        "basis": "【事業の内容】の当社グループの特徴（ものづくり知見と技術、IT人材調達力）と、MD&Aの経営成績の状況における強みの記述に依拠します。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のDX市場は拡大が見込まれ、ITエンジニアの需給ギャップも拡大すると会社は認識しています。製造業・建設業向けDX支援では国内外の大手SIer等と競合する一方、IT人材調達支援では大手SIerが顧客でもあるため、競合ではなく協業を目指す方針を示しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境と、MD&Aの情報サービス業界の動向の記述に依拠します。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
