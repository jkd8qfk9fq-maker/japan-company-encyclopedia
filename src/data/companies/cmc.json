  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画では「2030年を見据え、人とデータの共生を支える情報活用の基盤を拡げる」を基本方針としています。商材戦略では、お客さま企業の製品・業務情報に基づく情報活用の基盤構築を進め、次の段階として生成AIの活用で情報体験価値を高めることに注力するとしています。市場戦略では、アジアと欧州の拠点の再編を通じてグローバル体制作りを進めたとし、今後も成長市場への展開を加速するとしています。",
        "asOf": "2025-12-12",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "2025年9月期は、Knowledgeが製品・業務情報のデータ利活用支援の拡大で前期比7.1％増となった一方、Manualsは製品モデルサイクルや販売計画の変更・中止の影響で前期比22.9％減となり、売上高全体では前期比6.5％減となりました。事業分類別の構成ではKnowledgeが60.2％と過半を占め、収益の中心はManualsからKnowledgeへ移っています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（全般的概況と事業分類別の状況）に基づく。",
        "asOf": "2025-12-12",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1977年からトヨタ自動車のリペアマニュアルの原稿作成を担ってきた制作実績があり、顧客企業の商材・市場・会社を深く理解して情報を体系化する体制を築いています。国内5社・海外4社の連結子会社が専門性に応じて相互に業務支援を行い、翻訳を含む制作をグループで担えることも強みです。",
        "basis": "沿革、事業の内容（事業系統図の注記）、関係会社の状況に基づく。",
        "asOf": "2025-12-12",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客ごとの情報では、トヨタ自動車が最大の顧客として印字され、2025年9月期の販売実績では総販売実績の26.7％を占めています。地域別の売上高は日本が15,666百万円、その他が2,589百万円で、日本の顧客向けが中心です。",
        "basis": "セグメント情報等の関連情報（地域ごとの情報、主要な顧客ごとの情報）と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（販売実績）に基づく。",
        "asOf": "2025-12-12",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
