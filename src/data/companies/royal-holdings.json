  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営ビジョン2035として「食とホスピタリティで、地域と社会を笑顔にする」を掲げ、中期経営計画2025～2027の基本方針「変革から成長、そして飛躍へ」のもと、ブランド戦略、グローバル戦略、サステナビリティ戦略、人材戦略の四つの全社戦略を推進します。",
        "asOf": "2026-04-06",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ロイヤルホスト、てんや、シズラー、シェーキーズなど複数の飲食ブランドを持ち、空港や高速道路、病院などの施設内での飲食、ホテル、食品の製造と物流までをグループ内で手がけています。",
        "basis": "【事業の内容】及び【セグメント情報】の記載",
        "asOf": "2026-04-06",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外食事業は、2025年12月期の外部顧客への売上高65,951百万円で、最も大きな報告セグメントです。ホテル事業は41,266百万円で、外食事業に次ぐ規模です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-04-06",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
