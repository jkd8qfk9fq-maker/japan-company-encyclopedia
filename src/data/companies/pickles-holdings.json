  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「おいしくて安全、安心な商品を消費者にお届けし、同時に地球環境に配慮した企業経営を目指します」です。安全でおいしい製品を作るための品質管理、地球環境に配慮した企業経営、従業員のモラルアップと安全・健康を第一とした職場づくりを経営方針とし、中長期の取り組みとして製品開発の強化、西日本エリアを中心とした販売エリアの拡大、ドラッグストアなどへの販売先の拡大、外食・小売や農業などの新規事業への取り組みを進めています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点は、浅漬、キムチ、惣菜の新製品開発やリニューアルと、西日本エリアでの拡販、新しい売場や業務用への販売先拡大を組み合わせることにあります。あわせて、原料野菜の契約栽培の拡大や生産体制の見直しによるコストの見直し、冷凍食品など新しい分野の商品開発も進める方針です。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営戦略等と優先的に対処すべき事業上及び財務上の課題の記載",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、全国を網羅した生産・物流体制、食の安全・安心への取り組み、独自性の高い開発提案力、販売先のニーズに対応するベンダー機能です。浅漬やキムチの主要原料である白菜、胡瓜等には国産を使い、食品安全の規格であるJFS-Bと環境管理の国際規格であるISO14001に基づいた管理を行っています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境の記載と事業の内容の記載",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "漬物製造販売事業の単一セグメントで、2026年2月期の売上高40,923百万円の内訳は製品（漬物・キムチ・惣菜他）28,923百万円と商品（漬物他）12,000百万円です。主な相手先である株式会社セブン－イレブン・ジャパンへの売上高は6,999百万円でした。漬物市場全体は1990年代をピークに縮小傾向にあるなかでの事業展開です。",
        "basis": "セグメント情報の単一セグメントの記載、収益認識関係の収益を分解した情報、主要な顧客ごとの情報、MD&Aの経営成績の概要と経営環境の記載",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
