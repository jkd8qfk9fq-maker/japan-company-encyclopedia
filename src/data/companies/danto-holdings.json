  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "自社工場生産によるブランド「A.a.Danto」を中核に、商業施設・店舗・オフィス分野を中心としたインテリア市場でのシェア拡大を成長の軸とし、不動産事業では運用資産残高の積み上げによる安定収益の確保と新規事業の事業化、発電機事業では製品ラインナップの拡充、再生可能エネルギー事業では蓄電施設の開発と運営の本格化を進める方針です。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、タイル事業のインテリア市場への展開と、不動産・発電機・蓄電池の各事業による収益源の重層化に置かれています。",
        "basis": "経営戦略に、タイル事業ではインテリア市場でのシェア拡大を成長の軸とすること、不動産・発電機・再生可能エネルギー各事業の取り組みを進め、重層的な収益源の確保に取り組むことが記載されています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "明治初頭以来タイルづくりに取り組み、長年培ってきた独自の技術を活かして、タイルに関するトータルサービスを提供することを掲げています。自社工場生産によるブランド「A.a.Danto」は海外を中心に評価を高め、国内外で複数のデザイン賞を受賞しています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
