  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月に2027年度までの3か年中期経営計画を策定し、規模拡大に加えて収益性を重視する「利益重視経営」を推進しています。経営戦略として、開発・製造・営業の一体運営による効率化とコスト構造の最適化、日本で培った高品質・高機能製品の世界展開と地産地消の供給体制の強化、次世代医療領域への取り組み、選択と集中による経営資源の重点配分を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "透析関連ではダイアライザを大館工場などで自社生産し、海外での透析センターの運営や大手透析プロバイダーとの提携まで含めた供給体制を持っています。医療機器から医薬品の受託製造、医薬品用ガラス容器までをグループで担い、海外にも製造拠点と販売拠点を広く置いている点が特徴です。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の事業概況",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、医療関連が523,615百万円で全体の約8割を占め、医薬関連が81,107百万円、ファーマパッケージングが54,687百万円と続く構成です。地域別では日本が321,116百万円、アメリカが132,523百万円、アジアが108,437百万円、ヨーロッパが98,461百万円です。",
        "basis": "セグメント情報および関連情報（地域ごとの情報）（2026年3月期）",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
