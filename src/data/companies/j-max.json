  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年3月期から中長期5か年計画「J-VISION 30」を進めています。「既存事業の強化」と「新事業の創出」を成長戦略の2本柱とし、ビジョンに「技術で夢を -Make our dreams by Technology-」を掲げて持続可能な100年企業を目指すほか、電動化・軽量化に集中した電動化サプライヤーへの転換を図っています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "計画3年目にあたる2026年3月期は、日本の岡山工場と中国・福建省の新拠点が稼働し、中国で車載電池メーカー向け電動化部品の増産が進みました。一方で、主要な経営指標の目標到達は当初の予定から3年程度後ろ倒しになる見込みとされています。",
        "basis": "経営方針の中長期的な会社の経営戦略、MD&Aの経営成績等の状況の概要、セグメント情報",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "車体プレス部品では、自動車メーカーとの共同開発から生産設備の調達、プレス、溶接までの一貫生産を行い、創業以来培ってきた金型技術を基盤としています。冷間プレスによる超ハイテン加工技術を電動化部品へ応用し、車載電池関連部品の開発・量産化を進めています。",
        "basis": "事業の内容の日本セグメントの説明、経営方針の対処すべき課題、サステナビリティに関する考え方及び取組の技術戦略",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、中国が26,893百万円で最も大きく、日本が19,091百万円、タイが5,934百万円です。主要な顧客ごとの情報には東プレ株式会社、寧徳時代新能源科技股份有限公司、広汽本田汽車有限公司、東風本田汽車有限公司が開示されており、本田技研工業株式会社は事業の内容で主要な取引先とされています。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、事業の内容",
        "asOf": "2026-06-25",
