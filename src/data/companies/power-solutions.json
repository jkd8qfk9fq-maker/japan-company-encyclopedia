  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度を初年度とする３ヵ年の中期経営計画では、この３年間を「変革期」と位置づけ、ソリューション提供の方法を「つくる」から「つかう」へシフトします。重点施策は、既存顧客との取引拡大、新規顧客獲得（顧客基盤の拡大）、人員の増強と顧客単価の向上、コンサルティング領域への進出の４つです。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客と直接取引するプライム案件が中心で、2025年12月期のプライム案件の売上高比率は95.2％です。また、2024年12月期に受注実績のあった取引先64社のうち57社が2025年12月期も継続しており、取引継続率は89.1％、2025年12月期の新規取引先は17社でした。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、2025年12月期のプライム案件売上高比率が95.2％である旨、既存取引先64社のうち57社が継続し取引継続率が89.1％である旨、新規取引先が17社である旨が印字されていることに基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "野村グループ各社への売上高が、2025年12月期の売上高の37.8％を占めています。内訳は野村アセットマネジメント株式会社が22.0％、株式会社野村総合研究所が4.2％、野村ホールディングス株式会社が3.5％などです。同社は、資産運用業界における投資信託残高の上位企業との取引実績が差別化要因の一つになると考えています。",
        "basis": "【事業等のリスク】に、野村グループに対する売上高の割合が2025年12月期で37.8％である旨と各社の構成比が印字されていること、【事業の内容】に、資産運用業界における投資信託残高の上位企業との取引実績が差別化要因の一つである旨が印字されていることに基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
