  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として『真心をこめて、暮らしに欠かせない文化と科学を提案することにより、豊かな社会づくりに貢献できる企業を目指します』を掲げています。第9次中期経営計画（オーベクスビジョン2027）では、ESG経営を推進し新たな価値創出と持続可能な成長を追求することを基本方針とし、強固な収益基盤の構築、環境負荷低減活動の推進、成長を支える人財育成の3つを基本戦略としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "テクノ製品事業では高付加価値製品の開発と海外拠点の拡充を、メディカル製品事業では既存市場の拡販と海外展開の準備を進める方針です。",
        "basis": "中期経営計画における事業別の重点施策の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "微少な流量を制御するコア技術を基盤とし、帽子製造で培った繊維の加工技術をフェルトペン先やプラスチックペン先へ応用し、さらに医療機器へと広げてきました。ペン先の精密研削加工は国内の連結子会社と中国・天津の連結子会社が担い、製造と加工をグループ内で分担しています。",
        "basis": "経営方針におけるコア技術と技術の展開の記載、および事業の内容における連結子会社の役割の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
