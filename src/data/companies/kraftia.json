  "history": [
    {
      "year": 1944,
      "title": "九州電気工事株式会社を設立",
      "description": "1944年12月に、電気工事業整備要綱にもとづき、九州の主要電気工事業者13社が統合して、九州電気工事株式会社を設立しました。本社は福岡市に置きました。",
      "significance": "現在のクラフティアの出発点です。翌1945年にも2回、他の工事業者を統合しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1947,
      "title": "九州配電と配電工事委託契約を締結",
      "description": "1947年6月に、九州配電株式会社（現、九州電力株式会社）と配電工事委託契約を結びました。",
      "significance": "九州電力は、2026年3月31日現在で当社の議決権の22.6％を直接保有するその他の関係会社で、配電線工事は今も事業の柱の一つです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "空気調和・冷暖房・管工事の営業を開始",
      "description": "1964年7月に、空気調和・冷暖房・管工事の営業を始めました。",
      "significance": "電気工事に加えて空調管工事を手がけるようになった出来事です。1971年には水処理工事、1981年には公共下水道工事の営業も始めています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1971,
      "title": "東京証券取引所市場第二部に上場",
      "description": "1968年11月に大阪証券取引所市場第二部と福岡証券取引所市場に上場し、1971年11月に東京証券取引所市場第二部に上場しました。1972年9月には東京・大阪の市場第一部へ指定替え上場しました。",
      "significance": "九州の工事会社から、全国の取引所に上場する会社へ広がった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1989,
      "title": "株式会社九電工に商号変更",
      "description": "1989年12月に、九州電気工事株式会社から株式会社九電工へ商号を変更しました。",
      "significance": "2025年10月に株式会社クラフティアへ変わるまで使われた社名です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "シンガポールの工事会社の株式を一部取得",
      "description": "2013年5月に、シンガポールにあるASIA PROJECTS ENGINEERING PTE. LTD.の株式の一部を取得しました。同社は現在、連結子会社です。",
      "significance": "沿革に載る最初の海外の工事会社の取得です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2021,
      "title": "セントラル総合開発と資本業務提携契約を締結",
      "description": "2021年6月に、セントラル総合開発株式会社（現、持分法適用関連会社）と資本業務提携契約を結びました。同年9月には東京都の中央理化工業株式会社の株式を取得しました（現、連結子会社）。",
      "significance": "不動産事業と設備の保守事業を広げる動きです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行、監査等委員会設置会社へ",
      "description": "2022年4月に、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。同年6月には監査役会設置会社から監査等委員会設置会社へ移行しました。",
      "significance": "市場区分の再編と、会社の機関設計の変更が続いた年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "本社を移転し、株式会社クラフティアに商号変更",
      "description": "2025年5月に、本社を福岡市中央区天神一丁目のONE FUKUOKA BLDG.14階へ移転しました。同年10月1日に、株式会社クラフティアへ商号を変更しました。英訳名もKRAFTIA CORPORATIONになりました。",
      "significance": "2025年6月26日の第97期定時株主総会の決議にもとづく商号変更です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
