  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第15次中期経営計画（2023年4月1日から2026年3月31日）では、全社方針を「稼ぐ力を向上させ持続的に成長し社会に貢献する」と定め、「Back to Basics」として稼ぐ力の強化と財務体質の健全化、「Challenge for New」として戦略的な成長ビジネス機会の追求とサステナビリティ経営の構築に取り組みました。成長市場であるインドへの経営リソースの集中も掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "CAE技術を進化させた最適化設計により、サスペンションやサブフレームの大幅な軽量化や低コスト化、生産性向上を実現する設計開発力を強みとしています。当連結会計年度もホンダの「N-ONE e:」やゼネラルモーターズの大型SUV向け部品で成果を上げ、日本・北米・中国・フィリピンの研究開発部門が連携して受注を広げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【研究開発活動】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "自動車部品の専業メーカーで、生産と販売を日本・北米・アジアの3地域に広げています。売上高の約6割が本田技研工業グループ向けであり、特定の自動車メーカーとの結びつきが強い構造です。",
        "basis": "セグメント注記の主要な顧客ごとの情報（本田技研工業株式会社及びそのグループ会社向け売上高187,719百万円、2026年3月期）と連結売上高291,866百万円、3つの地域別報告セグメントに基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
