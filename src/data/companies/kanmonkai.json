  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力事業である「玄品」の価値向上を目的としたブランドの向上を進め、これを基礎とした再成長・収益性向上に取り組むとしています。今後は、「玄品」の価値を磨き上げてとらふぐ及びその他食材への展開を進めること、とらふぐ料理業界でのシェア拡大と各店舗の収益性の向上、フランチャイズの日本全国及び海外への拡大を推し進めるとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、直営店舗の売上高が前期とほぼ同額にとどまる一方、本部の小売り・流通業界等への食材販売が伸びて全体の売上高が微増しており、店舗以外の販路の拡大が進んでいることが読み取れます。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "養殖事業者と連携し、水産物の冷凍から解凍までの一連の工程における特許技術などを活用して育成したとらふぐを主に使用しているため、とらふぐ相場が大きく変動した場合にもその影響を抑えることができます。また、「玄品」はとらふぐ料理業界で店舗数が最も多いと会社は説明しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "とらふぐ料理業界は、景気動向、とらふぐ相場、インバウンド旅行客に大きな影響を受けます。とらふぐは高級食材であるため、消費意欲の動向により来客数や客単価が左右されると会社は見ています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
