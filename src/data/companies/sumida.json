  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2035年にありたい姿として「Top Position in Multiple Niches」を掲げ、高資本効率・メガトレンド・新事業の3つの柱からなるニッチトップ戦略を推進しています。その道筋として中期経営計画2026-2028を掲げ、Schmidbauerとの相乗効果の創出や、各地域で営業・開発・製造を完結する地産地消体制の強化に取り組み、2028年度の売上収益1,650億円を目標としています。",
        "asOf": "2026-03-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "コイルの中核技術である巻線技術から素材・材料技術まで8つの要素技術を社内にそろえ、顧客ごとに異なる仕様のカスタム製品にワンストップで応える体制が強みです。創業以来の用途開発力と、アジア・欧州・北米で設計・製造・販売を完結できる地産地消体制も強みとしています。",
        "asOf": "2026-03-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上収益の約6割が車載関連で、インダストリー関連と家電関連が続きます。生産・販売はアジア・パシフィック事業とEU事業の2つの地域セグメントで構成され、中国やベトナム、ドイツなどに大きな生産拠点を持っています。",
        "basis": "セグメント情報の製品及びサービスに関する情報（車載関連85,415百万円／連結売上収益147,194百万円）と、MD&Aの「製品の用途として車載関連の構成比率が約6割」の印字",
        "asOf": "2026-03-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【セグメント情報】"
      }
    }
  },
