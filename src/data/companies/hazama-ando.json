  "history": [
    {
      "year": 1873,
      "title": "安藤庄太郎が「安藤方」として創業",
      "description": "安藤庄太郎が東京・神田松枝町で「安藤方」と称し、煉瓦建築を施工する建築業者として始めました。のちに安藤建設となる会社の起源です。",
      "significance": "現在の安藤・間の二つの源流のうち、建築を軸とする安藤建設側の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1889,
      "title": "間猛馬が福岡県門司で創業",
      "description": "4月、間猛馬の個人企業として福岡県門司に創業し、土木建築の請負を始めました。のちに特に大型土木を得意とする総合建設業者になりました。",
      "significance": "もう一つの源流である間組の出発点です。土木に強みを持つ現在の事業の背景になっています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1918,
      "title": "株式会社安藤組を設立",
      "description": "3月、株式会社安藤組を設立し、合名会社安藤組の営業譲渡を受けました。",
      "significance": "個人の請負から株式会社へと、安藤建設側が組織を広げた出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "社名を安藤建設株式会社に変更",
      "description": "3月、社名を安藤組から安藤建設株式会社に変更しました。この会社は1961年に東京証券取引所市場第二部へ上場し、1963年に市場第一部の指定を受けています。",
      "significance": "2013年の合併の一方の当事会社となった「安藤建設」の名称の由来です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2003,
      "title": "旧ハザマの会社分割で株式会社間組を設立し上場",
      "description": "10月1日、旧ハザマ(青山管財株式会社)が分割型分割(混合型)の新設分割を行い、建設事業部門の承継会社として設立されました。同月、東京証券取引所市場第一部に上場しています。",
      "significance": "現在の会社の法人としての直接の前身にあたる出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "間組と安藤建設が合併し安藤・間が発足",
      "description": "4月1日付で株式会社間組と安藤建設株式会社が合併し、株式会社安藤・間が発足しました。本店は港区赤坂六丁目1番20号へ移転しました。",
      "significance": "土木に強い間組と建築に強い安藤建設が一つになり、現在の会社の形ができた出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。5月には本店を港区東新橋一丁目9番1号へ移転しています。",
      "significance": "現在の上場区分と本店所在地の経緯です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
