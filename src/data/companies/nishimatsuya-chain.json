  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針は、日常のくらし用品を気軽に、自由に、お客様に満足される品質の商品を、どこよりも低価格で最も便利に提供することによって、社会生活の向上に寄与することです。2031年2月期を達成年度として、売上高2,700億円の中期目標を掲げています。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "手ごろな価格とお客様の立場に立った品質を備えたプライベートブランド商品の開発と、全国47都道府県に広がる標準化された店舗網により、ベビー・子供用品を買いやすい価格と品揃えで提供しています。",
        "basis": "プライベートブランド商品の開発を重点政策とし、全国47都道府県に1,181店舗を展開していることが有報に記載されています。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ベビー・子供の生活関連用品の販売事業の単一セグメントで、商品別では育児・服飾雑貨の売上高が112,650百万円と最も大きく、国内の店舗販売が中心です。",
        "basis": "単一セグメントであることと、商品別の販売実績が有報に記載されています。",
        "asOf": "2026-05-13",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
