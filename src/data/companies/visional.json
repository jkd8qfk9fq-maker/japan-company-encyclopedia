  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「新しい可能性を、次々と。」をミッションとし、主力サービス『BizReach』を含むHR Tech領域でのさらなる事業成長とともに、社会的課題を捉えた新規事業の継続的な創出、国内外の有望な企業への投資とノウハウ提供を通じて、事業領域の拡大と企業価値の向上を図る方針です。",
        "asOf": "2026-10-21",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "強みとして、スカウト可能な353万人以上（2026年7月末時点）のプロフェッショナル人材のデータベースと約17年間のデータ蓄積に生成AI技術を掛け合わせたマッチング、『BizReach』と『ビズリーチ・キャンパス』『スタンバイ』などキャリアの各ステージを担うサービスラインナップ、『BizReach』のフロー型収益と『HRMOS』シリーズのサブスクリプション型収益を組み合わせた収益構造の多様化、幅広い領域で新規事業を生み出す創出能力を挙げています。",
        "asOf": "2026-10-21",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年7月期の売上高99,300百万円の内訳は、セグメント別の外部顧客への売上高でHR Techが93,807百万円、Incubationが5,488百万円です。HR Techの内訳は、BizReach事業が80,126百万円、HRMOS事業が9,289百万円、その他が4,391百万円です。本邦の外部顧客への売上高が売上高の90％を超え、売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の外部顧客への売上高と収益の分解情報、関連情報の地域ごとの情報・主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-10-21",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
