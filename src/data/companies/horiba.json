  "history": [
    {
      "year": 1953,
      "title": "堀場製作所を設立",
      "description": "創業者の堀場雅夫が1945年10月に創設した「堀場無線研究所」を前身として、1953年1月に設立された、分析計の専門メーカーです。本社は京都市中京区に置かれました。",
      "significance": "現在まで続く、測る・分析する機器づくりの出発点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1965,
      "title": "自動車排ガス測定装置の販売を開始",
      "description": "1965年11月に自動車の排ガスを測る装置の販売を始めました。",
      "significance": "現在のエネルギー・環境事業の自動車関連につながる製品です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1971,
      "title": "大阪証券取引所市場第二部などに上場",
      "description": "1971年3月に大阪証券取引所市場第二部と京都証券取引所に株式を上場しました。1974年3月には東京証券取引所市場第二部にも上場し、1982年9月に東京・大阪の市場第一部銘柄に指定されました。",
      "significance": "株式を公開して事業の拡大を進める土台ができました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "ドイツに現地法人を設立",
      "description": "1972年6月に欧州事務所を発展的に閉鎖し、現地法人のホリバGmbH（現 ホリバ・ヨーロッパ社）をドイツに設立しました。翌1973年4月にはアメリカにも現地法人を設立しました。",
      "significance": "海外に自前の拠点を持つ展開が始まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "フランスのABX社を買収",
      "description": "1996年6月にフランスのABX社（現 ホリバABX社）を買収しました。1997年9月にはフランスのインスツルメンツ社（現 ホリバ・フランス社）も買収しました。",
      "significance": "血液検査装置と分光分析の分野で、欧州の技術と拠点を取り込みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "ドイツのシェンク・ペガサス社などを買収",
      "description": "2005年9月に、ホリバ・ヨーロッパ社がドイツのSchenck Pegasus GmbHを、アメリカのホリバ・インターナショナル社がアメリカのSchenck Pegasus Corporationを買収しました。韓国の同名会社やシェンク東京衡機株式会社も買収しました。",
      "significance": "自動車の試験システムを品ぞろえに加える動きでした。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "イギリスのMIRA社から自動車開発の試験事業を買収",
      "description": "2015年7月に、HRA International Ltd.（現 ホリバMIRA社）が、イギリスのMIRA Ltd.から自動車開発全般に関するエンジニアリング・試験事業を買収しました。",
      "significance": "測定機器の販売に加え、車両開発のエンジニアリングも手がけるようになりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "水質・液体分析機器事業を堀場アドバンスドテクノへ承継",
      "description": "2017年1月に、株式会社堀場アドバンスドテクノが当社から水質・液体分析機器事業を引き継ぎました。",
      "significance": "事業ごとに子会社が担う体制が進みました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "ローム社から微量血液検査システム事業を買収",
      "description": "2018年12月にローム社から微量血液検査システム事業を買収しました。",
      "significance": "医用分野の製品を広げました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "アメリカのプロセス・インスツルメンツ社を買収",
      "description": "2023年10月に、HII PE Corp.（アメリカ）がProcess Instruments, Inc.（アメリカ）を買収しました。同年12月にはホリバ・インスツルメンツ社に統合されました。同年4月には、堀場アドバンスドテクノがフランスのTethys Instruments SAS.も買収しています。",
      "significance": "プロセス計測の分野で、北米と欧州の拠点を増やしました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "韓国のEtaMax社を買収",
      "description": "2025年4月に、堀場エステック・コリア社がEtaMax Co., Ltd.（韓国）を買収し、同年7月に統合しました。",
      "significance": "半導体向け事業を担う堀場エステックグループの韓国拠点が強まりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    }
  ],
