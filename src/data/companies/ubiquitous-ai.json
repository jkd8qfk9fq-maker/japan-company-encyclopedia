  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年6月に公表した中期経営計画（2026－2028年度）では、既存事業による成長と連続的なM&Aによる成長の両輪で成長を志向するとしています。既存事業では生産性向上、営業力強化、グループシナジーによるアップセル・クロスセルなどを重点施策とし、M&AではIoT関連、Big Data/AI関連、IT関連の領域で案件ごとに積極的に実行するとしています。あわせて、グループとしての運営効率化や品質マネジメント、ガバナンスの強化にも取り組むとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発の高速起動ソフトウェア『Ubiquitous QuickBoot』は2026年2月に累計出荷数が1億本を突破しています。自社製品を開発する力と、世界中の優れたソフトウェアを発掘して国内に展開する力、受託開発の力という3つのアプローチを組み合わせ、顧客のソフトウェアニーズに幅広く対応できる体制が特徴です。",
        "basis": "【事業の内容】における製品の記載、【沿革】における出荷実績の記載、及び人材戦略に関する基本方針における3つのアプローチの記載に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要顧客である電子・電気機器を製造・開発する大手企業の企画・開発・設計部門から学術・政府機関まで、幅広く強固な顧客基盤を有すると会社は述べています。組込みソフトウェアの取扱いでは、国内での取扱い製品数でNo.1ベンダーを目指すグループブランドを2017年に立ち上げています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】における対処すべき課題の記載と【沿革】の記載に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
