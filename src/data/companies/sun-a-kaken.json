  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業以来培ってきたラミネート技術、コーティング技術、フィルム多層押出し技術の3つの生産技術（コア・テクノロジー）を絶えず進化させ、新技術の開発を推進するとともに、魅力ある製品のラインアップ拡充と高付加価値製品の開発・拡販を推進し、収益基盤の安定化を図る方針です。あわせて徹底したコスト削減を実施し、価格競争力と収益力の強化に努めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "部門別には、軽包装材料では電子レンジ対応食品包材「レンジＤｏ！」のアイテム拡充とレトルト食品・介護食分野への拡販、産業資材ではシノムラ化学工業との設備・人員の最適化、機能性材料では譲り受けた保護フィルム事業と既存事業とのシナジー創出に取り組む方針が示されています。製品価格の適正化や設備の統廃合を含む合理化も進めるとしています。",
        "basis": "セグメント情報の報告セグメント別売上高、【経営方針、経営環境及び対処すべき課題等】の経営戦略等・優先的に対処すべき事業上及び財務上の課題、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ラミネート、コーティング、フィルム多層押出しの3つの生産技術を組み合わせる複合化技術により、紙、プラスチック、金属箔などの素材の特性を活かした製品づくりを行っています。顧客密着型の開発体制も強みとして掲げられています。",
        "basis": "【事業の内容】、【経営方針、経営環境及び対処すべき課題等】の経営方針・経営戦略等、セグメント情報の報告セグメントの概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "軽包装材料は国内市場が人口減少で大幅な拡大は見込みにくく競争が激しい一方、高齢化で医薬品・医療用包材の需要は増加傾向にあります。産業資材は顧客の最終製品の多くが国内で飽和状態に近く、機能性材料はスマートフォンなどの高機能化に伴う技術開発競争が激化しています。売上高の9割超が国内顧客向けです。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）、【経営方針、経営環境及び対処すべき課題等】の経営環境、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要",
        "asOf": "2026-06-25",
