  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年4月から3か年の中期事業計画「サイボー中期ビジョン2028」を始めます。テーマは「繊維事業の高付加価値領域の育成・拡充」「不動産活用事業の安定収益基盤の維持・強化」「各事業における新たな取組みへの挑戦」です。繊維事業では、環境配慮糸や機能性商材の拡販、ユニフォームの提案商材の拡大、プリント加工品の新規顧客開拓、防災用テントなどの取扱い強化を進めます。不動産活用事業では、2つの大型商業施設の設備の改修・改善を続け、イオンモール株式会社と連携して魅力ある建物として併存させるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "人口が密集する住宅地に近い川口市に、大規模な商業施設を2つ所有して賃貸していることが、不動産活用事業の安定した賃貸収入の基盤になっています。",
        "basis": "【主要な設備の状況】に、イオンモール川口前川とイオンモール川口が商業施設として賃貸されていることが印字され、【経営方針、経営環境及び対処すべき課題等】に、両施設が需要圏内でも大規模な商業施設であり、人口が密集する住宅地や幹線道路への近接性に優れると印字されています。【重要な契約等】にはイオンモール川口前川の賃貸借契約（2007年11月21日から2027年11月20日まで）が印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "祖業の繊維事業が売上高の約半分を占め、大型商業施設の賃貸を行う不動産活用事業が約3割を占める事業構成です。",
        "basis": "セグメント情報等の注記に、2026年3月期の外部顧客への売上高として繊維事業4,977百万円、不動産活用事業3,489百万円、合計10,349百万円が印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
