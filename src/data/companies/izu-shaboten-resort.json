  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "各施設の充実と営業力の強化、イベントによるPRなどで知名度を高めて入園者数の増加を図るとしています。アニタッチ事業については、2029年3月期までに現在の倍の店舗数となる12店舗を目指すとしています。ホテル事業では、2023年4月にオープンしたSKY-HILL HOTEL伊豆高原の認知度を高め、グランピング施設ではレジャー事業の施設との協業を進めるとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "伊豆半島の動物公園を中心とするレジャー施設に、都市部など全国6カ所の動物ふれあい施設と、公園に隣接する宿泊施設を組み合わせ、来園者を相互の施設へ送り合える体制を持っています。前年は240万人を超える来園者があり、宿泊施設は動物公園の隣地という立地を生かしています。",
        "basis": "経営方針に、前年240万人を超えるお客様にご来園いただいたこと、アニタッチ事業は全国6カ所の施設であること、ホテル事業の伊豆シャボテンヴィレッジは伊豆シャボテン動物公園の隣地に位置し、レジャー事業施設との協業を図る方針が印字されていること",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
