  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "市場規模が大きい診断用医薬品市場への本格参入、海外における研究用試薬市場の拡大、医薬品シーズ関連の開発コストの選択と集中、不採算事業の黒字化に取り組み、収益の拡大と財務の安定化を目指すとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "44年以上にわたって蓄積した抗体作製のノウハウに加え、高感度ゲルろ過高速液体クロマトグラフィーを用いた血中リポタンパク質の詳細プロファイリング技術と、遺伝子組換えカイコの繭にタンパク質を産生させる技術を持つことが強みです。",
        "basis": "経営方針における、44年以上抗体を開発し抗体作製のノウハウが蓄積されコア技術として確立されている旨の印字と、事業の内容におけるLipoSEARCH®とＴＧカイコサービスの技術の印字に基づく。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "製品開発型のバイオベンチャーとして、抗体試薬と体外診断用医薬品の領域で研究機関や製薬企業向けに事業を展開し、自社で創製した抗体医薬品候補の権利を製薬企業へ供与する取り組みも進める事業者です。",
        "basis": "研究開発活動における製品開発型のバイオベンチャー企業としての位置付けの印字と、事業の内容における医薬シーズライセンス導出事業の印字に基づく。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
