  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ダイレクトメールの発送代行及びインターネット広告により広告主とエンドユーザーを「つなぐ」ことで業容・サービスを拡大してきたとし、今後の持続的な成長のため、広告主のニーズを的確にかつ迅速に把握した付加価値の高いサービスの継続的な提供及び新たな収益源の構築に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は25,560百万円と前期比20.8％増で、全体の約9割を占めるダイレクトメール事業が牽引しました。同事業では宅配便等の小型貨物を扱うフルフィルメントサービスの体制強化が進められ、2025年6月に八王子第6フルフィルメントセンターが開設されています。一方、インターネット事業の売上高は前期比10.1％減でした。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメントごとの経営成績の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ダイレクトメール事業では、デザインを行うクリエイティブ室、発送業務を行うメールセンター、預託商品の保管も行うフルフィルメントセンターを自社内に有し、工程ごとに別々の会社へ発注していた作業を一括管理することで、工程間のタイムロスや中間マージンの排除を実現していると説明されています。インターネット事業でも、Webコンサルティングからコンテンツマーケティング、運用型広告、Webサイト制作までを自社サービスとしてワンストップで提供できる体制が整っているとしています。",
        "basis": "事業の内容におけるダイレクトメール事業とインターネット事業の説明と、経営方針、経営環境及び対処すべき課題等における対処すべき課題の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のダイレクトメール広告費は縮小傾向にあると事業の内容に示されるなかで、同社のダイレクトメール事業の取引社数は2023年3月期の4,941社から2026年3月期の5,746社へ増えています。2026年3月期は、主要な顧客として株式会社大和心向けの売上高が連結売上高の12.2％を占めたと開示されています。",
        "basis": "事業の内容におけるダイレクトメール広告費と取引社数の推移の記載と、セグメント情報の関連情報における主要な顧客ごとの情報に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
