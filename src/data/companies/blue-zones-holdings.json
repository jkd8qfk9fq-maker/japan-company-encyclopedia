  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションは「地域のお住まいのすべての方が、健康に毎日を楽しめる世界（ブルーゾーン）を実現する」、ビジョンは「地域の共通資本（コモンズ）になる」です。第11次中期経営計画（2025年3月期～2027年3月期）では「グループでより強くなる」をメインテーマに掲げ、ライフスタイル業態とディスカウント業態の各社が自律的な成長を果たすことで商圏シェアの向上を図っており、長期の数値目標として「500店舗、売上高1兆円」を掲げています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中核のヤオコーは埼玉県を中心に関東で202店舗を展開し、小商圏で高頻度に来店してもらう食品スーパーとして、地域ごとに異なるニーズへきめ細かく対応しています。加えて、圧倒的な低価格とローコスト運営を掲げるエイヴイやフーコットなど、異なるビジネスモデルを持つ会社が同じグループにそろっていることが特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略と、MD&A に載る会社別の店舗数（2026年3月31日現在）",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "食品を中心としたスーパーマーケット事業の単一セグメントで、2026年3月期の連結売上高は783,434百万円、店舗数は2026年3月31日現在でグループ全体276店舗です。部門別では生鮮食品が連結売上高全体の33.7％と最も大きな割合を占めています。",
        "basis": "セグメント情報（単一セグメント）と、MD&A の販売実績（部門別の売上高と構成比）・店舗数",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
