  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「水を通じて健康づくりに貢献する」という経営理念のもと、スイミングスクール事業を「教育」として専門性の高い指導で差別化し、会員集客の強化とＭ＆Ａ戦略を軸とした成長投資を進める方針です。直営事業所では会員数1,000名程度のコンパクトタイプ施設の展開を進め、年間２事業所程度の出店を計画しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業以来の指導経験を織り込んだ指導教本や水中健康運動教本などの独自の指導プログラムを持ち、住宅地を中心とした事業所展開で直営64箇所・受託20箇所を運営しています。",
        "basis": "【事業の内容】に、指導教本及び水中健康運動教本等の創業以来の指導経験を織り込んだ各種マニュアルや教本に基づく指導プログラムと、住宅地中心の事業所展開により事業所数を増やしてきた旨が印字されている。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "スイミングスクール運営企業として唯一の上場企業であり、業界最大と自社を位置づけています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に「業界最大にして唯一の上場企業」と印字され、MD&Aの人材戦略にもスイミングスクール業界で唯一の上場企業である旨が印字されている。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
