  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "次期の経営方針を「今を革新し、未来へ」とし、写真館事業においてお客様視点で新たな考え方や技術を取り入れ、新しい価値を生み出して変革するとしています。中長期的な経営戦略では「選択と集中」を掲げ、写真事業ではマタニティ・赤ちゃん撮影、七五三撮影、出張撮影を推進し、成長基盤である成人振袖レンタル事業と今後の成長基盤となるスクールフォト事業へ経営資源を投入すること、衣装製造卸売事業では京都府京丹後市の工場を閉鎖し、その機能を中国現地法人の工場に統合することを示しています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の99.6％を写真事業が占め、衣装製造卸売事業の外部顧客への売上高は133百万円と小さいため、経営資源は写真事業に集中する構成です。衣装製造卸売事業はグループ内への衣装供給を担い、写真事業の撮影サービスを支える役割にあります。",
        "basis": "セグメント情報の報告セグメントごとの外部顧客への売上高、事業の内容、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "こども写真館を全都道府県に展開し、撮影から写真の制作・加工、衣装の製造までをグループ内で一貫して担う体制を持ちます。研修センターを設けて新人教育を行うなど、店舗で働く人材の育成体制づくりにも取り組んでいます。",
        "basis": "事業の内容、沿革、関係会社の状況、主要な設備の状況",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "経営環境として、少子化の更なる進行や競合店の増加による競争激化により成長が鈍化しつつあるとの認識が示されています。こども写真館は2026年2月期末で407店舗を展開し、売上高の99.6％が写真事業によるものです。",
        "basis": "経営方針、経営環境及び対処すべき課題等、セグメント情報の報告セグメントごとの外部顧客への売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
