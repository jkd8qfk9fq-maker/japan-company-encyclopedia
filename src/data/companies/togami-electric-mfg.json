  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念『社会を、地球を、未来を豊かに。』のもと、配電・制御機器の総合メーカーとして、事業活動を通じた社会課題の解決により持続可能な社会の実現と中長期的な企業価値の向上に取り組む方針です。2025年3月に創立100周年を迎え、スローガン『さぁ　挑もう　つくろう　かえていこう』のもと、次の100年に向けた新たな一歩を踏み出しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、電力会社における次世代型への更新や配電設備の強化の動きが続き、電子制御器、配電用自動開閉器、配電盤及びシステム機器の需要が好調に推移しました。当社グループはDX推進等による生産性や品質の向上、主力製品の継続的なコストダウン、販売価格の適正化に取り組んでいます。",
        "basis": "MD&Aの経営成績等の状況の概要（セグメント別の経営成績の説明）及び【経営方針、経営環境及び対処すべき課題等】",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1925年の創業以来、配電用自動開閉器及び配電システムの専門メーカーとして長い歴史と高い技術力を持ち、高品質の配電用機器を送り出すリーディングカンパニーを自負しています。主力の波及事故防止機器（SOG開閉器）など、配電設備に組み込まれる機器を自社で製造し、電力会社との継続的な取引関係を築いています。",
        "basis": "【事業等のリスク】（特定セグメントへの依存について・価格競争について）、【沿革】及びMD&Aの製品区分別の説明",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期のセグメント別外部売上高では、産業用配電機器事業が25,629百万円と連結売上高の8割超を占めます。本邦の外部顧客への売上高が連結売上高の90％を超える国内中心の構成で、主要な顧客である中部電力パワーグリッド株式会社への売上高は3,234百万円（連結売上高の10.5％）です。",
        "basis": "セグメント情報（外部顧客への売上高）及び関連情報の主要な顧客ごとの情報・地域ごとの情報",
        "asOf": "2026-06-25",
