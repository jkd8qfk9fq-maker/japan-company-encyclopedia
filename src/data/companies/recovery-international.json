  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "『もう一人のあたたかい家族』を理念に掲げ、在宅での看取りを増やすこと、利用者様の健康寿命を延伸すること、医療従事者がいきいき働ける職場環境を提供することを使命としています。訪問看護ではドミナント戦略による拠点展開と人材確保・育成に取り組み、連結子会社のRePath株式会社による人材紹介で採用プロセスの垂直統合を図るとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高2,689百万円のうち訪問看護サービス事業が2,597百万円を占め、収益の中心は訪問看護です。2025年3月にRePath株式会社が有料職業紹介事業等を譲り受けたことで、人材紹介が新たな事業として加わりました。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "病院等特定の系列に属さない独立型であるため、医療機関や居宅介護支援事業所など地域の連携先と柔軟に連携できる体制です。訪問実績や地理等のデータを組み合わせて訪問エリアを設定し、事務処理を本社でクラウド管理するなど、ITの活用による効率化を進めています。訪問看護未経験者の採用と育成プログラムにより、看護師等の早期戦力化も図っています。",
        "basis": "【事業の内容】の記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "訪問看護の利用者数と訪問看護費は増加傾向にあり、市場は拡大していると会社は述べています。一方で業界は小規模な事業所が多く、訪問看護師の不足が課題とされています。同社は東京都を中心に訪問看護ステーション5拠点とサテライト31拠点を展開しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】と【事業の内容】の記載に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
