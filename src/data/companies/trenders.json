  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業ドメインを従来の「SNSマーケティング」から「SNS×リテールマーケティング」に発展させ、美容カテゴリだけでなくより幅広いカテゴリの顧客企業に、より付加価値の高いサービスを提供するとしています。SNSマーケティングと、連結子会社の株式会社zenplusが展開するイベント事業、しるし株式会社が展開するECコンサルティング事業を掛け合わせ、商品を「知る」「体験する」「購入する」をつなぐリテールマーケティング企業としての成長を目指すとしています。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "流行に敏感な女性を組織化した生活者の母集団をもとにマーケティング調査を行うサービスから出発した経緯があり、美容領域の知見と、美容メディア「MimiTV」の運営、自由診療クリニック向けの支援といった美容に特化した体制が強みです。",
        "basis": "【沿革】に、流行に敏感な女性を組織化し母集団に対してマーケティング調査を行う「女性に特化したマーケティング」サービスを開始したことが印字され、【事業の内容】に美容メディア「MimiTV」を含むマーケティング領域と、自由診療クリニックを支援するメディカル領域の体制が印字されています。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "拡大を続けるインターネット広告市場の中で、SNSを軸としたマーケティング支援を行う事業者です。主要な顧客である花王株式会社への販売実績は、2026年3月期の総販売実績の12.8％を占めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】にインターネット広告市場の規模と成長が印字され、セグメント情報の【関連情報】（主要な顧客ごとの情報）と販売実績に、花王株式会社への販売実績と総販売実績に対する割合12.8％が印字されています。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
