  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン『NR Vision 2035』を10年後の目指す姿とし、その第1ステップとして2025年度を初年度とする3年間の『中期経営計画2027』を推進している。グループパーパス『卓越した技術と誠実な施工でインフラを支え、安全・安心な社会と豊かな暮らしを未来につなぐ』のもと、安全第一、意識改革による会社・社会の発展、社員の働きがいを基本方針に掲げる。事業戦略では既存事業の収益力向上・深度化、多角化、グループ会社戦略を進め、DXや技術開発による生産性向上、環境戦略『REACH』による2050年カーボンニュートラルの達成への貢献にも取り組む。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【第一部 企業情報／第2 事業の状況／1 経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "鉄道の技術から発展した総合電気工事会社として、鉄道、道路、送電線、各種施設の電気・通信工事に専門性の高いコア技術とノウハウを蓄積している。東日本旅客鉄道をはじめとする主要顧客との強固な関係を基盤に、安全を経営の根幹として品質の維持・向上と技術の研鑽を続け、総合研修センターでの人財育成にも取り組む。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【第一部 企業情報／第2 事業の状況／1 経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期のセグメント別の外部顧客への売上高は、電気設備工事業70,482百万円、兼業事業3,164百万円、不動産賃貸事業397百万円で、連結売上高74,044百万円の大部分を電気設備工事業が占める。電気設備工事業の内訳は鉄道電気設備工事が最大で、送電線設備工事、道路設備工事、屋内外電気設備工事が続く。主要な顧客は東日本旅客鉄道で、売上高33,510百万円と連結売上高の45.3％を占める。海外売上高はない。",
        "basis": "セグメント情報等のセグメント売上高と主要な顧客に関する情報、関連情報（所在地別情報・製品及びサービス別情報）、経営成績等の状況における部門別の完成工事高に基づく分析",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
