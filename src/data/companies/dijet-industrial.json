  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "超硬工具を基盤として切削工具・耐摩耗工具・超硬合金を三本柱としてバランスのとれた営業力を維持強化し、各工具ともに新製品の開発と新分野開拓を積極化するとともに、最大のマーケットを持つ切削工具では需要家を広く求め、欧米・アジア各国等の海外マーケットへ注力して輸出比率の向上を図る方針です。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "合金から工具までの一貫製造を掲げ、開発・製造・販売の各部門が共同して顧客ニーズにタイムリーに応えることで業績を向上していく方針が読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、合金から切削工具・耐摩耗工具まで社内で一貫して製造するメーカーであり、開発・製造・販売の各部門が共同してタイムリーに製品提供することにより業績を向上していくことを目標とすると印字されていることによる。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "超硬合金の素材から工具の製造までを社内で一貫して行える点が特徴で、耐摩耗工具では高硬度と高強度を両立した自社開発の合金素材により、EVやHEV用電池ケース金型など従来の金型素材では対応しづらい分野で販路を広げています。",
        "basis": "経営成績等の分析に、当社独自の開発材料である高硬度・高抗折力合金素材が高硬度と高強度の両立を実現し、EVやHEV用電池ケース金型等の分野で成果を挙げ、販路を拡げていると印字されていることと、経営方針に合金から工具までの一貫製造が印字されていることによる。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "切削工具が売上高の82％を占める主力製品で、地域別では輸出が57.2％と国内を上回っています。機械工具業界では、当連結会計年度に機械工具の生産高が前年より増加したとされています。",
        "basis": "セグメント注記の関連情報の製品別外部売上高で切削工具が7,658百万円であることと、経営方針の経営環境に機械工具の生産高が前年より増加したと印字されていることによる。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
