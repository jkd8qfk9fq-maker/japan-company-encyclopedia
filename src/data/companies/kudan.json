  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コアソフトウェアを「空間知覚プラットフォーム」へ拡張し、デジタルツイン、ロボット、データ技術を統合したプラットフォームの展開を進めるとともに、高粗利ソフトウェアへの集中を通じて収益性の向上を図るとしています。フィジカルAI市場の拡大に合わせて、空間知覚を中核としたソフトウェア及びソリューションの提供を拡大し、中長期的な事業成長を目指すとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "SLAMを中核技術とし、自社の間接法SLAMとArtisense Corporationの直接法SLAMとのハイブリッド化に成功して基本性能を向上させたこと、技術を組み込んだ顧客製品の商用化が進み、Intel社のロボット開発プラットフォームへの本格採用が大手半導体メーカー向けの商用SLAM採用として重要な節目になったことが印字されています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、直接法と間接法のハイブリッド化に成功した旨と、Intel社のロボット開発プラットフォームへの本格採用が世界初の大手半導体メーカー向け商用SLAM採用として重要なマイルストーンとなった旨が印字されていることに基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "フィジカルAIの基盤技術である空間知覚に特化した研究開発型の会社です。連結従業員数は30人と小規模ながら、2026年３月期の売上高は前期から131.3％増の1,196百万円となりました。",
        "basis": "連結従業員数が2026年３月31日現在で30人である旨と、2026年３月期の売上高が1,196,972千円で前期比131.3％増である旨が印字されていることに基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
