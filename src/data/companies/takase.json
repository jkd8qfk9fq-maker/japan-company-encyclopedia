  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是として「ＡＤＤ ＳＹＳＴＥＭ」（物流システムの創造にたゆまぬ努力を続け、顧客に貢献すること）を掲げ、顧客目線を大切にしながら革新的なサービス開発と確実な業務の実行によって社会に貢献するとしています。中長期的な経営戦略では、2025年度から「既存事業の収益力強化と新たな収益構造を確立する」ことをテーマに、「足元の業績立て直し」「事業基盤の強化」「新たな事業領域・価値の創造」「骨太の収益構造の確立」に取り組むとしています。2026年度は、既存サービスのＣＯＬ（コンテンツクラウド＋オンデマンドプリント＋ロジスティクス）と医療機器物流を掛け合わせた新サービスの構築や、協業によるシナジーが見込める企業とのＭ＆Ａの検討などを掲げています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "営業収益の柱は総合物流事業8,410百万円で、連結営業収益8,491百万円のほぼ全てを占めます。運送事業と流通加工事業は主に総合物流事業向けの実運送と倉庫内作業を担うグループ内の分担であり、海外は米国・香港・上海の現地法人が総合物流事業を担っています。",
        "basis": "セグメント情報における事業別の外部顧客への営業収益と関係会社の状況における連結子会社の事業内容の記載に基づく",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "競争力の源泉は、東京・川崎の湾岸地区などに自社の倉庫施設を持ち、人の手によるきめ細やかな流通加工業務に機械やシステムを組み合わせて提供できる体制にあります。通関業の許可や認定通関業者（ＡＥＯ通関業者）の認定、医療機器製造業の免許など、取扱貨物の幅を広げる許認可も備えています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における強みの記載と、主要な設備の状況における自社倉庫施設の記載、および沿革における許認可の記載に基づく",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "物流業界では物価高や為替変動の影響が残り、人件費をはじめとするコスト上昇への対応が課題となる環境にあります。当社グループは営業収益84億91百万円の規模で、国内物流と国際物流の双方を手がけ、社会貢献度の高い分野への物流サービス提供や新規顧客の獲得を重点課題として位置づけています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境と重点課題の記載と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における記載に基づく",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
