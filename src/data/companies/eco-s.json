  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年2月期を最終年度とする中期経営計画（3カ年計画）では、「サステナブルな企業へ」をテーマに掲げ、商品改革、サービス力向上、人材育成、法令順守、従業員満足度の向上に取り組んでいます。社是は「正しい商売」です。",
        "asOf": "2026-05-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「安全・安心」「健康」「美味しさ」「鮮度」を重視した商品の提供と、地域に根ざした店舗づくりを掲げています。プライベートブランド「ナチュライブ」のラインナップ強化や、環境に配慮した商品の提供にも取り組んでいます。",
        "asOf": "2026-05-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の部門別売上高は、生鮮部門が65,163百万円、グロサリー部門が68,321百万円、物流部門が714百万円で、スーパー部門が全体の99.5％を占めます。売上はすべて本邦で、店舗数は137店舗です。",
        "basis": "MD&Aの部門別販売実績と、セグメント情報の関連情報（地域ごとの情報・主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-05-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
