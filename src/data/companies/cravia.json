  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョン「世界中の“好き”を加速する」を掲げ、主力のアンバサダー事業で培ったテクノロジーやノウハウとシナジーが期待できる新しい事業分野への取り組みを推進し、新たな収益源の確保を図るとしています。あわせて、コーポレートガバナンス体制の強化を最優先の課題とし、不適切な資金流用・会計処理への再発防止策の徹底に取り組むとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸はM&Aと新規事業による多角化です。2024年にEC小売を始め、幼児用教育材や旅行業の会社を子会社化し、2025年にはリユース事業を開始した結果、小売業がグループ最大の事業になりました。多角化した事業を有機的に結び、グループ内での相乗効果を高める段階へ移るとしています。",
        "basis": "【事業の内容】と【沿革】の子会社化・事業開始の記述、セグメント注記の事業別売上高の記述",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、アンバサダーのクチコミ効果を分析する独自のテクノロジーと、アンバサダーの行動によるビジネスへの貢献を分析するモデルなどのノウハウです。基幹システム「アンバサダープラットフォーム」に蓄積したデータをもとに、熱量が高く貢献度の高いファンを選んで企画を実施できる体制を持っています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の独自テクノロジーと分析モデルの記述、【事業の内容】のアンバサダープログラムの流れの記述",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
