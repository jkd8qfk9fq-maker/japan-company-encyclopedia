  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "サブスクリプション（月額課金）モデルの事業を中心に展開し、「ARR」の拡大を経営上の目標としています。継続的な顧客の獲得に加え、顧客の解約率の減少や、サービスの機能拡張のために必要な投資を積極的に行っていくことを経営戦略としています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "複数の集客サイトの予約管理を自動化する一元管理（サイトコントローラー）を理美容業界に先駆けて提供してきたことと、集客サイト・POSシステム・理美容ディーラーなどとのパートナーネットワークにより、店舗が導入済みのシステムを変えずに利用できることが強みです。",
        "basis": "【事業の内容】に、一元管理（サイトコントローラー）を理美容業界に先駆けて提供したリーディング企業であること、集客サイト・POSシステム・理美容ディーラーをはじめとする様々な企業との外部連携に対応し強力なパートナーネットワークを構築していること、2026年3月期のカスタマーチャーンレートが0.65％であることが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "理美容サービスのネット予約市場は拡大が続いており、経済産業省の調査では2024年に7,302億円まで広がっています。多くの理美容店舗が小規模な人数で運営され人手不足も深刻化するなか、予約や顧客対応をまとめて管理するシステムへの需要は今後も拡大していくものと会社はみています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、経済産業省「令和６年度 電子商取引に関する市場調査 報告書」による理美容サービスのネット予約市場が2015年の2,420億円から2024年には7,302億円となったこと、理美容業界では店舗間の競争激化と慢性的な人材不足が深刻化し、店舗経営の情報システム化が加速していることが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
