  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力のBtoBコマースサービスを軸として、ARPU・アクティブユーザー・顧客深耕の同時拡大を進めることで持続的な成長を目指すとしています。あわせて、段階的に３サービスのシナジーを強化し、統合プラットフォーム化していくことで、食産業における中核的なポジションを確立することを目指す方針です。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、BtoBコマースサービスの売上高が前期比16.0％増の6,348百万円となり、全体の増収をけん引しました。BtoCコマースサービスも前期比13.0％増えた一方、HRサービスは前期比13.8％減りました。",
        "basis": "MD&Aの経営成績の概要と【関連情報】の製品およびサービスごとの情報に依拠します。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は競争優位として、食品分野のEコマース化率が低くとどまる未踏市場の捕捉、大田市場の仲卸営業許可と豊洲市場の買参権を持つことによる参入障壁、生鮮食品のEコマースに対応した独自のITシステム、既存ユーザーの売上構成比が高いストック型ビジネスモデルを挙げています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "BtoBコマースサービスの売上高に占める既存コホート（前会計年度以前に登録したユーザー）の売上高割合は2026年３月期で92％と印字されており、利用が継続する構造が数値でも示されています。調達は大田市場・豊洲市場の中央卸売市場と、独自に開拓した全国の産地ネットワークを併用しています。",
        "basis": "【事業の内容】のBtoBコマースサービスの記述に依拠します。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "サービス別の売上高構成はBtoBコマースサービス81.2％、BtoCコマースサービス14.5％、HRサービス4.3％で、BtoBコマースサービスが中心です。2026年３月期は売上高の10％以上を占める特定の顧客がなかったため、主要な顧客ごとの情報の記載が省略されています。市場における順位やシェアは印字されていません。",
        "basis": "【事業の内容】のサービス別構成比と【関連情報】の製品およびサービスごとの情報・主要な顧客ごとの情報に依拠します。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
