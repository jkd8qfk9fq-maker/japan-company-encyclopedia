  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "海外事業へ重点的に経営リソースを投入すること、生産効率を重視した経営の徹底、顧客の声を直接反映できるDtoC事業への注力とブランド価値の向上、サステナビリティの取組みの加速、社員エンゲージメントの向上を、中長期的な経営戦略の重点課題としています。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "同じ特許技術について、国内向けには製品の製造販売、海外向けには主としてパーツの販売と製品化ノウハウの提供という、地域ごとに異なる売り方を組み合わせています。",
        "basis": "事業の内容に、国内向けはジュエリー・アクセサリー製品の製造販売、海外向けは主として「Dancing Stone」のパーツ販売と製造ノウハウの提供を行うことが記載されている事実に基づきます。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「Dancing Stone」は日本、米国、欧州、中国、香港、台湾、韓国など20の国と地域で特許権を取得しており、宝石に穴をあけずに揺らす仕組みを他社がそのまま使うことは難しい製品群を持っています。",
        "basis": "事業の内容に、「Dancing Stone」の特許権を取得した国と地域が列挙され、ダイヤモンドに穴をあけることなく揺らすことができる特許技術であることが記載されている事実に基づきます。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
