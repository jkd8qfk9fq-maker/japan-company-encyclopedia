  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「全人類の能力を全面開花させ、世界を変える」をミッションステートメント（経営理念）としてプラットフォーム事業を展開しています。優先的に対処すべき課題として、提供サービスの拡張及びコンテンツの充実、各プラットフォームの認知度向上、事業ポートフォリオの多様化（「mond」の開発・収益化と米国展開、M&Aの検討）、優秀な人材の確保・育成、社内管理体制の強化、技術革新への対応を挙げています。",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "新卒・若手社会人向けの採用プラットフォーム（LIFEプラットフォーム）という法人顧客からの収益を核に、個人ユーザーからの収益を得る「mond」の育成と米国展開で、収益源の多様化を進める組み立てになっています。",
        "basis": "経営方針に記載された優先的に対処すべき課題（事業ポートフォリオの多様化）の内容と、事業の内容に記載されたLIFEプラットフォームと「mond」の収益源の違いに基づく",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「外資就活ドットコム」の登録会員は難関大学に所属し外資系企業や入社難易度が高いとされる企業を志望する挑戦志向の高い層が中心で、会員の志望企業ランキングでは外資系コンサルティング会社や外資系金融機関が上位に登場するなど、他社競合サービスとは異なる傾向があるとしています。無差別に多数の求人情報を掲載せず、厳選した採用企業のラインナップとタイムリーで正確な募集情報を掲載する方針も掲げています。",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "就職活動を終えた「外資就活ドットコム」の登録会員を内定者向けコンテンツ等を通じて「外資就活ネクスト」へ誘導し、ネクストの登録会員の多くがドットコム出身者で占められる構造が、新卒から若手社会人までを一つの会員基盤でつなぐ仕組みになっています。",
        "basis": "事業の内容に記載された登録会員の特性と、「外資就活ドットコム」から「外資就活ネクスト」への会員誘導の仕組みに基づく",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
