  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期から2028年3月期までの3ヶ年を対象とする第12次中期経営計画「SGP2027（SUN-WA Growth Plan 2027）」を進めています。基本方針は、市場環境の変化に適合する事業構造改革、3つの成長戦略による収益力の強化、成長を支える投資と個別戦略の実施です。長期経営ビジョン「SUN-WA Vision 2030」の実現も掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "当社の競争優位は、幅広い商品群と技術知見を背景に、顧客ごとに最適なソリューションを提供する提案力にあり、その高度化を経営戦略の中核に据えているとしています。独立系技術商社として、提携メーカーとの協業により産業の振興に奉仕するとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【人材戦略に関する基本方針等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高148,329百万円のうち、電子コンポーネント部門が89,146百万円と約6割を占めています。海外の外部顧客への売上高はアジア40,005百万円、欧米5,788百万円で、売上全体の約3割が海外向けです。",
        "basis": "セグメント注記の外部顧客への売上高と、収益認識関係の製品及びサービスごとの分解情報に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
