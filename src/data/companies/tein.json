  "history": [
    {
      "year": 1962,
      "title": "前身の新日本繊業が設立",
      "description": "リボン、テープ等の繊維製品・半製品を製造販売（主に輸出）する目的で、東京都千代田区において新日本繊業株式会社が設立されました。",
      "significance": "現在のテインの母体となった会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1978,
      "title": "事業の継続を断念し休眠状態に",
      "description": "円高の進行で輸出が採算に合わなくなり、欠損金を抱えた新日本繊業は営業権を社員に譲渡して休眠状態に入りました。",
      "significance": "事業の存続が一度途絶え、後の再出発の前提となった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "株式会社テインとして再出発",
      "description": "市野諮が休眠状態にあった新日本繊業株式会社を譲り受け、商号を株式会社テインと改め、事業目的を自動車部品・用品の製造販売に変更して、横浜市で事業を始めました。",
      "significance": "現在のテインの実質的な創業です。サスペンション事業への進出の出発点となりました。",
