  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "カーアフターマーケット向けサスペンションの専門メーカーとして、「世界戦略に相応した品質、性能、価格の製品を作り上げ、カーアフターマーケット、プレミアム・リプレースメント市場におけるサスペンション事業」の拡大を目指すことを長期経営ビジョンとして掲げています。基本経営方針として、「セイフティー、ハイクオリティー、リーズナブルプライス」の商品を製造して新たな市場を創造すること、ユーザーの欲するものを欲するときに必要なだけ提供することなどを掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "開発を国内で自社で行い、国内工場と中国の工場で生産の役割を分け、北米、欧州、中国、アジア、オセアニアに販売子会社を持つことで、サスペンション専門メーカーとして開発から海外販売までをグループ内で一貫して担えることが特徴です。",
        "basis": "【事業の内容】に、開発は主に国内で当社が行うこと、製造は国内工場と中国工場が行い、中国工場はアジア地域を中心としたエントリーユーザー向けの製品を生産して国内工場と住み分けを図ること、地域ごとの販売子会社が列挙されていること",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
