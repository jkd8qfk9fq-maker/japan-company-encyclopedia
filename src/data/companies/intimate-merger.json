  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「データを用いて人々の意思決定を簡単にする」をミッションに掲げ、人手に頼る運用代行中心の事業から、AIや自動化ツールが力を発揮するためのデータ基盤そのものを提供する「インフラ提供型」へ移行する方針です。共通ID「IM-UID」の導入を広げるとともに、金融・セールス・HRなどの領域（X-Tech）へデータ活用を広げていくことも示しています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業以来蓄積してきたオーディエンスデータをもとに、ブラウザごとに割り当てるIDへ属性情報を集積したデータベースを持ち、3rd Party Cookieに依存しない共通ID「IM-UID」など、Cookieが使えない環境でもターゲティングができる技術を備えていることが特徴です。",
        "basis": "事業の内容に、IM-ID及びIM-UIDへ確定情報と類推情報を集積する仕組みと、IM-UIDやIM-CMPなど3rd Party Cookieに依存しない技術を開発してきた旨が印字されていること",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "DMP（データマネジメントプラットフォーム）市場において、国内導入シェアNo.1を達成しており、競合となる事業者は限定的であると説明しています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業等のリスク】"
      }
    }
  },
