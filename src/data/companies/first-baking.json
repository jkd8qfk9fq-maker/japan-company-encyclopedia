    {
      "year": 1955,
      "title": "第一屋製パン株式会社を設立",
      "description": "各種パン類、菓子類の製造並びに販売を目的として第一屋製パン株式会社を設立しました。なお、1961年12月に株式会社中屋へ吸収合併されましたが、社名は第一屋製パン株式会社とされ、経営の主体は従来からの第一屋製パン株式会社です。",
      "significance": "現在の会社の設立です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所市場第二部に上場",
      "description": "株式を東京証券取引所市場第二部に上場しました。",
      "significance": "株式上場です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1970,
      "title": "東京・大阪証券取引所の各市場第一部へ指定替え",
      "description": "東京証券取引所及び大阪証券取引所の各市場第一部に株式上場の指定替えを受けました。",
      "significance": "上場市場の移行です。",
