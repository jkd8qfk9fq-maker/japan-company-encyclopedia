  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「防ぐ」を合言葉に、すべてのユーザーへ安全・安心・快適・感動を提供し、持続可能な社会づくりに貢献することを経営ビジョンに掲げています。中期経営計画『TOYO ADVANCE ５』では、基幹事業の強化と企業品質向上、成長戦略と人的資本投資、サステナビリティへの取り組みを重点施策とし、フェーズフリー製品など競争力の高い成長戦略商品の開発強化を進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "製品・サービス別の売上高では重量シャッターと軽量シャッターの合計が売上高の41.7％を占め、シャッターが基幹であり、次いで修理・点検が5,366百万円と大きく、製造販売と保守サービスの組み合わせで収益を構成しています。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報）、MD&Aの経営成績の分析に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "シャッターに加えてスチールドアやドアノブ等の金物まで自社で製造する製品の幅と、製造販売に修理・点検サービスを組み合わせた体制が特徴です。フェーズフリー製品など成長戦略商品の開発にも取り組んでいます。",
        "basis": "【事業の内容】の事業内容、セグメント情報の関連情報（製品及びサービスごとの情報）、【経営方針、経営環境及び対処すべき課題等】の中期経営計画重点施策に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "シャッター業界は民間設備投資需要が堅調な一方、人手不足による建築案件のリスケジュールが多く、中・大型物件の受注競争が激しい環境にあるとされています。市場規模や市場シェアの数値は印字されていません。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記述、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
