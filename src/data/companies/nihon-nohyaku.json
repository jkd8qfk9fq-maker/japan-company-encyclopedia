  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョンに「Global Innovator for Crop & Life　食とくらしのグローバルイノベーター」を掲げ、2025年3月期から2027年3月期までの中期経営計画「Growing Global for Sustainability（GGS）」のもとで、サステナビリティ経営の推進を成長戦略としています。重点品目の拡販、アジア太平洋や中南米を中心とするエリア戦略に基づく市場拡大、原体製造の内製化による原価低減、生物農薬などバイオリソースの活用、スマート農業をはじめとするデジタル技術の活用に取り組んでいます。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "高い安全性と環境への配慮を兼ね備えた化学農薬や非化学農薬を創出することを掲げ、自社で開発を進めてきた新規有効成分シベンゾキサスルフィルは、日本と韓国で登録申請を完了しました。化学合成の研究開発は医薬品や動物用医薬品にも広げており、親会社の株式会社ADEKAとは資本業務提携に基づくシナジーの創出に向けた活動を進めています。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高111,822百万円のうち、農薬事業が105,455百万円と大半を占め、農薬以外の化学品事業は4,173百万円、その他は2,193百万円です。地域別では日本が33,366百万円、ブラジルが22,664百万円、その他地域が26,049百万円、米国が16,509百万円、インドが8,146百万円、アジアが5,085百万円となっています。外部顧客への売上高の10％以上を占める特定の顧客はありません。",
        "basis": "【セグメント情報等】の報告セグメントごとの外部顧客への売上高と、【関連情報】の地域ごとの売上高、主要な顧客ごとの情報によります。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
