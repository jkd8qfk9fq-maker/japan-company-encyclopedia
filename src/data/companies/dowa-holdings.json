        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "メキシコのロス・ガトス鉱山で操業を開始",
      "description": "2019年7月、メキシコで亜鉛鉱山（ロス・ガトス鉱山）の操業を始めました。1994年10月にはメキシコで別の亜鉛鉱山（ティサパ鉱山）の操業も始めています。",
      "significance": "製錬の原料となる鉱山の権益を海外に持つ例です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "国内の亜鉛関連子会社を秋田製錬に統合",
      "description": "2025年4月、国内の亜鉛事業に関連する子会社（秋田ジンクソリューションズ㈱、秋田レアメタル㈱、秋田ジンクリサイクリング㈱）を秋田製錬㈱に統合しました。同年10月にはDOWAエコシステム㈱熊本事業所の操業を始め、九州地区の環境・リサイクル事業を拡充しています。",
      "significance": "有報の沿革の最新の出来事です。亜鉛関連の会社を1社にまとめ、環境・リサイクルでは九州へ拠点を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
