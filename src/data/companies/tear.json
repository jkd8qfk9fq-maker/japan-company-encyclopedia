  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「新生ティアグループ」のスローガンのもと中期経営計画を策定し、ティアグループによる計画的な出店と既存エリアにおける営業促進の拡充、トータル・ライフ・デザイン領域の拡大及びグループ間連携の強化、計画に則した人材確保・育成とエンゲージメントの向上、上場会社グループとしての体制構築と潜在的なＭ＆Ａニーズの掘り起こしの４項目のテーマに取り組んでいます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "Ｍ＆Ａによるグループ化を重要な戦略と位置づけており、2023年11月に株式会社八光殿と株式会社東海典礼、2025年７月に株式会社メモリアジャパン及び関係会社を子会社化しました。2025年９月期の会館数は直営96店舗、フランチャイズ74店舗、八光殿21店舗、東海典礼25店舗、ティア北海道３店舗の合計219店舗です。",
        "basis": "MD&Aの経営成績の状況の概要と、セグメント情報に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "戦略の基本方針として「明瞭な価格体系による葬儀費用の明確化」「徹底した人財教育によるサービスの向上」「ドミナント出店による利便性の向上」を掲げ、直営・フランチャイズ出店による差別化を展開しています。人財育成専用施設や教育機関「ティアアカデミー」による教育体制も整えています。",
        "basis": "MD&Aの経営成績の状況の概要と【沿革】の記述に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "葬儀業界では、葬儀に関する潜在的需要は人口動態を背景に年々増加すると推計される一方、核家族化や葬祭規模の縮小等により葬儀単価の減少傾向が続いています。当社グループの葬祭事業の外部顧客への売上高は19,865百万円で、連結売上高21,563百万円の中心です。",
        "basis": "MD&Aの経営環境の記述と、セグメント情報の外部顧客への売上高に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
