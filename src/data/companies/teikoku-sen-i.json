  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2023年度に策定した「テイセン未来創造計画」のもと、第1フェーズの中期経営計画「テイセン2025/未来への基盤作り」では「先進的防災事業を確立・発展させ、多発化・激甚化・多様化する各種災害の脅威から社会や事業の安心・安全を守る」を旗印に、送排水ビジネス・セキュリティビジネス・防災特殊車輌ビジネスの開拓、下野・鹿沼両工場の機能拡充、持続的収益力の強化を進めてきました。2026年度からは新たな中期経営計画「テイセン2028」に取り組みます。",
        "asOf": "2026-03-17",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "戦略の軸は、災害の多発化・激甚化を背景とした官公庁・民間の防災需要の拡大を取り込むことです。大量送排水システムの自治体への導入拡大や、空港・重要施設向けのセキュリティ機材、次世代型防災特殊車輌の開発で防災事業の範囲を広げ、繊維事業では高機能繊維の新規商材開発に取り組んでいます。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報の主要な顧客ごとの情報、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績等の状況の概要",
        "asOf": "2026-03-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "消防ホースから救助工作車・空港用化学消防車、CBRNE対応資機材まで防災製品を幅広くそろえ、自社工場（下野・鹿沼）と、車輌製造・縫製加工・地域販売を担う子会社群による製造・販売の一体体制を持ちます。官公庁が売上高の33.0％を占める顧客基盤も特徴です。",
        "basis": "【事業の内容】の事業の内容とグループ各社の位置付け、セグメント情報の外部顧客への売上高と関連情報の主要な顧客ごとの情報",
        "asOf": "2026-03-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "防災分野では、気候変動による災害の多発化・激甚化やインフラ老朽化対策、「防災・国土強靭化」が成長投資分野に位置付けられた政策を背景に、官民の防災体制整備の需要が広がっています。売上高の中心は防災事業の27,257百万円で、繊維事業は5,835百万円、不動産賃貸事業は546百万円です。",
        "basis": "セグメント情報の外部顧客への売上高、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績等の状況の概要",
        "asOf": "2026-03-17",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
