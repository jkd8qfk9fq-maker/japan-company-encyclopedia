  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期成長戦略「Mimaki Innovation 30」で定めた重点施策に基づき、製品市場別に定期的かつ革新的な新製品を上市する目標を掲げ、収益性の維持による安定的な財務基盤の実践に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "2026年3月期は、SG市場向けにハイブリッドUVプリンタ「UJ330H-160」、TA市場向けに昇華転写プリンタ「TS330-1800」を発表するなど、戦略に沿った新製品の上市が続きました。",
        "basis": "MD&Aの経営成績の状況に記載された当期の新製品発表の事実に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "経営ビジョンとして、独自技術を保有し、自社ブランド製品を世界に供給する「開発型企業」を目指すことを掲げています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "製品史には世界初の機能を持つ発明がいくつもあり、2026年2月にはフラグシッププリンタ「UCJV330」と搭載インクが3MのMCS保証プログラムに認定されました。また、インクの販売は2026年3月期に各市場とも前年を上回り、本体販売後の継続的な販売につながっています。",
        "basis": "経営方針のマテリアリティの記載と、MD&Aの経営成績の状況（認定の事実とインク販売の推移）に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは地域別で、2026年3月期の外部顧客への売上高は日本・アジア・オセアニア371億52百万円、北・中南米249億60百万円、欧州・中東・アフリカ216億13百万円です。市場別ではSG市場向けが346億50百万円と最も大きく、IP市場向け215億57百万円、TA市場向け95億88百万円、FA事業41億40百万円、その他137億88百万円です。売上高の10％以上を占める販売先はありません。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの市場別売上高の表、【関連情報】の主要な顧客ごとの情報の記載に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
