  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様視点のものづくり」を基本原点に、建築鉄骨業界・製缶板金業界へ形鋼加工機を、自動車関連業界・鋼材加工業界へ丸鋸切断機を主力製品として展開し、省人化・省段取りに係る新製品開発や提案営業、保守サービスの充実を進めるとしています。あわせて、ERPとSFAを導入する新基幹システムを2027年6月頃の稼働を目指して更新しています。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "形鋼加工機は2026年5月期の売上高3,471百万円と全体の約7割を占める主力製品で、自社製品に使う金型や交換部品、保守サービスまで自社グループで担い、本機の販売と一体で提供できる体制を持っています。",
        "basis": "【事業の内容】の品目区分と、【セグメント情報等】の製品及びサービスごとの情報に印字された外部顧客への売上高に基づきます。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "金属加工機械事業の単一セグメントで、主力の形鋼加工機の需要は鋼構造物や物流倉庫・データセンターなどの建設需要と結びついています。加工した鋼材はビルの柱や梁などの部材や、自動車・機械関係の部品の素材に使われています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中長期的な会社の経営戦略と、経営成績の分析に印字された事業環境の記述に基づきます。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
