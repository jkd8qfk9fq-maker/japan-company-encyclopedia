  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「乗換案内」の機能強化による事業推進と、その周辺領域である位置や移動に関する各種事業（コンテンツ提供だけでなく、ハードウエアやMaaSのような実際の移動手段の提供を含む）への展開を進め、「移動に関するNo.1 ICTカンパニー」としての地位を確立するとしています。あわせて、各種コンテンツの提供による時間の質的向上や、IoT・AI技術の進展に対応したビジネスモデルの確立を掲げています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ソフトウエアの自社開発を基本とする「もの作り」の集団であり、「乗換案内」を長く提供し続けています。時刻表データは、株式会社交通新聞社との利用許諾契約に基づき、ダイヤ改正前にデジタルデータで受け取っています。",
        "basis": "経営方針における基本スタンスの記載と、重要な契約等における時刻表データの利用許諾契約の記載に基づきます。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "位置や移動に関するサービスの領域では、MaaSやスマートシティの流れが進展し、訪日旅行者の増加などもあって移動需要の増加が続いています。パソコン向け・法人向けでは株式会社ヴァル研究所の「駅すぱあと」、モバイル向けでは株式会社駅探の「駅探」や株式会社ナビタイムジャパンの「NAVITIME」が有力な競合先です。",
        "basis": "経営方針における経営環境の記載と、事業等のリスクにおける競合先の記載に基づきます。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
