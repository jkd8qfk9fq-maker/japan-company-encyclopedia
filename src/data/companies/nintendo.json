  "history": [
    {
      "year": 1889,
      "title": "花札の製造を始める",
      "description": "山内房治郎が京都市下京区で花札の製造を始めた。任天堂はこの年（明治22年9月）を創業としている。",
      "significance": "任天堂は花札の製造から始まった。1947年に設立した現在の会社も「かるた・トランプ類の製造・販売会社」として発足し、トランプは今も主な製品のひとつに挙げられている。",
      "sourceIds": [
        "official-history",
        "official-outline",
        "yuho-2026"
      ]
    },
    {
      "year": 1980,
      "title": "アメリカに現地法人を設立",
      "description": "アメリカ・ニューヨーク州に現地法人Nintendo of America Inc.を設立した。1982年にワシントン州で新たに設立した同名の法人がこれを吸収合併し、現在の[[term:consolidated-subsidiary|連結子会社]]となっている。",
      "significance": "Nintendo of America Inc.は今もグループの主な販売会社のひとつ。2026年3月期は米大陸の売上高が9,352億円で、日本・欧州などを上回る最大の地域だった。",
      "sourceIds": [
        "yuho-2026",
        "official-history"
      ]
    },
    {
      "year": 1983,
      "title": "ファミリーコンピュータを発売",
      "description": "家庭用テレビゲーム機「ファミリーコンピュータ」を発売した。同じ年に東京証券取引所市場第一部に上場し、京都府宇治市に宇治工場を設けた。",
      "significance": "公式の沿革では、この後もスーパーファミコン（1990年）、Wii（2006年）、Nintendo Switch（2017年）などの家庭用テレビゲーム機が続く。ゲーム機とソフトからなる「ゲーム専用機」は、2026年3月期の売上高の9割以上を占める。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    },
    {
      "year": 2016,
      "title": "スマートデバイス向けアプリを配信",
      "description": "スマートデバイス向けアプリ『Miitomo』を配信した。",
      "significance": "モバイルアプリは、任天堂が「ゲーム専用機ビジネスの枠外の分野」として挙げるもののひとつ。今も『ファイアーエムブレム ヒーローズ』などのゲームアプリを運営しており、スマートデバイス向けの課金収入は「IP関連収入等」に含まれる。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    },
    {
      "year": 2017,
      "title": "Nintendo Switchを発売",
      "description": "持ち運べる家庭用テレビゲーム機「Nintendo Switch」を発売した。",
      "significance": "2026年3月に発売から10年目を迎え、2026年3月期もNintendo Switchのソフトは1億3,691万本売れた。後継機のNintendo Switch 2でもNintendo Switchのソフトを遊べる。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    },
    {
      "year": 2023,
      "title": "マリオの映画が公開",
      "description": "任天堂が制作に携わる初のアニメ映画『ザ・スーパーマリオブラザーズ・ムービー』が公開された。",
      "significance": "任天堂は有価証券報告書で映像ビジネスを「一層重要な位置づけ」と述べ、2026年4月公開の『ザ・スーパーマリオギャラクシー・ムービー』の制作にも携わっている。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    },
    {
      "year": 2025,
      "title": "Nintendo Switch 2を発売",
      "description": "Nintendo Switchの後継機種となる家庭用テレビゲーム機「Nintendo Switch 2」を6月に発売した。",
      "significance": "任天堂はNintendo Switchの普及基盤を引き継ぐ後継機種と位置づけている。発売した2026年3月期に1,986万台を販売した。",
      "sourceIds": [
        "official-history",
        "yuho-2026"
      ]
    }
  ],
