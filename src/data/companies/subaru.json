  "history": [
    {
      "year": 1917,
      "title": "中島知久平が航空機の研究所を創設",
      "description": "中島知久平が群馬県太田町（現在の太田市）に航空機の研究所を創設しました。1931年12月に株式会社へ改組し、中島飛行機株式会社と改称しています。",
      "significance": "SUBARUの前身は航空機の会社で、現在の航空宇宙部門はこの流れをくんでいます。創業の地である群馬県太田市には現在も群馬製作所があります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1953,
      "title": "5社の共同出資で当社を設立",
      "description": "1945年8月の終戦にともない富士産業株式会社と改称して民需産業に転換し、1950年7月に12社へ分割されました。1953年7月、そのうち富士工業、富士自動車工業、大宮富士工業、宇都宮車輌、東京富士産業の5社の共同出資で当社を設立し、航空機の生産と修理を再開しました。5社は1955年4月に当社へ吸収合併されています。",
      "significance": "現在の会社の設立です。分割された会社が再び集まる形で、航空機の事業が再開されました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1960,
      "title": "群馬製作所を開設",
      "description": "群馬製作所を開設しました。1969年2月には群馬製作所・矢島工場が、1983年2月には大泉工場が稼働しています。",
      "significance": "現在も自動車の国内生産の中心となる拠点です。矢島工場ではトヨタ自動車と共同開発したBEVの委託生産も行っています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1987,
      "title": "いすゞ自動車と米国で合弁生産会社を設立",
      "description": "いすゞ自動車との米国における共同現地生産の合弁契約に基づき、スバル・いすゞ オートモーティブ インクを設立しました。2002年12月に合弁契約を解消し、2003年1月に完全子会社としてスバル オブ インディアナ オートモーティブ インク（SIA）へ社名を変更しています。",
      "significance": "現在の米国の生産拠点SIAの起点です。SIAは完成車をつくり、スバル オブ アメリカ インクなどへ販売しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1990,
      "title": "米国の販売会社スバル オブ アメリカ インクを買収",
      "description": "米国における販売会社スバル オブ アメリカ インクを買収しました。同社の売上高は連結売上高の10％を超えており、2026年3月期の売上高は3兆4,224億28百万円です。",
      "significance": "北米での販売を自社で担う体制になりました。2026年3月期の北米の売上収益は3兆7,804億97百万円で、地域別で最も大きい市場です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2003,
      "title": "鉄道車両事業とバスの新車生産を終了",
      "description": "2003年3月に鉄道車両事業を終了し、バス事業における新車生産も終了しました。2012年7月には風力発電システム事業を株式会社日立製作所へ、2013年1月には塵芥収集車事業を新明和工業株式会社へ譲渡し、2017年9月には汎用エンジン・発電機等の生産・販売を終了しています。",
      "significance": "終戦後に広げた製品分野から順に撤退し、現在の自動車と航空宇宙を中心とする事業構成になりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2017,
      "title": "株式会社ＳＵＢＡＲＵに商号変更",
      "description": "2017年4月、富士重工業株式会社から株式会社ＳＵＢＡＲＵに商号を変更しました。2014年8月には本店所在地を新宿区西新宿から渋谷区恵比寿へ移転しています。",
      "significance": "自動車のブランド名を会社の名前にしました。現在の商号です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2019,
      "title": "トヨタ自動車と業務資本提携",
      "description": "2006年3月にトヨタ自動車と業務提携し、2008年4月にはトヨタ自動車およびダイハツ工業と開発・生産における新たな業務提携を結びました。2019年9月には長期的連携関係のさらなる発展・強化を目指して新たな業務資本提携に合意しています。",
      "significance": "現在トヨタ自動車は議決権の21.5％を持つその他の関係会社で、スポーツカーと電気自動車を共同開発しています。ダイハツ工業からは軽・小型自動車のOEM供給を受けています。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
