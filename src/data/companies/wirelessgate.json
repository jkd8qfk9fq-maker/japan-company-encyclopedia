  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスとして「イマジネーションとつなげる力で社会に、そして未来に『あって良かった』を届ける」、ビジョンとして「社員に感動を　社会に笑顔を」を掲げています。2026年12月期から2028年12月期までの中期経営計画では、オフラインとオンラインの販売プラットフォームを活かして既存の通信事業の安定成長を持続させること、海外向け・国内向けのeSIMサービスを拡充して新たな主力事業に成長させることを掲げています。株式会社FREEDiVEがグループに加わったことによるグループシナジーの推進も、対処すべき課題に挙げています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高のほぼ全てを通信事業が占め、デジタルマーケティング事業は開始から間もない小規模な段階にあります。モバイルWiFiサービス事業の業績が連結の売上高に加わるのは翌期以降であり、事業構成が変化していく局面にあります。",
        "basis": "【セグメント情報等】及び注記事項（企業結合等関係）の記載に基づきます。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "通信事業では、販売チャネルの拡充に向けて新規代理店の開拓とパートナーとの連携強化を図り、ヨドバシカメラとのパートナーシップをさらに強化するとしています。主力サービスを補完する新商品の投入や、保険付きプランなどの周辺サービスの販売拡大を通じて、顧客単価の拡大にも取り組むとしています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "独自の通信設備を持たず、主力のWiMAXはKDDI株式会社から、その他のサービスも通信事業者や公衆無線LAN事業者から通信回線等を仕入れて提供する事業構造です。ワイヤレス・ブロードバンド市場は競争環境が激化しており、主力サービスの販売獲得競争に直面していると会社は認識しています。",
        "basis": "【事業等のリスク】及び【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
