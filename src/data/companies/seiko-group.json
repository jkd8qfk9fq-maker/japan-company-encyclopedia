    },
    {
      "year": 1917,
      "title": "株式会社服部時計店となる",
      "description": "1917年10月に会社組織に改め、株式会社服部時計店となりました。",
      "significance": "株式会社としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1937,
      "title": "第二精工舎が分離独立",
      "description": "1937年9月に工場精工舎のウオッチ部門が分離独立し、株式会社第二精工舎（現在のセイコーインスツル株式会社）となりました。",
      "significance": "のちに電子デバイス事業の中心となるセイコーインスツルの源流です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1947,
      "title": "和光を設立",
      "description": "1947年4月に小売部門を分離し、株式会社和光を設立しました。",
      "significance": "高級宝飾・服飾・雑貨品の小売を担う会社の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に上場",
      "description": "1949年5月に東京証券取引所に上場しました。",
      "significance": "上場企業としての歩みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "世界初のクオーツウオッチを発売",
      "description": "1969年12月に、世界で初めて水晶発振式（クオーツ）のウオッチを発売しました。",
      "significance": "腕時計の仕組みを大きく変えた製品として、会社の技術を象徴します。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "スプリングドライブウオッチを発売",
      "description": "1999年12月に、機械式とクオーツを組み合わせた世界初の駆動機構「スプリングドライブ」のウオッチを発売しました。",
      "significance": "独自の駆動機構を持つウオッチの系譜です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "セイコーウオッチを設立し持株会社に",
      "description": "2001年7月にセイコーウオッチ株式会社を設立してウオッチ事業を分社し、当社は持株会社となりました。",
      "significance": "事業会社を束ねる現在のグループ経営体制につながります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "セイコーインスツルを経営統合",
      "description": "2009年10月にセイコーインスツル株式会社を経営統合しました。",
      "significance": "電子デバイスなどの事業がグループの柱に加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "プライム市場に移行し、社名をセイコーグループ株式会社に",
      "description": "2022年4月に東京証券取引所の市場区分の見直しでプライム市場に移行し、同年10月に社名をセイコーグループ株式会社としました。",
      "significance": "現在の社名と上場市場になった節目です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "クロック販売事業をセイコーウオッチへ承継",
      "description": "2025年4月にセイコーウオッチ株式会社が、セイコータイムクリエーション株式会社からクロック販売事業を承継しました。",
      "significance": "この変更に合わせ、セイコータイムクリエーションは報告セグメント上、システムソリューション事業に区分されました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
