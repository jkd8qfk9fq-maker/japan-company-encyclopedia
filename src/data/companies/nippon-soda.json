  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン（2021年3月期〜2030年3月期）と中期経営計画「かがくで、かがやく。Stage Ⅲ」（2026年度～2029年度）を推進します。基本戦略は「高効率な事業構造への変革」で、高付加価値事業の拡大と、資産効率性を重視した構造改革と成長投資により、企業価値を高めます。2030年3月期の目標は、親会社株主に帰属する当期純利益200億円以上です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "独自の特色ある技術を活用して高付加価値製品の開発を進め、グローバルな視野で化学を中心に事業を展開する、技術指向型の企業グループを目指します。化学領域を中心に商社・物流・エンジニアリングなどの事業を展開し、グループとしての収益力向上を図ります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "農薬と化学品の両方を自社で製造し、商社・物流・工事・廃棄物処理の子会社を持つため、製造から販売、物流までグループ内で対応できる体制です。",
        "basis": "【事業の内容】の事業系統の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    }
  },
