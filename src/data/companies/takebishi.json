  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「人と人、技術と技術を信頼で結び、輝く未来を創造する」を掲げ、進化する技術と最良の品質を提供する「トータルソリューション技術商社」を目指しています。2026年度を最終年度とする4ヵ年の中期経営計画『Ｔ-Ｌｉｎｋ１３６９』では、ＦＡ機器等の基幹ビジネスの更なる拡大に加え、「グローバル」「メディカル」「オートメーション」「オリジナル」の4つの成長戦略の更なる進化や、「モビリティ」「マテリアル」「エネルギーソリューション」「ＤＸ推進」等のビジネス領域拡大にも注力し、「ＮＥＷビジネスの創造」に取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "三菱電機の販売代理店として、1926年の元扱店契約以来続く取引基盤を持ち、回転機、配電・制御、駆動制御、コントローラ、レーザー加工機・放電加工機・産業用ロボットなど幅広い製品の販売代理店契約・販売特約店契約を結んでいます。汎用的な商品の仕入販売にとどまらず、設置工事・現地調整やシステム連携作業などの据付工事等を伴う販売取引が連結売上高の2割程度を占め、機器と工事・サービスを一体で提供する体制を持っています。海外では、シンガポールのLe Champ（South East Asia）Pte Ltdの売上高が連結売上高の10％を超えるなど、アジアを中心に販売拠点を展開しています。",
        "basis": "【重要な契約等】の三菱電機との販売代理店契約等、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の据付工事等を伴う販売取引の検討内容、【関係会社の状況】のLe Champ（South East Asia）Pte Ltdに関する記載によります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、ＦＡ・デバイス事業が77,634百万円と連結売上高の約7割を占め、社会・情報通信事業が32,228百万円です。分野別では産業機器システムが39,578百万円、半導体・デバイスが38,056百万円、社会インフラが22,942百万円、情報通信が9,285百万円です。地域別では日本が86,828百万円、シンガポールが17,628百万円、その他アジアが5,327百万円、その他が79百万円です。売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント注記の外部顧客への売上高、経営者による分析の販売実績、関連情報の地域ごとの情報、主要な顧客ごとの情報",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
