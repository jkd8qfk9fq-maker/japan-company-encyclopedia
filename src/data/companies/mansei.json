  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営ビジョンとして「技術商社として、お客様のベストパートナーであり続け、ともに成長する」を掲げ、基本戦略として顧客起点の徹底（顧客接点の強化、営業品質の向上、業務処理の効率化）、収益基盤の強化と営業エリアの拡大（パートナー協業の推進、首都圏・関西圏をベースとした営業地域の拡充、M&Aの機会の検討）、人材育成と人材の確保を進めています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "最大の事業は売上高の44.5％を占める電気機器・産業用システムです。2026年3月31日に三菱電機住環境システムズ株式会社から和歌山エリアの三菱電機FA機器代理店事業を譲り受け、同年5月に和歌山支店を開設するなど、営業エリアの拡大を進めています。",
        "basis": "セグメント情報の外部顧客への売上高、企業結合等関係の注記、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1947年の創業直後から三菱電機と特約店契約・代理店契約を結ぶ総合代理店であり、三菱電機は当社の議決権の21.6％を保有するその他の関係会社です。照明器具、受変電設備、回転機、空調・冷熱機器、半導体、昇降機等の幅広い品目で販売代理店契約・販売特約店契約を結び、販売に加えて工事・保守まで担っています。",
        "basis": "関係会社の状況、重要な契約等、事業の内容",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "三菱電機製品の販売が事業の中核であり、前連結会計年度は三菱電機フィナンシャルソリューションズ株式会社への売上高が連結売上高の10.9％を占める主要な顧客でしたが、当連結会計年度は売上高の10％以上を占める顧客はありません。電子デバイス・情報通信機器は半導体が増加した一方でパソコンが減少し、設備機器は冷熱機器の販売と関連工事が伸長しました。",
        "basis": "セグメント情報の主要な顧客ごとの情報・外部顧客への売上高、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
