  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年7月に策定した中期経営計画（2025年3月期から2027年3月期）に基づき、外航海運業では既存の貨物・航路・船舶の最効率化による収益の安定化と最大化を目指し、長期契約の獲得やバラスト航海の短縮による効率的配船を進めるとしています。内航海運業では契約単価・契約期間の適正化による収益向上と、船員の増員・管理船舶の増加による事業拡大を目指すとしています。投資戦略では、海運市況や経営環境の変化に耐えうる財政状態を確保しつつ、主力である外航・内航海運業への再投資を進めるとしています。",
        "asOf": "2026-06-08",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "外航海運業では、長期にわたり信頼関係を構築してきた主要顧客との中長期的な輸送契約を基盤とし、内航海運業では、平均年齢33歳の若手船員を保有する連結子会社の大四マリン株式会社の優位性を生かし、若年船員を計画的に雇用・教育訓練して船員派遣を行う体制を特徴としています。",
        "asOf": "2026-06-08",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の営業収益5,122百万円の内訳は、外航海運業が4,047百万円（約79.0％）、内航海運業が950百万円、不動産賃貸業が124百万円であり、外航海運業が大半を占めています。顧客別では、日本軽金属株式会社向けが営業収益の35.3％、全国農業協同組合連合会向けが15.9％と印字されています。",
        "basis": "セグメント情報等の外部顧客への営業収益及び関連情報の主要な顧客ごとの情報に印字された金額と割合に基づきます。",
        "asOf": "2026-06-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
