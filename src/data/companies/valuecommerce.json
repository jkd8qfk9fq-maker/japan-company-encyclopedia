  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "限られた経営資源を選択と集中によって成長領域に重点投入し、事業基盤の強化を図りながら中長期的な成長を目指す方針です。消費者が求める価値ある情報を情報探索の文脈に沿って提供することで、消費者の意思決定を支援し、コマース事業者のマーケティング効果を最大化し、価値ある情報を生産するメディア運営者に適切な報酬を提供するビジネスモデルを基盤に、事業を発展させるとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期にECソリューションズ事業の両サービスが終了し、売上高の中心はマーケティングソリューションズ事業へ移りました。同事業では、インフルエンサーマーケティングのプラットフォームの取り込みや、SNSメディア向けプログラムと新たな成果報酬型広告ソリューションの開始など、ソーシャルコマース領域への展開が進められています。トラベルテック事業では、吸収合併とブランド統一を経て、宿泊施設向けに集客から運営までを一体で支える提供体制が整えられました。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの経営成績等の状況の概要、経営方針（優先的に対処すべき事業上及び財務上の課題）に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独自のトラッキングシステムであるバリューコマースアフィリエイトプログラムを通じて、広告主とメディア運営者の提携ネットワークと、販売実績や成果報酬の管理基盤を自社で運営しています。広告主は実際の広告掲載の成果に対してのみ広告費が発生し、成果を実数で把握し分析できる仕組みです。",
        "basis": "事業の内容（成果報酬型広告「アフィリエイト」の仕組み）とセグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "インターネット広告市場が伸長する中、セグメント情報では主要な顧客としてLINEヤフー株式会社が開示され、同社向けの販売実績は連結売上高の11.0％を占めています。一方で、ECソリューションズ事業の両サービスに関する同社との取引契約は2025年7月に終了し、同社グループとの資本関係も同年8月に解消しています。",
        "basis": "セグメント情報の主要な顧客ごとの情報、MD&Aの販売実績（相手先別の割合）、沿革に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
