  "history": [
    {
      "year": 2003,
      "title": "株式移転で持株会社として設立",
      "description": "日本コムシス、三和エレック（現・サンワコムシスエンジニアリング）、東日本システム建設（現・TOSYS）の3社が株式移転で設立しました。東京証券取引所と大阪証券取引所の市場第一部に上場しました。",
      "significance": "3社を傘下に置く純粋持株会社として、コムシスグループが始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "キャリア系ビジネスをサンワコムシスエンジニアリングに集約",
      "description": "三和エレックがサンワコムシスエンジニアリングに商号を変更しました。日本コムシスの電気通信エンジニアリング事業のうちキャリア系ビジネスを同社に集約しました。",
      "significance": "NTT向けとNCC向けで、担当する会社の役割を分けました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "コムシス情報システムを設立",
      "description": "日本コムシスのITソリューション事業のうちソフトウェア開発事業を新設分割で承継するコムシス情報システムを設立し、当社の完全子会社としました。",
      "significance": "ソフトウェア開発を担う統括事業会社が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "つうけんを完全子会社化",
      "description": "株式交換でつうけんを完全子会社にしました。",
      "significance": "北海道エリアの事業が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "東日本システム建設がTOSYSに商号変更",
      "description": "東日本システム建設が株式会社TOSYSに商号を変更しました。",
      "significance": "現在の統括事業会社名になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "監査等委員会設置会社へ移行",
      "description": "監査役会設置会社から監査等委員会設置会社へ移行しました。",
      "significance": "統治の仕組みが変わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "NDS、SYSKEN、北陸電話工事を完全子会社化",
      "description": "株式交換でNDS、SYSKEN、北陸電話工事の3社を完全子会社にしました。",
      "significance": "東海・九州・北陸エリアの事業が加わり、統括事業会社は8社の体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "プライム市場へ移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "サンワコムシスエンジニアリングの事業を日本コムシスへ承継",
      "description": "サンワコムシスエンジニアリングのITソリューション事業と社会システム関連事業を、吸収分割で日本コムシスに承継しました。",
      "significance": "サンワコムシスエンジニアリングは、通信キャリア向けの工事に重心を置く形になりました。",
