  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "サステナビリティ基本方針の戦略として「ワックス事業ポートフォリオの構築」を掲げ、再生可能なバイオマス由来ワックス製品の開発に注力し、将来的には石油、天然ガス、バイオマスの原料３本柱によるワックス事業ポートフォリオの構築を目指しています。また、経営方針では新規高付加価値ワックスへの集中を重要な施策とし、ライスワックスのインキ・塗料、化粧品用途等での展開や、水系ワックスエマルジョンのインキ・塗料、建材、加工紙用途等を中心とした拡販を進めるとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は高付加価値品販売への集中と価格改定により、ワックスの販売単価が前期比で上昇しました。2026年度からは徳山工場のリニューアルに取り組む予定で、撤去する予定の旧設備の解体を進め、跡地に新製品の製造設備や生産効率・品質の向上に寄与する設備の導入を予定しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内唯一のワックス専業メーカーとして、永年にわたり蓄積された技術により多種多様かつ高品質のワックス製品及びワックスを原料とする各種変性品を製造しています。基礎研究から製品の改良、新用途の開拓、新製品の開発まで幅広い販売開発活動に取り組んでおり、徳山工場・開発研究センター、茨城県のつくば事業所、タイの生産拠点を備えています。",
        "basis": "事業の内容、経営方針、経営環境及び対処すべき課題等、主要な設備の状況に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高19,776百万円のうちワックスが18,727百万円と大半を占めています。地域別の売上高は日本が14,267百万円、日本を除くアジアが4,149百万円、北米が818百万円、その他が541百万円です。最大の顧客は安藤パラケミー株式会社で、売上高は2,589百万円と総販売実績の13.1％を占めています。",
        "basis": "セグメント情報の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
