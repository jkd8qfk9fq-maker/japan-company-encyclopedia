  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「誠実・信用・信頼」を掲げ、「感動創造カンパニー」を目指すとしています。中長期の戦略では、婚礼事業を柱として当社グループの強みを発揮できる分野への進出を国内外を問わず進める方針で、既存店の戦略的なリニューアルや、長期的に成果を見込めるエリアへの出店を継続するとしています。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成では、連結子会社のアイ・ケイ・ケイ株式会社が担う婚礼事業が2025年10月期の外部顧客への売上高20,771百万円と、連結売上高の約92％を占めます。フォト事業は904百万円、介護事業は663百万円、食品事業は115百万円で、婚礼以外の事業はいずれも小規模ですが、フォト事業と食品事業は前期から大きく伸びています。",
        "basis": "報告セグメントごとの外部顧客への売上高（セグメント情報）と、セグメント別の業績の記載（経営成績の状況の概要）に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ゲストハウス・ウェディング形式で挙式・披露宴を行い、全国各地に自社の式場施設を展開しています。スタッフの人間力・接客力の向上を目的とした社内外の研修や、独自の営業支援システムを活用した情報収集・分析に取り組み、ウェディングのブランド化の推進を担う専門部署も設立しています。",
        "basis": "事業の内容と、経営成績の状況の概要における当連結会計年度の取組の記載に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "厚生労働省の統計では2024年の婚姻件数は48万組と前年から約1万組増加し、挙式・披露宴件数は底堅く推移したと印字されています。一方で、結婚適齢期人口の減少という構造的な課題は依然としてあるとも印字されています。売上高の10％以上を占める相手先はなく、顧客は多数の個人に分散しています。",
        "basis": "経営成績の状況の概要におけるウェディング業界の記載と、セグメント情報の関連情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
