  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「スモールビジネスを、世界の主役に。」をミッションに掲げ、「だれもが自由に経営できる統合型経営プラットフォーム」の実現を目指しています。生成AIの進展を踏まえ、人が操作する体験から業務そのものをAIエージェントに任せる体験への転換を進めており、会計事務所向けの統合型AIエージェント「freee Agent Hub」や、法人顧客向けの「freee AIアシスタント」を提供しています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の拡大は、有料課金ユーザー企業数の増加と利用単価の上昇の両方から生じています。会計と人事労務を起点に、販売管理・電子契約・金融サービスへ利用を広げることが単価上昇の経路になっています。",
        "basis": "事業の内容におけるサービスラインナップとM&Aの経緯、経営成績等の分析における売上高の増加要因（有料課金ユーザー企業数の増加とARPUの上昇）の説明に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "会計帳簿だけでなく請求書発行や入金消込といった上流の業務までを一つのソフトで扱う統合型の設計が特徴です。銀行口座やクレジットカードとの同期による自動仕訳と、380本以上のパブリックAPIによる外部サービスとの連携が、単機能のソフトとの違いになっています。",
        "basis": "事業の内容『freeeが選ばれる理由』における統合型の設計、自動仕訳、パブリックAPIの説明に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "同社は、スモールビジネス向けのクラウド会計ソフトとクラウド人事労務ソフトの市場規模を合計で約1.7兆円と推計しています。中小企業のバックオフィス向けクラウドソフトの利用率は5割に届かず、個人事業主のクラウド会計ソフトの利用率も4割弱にとどまるため、クラウドへの移行余地が大きい市場です。",
        "basis": "経営方針における市場規模の推計とクラウド利用率の説明、経営成績等の分析における市場認識に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
