  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "地域唯一の百貨店として、地域経済・社会の発展に貢献することを中長期的に目指す姿と定め、資産価値向上に取り組む「井筒屋グループ 中期３ヵ年経営計画(2025年度～2027年度)」を策定し、推進しています。収益基盤の多様化に向けた「地域商社」構想にも取り組み、北九州市および北九州商工会議所との３者間で基本合意を締結し、第一弾となる商品の開発・販売を開始しました。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1936年に開店した小倉の本店を拠点に、北九州市で百貨店を営む唯一の事業者として地域に根ざした営業を続けており、山口店とあわせて北九州・山口地域に店舗網を持ちます。友の会の積立会員の基盤を持ち、店舗内のレストラン部門や慶弔ギフトの販売をグループ会社が担う体制です。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（業績等の概要）に基づきます。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "百貨店業が売上高の大半を占め、2026年2月期の外部顧客への売上高は21,247百万円です。百貨店業界は、国内のオケージョン需要や富裕層の消費が堅調な一方、インバウンド需要の減速や高額品需要の勢いの鈍化など厳しい商況が続いているとされています。10％以上を占める主要な顧客はないと印字されています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高）と関連情報（主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づきます。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
