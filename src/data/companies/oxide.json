  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "光学分野の次世代製品開発や、レーザ加工、レーザセンシングといった新領域の新製品開発とともに、コア技術である単結晶の高品質化開発といった基盤技術の研究開発を推進するとしています。あわせて、パワー半導体向けSiCウエハの超高品質化と大口径化の開発や、家電パワーデバイス用途の低コストβ-Ga2O3基板の開発に注力するとしています。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "FZ法、CZ法、VB法、TSSG法、DCCZ法、KY法、EFG法、フラックス法など、多くの単結晶育成技術と装置を保有しているとしています。また、2014年には経済産業省の「グローバルニッチトップ100選」に選定されています。",
        "asOf": "2026-05-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    }
  },
