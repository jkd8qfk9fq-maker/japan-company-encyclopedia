  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-25",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「アイディアとテクノロジーで世界をもっとハッピーに」というミッションを掲げ、成長投資事業と位置付けるキャッシュレスサービス事業とデジタルサイネージ関連事業、安定収益事業と位置付けるソリューション事業を事業会社を通じて展開し、中長期的な収益拡大を目指すとしています。各事業とも、月額利用料や決済手数料、システム利用料などのリカーリングビジネスによる継続的な売上を得ることを重要戦略とし、独自Payプラットフォームの開発やデジタルサイネージの新機能開発、メッセージングサービスのAPI開発などを計画しています。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "キャッシュレスサービス事業は、売上の75.8％が月額利用料や決済手数料などのリカーリングビジネスによるもので、顧客との契約が続く限り安定した収益が見込める構造です。デジタルサイネージ関連事業は、機器の選定から設置工事、表示内容の制作・配信、運用・保守までをワンストップで提供しています。メッセージングサービスは月次平均解約率が0.6％と低く、取引社数は395社です。",
        "basis": "【事業の内容】にキャッシュレスサービス事業の売上の75.8％がリカーリングビジネスによるものであることが印字され、デジタルサイネージの提供内容がワンストップであることが印字され、MD&Aにメッセージングサービスの解約率と取引社数が印字されていること。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年8月期は、株式会社クラウドポイントの通期の業績が連結されたことでデジタルサイネージ関連事業が売上高5,690百万円と最大の事業になりました。キャッシュレスサービス事業は3,768百万円で、顧客数は1,131社、顧客の独自Payの決済取扱高は約1.45兆円です。ソリューション事業は761百万円です。",
        "basis": "セグメント注記に事業ごとの外部顧客への売上高が印字され、MD&Aにクラウドポイントの通期連結の影響、キャッシュレスサービス事業の顧客数と独自Pay決済取扱高が印字されていること。",
        "asOf": "2025-11-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
