  "history": [
    {
      "year": 1939,
      "title": "ラサ商事株式会社を設立",
      "description": "ラサ工業株式会社の製品を販売する目的で、東京都中央区京橋にラサ商事株式会社を設立しました。",
      "significance": "会社の起源です。",
      "sourceIds": [
