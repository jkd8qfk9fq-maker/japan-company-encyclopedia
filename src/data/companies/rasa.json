      ],
      "locator": "【沿革】"
    },
    {
      "year": 1958,
      "title": "ワーマンポンプの総販売代理店契約を締結",
      "description": "日曹製鋼株式会社（現在の大平洋金属株式会社）と「ニッソ・ワーマンポンプ」の総販売代理店契約を締結し、販売を開始しました。",
      "significance": "主力商品であるワーマンポンプの取扱いの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "アイルカ社とジルコンサンドの代理店契約を締結",
      "description": "ウエストラリアンサンド社（現在のアイルカ社・オーストラリア）とジルコンサンドの輸入販売代理店契約を締結しました。1978年には総販売代理店契約となりました。",
      "significance": "資源・金属素材関連事業の中核商品の供給体制の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1984,
      "title": "大平洋機工株式会社が関連会社になる",
      "description": "大平洋金属株式会社が大平洋機工株式会社を設立したことに伴い、ワーマンポンプの総販売代理店契約の相手先は大平洋機工株式会社に変更されました。同時に当社が出資し、同社は当社の関連会社となりました。",
      "significance": "現在のグループ体制につながる出来事です。",
      "sourceIds": [
