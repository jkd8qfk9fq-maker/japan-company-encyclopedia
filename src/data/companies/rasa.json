  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期から2028年3月期までの3か年を計画期間とする中期経営計画「“Step Forward”Rasa 2027～成長のステージへ～」に取り組んでいます。重点施策は、新規・成長分野への取り組み、既存領域の深耕、事業活動を通じたサステナビリティ経営の推進の3つです。社会インフラを支える付加価値創出企業として、既存事業の安定的成長にとどまらず新たなステージを目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、環境設備関連の売上高が前連結会計年度の1,858百万円から3,087百万円へ大きく増え、全体の増収をけん引しました。産機・建機関連は売上高がやや減った一方で、部品・整備の需要が好調だったと開示されています。",
        "basis": "セグメント情報の外部顧客への売上高と、MD&Aの経営成績の概要・分析に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "オーストラリアのアイルカ社のジルコンサンド、大平洋機工株式会社のワーマンポンプ、ドイツのメーカー3社の高圧ポンプなど、国内外のメーカーとの総販売代理店契約に基づく仕入れ体制が特徴です。自社技術の水砕スラグ製造設備「ラサ・システム」は、製鉄所の溶融スラグを粒状化する設備で、国内の製鉄所だけでなく海外にも納入実績があります。ポンプは部品交換で長期使用でき、現場でメンテナンスできる点も強みとされています。",
        "basis": "事業の内容とセグメント情報に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "専門商社として、資源・金属素材、産機・建機、環境設備、化成品、プラント・設備工事、不動産賃貸の6事業を展開しています。売上高が最も大きいのは産機・建機関連で、ワーマンポンプは耐食・耐磨耗ポンプのトップクラスのシェアを維持していると開示されています。",
        "basis": "事業の内容とセグメント情報の外部顧客への売上高に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
