  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは、2023年11月に中期経営計画『Together Toward Transformation 26（TTT-26）』を策定し、アジアを中心とした半導体・製薬工場向け超純水製造装置の卓越した会社を目指すことを経営ビジョンに掲げています。2026年度の経営目標として売上高1,010億円の達成を目指し、営業力の強化、エンジニアリングプロセスの改革、研究開発の加速、人的資本強化、環境問題への取組みを推進しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "経営方針では、半導体生産拠点の分散に対応してシンガポールに現地法人を設立して営業を開始したことや、インドで最初の半導体製造工場向けの水処理装置を受注したことが示されており、販売地域の拡大が進められています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略及び優先的に対処すべき課題における販売地域拡大の記載と、セグメント情報の地域別売上高",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "原水中の不純物を除去する前処理から超純水製造工程までを一貫して構築できることや、排水・回収処理装置による水資源の有効利用への対応が、事業の内容に示されています。韓国子会社は研究開発機能を有し、海外の有力ユーザーに近い場所で研究開発体制を構築しています。",
        "basis": "【事業の内容】の超純水製造装置の構成と韓国子会社の研究開発機能の記載、【研究開発活動】の顧客ニーズ直結型の研究開発の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
