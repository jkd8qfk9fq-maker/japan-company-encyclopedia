  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第5次中期経営計画（2025年3月期から2027年3月期）では、「変革とチャレンジ」をキーワードに、中長期的に基幹事業ポートフォリオの最適化を図り、事業利益のさらなる向上を目指すことを基本方針としています。本業である鋼構造物製造事業では、中部地区を重点とした受注戦略と他地域への営業活動の展開、橋梁保全では高速道路の大規模更新や床版取替工事への注力、鉄骨・鉄構では首都圏の超高層案件への取り組みを掲げ、不動産賃貸事業は安定的な収益源として一定規模を確保し、材料販売事業は新規顧客の開拓と既存顧客への販売増加を進めるとしています。最終年度を迎えるにあたり、事業環境を踏まえて計画の数値目標の見直しを行ったことも示しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "橋梁・鉄骨などの鋼構造物について、設計・製作から現場施工までをグループで一貫して担う体制を持ちます。本社・工場を愛知県半田市に置き、連結子会社が鉄骨等の製作加工、現場施工や溶接工事、製品輸送を分担し、橋梁保全工事では設計変更への対応も収益に結びつけています。",
        "basis": "事業の内容における当社と子会社の役割の記載、関係会社の状況における各子会社の関係内容の記載、主要な設備の状況における本社・工場の設備の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "鋼構造物製造事業が2026年3月期の外部顧客への売上高20,697百万円と売上高の大半を占め、主要な顧客は西日本高速道路株式会社、国土交通省、中日本高速道路株式会社です。会社は、鋼道路橋の発注量が過去最低水準の厳しい状況で推移し、受注競争の激化が続いていると分析しています。",
        "basis": "セグメント情報における外部顧客への売上高と主要な顧客ごとの情報の記載、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における鋼構造物製造事業の概況の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
