  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年９月17日に2026年２月期から2028年２月期までの３ヵ年を対象とする新たな中期経営計画を策定・公表し、①デジタル化の推進（ハードウェア一辺倒の事業から、ソフトウェア・AI・ネットワーク等のデジタル化技術との融合を提案するハード・ソフト一体の事業体への発展）、②持続的成長のための投資、③人材教育への投資の３点を掲げています。試験機事業では、標準製品のブラッシュアップや代理店網を活用した営業基盤の強化、オーダーメイドの特殊製品の受注拡大、修理・校正・メンテナンスサービスの拡充に取り組み、エンジニアリング事業では、道路・建築・鉄道・電力等の既存顧客の深耕や新規顧客の開拓、顧客との共同製品開発によりインフラ市場への浸透を進めるとしています。デジタル事業では、CAE分野に強みを持つ株式会社先端力学シミュレーション研究所を基盤に、実測とCAEを融合したデジタルツイン技術やAI解析技術等を統合し、独自の『フィジカルAIソリューション』の創出を目指すとしています。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "安全性・品質保証を重視する顧客基盤を持つ試験機事業の安定需要を収益の土台に、2025年３月に子会社化したデジタル事業を成長領域として育て、実測データと解析を組み合わせた提案で付加価値を高める事業構成への移行を進める方向と読み取れます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に中期経営計画の３つの柱と各事業の戦略が、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に試験機事業の需要構造と先端力学シミュレーション研究所との連携の記述が印字されていることに基づく要約です。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "材料の評価試験や動力・性能試験等の各分野で業界トップレベルの品揃えを持ち、開発・設計・生産からメンテナンス・校正までを一貫して提供できる体制と、オーダーメイド対応のカスタマイズ力が強みです。研究開発投資や法規制対応に基づく需要が中心で、一般的な設備投資に比べ景気変動の影響を受けにくい需要構造も特徴です。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に試験機事業の品揃え、ワンストップ提供、需要構造の記述が印字されていることに基づく要約です。",
        "asOf": "2026-05-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
