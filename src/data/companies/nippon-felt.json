  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「『伝統の継承』と『新たな挑戦』の融合で豊かな未来を創造します」と10年長期ビジョン「業界の先駆者として磨き上げた独自の価値・技術を活かし、永く広く社会の発展に寄与し続ける企業へ」を掲げ、2026年度から2028年度までの中期経営計画では、フェルト事業の収益力の改善と収益基盤の強化に取り組んでいます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "紙・パルプ用フェルトで国内の高いシェアを維持しており、台湾惠爾得は台湾で唯一の抄紙用フェルト生産拠点として、アジア市場への供給の足場を持っています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、紙・パルプ用フェルトについて国内は高シェアを維持したことが印字され、【経営方針、経営環境及び対処すべき課題等】に、台湾惠爾得股份有限公司が台湾唯一の抄紙用フェルト生産拠点であることが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内では新聞紙・印刷用紙の生産縮小で市場が縮小するなか、板紙・家庭紙分野へのシェア拡大とアジア市場の開拓で収益基盤の維持・拡大を図る位置づけにあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、国内の情報用紙分野が縮小するなか板紙・家庭紙分野のシェア拡大を掲げることが印字され、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、新聞紙や印刷・情報用紙の生産が縮小していることが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
