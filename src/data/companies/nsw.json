  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「Humanware By Systemware」の実現に向け事業を推進し、2025年4月からの中期経営計画では、この3年を「原点回帰」＝Rebornと位置付け、基本コンセプト「DRIVE DX×Change The Standard」のもと、DXの実現による顧客価値の共創を加速するとしています。2027年3月期の連結業績として売上高54,000百万円を計画しています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は、各セグメントの伸長分野にあります。エンタープライズソリューションでは金融・公共領域、サービスソリューションではIoTシステム構築やデータマネジメント、エンベデッドソリューションではオートモーティブ分野、デバイスソリューションでは半導体設計・開発が伸長し、当連結会計年度の増収をけん引しました。",
        "basis": "セグメント情報における外部顧客への売上高と製品及びサービスごとの情報、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の概況",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "優位性は、業務システムの開発からクラウド・インフラの運用、組込みソフトウェア、LSI設計までを一貫して手がけられる技術領域の広さにあります。1966年の創業以来、受託計算やファームウエア・論理回路の開発から事業を広げ、自社データセンターによるハウジング・ホスティングサービスまで提供しています。",
        "basis": "事業の内容における4セグメントの構成と各事業の内容、沿革における事業展開の記録、関係会社の状況",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス産業では、企業のDX関連投資やAIの社会実装を背景にIT投資需要が堅調に推移しています。当社グループは独立系のシステムインテグレータとして、業種を横断する顧客基盤を持ち、主要な顧客である日本電気グループとは全4セグメントにわたる取引があります。",
        "basis": "経営方針、経営環境及び対処すべき課題等における経営環境の記載、セグメント情報の主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における業界動向の記載",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
