  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社の強みである金型や生産技術力をさらに磨き、設備を強化して高まる顧客要求に応えることで売上拡大を実現する方針です。対処すべき課題として、自動車の電装製品、安全走行製品、ＥＶ関連製品の受注拡大と、内需産業のスマートメーター、インフラ関連製品の受注活動の強化、ロボット導入による自動化や内製化などの原価低減、タイの連結子会社の生産体制の強化、大型化や絞り加工で競合との差別化を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上の中心である自動車関連製品の受注拡大と、タイの連結子会社の生産体制強化による海外対応を両輪とする戦略です。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、MD&Aの業績等の概要に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金型の製作からプレス加工、ユニットの組立までを自社で担う体制があり、大型化や絞り加工などの加工技術で差別化を図っていることが強みです。",
        "basis": "経営方針、経営環境及び対処すべき課題等と事業の内容に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "製品別では自動車関連製品が売上高の中心であり、安全関連や車載電装品を手がけています。主要な顧客として住友電装株式会社と株式会社デンソーが開示されています。",
        "basis": "セグメント情報の関連情報（主要な顧客ごとの情報）とMD&Aの製品別概況に基づきます。",
        "asOf": "2026-06-25",
