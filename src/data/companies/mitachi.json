  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年5月期から2027年5月期までの3ヶ年の中期経営計画「中期経営計画2026」では、基盤ビジネスの強化・拡大、新たな収益基盤の創出、健全な経営基盤の維持・強化を進める方針です。モビリティ分野での取組強化や、産業機器分野の自動化・省人化・効率化領域での取組強化、協業やM＆Aの活用による成長の加速を掲げています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自動車部品メーカー向け半導体の販売を軸に、デンソーグループへの販売実績が売上高の64.6％を占め、フィリピンのM.A.TECHNOLOGY,INC.を中心とする受託加工体制と、香港、台湾、上海、深圳、タイ、インドネシア、マレーシアの海外拠点網を備えています。",
        "basis": "【事業の内容】のグループ構成と取扱商品、【関連情報】の主要な顧客ごとの情報によります。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高のうち国内事業部門が1,023億90百万円、海外事業部門が179億37百万円で、地域別では日本が1,043億5百万円、中国が52億59百万円、フィリピンが60億86百万円、その他が46億76百万円となっています。品目別では半導体が958億35百万円で売上高の約8割を占め、自動車分野の需要に大きく依存する構成です。",
        "basis": "セグメント情報の報告セグメントごとの売上高と関連情報の製品・サービス別／地域別／主要な顧客別情報によります。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
