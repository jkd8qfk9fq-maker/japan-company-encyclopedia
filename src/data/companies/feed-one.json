  "history": [
    {
      "year": 2014,
      "title": "協同飼料と日本配合飼料が株式移転で当社を設立し上場",
      "description": "2014年10月、協同飼料と日本配合飼料が株式移転で持株会社として当社を設立し、当社の普通株式が東京証券取引所に上場しました。",
      "significance": "飼料メーカー2社が一つのグループになった出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "2社を吸収合併し、商号をフィード・ワンに変更",
      "description": "2015年10月、当社が協同飼料と日本配合飼料を吸収合併し、商号を「フィード・ワン」に変更しました。",
      "significance": "持株会社から、飼料をつくって売る事業会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "北九州工場を開設",
