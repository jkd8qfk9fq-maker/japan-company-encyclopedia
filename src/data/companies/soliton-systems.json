  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "受託開発の会社でも輸入再販の会社でもなく、独自の標準製品を開発し、オリジナル製品の販売あるいはサービスの形でユーザーに提供することを掲げています。ITシステムの根幹となる技術に焦点を絞り、ITセキュリティを鍵に新たな技術や市場へ積極的に展開して事業の拡大を図り、企業価値を持続的に向上させることを目指しています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、ITセキュリティ事業で自社製品とサービスの販売が伸び、防衛や防災分野での大型案件の獲得や、教育機関の業務デジタル化に関係する文教分野の需要の拡大が売上高を押し上げ、グループの売上高は前年同期比6.2％増となりました。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ソフトウェアとハードウェアの両面を自社で開発できる体制を持ち、国内シェアNo.1の認証アプライアンス「NetAttest」をはじめとする主力製品を自社ブランドで販売し、保守やクラウドサービスによる継続的な収益も積み上げている点が強みです。",
        "basis": "セグメント情報の外部顧客への売上高と収益の分解情報、経営方針、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "企業のデジタル化の取り組みが高水準で推移するなか、クラウドの導入や生成AIの活用と並んでサイバーセキュリティ対策の強化が重要分野とされ、関連投資が幅広い業種で拡大しています。主要な顧客であるダイワボウ情報システム株式会社への販売実績は、2025年12月期の総販売実績の14.6％を占めています。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
