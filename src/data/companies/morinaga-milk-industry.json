  "history": [
    {
      "year": 1917,
      "title": "日本煉乳株式会社として設立",
      "description": "乳製品の製造販売を主な目的とする日本煉乳株式会社として、1917年9月に設立されました。",
      "significance": "現在の森永乳業につながる出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1919,
      "title": "小缶煉乳「森永ミルク」を発売",
      "description": "1919年5月に小缶煉乳の森永ミルクを発売しました。",
      "significance": "乳製品メーカーとしての最初期の商品です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1920,
      "title": "森永製菓と合併",
      "description": "1920年7月に森永製菓株式会社と合併し、同社の畜産部（後に煉乳部）となりました。",
      "significance": "後に分離独立する前の、菓子会社の一部門だった時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1927,
      "title": "森永煉乳株式会社を設立",
      "description": "1927年9月に森永製菓の煉乳部を分離し、新たに森永煉乳株式会社を設立しました。",
      "significance": "乳製品事業が独立した会社になった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "現在の森永乳業株式会社が設立",
      "description": "森永製菓との合併と分離を経て、1949年4月に現在の森永乳業株式会社が設立されました。",
      "significance": "現在の会社の設立年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1954,
      "title": "東京証券取引所に株式を上場",
      "description": "1954年9月に東京証券取引所に株式を上場しました。",
      "significance": "株式を公開する会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1967,
      "title": "森永商事の乳製品販売部門を譲り受け",
      "description": "生産と販売を一体で行うため、1967年10月に森永商事株式会社の乳製品販売部門を譲り受けました。",
      "significance": "製造から販売までを自社で担う体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1977,
      "title": "「森永ビヒダス」を発売",
      "description": "1977年6月にビフィズス菌入りの乳製品、森永ビヒダスを発売しました。",
      "significance": "ビフィズス菌を使った商品の先駆けとなる商品です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1993,
      "title": "「マウントレーニア カフェラッテ」を発売",
