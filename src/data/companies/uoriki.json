  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として、使命「魚によって、世界の人々を健康で幸せにする」と将来像「魚食文化を守り、日本の水産業の発展に貢献する」を掲げています。基本的な経営戦略は、強みである鮮魚の仕入力と販売力、それに経営実績により作られた信用力を活かして、国内外で活躍する「魚」の総合企業を目指すことです。国内の基幹事業を土台に海外進出を進め、中期経営計画（2024－2026年度）の下で国内事業の成長と海外事業の拡大に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上の中心は国内の小売事業で、2026年3月期の小売事業の外部顧客への売上高は38,228百万円と連結売上高の大半を占めています。海外は、タイの関連会社CP-Uoriki Co.,Ltd.の店舗が2026年3月時点で32店舗に広がり、ドバイ向けの輸出も伸びていると書かれており、国内の小売を土台に海外の販路を広げる進め方が開示から読み取れます。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aのセグメント別の概況と店舗数の説明、関係会社の状況に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "鮮魚の仕入力と販売力を強みとしています。豊洲市場を仕入の拠点としつつ、産地からも直送した新鮮な生魚を中心に、平均的な店舗で常時200から300品目ほどの品揃えで、鮮度と値ごろ感を打ち出した販売を行っています。物流では、一部の商品の集荷場を埼玉県魚市場（さいたま市北区）に移すなどの見直しに取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "小売事業は駅ビルや百貨店、スーパーへのテナント出店が中心で、鮮魚売場と寿司の販売を組み合わせています。飲食事業では近隣の鮮魚店と連携して天然の生ネタ寿司の品揃えを充実させると書かれており、鮮魚の仕入れと売場の近さが、小売と飲食の両方に使われていることが読み取れます。",
        "basis": "事業の内容の小売事業と飲食事業の説明、MD&Aのセグメント別の概況に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "経営環境として、国内では魚の価格の上昇や供給量の減少、肉類など他の食品への移行、好みの変化により魚を食べる機会が減る状況にあると説明しています。一方で、世界的な規模で地上からの供給に代わるたんぱく質の供給源として、また健康志向の広がりから、養殖業を含む水産業や水産物への注目は高まっているとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
