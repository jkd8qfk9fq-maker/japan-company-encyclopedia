  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2036年の創業370周年を見据えた長期ビジョン「YUASA vision 370」と、2026年4月から2031年3月までの5カ年を対象とする中期経営計画「Reborn 2031」を策定しました。中期経営計画では、事業基盤・人財基盤・経営基盤の3つの基盤の強化と積極的な投資を行うことで、高い成長性・収益性・効率性を目指すとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "産業機器から住宅設備、建設機械、エネルギーまで7つの部門で幅広い商品を扱い、商品の販売に工事の請負やリース・レンタル、現場の課題を解決するソリューション提案を組み合わせている点が特徴です。1666年の創業以来の長い歴史を持ち、国内外に多くのグループ会社を擁しています。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記述",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は545,027百万円で、部門別では住設・管材・空調が223,492百万円と全体の4割超を占め、工業機械が105,444百万円、産業機器が77,739百万円で続いています。国内のお客様への売上高が連結売上高の90％を超えており、国内中心の事業構成です。",
        "basis": "セグメント情報と【関連情報】の記述",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
