  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「プロジェクト型社会の創出」をミッションに掲げ、成長戦略として、プロジェクト型人材の輩出を目指すHR戦略と、日本企業を変革する多様なソリューションの提供を目指す事業戦略の両面でアプローチする方針を示しています。事業戦略では、専門性の高いテーマに対応するエキスパート機能の立ち上げや、スケーラビリティの高いソリューションの開発・提供を進めるとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年１月に新設したAIコンサルティング本部を置くなど、生成AIの利活用推進の支援を新たな柱として育てています。2025年12月期はデジタルトランスフォーメーション事業のコンサルティングサービスが売上を牽引し、DX×テクノロジー事業では組織拡大、DX×HR事業ではサービス提供体制の安定化に注力しました。",
        "basis": "【事業の内容】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づく",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "従来の経営コンサルティングが主に経営層を対象に戦略策定を支援するのに対し、同社は大企業の部課長などミドル層を対象に、事業展開の実行そのものを当事者意識を持って伴走支援する点に特徴があります。デジタルトランスフォーメーション事業で支援する新規事業開発案件の下流工程をDX×テクノロジー事業が担うなど、セグメント間の連携も生まれています。",
        "basis": "【事業の内容】の記載に基づく",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内企業のDXへの取組みが浸透する一方で、DXを推進する人材の不足が多くの企業で続いており、経営戦略・事業戦略の実行を担う中間管理職層のキャパシティ不足が戦略実行のボトルネックになっていると同社は捉えています。同社は部門を問わずビジネスを横断的に支援するパートナーの位置付けを取っています。",
        "basis": "【事業の内容】の記載に基づく",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
