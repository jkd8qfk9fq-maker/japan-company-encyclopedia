    {
      "year": 2006,
      "title": "三協アルミニウム工業と立山アルミニウム工業が合併",
      "description": "2006年6月に三協アルミニウム工業株式会社と立山アルミニウム工業株式会社が合併し、商号を三協立山アルミ株式会社としました。",
      "significance": "二つの源流が一つの会社になり、現在の社名の基になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "商号を三協立山株式会社に変更",
      "description": "2012年6月に三協マテリアル株式会社及びタテヤマアドバンス株式会社を合併し、商号を三協立山株式会社としました。同年12月には三協・立山ホールディングス株式会社を合併しています。",
      "significance": "持株会社を含むグループの組織を整理し、現在の会社の形になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "欧州とタイでアルミ押出事業を取得",
      "description": "2015年3月に、ベルギーのSankyo Tateyama Europe BVが米国Aleris International,Inc.の押出事業部門を買収しました。同月、Aluminium Capital Pte.Ltd.（現：SANKYO TATEYAMA (SINGAPORE) PTE.LTD.）の全株式を取得し、子会社のThai Metal Aluminium Co.,Ltd.とともに子会社にしました。",
      "significance": "欧州とASEANでアルミ押出を手がける現在の国際事業の土台になりました。",
