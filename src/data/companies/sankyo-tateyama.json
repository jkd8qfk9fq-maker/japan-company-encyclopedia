        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1972,
      "title": "東京及び大阪証券取引所第一部に上場",
      "description": "1972年4月に東京及び大阪証券取引所の第一部に上場しました。",
      "significance": "株式市場に上場し、事業を広げる資金を市場から調達できる会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
