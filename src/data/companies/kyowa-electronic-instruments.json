  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度を初年度とする中期経営計画「KYOWA Vision 2027」では、基本方針として「既存分野の深耕とサービスの拡充・創出により持続的な事業の成長を目指す」ことと「収益力の向上と資本効率の改善により企業価値向上を目指す」ことを掲げています。基本戦略は、校正事業の拡大やクラウドサービスの事業化などによる「計測事業のさらなる拡充」、「顧客満足のさらなる向上」、「変革を促す組織基盤の強化」、「ESGへの取り組み」の4つです。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期には、計測クラウドサービスの提供開始や、校正範囲の拡大と校正種類の追加認定の取得など、計画が掲げるサービスの拡充に沿った取り組みが始まっています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における当期の取り組みの記載",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "経営ビジョンとして「計測を通じ、お客様と共に社会と人の安全を実現し、安心な未来をつくる」を掲げ、応力計測に軸足を置いて、要素技術・製品技術および計測技術の研究開発を行っているとしています。研究開発活動は提出会社に集約されています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【研究開発活動】"
      },
      "analysis": {
        "text": "製造子会社による製品の製造から、中国・アメリカの販売子会社による各市場への販売、専門子会社による修理・保守、コンサルティング子会社による設置・測定・解析まで、計測に関わる工程をグループ内で担う体制になっています。",
        "basis": "【事業の内容】および【関係会社の状況】における各子会社の役割の記載",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
