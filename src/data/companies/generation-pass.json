  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ECマーケティング事業では商品取扱高の増加に注力し、他社を支援するECサポート事業及びメディア事業に力を入れていくとしています。商品企画関連事業では、ECマーケティング事業で蓄積されたビッグデータを活用して商品提案と新規顧客開拓を加速させるとしています。海外では中国・ベトナム・ラオスなどのアジアを重点地域として事業展開を推進するとしています。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ECモールごとに蓄積したデータで販売条件を最適化するEPOの仕組みと、自社開発の受発注・分析システムにより、249万点という多品種の商品を87店舗で扱いながら低コストの運営ができている点が強みです。",
        "basis": "ECモール等から収集したビッグデータを分析し販売条件を最適化するEPOの手法と、受発注システムGPMS・分析システムMISを自社開発していること、2025年10月31日時点で取扱商品数が249万点、店舗数が連結合計87店舗であることに基づきます。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "EC市場は利用の定着で拡大が続く一方、競争も激化しています。同社は大手ECモールの中での販売と、自社ECサイト群を束ねるプラットフォームの構築を組み合わせて事業を行うEC事業者です。",
        "basis": "経営環境としてEC市場の継続的な拡大と競争の激化が述べられていること、楽天市場・Yahoo!ショッピング・Amazon等のECモールへの出店と自社ECサイト群のプラットフォーム事業（USP事業）を併用していることに基づきます。",
        "asOf": "2026-01-29",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
