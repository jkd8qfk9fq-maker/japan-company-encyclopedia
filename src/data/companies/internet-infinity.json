  "history": [
    {
      "year": 2001,
      "title": "有限会社インターネットインフィニティーを設立",
      "description": "代表取締役社長の別宮圭一が、東京都墨田区においてシステムインテグレーション事業を目的に有限会社インターネットインフィニティーを設立しました。",
      "significance": "システムインテグレーション事業を目的に設立された会社が、その後の介護事業参入の起点となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "介護事業に参入",
      "description": "東京都中央区にて訪問介護事業所「クローバーケアステーション」を開設し、介護事業に参入しました。介護業界の業務システム構築案件を手掛ける中で、介護業界に大きなビジネスチャンスがあることを認識したことがきっかけです。",
      "significance": "設立当初とは異なる介護分野への参入で、現在の事業の中心はここから始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
