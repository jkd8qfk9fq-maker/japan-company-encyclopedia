  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ヘルスケアプラットフォームの価値向上により事業拡大と新規事業開発を進めるとし、レコードブックの店舗ネットワークの拡大、介護保険適用外のヘルスケアソリューションの開発によるターゲット層の拡大、DXソリューション事業の強化、経営基盤の強化に取り組むとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、レコードブックの店舗網とケアマネジャーの会員網という2つの基盤を相互に活かすことです。2025年4月にセントワークス株式会社を子会社化し、中規模の介護事業者向けのソフトウエアを起点としたDXソリューションの拡大を進めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中長期的な経営戦略、経営成績の分析におけるセントワークス株式会社の取得の記述",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "実際の介護現場を持つ事業とウェブの事業の双方を持ち、介護現場での課題をウェブで解決し、現場を通じて蓄積したデータを活用できることが強みです。レコードブックでは、運動指導チームによる研修で育成したトレーナーが、スポーツ医学などに基づいた運動プログラムを個別に指導しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の基本方針、【事業の内容】のレコードブック事業の説明",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
