  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "レジャー産業を基軸にした総合商社として、環境の変化に対応しながら新たな需要の創造と機能性の向上を目指すことを基本方針としています。中期ビジョンとして「新たな商品開発スキーム×ブランディング発信×成長投資による持続的成長基盤の構築」を掲げ、販路とサービスの拡大、商品企画とブランディングによる商品力の強化、人材育成と体制整備、成長に向けた投資に取り組むとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、大阪・関西万博における会場内外への商品供給が、みやげ卸売事業とみやげ製造事業の売上を押し上げました。一方で、みやげ小売事業とアウトドア用品事業では、一部店舗の賃借契約満了による閉店が売上の減少要因となりました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2012年に各地の事業を子会社化して以降、地域ごとの販売会社が地元の観光地に密着して営業する体制をとっています。各地の食品製造会社や地域団体と協働し、特産品や名産品を原料とした加工品づくりを通じて、地産地消の推進に取り組んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "観光みやげ品の卸売を主力とし、宿泊施設や駅・サービスエリアの売店といった、観光客の動線上にある販売チャネルへ商品を供給する位置にあります。卸売に加えて直営店での小売と菓子の製造も自社グループで行っています。",
        "basis": "事業の内容及び経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
  "workforce": {
