  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "鋼製品事業、デンタル事業、書庫ロッカー事業を核として多様化する顧客ニーズに対応し、満足いただける質の高い製品・サービス提供を通じて、より快適なくらしの創造をめざすことを基本方針としています。経営戦略としては、技術開発と品質管理の更なる向上を追求して「ものづくり」と「商品提供」に取り組み、営業活動の強化、新製品の開発、管理部門の効率化、財務体質の向上など経営全般にわたる改善と効率化を推進するとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "３つの中核事業の規模が拮抗しており、特定の事業への依存度は高くありません。対処すべき課題として、多様化する顧客ニーズに応える高品質商品の提供、新製品の開発、低コスト生産体制の確立、営業活動の強化、管理部門の効率化を挙げています。",
        "basis": "セグメント情報に報告セグメントごとの外部顧客への売上高が印字され、経営方針の課題の記載があることから読み取れます。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "耐火金庫では指紋・静脈認証に加え、虹彩・顔認証の生体認証モデルなど高付加価値製品を展開しており、認証技術を組み合わせたセキュリティ製品の品揃えが特徴です。",
        "basis": "経営成績の分析に、耐火金庫の生体認証製品の拡販に努めた旨が印字されていることから読み取れます。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高はデンタル関連事業2,065百万円、書庫ロッカー関連事業1,961百万円、鋼製品関連事業1,722百万円と３事業が拮抗する構成で、不動産賃貸関連事業178百万円とその他136百万円がこれに続きます。",
        "basis": "セグメント情報に報告セグメントごとの外部顧客への売上高が印字されていることから読み取れます。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
