  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度に創立100周年を迎えたことを契機として、次の100年に向けた持続的な成長を実現するため、収益構造改革及び事業基盤強化に取り組む方針です。品質向上、生産効率改善、高付加価値製品へのシフト、プロダクトミックスの変更による採算の改善、新規顧客開拓等を推進し、安定した収益構造の構築を図るとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年９月に千葉工場を閉鎖するなど、生産拠点の集約はすでに実行に移されています。主力の18Ｌ缶市場については国内需要の減少傾向が続くという見方のもとで、改革の柱は高付加価値製品への移行と新規顧客の開拓に置かれています。",
        "basis": "沿革における2025年９月の千葉工場閉鎖の記載と、経営方針における18Ｌ缶市場の需要動向の見方および収益構造改革の取組内容の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1925年の創業以来の金属缶製造の歴史を持ち、本社工場内に印刷工場を備えて美術缶の印刷まで自社で手がけています。関東地区は当社、関西地区は子会社の新生製缶株式会社が製造拠点を持ち、関東地区では当社が同社のＯＥＭ生産も行う分担体制です。",
        "basis": "沿革における1925年の創業と1950年の印刷工場新設の記載、および事業の内容と関係会社の状況における新生製缶株式会社との役割分担の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の金属缶メーカーの一つで、2026年３月期の売上高11,442百万円のうち金属缶製造販売事業が11,278百万円を占め、その中心は18Ｌ缶です。連結従業員数は189人で、連結子会社は新生製缶株式会社の１社です。",
        "basis": "セグメント情報における事業別の外部顧客への売上高（金属缶製造販売事業11,278百万円）の印字と、経営指標等における売上高11,442百万円および従業員数189人の印字に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
