  "history": [
    {
      "year": 2003,
      "title": "位置情報ゲーム「コロニーな生活」の提供を開始",
      "description": "当社取締役会長の馬場功淳が、携帯電話の位置情報送信機能を利用したゲームアプリ「コロニーな生活」の提供を個人事業として開始しました。",
      "significance": "現在の事業の起源です。",
