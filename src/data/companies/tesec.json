  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度を対象期間とする中期計画「Enjoy2.1」を掲げ、基盤戦略として生産工程の標準化・効率化による供給安定性の向上、顧客満足を起点とした営業力・提案力の強化、デジタル化を通じた業務プロセス革新、人材育成と組織体制の再構築を進めるとしています。事業戦略では、テスタ分野でバリュー志向型ビジネスとトータルソリューションの構築、パートナー企業との連携、海外展開を、ハンドラ分野で既存顧客との安定取引の維持と新規市場の開拓、次世代ハンドラの市場投入を掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "テスタとハンドラの両方を自社で開発・製造し、組み合わせた提案ができる点が特長です。米国、マレーシア、中国の販売子会社を通じてアフターサービスまで担い、ハンドラの稼働台数を基盤にチェンジキットなどのパーツ等を継続的に販売する取引も持っています。子会社の嶺光音電機との連携など外部リソースを活用した開発体制の強化も進めています。",
        "basis": "事業の内容に、当社がハンドラ、テスタおよびパーツ等の開発・製造・販売とアフターサービスを行うこと、海外子会社が当社製品の販売とアフターサービスを担うこと、パーツ等がハンドラの稼働台数を基盤とした取引であることが印字され、サステナビリティの戦略に嶺光音電機との連携による開発体制の強化が印字されているため。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "半導体検査装置の専業メーカーとして、パワー半導体向けのテスタとAI関連需要で回復したハンドラを軸に事業を行っています。2026年3月期は連結売上高の77.0％が海外向けで、特定の顧客としてINFINEON TECHNOLOGIES (MALAYSIA) SDN BHDへの売上高596百万円が主要な顧客として開示されています。",
        "basis": "事業の内容に半導体検査装置の製造・販売を単一の事業とすることが、事業等のリスクに海外売上高比率が当期77.0％であることが、セグメント情報の主要な顧客ごとの情報にINFINEON TECHNOLOGIES (MALAYSIA) SDN BHDの売上高596百万円が印字されているため。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
