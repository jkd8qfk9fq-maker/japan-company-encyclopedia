  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパス『豊かなコミュニケーションを広げ、世界を幸せな驚きで包む。』とミッション『「心もつながる」場と機会の創造。』を掲げ、SNS「mixi」や「モンスターストライク」で培ったコミュニケーションサービスのノウハウと、AIなど最新のテクノロジーを活用し、サステナブルな収益基盤の構築を目指しています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「モンスターストライク」を主力とするデジタルエンターテインメント事業が売上高の約半分を占め、スポーツ事業では2025年9月のPointsBetの子会社化により海外のベッティング事業が加わりました。SNS「mixi」で培ったコミュニケーションサービスのノウハウを各事業に生かしています。",
        "basis": "2026年3月期のセグメント別売上高と沿革の記載に基づきます。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
