  "history": [
    {
      "year": 1925,
      "title": "寳酒造株式会社を設立",
      "description": "京都市伏見区に、酒類、酒精、清涼飲料水、調味料などの製造・販売を目的として設立されました。江戸後期の天保年間以降、京都伏見で酒造業を営んでいた四方合名会社を改組したものです。",
      "significance": "現在の宝ホールディングスの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "株式を上場",
      "description": "東京、大阪、名古屋の各証券取引所の開設にあわせて株式を上場しました。その後、取引所の整理・統合を経て、現在は東京証券取引所のみに上場しています。",
      "significance": "公開会社として事業規模を広げる土台になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1982,
      "title": "米国で清酒の製造を開始",
      "description": "米国カリフォルニア州のNUMANO SAKE CO.（現・Takara Sake USA Inc.）の株式を取得し、米国本土での清酒製造を始めました。",
      "significance": "海外で酒類をつくる事業の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "スコットランドにトマーチン蒸溜所の会社を設立",
      "description": "英国スコットランドにThe Tomatin Distillery Co.Ltdを設立しました。翌年にウイスキーメーカーの資産を買収し、スコッチウイスキーの製造を始めました。",
      "significance": "ウイスキーを手がけるきっかけになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2002,
      "title": "持株会社へ移行",
      "description": "酒類・食品・酒精事業とバイオ事業を分割し、新設の宝酒造株式会社とタカラバイオ株式会社が引き継ぎました。当社は持株会社となり、商号を宝ホールディングス株式会社に変更しました。",
      "significance": "現在の「持株会社と事業会社」のグループ体制になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "米国のClontech Laboratoriesを買収",
      "description": "米国カリフォルニア州のClontech Laboratories, Inc.（現・Takara Bio USA, Inc.）の全株式を、Takara Bio USA Holdings Inc.を通じて取得しました。",
      "significance": "バイオ事業が米国で開発・製造・販売する拠点になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "欧州の日本食材卸事業に進出",
      "description": "フランス・パリのFoodex SASの発行済株式の80％を宝酒造を通じて取得し、傘下の子会社とともに連結子会社としました。2015年に残りの20％も取得しています。",
      "significance": "海外の日本食材卸事業の広がりの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "米国の日本食材卸Mutual Tradingを連結子会社化",
      "description": "持分法適用関連会社だったMutual Trading Co.,Inc.の第三者割当増資を宝酒造が引き受け、発行済株式の51％を取得して傘下の子会社とともに連結子会社としました。",
      "significance": "米国で日本食材の卸売業を展開する基盤になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "宝酒造インターナショナルを設立",
      "description": "宝酒造の海外事業を新設分割し、宝酒造インターナショナル株式会社が引き継ぎました。同社の株式は剰余金の配当として当社へ交付され、当社の連結子会社となりました。",
      "significance": "海外事業を担う会社が独立し、現在の報告セグメントの一つになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "市場区分の見直しにより、当社とタカラバイオ株式会社は東京証券取引所の市場第一部からプライム市場に移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "ドイツの日本食材卸Kagerer & Co.を取得",
      "description": "ドイツ・ミュンヘン近郊のKagerer & Co. GmbHの出資持分の90％を、宝酒造インターナショナルを通じて取得しました。",
      "significance": "欧州の日本食材卸ネットワークに水産品を主力とする会社が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "Curio Bioscienceを買収",
      "description": "米国パロアルト市で空間トランスクリプトーム解析用試薬を開発するCurio Bioscience, Inc.の全株式を、Takara Bio USA Holdings Inc.を通じて取得しました。",
      "significance": "バイオ事業が試薬の開発分野を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
