  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年6月に策定した中期経営計画2027（2025年度から2027年度までの3年間）では、素材事業の強化としてビジネスパートナーとの連携強化と新規顧客の開拓、操業改善によるコスト競争力の向上を、加工品事業の拡大としてプレキャスト工場向け製品の拡販とインフラメンテナンス・国土強靭化需要の取り込み、東京加工品営業所の人員拡充を、さらに固定費のコントロールと情報化推進を掲げ、鉄鋼素材から土木・建築向け加工製品までの一貫体制の中で高付加価値製品の開発・拡充により他社との差別化を図るとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "鉄スクラップを電気炉で溶かす製鋼から、圧延による素材製品の製造、土木・建築向け加工製品への加工までを自社工場で一貫して手掛ける体制を持ちます。長岡・三条・雲出・見附・喜多方の各工場に加え、連結子会社が加工・販売と運搬を担い、素材と加工品の両方を供給できます。",
        "basis": "事業の内容における製品と関係会社の役割の記載、主要な設備の状況における工場ごとの設備の内容の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "鉄鋼事業の単一セグメントで、2026年3月期の売上高は23,598百万円でした。建設向け鋼材需要の低迷により販売数量が大きく減少したと会社は分析しています。主要な顧客として伊藤忠丸紅住商テクノスチール株式会社と阪和興業株式会社が印字され、海外への売上高は売上高の10％未満です。",
        "basis": "セグメント情報の主要な顧客ごとの情報と地域ごとの情報の記載、経営者による分析における売上高の分析の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
