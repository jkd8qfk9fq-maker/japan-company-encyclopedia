  "updatedAt": "2026-10-31",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「食と健康」の企業グループとして、2026中期経営計画（2025年3月期〜2027年3月期）の重点戦略に、成長事業への経営資源の投入、安定したキャッシュ創出力の維持・強化、経営戦略に即した人財戦略の推進の3つを掲げています。食品では、国内でヨーグルト、チョコレート、栄養食品に注力し、海外では各地域で差別化した商品を展開して独自のポジションを確立する方針です。医薬品では、感染症治療薬、ジェネリック医薬品、バイオ医薬品を国内外で拡大し、感染症の領域でアジアのリーディングカンパニーになることを目指しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "食品では、海外での成長に向けて、キューブタイプ粉ミルクなどの技術・知財面で競争優位性のある商品や、チョコスナックなどの味や食感の設計、製造技術で差別性のある商品での事業拡大を掲げています。また、食品と医薬品の両方を持ち、赤ちゃんからお年寄りまであらゆる世代の「こころとからだの健康」に貢献するユニークな企業グループとしての強みに磨きをかけるとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
