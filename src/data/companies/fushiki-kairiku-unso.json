  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-20",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業基盤である伏木港、伏木外港万葉埠頭、富山新港が環日本海経済圏の中心に立地する地理的優位性を活かし、対岸諸国との物的・人的交流を推進するとしています。主力の港湾運送事業では、地方港の規制緩和で競争が激化するとの危機意識のもと、コスト削減に努めると同時に、総合的な物流ノウハウを駆使したサービスの充実を図るとしています。対処すべき課題として、伏木富山港における取扱貨物と航路の拡充、国内のモーダルシフトへの注力、デジタル技術や生成ＡＩの活用による業務効率化と事業変革を掲げています。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "外部顧客への売上高では港運事業が全体の約7割を占め、繊維製品製造事業と不動産事業、その他事業が残りを構成する、港湾物流を中核とした多角化の構成になっています。",
        "basis": "【セグメント情報等】の記載に基づきます。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "伏木港、伏木外港万葉埠頭、富山新港が環日本海経済圏の中心に立地する地理的優位性を掲げています。また、本船積卸から通関、輸送、保管までをグループで担う海陸一貫作業と、総合的な物流ノウハウを駆使したサービスの充実を強みとして打ち出しています。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "伏木富山港を拠点とする港湾運送事業者であり、地方港の規制緩和により港湾運送の競争は激化していると会社は認識しています。貨物の輸移入ではウッドチップ、コンテナ貨物、石炭、木質燃料などが主な取扱品目です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】と【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載に基づきます。",
        "asOf": "2026-09-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
