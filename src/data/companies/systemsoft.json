  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 重要な後発事象として、2025年９月18日開催の取締役会において、SES事業やDXコンサルティング事業等を営む株式会社わさび及び株式会社Green&Digital Partnersの株式を取得することを決議し、2025年10月１日に両社を子会社化した旨が記載されています。両社の子会社化は当事業年度末（2025年９月30日）後の事象であるため、本登録は2025年９月期の構造で登録しています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "優れたIT技術により顧客の問題解決に真摯に取り組み、社会に必要とされる会社として貢献することを経営理念とし、既存事業の選択と集中を徹底するとともに、AIやDX、クラウドネイティブ技術など将来の成長が期待される分野において、高い技術力を持つ企業や優秀なデジタル人材を獲得するための戦略的M&Aを最重要課題として推進するとしています。また、人材開発や育成による人材の高付加価値化にも取り組むとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "テクノロジー事業が売上高の約76％を占める一方で、事業の承継や譲渡が続いたことで売上規模は縮小しており、M&Aによる事業ポートフォリオの再構築が進められている構造です。",
        "basis": "セグメント情報に印字された2025年9月期の外部顧客への売上高（テクノロジー事業1,047百万円、オープンイノベーション事業325百万円）と、【経営方針、経営環境及び対処すべき課題等】に印字された事業ポートフォリオの再構築と戦略的M&Aの推進の記載から読み取れます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "Web技術をベースとするシステム開発に強みを持ち、不動産分野、情報通信分野、生損保分野、教育分野等のお客様に対し長年にわたってシステム開発及びソリューションサービスの提供を行っているとしています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "受託型のシステム開発に加えて、賃貸不動産情報サイトの運営やSaaSの提供も手がけており、開発以外の収益経路を持つ構造です。",
        "basis": "【事業の内容】に印字された、賃貸不動産情報サイトの運営に加え、RPAソリューションサービス、SSクラウドシリーズを含めたSaaSの提供を行っている旨の記載から読み取れます。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
