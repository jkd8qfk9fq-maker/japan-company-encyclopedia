  "history": [
    {
      "year": 1920,
      "title": "東洋コルク工業株式会社として設立",
      "description": "東洋コルク工業株式会社として設立されました。1927年9月に東洋工業株式会社へ社名を変更し、1929年4月に工作機械、1935年10月にさく岩機の生産を始めています。",
      "significance": "自動車の会社になる前はコルクや機械をつくる会社でした。創業の地である広島県には現在も本社と本社工場があります。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1931,
      "title": "三輪トラックの生産を開始",
      "description": "三輪トラックの生産を始めました。1958年4月には小型四輪トラックを発売しています。",
      "significance": "自動車をつくる会社としての出発点です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1964,
      "title": "小型乗用車を発売",
      "description": "小型乗用車を発売しました。1960年5月に軽乗用車を発売しており、1966年11月には乗用車専門の宇品工場が本社工場内に完成しています。1961年2月にドイツNSU社、バンケル社とロータリーエンジンの技術提携を結び、1967年5月には初のロータリーエンジン搭載車コスモスポーツを発売しました。",
      "significance": "トラックから乗用車へ広がり、現在の主力である乗用車の事業になりました。宇品工場は現在の本社工場の一部です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1979,
      "title": "フォードモーターカンパニーと資本提携",
      "description": "フォードモーターカンパニーと資本提携しました。1996年5月に同社は当社株式の保有比率を33.4％へ引き上げましたが、2008年11月に13.8％へ引き下げ、その後段階的に売却して2026年3月末時点で同社による当社株式の保有はありません。",
      "significance": "約30年続いた提携で、この間にタイのオートアライアンス(タイランド)Co., Ltd.や中国での合弁が生まれました。それらの会社は現在も持分法適用関連会社として生産を担っています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1984,
      "title": "マツダ株式会社に社名変更",
      "description": "東洋工業株式会社からマツダ株式会社に社名を変更しました。",
      "significance": "現在の商号です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2006,
      "title": "中国で長安汽車との合弁事業に参加",
      "description": "2005年9月にフォードモーターカンパニーおよび長安汽車集団との合弁で長安フォードマツダエンジン有限公司を設立し、2006年3月には長安フォード汽車有限公司へ出資して長安フォードマツダ汽車有限公司に社名変更しました。その後の存続分立を経て、現在の長安マツダ汽車有限公司と長安マツダエンジン有限公司になっています。",
      "significance": "中国での生産・開発の拠点です。長安マツダ汽車有限公司が開発・製造する新型電動車「MAZDA EZ-6」「MAZDA EZ-60」を中国市場へ順次投入しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2014,
      "title": "メキシコ工場で量産を開始",
      "description": "2011年9月に住友商事株式会社との合弁でマツダモトールマヌファクトゥリングデメヒコS.A. de C.V.を設立し、2014年1月に量産車の生産を始めました。その後、住友商事が保有する全株式を当社が取得しています。",
      "significance": "北米向けの生産拠点です。2026年3月期は米国の関税負担が大きいメキシコ製「MAZDA CX-30」の生産を抑制し、グローバル販売台数の減少要因になりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2017,
      "title": "トヨタ自動車と業務資本提携",
      "description": "2017年8月にトヨタ自動車株式会社と業務資本提携に関する合意書を締結し、2018年3月には米国アラバマ州に合弁会社マツダトヨタマニュファクチャリングUSA, Inc.を設立、2022年1月に量産車の生産を始めました。",
      "significance": "米国内に持分法適用関連会社の生産拠点を持つことになりました。マツダトヨタマニュファクチャリングUSA, Inc.は現在も持分法適用関連会社です。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
  ],
