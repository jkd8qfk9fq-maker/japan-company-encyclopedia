  "history": [
    {
      "year": 1917,
      "title": "大阪で創業",
      "description": "初代社長の椿本説三が、個人経営として大阪府西成郡（現・大阪市北区）で創業しました。",
      "significance": "チェーンづくり一筋で続く会社の出発点です。",
