  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年6月26日開催の取締役会で、東京労働局から受給した雇用調整助成金を自主返還することを決定しています。東京労働局からの調査依頼を受けて社内調査を行ったところ、誤認により不適正な申請内容が一部確認されたための措置で、自主返還金額が確定した場合、翌連結会計年度の財政状態及び経営成績に重要な影響を及ぼす可能性があるとされています（重要な後発事象に記載）。本登録は2026年3月31日現在の構造で登録しています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本理念として、教育と文化に「紙」媒体を通じて貢献することを掲げています。全国に網羅した拠点から原紙をタイムリーに配送し、生活必需品である紙を常に安定供給するとともに、取扱商品の多角化に取り組み、安定供給と適正価格販売に努めるとしています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高のほぼ全てを洋紙卸売事業が占める構成で、その他の関係会社である日本製紙との関係を持つ仕入体制と、物流子会社による保管・加工・配送までをグループ内で担う体制を組み合わせています。",
        "basis": "事業の内容、関係会社の状況、セグメント情報の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "その他の関係会社である日本製紙の製品を販売代理店から仕入れる調達関係と、連結子会社の関東流通による保管・加工・配送までをグループ内で担える体制が特徴です。",
        "basis": "関係会社の状況と事業の内容の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の紙流通業界では、デジタル化の推進や企業・官公庁のコスト削減の影響で紙需要全体が減少する厳しい環境が続いています。その中で当社グループは、安定供給と適正価格を維持した販売に努める紙の専門商社として事業を行っています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
