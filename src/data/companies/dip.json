  "businesses": [
    {
      "id": "dip",
      "name": "ディップ株式会社",
      "description": "東京都港区六本木に本社を置き、当社と連結子会社1社（コーポレートベンチャーキャピタルファンド）および持分法適用関連会社2社でグループを構成しています。人材サービス事業とDX事業の2つを報告セグメントとし、2026年2月28日現在の連結従業員数は2,663人です。",
      "sourceIds": [
        "yuho-2026"
