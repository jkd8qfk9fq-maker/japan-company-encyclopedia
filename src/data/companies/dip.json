      "locator": "【事業の内容】",
      "children": [
        {
          "id": "human-resource-service-business",
          "name": "人材サービス事業",
          "description": "インターネット求人情報サイト等を通じて顧客企業の人材採用とその活用を支援する主力事業で、2026年2月期の外部顧客への売上高は48,239百万円です。内訳は、メディア（求人広告）サービス46,048百万円、エージェント（人材紹介）サービス1,848百万円、その他サービス342百万円です。アルバイト・パート求人情報サイト「バイトル」、スポットのバイトサービス「スポットバイトル」、正社員・契約社員向け求人情報サイト「バイトルNEXT」、総合求人情報サイト「はたらこねっと」、専門職の総合求人サイト「バイトルPRO」、看護師人材紹介サービス「ナースではたらこ」、介護職人材紹介サービス「介護ではたらこ」を運営しています。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "dx-business",
          "name": "DX事業",
          "description": "中堅・中小企業に特化した商品設計で機能を絞りパッケージ化したSaaS型のDXサービス「コボット」シリーズを提供し、中堅・中小企業のDX化を支援する事業で、2026年2月期の外部顧客への売上高は6,613百万円です。採用ページコボット、面接コボット、人事労務コボット、HRコボット、常連コボット forLINE、集客コボット for MEO、集客コボット forSNSBoosterなどがあります。",
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【セグメント情報】"
        }
      ]
    }
