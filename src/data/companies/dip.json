  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「私たちdipは夢とアイデアと情熱で社会を改善する存在となる」のもと、ビジョン「Labor force solution company」の実現に向け、2023年に中期経営計画「dip30th」を策定しています。2025年6月からは、顧客規模・エリア別の営業体制から業種別の営業体制（ソリューション体制）へ移行しました。2027年2月期は、従来の掲載課金型に加え新たにCPC（クリック課金）型を導入したハイブリッド戦略を実行し、営業生産性の向上を図るとしています。",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "営業体制を顧客規模・エリア別から業種別へ組み替え、業界専門性を高めて人材・AI・DXを組み合わせた提案を行う体制への移行を進めています。課金方式についても掲載課金のみからクリック課金を組み合わせた方式へ広げており、収益モデルの転換期にあります。",
        "basis": "経営方針の中期経営計画とソリューション体制移行の記載、MD&Aの業績等の概要と2027年2月期の見通し",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "当社の営業人員による売上高の割合（直販比率）は約8割で、新卒入社の若手社員を中心とする営業体制が基盤です。人材サービス事業では、当社の強みである営業力、サービス開発力、プロモーション力を活かし、ユーザーおよび顧客基盤の拡大を目指しています。",
        "basis": "経営方針の優先的に対処すべき課題における直販比率と営業体制の記載、MD&Aのセグメント別の概況",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の売上高54,852百万円の内訳は、人材サービス事業48,239百万円とDX事業6,613百万円で、人材サービス事業が大半を占める構成です。本邦以外への外部顧客への売上高はなく、連結売上高の10％を超える特定の顧客への売上高もありません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報",
        "asOf": "2026-05-20",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
