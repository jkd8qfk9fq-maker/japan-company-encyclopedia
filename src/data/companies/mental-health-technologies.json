  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「ウェルビーイングのスタンダードを創る」というビジョンを掲げ、中核事業のメンタルヘルスソリューション事業では、エンタープライズ顧客の比率向上、一顧客グループ当たりの単価向上、「ELPIS」の導入促進によるクラウドサービス比率の向上、解約率の改善を進めるとしています。メディカルワークシフト事業では、医療機関への経営改善提案力の強化と大規模急性期病院におけるシェア拡大、派遣スタッフの量と質の強化を掲げ、月次経常収益（MRR）を重要な経営指標と位置付けています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2024年２月に株式会社タスクフォースを子会社化して始めたメディカルワークシフト事業が、2025年12月期にはグループ最大の事業となっており、M&Aによる事業の取り込みが成長の進め方になっていることが読み取れます。",
        "basis": "【沿革】における株式会社タスクフォースの子会社化の記録と、セグメント情報における外部顧客への売上高の構成に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "産業医業務を、産業医のみが実施できる業務と、保健師等の専門家やクラウドサービスで代替できる業務に切り分ける仕組みにより、企業の事務負担とコストを引き下げながら従業員の健康管理の質を高められることが強みであるとしています。メディカルワークシフト事業では、医療現場の業務への理解を背景とした改善提案力と、長期間安定的に定着している派遣スタッフの多さが強みであるとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "役務提供とクラウドサービスを一体で提供する形は、産業医の役務提供のみを行う提供者との価格競争に陥りにくい構造になっています。産業医は独自の基準で選定し、紹介後も定期的に再評価する運用が品質の維持に結びついています。",
        "basis": "【事業の内容】における「産業医クラウド」の仕組みと産業医の選定・再評価に関する記述に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "精神疾患の患者数の増加やストレスチェック制度の義務化により企業の健康管理への対応が求められる一方、医師の時間外労働の上限規制の導入で医療機関の人材不足が顕在化しており、同社は産業保健と医療人材の両領域に事業を持つ位置にいます。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】における経営環境の記述と【事業の内容】の事業構成に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
