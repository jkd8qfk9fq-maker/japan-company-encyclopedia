  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画において、産業システム事業の拡大と放送システム事業の安定確保による売上高の拡大を経営課題としています。コア技術であるＩＰ＆Ｔ（撮像・画像処理・伝送技術）の更なる高度化を進め、放送システム事業ではＩＰやクラウド、ＡＩの活用によるトータルシステムソリューションの提案力を強化し、産業システム事業ではメディカル事業のＯＥＭビジネス拡大などに取り組んでいます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期の売上高は前年同期比2.9％増の21,329百万円、親会社株主に帰属する当期純利益は376百万円となりました。放送システム事業では放送局向けのスタジオカメラや中継車システムの納入に加え、官公庁向けのヘリコプター電送システムや受信基地局設備の納入が大幅に伸長しました。産業システム事業ではセキュリティー事業と検査装置事業が堅調に推移した一方、メディカル事業の医療用カメラの販売は低調でした。",
        "basis": "MD&Aの経営成績の概要、セグメント情報の地域ごとの情報および主要な顧客ごとの情報",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1946年の創業以来、撮像・画像処理・伝送技術をコア技術として蓄積し、放送局向けのスタジオカメラから医療用カメラ、検査装置まで映像技術を応用した製品群を展開しています。米国、ドイツ、シンガポールの販売・サービス子会社を通じて海外市場にも対応しています。",
        "basis": "事業の内容、沿革、MD&Aの経営成績の概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報通信機器の単一セグメントであり、最大の顧客である日本放送協会への売上高は連結売上高の12.1％を占めています。地域別の売上高は日本が18,121百万円と大半を占め、北米が980百万円、ヨーロッパが1,056百万円、アジアが1,171百万円となっています。ＭＤ＆Ａでは、放送局における設備の更新需要や官公庁向けの大型案件の納入が当期の売上を支えたとされています。",
        "basis": "セグメント情報の主要な顧客ごとの情報および地域ごとの情報、MD&Aの経営成績の概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
