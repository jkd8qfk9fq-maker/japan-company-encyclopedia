  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「もっとおもしろくできる」のもと、「人類のアウトプットを増やす」をミッションに掲げています。ストック型のビジネスモデルを持つホスティング事業やEC支援事業の安定した収益力を活かし、高単価・高付加価値のストック型サービスの提供やAIを活用したビジネスへの投資を行うほか、ブランド力や顧客基盤、運営ノウハウを活かした新サービスや、シナジー効果の高い関連企業への資金投入により、事業領域の拡大を図るとしています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "レンタルサーバー、ドメイン、ECサイト構築といったストック型のサービスを複数展開し、契約の積み上がりによる安定した収益基盤を持つことが強みです。利用しやすい価格でサービスを提供し、個人や小規模事業者の幅広い利用者を取り込んでいます。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等におけるストック型のビジネスモデルに関する記載に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ECサイト構築サービスの「カラーミーショップ」は月額制のサービスとして国内の店舗数が最も多く、ハンドメイドマーケットの「minne」は国内最大級のマーケットの位置を占めています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における「カラーミーショップ」と「minne」の位置づけの記載に基づく",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
