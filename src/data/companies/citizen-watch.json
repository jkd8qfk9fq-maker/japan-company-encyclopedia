  "history": [
    {
      "year": 1930,
      "title": "シチズン時計を創立し、腕時計の製造・販売を開始",
      "description": "1918年に設立された尚工舎時計研究所を母体に、東京都新宿区高田馬場で会社が創立されました。腕時計の製造と販売を始めました。",
      "significance": "現在の時計事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1941,
      "title": "日東精機を合併し、工作機械の生産を開始",
      "description": "日東精機株式会社を合併し、工作機械の生産を始めました。",
      "significance": "時計に次ぐ柱である工作機械事業のはじまりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に上場",
      "description": "社名を1948年にシチズン時計株式会社へ戻した翌年、東京証券取引所に上場しました。",
      "significance": "戦後の再出発のなかで、株式を公開する会社になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1959,
      "title": "御代田精密を設立",
      "description": "御代田精密株式会社を設立しました。現在はシチズンファインデバイス株式会社として、デバイス事業を担う連結子会社です。",
      "significance": "時計づくりの技術を生かした部品事業の広がりを示します。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1975,
      "title": "米国に販売会社を設立",
      "description": "米国にシチズン・ウオッチ・カンパニー・オブ・アメリカInc.を設立しました。その後、香港やドイツにも販売や製造の会社をつくりました。",
      "significance": "海外展開の足がかりです。この会社は現在、グループの売上高の10％を超える主要な子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2007,
      "title": "持株会社制へ移行し、シチズンホールディングスに商号変更",
      "description": "商号をシチズンホールディングス株式会社に変更し、会社分割により時計事業を担うシチズン時計株式会社などを設立しました。",
      "significance": "事業ごとに会社を分け、それぞれが戦略を立てる体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "米国のBulova Corporationの株式を取得",
      "description": "シチズン時計株式会社が、時計ブランド「ブローバ」を持つBulova Corporationの株式を取得しました。同年、公開買付けで株式会社ミヤノの株式も取得しました。",
      "significance": "海外ブランドの獲得と、工作機械事業の拡大につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "スイスのProthor Holding S.A.の株式を取得",
      "description": "シチズン時計株式会社がProthor Holding S.A.の株式を取得しました。現在はManufacture La Joux-Perret S.A.という連結子会社です。",
      "significance": "スイスで機械式ムーブメントをつくる拠点を得ました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2016,
      "title": "Frederique Constant Holding SAの株式を取得し、シチズン時計に商号を戻す",
      "description": "7月にスイスのFrederique Constant Holding SAの株式を取得しました。10月にはシチズン時計株式会社とシチズンビジネスエキスパート株式会社を合併し、商号をシチズン時計株式会社に変更しました。",
      "significance": "スイス時計ブランドを加え、グループの中心会社名が再びシチズン時計になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "米国子会社がBulova Corporationを合併",
      "description": "シチズン・ウオッチ・カンパニー・オブ・アメリカInc.がBulova Corporationを合併しました。",
      "significance": "米国での時計の販売体制を一つにまとめました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所のプライム市場へ移行",
      "description": "東京証券取引所の市場区分の見直しにより、市場第一部からプライム市場へ移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
