  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「音と映像で社会を豊かに」のもと、中期経営計画（2026-2030）では、ゲーム事業で得られた技術やノウハウ、知見、資金をエンタープライズ事業の研究開発や営業強化に投下して事業領域を拡げ、ゲーム中心の事業構造を、モビリティ、ゲーム、オンラインコミュニケーションをコア事業とした事業構造へ変革することをめざしています。",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設立以来、音声・映像関連の独自技術の研究開発を続けており、ミドルウェアがハードウェアやOSの違いを吸収することで、顧客は多くのプラットフォームへアプリケーションを展開しやすくなります。ゲーム業界で培った技術をモビリティや組込み、クラウドソリューションの分野にも展開していることが土台になっています。",
        "basis": "【事業の内容】にミドルウェアの定義と、プラットフォーム間の違いを吸収して開発を効率化する効果が印字されていること",
        "asOf": "2025-12-15",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
