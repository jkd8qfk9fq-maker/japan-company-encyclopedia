  "history": [
    {
      "year": 1983,
      "title": "前身の株式会社ＣＳＫ総合研究所が設立",
      "description": "当社の前身は、1983年に株式会社ＣＳＫの子会社でソフトウェア技術の研究所として設立された株式会社ＣＳＫ総合研究所です。当初は人工知能等の研究を行い、後にセガの家庭用ゲーム機向け基本ソフト（ミドルウェア）やゲームソフトの開発を手掛けるようになりました。",
      "significance": "会社の起点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2001,
      "title": "ミドルウェア部門が独立し当社を設立",
      "description": "セガが家庭用ゲーム機のハードウェア事業から撤退することになり、株式会社ＣＳＫ総合研究所のミドルウェア事業をセガ以外の各社の家庭用ゲーム機向けに展開するため、同社のミドルウェア部門が独立する形で当社が設立されました。社名のCRIは、前身の英語表記「CSK Research Institute」に由来します。",
      "significance": "現在の会社の設立です。",
      "sourceIds": [
        "yuho-2025",
        "wikipedia"
      ],
      "locator": "【沿革】"
