  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「VISION30」のもと、3ヵ年固定型の中期経営計画「Onyx（オニキス）」を策定し、安定した国内事業基盤を土台としつつ、海外事業およびアフタービジネスの成長を通じて、価値創造型の成長モデルへの転換を目指すとしています。国内ではプライシングの適正化とメンテナンスサービスの強化、海外では北米・欧州を成長ドライバーとして重点的に取り組む方針です。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成は国内セグメントが76.6％、海外セグメントが23.4％で、国内の解体・インフラ工事需要がグループの基盤になっています。当期は国内が前年同期比0.3％増にとどまった一方、海外が5.8％増と伸び、連結売上高の増加は海外の伸びが主因でした。",
        "basis": "セグメント情報等の外部顧客への売上高と地域ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "主力の油圧ブレーカでは自社ブランドの品質と品揃え、販売代理店への安定した部品供給やメンテナンス対応を強みとし、国内の解体アタッチメントで高いシェアの維持を目指しています。林業機械やケーブルクレーンでは用途を絞ったニッチトップ戦略を掲げ、子会社南星機械との営業統合によるメンテナンス体制も生かしています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "解体用建機アタッチメントの専業に近いメーカーで、国内では解体市場の本格化を追い風にシェアの拡大を目指す位置づけです。海外は米国・欧州・アジアの注力市場でも推定シェアは3％から4％にとどまると自社で分析しており、開拓余地が大きい段階にあります。",
        "basis": "経営方針、経営環境及び対処すべき課題等、セグメント情報等の地域ごとの情報に基づく",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
