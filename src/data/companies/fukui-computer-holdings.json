  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度を対象とする中期経営計画では、コアビジネスであるCADシステムの漸進的成長を企図し、データプラットフォーム機能の提供とアプリケーションの拡充に取り組むほか、サービスプラットフォームの展開や共通データ環境の構築を進めるとしています。また、株式会社ダイテックホールディングとの合併により同社の建築設備分野の事業を加え、建設ライフサイクルの全てを網羅する事業体制の構築を目指すとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "CADソフトウェアの使用権と保守による継続的な収益を土台に、プラットフォーム展開と合併による事業領域の拡大で、建設業界のDX需要を取り込む構成になっています。",
        "basis": "中期経営計画の基本方針と、対処すべき課題における合併の位置付けの記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "建築・測量・土木の3分野を揃えた製品群を持ち、建築基準法改正への対応や国が推進するi-Construction、BIM/CIMへの対応を進めていること、使用権と保守によるストック型の収益基盤を持つことが特徴です。",
        "basis": "事業の内容における各事業の記載と、MD&Aにおける法改正や国策への対応の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建設業界向けソフトウェアの専業グループであり、調査・設計分野の建築・測量システムで大きなシェアを持つ一方、市場の中長期的な縮小が見込まれる中で施工・維持管理分野への展開を課題としています。",
        "basis": "経営環境と対処すべき課題の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
