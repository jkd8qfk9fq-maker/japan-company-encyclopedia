  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「新しい道を切りひらく」を合言葉に、持続可能な原材料及び製造への取り組みと、特許を含む新技術による組み立てをベースに商品の開発、一貫製造及び販売を行っています。フードロス・廃棄の削減、環境に配慮した設備導入、3温度帯における垂直統合の深耕、健康志向に応える商品開発、M&Aの推進などの施策により、世代を超えた永続企業として継続的な成長を目指す方針です。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期には、2025年4月に株式会社浜信と同社の子会社である味の浜藤株式会社、株式会社藤兵衛を取得してリテール事業を新たな報告セグメントとし、食品製造販売事業と合わせた2セグメント体制としました。公表方針に掲げるM&Aの推進が、当期に具体的な事業拡大として実行されたことが読み取れます。",
        "basis": "セグメント情報等の報告セグメントの変更に関する事項と企業結合等関係の注記、経営方針、経営環境及び対処すべき課題等の経営戦略等に基づく分析",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "原料調達から生産・販売までを一貫体制で運営し、原料段階からのトレーサビリティを含む品質管理を徹底して、安全・安心な商品の提供を続けています。また、コンビニエンスストア向けに販売する食材や惣菜は、特許技術を含む独自の製造技術を駆使して生産されるため、供給元が限られる商品であると説明しています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "食品製造販売事業の外部顧客への売上高は36,124百万円と連結売上高38,605百万円の大半を占め、主要な顧客である株式会社セブン-イレブン・ジャパン向けの売上高は25,629百万円と開示されています。原料調達から販売までの一貫体制と独自の製造技術を基盤とする事業が、大手顧客との継続的な取引を通じて規模を持っていることが読み取れます。",
        "basis": "セグメント情報等の外部顧客への売上高と主要な顧客ごとの情報、事業の内容の事業の概況に基づく分析",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内では高齢世帯や共働き世帯の増加などを背景に中食市場が成長して食市場全体を牽引し、魚を素材とする惣菜商品は市場に少ない一方で、簡便性や健康志向を背景に需要が高まる傾向にあるとされています。同社は水産素材の惣菜を中心とする食品製造販売事業と、百貨店等での店舗販売を行うリテール事業を展開しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境と、セグメント情報等の報告セグメントの概要に基づく分析",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
