    },
    {
      "year": 1997,
      "title": "米国子会社STI AMERICA Inc.の設立",
      "description": "新東京インターナショナル株式会社が、国産水産品の北米向け輸出窓口と北米産水産原材料の検品・集荷を目的として、米国ワシントン州シアトルにSTI AMERICA Inc.を設立しました。",
      "significance": "海外での調達と輸出の拠点を設けました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
