  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは、60店舗体制の確立に向けて直営店出店に重点を置いた店舗開発に取り組む出店戦略の再構築を進めています。出店候補地に関する情報収集の強化や出店条件の精査に注力し、既存店については改装など様々な見直しを積極的に検討・実施するとともに、店舗数と業務の拡大に対応できる人材の確保・育成に取り組みます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期の売上高は前期比7.1％増の16,246百万円、親会社株主に帰属する当期純利益は同20.7％増の928百万円となり、上場以来の最高益を達成した前期実績をさらに上回る過去最高益を更新しました。会社は、前期にオープンした店舗の通期稼働に加え、アニメコンテンツやVtuber等とのコラボイベントの継続実施、入館料金の改定、2025年12月に開店した「RAKU SPA Station 武蔵小金井」などが増収に寄与したと説明しています。",
        "basis": "MD&Aの経営成績等の状況の概要と経営者の視点による経営成績等の状況に関する分析・検討内容、主要な経営指標等の推移に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "各店舗が地域特性に応じて実施する独自のお風呂・サウナイベントや、アニメコンテンツ・Vtuberとのコラボイベントの継続的な実施により、幅広い客層の獲得を実現したと会社は説明しています。滞在型大型温浴施設の「RAKU SPA」とスーパー銭湯の「極楽湯」の２ブランドで施設形態を使い分け、直営店に重点を置いた出店を進めています。",
        "basis": "【事業の内容】の事業の説明とMD&Aのセグメントごとの経営成績の状況に関する認識及び分析・検討内容に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは「日本」のみで、売上高16,246百万円の全額が国内の温浴事業によるものです。店舗数は2026年６月現在で「極楽湯」・「RAKU SPA」が国内の直営30店舗・フランチャイズ10店舗と海外の系列11店舗、「RAKU CAFE」が国内直営２店舗、パートナー店「ヒナタの杜」が１店舗の合計54店舗です。外部顧客への売上高のうち10％以上を占める相手先はありません。",
        "basis": "【事業の内容】の店舗数の記載とセグメント情報の関連情報（主要な顧客ごとの情報）、【沿革】の店舗数一覧に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
