  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度から2028年度までの中期事業計画を「構造転換の3年間」と位置づけ、「ビジネスモデルを進化、総合力を利益に換える」と「顧客基盤・サービスポートフォリオを拡充、次の成長へ」をテーマに掲げています。投資を行いながら高収益なビジネスモデルへの転換を進め、構築した高収益モデルを全社的に展開し、CXサービス・BPOサービスの売上拡大と収益性の向上を目指すとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "当社は、事業の原点を「優れた人と技術を『仕組み』で融合すること」に置いています。人とは専門性の高いプロフェッショナルのこと、技術とはお客様企業の課題解決に最適なグローバルの最先端技術のことであり、この考えをロゴの「people & technology」に表しています。1966年の創業以来、情報処理アウトソーサーの先駆者として、独立系の総合情報サービス企業として事業を続けてきました。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は、トランス・コスモス自身が提供する単体サービスです。2026年3月期の外部顧客への売上高は、単体サービスが254,286百万円、海外関係会社が99,601百万円、国内関係会社が39,977百万円で、単体サービスが連結売上高393,866百万円の6割を超えます。国内・海外の関係会社は、現地の顧客向けサービスやグループ内の業務を担う位置づけです。",
        "basis": "セグメント情報に2026年3月期の外部顧客への売上高（単体サービス254,286百万円、国内関係会社39,977百万円、海外関係会社99,601百万円、連結売上高393,866百万円）が印字されている。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
