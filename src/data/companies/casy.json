  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「笑顔の暮らしを、あたりまえにする。」をビジョン、「大切なことを、大切にできる時間を創る。」をミッションとし、提供価値を「Omotenashi（おもてなし）×Technology」と定義しています。中期的には家事支援サービス事業の成長を加速して収益基盤と顧客基盤を固め、企業の福利厚生制度としての導入や自治体との連携を進めたうえで、暮らしの中の時間をトータルでサポートする「イエナカ」プラットフォームの構築を目指すとしています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "テクノロジーの面では、蓄積したマッチングデータを活用した相性の考慮や、マッチングが難しい場合にキャスト報酬を変動させるダイナミックプライシング機能などでマッチング機会の最大化を図っています。おもてなしの面では、キャストの行動指針「キャストクレド」の制定や、キャスト同士のコミュニケーション機会・表彰制度、全社員によるサービス報告へのメッセージ返信などでキャストのエンゲージメントを高める取り組みを行っています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年11月期の売上高1,922百万円のうち、お掃除代行・お料理代行が1,803百万円と大半を占め、その他（ハウスクリーニング・整理収納等）が118百万円です。家事支援サービス市場では、共働き世帯の増加や家事のアウトソースへの価値観の変化を背景に需要が増えており、少子化対策を背景とした行政の家事支援事業の拡充も進んでいると説明されています。",
        "basis": "販売実績（サービスの種別ごとの金額）及び経営成績等の状況の概要に印字された金額と市場環境の説明に基づきます。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
