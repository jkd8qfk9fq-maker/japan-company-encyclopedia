  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「いつかの未来を、いつもの日々に～New Normal Acceleration」をパーパスに掲げ、顧客接点を持つ企業に対し、実用性の高い技術を使い販売現場の生産性を高めるコンサルティングを展開する方針です。優先的に対処すべき課題として、持続的な成長のための収益力強化と継続的な事業投資、新規事業による収益源の多様化、組織体制の強化を挙げています。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "通信業界の販売現場で培った接客ノウハウを持ち、接客データの収集・分析による応対品質の可視化や、AIを活用した研修システム「mimik」など、現場の知見と技術を組み合わせたサービスを提供できることが特徴です。",
        "basis": "事業の内容に、通信業界の販売現場の支援から事業を開始したこと、接客時のデータの収集・分析で応対品質を可視化するシステム開発、AIを活用した「mimik」などのソリューション提供が印字されていること",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "コンサルティング事業の単一セグメントで、2025年9月期の売上高は6,103百万円です。主要な顧客の株式会社NTTドコモへの売上高は3,884百万円で、全体の63.6％を占めています。",
        "basis": "セグメント情報等の主要な顧客ごとの情報に、株式会社NTTドコモへの売上高3,884,441千円が印字され、経営者による分析の相手先別販売実績に割合63.6％が印字されていること",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
