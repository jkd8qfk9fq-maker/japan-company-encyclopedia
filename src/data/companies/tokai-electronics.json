  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "前中期経営計画の成果を踏まえ、2028年度を最終年度とする新たな中期経営計画「Always Together2028：AT28」を策定しました。エレクトロニクスのパートナーとして想いや経験を共有し社会や人の生活に役立つことと、安心・安全な社会と緑豊かな環境を創ることをテーマに掲げ、自動車、医療、環境・エネルギー、ＩｏＴ・ＦＡ、ソフトウエアの5つの全社横断プロジェクトの推進やエンジニアリング機能の強化に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "国内3カンパニー、海外のオーバーシーズ・ソリューションカンパニー、システム・ソリューションカンパニーという5つの報告セグメントの体制と、5つの全社横断プロジェクトは、市場分野ごとに顧客へ提案する進め方に対応しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】のAT28と全社プロジェクトの記載と、【事業の内容】のセグメント別の位置付けに基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内営業本部統括の3カンパニーに加え、海外子会社10社による中国、米国、欧州、東南アジアを中心とする販売網を持ち、海外拠点を含めた技術者の増強などエンジニアリング力の強化を進めています。電子部品の販売にソフトウエアやシステム提案を組み合わせる体制も特徴です。",
        "basis": "【事業の内容】の海外販売拠点とセグメント別の位置付け、【経営方針、経営環境及び対処すべき課題等】のエンジニアリング機能の強化の記載に基づきます。",
        "asOf": "2026-06-24",
