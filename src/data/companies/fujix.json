  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "まずは損失の解消を課題として、工業用縫い糸では顧客のニーズや購買志向を把握し直したうえで新たな営業戦略に基づき国内外の製造・販売体制を再構築し、アジア地域におけるシェアの拡大を図ります。手芸及びホビー関連分野では、国内で手芸の「きっかけ」作りに注力して需要を掘り起こすとともに、独自性の高い商品の提案により欧米諸国やアジア各国への販売拡大を目指します。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1921年の創業以来、縫い糸専業として技術と製品開発を蓄積し、1951年に日本初の合繊ミシン糸を開発した実績があります。中国、ベトナム、タイに生産・販売拠点を持ち、衣料品の縫製生産が移行するアジア各地で現地の縫製業者に供給できる体制を備えています。",
        "basis": "【沿革】に1921年の創業と1951年の合繊ミシン糸の開発が、【事業の内容】に中国・ベトナム・タイの連結子会社の製造・販売体制が印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "アジア地域の縫い糸市場における同社グループのシェアは低く、生産体制の対応を含めて競争力を磨くことでシェア拡大による成長の余地があると会社は見ています。欧米の手芸市場でも同社製品のシェアは極めて低く、独自性の高い商品の提案によって販売を広げる可能性があるとしています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、アジア地域の縫い糸市場におけるシェアが低く成長の余地があること、欧米市場におけるシェアが極めて低いことが印字されています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
