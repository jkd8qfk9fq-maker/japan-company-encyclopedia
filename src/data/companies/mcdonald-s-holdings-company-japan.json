  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年2月に公表した中期経営計画（2025年度から2027年度）では、「日本で最も愛されるレストランブランド」であり続け、将来にわたり成長し続けるために、「メニュー・バリュー」「店舗ポートフォリオ・デジタル」「サステナビリティ・ピープル」の3つの領域に注力し、地域に根差したフランチャイズビジネスの強化・拡大を通じて「お客様にとってNo.1」の存在を目指すとしています。経営の基本方針としては、食の安全・安心を徹底し、利便性やQSC（クオリティー、サービス、清潔さ）の高い店舗体験の提供を掲げています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "米国マクドナルド・コーポレーションの商標やノウハウを使えるライセンスを持ち、1971年の日本第1号店以来積み上げてきた直営店舗705店とフランチャイズ店舗2,320店の店舗網と、人材教育のためのハンバーガー大学を持つことが特徴です。",
        "basis": "【事業の内容】と【沿革】の記述、MD&Aの店舗数の表",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
