  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは、2026年７月７日に公表した中期経営計画（2026年５月期－2028年５月期）において、経営ビジョン「あらゆる方々が、いつでも、どこでも『Honeys』にふれることができる」を掲げ、経営方針として既存事業の強化、新たな取り組みの深化、事業基盤の整備を定めています。既存事業の強化では店舗売上の拡大（商品力・販売力の強化、出店・改装）とEC事業の拡大・強化に取り組み、新たな取り組みの深化ではグラシアルッソの拡大と新業態の開発を進め、事業基盤の整備ではDX推進、人材活躍に向けた取り組み、サステナビリティ推進を行うとしています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企画・製造・販売を一貫して行うSPAモデルと、ミャンマー自社工場を活用した高いアセアン生産比率により、高品質な商品を求めやすい価格で安定的に供給できる体制が強みです。全国47都道府県に864店舗を展開する店舗網と自社ECサイトの運営による幅広い顧客基盤を持ち、店舗とECの相互送客にも取り組んでいます。",
        "basis": "事業の内容におけるSPAモデルと生産体制（ミャンマー自社工場・海外生産委託工場）の記載、経営方針及びMD&Aにおけるアセアン生産比率・店舗展開・EC事業の記載に基づく。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "婦人服専門店として国内の単一セグメントで事業を行い、2026年５月期の売上高は56,182百万円です。品目別ではトップスが30,641百万円と最も大きく、ボトムス10,458百万円、外衣7,617百万円、雑貨7,447百万円が続きます。地域別では関東地域の売上高が17,910百万円と最大で、全国864店舗を展開します。外部顧客への売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報等（当連結会計年度より日本の単一セグメントへ変更し記載を省略した旨、並びに関連情報における主要な顧客ごとの情報の省略根拠）、MD&Aに印字された品目別・地域別の販売実績に基づく。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
