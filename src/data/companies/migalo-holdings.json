  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは、2029年３月期にDX推進事業の売上高100億円、DX不動産事業の売上高1,000億円をそれぞれ達成することを中期的な目標としています。DX推進事業をグループの成長の柱として売上高100億円を目指し、DX不動産事業をグループの収益の柱として売上高1,000億円を目指す方針です。AIによる事業再構築とサービス展開に注力し、DX推進事業では積極的なM&Aと優秀な人材の採用を進めるとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "２事業の役割分担が明確で、収益の柱であるDX不動産事業で得た収益資金を、成長の柱であるDX推進事業への投資に回す方針が示されています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営方針・対処すべき課題と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の財務戦略の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、不動産事業の業務のコアをAIを用いてDXしてきた実績を持ち、その知見を外販するDX推進事業を併せ持つことです。顔認証IDプラットフォーム「FreeiD」のマンション向け導入は2026年３月31日現在376棟と前年同時期の1.8倍に拡大し、DX不動産事業ではDX不動産会員191,153人の顧客基盤と、賃貸管理7,272戸・建物管理6,115戸のストック基盤を持ちます。",
        "basis": "【事業の内容】のDX推進事業・DX不動産事業の記載と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント業績、DX不動産会員数、管理戸数の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年３月期の売上高57,532百万円のうち、DX不動産事業が53,247百万円、DX推進事業が4,284百万円を占めます。外部顧客への売上高は本邦の割合が90％を超えます。主要な顧客ごとの情報では、東急不動産株式会社への売上高5,905百万円がDX不動産事業の主要な顧客として印字されています。",
        "basis": "セグメント情報等の報告セグメントごとの外部顧客への売上高と、関連情報（地域ごとの情報、主要な顧客ごとの情報）の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
