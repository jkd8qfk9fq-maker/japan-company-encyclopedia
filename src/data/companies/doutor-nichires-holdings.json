  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "多様化するお客様の心の奥底にある期待感に応える商品とサービスで、ご来店いただくお客様にご満足いただき、地域社会に愛されることでブランド価値を高め、企業価値の最大化を目指します。「飲」と「食」で新たな食文化を創造し、外食産業における日本一のエクセレント・リーディングカンパニーの地位確立を目指します。既存事業の再強化、効率化の徹底、新規出店、シナジー効果の拡大、Ｍ＆Ａによる事業拡大、アジアを中心としたグローバル展開、内部統制の強化に取り組みます。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "ドトールコーヒーの「飲」と日本レストランシステムの「食」という二つの中核事業を持ち、両社の経営資源とノウハウを組み合わせて新しい業態や店舗を生み出す体制です。海外ではシンガポール、台湾、韓国で直営店を運営しています。",
        "basis": "ドトールコーヒーグループの外部顧客への売上高は96,344百万円、日本レストランシステムグループは56,260百万円で、海外事業はシンガポール、台湾、韓国の直営店です。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コーヒー豆の仕入から焙煎加工、直営店とフランチャイズによる販売、コンビニエンスストア等への卸売りまでを一貫して行い、レストランチェーンでは食材の仕入から製造、販売までを手がけています。",
        "basis": "ドトールコーヒーグループはコーヒー豆の仕入、焙煎加工、直営店舗における販売、フランチャイズ店舗への卸売りやロイヤリティ等の収入、コンビニエンスストア等へのコーヒー製品の販売を行い、日本レストランシステムグループは食材の仕入、製造及び販売までを行っています。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
