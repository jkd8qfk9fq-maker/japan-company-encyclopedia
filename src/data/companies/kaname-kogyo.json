  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「環境保全と循環型社会に貢献する企業であること」を企業理念として事業活動の中心に据え、循環型社会の構築と環境保全を追求し、遵法精神を常にもって業に臨むことで着実な成長を目指すとしています。収集運搬・処分事業では、廃棄物に関する高い知識を備えた営業担当者が徹底した法令遵守による安心を提供し、着実な顧客数の増加を図るとしています。リサイクル事業では、リサイクルセンターの改廃・拡張や分別の徹底による品質向上、新たな資源化ルートの開拓により、リサイクル率の向上とさらなる再資源化を推し進めるとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "事業活動に伴い発生するほぼ全ての廃棄物の収集運搬許可を持ち、自社の中間処理施設であるリサイクルセンターを8か所持つため、排出事業者は同社1社との契約で一貫した取扱いができ、法律で定められた事務処理を大幅に簡略化できます。自社開発の配車ソフトで多数の現場と車両を路線のように結ぶ効率的な収集運搬と、自社開発の電子マニフェスト登録サポートシステムによる顧客支援も特徴です。",
        "basis": "事業の内容に、ほぼ全ての品目の収集運搬許可と8つの中間処理施設による一貫取扱い、排出事業者の事務処理の簡略化、自社開発の配車ソフトと電子マニフェスト登録サポートシステムが印字されていること",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業系一般廃棄物の年間取扱量は85,694トン（2024年度）で、2024年度の東京23区における持込ごみ量の約10.2％を占めています。東京23区の全ての区で事業系一般廃棄物の収集運搬業の許可を有し、産業廃棄物については首都圏の各都県市の許可を有しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等に、事業系一般廃棄物の年間取扱量と東京23区の持込ごみ量に占める割合、全区での収集運搬業許可が印字されていること",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
