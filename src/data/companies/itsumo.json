  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「Eコマースで、日本の未来をリードする」のもと、独自支援モデル「いつも．データマーケティング（iDM）」に生成AIを融合させた「iDM×AI」を戦略の中核に据え、「いつも．TX（Total Transformation）」を推進するとしています。TikTok Shopをはじめとするソーシャルコマースへの対応を本格化させ、サービス別に、OneコマースではAIエージェントの開発と実装、協業ブランドパートナーでは新規ブランドの獲得とマルチチャネル展開、共創・自創バリューアップでは取得したブランドの販路拡大、ECプラットフォームではライブコマースの市場拡大に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳では、ブランド公式ECの運営代行（協業ブランドパートナー）が大半を占め、支援サービス（Oneコマース）が継続契約による積み上げ型の収益を担う構成です。新規ブランドの獲得と既存取引先の深耕を進めながら、ソーシャルコマースという新しい販路への体制構築に先行して投資している点が、開示から読み取れる戦略の軸です。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報）に印字されたサービス別の外部顧客への売上高、事業の内容のサービス区分の説明、経営方針に印字されたサービス別の成長戦略に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、戦略立案からサイト運営、マーケティング、物流、顧客対応までECバリューチェーンをワンストップで担えること、複数のECチャネルを統合的に捉えて最適化するクロスチャネル戦略、化粧品や日用品、食品、家電など多様な商材での支援実績、データとテクノロジーと再現性のあるメソッドを掛け合わせた独自の支援モデル「iDM」にあります。自社でもブランド販売とプラットフォーム運営を行い、そこで得たノウハウを支援事業に活かす循環も特徴です。",
        "basis": "事業の内容（事業の特徴）に印字された4つの特徴と、各サービス区分の説明に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のEC（物販）市場は拡大が続くと見込まれるなか、同社はブランド・メーカーのEC事業を支援する専業的な立場で、支援と直販とプラットフォームを組み合わせて展開しています。2026年3月期は、協業ブランドパートナーで当期に取引を開始したブランドが伸長し、売上高は前期から28.2%増えました。",
        "basis": "経営方針とMD&Aに印字された市場環境の記述、セグメント情報の関連情報に印字されたサービス別の外部顧客への売上高、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
