  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "短期の成長戦略として、キャッシュレス決済サービス事業の面的拡大・岩盤化と、端末１台当たりの売上の成長を掲げています。中長期では、決済インフラを梃に店舗の高度化を目的とした「総合流通ソリューション」の提供を通じて新たな収益基盤の構築を目指し、情報プロセシング事業の収益化と、業界のロールアップも視野に入れた積極的なM&Aの活用を掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「クラウド（シンクライアント）型電子決済」を国内で初めて商用化した企業であり、ソフトウエア技術だけでなく自社開発の決済端末によるハードウエアの技術力も蓄積しています。小売事業者のシステムと密接に結合しているためスイッチングコストが高く、利用の多い汎用電子マネーを入口にクレジットやQR・バーコード決済等もセットで販売できるワンストップソリューションが強みです。",
        "basis": "【事業の内容】の［事業の特徴と強み］に、クラウド型電子決済の国内初の商用化、端末サプライヤーとしてのハードウエア技術力の蓄積、大規模なカスタマイズ開発への対応力が競争力の源泉であること、小売事業者のシステムと密接に結合していることからスイッチングコストが高額となることが事業の特徴であること、汎用電子マネーを入口にその他の決済手段もセットで販売できることが強みであることが印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子マネー領域における当社の占有率は2025年時点で41.7％とされています。接続端末台数は121万台を超え、2026年３月期には年間で5.5兆円、28億件の決済を処理する規模に拡大しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、電子マネー領域における当社の占有率が2025年時点で41.7％であることが印字され、【事業の内容】に、2026年３月末現在の接続端末台数が121万台、2026年３月期の年間決済処理金額が5.5兆円、年間決済処理件数が28億件であることが印字されているため。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
