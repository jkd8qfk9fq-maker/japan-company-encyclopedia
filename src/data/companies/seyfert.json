  "history": [
    {
      "year": 1991,
      "title": "就職情報誌「re-quest/QJ」創刊と株式会社セイファートの設立",
      "description": "創業者の長谷川高志が美容業界専門の就職情報誌「re-quest/QJ」を創刊し、同年に株式会社セイファートを設立して広告求人サービスを開始しました。美容学生を対象とした合同会社説明会「re-quest/QJ 就職フェア」も同年に始めています。",
      "significance": "創業です。現在の広告求人サービスの原点となる出来事です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "株式会社ビーキャリアを設立",
      "description": "美容師専門の人材紹介・人材派遣業を営むことを目的として、株式会社ビーキャリアを設立しました。",
      "significance": "紹介・派遣サービスへの進出です。事業の柱が広告求人から人材サービスへ広がりました。",
