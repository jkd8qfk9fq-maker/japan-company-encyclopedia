  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「美容に携わるひとたちとともに、世の中に新しい価値を創造する」というミッションを掲げ、美容師の社会的地位向上や美容室経営者の課題解決を支援しています。中長期の経営戦略として、「コンサルティング型営業」とデジタルの融合により既存商品を拡販して市場シェアの奪還を図る計画であり、主力商品である「re-quest/QJ navi」の業績回復に注力するとともに、「re-quest/QJ 就職フェア」や「beauqet」、「re-quest/QJ agent」、「資格証明」など成長基調にある商品群の拡販を進めるとしています。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "美容業界に特化して30年以上積み上げてきた関係資産が強みです。美容学校は全国270校のうち257校と取引関係があり、美容師向け求人サイトの累計会員数は12万名を超え、就職フェアの年間総来場者数は1.3万名を超えます。約1万店の美容室との関係を基盤に広告・人材・教育のサービスを相互に展開できるほか、英国教育機関「City & Guilds」との提携による国際的な資格プログラムも扱っています。",
        "basis": "【事業の内容】の各商品の説明に印字された、美容学校との取引関係の校数とカバー率、求人サイトの累計会員数、就職フェアの年間総来場者数、関係のある美容室の店舗数、および英国教育機関との業務提携の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "美容業界専門の求人・人材サービスに特化した会社で、単一セグメントの売上高のうち広告求人サービスが約3分の2を占めます。新卒採用では美容学校との関係を起点にフェア、求人サイト、情報誌を連動させており、転職向け求人サイトは2007年から運用している先行商品です。",
        "basis": "【セグメント情報等】の単一セグメントの記載、収益認識注記のサービス別外部顧客への売上高の構成、および【事業の内容】・【沿革】の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
