  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションとして「EMPOWER ARTISTS & CREATORS, ENRICH FAN EXPERIENCE」を掲げ、中期経営計画「Ignite 2027」（2025年度から2027年度を対象とする3ヶ年計画）のもと、コンテンツとソリューションの両セグメントの相乗効果により生まれる新たなIPやサービスの開発を推進し、両セグメントを拡充するための積極的な成長投資を実行していくとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2024年4月の株式会社SKIYAKIとの経営統合で持株会社体制に移行して以降、コンテンツとソリューションの外部顧客への売上高が拮抗する構成となり、2026年3月期はソリューションが最大のセグメントとなりました。統合の狙いである、コンテンツとテクノロジーを併せ持つ企業体としての体制が形になってきています。",
        "basis": "セグメント情報の外部顧客への売上高と、沿革、MD&Aの経営成績の状況に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "音楽専門チャンネル「スペースシャワーTV」以来のコンテンツの制作・運営の蓄積に加え、ファンプラットフォーム「Bitfan」などのテクノロジー基盤をグループ内に併せ持つ点が特徴です。アーティストへのソリューション提供と、ファンへのコンテンツや感動の提供を一体で手がけています。",
        "basis": "事業の内容と、セグメント情報の報告セグメントの概要、MD&Aの経営成績の状況に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "音楽・エンタテインメント分野で、イベントの主催から有料放送、ファンプラットフォーム、楽曲の流通までを手がける企業グループです。売上高の10％以上を占める顧客はなく、地域別では本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "セグメント情報の関連情報（地域ごとの情報・主要な顧客ごとの情報）と、事業の内容に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
