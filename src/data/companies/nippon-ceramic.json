  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ステークホルダーの満足度を継続的に高め、真価のある製品を社会に納めることにより人類に貢献すると同時に企業価値を向上させることを経営の基本方針としています。世界的にトップシェアの位置にあるセンサ分野では、さらなるシェアの向上と新しい用途開発を強力に推進していく方針です。安全・安心・省エネ及び車載関連の電子部品需要の拡大を見据え、フィリピン新工場における製造ラインの整備や成長分野への積極的な投資を推進し、自動化設備の導入や製造工程の合理化による生産性と品質の向上を図ります。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "MD&Aでは、車載向け製品が堅調なADAS需要や自動車生産台数の回復を背景に好調だったこと、セキュリティ向け製品の販売が拡大したこと、照明・家電向け製品の在庫調整が一巡したことが、2025年12月期の増収の要因として挙げられています。",
        "basis": "MD&Aの経営成績の概要に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1975年の創業以来、センサ製品に特化して技術を蓄積してきました。超音波送受信具や焦電型赤外線センサで日本と米国の特許を取得し、鳥取の先進技術開発研究所ではMEMS技術による生産と研究開発を行っています。生産は国内のほかフィリピンと中国の子会社が担い、販売は英国と香港の子会社も担う体制です。",
        "basis": "沿革、主要な設備の状況、関係会社の状況に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高27,325百万円のうち、顧客の所在地別では日本が15,358百万円で、残りは欧州、アジア、北南米向けと、海外向けが4割超を占めます。最大の販売先である株式会社中外への販売実績は、全体の22.2％を占めています。",
        "basis": "セグメント情報の関連情報（地域ごとの情報、主要な顧客ごとの情報）に基づく",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
