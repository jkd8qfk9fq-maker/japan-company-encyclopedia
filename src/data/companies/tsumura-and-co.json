  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスは「一人ひとりの、生きるに、活きる。」、経営理念は「自然と健康を科学する」、企業使命は「漢方医学と西洋医学の融合により、世界で類のない最高の医療提供に貢献します」です。長期経営ビジョン「TSUMURA VISION “Cho-WA” 2031」と第2期中期経営計画（2025年度－2027年度）を掲げ、2027年度の売上高2,340億円を目標としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "原料生薬の栽培と調達から製造、販売までを一貫して行う漢方バリューチェーンを持ち、医療用漢方製剤129処方をそろえています。中国にも原料生薬の調達と中薬の製造販売の拠点を広げています。",
        "basis": "漢方バリューチェーンを通じて事業を行い、医療用漢方製剤129処方を販売していることが有報に記載されています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
