  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度から2026年度までの3年間を計画期間とする中期経営計画『地域とこうぎんの「みらい」第Ⅰ期：展望の共有』を進めています。高知銀行を地域の「わくわく（＝価値）」が集まる新世代ターミナルと見立て、専門担当者を置くコンサルティングの強化、店舗網の見直しとデジタル化による顧客体験の再設計、人的資本経営に基づく人事制度改革などを基本戦略としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "高知市に本店を置き、高知県内を中心とする営業基盤を持ち、銀行本体に加えてリース、クレジットカード、銀行業務に付随する業務、地域商社業務までをグループで手がけています。ソリューション提供・イノベーション推進室や資産運用センターに専門担当者を置き、事業者の課題解決や資産形成の提案を行う体制も特徴です。",
        "basis": "【事業の内容】・【経営方針、経営環境及び対処すべき課題等】の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "高知県高知市に本店を置く第二地方銀行で、通称は「こうぎん」です。2026年3月期のサービス別の経常収益は、貸出業務が10,942百万円、有価証券投資業務が7,698百万円、リース業務が6,206百万円、その他が3,531百万円です。本邦の外部顧客に対する経常収益が連結経常収益の90％を超えており、国内の顧客が中心です。",
        "basis": "【セグメント情報】の記載とWikipediaの補足",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026",
          "wikipedia"
        ]
      }
    }
  },
