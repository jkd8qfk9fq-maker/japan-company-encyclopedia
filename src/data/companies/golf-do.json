  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "新中期経営計画「Breakthrough 2028」のもとで、ゴルフドゥ！店舗網の更なる拡大、オムニチャネル戦略の推進、ゴルフ関連商品の取り扱いの拡大、インドアゴルフ練習場の成長を重点施策としています。成長の原動力である「ゴルフドゥ！オンラインショップ」には積極的かつ優先的に投資を続け、「ＤＯＤＯ ＧＯＬＦ」は新たな収益の柱への成長を目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ゴルフクラブの買取りと販売を一つの店舗網で行うリユース専門の事業モデルで、2026年3月31日現在で直営24店舗とフランチャイズ45店舗の合計69店舗に、自社ECサイトとECモール内の店舗を組み合わせた販売網を持っています。",
        "basis": "【事業の内容】の事業構成と、財政状態及び経営成績の状況の概要に印字された店舗数に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "リユース市場では中古品への抵抗感の減少や節約需要、インバウンド需要で中古品の需要が増え、買取りの競争も活発になっているとされ、その中で価格面で優位性のある中古クラブへの需要は底堅いとされています。",
        "basis": "財政状態及び経営成績の状況の概要のリユース市場とゴルフ用品市場の記載に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
