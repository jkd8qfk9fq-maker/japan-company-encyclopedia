  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期を初年度とする3ヵ年の中期経営計画「Next 2028」では、「真のグローバル企業体制の構築」「付加価値創造型企業への進化」「サステナブルな成長を実現する企業基盤の構築」を基本方針とし、海外では北米を中心とした事業の成長、国内ではご飯盛付けロボットFuwaricaの市場拡大、生産では新工場でライン生産方式への変更による生産能力の向上に取り組むとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "寿司ロボットやご飯盛付けロボットなど米飯加工機械に製品を絞り、北米とASEANに販売子会社を持って世界各地の商社等とも組み合わせる販売体制を持っています。製造だけでなく、衛生資材や店舗システムまで食の現場で使う製品・サービスをあわせて提案できる構成です。",
        "basis": "事業の内容に、米飯加工機械の製造・販売を当社が行い、海外は北米を子会社のSuzumo International Corporation、ASEAN地域をSuzumo Singapore Corporation、その他の地域を国内外の商社等を通じて販売すること、衛生資材関連と店舗システム関連の事業内容が印字されているため。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "1981年に世界初の量産型小型寿司ロボットを開発し、世界の90ヵ国以上に寿司ロボットを販売する世界シェアNo.1企業へと成長したとしています。国内では、当社が市場シェアの約80％を占める寿司ロボットの市場は成熟期を迎えているとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
