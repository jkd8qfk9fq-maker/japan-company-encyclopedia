  "perspectives": {
    "competitiveAdvantage": {
      "analysis": {
        "asOf": "2026-02-19",
        "basis": "【事業の内容】と【沿革】の記載",
        "sourceIds": [
          "yuho-2025"
        ],
        "text": "販売、整備、買取という車両に関わる一連の流れを1つの店舗でワンストップで行える体制を持ち、買取ではお客様からの直接仕入を増やして、オークションに依存しない仕入ルートを開拓しています。2025年には全都道府県への出店を実現し、全国242拠点の店舗網で事業を行っています。"
      }
    },
    "industryPosition": {
      "analysis": {
        "asOf": "2026-02-19",
        "basis": "【事業の内容】および経営成績の分析にある販売実績（2025年11月期）",
        "sourceIds": [
          "yuho-2025"
        ],
        "text": "2025年11月期の売上高は652,072百万円で、販売台数は445,862台でした。拠点数は中古車販売が125拠点、新車販売が52拠点、買取単独店が65拠点で、地域別の売上高は東海北陸地方と関東甲信越地方が大きい構成です。"
      }
    },
    "strategy": {
      "disclosed": {
        "asOf": "2026-02-19",
        "locator": "【経営方針、経営環境及び対処すべき課題等】",
        "sourceIds": [
          "yuho-2025"
        ],
        "text": "経営理念『みんなに愛されるクルマ屋さん』のもと、お客様の生涯のカーライフに寄り添い、販売だけでなく整備、車検、買取と次のクルマの提案まで一貫したサービスを提供して、生涯取引の拡大を進めています。中長期の経営戦略として、地域一番店の実現、店舗の収益性向上、専門性・課題解決力の高い人材育成の強化、商品管理の強化の4つを重要な取り組みに掲げています。"
      }
    }
  },
