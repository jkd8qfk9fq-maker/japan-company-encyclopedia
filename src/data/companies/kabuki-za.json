  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "歌舞伎の殿堂である『歌舞伎座』が多くの人に楽しんでもらえる場であるよう、快適で安心・安全な劇場環境と、歌舞伎座ならではの食やサービスを提供していく方針です。不動産賃貸事業では保有物件の価値向上に努め、広告媒体の活用などによる収益向上と、劇場や附帯施設の保全業務を計画的に実施できる体制づくりを進めます。売店事業では、増加傾向にある外国人観光客に魅力的な商品を揃え、マーケティングや在庫管理に注力します。",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本で唯一の歌舞伎専用の劇場である『歌舞伎座』の土地と建物を所有し、興行を行う松竹株式会社へ長期的に賃貸していることに加え、劇場内と地下広場で食堂と売店を自ら運営し、観劇に訪れる来場者の食と買い物の需要を劇場の中で取り込める体制が強みとして読み取れます。",
        "basis": "事業の内容における賃貸と食堂・売店の運営の記載、関係会社の状況における松竹株式会社との関係、および歌舞伎座が日本で唯一の歌舞伎専用劇場であることに基づく",
        "asOf": "2026-05-26",
        "sourceIds": [
          "yuho-2026",
          "wikipedia"
        ]
      }
    }
  },
