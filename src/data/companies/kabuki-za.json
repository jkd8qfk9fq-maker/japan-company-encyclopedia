  "history": [
    {
      "year": 1949,
      "title": "株式会社歌舞伎座を設立",
      "description": "戦後、東京大空襲で焼失した歌舞伎座の復興に際し、株式会社歌舞伎座が設立されました。敷地は所有者の松竹株式会社から借り受け、劇場は演劇の興行を行う松竹株式会社に賃貸する形で出発しました。",
      "significance": "現在の歌舞伎座グループの出発点であり、不動産の所有・賃貸を軸とする事業の形がこの時点で定まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1951,
      "title": "劇場『歌舞伎座』が開場",
      "description": "1950年12月に劇場が竣工し、1951年1月に歌舞伎座が開場しました。",
      "significance": "戦後の歌舞伎興行の拠点が再建され、当社の賃貸事業の中核となる劇場が稼働を始めました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1952,
      "title": "東京証券取引所に株式を上場",
      "description": "当社の株式が東京証券取引所に上場しました。",
      "significance": "上場企業としての歩みが始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1954,
      "title": "食堂・売店を担う子会社を設立",
      "description": "劇場内の食堂や売店を担う株式会社歌舞伎座サービスが設立され、同年に歌舞伎座サービス株式会社へ社名変更しました。",
      "significance": "現在の連結子会社につながる、劇場内の食と物販の担い手が設けられました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
      "title": "建替えのため劇場を閉場",
      "description": "建替えのため、2010年4月末日をもって劇場歌舞伎座が閉場し、劇場や歌舞伎座ビルなどが取り壊されました。",
      "significance": "約60年使われた劇場の建替えが始まり、完成までの間は事業の中心を欠く転機となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "現在の連結子会社・歌舞伎座サービス株式会社が発足",
      "description": "歌舞伎座サービス株式会社と歌舞伎座事業株式会社が合併し、歌舞伎座サービス株式会社が存続会社となりました。",
      "significance": "食堂・飲食事業と売店事業を担う現在の連結子会社の体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
