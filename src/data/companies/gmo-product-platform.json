    "strategy": {
      "disclosed": {
        "text": "ビジョンとして「世の中によいプロダクトを増やしていく」を掲げ、プロダクトの継続的改良と商品力の強化、グループシナジーの創出と事業領域の拡大、AI活用を含めた人材の育成と組織基盤の強化を主要な課題として取り組むとしています。",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "提携先のパネルと合わせた国内の調査パネルは3,841万人、アジア15の国と地域の調査パネルは3,217万人を超え、アジア最大級の規模を持つことが特徴です。調査業務を一貫して受託する運用と、顧客が自ら調査を実施できるツールの提供を同じ基盤で行っていることも強みです。",
        "basis": "事業の内容における調査パネルの規模とサービス形態の記載に基づく",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の調査パネルは国内最大規模、アジアの調査パネルはアジア最大級と位置づけられており、調査会社や事業会社に向けて日本とアジアの市場調査の基盤を提供しています。",
        "basis": "事業の内容における調査パネルの記載に基づく",
        "asOf": "2026-03-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
