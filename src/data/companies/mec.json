  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年ビジョンの実現に向けた第二期として「Phase2 中期経営計画（2025～2027）」を進め、「創造と変革」を指針に、高密度電子基板向け製品の開発や販売、新たな市場への技術展開に取り組んでいます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "売上高の伸びは、生成AI関連など先端半導体パッケージ基板や、パソコン・スマートフォンなどの汎用半導体パッケージ基板向けの薬品需要が堅調だったことによるものです。",
        "basis": "MD&Aの経営成績の概要（売上高の内訳と製品別の売上動向）と、セグメント注記の外部顧客への売上高に基づきます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "密着向上剤のCZシリーズは半導体パッケージ基板向けに高いシェアを持ち、エッチング剤のEXEシリーズはディスプレイ用COF基板向けに高いシェアを持つとされています。",
        "basis": "【事業の内容】の製品説明（CZシリーズとEXEシリーズのシェアに関する記述）と、MD&Aの製品別売上動向に基づきます。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
