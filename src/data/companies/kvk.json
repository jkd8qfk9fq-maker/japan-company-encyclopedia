  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年に向けた長期ビジョン「Vision2030」において、「ＫＶＫブランド価値を高め、世界中の人々から必要とされる水まわりのリーディングカンパニー」を目指します。2027年3月期を初年度とする3ヵ年の中期経営計画では、「営業力・商品力の進化」「生産力の進化」「サステナビリティ視点での経営基盤の強化」に取り組む方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の大部分は日本のセグメントが占め、中国セグメントの外部顧客への売上高は486百万円にとどまります。中国とフィリピンの子会社は主に当社への供給拠点であり、販売は日本を中心とする体制です。新設住宅着工戸数が減少傾向にあるなか、リフォーム需要に対応するマルチリフォーム水栓シリーズの拡充を進めています。",
        "basis": "セグメント情報のセグメント別売上高、関連情報の主要な顧客ごとの情報、地域ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1949年の創業以来、給水栓を中心とする水まわり製品の専門メーカーとして事業を続けてきました。日本・中国・フィリピンの3拠点による生産体制と、ＫＰＳ（KVK Production System）活動による生産効率の追求、販売代理店・特約店で構成する全国ＫＶＫ会を通じた販売網が特徴です。",
        "basis": "事業の内容の記述、沿革の記録、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内の住宅市場では、少子高齢化や世帯数の減少により新設住宅市場は将来的に縮小していくと見込まれる一方、住宅リフォーム需要は堅調に推移すると予想されています。当社は給水栓等の専門メーカーとして、リフォーム対応商品の拡充と得意先への受注活動で対応しています。主要な顧客であるタカラスタンダード株式会社への販売が売上高の1割強を占めています。",
        "basis": "セグメント情報のセグメント別売上高、関連情報の製品及びサービスごとの情報、地域ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
