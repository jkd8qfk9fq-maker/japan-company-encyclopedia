  "history": [
    {
      "year": 1922,
      "title": "設立し、名古屋瓦斯㈱を買収してガス事業を開始",
      "description": "1922年7月に設立され、名古屋瓦斯㈱を買収してガス事業を始めました。",
      "significance": "現在の東邦瓦斯の出発点です。その後、周辺のガス会社を取り込みながら事業の範囲を広げていきました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1949,
      "title": "東京・名古屋・大阪の証券取引所に上場",
      "description": "1949年5月、東京・名古屋及び大阪証券取引所に当社株式を上場しました。",
      "significance": "株式を公開した年です。2022年4月からは東京証券取引所プライム市場と名古屋証券取引所プレミア市場に上場しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1977,
      "title": "知多LNG共同基地が稼働し、LNGの導入を開始",
      "description": "1977年9月、知多ＬＮＧ共同基地が操業を開始し、インドネシアＬＮＧの導入を始めました。",
      "significance": "ガスの原料を石炭や石油系から液化天然ガス（ＬＮＧ）に切り替えていく流れの始まりです。以後、豪州（1989年）、マレーシア（1995年）、カタール（2000年）などから順にＬＮＧを受け入れています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 1978,
      "title": "天然ガスへの転換を開始",
      "description": "1978年6月、供給するガスを天然ガスに転換する作業を始めました。1993年5月に転換が完了しました。",
      "significance": "供給ガスの熱量が1m3当たり18.83723MJから46.04655MJへ変わる大きな切り替えで、約15年かけて完了しました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2003,
      "title": "合同瓦斯㈱、岐阜瓦斯㈱、岡崎瓦斯㈱を合併",
      "description": "2003年4月、合同瓦斯㈱、岐阜瓦斯㈱、岡崎瓦斯㈱を合併しました。",
      "significance": "かつて別々の会社だった地域のガス事業が1社にまとまりました。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2008,
      "title": "桑名市から一般ガス事業を譲り受け",
      "description": "2008年4月、桑名市から一般ガス事業を譲り受けました。",
      "significance": "三重県のガス供給区域が広がった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2012,
      "title": "豪州イクシスLNGプロジェクトの権益売買契約を締結",
      "description": "2012年1月、豪州イクシスＬＮＧプロジェクトの権益売買契約を締結しました。",
      "significance": "ガスを買うだけでなく、海外のＬＮＧ開発にも出資する形に広がりました。現在は、海外の天然ガス等の開発・投資をグループ会社が行っています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2013,
      "title": "伊勢湾横断パイプラインの運用を開始",
      "description": "2013年9月、伊勢湾横断パイプラインの運用を始めました。",
      "significance": "愛知県と三重県を結ぶガス輸送の道が加わりました。2009年10月には輸送幹線の環状化も完成しています。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2016,
      "title": "小売電気事業に参入",
      "description": "2016年4月、小売電気事業に参入しました。",
      "significance": "ガスに加えて電気も売るようになり、現在は報告セグメントの「電気」にあたります。2026年3月期末の電気のお客さま数は71万6千件です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "一般ガス導管事業等を東邦ガスネットワーク㈱へ承継",
      "description": "2021年4月に東邦ガスネットワーク㈱を設立し、2022年4月に一般ガス導管事業等を会社分割の方法により同社へ承継しました。",
      "significance": "ガスを運ぶ導管の事業が別会社になりました。現在、同社はガスの託送供給とガス供給のための配管工事を担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場・名古屋証券取引所プレミア市場へ移行",
      "description": "2022年4月、市場区分の見直しにより、各市場第一部から東京証券取引所プライム市場及び名古屋証券取引所プレミア市場へそれぞれ移行しました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ]
    },
    {
      "year": 2025,
      "title": "カナダからのLNG導入を開始",
      "description": "2025年7月、カナダＬＮＧの導入を始めました。",
      "significance": "ＬＮＧの調達先が広がりました。カナダからの受入れ開始は、ＬＮＧ調達地域の分散の一環です。",
      "sourceIds": [
        "yuho-2026"
      ]
    }
