  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「デジタルを簡単に、社会を豊かに」というミッションのもと、主力プロダクト「Yappli」を中核に、ウェブ構築の「Yappli WebX」、モバイルオーダーの「Yappli MobileOrder」、LINEミニアプリ向けの「Yappli MiniApp」へプロダクトを広げるマルチプロダクト戦略を進め、アプリ・ウェブ・LINEのデジタル接点を統合管理するデジタルエクスペリエンスプラットフォーム（DXP）の実現を目指しています。ソリューションではマーケティング領域とHR領域の2軸に注力し、シナジーの見込める企業との提携やM&Aも活用する方針です。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「Yappli」は、プログラミング不要で開発・運用・分析を一手に担えるプラットフォームとして、スクラッチ開発を外注する方式と差別化されています。創業前から累計10年以上の開発の蓄積があり、大企業への提供に強みがあります。2025年12月末の契約アプリ数は939、月次解約率（直近12カ月平均）は0.92％で、契約が積み上がる構造です。",
        "basis": "【事業の内容】のプロダクト説明と主要KPI（契約アプリ数・月次解約率）、【経営方針、経営環境及び対処すべき課題等】の競合環境の記述に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内ではDXの進展とIT人材の不足を背景にSaaS市場が拡大しており、スマートフォンアプリの必要性も高まっています。当社グループの売上は月額利用料を中心とするストック型が大部分を占め、契約数の構成では顧客向け公式アプリのマーケティング領域が62％と中心です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の市場環境の記述と、【事業の内容】の契約数構成比および収益認識注記の分解情報に基づく",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
