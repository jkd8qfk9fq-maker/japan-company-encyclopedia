  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "新たな中期経営計画の達成に向け、国内では新製品の上市をはじめとする営業活動の強化と販売価格の改定により収益性の向上を図り、仕入先の変更による原価低減にも努めるとしています。海外販売ではインド及び東南アジア地域への販路拡大を積極的に進め、将来の事業の柱となる海外販売事業の基盤構築に向けて取り組みを強化するとしています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "シリコーン樹脂の医療分野への用途開発から出発し、国産初のオールシリコーンフォーリーカテーテルを製品化した素材と製品の技術蓄積を持ち、日本・中国・ベトナムに生産拠点を展開している点が特徴です。",
        "basis": "【沿革】に1974年の設立時にシリコーン樹脂の医療分野における用途開発に着手したこと、1978年に国産初のオールシリコーンフォーリーカテーテルの製品化に成功したことが印字され、【関係会社の状況】に大連・ベトナムの製造子会社が印字されている。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "製品区分では泌尿器系が2025年12月期の外部顧客への売上高6,613百万円で全体の最大を占め、次いで消化器系が4,065百万円であり、この2区分が売上の中心です。",
        "basis": "【セグメント情報等】の製品及びサービスごとの情報に、2025年12月期の外部顧客への売上高として泌尿器系6,613,700千円、消化器系4,065,945千円が印字されている。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
