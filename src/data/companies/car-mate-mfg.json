  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「CREATE―創造―」を掲げ、お客様に納得・満足してもらえる、環境に配慮した「安全・安心なモノづくり」を目指す方針です。新製品・新サービスの市場導入強化、海外市場への積極的な展開による輸出の増加、新規チャネル・新規顧客の開拓、新ビジネスモデルへの取り組みを進めています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は、主力の車関連事業でチャイルドシート類やドライブレコーダーが減収となり、前期比6.2％減の14,563百万円でした。一方、アウトドア・レジャー・スポーツ関連事業は主力のスノーボード関連製品が増収となり、売上高は前期比13.6％増の1,709百万円でした。",
        "basis": "MD&Aの経営成績の分析と、セグメント情報の外部顧客への売上高に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "製品開発は日本と中国の二極体制で展開し、「技術融合によるオンリーカーメイトな新製品」の開発を目指すことが示されています。11ジャンルにわたる製品開発部門と次世代製品の研究部門を併せ持ち、技術者は総勢100名超が在籍しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【研究開発活動】"
      },
      "analysis": {
        "text": "製造は茨城県の結城工場と中国・深センの連結子会社が担い、設計・開発から製造までをグループ内で行う体制です。車用品の幅広い部門（車用品、運搬架台・タイヤ滑止、ケミカル類、電子・電気機器）を一社で手がけています。",
        "basis": "事業の内容、研究開発活動、主要な設備の状況に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
