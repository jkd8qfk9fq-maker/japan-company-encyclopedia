  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期から2028年3月期を対象とする中期経営計画を踏まえ、翻訳支援ツール（CAT）、機械翻訳（MT）、大規模言語モデル（LLM）などの自然言語処理技術を活用したサービスの提供と、データ分析に基づく営業・マーケティングを推進するとしています。対処すべき課題として、AI・データの活用による事業競争力の強化、プロジェクトマネージャの業務効率化、資本効率を重視した事業ポートフォリオの最適化による安定した収益基盤の確立を挙げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、通訳事業の売上高が3期連続で過去最高を更新する一方、翻訳事業は米国の通商政策に対する不透明感を背景に自動車関連企業などからの受注が減少し、連結売上高が前期を下回りました。通訳事業の伸びが翻訳事業の減少を一部補う形になっています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の売上高の推移と増減理由の記述による。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "特許、医薬、工業・ローカライゼーション、金融・法務という専門分野ごとに顧客と文書の種類が異なる翻訳をそろえ、翻訳だけでなく通訳・派遣までをグループで担うことで、専門特化サービスの集合体として顧客企業のグローバルコミュニケーションを包括的に支援できる体制があります。",
        "basis": "事業の内容における分野別の事業内容と関係会社の状況、経営方針における専門特化サービスの集合体としての強みの記述による。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "翻訳業界は企業のグローバル展開を背景に市場が堅調に推移する一方、AI技術の向上で機械翻訳を活用した新しい商品・サービスの開発が進み、大きな変革期を迎えています。同社は機械翻訳や大規模言語モデルなどの技術活用を競争力強化の課題に位置付けています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における翻訳業界・派遣業界・通訳業界の環境認識の記述による。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
