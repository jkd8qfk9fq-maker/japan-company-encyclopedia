  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "日本の製造業をソフトウエア技術で支えることを経営の中心とし、提案から開発・運用までのワンストップソリューションの提供や、新しい技術への挑戦と提案などを経営方針に掲げています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "SDV化の進展に対応して電動化や先進安全の領域で体制を強化し、製造業向けにはPlusFORCEやmcframeを活用したDX支援、公共分野ではヘルスケアを重点領域として取り組んでいます。人材への教育投資やM&Aによる人材獲得も進めています。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】に、SDV化に対応して電動化領域（EV）及び先進安全（ADAS）技術を中心に体制強化を進める旨、PlusFORCEやmcframeによる製造DX支援に取り組む旨、公共ヘルスケア分野を重点領域とする旨、人材への教育投資やM&Aを通じた人材獲得を推進する旨が印字されています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "車載分野をはじめとする開発で長年蓄積した品質管理ノウハウと技術力を持ち、開発規模に応じて機動的に開発要員を確保・投入できる開発体制が強みです。",
        "basis": "【事業の内容】に、継続的な開発支援を通じて培った品質管理ノウハウ、技術力及び開発体制を強みとしている旨と、開発要員の確保・投入とプロジェクトマネジメント能力が重要な成功要因である旨が印字されています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "独立系のソフトウエア開発会社として自動車などの製造業を中心に開発を担い、金融・公共分野では大手SIerのパートナー企業の一員として大型プロジェクトに参加しています。",
        "basis": "【事業の内容】に、当社及び連結子会社は独立系ソフトウエア開発会社である旨と、金融・公共関連事業では大手SIerの協力会社として開発を受託している旨が印字されています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
