  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "首都圏エリアでファミリータイプを中心とした「クレストシティ」「クレストレジデンス」などクレストシリーズのマンションを提供し、ハイグレードマンションへのこだわりを持って、専門の部署を通して設計・施工の各工程に関与し品質管理を徹底するとともに、企画、販売からアフターフォローまでのトータルサービスを行います。用地の仕入れ競争が厳しく建築費も上昇する中、強い需要の見込める都心及び都心近郊部に経営資源を集中し、仕入れ競争力、商品開発力、営業力を向上させることを課題としています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約3分の2を占める不動産分譲事業を中核に、分譲したマンションの管理受託や賃貸、ホテル運営という継続的な収益源を組み合わせる構成です。用地取得では利益の見込める用地を選別して取得する方針が示されており、分譲市況の変動に対して仕入れの段階で収益性を確保する進め方とみられます。",
        "basis": "セグメント情報の報告セグメントごとの売上高、関連情報、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "企画、販売からアフターフォローまでをグループで一貫して担い、専門の部署を通して設計・施工の各工程に関与して品質管理を徹底する体制が開示されています。分譲後の管理を子会社が担うことで、顧客の意見を次のマンションづくりに生かす循環を作っています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の会社の経営の基本方針、事業の内容",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "首都圏の新築分譲マンション市場で事業を展開し、供給戸数は2022年12月に累計30,000戸を突破しました。市場では建設費の高騰により販売価格が上昇し供給戸数は低水準で推移する一方、住宅取得支援政策等を背景に実需者層を中心に需要は堅調とされています。",
        "basis": "沿革、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
