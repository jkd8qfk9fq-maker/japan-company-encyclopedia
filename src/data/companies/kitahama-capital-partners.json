  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業以来、社会性、安全性、収益性を投資の基準として外部環境に対し柔軟に対応し、高機能・高専門性を基盤として常に進化し続ける企業集団を目指す方針です。継続企業の前提に関する状況の改善に向けては、第15回新株予約権の発行による資金調達と、データセンター事業の一環としての蓄電所開発事業への取り組みによる収益計上を進める方針です。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高のすべてが投資事業から生じており、2026年３月期はクリーンエネルギー事業における太陽光発電・蓄電システムの売上が伸びて売上高が大きく増加しました。一方で、アセットマネージメント事業とその他の事業には売上高の計上がなく、収益は投資事業の案件動向に左右される構成です。",
        "basis": "セグメント情報における外部顧客への売上高（投資事業1,910百万円、アセットマネージメント事業及びその他の事業は計上なし）と、経営成績等の分析における売上高の増加要因の記載に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "TMKスキームを中心に、投資対象に応じて金融商品化を行う金融技術と、案件のソーシングからデュー・ディリジェンスまでを担う総合的なスキル・ノウハウが強みです。投資案件の選定では、他の事業のバリューアップノウハウの活用も想定して案件を厳選しています。",
        "basis": "事業の内容におけるアセットマネージメント事業の記載（TMKスキーム、案件のソーシング、オリジネーション、ファイナンスアレンジ、デュー・ディリジェンス）と、投資事業における投資案件の選定方法の記載に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結従業員数38人の小規模な投資会社で、投資対象を不動産のみならず事業会社及び事業並びに工学技術等へ拡げています。2026年３月期の売上高は1,910百万円と前期から大きく伸びましたが、収益が立つのは投資事業のみであり、事業規模はなお小さい位置付けです。",
        "basis": "セグメント情報における外部顧客への売上高と、従業員の状況における連結従業員数、事業の内容における投資対象の範囲の記載に基づきます。",
        "asOf": "2026-06-30",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
