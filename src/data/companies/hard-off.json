  "updatedAt": "2026-11-13",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンとして、理念経営に磨きをかけ、強いリアル店舗を中心にリアル店舗とインターネットの様々なチャネルを融合させる仕組みを作り上げ、国内外で圧倒的なリユースのリーディングカンパニーとして循環型社会の構築に貢献することを掲げています。2030年に向けた中期計画では、リアル店舗戦略、出店戦略、デジタル戦略、海外戦略の4つの戦略で事業拡大を図り、2030年度1,300店舗を目標としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "店舗網の拡大が成長の中心です。2026年3月期は直営店の新規出店に加え、株式会社エコノスの子会社化により同社の店舗が直営店に加わり、直営店545店舗とFC加盟店533店舗の合計1,078店舗となりました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の店舗数の記載、関係会社の状況の連結子会社一覧",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "地域のお客様から買い取った品物をそのまま買い取った店舗で販売する地産地消型のため、チェーン店でありながら店舗ごとに品揃えが異なる点が強みとされています。ハードオフ、オフハウス、ホビーオフなど多業態のリユースショップ展開により、多様なお客様の要望に応える体制も備えています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の強みと店舗モデルの記載、事業の内容の各業態の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "リユース市場は継続的に拡大しているとされる中で、同社は直営店とFC加盟店を合わせた1,078店舗のネットワークを持ち、外部顧客への売上高の大部分をリユース事業が占める構成です。米国と台湾にも子会社を通じて店舗を展開しています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析のリユース市場の記載、セグメント情報の外部顧客への売上高、事業の内容の海外子会社の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
