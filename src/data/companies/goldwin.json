  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「PLAY EARTH 2030」のもと、2025年3月期を初年度とする中期経営計画を進めています。基本方針は「事業と環境の2つのサステナビリティの両立」で、成長戦略の柱として「Goldwin 500」、「ザ・ノース・フェイスの市場拡張」、「ブランドポートフォリオの良質化」、「コト事業の推進」を掲げています。自社ブランドGoldwinについては、2033年3月期に全世界売上高500億円の達成を長期目標としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "基幹ブランドTHE NORTH FACEでは、パフォーマンスブランドとしての本質への回帰を中核に据え、マウンテンパフォーマンス領域の強化やフットウエアのVECTIVシリーズなど新規ラインの展開を進めています。自社ブランドGoldwinでは、中国子会社が黒字転換し、1店舗当たりの収益性を高める成長モデルが現地市場で機能し始めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高は137,516百万円で過去最高を更新しました。スポーツ用品関連事業の単一セグメントで、地域別の売上高は本邦が連結売上高の90％を超えています。基幹ブランドTHE NORTH FACEと自社ブランドGoldwinが事業の中心で、中国・韓国・欧米の子会社を通じて海外販売も行っています。",
        "basis": "事業の内容、セグメント情報の関連情報（地域ごとの情報）および経営者による分析の印字に基づきます。",
        "asOf": "2026-06-23",
