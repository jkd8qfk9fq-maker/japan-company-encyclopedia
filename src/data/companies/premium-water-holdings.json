  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "対処すべき課題として、保有契約件数の純増の維持とお客様一人当たりの収益の向上に向けた販売チャネルの多様化・強化や外部企業とのアライアンスの推進と解約の抑止、ウォーターサーバーの調達や宅配水の製造・配送の安定化と費用の増加抑制、人材基盤の強化、顧客管理システムと情報管理体制の強化、内部管理体制の充実、ESG経営の強化を掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上収益は80,323百万円と前期比4.5%増え、保有契約件数は182万件となりました。サービスライン別では、ウォーターサーバーレンタルが14,057百万円から17,329百万円へ増えた一方、ナチュラルミネラルウォーター販売は48,877百万円から48,716百万円とほぼ横ばいであり、レンタルの伸びが増収を支えました。",
        "basis": "MD&Aの経営成績の状況と、売上収益注記の主要なサービスライン別内訳の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「天然（天然水）」「生（非加熱殺菌）」「直（ダイレクトビジネス）」にこだわり、独自のウォーターサーバーと収縮性のあるペットボトルを使い、宅配事業者に委託して顧客宅へ直送し、使用後のボトル回収を不要とするワンウェイ方式を採用しています。この方式により、空きボトルを回収することなく日本全国の顧客宅への配送が可能となっています。ペットボトルは自社で製造し、内製化率は100%に達しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "宅配水は定期配送の継続利用が収益の土台となる事業です。保有契約件数は2020年3月に100万件を超え、2026年3月31日現在で182万件まで増えており、長期契約プランの提供などにより顧客基盤の安定化が図られています。",
        "basis": "事業の内容のワンウェイ方式の記載、沿革の保有契約件数の記載、MD&Aの経営成績の状況の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
