  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営方針として「変革と成長」を掲げ、支持率No.1ブランドの獲得に向けて、収益構造の見直しとともに商品力・ブランド力の強化を図り、主に新商品の企画・開発及び既存製品のリニューアル開発に注力するとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "少人数で構成する開発グループ制により多様なニーズを収集し、自社では生産設備を持たず商品特性に合わせた最適なベンダーに生産を委託する仕組みで、多品種小ロットの商品提供と毎年の多数の新商品投入を実現している点が特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、お客様のニーズに的確に対応するため少人数で構成する開発グループ制を採用していること、自社では生産設備を持たずそれぞれ商品の特性に合わせた最適なベンダーに生産を委託していること、この仕組みにより多くの新商品投入を実現し既存商品の販売逓減をカバーしていることが書かれています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
