  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "販売・営業・サービス分野に特化した「成果追求型営業支援」をビジネスモデルとして掲げ、人の力によるヒューマン営業支援とデジタル営業支援を掛け合わせた「オムニチャネル営業支援」プラットフォームにより、実店舗とＥＣ等の無店舗販売の双方で付加価値の高いソリューションの提供に努めるとしています。中期経営計画2025-2029の重点領域として「エアポート」「ホールセール」「スポーツ・エンタメ」などを挙げ、空港グランドハンドリングの新規拠点展開や、ＩＰライセンスを活用した商品など高付加価値商品の拡充に取り組んでいます。",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "業務請負では、クライアントごとに「業務運営事務局」を設置して課題や施策を共有し、現場のスタッフへの指示や販売状況のフィードバックまでを担う体制を取っています。あわせて、オリジナルの販売カリキュラムによる教育・研修制度を整え、販売や営業の経験がない人材でも標準化された研修で実践に近い経験を積めるようにし、就業後もフォローアップ研修を続ける点が特徴です。",
        "basis": "事業の内容（アウトソーシング事業の特徴である業務運営事務局と教育・研修制度の記載）に基づく。",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "最大の事業はアウトソーシング事業で、2025年８月期の外部顧客への売上高は25,831百万円と連結売上高の約４割を占めます。次いでホールセール事業が16,679百万円、ＥＣ・ＴＣ支援事業が9,253百万円、人材派遣事業が8,786百万円、その他が3,044百万円です。地域別の売上高は本邦が90％を超えるため内訳の開示が省略されており、売上高の10％以上を占める特定の顧客はありません。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、関連情報の地域ごとの情報・主要な顧客ごとの情報）に基づく。",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
