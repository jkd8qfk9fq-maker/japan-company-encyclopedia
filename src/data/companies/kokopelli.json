  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「企業価値の中に、未来を見つける。」とビジョン「中小企業にテクノロジーを届けよう。」を掲げています。中長期的な経営戦略として、既存事業の磨き込みでは「AIエージェント構想」を掲げ、複数のAI技術を組み合わせて自律的に意思決定や行動を支援するAIエージェントの実装を進めること、新規事業の拡大では「BIG ADVANCE GLOBAL」の海外展開と成功報酬などトランザクションに応じた収益構造への転換、金融機関向けサービスの拡販による金融DXの推進を挙げ、さらに「地域密着ネットワーク」領域を中心としたM&Aによる非連続な成長も目指すとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "全国の地域金融機関とパートナーシップを結び、金融機関自身のサービスとして中小企業へ届ける仕組みにより、５万社を超える中小企業のネットワークを構築していることが強みです。ビジネスマッチングではAIによるレコメンドと、面談の設定を金融機関が担う「Face to Face」の進め方を両立させ、蓄積したデータと生成AIを活用した機能の高度化も進めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、地域金融機関と協業したビジネスモデル、テクノロジーとFace to Faceの融合、５万社以上の中小企業のネットワークと生成AIを活用したデータ分析が強みとして印字され、【事業の内容】に2026年３月31日時点の導入金融機関76社・会員企業数53,895社が印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "中小企業向け経営支援プラットフォームを地域金融機関経由で全国に展開する事業者です。「Big Advance」の会員企業数は60,172社（2025年３月末）から53,895社（2026年３月末）へ、導入金融機関数は78社から76社へいずれも減少しています。一方で、会員企業の解約率は2025年４月から2026年３月までの平均で1.53％と、同社が目標とする２％以内で推移しています。",
        "basis": "【事業の内容】の推移表に導入金融機関数と会員企業数の四半期推移が、経営成績の分析に解約率1.53％（2025年４月～2026年３月の平均）と目標２％以内であることが印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
