  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「High Quality」と「Workers First」を掲げ、経営方針は、ソフトインフラとしての経理業務・経理業界の改革、人間力の育成、持続可能な企業（社会）の実現の3つです。経理業務は企業情報に係る重要な社会インフラ（ソフトインフラ）であることを社会に訴え、経理業界の活性化やイメージアップも目標に掲げています。",
        "asOf": "2026-06-11",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "大企業クライアントとの取引は一部の業務から始まり、信頼を得ることで同じクライアントグループ内での業務範囲や契約件数が広がっていく進め方です。契約の継続を重視しており、2026年3月期の契約継続率は99.979％でした。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-11",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "継続型の業務では、会計処理の検討や決算作業の効率化の提案まで含め、戦略の策定から実行支援まで一貫して担い、単純な記帳代行とは異なる進め方をしています。継続型の業務は2026年3月期の売上高の80.7％を占めており、収益の継続性が高い構成です。",
        "basis": "事業の内容の記載に基づく",
        "asOf": "2026-06-11",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "会計業界では、企業の人材不足や会計業務の高度化・複雑化に加え、組織再編などへの専門性の高い会計支援を求める動きが高まっています。同社の主要な顧客は強固な経営基盤を持つ大企業であり、外部環境の変動による影響を受けにくい事業基盤と位置づけられています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-11",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
