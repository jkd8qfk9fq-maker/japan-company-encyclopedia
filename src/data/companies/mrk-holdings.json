  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「なりたい自分になるためのきっかけとソリューションを提供する」ことをブランド価値とし、主力の補整下着の販売を中心に既存事業の業績拡大を図るとともに、お客様のライフステージに寄り添い、美と健康を中心に多彩な商品・サービスの提供を通じて、新たな収益源となる事業の創出・育成を推進するとしています。あわせて、経営体制の強化と効率的な経営の実現、持続的成長を支える強固な経営基盤の構築に取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "婦人下着及びその関連事業は2026年3月期の外部顧客への売上高18,589百万円と、連結売上高の大半を占める中核事業です。体型補整用婦人下着を全国の直営店舗等とECサイトで販売し、直営店舗では商品提供後もボディメイクなどのアフターサービスを提供して、購入後も続く顧客との関係を保っています。当期は主力商品シリーズの新色投入などにより既存顧客の購入単価が増加し、同事業は増収となりました。",
        "basis": "セグメント情報の外部顧客への売上高、事業の内容、MD&Aの経営成績等の状況の概要に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の10%以上を占める主要な顧客はなく、本邦の外部顧客への売上高が連結売上高の90%を超える、国内中心の事業構成です。2026年3月期は婚礼・宴会関連事業の外部顧客への売上高が前期比18.6%増と伸びた一方、マタニティ及びベビー関連事業は在庫適正化のための新商品投入の抑制により前期比13.1%減となりました。",
        "basis": "セグメント情報の外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）、販売実績に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
