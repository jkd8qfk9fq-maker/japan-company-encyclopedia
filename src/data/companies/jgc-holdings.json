  "history": [
    {
      "year": 1928,
      "title": "日本揮発油株式会社として創立",
      "description": "1928年10月に、「日本揮発油株式会社」として創立されました。同年11月には、米国のユニバーサル・オイル・プロダクツ社（現Honeywell UOP社）と、熱分解蒸留法装置の特許の譲受けと建設に関する協約を結びました。",
      "significance": "石油精製の技術を海外から取り入れて、プラントをつくる事業を始めた出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1952,
      "title": "触媒製造工場を分離し日揮化学を設立",
      "description": "1952年5月に、UOP社と石油精製・石油化学の特許の実施と建設に関する契約を結びました。同年8月には触媒製造工場を分けて日揮化学㈱をつくりました。",
      "significance": "現在の機能材製造事業につながる触媒づくりが、別会社として始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1958,
      "title": "触媒化成工業を設立",
      "description": "1958年7月に、旭硝子㈱との共同出資で触媒化成工業㈱を設立しました。",
      "significance": "のちに日揮化学と合併して、現在の日揮触媒化成㈱になります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京証券取引所市場第2部に上場",
      "description": "1962年5月に、東京証券取引所市場第2部に株式を上場しました。1969年2月には第1部銘柄に指定されました。",
      "significance": "上場企業になった節目です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "社名を日揮株式会社に変更",
      "description": "1976年10月に、社名を「日本揮発油株式会社」から「日揮株式会社」（英文名JGC CORPORATION）に変更しました。",
      "significance": "現在の「日揮」の名前になった年です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "日揮触媒化成が発足",
      "description": "2004年7月に触媒化成工業㈱を100％子会社にしました。2008年7月には、触媒化成工業㈱と日揮化学㈱が合併し、日揮触媒化成㈱と改称しました。",
      "significance": "グループの触媒事業が一つの会社にまとまりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "持株会社体制に移行し日揮ホールディングスに商号変更",
      "description": "2019年4月に日揮グローバル㈱を設立し、同年10月に持株会社体制へ移行して商号を「日揮ホールディングス株式会社」（英文名JGC HOLDINGS CORPORATION）に変更しました。海外のEPC事業は日揮グローバル㈱に、国内のEPC事業は日揮㈱に引き継がれました。",
      "significance": "事業会社がプラント建設を担い、当社がグループ全体を管理する体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月に、東京証券取引所市場第1部から新しい市場区分のプライム市場に移りました。",
      "significance": "現在の上場市場です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "日揮コーポレートソリューションズを設立",
      "description": "2023年4月に、グループ内のコーポレート機能の業務を集めて効率化と専門性を高めるため、日揮コーポレートソリューションズ㈱を設立しました。",
      "significance": "グループ共通の管理業務を一つの会社が担うようになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "バイオプロセス研究所を神戸市に設置",
      "description": "2026年1月に、兵庫県神戸市に「バイオプロセス研究所」を設置しました。",
      "significance": "微生物を使ったものづくりの技術開発の拠点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
