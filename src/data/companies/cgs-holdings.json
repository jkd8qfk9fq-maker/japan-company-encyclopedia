  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「生産性の限界に挑戦する」とグループビジョン「グローバル・ニッチ・トップ」を掲げ、2025年4月に純粋持株会社体制へ移行しました。中期的な経営戦略として、既存ソリューションの開発・営業力の強化と適応分野の拡大、生産管理システムを核とするスマートファクトリー領域の拡大、ものづくりDXプラットフォームによる既存システムのクラウド化とSaaS/PaaSの展開、他社との協業やM&Aによる事業の推進を挙げ、CAD/CAMメーカーとしての技術革新を中核に「製造業DXインテグレーター」へ進化することを目指しています。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金型向けCAD/CAMで長い歴史を持つ2社が統合した事業基盤に、2025年には株式会社ＮＤＥＳが加わり、会社はCAD/CAM業界トップシェアの企業グループになったと述べています。収益面では、既存顧客との保守契約の更新による収益が売上高の中心で、ソフトウェアの販売後も継続的に収益が積み上がる構造になっています。",
        "basis": "経営方針に、組織再編により「CAD/CAM業界トップシェアの企業グループとなりました」と印字されていること。セグメント情報の収益分解で、更新保守が2,090百万円と最大の行であり、既存顧客への地域密着型のサポート体制が保守収益に貢献したと経営成績の分析に印字されていること。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "2025年の組織再編により、CAD/CAM業界トップシェアの企業グループになったとしています。",
        "asOf": "2026-03-24",
