  "status": {
    "state": "needs-attention",
    "notes": [
      "businessStructure: 連結子会社のKURODA JENA TEC HOLDINGS LTD.は、2024年9月26日に解散及び清算を決定し、本書提出日時点において清算手続き中です。2026年3月31日現在は連結子会社として計上されているため、その体制で登録しました。清算の完了時期は印字されていません。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度から2030年度までの5年間を対象とする中期経営計画Vision2030を策定し、精密領域と金型領域の2つの領域で、産業の高度化への対応、未来の産業への対応、環境・社会への対応を進め、成長戦略の実行と収益力の強化、人材育成により企業価値の向上を図るとしています。精密領域では精密領域のCoE（センターオブエクレセンス）を、金型領域ではモーターコアのフロントランナーを各領域のビジョンに掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ボールねじの精密研削技術を核とする駆動システムに加え、型内接着積層システム「Glue FASTEC®」によるモーターコア生産など、精密加工と計測の技術を3つの事業で横断的に持っている点が強みです。高効率モーターコアや省エネ性能の高いアクチュエーター・工作機械など、低炭素社会に貢献する製品の提供にも取り組んでいます。",
        "basis": "セグメント情報における報告セグメントごとの売上高と製品の記載、事業の内容における各セグメントの主要製品、経営方針における環境・社会への対応の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は金型システムで、2026年3月期の外部顧客への売上高は9,139百万円、次いで駆動システムが6,459百万円、機工・計測システムが3,902百万円です。地域別では日本が9,220百万円、アメリカ合衆国が2,724百万円、中国（香港含む）が2,137百万円など、海外への販売も行っています。",
        "basis": "セグメント情報における外部顧客への売上高と、関連情報における地域ごとの売上高の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
