  "businesses": [
    {
      "id": "marketing",
      "name": "マーケティング事業",
      "description": "連結子会社の株式会社キャリアインデックスと株式会社ホワイトキャリアが担う事業です。複数の求人サイトや賃貸物件サイトの情報を自社サイトと連携させる「アグリゲーションモデル」で、利用者が情報を一括検索し、複数のサイトへ登録・応募や問い合わせをまとめて行える仕組みを提供しています。2026年3月期の売上高は3,917百万円で、前期に比べ26.6％増えました。",
      "customers": [
        "求人サイト・スカウトサービス・職業紹介サービスの運営事業者",
        "求職者",
        "賃貸物件やフレキシブルオフィスを探す個人・法人"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "hr",
          "name": "HR領域（求人情報サイト・職業紹介）",
          "description": "転職情報サイト『CAREER INDEX』、アルバイト・派遣情報サイト『Lacotto』、ファッション・アパレル業界に特化した転職情報サイト『Fashion HR』、成果報酬型採用支援サービス『Adopt Admin』を運営しています。ハローワークの求人情報を掲載し応募書類を作成・郵送できるサービスも提供しています。株式会社ホワイトキャリアは職業紹介サービス『ホワイトキャリア』を運営し、自社のマーケティングノウハウを他の職業紹介事業者にも提供しています。人材紹介会社等でマッチングが成立していない候補者にグループの求人プラットフォームを提供する「求人シェアリング事業（アライアンス・マーケティング）」も展開しています。2026年3月期のサービス別売上高は、転職が2,108百万円、アルバイト・派遣が818百万円でした。",
          "customers": [
            "求人情報を掲載する求人サイト・職業紹介サービスの運営事業者",
            "転職やアルバイトを探す求職者"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "real-estate-info",
          "name": "不動産領域（賃貸・フレキシブルオフィス情報サイト）",
          "description": "アグリゲーションモデルを不動産賃貸に展開した事業です。個人向けには賃貸情報サイト『DOOR賃貸』『キャッシュバック賃貸』を運営し、「敷金・礼金なし」に特化した物件情報サービスを提供しています。法人向けには、レンタルオフィスやシェアオフィス、コワーキングスペースの情報を集めたフレキシブルオフィス情報サイト『JUST FIT OFFICE』を運営しています。2026年3月期のサービス別売上高は990百万円でした。",
          "customers": [
            "賃貸物件を探す個人",
            "フレキシブルオフィスの利用を検討する法人"
