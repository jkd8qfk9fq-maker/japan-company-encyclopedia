  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「ＮＸ２０２８」（2026年5月期～2028年5月期）を推進し、経営理念「四者共栄」のもと長期ビジョン「世の中の“キレイ”を支える会社」を目指しています。基本戦略は、既存事業の成長と収益率の両立、新領域・海外の成長基盤構築、ヘルスケア事業の成長です。",
        "asOf": "2026-09-04",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年5月期は中期経営計画の初年度で、外食市場の堅調を背景にケミカル事業が増収となる一方、ヘルスケア事業は国内外で減収となりました。連結子会社３社の吸収合併などグループ内再編も進めています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報（製品及びサービスごとの情報・地域ごとの情報・主要な顧客ごとの情報）、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-09-04",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
