  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営戦略として、タレントマネジメント領域への積極投資とHR分野への本格展開、ビッグデータと分析テクノロジーのプラットフォーム戦略、コンサルティング力の強化による高付加価値化と大型案件の創出、AI・テキストマイニングの技術力強化による機能差別化、経営基盤の強化を進める方針です。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年９月期は、HRソリューションの外部顧客への売上高が13,244百万円とマーケティングソリューションの3,839百万円を大きく上回り、タレントパレットを中心とするHR領域が成長をけん引しました。マーケティングソリューションでは生成AIを活用した機能強化を進めながら、顧客基盤の安定・強化に取り組んでいます。",
        "basis": "セグメント情報の外部顧客への売上高と、MD&Aの経営成績等の状況の概要による。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発の自然言語処理エンジン「Waters」を全てのサービスに組み込み、解析精度の高さと処理速度で差別化を図っています。コンサルティングチームが導入先企業に寄り添って活用支援を行い、そこで得た気づきを開発・営業チームへ素早く共有して新機能開発に反映するPACサイクルにより、サービスの高速進化と顧客の定着につなげています。",
        "basis": "事業の内容における製品・サービス情報（自然言語処理エンジン「Waters」とPACサイクルの記述）による。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内ソフトウェア市場は2024年度に２兆7,366億円、うちSaaS市場は１兆9,641億円と印字されています。当社グループはテキストマイニングツール分野、CRM分野、HRテック分野で事業を展開し、２つの報告セグメントのうちHRソリューションが売上高の中心です。地域ごとの情報は、本邦の外部顧客への売上高が全体の90％を超えるため記載が省略されており、売上高の10％以上を占める主要な顧客もありません。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境と、セグメント情報等の関連情報（地域ごとの情報、主要な顧客ごとの情報）による。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
