  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「企業と地域社会の未来に、テクノロジーの追い風を。」をパーパスに掲げ、中期経営計画（2024年6月期～2026年6月期）では「すべての中小企業のDXをサポートする」をミッションに、デジタルとリアルの両面から経営課題を解決する「総合DX支援企業」を目指しています。今後はWebマーケティングの知見と子会社の採用支援ノウハウを融合させ、AI技術を活用した次世代型のRPO（採用プロセスアウトソーシング）サービスの提供を加速させる方針です。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "VideoクラウドとRaiseから抽出できる動画の視聴データと顧客のマーケティングデータを活用し、顧客の課題を可視化してクロスセルを行える点が強みです。デジタルマーケティングにとどまらず、顧客ニーズに応じたソリューションを柔軟に提案できる体制を持っています。",
        "basis": "【事業の内容】に、VideoクラウドとRaiseから抽出できる視聴データ及びマーケティングデータを活用したDXコンサルティングサービスの提供を行っており、集積されたデータをもとに顧客の課題を可視化し、クロスセルを行う他、デジタルマーケティングだけでなく顧客ニーズに応じたソリューションを柔軟に提案できることが当社の優位性であると認識している旨が印字されているため。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "中小企業向けの動画マーケティング支援では、基盤サービスであるVideoクラウドの導入社数が2026年6月末現在で6,000社を超える実績を持ちます。2026年6月期からは人材紹介のHR事業が加わり、支援領域は採用課題へも広がっています。",
        "basis": "【事業の内容】に、Videoクラウドは2021年4月に本格リリースしてからサービス導入社数は6,000社を超え（2026年6月末現在）と印字され、2026年1月に株式会社オルプラ及び株式会社Nexilを子会社化しHR事業を開始したことが印字されているため。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
