  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基幹事業であるネット型リユース事業のさらなる成長と、モバイル通信事業の収益基盤の安定化を課題として掲げています。リユース事業では、AIの活用による生産性とサービス品質の向上や買取チャネルの拡大に取り組み、「おいくら」では地方自治体との連携を推進し、使用済みGIGAスクール端末等の取扱いを加速するとしています。モバイル通信事業では、新規回線獲得時に発生するショット型収入への依存から、保有回線から継続的に得られるストック型収入を主体とする事業構造への転換を進め、2026年10月より月額基本料金の改定を実施する計画です。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の構成はネット型リユース事業とモバイル通信事業がほぼ半分ずつですが、会社が成長の主軸に位置付けるのはリユース事業です。モバイル通信事業は特定の主要な顧客への販売が大きく、収益構造の転換が進むかどうかが、グループ全体の安定性を左右する構造です。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "インターネットによる事前査定と全国対応を組み合わせた独自の買取モデルを持ち、査定・販売のノウハウをマニュアル『STANDARD BOOK』に標準化して全社で共有しています。自社開発の在庫一元管理システムにより複数のマーケットプレイスへ同時に出品でき、商品回転率の高さにつながっています。また「おいくら」は2026年6月30日時点で336の地方自治体と連携しており、自治体との接点も強みの一つです。",
        "basis": "事業の内容、経営方針、MD&Aのおいくら分野の記載に基づく",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
