  "history": [
    {
      "year": 2006,
      "title": "株式会社マーケットエンタープライズを設立",
      "description": "代表取締役社長の小林泰士が個人事業として行っていた格安中古乾電池の仕入・販売やフリーマーケットの主催業務を母体に、リユース取扱商品の幅を広げて業容を拡大するため、東京都墨田区亀沢に株式会社マーケットエンタープライズを設立しました。",
      "significance": "会社の起源であり、リユース事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
