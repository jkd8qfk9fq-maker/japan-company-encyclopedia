  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業以来、高品質の小型コネクタをエレクトロニクス市場に提供することを基本とし、海外売上拡大に向けて開発力・供給力・販売力のグローバル体制を強化し、新製品開発と注力市場の開拓を進めるとしています。2030年を目標とする長期経営計画「KEL VISION 2030」も掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は日本が7,584百万円、中国が2,608百万円、その他アジアが1,353百万円、欧州が1,026百万円、北中米が285百万円で、海外向けが全体の約4割を占めることが読み取れます。",
        "basis": "セグメント情報の地域ごとの情報に、2026年3月期の売上高として日本7,584百万円、中国2,608百万円、その他アジア1,353百万円、欧州1,026百万円、北中米285百万円が印字されていること。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "コネクタの専門メーカーとして、常に最先端の接続技術（コネクション・テクノロジー）を追い求め、高密度・高速化する産業用機器に対応し、市場ニーズを先取りした製品を開発し、市場に供給し続けることを掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
