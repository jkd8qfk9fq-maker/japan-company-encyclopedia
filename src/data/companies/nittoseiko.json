  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度の経営方針を「イノベーションを核に、稼ぎ力を加速する2026」とし、新中期経営計画「Mission G-final」の初年度を「改革の年」と位置付けています。収益性と資本効率の抜本的な改善を最優先課題とし、投資の優先順位付けと資本配分の透明性を徹底して投資リターンを最大化する体制の構築、グループ横断のイノベーションを基盤とした組織運営とESGの推進により、安定と成長を両立するグループ像を目指しています。",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "前期までの中期経営計画「Mission G-second」では海外展開の遅れや自動車分野の回復の遅延で数値目標に未達が残ったことを踏まえ、新計画では短期の収益改善と中長期の成長の両立へ重点を移しています。インドのVULCANグループの子会社化などM&Aによる海外生産拠点の拡充が、その具体策の一つとして進んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等における「Mission G-second」の総括と2026年度の経営方針の記載、MD&Aにおけるセグメント別の取り組みの記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、ファスナー製品について設計・原材料調達・加工・検査・包装までを一貫して行う生産体制と、異種金属接合の「アクローズ」や薄板化に貢献する「ジョイスタッド」「ギザタイト」といった高付加価値製品の展開力にあります。アジア・北米・欧州に生産・販売拠点を持ち、現地供給できる体制も備えています。",
        "basis": "事業の内容における一貫生産体制の記載、MD&Aのファスナー事業における製品展開の記載、関係会社の状況における海外連結子会社の記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の内訳はファスナー事業が全体の約4分の3を占め、制御事業・産機事業がそれぞれ1割強、メディカル事業は立ち上がりの段階です。地域別では日本が34,750百万円、アジアが12,439百万円、その他の地域が3,047百万円で、自動車関連業界の設備投資や需要動向の影響を受けやすい構成です。",
        "basis": "セグメント情報における外部顧客への売上高と関連情報における地域ごとの売上高の記載、MD&Aにおける各事業の需要環境の記載",
        "asOf": "2026-03-31",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
