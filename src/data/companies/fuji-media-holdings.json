  "history": [
    {
      "year": 1957,
      "title": "富士テレビジョンを設立し、テレビ免許を申請",
      "description": "1957年6月、ニッポン放送と文化放送に東宝・松竹・大映の映画3社が加わり、「富士テレビジョン」としてテレビ免許を申請しました。同年7月に予備免許が交付され、11月に㈱富士テレビジョンが設立されました。",
      "significance": "今のグループの出発点です。㈱フジテレビジョンはその後、グループのテレビ放送事業の中核になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1959,
      "title": "フジテレビジョンが開局し、全国ネットワークの基礎を築く",
      "description": "1958年12月に㈱フジテレビジョンへ社名を変え、1959年3月に開局しました。同年6月には基幹4局がネット調印を行ってFNS（フジネットワークシステム）の基礎を確立し、1970年10月にはFNS27局体制が確立して全国ネットワークが完成しました。",
      "significance": "全国の系列局に番組を届ける仕組みが整いました。今のグループにも、㈱仙台放送のようなFNS系列局が含まれます。",
      "sourceIds": [
