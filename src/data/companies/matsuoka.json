  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年度から2028年度を計画期間とする新中期経営計画『BEYOND2028～Stitch the Future～』を策定し、生産規模の活用と稼働率の向上、『選ばれる工場』に向けた提供価値の向上、資本効率を高める経営への転換、人的資本への重点取り組みを重点施策としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "バングラデシュ・ベトナム・インドネシアの生産体制強化やスマートファクトリー化を掲げており、海外自社工場の生産能力を活かして受注に応える事業の進め方と整合しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における新中期経営計画の重点施策の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "海外5ヶ国の自社工場で企画から製造・物流まで一貫して担い、旗艦工場で培った縫製技術や品質管理のノウハウをグループ全体へ展開する体制が強みです。",
        "basis": "事業の内容における一貫サービスの記載、経営方針における技術・品質管理ノウハウの展開の記載",
