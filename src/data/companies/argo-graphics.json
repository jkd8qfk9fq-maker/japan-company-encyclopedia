  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度の3カ年中期経営計画では、ものづくりプラットフォームの高度化、AIを活用した予測・分析ソリューションの展開、VDI・HPC・データセンターを基盤としたハイブリッドIT環境及びマネージドサービスの拡充を掲げ、人的資本経営を重要な経営戦略として位置付けています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "主要顧客である自動車関連業界では開発強化に向けたIT投資が堅調で、PLMソリューションの売上高が伸びています。半導体需要の拡大を背景に、システム構築支援でもハードウェアを中心としたソリューションが伸長しました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の概要",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設計DX・製造DXを中核としたワンストップDXソリューションの提供を強みとしており、主力製品である3次元CAD「CATIA」については、開発したダッソー・システムズとの販売代理店契約に基づいて販売しています。コンサルティングから開発、運用、保守までをグループで担う体制があります。",
        "basis": "事業の内容におけるPLMソリューションの説明と、重要な契約等におけるダッソー・システムズとの販売代理店契約",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、PLM事業が69,489百万円、EDA事業が2,036百万円で、売上高の大半をPLM事業が占めています。主要な顧客であるホンダグループへの売上高は14,143百万円でした。",
        "basis": "セグメント情報の報告セグメントごとの売上高と、関連情報の主要な顧客ごとの情報",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
