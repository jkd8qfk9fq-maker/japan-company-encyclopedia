  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「企業活動を効率化し便利にする」を経営理念に掲げ、長期ビジョンとして「ラクーンBtoBネットワーク」構想を掲げています。各サービスの顧客をグループ共通顧客と捉え直し、利用実績に応じた信用の付与や、グループサービスを使いたくなる仕掛けの提供でクロスセルを促す方針です。グループが運営するサービスに提携企業が運営するサービスも加えていく方針も示しています。",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年11月に株式会社アドバンテッジパートナーズと事業提携契約を締結し、同社からマーケティングや営業活動の支援、経営管理強化の支援、M&Aやアライアンス推進の支援を受ける体制を整えています。あわせて、同社がサービスを提供するファンドが出資する特別目的事業体に対して新株予約権と転換社債型新株予約権付社債を発行しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と重要な契約等の記載に基づく",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "約60万社の中小零細企業の顧客基盤を持ち、顧客理解力と技術活用力に加えて、事業者データ・与信データ・取引データなどのデータ資産を強みとしています。取引の場であるECサイトと、与信データを扱う売掛保証・決済代行を同じグループで運営している点も特徴です。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載に基づく",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "BtoB分野では人手不足や働き方の変化を背景に業務効率化やDXへの対応が一般化しつつあります。ECとフィナンシャルの市場規模はともに大きい一方でDXの浸透率はまだ低く、緩やかに高まっているとされています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境の記載に基づく",
        "asOf": "2026-07-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
