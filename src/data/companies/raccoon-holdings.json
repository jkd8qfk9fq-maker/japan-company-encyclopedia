  "businesses": [
    {
      "id": "ec",
      "name": "EC事業",
      "description": "アパレル・雑貨を取り扱う企業間取引（BtoB）サイト「スーパーデリバリー」を運営する、当社グループの報告セグメントです。2026年4月期の外部顧客への売上高は3,899百万円でした。連結子会社の株式会社ラクーンコマースが運営しています。出展企業がサイトに掲載した商品を会員企業が購入するショッピングモール型のサイトで、出展企業は中小規模の小売店の与信リスクを回避する仕組みを使いながら販路を広げられます。",
      "customers": [
        "アパレル・雑貨メーカーなどの出展企業",
        "中小規模の小売店などの会員企業"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "super-delivery-domestic",
          "name": "国内向けサイト",
          "description": "国内の中小規模小売店を主な対象とする「スーパーデリバリー」の国内向けサイトです。会員小売店には無料のフリープランと、月会費を支払い購入額に応じてポイント還元などを受けられるスタンダードプランがあります。現在は国内の小売業以外の事業者や、国内に受取拠点を持つ海外事業者にも対象を広げています。売上高はEC事業としてのみ開示されており、この区分だけの金額は印字されていません。",
          "customers": [
            "国内の中小規模小売店",
            "国内の小売業以外の事業者"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "sd-export",
          "name": "海外向けサイト（SD export）",
          "description": "「スーパーデリバリー」の海外向けサイトです。当社グループが輸出者となるため、出展企業は輸出に必要な手続きをせず、指定倉庫へ商品を出荷するだけで海外の小売店・企業へ販売できます。フリープランのみの提供で月会費はなく、出展企業から流通額に応じたシステム利用料を受け取ります。売上高はEC事業としてのみ開示されており、この区分だけの金額は印字されていません。",
          "customers": [
            "海外の小売店・企業",
            "海外へ販売する出展企業"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        }
      ]
    },
    {
      "id": "financial",
      "name": "フィナンシャル事業",
      "description": "売掛保証と決済代行で構成される、当社グループの報告セグメントです。2026年4月期の外部顧客への売上高は2,674百万円でした。連結子会社の株式会社ラクーンフィナンシャルが運営しています。企業間取引で生じる与信リスクや請求・回収の手間を引き受けることで、販売側企業が安心して取引を広げられるようにするサービスです。",
      "customers": [
        "企業間取引を行う販売側企業"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "uriho",
          "name": "URIHO",
          "description": "企業間取引で発生した売掛金が未回収になったときに、取引先に代わってあらかじめ設定した支払限度額を上限に保証金額を支払う売掛保証サービスです。申込みから与信審査、保証の請求まですべてオンラインで完結し、定額制でプランの枠内なら何社でも保証をかけられます。2026年4月期の売上高は1,563百万円でした。",
          "customers": [
            "取引先への売掛債権を持つ販売側企業"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        },
        {
          "id": "paid",
          "name": "Paid",
          "description": "企業間取引で発生する請求書の発行から代金回収までをすべて代行する、BtoB後払い決済サービスです。与信管理から回収業務までを担い、未回収が発生した際も代金を支払うため、販売側企業は初回の取引から掛売りができます。2026年4月期の売上高は1,110百万円でした。",
          "customers": [
            "掛売り決済を導入する販売側企業（加盟企業）",
            "購入側の企業（Paidメンバー）"
          ],
          "sourceIds": [
            "yuho-2026"
          ],
          "locator": "【事業の内容】"
        }
      ]
    }
