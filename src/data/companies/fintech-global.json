  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "コーポレートアイデンティティとして「すべての産業界へ革新的なストラクチャードファイナンスの効用を浸透させる」を掲げ、金融環境の変化に応じた先端的・革新的な金融商品や「仕組み」を作り、多様化する顧客のファイナンス・ニーズに対応するとしています。投資銀行事業では、事業承継案件へのプライベートエクイティ投資が順調に拡大し、航空機リースとトラックオペレーティングリースが新たな成長ドライバーになったとしています。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1994年の設立以来ストラクチャードファイナンスを専門とし、資金調達の仕組みづくりから自己資金による投資、ファンドの運用までをグループ内で担う体制を持つことが読み取れます。",
        "basis": "沿革における設立目的の記載と、事業の内容における事業構成の記載に基づきます。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "公共コンサルティング事業では、財務書類作成支援を中心に大規模な地方公共団体での受託を積み上げており、行政計画の策定支援などへ領域を広げていることが読み取れます。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における公共コンサルティング事業の記載に基づきます。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
