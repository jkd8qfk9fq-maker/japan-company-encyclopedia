  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社グループは「辺境の知から“マーケティングゼロ”を実現する」というパーパスのもと、売り手と買い手の境界線が存在しない世界の実現を目指しています。競争優位性（コア・コンピタンス）の拡大を経営の基本方針かつアクションプランの基軸とし、自動化ツール群及びリソース群の提供を通じ、解決可能な課題の幅と深度を拡充するサービスを創出していく方針です。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期は、経営環境やトレンド、ニーズの変化に応じた機能面・サービス面の改善に加え、大手・中堅企業への組織的な販売活動、既存顧客に対するクロスセルに注力しました。デジタルマーケティング自動化ツールの売上は1,441百万円（前年同期比5.7％増）、デジタルマーケティングリソースの売上は1,110百万円（同18.1％増）と、リソース群の伸びが大きくなっています。",
        "basis": "MD&Aの経営成績等の状況の概要（経営成績の状況）、セグメント情報の製品及びサービスごとの情報、【経営方針、経営環境及び対処すべき課題等】の記載に基づきます。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "競争優位性（コア・コンピタンス）として、①低コストで大量の認知及び営業リードを形成するマーケティング力、②高度専門人材を発掘・育成するデジタルマーケティング人材のネットワークの構築力、③有料既存顧客1,668社への豊富なクロスセル機会、④顧客接点と筑波大学との産学共同研究を活かした技術解決力、⑤「DNAマップ」による継続的な企業文化の醸成、の5点を掲げています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略の記載、【事業の内容】のサービスの概要に基づきます。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当社グループが事業展開を行うデジタルマーケティング市場は、2025年の市場規模が4,190億2,000万円（前年比114.1％）に成長すると見込まれ、2028年には6,158億円に拡大すると予測されています。生成AIの利活用による生産性向上への企業の関心の高まりや、デジタルマーケティング人材の不足を受け、当社グループのサービスを取り巻く環境は堅調に推移しました。売上高の90％超が本邦の外部顧客への売上高です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境の記載、MD&Aの経営成績等の状況の概要、セグメント情報の地域ごとの情報に基づきます。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
