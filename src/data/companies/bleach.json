  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "月次売上高の大きい「コア商材」を再現性をもって生み出し、コア商材の数と商材当たり売上高を引き上げるため、バリューチェーンの強化を経営戦略の中心に据えています。施策として、人材採用と組織体制の強化、商材パイプラインの拡充とコンサルティング力の強化、動画フォーマット等のマーケティング手法の拡大、データ・ITツールの活用促進に取り組むとしています。",
        "asOf": "2026-09-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "収益がコア商材と特定の顧客に集まりやすい構造であり、主要な顧客として株式会社アールが開示されています。当期はコマースソリューション事業が報告セグメントに加わり、子会社を通じたメーカー事業への展開で収益基盤の多様化を進めています。",
        "basis": "セグメント情報、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-09-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "レベニューシェア型のため、顧客企業は多額の予算を事前に確保せずに支援を受けられ、デジタルマーケティングの人材を持たない中小・中堅企業まで顧客になり得ます。戦略構築から広告制作・運用までを内製化し、大量のA/Bテストによる高速な改善の繰り返しと、データやノウハウの社内蓄積を続けている点が強みです。",
        "basis": "事業の内容に基づく",
        "asOf": "2026-09-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主力事業が属するインターネット広告市場は、動画広告やSNS広告を中心に需要の拡大が続いています。同社は化粧品・日用品・機能性表示食品等のネット通販、美容サロン、金融サービス等におけるウェブでの新規ユーザー獲得ニーズを対象市場とし、EC化率がなお低い水準にあるなかで、潜在的な支援ニーズの掘り起こしを掲げています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-09-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
