  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年5月に改定した中期経営方針では、2030年度の売上高2,000億円以上を長期的な経営指標の定量目標とし、ブレーキ配管事業及び燃料配管事業に加え、データセンター事業、生産ソリューション事業、冷蔵庫向けワイヤーコンデンサー事業など非自動車関連の次世代コア事業を拡大していくことを目指しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "自動車部品が売上高の9割超を占める一方で、データセンター向け冷却装置など非自動車関連の新事業を拡大し、マルチポートフォリオの構築を目指しています。日本、北南米、欧州、中国、アジアの5つの地域で生産販売する体制です。",
        "basis": "自動車部品の外部顧客への売上高が連結売上高の90%を超えています。報告セグメントは日本、北南米、欧州、中国、アジアの5つです。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "競合企業が内燃機関車向け製品から撤退する中、顧客が必要とする限り撤退しない「サンオー・ラストマン・スタンディング戦略」により、局地的には独占的に供給できる体制を整え、市場占有率と価格決定権を高めています。",
        "basis": "競合企業が内燃機関車向けの製品からは撤退していく中、ユーザーやお客様である自動車メーカーが従来の自動車配管製品を必要とされている限り最後まで撤退はしないという「サンオー・ラストマン・スタンディング戦略」を2020年から掲げております。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
