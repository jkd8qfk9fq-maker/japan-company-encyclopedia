  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "使命は「愛される『ものがたり』を全世界に」です。2023年2月に中長期的な成長戦略「東映グループ中長期VISION TOEI NEW WAVE 2033」を策定し、映像事業収益の最大化、コンテンツのグローバル展開へのチャレンジ、映像事業強化のための人的投資の拡大、持続的なチャレンジと成長を支える経営基盤強化の4つの重点施策に取り組んでいます。売上構成比率における海外割合50％を目指しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "多様で魅力的な作品群を生み出す企画製作力と、IPホルダーとして収益最大化を実現するマルチユース展開力を持ちます。劇場用映画の製作から配給、シネマコンプレックスの運営までグループで手がけています。",
        "basis": "【事業の内容】及び【経営方針、経営環境及び対処すべき課題等】の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高は185,333百万円で、映像関連事業が127,941百万円と全体の約7割を占めています。地域別の売上高は日本120,533百万円、アジア20,280百万円、北米24,928百万円、その他19,591百万円です。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-24",
