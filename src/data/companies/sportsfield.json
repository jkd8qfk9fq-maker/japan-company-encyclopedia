    "strategy": {
      "disclosed": {
        "text": "既存事業の持続的な成長に加え、スポーツに関わる新規事業の拡大により、「スポーツ人財会社」から「日本を代表するスポーツカンパニー」への飛躍を図ることを経営戦略とし、M&Aを積極的に推進するとしています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "採用支援で培ったスポーツ人財との接点を土台に、スポーツ用品など周辺領域へ事業を広げて、スポーツに関わる幅広い会社へ変わろうとする戦略です。",
        "basis": "経営戦略に既存事業の成長と新規事業の拡大、M&Aの積極的な推進が印字され、当期にはスポーツ用品のリンドスポーツが連結子会社となっているため。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "スポーツ人財とスポーツ市場に特化し、一人の担当者が就職アドバイザーと人事コンサルタントを兼ねて人財一人ひとりに多くの時間をかける対応を続けることで、人財と企業の双方から信頼を得ている点が強みです。",
        "basis": "事業の内容に、特長としてスポーツ人財・スポーツ市場への特化と、一人ひとりへのきめ細やかな対応による信頼関係が印字されているため。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
