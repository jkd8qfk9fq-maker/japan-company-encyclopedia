  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本理念として「社会貢献」「自己実現」「願望実現」を掲げ、ニーズの多様化に対応した業容拡大や新規事業の開発、業務用の食材を低価格で提供することによる地域社会への貢献、キャッシュ・フローを重視した事業運営など、7項目の実現を目指しています。経営の実践では、人間尊重を基盤として顧客第一主義と現地現場主義を掲げ、新たな経営テーマとして業務フローの革新とDX推進による生産性向上に取り組み、収益力の拡大を目指しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "二つの大きなフランチャイズチェーンの加盟店として、フランチャイズ本部から商品の安定供給や店舗運営の事業システム・ノウハウの提供を受けながら店舗を運営している点が特徴です。食品、車、精肉という生活に密着した小売を複数持ち、業務スーパー223店舗、オートバックス71店舗、お肉のてらばやし191店舗の店舗網があります（2026年3月31日現在）。",
        "basis": "【重要な契約等】・【事業の内容】の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、業務スーパー事業が132,840百万円で全体の半分以上を占め、車関連事業が49,651百万円、精肉事業が24,091百万円、その他が25,615百万円です。本邦の売上高が全体の90％を超えています。",
        "basis": "【セグメント情報】の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
