  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「顧客の利益が我々の利益である」ことを念頭に、常に変革を求めて会社の活性化を図ることを経営方針としています。中期経営計画「Progress 65 ～成長と効率化の両立に向けて～」（2025年度から2029年度まで）では、「成長戦略と資本効率の改善」「DX戦略の強化」「サステナビリティへの取り組み」の3つを重点施策として、事業環境に左右されない確固とした収益基盤の構築を目指しています。",
        "asOf": "2026-01-21",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1964年の創業以来の建設機械レンタルを軸に、仮設ユニットハウス、地盤改良やシールド工法向けの特殊機械、計測機器、道路建設機械など、工事の種類ごとに専門のグループ会社を持つ構成です。グループ各社がレンタル用資産を融通し合うため、幅広い機種を効率よく貸し出せる体制になっています。",
        "basis": "【事業の内容】・【沿革】の記載",
        "asOf": "2026-01-21",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは建設関連のみで、2025年10月期の外部顧客への売上高は連結売上高213,266百万円のうち190,225百万円を占めます。売上高の90%以上は国内であり、海外はオーストラリア、中国、東南アジアなどにレンタル子会社を持つ展開です。",
        "basis": "【セグメント情報】・【関連情報】の記載",
        "asOf": "2026-01-21",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
