  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスとして「ものづくりによる信頼、真摯な技術、自由な創造力で、次世代の豊かな未来をカタチづくる」を掲げています。2025年5月に策定した長期ビジョン「Vision60」では「脱・金型部品依存」を掲げ、2026年5月に策定した中期経営計画「ＶＣ28」では、収益性の改善と次の成長に向けた基盤構築に集中し、金型部品事業での特注品特化と生産性向上、ＦＡ事業の育成・拡大などに取り組むとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "中期経営計画は、基盤である金型部品事業で特注品への特化を進めながら、ＦＡ事業を第２の収益柱として育てる構成になっています。国内事業と海外事業の両方で特注品に対応する方針は、標準製品と特注品を併せて扱う現在の事業内容とつながっています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営戦略等の記載と、【事業の内容】の国内事業及び海外事業の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "熱処理技術や研削加工技術を活かした社内生産と、約300社の協力工場による社外生産を両輪とする製造活動を行っています。全国10ヵ所の販売拠点を配置し、顧客密着型の受注活動を基本に製造直販を行っており、充実した生産設備を持つ製造部門と販売部門が一体となった製販一体型の事業を行っているとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "標準製品に加えて多様な特注品に対応できる生産体制と、国内と中国を中心とする生産・販売の拠点網が、幅広い業種の顧客への対応を支えています。中国では34ヵ所の販売拠点を展開しています。",
        "basis": "【事業の内容】の国内事業における製造と販売の記載、海外事業における生産拠点と販売拠点の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
