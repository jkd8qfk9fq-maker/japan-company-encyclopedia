  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "10年後のありたい姿（長期ビジョン）を定めた上で、2026年度よりスタートする新たな3ヶ年の中期経営計画の策定を進めており、中期ビジョンとして「変化への対応スピードとやりきる力で持続的成長を実現」を掲げ、市場価値を高める事業展開と選択集中、競争力を支えるものづくり革新とDX実装、人財力を引き出す成長支援型組織づくりの3つを柱とします。",
        "asOf": "2026-11-09",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点分野として、市場の大きい自動車・住宅関連の金属切断・木工用丸鋸製品と競合の少ない合板・紙工関連の平刃製品をグローバル戦略製品に、EV・半導体関連の高精度刃具と新素材切断刃を新市場攻略製品に位置づけ、重点市場は北中南米とインドとしています。重点技術は希少素材の微小化、コーティング、接合、レーザクラッド、熱処理です。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の製品及びサービスごとの情報と地域ごとの情報、【経営方針、経営環境及び対処すべき課題等】、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-11-09",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "平刃類、精密刃具類、丸鋸類の3つの製品区分を持つ総合刃物メーカーで、日本、インドネシア、中国、ベトナムに生産拠点を持ち、米国、欧州、ブラジル、インド、メキシコなどに販売拠点を展開しています。携帯用電気鉋用ブレードで小型・高精度な刃物製作を始め、チップソーや金属切断用丸鋸へ分野を広げてきた技術の蓄積があります。",
        "basis": "セグメント情報の外部顧客への売上高、【事業の内容】、【沿革】、関連情報の地域ごとの情報に基づきます。",
        "asOf": "2026-11-09",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "工業用機械刃物の専業メーカーで、地域別セグメントでは日本が外部顧客への売上高の半分強を占め、インドネシア、米国、欧州、中国、ブラジル、ベトナムの現地法人が各地域を担当しています。製品区分別では丸鋸類が最も大きく、次いで平刃類、精密刃具類の順です。特定の顧客への売上高が10％以上に該当するものはありません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-11-09",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
