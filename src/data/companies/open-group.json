  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "顧客企業に対してRPA、AI等のサービスを提供する事業と、RPA、AI等の技術を活用した事業を行うことによって、グループ各事業のさらなる成長と収益力の強化を図る方針です。インテリジェントオートメーション事業では、中堅中小企業をメインターゲットに「BizRobo!」「AUTORO」のユーザー数の拡大や適用業務領域の拡大により、収益基盤であるストック収入の拡大を図り、「RoboRobo」では無料ユーザーの拡大と有料ユーザーへの転換を進めます。アドオートメーション事業では、国内アフィリエイト広告市場において取扱高と取扱シェアの拡大を図ります。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "インテリジェントオートメーション事業は、オンプレミス向けの「BizRobo!」とクラウド向けの「AUTORO」をそろえ、導入企業の拡大に伴ってストック型のライセンス収入が伸長する収益構造を持っています。アドオートメーション事業では、RPA等を活用したマーケティングデータの収集・集計・レポーティング業務の自動化が競争優位性とされています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、RPA市場は普及期に入り引き続き成長していく見通しであること、中堅中小企業をメインターゲットにユーザー数の拡大によりストック収入の拡大を図ることが印字され、アドオートメーション事業についてオートメーション化による競争優位性を武器に取扱高、取扱シェアの拡大を図る方針が印字されています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年2月期の売上高8,148百万円のうち、インテリジェントオートメーション事業が5,638百万円と約7割を占め、アドオートメーション事業が1,317百万円、その他が1,192百万円と続いています。",
        "basis": "【セグメント情報等】の当連結会計年度における外部顧客への売上高に、インテリジェントオートメーション事業5,638,487千円、アドオートメーション事業1,317,024千円、その他1,192,577千円、合計8,148,088千円が印字されています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
