  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念に基づく使命を顧客創造とし、『最高の料理』『最高のサービス』『最高の空間』の3つの『ご馳走』品質を向上させ、コンセプトである『ご馳走カンパニー』の実現を経営の基本方針としています。中長期的には、収益の見込まれる物件を厳選し、全て直営店舗で東海地区、関東地区、関西地区、九州地区への拡大を目指す方針です。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、『ブロンコビリー』を群馬県に3店舗、埼玉県に2店舗、大阪府・兵庫県・福岡県に各1店舗開店し、1店舗を閉店してグループ合計161店舗体制としました。140店舗突破大感謝祭などの販促や数量限定の高品質なステーキの投入で来店につなげ、子会社の株式会社レ・ヴァンでは『かつ雅』創業30周年大感謝祭を実施しました。株式会社松屋栄食品本舗では当社店舗向けの製造割合が6割を超え、常温保存のステーキソースやドレッシングの店頭販売も始めています。",
        "basis": "MD&Aの経営成績等の状況の概要及び【経営方針、経営環境及び対処すべき課題等】の中長期的な会社の経営戦略",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ステーキやハンバーグを自社工場（ファクトリー）で加工して毎日店舗へ出荷し、野菜も毎日配送する体制で鮮度を保っています。仕入・商品開発・商品製造までをグループで一貫して行い、市場では流通しない不揃い品等の加工が必要な食材も使うことで、食材ロスの低減と低コストの仕入を実現しています。オープンキッチンの炭焼き台や大かまど、サラダバーを備えた店舗形式も特徴です。",
        "basis": "【事業の内容】、【経営方針、経営環境及び対処すべき課題等】の対処すべき課題及びサステナビリティに関する考え方及び取組の戦略、【主要な設備の状況】",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "飲食事業の単一セグメントで、2025年12月期の売上高30,219百万円は全て国内の店舗販売によるものです。地域別の販売高は東海地区13,561百万円、関東地区10,564百万円、関西地区4,903百万円、九州地区660百万円、その他528百万円で、発祥地の東海地区が最大です。店舗数は『ブロンコビリー』146店舗、とんかつ業態14店舗、居酒屋業態1店舗の合計161店舗で、売上高の10％以上を占める主要な顧客はありません。",
        "basis": "セグメント情報等（単一セグメント）及び関連情報の主要な顧客ごとの情報、MD&Aの販売実績（地域別）",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
