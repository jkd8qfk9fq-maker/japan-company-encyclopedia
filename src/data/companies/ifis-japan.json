  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 決算日後のグループ内再編が【関係会社の状況】の注記に記載されています。2026年１月１日を効力発生日として、連結子会社の株式会社テンナイン・コミュニケーションを吸収存続会社とし、株式会社アイコスを吸収消滅会社とする吸収合併を行いました。また、2026年４月１日を効力発生日として、当社を吸収存続会社とし、アイフィス・インベストメント・マネジメント株式会社を吸収消滅会社とする吸収合併を行うことにいたしました。本登録は2025年12月期の構造で登録しています。"
    ]
  },
  "updatedAt": "2026-11-23",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「紙媒体」と「電子媒体」両方でのサービス、ソリューションを提供するユニークな情報ベンダーとして、証券会社、機関投資家、上場会社の各セクター間での情報伝達とドキュメント処理のサービス・インフラを強化し、顧客基盤を拡大して、インタラクティブな情報仲介サービスへ発展させることを基本方針としています。中長期的には、情報提供サービスの電子配信ビジネスと情報処理を主としたドキュメントビジネスを両輪とし、発行市場に関する情報配信、個人向け投資情報サービスの拡大、ITソリューション事業の拡大、「IFISブランド」の確立、ランゲージソリューション事業の拡大に重点を置いています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "5つの事業はいずれも金融市場の情報伝達に関わる領域で、投資情報とドキュメントの両輪に、システム開発と翻訳・通訳を組み合わせる構成です。2024年10月に子会社化した株式会社テンナイン・コミュニケーションの業績を通年で取り込んだランゲージソリューション事業が大きく伸び、事業構成の柱の一つになりました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】におけるセグメント別の売上高の記述に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "コンセンサスデータは、社内の専門スタッフが制作に従事し、独自の算出ルールと数段階のチェック体制でデータの即時性と精緻性を両立させている点が差別化の源泉とされています。証券調査レポートの電子書庫は、データ更新の速さ、情報量、使いやすさが評価され、レポート閲覧サービスで高いシェアを獲得しています。",
        "basis": "【事業の内容】における『IFIS Consensus』と『IFIS Research Manager』の説明に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "証券調査レポートの閲覧サービス『IFIS Research Manager』は、有報に圧倒的なシェアを獲得していると印字されており、主要な機関投資家のファンドマネージャーやアナリスト、主な上場企業のIR部署などで利用されています。",
        "basis": "【事業の内容】における『IFIS Research Manager』の利用状況の記述に基づきます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
