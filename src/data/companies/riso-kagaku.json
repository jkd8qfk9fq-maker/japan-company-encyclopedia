  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年3月期の経営方針として、印刷機器関連事業の収益体質の強化、理想科学らしい企画・開発の推進、コーポレート本部の企画力の充実、事業環境の変化への迅速な対応を掲げています。中長期的な課題として、インクジェット事業の収益力の強化と、経営環境の変化に適応して効率的で強い企業体質に変えることを挙げ、新規事業の創出にも取り組むとしています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期も、印刷機器関連事業の安定した運営、理想科学らしい企画・開発、コーポレート本部の企画力の充実という同じ三つの柱で運営されました。2024年7月にインクジェットヘッド事業を理想テクノロジーズ株式会社へ統合した効果が、印刷機器関連事業の売上高の増加に寄与したとされています。",
        "basis": "MD&Aの経営成績の状況の概要と経営方針の記載に基づく。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "製品・サービスの特長をいかした販売活動を全世界で展開し、新規事業の創出に向けた活動を行う方針を示しています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "高速インクジェット印刷と孔版印刷という二つの印刷方式の製品を持ち、印刷機器本体に加えて専用インクや原紙などの消耗品を継続して販売する体制があります。地域別の売上高は日本37,202百万円、欧州19,695百万円、アジア16,339百万円、米州5,753百万円で、海外向けの売上高が日本向けを上回っています。",
        "basis": "事業の内容、関係会社の状況、セグメント情報の地域別売上高に基づく。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "印刷機器関連事業の外部顧客への売上高は77,317百万円で、連結売上高78,990百万円の大半を占めています。地域別ではフランスの売上高が8,977百万円、中国の売上高が8,108百万円と、それぞれ連結売上高の10%以上を占めています。売上高の10%以上を占める特定の顧客は存在しません。",
        "basis": "セグメント情報の外部顧客への売上高と、関連情報の地域ごとの情報・主要な顧客ごとの情報に基づく。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
