  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期的な経営戦略として、事業ドメインである「オレオケミカルを中心とした化学品分野」に人的・物的・情報的な経営資源を集中的に展開する集中戦略を採用し、化学品事業、日用品事業及び土木建設資材事業の市場の深耕と、情報的経営資源の3事業での有効活用による事業間のシナジー効果の最大化を図っています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の9割超を化学品事業が占め、その基礎は花王株式会社のケミカル事業の国内主要代理店としてオレオケミカルを流通させる基盤にあります。日用品事業と土木建設資材事業はいずれも化学品事業で蓄積した界面活性剤の専門知識を活用する関連多角化であり、主力の化学品事業の深耕が全体の戦略の中心です。",
        "basis": "セグメント情報の外部売上高、事業の内容、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "オレオケミカルや界面活性剤の原材料を油脂メーカーから仕入れ、中間製品メーカーを経て最終製品メーカーまで届ける、化学品の原材料流通を川上から川下まで広くカバーする仕組みを持っています。得意先の開発テーマや製造上の課題を聞き取り、原材料選定の面から新商品開発を支援することで差別化を図っています。土木建設資材事業では、ジェット・グラウト工法の混和剤や汚染土壌浄化薬剤など、特定の工法に対する原材料の独占販売の地位を持っています。",
        "basis": "事業の内容に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "天然油脂由来のオレオケミカルに特化した化学品商社で、化学品事業が売上高の大部分を占めます。主要な仕入先は花王株式会社で、同社とは販売先としての関係もあり、主要な顧客としては三洋化成工業株式会社が開示されています。中国とタイに連結子会社を持ち、アジアでの販売も行っています。",
        "basis": "セグメント情報及び主要な顧客ごとの情報、事業の内容、関係会社の状況に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
