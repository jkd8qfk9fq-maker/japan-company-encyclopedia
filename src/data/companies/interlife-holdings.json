  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年２月期を初年度とする第５次中期経営計画において、「持続的な利益成長による企業価値向上を目指し、新たな成長ステージへの基盤を構築する」との基本方針のもと、①新たな成長基盤の構築、②更なる収益力の向上、③ＥＳＧ経営の推進の３つの重点施策を進めています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "第５次中期経営計画の初年度である2026年２月期は、重点施策である新たな成長基盤の構築として、設備・メンテナンス事業の玉紘工業株式会社の全株式を売却し、ファシリティーマネジメント株式会社を㈱日商インターライフに吸収合併する事業ポートフォリオの再編を実施し、２事業４社体制となりました。売上高は16,336百万円と前年を下回りましたが、親会社株主に帰属する当期純利益は828百万円と過去最高を更新しています。",
        "basis": "セグメント情報の売上高と、MD&Aの経営成績等の状況の概要による。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商業施設等の企画・デザイン・設計・制作・施工管理から、建物内外の清掃請負や空調設備機器等のメンテナンスまでをグループで一貫して受注できる体制が強みです。2025年６月の吸収合併により、㈱日商インターライフは自ら施工する商業施設等の清掃・メンテナンス業務までを一貫体制で受注できるようになりました。また、㈱日商インターライフは、リサイクル紙とアルミ箔のハイブリッドボードで特許取得済みの省エネ・環境保護商材「アトラスボード」を山田ダンボール株式会社と共同で開発し、その開発・施工を進めています。",
        "basis": "事業の内容に記載された事業内容と、MD&Aの事業別の営業概況、サステナビリティに関する考え方及び取組による。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "内装工事事業と音響・照明設備事業の２つの報告セグメントで構成され、2026年２月期の外部顧客への売上高は内装工事事業10,046百万円、音響・照明設備事業6,265百万円です。売上高はすべて国内であり、本邦以外の国又は地域の売上高はありません。外部顧客への売上高のうち連結売上高の10％以上を占める相手先はなく、顧客は分散しています。",
        "basis": "セグメント情報等（セグメント情報、地域ごとの情報、主要な顧客ごとの情報）による。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
