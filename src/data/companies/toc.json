  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「社会に役立つ企業」に基づき、お客様に「明るく、活力のある、和やかな」場を提供することを使命として事業を推進しています。中長期的には、中核事業である不動産事業を中心に、新規事業と既存事業の融合を図りながら、グループ事業全般の強化に努めるとしています。所有するビルについては、運営の効率化とよりきめ細かなリニューアルの実施により個々の付加価値を高め、営業を再開したTOCビルでは、催事機能や物流機能といったビルの特性を活かして稼働率の向上を図るとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、耐震補強などのリニューアル工事を経て2024年9月より順次営業を再開したTOCビルをはじめ、既存ビルの入居率・賃料の改善により不動産事業が増収となり、連結売上高は前期を上回りました。新TOCビル計画については、着工時期を2036年以降と想定する長期の計画と位置付けています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析並びに経営方針の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "西五反田のTOCビル、大崎ニューシティ、浅草の商業施設群「ROX」など、都内に自社保有のビル・商業施設を複数持ち、賃貸に管理・運営を一体で営んでいます。施設の運営業務やスポーツクラブ・温浴施設の運営までグループ会社が担い、建物の価値を自社グループで高める体制を持ちます。",
        "basis": "事業の内容及びセグメント情報の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "都心のオフィス賃貸市場で空室率の低下と賃料の回復基調が続く中、自社保有ビルの運営効率化とリニューアルによる高付加価値化で差別化を図る不動産賃貸事業者です。不動産を基幹としながら、ホテル向けリネンサプライと胃腸薬等の製薬事業を併せ持つ複合的な事業構成が特徴です。",
        "basis": "経営方針、経営環境及び対処すべき課題等並びに事業の内容の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
