  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「成長を志す人財と変革（挑戦）を志す組織（企業）と共に、新しい価値を創造し続け、常に成長し続けます」を掲げ、企業スローガン「夢をカタチに！和食を世界に！」のもと、和食文化を日本から世界の各地域へ広げる架け橋となることを目指しています。経営サポート事業と飲食事業の連動で独自の「プラットフォーム」を形成し、経営サポート事業では国内の出退店サポートを中心とした営業体制の充実と、外国人材紹介サポートを事業の柱に育てることを課題とし、飲食事業では既存店の収益力の向上に注力し、不採算店舗や成長が鈍化した店舗はブランド転換や売却も検討するとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自ら飲食店を直営しライセンス展開も行う会社が、その現場で得た知見を使って、他の飲食店の出店・退店・設備・人材・海外進出までを一貫して支援できる点が特徴です。支援する側と店舗を経営する側の両方の事業を自社グループで持つことで、飲食店経営の課題に沿ったサービスを生み出しています。",
        "basis": "【事業の内容】に、飲食店舗の運営と出退店サポートの両事業を自社グループで担う体制と、飲食事業で培ったノウハウを経営サポート事業に活かす旨が印字されていること",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
