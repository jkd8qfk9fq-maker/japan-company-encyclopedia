  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "使命として「大豊グループはトライボロジーを基盤とした製品とエンジニアリングをもって社会に貢献する」を掲げ、2030年に向けて「常に社会のニーズを把握して、技術（材料・工法）を極めて、新たな商品を生み出す集団」を目指す姿としています。持続的成長に向けて既存事業の強化を進め、新領域・新事業の創出により企業価値の最大化を図る方針です。基盤として「人」を大事にする会社であり続けることを、大切にする価値観としています。",
        "asOf": "2026-07-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "すべり軸受を中心とした既存事業の維持・強化に取り組むとともに、収益性の確保と事業基盤の安定化を図る方針です。「地球環境とお客様への貢献」を基本的な考え方とし、「グローバル供給を支える製造・生産技術」、「製品技術・生産技術の改善」、「人財力の強化」などを通じて、競争力の維持・向上に努めるとしています。",
        "asOf": "2026-07-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高119,378百万円のうち、自動車部品関連事業が106,066百万円と大半を占め、製品別では軸受製品が47,405百万円で最大です。地域別では日本が72,712百万円で最も大きく、米国14,543百万円、中国11,127百万円、アジアその他10,381百万円、その他10,612百万円が続きます。最大の顧客であるトヨタ自動車株式会社への販売は総販売額の27.2％を占め、同社への販売依存度が高い構成です。",
        "basis": "【セグメント情報等】の報告セグメントごとの情報と【関連情報】の地域ごとの情報・主要な顧客ごとの情報、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の販売実績、【事業等のリスク】の特定の得意先への販売依存度の記述によります。",
        "asOf": "2026-07-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
