  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ドローンソリューションと運航管理の2つのセグメントを通じて、ドローンによる産業課題の解決と、UTMの社会実装による低空域経済圏の構築を中長期的な事業構想としています。段階出資でリスクを抑えながらM&Aで世界のドローン関連企業を取り込む「テラ群戦略」を進め、欧州や中東へのUTMの提供地域の拡大と、空飛ぶクルマ向け運航管理システムの開発に取り組むとしています。",
        "asOf": "2026-09-07",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ベルギーの子会社Unifly NVのUTMは欧州のU-space規制に準拠した実装実績を持ち、各国の航空管制機関への提供が進んでいます。自社開発の超音波板厚点検ドローンは特許を取得し、石油メジャーの製油所などでの点検実績を重ねています。",
        "basis": "【事業の内容】に、Unifly NVが欧州を中心とした各国の航空管制機関（ANSP）へのUTM提供実績を持つこと、Terra UTドローンが特許取得済みでありシェルの製油所やBASFでの点検を提供していることが印字されていること。",
        "asOf": "2026-09-07",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ドローンサービス企業として2024年に世界1位を獲得しており、日本のほか東南アジア、欧州、中東、北米に子会社を置くグローバルな事業展開を行っています。",
        "basis": "【事業の内容】に、ドローンサービス企業として2024年は世界1位を獲得したことが印字され、【関係会社の状況】にインドネシア、オランダ、ベルギー、マレーシア、サウジアラビア、アメリカ、イタリアの子会社・関連会社が印字されていること。",
        "asOf": "2026-09-07",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
