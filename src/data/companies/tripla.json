  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「tripla Book」を中心に、「tripla Bot」「tripla Connect」「tripla Boost」「tripla Pay」「tripla Analytics」「tripla Link/Nexus」「tripla Page」などの導入施設数の拡大と取扱高の増加、付加価値の提供による単価の向上を通じて継続的な成長を目指しています。各サービスを相互に提案するクロスセルを進め、宿泊施設の自社予約の増加と収益の最大化を支援します。アジア太平洋地域を中心に販路の拡大を続け、海外子会社の活用や買収後の統合を通じた製品の置換などでグループ一体の相乗効果の創出も図ります。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "「tripla Book」の強みは拡張性の高さと多機能性にあります。クラウド型で提供しているため、機能を開発した後に速やかに提供と改善を行うことができ、汎用的に使える機能はすべて内製で開発する方針です。顧客への徹底したヒアリングに基づき優先順位を付けて機能開発を進め、「tripla Bot」や「tripla Connect」などの他サービスとも連携して提供価値を高めています。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "宿泊業界では訪日観光客の増加を背景に観光需要が回復し拡大しています。一方で宿泊施設では人手不足や運営コストの上昇が進み、省人化や業務効率化、直販の強化やマーケティングの高度化を目的としたデジタル化の重要性が高まっています。同社は宿泊施設に特化した予約や接客、顧客管理などのサービス群を一体として提供する位置にあります。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境に、訪日観光客の増加による観光需要の回復と拡大、宿泊施設の人手不足や運営コスト上昇を背景としたデジタル化の重要性の高まりが印字され、対処すべき課題に予約の獲得から接客、顧客管理、マーケティング、決済、外部チャネル連携までを一体として支援する方針が印字されているため。",
        "asOf": "2026-01-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
