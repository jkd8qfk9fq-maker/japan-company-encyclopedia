  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「VISION 2031」では、社会課題と顧客課題の解決を進める「価値創造型IT企業グループ」への変革を掲げています。2025年9月期は3か年の中期経営計画「co-creation Value 2025」の最終年度で、飲食業界の人手不足の解消を目指す次世代型IoTサービスの研究開発や、顧客の経営・IT課題に対して上流工程から支援する企画提案型のコンサルティングを進めました。2026年9月期を初年度とする中期経営計画「Growing Beyond 2028」では「成長基盤の強化」に注力するとしています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ソフトウェア開発からインフラの設計構築、システム運用支援、ITコンサルティングまでをグループで幅広く担える体制があり、開発や運用を顧客の事業所への常駐と自社内実施の双方で引き受けています。システム運用管理を起点に事業を広げてきた会社であり、運用と開発の両方を持つことが受託の幅につながっています。",
        "basis": "【事業の内容】に、ソフトウェア開発からインフラ設計構築、システム運用支援、ITコンサルティングまで幅広くトータルに支援するITソリューションを提供すると印字され、ソフトウェア開発とシステム運用のいずれも顧客の事業所内に常駐する業務と当社内で行う業務があると印字されていること",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上の大半は基盤事業と位置づけるITソリューション事業が占め、自社製サービスを担うITサービス事業はまだ小さい構成です。会社は新規事業の創出を課題に挙げ、自社保有技術の活用に加えてM&Aを含む社外リソースの活用を積極的に行い、早期の事業化を目指すとしています。",
        "basis": "セグメント注記の【関連情報】に2025年9月期の外部顧客への売上高はITソリューション9,967百万円、ITサービス168百万円と印字され、【経営方針、経営環境及び対処すべき課題等】の対処すべき課題に、ITソリューション事業を基盤事業と位置づけることと、新規事業の創出に向けてM&Aを含む社外リソースの活用等を積極的に行うことが印字されていること",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
