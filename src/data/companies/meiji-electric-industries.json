  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "第11次中期経営計画（2024年度～2026年度）では、「エリアNo.1の存在価値のあるパートナーになる」をスローガンに、事業品質向上、成長投資と収益力強化、サステナビリティ推進、資本コスト経営を主要な戦略課題としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "計画の課題は、地域に根差した営業体制の品質向上とエンジニアリング力の強化に向けられており、商社機能とFAエンジニアリングを組み合わせる事業の進め方と整合しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の主要な戦略課題と【事業の内容】の営業体制",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "大手FA機器メーカーの代理店として多彩な商品を取り扱い、自社のエンジニアリング事業本部と子会社・関連会社による設計・製造、ソフトウェア開発、保守・修理まで対応できる体制があります。物流拠点を集約し、注文を受けた翌日に商品を届ける体制も整えています。",
        "basis": "【事業の内容】の取扱商品、国内営業体制と業務管理体制",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "単一セグメントで、品目別では産業機器の売上高が最も大きく、制御機器、計測機器が続きます。地域別では日本の収益が大半を占め、主要な顧客は株式会社デンソーです。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の品目別売上高、収益認識関係の地域別収益の分解情報、セグメント情報等の主要な顧客ごとの情報",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
