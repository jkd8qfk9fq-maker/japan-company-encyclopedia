  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン「LIVZON DREAM 2030」の実現に向け、2026～2030年度を対象とする中期経営計画「LIVZON DREAM 2030 2nd half!」を策定しました。成長戦略は、産業用・医療用施設案件等で培った技術力を活用する「高度エンジニアリング領域の拡大」、保守・改修領域での継続収益を最大化する「ストック収益の最大化」、DX・標準化・外部活用による「生産性の向上」の３つです。ブランドステートメント「たてものを、いきものに」を掲げ、「総合たてものサービス企業」への飛躍を目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1941年の創業以来、空気調和・給排水衛生・電気設備工事を中心に、設計・施工管理・メンテナンスまでを一貫して手がけてきました。恒温恒湿、除湿、熱交換、冷凍冷蔵といった高度な環境制御の工事にも対応できることが、産業用・医療用施設などの案件で培った技術力につながっています。",
        "basis": "事業の内容（設備工事事業の取扱分野）と経営方針（創業以来の事業の歩み）の記載に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は日本で、2026年３月期は475億26百万円と連結売上高617億19百万円の大半を占めます。海外では米国のALAKA'I MECHANICAL CORPORATIONが連結売上高の10％を超える主要な連結子会社で、米国セグメントの売上高は123億50百万円です。主要な顧客としては、売上高の10.1％を占める株式会社フジタが開示されています。",
        "basis": "セグメント情報（地域別の外部顧客への売上高）、関係会社の状況（ALAKA'I MECHANICAL CORPORATIONの連結売上高に占める割合）、経営成績等の状況の概要（主要な顧客ごとの情報）の記載に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
