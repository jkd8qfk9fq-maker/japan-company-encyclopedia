  "history": [
    {
      "year": 1946,
      "title": "山﨑鉄工所として創業",
      "description": "静岡県浜松市寺島町に山﨑鉄工所として創業し、日本楽器製造株式会社（現ヤマハ株式会社）向けの楽器部品と、日本専売公社（現日本たばこ産業株式会社）浜松工場向けの専用機・治工具などの製造を始めました。",
      "significance": "現在の工作機械事業と部品製造の起源です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1955,
      "title": "ヤマハ発動機の協力工場となる",
      "description": "ヤマハ発動機株式会社の設立に伴い、その協力工場となりました。",
      "significance": "現在の輸送用機器事業の主要な顧客との関係の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "株式会社山﨑鉄工所を設立",
      "description": "自動二輪車部品を製造する目的で、静岡県浜松市浅田町に株式会社山﨑鉄工所を設立しました。",
      "significance": "法人としての出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "現在地に本社・工場を全面移転",
      "description": "事業の拡張と合理化・近代化のため、静岡県浜松市有玉北町489番地の23（現在地）に本社及び工場を全面的に移転し、設備の拡充と環境の整備を行いました。",
      "significance": "現在の本社工場の所在地です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
