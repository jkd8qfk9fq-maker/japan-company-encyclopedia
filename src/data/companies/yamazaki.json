  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "自動車業界で進むEV化、カーボンニュートラル、CASE技術などによる産業構造の変化に対し、従来のビジネスモデルにとらわれず変革し、強固な経営基盤の確立を目指しています。優先的に対処すべき課題として、省人化・省力化設備の製作や、工作機械や輸送用機器にとらわれない新たな市場への進出を掲げ、新たな半導体製造装置や水処理プラントの受注を目指して営業活動を行っています。グローバル化への対応では、ベトナム子会社を東南アジア戦略の拠点とし、輸送用機器業界以外への参入やASEANでの取引拡大を目指しています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "工作機械部門で開発した設備を社内の生産に使い、そこで得た知見を工作機械の商品にフィードバックする相互連携の仕組みを持っています。個別のニーズに細かく対応できる工作機械用の機械ユニット（主要機械構成部）を標準化・商品化することで、信頼性の向上とコストの低減を図り、顧客の計画段階の早い時期から生産設備の最適化を提案しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営方針・経営戦略等の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主な得意先は自動車産業で、輸送用機器事業ではヤマハ発動機が主要な顧客です。工作機械事業は企業の設備投資の動向の影響を受けやすく、2026年3月期は設備投資の慎重な姿勢が続く中で専用工作機械の販売が減少しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績の概要と、【セグメント情報】の主要な顧客ごとの情報に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
