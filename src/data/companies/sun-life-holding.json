  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2033年の創業100周年に向けて、2023年を起点とする10年間の取組み「Sustain100～持続可能な明日へ～」を掲げています。式典事業では終活総合支援事業「ライフリリーフ」の拡充と戦略的な新規斎場の出店を進め、介護事業では看護師・ヘルパーの確保と処遇改善、M&Aによる事業領域の拡大に取り組むとしています。互助会事業では、会員の顧客基盤を活かしながら、無料登録の制度などを通じて会員以外の顧客基盤の拡大にも取り組むとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期には、式典事業で5棟のファミリーホールを開設し、介護事業では事業譲受によりデイサービス事業所を開設しました。開示された方針にある新規出店とM&Aによる事業拡大が、当期の実際の動きと一致しています。",
        "basis": "沿革と経営成績の分析における、2026年3月期中の新規斎場の開設とデイサービス事業所の事業譲受の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "互助会事業については、前払式特定取引の前受金にもとづく強固な顧客基盤を活かし、顧客のニーズに応じた商品・サービスの開発と拡充を続けると述べています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "グループは、互助会の会員を入口として、葬儀・法要などの式典、介護、ホテル・婚礼まで、人生の節目に関わるサービスを神奈川県と東京都の地域内でそろえています。会員を抱える事業と、施設でサービスを提供する事業が同じ地域にそろっていることが、事業構成の特徴です。",
        "basis": "事業の内容における事業構成と、セグメント情報における事業別の売上高の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "式典事業を取り巻く環境については、葬儀規模の縮小傾向や家族葬を中心とした簡素化志向の高まりにより、市場環境は大きく変化していると述べています。一方で、超高齢社会の到来により、介護・福祉サービスや葬祭関連サービスへの需要は底堅く推移するとの認識を示しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、主要エリアの死亡数の減少により葬儀の施行件数が減った一方で、介護事業は施設の入居率とサービス利用件数の増加、ホテル事業は婚礼の施行組数の増加により売上高が伸び、連結の売上高は前期を上回りました。",
        "basis": "経営成績の分析における、事業別の売上高と施行件数・入居率の推移の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
