  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "対処すべき課題として、コーポレート・ガバナンスの充実、財務基盤の強化、低コスト体制の徹底、人材の確保・育成、事業基盤の強化を掲げ、財務基盤については新株発行による増資で連結純資産の増強を目指すとしています。今後の方針として、省エネルギーに関するノウハウをAIデータセンターにも活用し、エネルギー効率が高いコンテナ型データセンターの構築に取り組むこと、M&Aへの積極的な取組や株式会社HARUMI TRUSTを中心とした投資事業の展開、環境・衛生ソリューション事業、再生可能エネルギー事業、リノベーション事業の３つの既存事業を収益部門として確立させることを示しています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の８割超をリノベーション事業が占め、創業来の省エネルギー関連事業は２割弱にとどまるなど、2022年に子会社化した不動産事業がグループの収益の中心に移っています。2026年３月期は本業の収支が黒字に転じた一方、親会社株主に帰属する当期純損失は５期連続で計上されており、連結純資産の棄損が進んでいることから、財務基盤の強化が開示上も喫緊の課題と位置づけられています。",
        "basis": "セグメント情報（報告セグメントごとの売上高、主要な顧客ごとの情報）及びMD&A（業績等の概要、経営成績の分析）に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1986年の創業以来手がける省エネルギー分野では、エネルギー使用量削減保証型のESCO事業に取り組んできた実績があり、設備導入から企画、設計、販売、施工、コンサルティングまでを一貫して提供できる体制を持ちます。リノベーション事業では、物件の仕入れから改修、販売までを連結子会社が手がけ、太陽光発電設備を保有する売電事業もグループ内に備えています。",
        "basis": "事業の内容（各事業の内容）、セグメント情報（報告セグメントの概要）及び沿革に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "エネルギー価格の上昇や脱炭素への対応が進む中で、省エネルギー設備の導入や施設改修への需要を事業機会として捉えています。当社グループは売上高5,251百万円、連結従業員数21人の小規模なグループであり、リノベーション事業の好調が2026年３月期の増収を牽引しました。新たに小型・分散型AIデータセンターの建設・受託開発とGPUクラウド事業への参入を表明し、成長領域の開拓を進めています。",
        "basis": "MD&A（業績等の概要、経営戦略の現状と見通し）及びセグメント情報（主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
