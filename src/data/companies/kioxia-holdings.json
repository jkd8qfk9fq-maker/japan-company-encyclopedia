  "perspectives": {
    "competitiveAdvantage": {
      "disclosed": {
        "asOf": "2026-06-24",
        "locator": "【経営方針、経営環境及び対処すべき課題等】",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "当社グループは、自らをフラッシュメモリ業界におけるテクノロジーリーダーと位置づけ、市場リーダーの求める製品の開発を推進するとともに、世界最大級のフラッシュメモリ工場を活用し、生産規模及び生産効率を最大化することで高いコスト競争力を実現するとしています。"
      }
    },
    "industryPosition": {
      "analysis": {
        "asOf": "2026-06-24",
        "basis": "セグメント情報（製品及びサービスに関する情報、地域別情報、主要な顧客に関する情報、2026年3月期）",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "売上収益をアプリケーション別に見ると、SSD & ストレージが最も大きく、スマートデバイス、その他の順です。地域別では欧米向けが最も大きく、アジア、日本の順に続いています。外部顧客への売上収益の10％以上を占める顧客はAppleグループです。"
      }
    },
    "strategy": {
      "disclosed": {
        "asOf": "2026-06-24",
        "locator": "【経営方針、経営環境及び対処すべき課題等】",
        "sourceIds": [
          "yuho-2026"
        ],
        "text": "「『記憶』で世界をおもしろくする」というミッションのもと、高成長市場にアクセス可能な幅広い製品ポートフォリオを持ち、各アプリケーションの主要顧客との強固な関係構築を継続するとしています。SSD & ストレージでは、中期的に大手データセンター、エンタープライズ顧客向けを中心にシェアの確保に取り組み、長期的にはSSD市場におけるより高いシェアの獲得を目指します。2024年11月に策定した長期財務モデルについては、業績がこれを大幅に上回って成長しているため、2026年6月2日のInvestor Dayで新しいモデルに置き換えたことが報告されています。"
      }
    }
  },
