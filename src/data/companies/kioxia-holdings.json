  "history": [
    {
      "description": "株式会社東芝において、世界初のNAND型フラッシュメモリが発明されました。",
      "locator": "【沿革】",
      "significance": "電源を切っても記憶が消えない不揮発性メモリとして世界標準となり、現在のキオクシアグループの事業の原点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "世界初のNAND型フラッシュメモリを発明",
      "year": 1987
    },
    {
      "description": "三重県に四日市工場が設立されました。",
      "locator": "【沿革】",
      "significance": "現在もキオクシア株式会社の主力製造拠点であり、6つの製造棟を棟間搬送で連結する統合生産体制の中心です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "四日市工場を設立",
      "year": 1992
    },
    {
      "description": "Sandiskグループ（当時のSanDisk Corporation）とフラッシュメモリについて協業を開始しました。",
      "locator": "【沿革】",
      "significance": "共同出資の製造合弁会社による四日市・北上両工場での共同生産へと発展し、現在まで続く提携の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "Sandiskグループとフラッシュメモリの協業を開始",
      "year": 2000
    },
    {
      "description": "メモリセルを垂直方向に積み上げる3次元フラッシュメモリ技術が開発されました。",
      "locator": "【沿革】",
      "significance": "微細化の限界を積層化で乗り越える技術で、後のBiCS FLASH™につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "3次元フラッシュメモリ技術を開発",
      "year": 2007
    },
    {
      "description": "48層積層プロセスを用いたBiCS FLASH™のサンプル出荷が始まりました。",
      "locator": "【沿革】",
      "significance": "3次元フラッシュメモリの製品化が進み、現在は第8世代BiCS FLASH™を量産しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "BiCS FLASH™のサンプル出荷を開始",
      "year": 2015
    },
    {
      "description": "株式会社東芝の100％子会社として旧東芝メモリ株式会社が設立され、同年4月に会社分割により東芝のメモリ事業（SSD事業を含み、イメージセンサ事業を除く）を承継しました。",
      "locator": "【沿革】",
      "significance": "東芝の社内カンパニーだったメモリ事業が独立した会社となり、現在のキオクシア株式会社の直接の前身ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "東芝メモリ株式会社を設立し、東芝のメモリ事業を承継",
      "year": 2017
    },
    {
      "description": "株式会社東芝が旧東芝メモリ株式会社の全株式を、Bain Capital Private Equity, L.P.を軸とする企業コンソーシアムにより組成された買収目的会社・株式会社Pangeaへ譲渡しました。同年8月、Pangeaが旧東芝メモリ株式会社を吸収合併し、東芝メモリ株式会社に社名変更しました。",
      "locator": "【沿革】",
      "significance": "東芝グループを離れ、投資ファンド主導の経営体制に移行しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "東芝がメモリ事業をPangeaへ譲渡",
      "year": 2018
    },
    {
      "description": "東芝メモリ株式会社からの単独株式移転により、持株会社の東芝メモリホールディングス株式会社が設立されました。同年10月、ブランド名称のキオクシアへの刷新に伴い、当社はキオクシアホールディングス株式会社に、東芝メモリ株式会社はキオクシア株式会社に社名変更しました。",
      "locator": "【沿革】",
      "significance": "現在の純粋持株会社体制と「キオクシア」の社名がこの年に始まりました。キオクシアは日本語の「記憶」とギリシャ語の「価値（AXIA）」に由来します。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "持株会社を設立し、キオクシアに社名変更",
      "year": 2019
    },
    {
      "description": "キオクシア株式会社が、台湾・LITE-ONテクノロジー社の子会社であるSolid State Storage Technology Corporationとその関係会社の全株式を取得しました。",
      "locator": "【沿革】",
      "significance": "SSD製品の製造、販売及び研究開発を行う会社がグループに加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "LITE-ON社のSSD事業会社を取得",
      "year": 2020
    },
    {
      "description": "当社の株式が東京証券取引所プライム市場に上場しました。",
      "locator": "【沿革】",
      "significance": "2018年の東芝グループ離脱以来、非上場だった当社が上場会社となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "東京証券取引所プライム市場に上場",
      "year": 2024
    },
    {
      "description": "岩手県北上市の北上工場で第2製造棟（K2棟）が稼働を開始しました。2022年4月から建設が進められていた製造棟です。",
      "locator": "【沿革】",
      "significance": "四日市工場と並ぶ製造拠点である北上工場の生産能力が増強されました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "title": "北上工場第2製造棟が稼働開始",
      "year": 2025
