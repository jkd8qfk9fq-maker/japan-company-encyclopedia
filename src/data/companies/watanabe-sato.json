  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「佐藤渡辺グループ中期経営計画（2024～2026年度）」では、「変革と学習文化の醸成および持続可能性への取り組み」をテーマとし、収益力の向上、資本・財務戦略の強化、ESG経営の推進の3つを基本方針として掲げ、グループ一丸となって取り組んでいます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績およびキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "計画の軸は、舗装工事の請負とアスファルト合材の製造・販売という既存の2部門を土台に、収益力と財務基盤を強化することにあります。",
        "basis": "事業の内容、MD&Aの経営成績等の状況の概要、セグメント情報（主要な顧客ごとの情報）",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "舗装工事に使うアスファルト合材を自社グループで製造・販売しており、工事の施工と材料の供給を一体で担えます。技術研究所では舗装・土木技術の研究開発を行っています。",
        "basis": "事業の内容、主要な設備の状況、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建設事業の単一セグメントで、完成工事高の81.1％が舗装工事です。2026年3月期の売上高が前年を下回った理由として、MD&Aは国土交通省関東地方整備局から受けた営業停止処分（2025年4月9日から8月6日まで）の影響で工事の受注時期が遅れたことを挙げています。主要な顧客である東京ガスネットワーク株式会社への売上高は、売上高の10.2％を占めます。",
        "basis": "セグメント情報（主要な顧客ごとの情報）、事業の内容、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
