  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年6月期から2027年6月期を対象とする3ヵ年の中期経営計画を進めており、最終年度の2027年6月期に売上高1,500億円の達成を目標としています。長期的には、新製品・新市場・新事業の成長によって、2030年6月期に売上高2,000億円の達成に向けて取り組んでいます。「SHIBUYA未来ビジョン宣言」では、存在意義を「ダントツ共進化で社会に役立つものをつくる」と定めています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "飲料を無菌環境下でPETボトルに常温で充填する無菌充填システムは技術的な優位性が多くのユーザーに支持され、国内シェアは80～90％に上ると推定しています。電子線ボトル滅菌方式による無菌充填システムなど、薬剤や水の使用量を減らす技術も開発しています。人工透析装置は海外向けの売上高の割合が80％を超えています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年6月期の売上高の構成は、パッケージングプラント事業が84,041百万円、メカトロシステム事業が38,997百万円、農業用設備事業が12,574百万円です。地域別では日本が80,271百万円と最も大きく、アジア18,701百万円、中国15,506百万円、北米13,288百万円と海外販売も広がっています。ニプロ株式会社への販売実績は22,850百万円で、総販売実績の16.9％を占めています。",
        "basis": "セグメント情報および関連情報（地域ごとの情報、主要な顧客ごとの情報）の印字に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
