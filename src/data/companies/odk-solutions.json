  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念に「情報サービス事業を通じて、顧客の繁栄・社会の発展に貢献する。」を掲げ、長期ビジョンを『ビジネスを、スマートにつなぐ。人生の、ストーリーをつむぐ。』、提供する社会的価値を『データに、物語を。』と定めています。中期経営計画（2027年３月期～2029年３月期）では基本方針に「ＯＤＫグループ拡大」、基本戦略に「コア事業の収益最大化と最新テクノロジーの活用、グループシナジーの最大化」を掲げ、従来の情報処理アウトソーシングによる安定収益を基盤に、『UCARO®』を軸としたデータビジネスと『アプデミー®』のプラットフォーム拡充、M&A・アライアンスの推進を進める方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1964年の大学入試業務、1965年の証券業務の受託開始以来、基幹業務の運用を長年担ってきた実績があり、売上高の９割超をシステム運用が占める継続的な受託基盤を持っています。運用に開発・保守を組み合わせた一貫体制で、子会社の採用・キャリア支援サービスと学生接点のデータを連携させる展開も進めています。",
        "basis": "【事業の内容】における業務開始時期とサービス構成の記述、およびセグメント関連情報におけるサービス別の売上高構成の記述に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス産業では、企業のDX、AI導入、データ基盤整備への投資意欲が高い水準で推移し、市場のさらなる拡大が見込まれる一方、慢性的な人材不足が続いています。当社グループは教育業務と証券・ほふり業務を主力の顧客分野とし、2026年３月期の売上高は過去最高となりました。",
        "basis": "経営者による分析における情報サービス産業の環境認識と、顧客分野別の売上動向の記述に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
