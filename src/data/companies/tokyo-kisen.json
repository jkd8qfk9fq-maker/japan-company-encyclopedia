  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主力の曳船事業では、増加するコストに見合う曳船料率の改定を2025年5月に実施し、今後は運航定員の削減や船隊規模の最適化、AIを使った配船支援システムの導入による効率化を進めるとしています。環境面では、2023年に就航したハイブリッド型電気推進曳船の運航で得た知見を生かし、2030年を目途に純バッテリー曳船の投入を目指すとしています。洋上風力発電向け事業は本業のひとつとして成長させる方針で、交通船（CTV）に加えてSOV等の事業開発や船員の教育訓練に取り組むとしています。旅客船事業では、東京湾フェリーが2027年秋から新造船の裸用船による船舶の代替を行う計画です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "当社グループの曳船は、浦賀水道・中ノ瀬航路における船舶のエスコート業務、東京湾各港における船舶の離着桟補助業務、LNGバース等での警戒船業務、防災業務、緊急出動・海難救助に従事し、東京湾全域にわたって船舶の安全航行をサポートする体制を特徴としています。洋上風力発電向けでは、2013年から交通船（CTV）を手がけてきた実績があります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の売上高13,144百万円の内訳は、曳船事業が9,517百万円（約72.4％）、海事関連事業が1,956百万円（約14.9％）、旅客船事業が1,670百万円（約12.7％）であり、曳船事業が大半を占めています。顧客別では、東京湾海事事業協同組合向けが売上高の11.08％と印字されています。",
        "basis": "セグメント情報等の外部顧客への売上高及び関連情報の主要な顧客ごとの情報に印字された金額と割合に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
