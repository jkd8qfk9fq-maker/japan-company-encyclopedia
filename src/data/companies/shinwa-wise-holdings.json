  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 連結子会社（孫会社）のシンワメディコ株式会社は、2026年6月17日開催の同社株主総会において解散を決議し、本書提出日現在、清算手続中である旨が印字されています（決算日後の事象）。本登録は2026年5月31日現在のグループ構造に基づいています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年7月15日に公表した中期経営Vision FY2027－FY2029で、既存事業（オークション及びプライベートセール）の立て直しとコレクティブ分野への横展開、美術品等を担保とする動産担保ローン事業（アート×金融）の立ち上げ、グローバル展開並びにAI査定及び真贋証明等のテクノロジーの実装の3点を柱として掲げ、2027年5月期を構造改革の完了年度、2028年5月期以降を成長フェーズと位置付けています。また、ガバナンス・内部統制等の管理体制の強化、アート関連事業への成長投資、丸の内エリア再開発に伴う事務所の移転に取り組むとしています。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "当連結会計年度は、プライベートセールの売上高が前期から半減する一方、オークション事業の取扱高は前期を上回っており、グループの収益の中心がオークションにより移っています。過年度に生じた会計処理に係る事案を受けて、取引審査、会計判定及び開示に係るプロセスの整備を進め、信頼の回復を経営の起点と位置付けていることも読み取れます。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績の概要と認識及び分析・検討内容）の記述に基づく。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "近代美術オークションでは、出品点数と落札点数が前期を下回る中でも、落札価額の合計がエスティメイト（落札予想価格）の下限合計を大きく上回る水準で推移しており、高額な美術品の出品を受けて価格を形成してきた実績が示されています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析のオークション事業の記述に基づく。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "アートオークション市場については、価格の上昇をにらんだ良品の出し渋り傾向が引き続きみられ、以前に比べ低調に推移しているとしています。一方で、インフレによる現金資産の実質的な目減りが意識されやすい状況のもと、実物資産への需要は引き続き一定レベルを保っていると認識しています。",
        "asOf": "2026-08-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    }
  },
