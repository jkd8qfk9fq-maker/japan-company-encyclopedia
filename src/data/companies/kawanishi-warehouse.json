  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン『KAWANISHI2030』と、2027年度を最終年度とする中期経営計画『Vision2027 事業領域の拡大』を策定しています。次世代型物流施設の計画推進、ASEAN投資、リコンストラクション（拠点・組織の再構築）を三大重点戦略として掲げています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年にはベトナムのTOAN PHAT LOGISTICS JOINT STOCK COMPANYを、2026年には株式会社エムティーサービスを子会社化し、決算日後にはGBtechnology株式会社の株式取得契約を締結するなど、M&Aで事業領域を広げる動きが続いています。",
        "basis": "沿革、企業結合等関係の注記、重要な後発事象の注記に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "神戸、大阪、名古屋、横浜、東京といった港湾都市に倉庫拠点を持ち、倉庫業に港湾運送と貨物運送取扱を組み合わせた一貫した体制を国内で備えています。海外ではシンガポール、タイ、インドネシア、ベトナム、アメリカに現地法人を持ち、輸出入貨物の取扱いから現地での倉庫事業まで対応しています。",
        "basis": "事業の内容、関係会社の状況、主要な設備の状況に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への営業収益は、国内物流事業が21,484百万円と全体の約8割を占め、国際物流事業は4,532百万円です。倉庫業を中核とする中堅の総合物流会社として、国内の港湾都市を地盤に事業を行っています。",
        "basis": "セグメント情報の外部顧客への営業収益、事業の内容に基づく",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
