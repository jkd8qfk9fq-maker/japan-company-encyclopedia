  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 重要な後発事象：2026年４月28日開催の取締役会において、グローバルでの生産拠点の最適化の一環として、連結子会社であるアメリカンファインシンター株式会社（AFS）での生産事業を停止することについて決議いたしました。生産を段階的に停止し、他拠点への生産移管を行い、事業の停止は2028年３月末の予定です。2026年3月31日現在の関係会社の状況では、AFSは議決権の所有割合100.0％の連結子会社として印字されています（停止前の構造）。"
    ]
  },
  "updatedAt": "2026-11-12",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年５月に新たな中期経営計画（Vision2030）を開示し、「変革を遂げる」を基本方針に掲げています。事業ポートフォリオの継続的な見直しを通じた重点事業への経営資源の集中と収益基盤の強化を図るとともに、人的資本への投資を通じて将来志向の組織・人材への変革を推進するとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点実施項目は収益基盤の強化とポートフォリオ変革で、売上の大半を占める自動車焼結事業を軸にしながら、磁性材・鉄道・油圧の重点事業へ経営資源を集中させる方針が読み取れます。",
        "basis": "経営方針の中期経営計画と重点実施項目の記述、セグメント注記の外部顧客への売上高、MD&Aの事業ポートフォリオ変革の記述",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "粉末冶金工法を活用し、金属粉末から高強度・高精度・耐摩耗性や摩擦摺動性など、最終製品が求める様々な特性を焼結部品の形で実現しています。鉄道向けでは集電性と耐摩耗性を両立した材料開発、油圧機器では小型で静粛性の高い油圧コンポーネントが強みとして述べられています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【研究開発活動】"
      },
      "analysis": {
        "text": "同じ粉末冶金の技術基盤を、自動車・鉄道・油圧機器という複数の用途の部品に応用している点が、３つの報告セグメントに共通する技術の土台になっています。",
        "basis": "セグメント概要の製品特性の記述、研究開発活動のセグメント別記述、事業の内容の製品構成",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の外部顧客への売上高は、自動車焼結事業が41,895百万円と連結売上高の大半を占め、鉄道焼結事業が2,381百万円、油圧機器製品事業が1,920百万円です。主要な顧客ごとの情報には、自動車焼結事業の顧客としてデンソーとトヨタ自動車が印字されています。",
        "basis": "セグメント注記の外部顧客への売上高、関連情報の主要な顧客ごとの情報、地域ごとの情報",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
