  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "新造船事業では、一般貨物船や自動車運搬船などの外航船と、フェリーやRORO船などの内航船のプロダクトミックスを推進し、パナマックスサイズの中型船から小型フェリーまで多彩な船種を建造するとしています。受注一貫体制（営業・設計・調達・現業）の充実によるコスト競争力の強化とリスク管理の徹底、2工場への戦略的な設備投資による業容の拡大とコストダウンも掲げています。改修船事業では、スピーディーかつ柔軟な対応による顧客満足度の向上と、技術とノウハウによる高品質な修繕を掲げています。2027年3月期については、連結業績予想の売上高460億円の達成を念頭に、生産性の向上などに努めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中堅造船所として技術力を国の内外から高く評価されていると自社で位置づけ、豊富な建造実績のある中小型フェリーやRORO船などの船種を持っています。瀬戸田・因島の2工場体制を活かし、同型船の連続建造で生産性の向上に取り組んでいます。国土交通省の内航船省エネルギー格付制度では、建造船23隻が最高評価を獲得しています。",
        "basis": "経営方針における技術力と経営戦略の記述、経営成績等の分析における2工場体制と同型船の連続建造の記述、サステナビリティに関する取組における省エネルギー格付の記述に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高の大部分を船舶事業が占める造船専業に近い構成です。2026年3月期の外部顧客への売上高は船舶事業が464億97百万円、その他の区分が518百万円でした。顧客は官公庁と国内外の船会社に集中しており、防衛装備庁と海外の船会社2社、株式会社フジトランスコーポレーションの4先で総販売高の60％～70％を占めています。",
        "basis": "セグメント情報の注記（報告セグメントごとの外部顧客への売上高、主要な顧客ごとの情報）と経営成績等の分析におけるセグメントごとの経営成績の記述に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
