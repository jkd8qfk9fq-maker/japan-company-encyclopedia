  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年４月28日開催の取締役会において、東京都品川区にある賃貸用ビル（土地・建物）の譲渡を決定し、所有権持分を段階的に移転する予定です。その他（不動産賃貸事業）の登録は、2026年３月31日現在の保有・賃貸の構成に基づいています。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「2027中期経営計画」の初年度として、安全・品質・コンプライアンスを最優先とする「ＳＱＣファースト改革」を経営の基軸に据え、コア事業である電力機器・計量事業の再生と強靭化を進めています。成長分野として第２世代スマートメーター、ＥＶインフラ、半導体検査の３事業に注力し、10年後の目指す姿として「SERAカンパニー」を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "受変電・配電用機器から計器まで、電力ネットワークの結節点となる製品を幅広く手がけ、製造だけでなく据付工事や保守まで担える体制を持っています。第２世代スマートメーターでは、製造から物流、取付工事、データ活用まで、サプライチェーン全体に関与する体制を構築しているとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年３月期の外部顧客への売上高は、電力機器事業が63,864百万円と連結売上高の過半を占め、計量事業が33,212百万円、ＧＸソリューション事業が12,370百万円、光応用検査機器事業が1,666百万円、その他（不動産賃貸）が979百万円です。最大の顧客は東京電力パワーグリッド株式会社で、売上高は43,862百万円（連結売上高の39.1％）です。本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "セグメント注記の外部顧客への売上高、関連情報の主要な顧客ごとの情報と地域ごとの情報（本邦の売上高が90％を超えるため記載を省略）、販売実績に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
