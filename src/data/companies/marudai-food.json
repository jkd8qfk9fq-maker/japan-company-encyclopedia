  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「日々の活動に精一杯の真心を込め、誠意を尽くすことにより、社会に貢献します」を掲げ、未来像として、美味しさと健康を追求し、安全・安心な食品を通してお客様の幸せな食生活に貢献することを掲げています。2026年4月を起点とする中期三ヵ年経営計画（2029年3月31日まで）では、「新たな顧客価値の創造」「収益構造の改革」「事業領域の拡大」「人財の育成」「持続可能な社会への貢献」の5つを基本方針とし、計画最終年度である2029年3月期の連結売上高2,550億円を目標としています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "北海道から九州まで全国11か所に自社工場を持ち、戸田フーズやトーラクなどの製造子会社とあわせて、全国で加工食品を製造する体制を備えています。食肉事業でも丸大ミートやミートサプライなどの子会社が加工・販売を担い、製造から販売までをグループ内で行えることが強みです。",
        "basis": "【主要な設備の状況】に提出会社の工場11か所（北海道・岩手・新潟・関東・茨城・横須賀・静岡・松阪・高槻・広島・唐津）がいずれも加工食品事業の製造設備として印字され、【事業の内容】に戸田フーズ株式会社・安曇野食品工房株式会社・トーラク株式会社などが加工食品事業を、丸大ミート株式会社・株式会社ミートサプライなどが食肉事業を担うと印字されている。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約3分の2を加工食品事業が占める構成で、本邦の外部顧客への売上高が連結売上高の90％を超える、国内中心の事業です。",
        "basis": "【セグメント情報】の外部顧客への売上高（加工食品事業160,500百万円、食肉事業77,763百万円、その他132百万円、連結238,396百万円）と、【関連情報】に本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えると印字されていることによる。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
