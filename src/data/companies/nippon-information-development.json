  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念として「ヒューマンウェア」を掲げ、顧客の一歩先を見通し付加価値を提供することを経営の基本方針としています。優先的に対処すべき課題として、新しい事業ポートフォリオの開拓、既存事業の収益性の拡大、営業戦略の拡充、業務改革推進による生産性の向上、人材確保の強化、ビジネスパートナーとの強固な関係強化、技術革新への対応及び開発力の強化を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、1967年の創業以来続く情報サービス事業の実績と、開発から構築、保守・運用までをグループ内で担える体制です。沿革には、ISO9001・ISO14001・ISO27001の認証をNIDグループ全社で取得したことが記されており、品質と情報セキュリティーの体制が裏付けられます。金融・保険、情報・通信、公共・社会インフラ、運輸など幅広い分野に顧客基盤を持ち、特定の分野への偏りが小さいことも特長です。",
        "basis": "事業の内容における事業分野と関係会社の位置付け、沿革における認証取得の記載、セグメント情報における報告セグメントごとの外部顧客への売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成は、システム開発事業18,497百万円、システムマネジメント事業6,056百万円、その他1,874百万円で、システム開発事業が約7割を占めます。売上高は国内のみです。主要な顧客であるANAシステムズ株式会社への売上高は2,171百万円で、全体の8.2％です。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と関連情報（地域ごとの情報、主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における相手先別販売実績の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
