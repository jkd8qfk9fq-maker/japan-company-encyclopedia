  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様の公正な資本競争力の向上とグローバルな資本経済の発展に貢献する」という企業使命のもと、株式議決権に関わるコンサルティングと経営支配権に関わるM&Aアドバイザリーを両輪として、エクイティ・コンサルティングの普及、PA/FA業務の拡大、付加価値のある証券代行サービスの提供、人的資源の拡充に取り組むとしています。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "実質株主判明調査を基軸とする平時の株主対応と、アクティビスト対応や支配権争奪などの有事対応を組み合わせ、金融グループに属さない独立系の専門家集団として上場企業を支援する戦略です。",
        "basis": "経営方針に、創業以来、特定の金融系列に属さない独立性を保持し、上場会社と投資家を結ぶブリッジ役に徹してきたこと、中長期的な経営戦略の重要課題としてエクイティ・コンサルティングの普及とPA/FA業務の拡大などを掲げることが記載されていることによるものです。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "機関投資家や個人株主のネットワークと、株主や株式に関する公開情報を蓄積したデータベースを持つことが強みです。",
        "basis": "事業の内容に、ファンドマネージャー、アナリスト、議決権行使担当者を網羅する機関投資家ネットワークや、WEBアンケートシステム「株主ひろば」に登録する58,704名の個人株主とのネットワーク（2026年3月31日現在）を利用して情報を日々収集していることが記載されていることによるものです。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "IR・SR活動に専門特化した単一セグメントのコンサルティング会社で、証券代行事業では株主名簿管理人として93社の企業にサービスを提供しています。",
        "basis": "セグメント情報に事業がIR・SR活動に専門特化したコンサルティング業の単一セグメントであることが、経営方針に2026年3月31日時点で93社（管理株主約57万人）へ証券代行サービスを提供していることが記載されていることによるものです。",
        "asOf": "2026-06-12",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
