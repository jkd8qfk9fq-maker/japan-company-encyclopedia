  "businesses": [
    {
      "id": "ordered-product",
      "name": "受注型Product事業",
      "description": "IoT技術を用いた製品・ソリューションの企画、設計、製造から運用・保守サポートまでを垂直統合で行い、顧客が望む製品を柔軟に提供する事業です。セットトップボックス（STB）やウェアラブル端末「Cygnus2」、コードレス呼び出しチャイムなどを手がけ、製品に付加価値を付けて再販するVAR（付加価値再販パートナー）と協業して販路を広げています。2026年1月期の外部顧客への売上高は219百万円でした。",
      "customers": [
        "ホテルや飲食店などの宿泊・飲食事業者",
        "当社製品に付加価値を付けて再販するVAR（付加価値再販パートナー）"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "traas",
      "name": "TRaaS事業",
      "description": "BtoB市場向けに、顧客の価値を最大化するためのIoTソリューションと最適なモノを選定し、そのモノを起点としたSaaSサービスを提供する事業です。AI電力削減ソリューションサービス「AIrux8」、流通小売店舗向けDX製品「店舗の星」、LEDサイネージ及びサイネージ配信プラットフォーム「CELDIS」を展開しています。2026年1月期の外部顧客への売上高は143百万円でした。",
      "customers": [
        "携帯キャリアショップや流通小売店舗などのロケーションオーナー",
        "パートナー企業"
      ],
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【事業の内容】"
    },
    {
      "id": "technical-service",
      "name": "テクニカルサービス事業",
      "description": "基幹業務システム等のアプリケーションソフトウェアの受託開発、システム運用に必要なパソコンやサーバー等の提供及びメンテナンス、開発したソフトウェア及びシステムのメンテナンスや常駐型保守に向けたエンジニア派遣サービスを提供する事業です。2026年1月期の外部顧客への売上高は123百万円でした。",
      "customers": [
        "基幹業務システムなどの開発・運用を委託する企業"
      ],
