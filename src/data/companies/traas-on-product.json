  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "単なるモノの販売から脱却し、モノづくりを基盤としたSaaS月額課金型サービスを主力事業とすべく事業転換を進めています。対処すべき課題として、専門パートナーとの協業体制の構築や他企業との業務提携の推進による販路の拡大と収益の最大化、既存顧客へのクロスセル、顧客満足度及び品質の向上を挙げています。",
        "asOf": "2026-04-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "IoT製品の設計から製造までを一気通貫で行う垂直統合の体制を持ち、開発したソフトウェアの知的財産権を社内に蓄積して横展開することで、短期間・少人数での開発や、競合の少ない小ロット生産にも対応できることが強みです。",
        "basis": "事業の内容に、IoT製品の設計から製造までを一気通貫で行う垂直統合型のビジネスを展開していること、ソフトウェア開発を内製化していること、ソフトウェアの知的財産権を社内に蓄積し転用することで短期間・少人数での開発を実現し小ロットでの生産にも対応していることが書かれているため。",
        "asOf": "2026-04-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
