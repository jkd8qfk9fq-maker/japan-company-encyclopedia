  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "10年後のあるべき姿の実現に向けて企業理念を再定義し、2024年度から2026年度までの3ヵ年の中期経営計画「Ever Onward 2026」では、「経営基盤の再構築」「ソリューションビジネスの確立」「横編機事業の再生」「自動裁断機事業の拡大」の4つを重点施策として、サステナブルなモノづくりを支援する製品・サービスの提案活動を世界各地で展開しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "中期経営計画の2年目にあたる2026年3月期は、売上高が前期比3.0％増の33,509百万円となり、親会社株主に帰属する当期純利益は前期の当期純損失から黒字に転じました。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1964年の全自動手袋編機の開発以来、編機の開発を積み重ね、1995年には完全無縫製型コンピュータ横編機を製品化しました。編機とデザインシステムを一体で提供できることが事業の土台になっています。",
        "basis": "事業の内容の製品構成、セグメント情報の外部顧客への売上高、沿革の開発の経緯、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約8割が海外向けで、地域別ではアジアが16,034百万円と全体の約半分を占め、欧州が8,207百万円、日本が6,160百万円と続きます。世界のニット生産地が主な市場です。",
        "basis": "関連情報の地域ごとの売上高、セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-06-24",
