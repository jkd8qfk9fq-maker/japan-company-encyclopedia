  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2021年10月から2030年９月までの９ヵ年に及ぶ長期経営計画『～100年選ばれ続ける会社を目指す！～』のもと、急激に変容していく経営環境の中でも永続的な成長ができる総合専門工事会社となることを目指しています。テーマとして「ゼネコン上位10社でのシェアNo.1」と「成長性分野開拓」を最終年度の達成目標として掲げています。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年９月期の売上高は前連結会計年度比19.0％増の10,647百万円となりました。設備工事業の外部顧客への売上高は1,482百万円と前連結会計年度の892百万円から大きく伸び、建設工事業も9,165百万円と増収となり、全体の伸びを支えました。",
        "basis": "セグメント情報等の外部顧客への売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）による。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1957年の設立以来、建物の防水工事を専門としてきました。1968年にはわが国初の超高層ビルである三井霞が関ビルのシーリング防水工事を施工し、他社に先がけて建物シーリング防水工事のノウハウを取得したと有報に記載されています。新築防水工事、改修工事、直接受注工事に加え、設備工事まで当社グループとして受注する仕組みを整えている点も特徴です。",
        "basis": "沿革、事業の内容による。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約86％を建設工事業が占めています。主要な顧客ごとの情報では鹿島建設と大成建設の大手ゼネコン２社が主要な顧客として開示されており、この２社で売上高の約28％を占めています。",
        "basis": "セグメント情報等の外部顧客への売上高、関連情報（主要な顧客ごとの情報）による。",
        "asOf": "2025-12-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
