  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "会社は、商圏人口1万人をターゲットに、自社競合を厭わず自ら商圏を分割して、小さな商圏の消費者にとって最も便利な買い物の拠点となる店づくりを進めるとしています。出店は「インクが染み出すように」徐々にエリアを広げる方針で、集客力のある店舗を高密度に集中出店しながら、限定商圏での高占有率の獲得をめざします。調剤でもシェア拡大をめざしています。対処すべき課題には、人材教育、マニュアルの整備、コンピュータシステムの充実の3つを挙げています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は、日常生活の消耗品を主とした商品構成で来店頻度と買上点数を同時に追求するビジネスモデルのため、商圏を小さく設定でき、出店候補地に窮することなく多店舗展開ができると述べています。あわせて、医薬品・化粧品の専門知識を持つスタッフが気軽に相談に応じる「ライトカウンセリング」など、人的なサービスの強化に努めています。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
  },
