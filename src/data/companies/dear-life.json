  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「挑戦 2025 ～ Catch the Wave ～」の基本方針として、持続可能な社会の実現に向けた取り組み強化と不動産商社としての更なる成長を掲げています。重点テーマは、東京23区に重点を置いた不動産事業のオーガニックグロースと事業環境に合わせたポートフォリオ最適化、人材サービス事業における専門性・教育力・ブランド力を融合した「人材戦略パートナー」としての人的資本の最大化、M&Aの活用による戦略投資、人的資本投資とDX投資、財務健全性の維持と資本効率の改善です。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期は、土地の開発適地化を行うアセット・デザイン＆リセールを中心に35件、収益不動産43件を売却し、リアルエステート事業の売上高は74,569百万円（前期比74.1％増）となりました。人材サービスでは、派遣人材の採用強化と派遣品質の向上による高付加価値化を進めたとされています。",
        "basis": "MD&Aの経営成績の状況の概要に基づく。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "不動産投資ファンド・REITから個人投資家に至るさまざまなマーケットでの取引を通じて蓄積された「目利き」能力、建物企画、コンストラクションマネジメント、不動産運営実績、市場における情報ネットワークを基に事業を行っていると説明しています。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "東京23区内・駅徒歩10分圏内に集中して投資し、開発だけでなく、開発期間を短縮できるアセットデザイン＆リセールや収益不動産にも取り組むことで、事業の進め方を分散させています。",
        "basis": "中期経営計画の重点テーマとMD&Aの経営成績の状況の概要に基づく。",
        "asOf": "2025-12-16",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
