  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念である「進取の精神」と「自利利他の心」に基づき、2024年４月から中期経営計画「Jumping over the 130th ～成長の未来へ～」を進めています。2026年３月期はこの計画の最終年度に当たり、計画の完遂に向けて諸施策の実現に取り組んでいくとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商業施設事業は外部顧客への売上高の過半を占め、その中心は静岡県下有数の商業施設とされる「サントムーン柿田川」です。当社が施設を所有して賃貸し、連結子会社が運営・管理を担う体制で、賃貸による収入が継続的に得られる構造になっています。",
        "basis": "事業の内容における商業施設事業の位置付けと、セグメント情報の外部顧客への売上高、MD&Aにおけるサントムーン柿田川の位置付けの記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "1896年に羊毛紡織の会社として創業しましたが、現在の売上高の中心は商業施設事業であり、寝装品のヘルスケア事業と繊維に関わるせんい事業がこれに続きます。創業以来の繊維に関わる事業を残しながら、商業施設の賃貸・運営が最大の事業になっています。",
        "basis": "沿革における創業の記載と、セグメント情報の外部顧客への売上高の構成",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
