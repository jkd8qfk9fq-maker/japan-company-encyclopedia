  "updatedAt": "2026-11-21",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン『OYOサステナビリティビジョン2030』のアクションプランである中期経営計画『OYO 中期経営計画2026』では、セグメント戦略の推進、バランスシートの最適化、サステナブル経営の強化を3つの基本方針とし、セグメント戦略の深化、生産性向上、高付加価値サービスの創出を重点課題としています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点課題は3つの報告セグメントごとに戦略を深める方向であり、防災・インフラ、環境・エネルギー、国際という現在の事業構成に沿った計画です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の重点課題と【事業の内容】の事業区分",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "地質や地盤の調査技術に加え、地震計や地下レーダー、物理探査機器などの計測機器をグループ内で開発・製造・販売できる体制があり、調査から観測システムの構築までを一貫して担えます。",
        "basis": "【事業の内容】の事業内容と【関係会社の状況】の連結子会社の事業内容",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは防災・インフラ事業、環境・エネルギー事業、国際事業の3つで、2025年12月期の外部顧客への売上高は防災・インフラ事業が30,015百万円、環境・エネルギー事業が29,759百万円、国際事業が16,511百万円です。地域別では日本が60,064百万円と大半を占め、主要な顧客は国土交通省です。",
        "basis": "セグメント情報等の報告セグメントごとの売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
