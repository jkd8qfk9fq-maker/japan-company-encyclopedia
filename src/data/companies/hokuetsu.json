  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン「Vision 2030」を掲げ、その実現に向けた最終ステップとして2026年4月より「中期経営計画 2030」をスタートさせました。基本方針は「事業ポートフォリオシフトの加速」「競争力強化による優位性の確立」「サステナビリティ経営による価値創造」の3つで、パッケージング事業の拡大、白板紙再構築、輸出の拡大、戦略投資の4分野に注力するとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "国内最大規模の基幹工場である新潟工場の高効率操業を活かしたコスト競争力と、国内紙パルプ業界をリードする環境競争力を強みとしています。大王製紙株式会社との戦略的業務提携では、生産技術、原材料購買、製品物流におけるコストダウン施策で収益改善効果を積み上げてきたとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "洋紙・白板紙・パルプを手がける大手製紙メーカーの一つです。売上高の約9割を紙パルプ事業が占め、カナダの市販パルプ事業が海外の中核です。大王製紙株式会社が筆頭株主であり、両社は戦略的業務提携を通じて協業を深めています。",
        "basis": "【セグメント情報】に紙パルプ事業261,384百万円、パッケージング・紙加工事業17,437百万円、その他8,914百万円の外部顧客への売上高が印字され、【大株主の状況】に大王製紙株式会社が17.51％を保有する筆頭株主であることが印字され、【重要な契約等】に大王製紙株式会社との戦略的業務提携基本契約と2026年3月の覚書が印字されている。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
