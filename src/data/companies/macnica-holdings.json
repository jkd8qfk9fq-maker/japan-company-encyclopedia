  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年に向けたビジョン「Vision2030」で、これまでの成長を支えてきた高付加価値ディストリビューションのビジネスモデルを拡大しながら、サービス・ソリューションモデルへの変革を目指しています。中期経営計画（FY2025～FY2027）では、全社戦略として成長投資、ビジネスモデル変革、AI関連ビジネスの強化を掲げ、半導体事業は成長国への重点投資と成長市場の継続強化、サイバーセキュリティ事業は高付加価値運用支援サービスの強化とサービス・ソリューションの拡大、CPSソリューション事業はスマートシティ/モビリティとスマートマニュファクチャリングのビジネス拡大を戦略としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "独立系エレクトロニクス専門商社として、商品の物流機能だけでなく、顧客の課題への的確な提案や、新しい技術を使いこなすためのテクニカルサポートの提供によって、競合他社との差別化を図ってきたとしています。新しい技術を早く探し出し磨き込む目利き力で、最先端の半導体、電子デバイス、ネットワーク、サイバーセキュリティ商品を提供してきたとも述べています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
  },
