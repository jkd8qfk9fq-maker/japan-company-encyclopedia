  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "Mission『つながりで、人の可能性があふれる社会をつくる』のもと、Vision2030として『未来を担う若い世代から、もっとも選ばれるプラットフォームになる』を掲げています。中長期的な事業戦略では、既存の新卒採用領域での継続的な成長に加え、新卒領域以外における『第2の柱』となりうる事業開発を進める方針です。2024年度からの7ヵ年を前半・後半の2つのステップに分けて取り組み、2030年度をマイルストーンとしています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "創業当時から蓄積してきた登録学生の属性・行動データと、適性検査eF-1Gの受検結果によるパーソナリティデータを併せ持つ独自のデータベースが基盤です。eF-1GをOfferBoxに標準搭載し、自社で活躍する人材の行動特性で学生を検索できるようにしたことで、活躍・定着につながるマッチングを狙える点が特徴です。",
        "basis": "【事業の内容】におけるビッグデータの活用、eF-1Gの標準搭載、活躍人材データによる検索の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "同社は新卒ダイレクトリクルーティング市場のリーディングカンパニーを目指すとしています。2026年卒業予定者の登録学生数は23.9万人で、同年度の民間企業就職希望者数46.1万人に対して大きな基盤を持ち、企業登録数は22,456社に積み上がっています。売上高の約89％をOfferBoxが占めています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の位置付けの記載と【事業の内容】の登録学生数・企業登録数・売上構成の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
