  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是として『わがグループは総合レンタル業のパイオニアとして経済社会に貢献する』を掲げ、常にユーザーの立場からレンタル活用のメリットを追求し、商品開発・システム構築に努めています。中期経営計画「Next Stage 2026」（2024年9月期から2026年9月期まで）では、建機レンタル事業と運送物流事業を融合させた「建設ロジスティックス」、建機レンタル事業とイベント事業を融合させた「仮設のチカラ」を具体的に事業化し、成長性の高い海外でのM&Aも推進する方針で、2026年9月期の売上高は2,200億円を計画しています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1965年に道路機械のレンタルを始めた総合レンタルの先駆けで、土木・道路用機械から高所作業用機械、測量機器、イベント用機材まで幅広い貸与資産を持っています。電気設備工事、運送、建設工事用機械のオペレーション業務までグループで担えるため、工事現場の需要にまとめて応えられる体制です。",
        "basis": "【事業の内容】・【沿革】の記載",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の大部分はレンタル関連事業で、地域別では国内が189,481百万円、海外が25,473百万円です。海外はマレーシア、タイ、ベトナム、シンガポール、オーストラリアなどにレンタル子会社を持ち、アジアとオセアニアが中心です。",
        "basis": "【セグメント情報】・【関連情報】の記載",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
