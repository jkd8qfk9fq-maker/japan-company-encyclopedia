  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "主要な顧客である自動車分野で最先端の製品開発を支援してノウハウと知見を蓄え、建設機器、農機、医療、FAなどの分野の開発支援にも携わっていくとしています。あわせて、コンサルタントの人員数の制約を受けないストックビジネスとして、「Eureka Box」と「CoBrain」の拡販に注力するとしています。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "提案主体にとどまらず、提案した内容をコンサルタント自身が実践し、直接課題解決まで手掛けるワンストップ型の実践的なスタイルと、モデリング技術を中心とした組込みソフトウェア開発の技術が強みです。",
        "basis": "「第２【事業の状況】３【事業の内容】」に、提案した内容を実際に自分たちで実践し、直接課題解決まで手掛けるワンストップ型の実践的スタイルが特徴であること、モデリング技術を中心に組込みソフトウェア開発に有効な多くの技術を得意領域にしていることが書かれていることによります。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "組込みソフトウェア開発のコンサルティングでは、自動車分野の顧客が多くを占め、主要な顧客として株式会社ＳＵＢＡＲＵとトヨタ自動車株式会社が開示されています。自動車分野で培ったソリューションを医療や建設機械など他の分野へ広げることが課題の一つとされています。",
        "basis": "「第２【事業の状況】１【経営方針、経営環境及び対処すべき課題等】」に、主要な顧客である自動車分野への言及と、自動車分野以外の新規分野における収益基盤の強化が課題であることが書かれていること、セグメント情報の【関連情報】に主要な顧客が開示されていることによります。",
        "asOf": "2026-02-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
