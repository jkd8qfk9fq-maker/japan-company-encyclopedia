  "businesses": [
    {
      "id": "consulting",
      "name": "コンサルティング事業",
      "description": "当社グループの単一セグメントです。自動車やロボット、デジタル機器等の製品に組み込まれる組込みソフトウェアの品質改善を中心に、提案から課題解決までをワンストップで担うコンサルティングを提供しています。2025年11月期の売上高は1,386百万円でした。当社と連結子会社の株式会社ｂｕｂｏの２社でグループを構成しています。本社（東京都品川区）、名古屋プロジェクトルーム、大阪オフィスはいずれも単一セグメントの事業所のため、この事業全体に対応します。",
      "customers": [
        "自動車メーカー",
        "自動車部品メーカー（サプライヤー）",
        "ロボットやデジタル機器のメーカー",
        "株式会社ＳＵＢＡＲＵ",
        "トヨタ自動車株式会社",
        "ウーブン・バイ・トヨタ株式会社"
      ],
