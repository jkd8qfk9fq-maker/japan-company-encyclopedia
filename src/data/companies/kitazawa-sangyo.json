  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "食品加工機器・厨房機器の総合販売商社として、自社ブランドの商品と世界の優れた商品の提供に加え、キッチンコーディネイト、厨房設備の設計施工、新商品開発、メンテナンスサービス、ファニチャー販売までを一体で提供するトータルサポートを経営方針としています。重点課題として、提案営業の推進とアフターサービス体制の充実による既存事業の収益性の向上と事業基盤の強化、食品加工場やスーパーマーケットを中心とした中食分野など新たな需要分野への取り組み強化、人材の確保と育成、省エネルギー型・省資源型製品の開発と販売を通じた持続可能な社会の実現への取り組みを挙げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "業務用厨房機器の販売に、連結子会社による厨房機械器具と製菓・製パン機械器具の製造、修理・保守サービスを組み合わせ、厨房の企画や設備の設計施工から納入後の保守までをグループで担える体制を持っています。全国に15支店30営業所、6出張所の販売拠点を配し、24時間365日対応のサービス体制の充実を掲げています。",
        "basis": "【事業の内容】の事業構成と、【経営方針、経営環境及び対処すべき課題等】のトータルサポートとサービス体制の記載、【沿革】の販売拠点数の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "業務用厨房機器の総合販売会社として、連結子会社2社による製造機能を持ち、売上高のほとんどを業務用厨房関連事業が占めています。主要な取引先である外食産業の経営環境が厳しいなか、2026年3月期の売上高は14,031百万円と前期を下回りましたが、中食分野など新たな需要分野への営業展開を進めています。",
        "basis": "【セグメント情報】の外部顧客への売上高と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の主要取引先と売上高の記載",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
