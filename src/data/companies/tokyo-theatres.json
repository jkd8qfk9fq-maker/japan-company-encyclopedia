  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営方針『プロデュースカンパニーへの革新』をテーマに、消費者ニーズに沿った商品やサービスを自社で開発・創造する『ヒューマンリソース型ビジネス』への転換を進めています。基幹事業では、映像関連事業で『映画』から『映像エンターテインメント』へ事業領域を再定義すること、飲食関連事業で焼鳥専門店『串鳥』のセントラルキッチンの建築による製造能力の拡充と中食事業の収益拡大、中古マンション再生販売事業で年間300件におよぶ仕入れ販売数を安定的に実現する仕組みづくりを掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の過半を不動産関連事業が占め、会社の出発点である映像関連事業は３事業の中で最も小さい構成です。中期経営方針では、その映像事業の再建が基幹事業における主要な政策の一つに掲げられています。",
        "basis": "セグメント情報の外部顧客への売上高とMD&Aの経営成績等の分析、【経営方針、経営環境及び対処すべき課題等】の中期経営方針に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "新宿テアトルビルなど都心の自社保有物件を賃貸し、きめ細かいリーシング活動で100％近い稼働率を維持していること、札幌地区を中心に焼鳥専門店『串鳥』を展開しテイクアウト専門店を含む出店を進めていること、1993年以降、商業施設の映画館の運営受託を重ねてきた映画館運営の実績を持つことが、各事業を支える基盤です。",
        "basis": "MD&Aの経営成績等の分析（セグメント別の業績概況）と【沿革】の運営受託の記載に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年の国内映画市場は興行収入2,744億円と過去最高を記録し、当社グループの映画館は６館16スクリーンです。一方で当社グループの売上高の中心は不動産関連事業に移っており、映画の興行から出発した会社が、飲食と不動産を含む複合事業の会社となっています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境とセグメント情報の外部顧客への売上高、MD&Aの経営成績等の分析に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
