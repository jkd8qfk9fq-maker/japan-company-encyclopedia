  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-20",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ＦＣ店舗数に比例して得られる店舗管理収入によるストックビジネスで、安定した経営基盤を築くことを基本方針としています。中長期の戦略として、ＦＣ店舗を加速度的に増やすことに加え、広告収入や洗剤の自社製造をはじめとするセルフランドリー周辺事業ならに関連事業へ進出し、新規事業とストックビジネスを合わせて展開して事業規模の拡大を図る方針です。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期は、コンテナ事業でホテルの販売があり売上高が大きく伸びました。セルフランドリー事業では新規出店が7店舗にとどまった一方、既存店の機器増設やリニューアルは20店舗と堅調で、アプリの累計ダウンロード数は115万に達しています。",
        "basis": "経営成績の分析における部門別の出店・リニューアル実績、アプリのダウンロード数とコンテナ事業の売上高の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ＦＣ店舗と直営店舗のすべてを自社で管理運営する全店舗一括管理運営方式を取り、ＦＣオーナーが日常の店舗管理の業務から解放される仕組みにしています。管理カメラと遠隔コントロールによる即時サポートや毎日の点検・清掃により、無人店舗でも清潔で安全な店舗を保ちます。",
        "basis": "事業の内容における店舗運営部門のサービス内容（コールセンター、管理カメラと遠隔コントロール、毎日の点検・清掃等）の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月31日現在の店舗数は571店舗で、ＦＣ店舗が499店舗、直営店舗が72店舗です。九州を中心に全国へ店舗網を広げ、2025年12月には中国・青島に海外第1号店を出店しました。",
        "basis": "経営成績の分析に掲載されたセルフランドリー店舗数の推移表と、沿革の海外第1号店の記載に基づきます。",
        "asOf": "2026-03-30",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
