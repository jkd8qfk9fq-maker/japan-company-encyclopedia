  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年度から2027年度までの3ヶ年の中期経営計画「Integrity（誠実） & Initiative（主導権）」を遂行中です。基本方針を「価値創造企業へ　挑戦と進化」とし、「事業基盤の強化」、「人材基盤の強化」、「業務の再構築」、「企業価値の向上」に取り組んでいます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の柱は建設事業で、全体の約半分を占めています。2026年3月期は建設事業が工事の進捗等の影響で減収となった一方、機器のメンテナンス事業と機器販売及び情報システム事業は増収となり、事業の組み合わせが売上の変動を緩和しています。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメントごとの経営成績の説明に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "設備の企画から施工、保守メンテナンス、受託管理までをグループでワンストップに提供できる体制を整えており、提供する設備機器や装置とシステムとの融合により、顧客の製造工程や保守メンテナンス業務の合理化・効率化を可能としています。",
        "basis": "経営方針、経営環境及び対処すべき課題等におけるワンストップでサービスを提供できる体制と設備機器・装置とシステムの融合に関する説明に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "群馬県高崎市に本社を置き、国内の建設業界で設備工事を主力としています。売上高は本邦の外部顧客向けが連結売上高の90％を超えており、国内市場が中心です。",
        "basis": "セグメント情報の関連情報（地域ごとの情報）における、本邦の外部顧客への売上高が連結売上高の90％を超える旨の記載と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における業界環境の説明に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
