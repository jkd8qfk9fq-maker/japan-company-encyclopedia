  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョン「VISION 2030」の実現に向け、2025年5月に中期経営計画（2025～2030年度）を策定しました。2025～2027年度を成長への基盤強化、2028～2030年度を本格的な成長軌道へとする2つのフェーズで、スペシャリティ製品の拡大、エッセンシャル製品の強化、事業ポートフォリオの最適化、ＥＳＧ経営による事業基盤強化に取り組みます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ガラスと化学の両方の素材技術を持ち、半導体プロセス用高純度ガスやリチウムイオン電池用電解液、医療化学品、建築用ガラスや自動車用ガラス、ガラス繊維まで幅広い製品を手がけています。",
        "basis": "【事業の内容】の4部門の製品構成によります。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子材料事業はＡＩ向け半導体の需要増加を背景に売上高が前期比8.1%増加しました。一方、エネルギー材料事業は競争激化により売上高が前期比19.5%減少しました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】のセグメント別の状況によります。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    }
