  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期の経営方針として「既存顧客との取引拡大」「ビジネスモデルの変革」「自社ＩＰ製品×グローバルビジネスの推進」を成長戦略の柱に掲げています。ビジネスモデルの変革ではコンサルティング業務の強化、クラウドビジネスの強化、ソリューションビジネスの推進に注力し、子会社の株式会社SRA OSSは2024年に株式会社ＮＴＴデータグループと資本業務提携を行い、オープンソースソフトウェアのサポートサービスの拡大を目指しています。生成ＡＩの活用も成長の原動力として取り込む方針です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "成長の軸は、既存顧客との取引拡大を土台に、コンサルティングとクラウド、自社ＩＰ製品と海外展開へ事業の重心を移すことです。オープンソースのサポートを軸にした提携と生成ＡＩの活用で、従来型の受託開発からの変革を進める構えです。",
        "basis": "MD&Aの2026年3月期経営方針と成長戦略の記載、セグメント情報の3事業の外部売上構成、株式会社SRA OSSと株式会社ＮＴＴデータグループの資本業務提携の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "オープンソースソフトウェアの技術サポートを長年手がけてきた蓄積と、2022年に当社へ移管した先端技術研究所（ＫＴＬ）を核とする技術体制が強みです。Oracle Cloud ERPの自社導入で得た知見を導入支援サービスに活かすなど、自社実践に基づくコンサルティングも行っています。",
        "basis": "事業の内容の開発事業におけるオープンソースビジネスの記載、MD&Aのビジネスモデル変革の取組み（ＫＴＬの再編、Oracle Cloud ERP導入支援サービス）の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "独立系の情報サービスグループとして、金融業の顧客基盤を軸に事業を展開しています。2026年3月期は開発事業で金融業向けの業務が伸長し、販売事業でも株式会社ＡＩＴの金融業向け大口案件が寄与しました。売上高53,279百万円のうち開発事業が約半分を占め、特定顧客への依存はありません。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の主要な顧客ごとの情報（10％以上の相手先なし）、MD&Aのセグメント別の経営成績の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
