  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年6月17日開催の取締役会において、連結子会社である大英エレクトロニクス株式会社の全株式を竹田iPホールディングス株式会社に譲渡することを決議し、同日付で株式譲渡契約を締結しました（重要な後発事象に記載）。株式譲渡の実行日は2026年7月13日の予定であり、譲渡に伴い大英エレクトロニクス株式会社は連結子会社から外れることとなります。登録は2026年3月31日現在の体制（連結子会社6社、プリント基板事業を含む2つの報告セグメント）で行っています。",
      "businessModel: 連結子会社のムトーシンガポールPTE LTDは、2025年3月13日開催の取締役会において解散及び清算を決議し、清算手続き中であります（関係会社の状況に記載）。登録は2026年3月31日現在の体制（連結子会社として計上）で行っています。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様第一」を基本に、より精密で高機能のプラスチック部品を供給することにより社会に貢献できる企業を目指しています。重要課題として、一貫生産体制による業務の効率化、生産・調達の国際化、国内生産体制の強化、環境保全への取組、自然災害・ウイルス感染等への取組の5点を掲げています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2024年10月に精密プレス部品事業のタチバナ精機を譲渡し、2026年6月にはプリント基板事業の大英エレクトロニクスの全株式譲渡を決議するなど、主要なプラスチック成形事業へ経営資源を集中させる動きが続いています。",
        "basis": "セグメント情報の報告セグメントの変更等に関する事項、【重要な契約等】と重要な後発事象の子会社株式の譲渡の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金型設計・製造から組立ライン設計・治具工具製作・試作・検査・成形・組立・二次加工までをグループ内で担う一貫生産体制を持ち、設計期間の短縮や最適なコスト技術の提案につなげています。金型製造は1985年に内製化しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の重要課題（一貫生産体制による業務の効率化）、【沿革】の1985年の吸収合併の記載",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の地域ごとの売上高は、日本8,773百万円に対し、タイ7,387百万円、ベトナム7,372百万円、中国3,241百万円と、海外向けが中心です。主要な顧客もタイとベトナムの現地法人が上位を占め、アジアの生産拠点から現地の顧客へ供給する体制が読み取れます。",
        "basis": "セグメント情報の【関連情報】地域ごとの情報（売上高）と主要な顧客ごとの情報、【関係会社の状況】の海外子会社の記載",
        "asOf": "2026-06-23",
