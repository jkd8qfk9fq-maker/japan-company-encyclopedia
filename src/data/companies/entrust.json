  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "保証スキームでサービスと流通の活性化を実現するため、社会の様々な機会において、保証に基づく安心を社会インフラとして普及させていく方針です。2024年5月に策定した中期経営計画では、「売上の成長」と「成長を育成する投資」を事業展開の基本方針としています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "家賃債務保証を起点に、医療・介護・養育費といった他の分野へ保証商品を広げ、あわせて保証関連業務の受託サービスを新たな収益の柱として育てる方向性が示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等と経営成績等の分析に記載された、分野別の拡販方針とソリューション事業の位置づけに基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "家賃債務保証商品には画一的なパッケージはなく、提携する不動産管理会社ごとに保証の範囲や業務フローをカスタマイズし、それぞれのオリジナル保証商品として提案しています。督促・回収では弁護士の指導のもと不動産管理会社と業務フローを共有し、コールセンターでは電話内容の録音などで管理しています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "審査から督促・回収までを自社の仕組みで担い、不動産管理会社の業務負担を減らす一体のサービスとして提供している点が、保証の引受けだけを行う形と異なる特徴です。",
        "basis": "事業の内容に記載された審査システム、コールセンター体制、求償債権の回収への取り組みに基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
