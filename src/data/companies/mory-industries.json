  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「ステンレスで創るきらきらの未来」をテーマに長期ビジョンを掲げ、2024年度から2026年度までを対象とした中期経営計画「MORY－PLAN26」を進めています。基本方針として、主力のステンレス管の高付加価値製品の開発・拡販と製造原価の低減、生産設備のリニューアルと計画中の新工場の建設による工場の集約、インドネシアでの競争優位の確保、新規事業領域への進出、高度人材の育成と組織体制の強化に取り組みます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "得意とする配管の小径管については、最新の製造設備の導入により品質及びコスト競争力の向上に努めています。また、グループ内で使用する造管機等の専用設備の大半を自社で設計製作しており、それらの修理や調整、老朽化への対応を自社内で実施することで、設備の長期使用を可能とする強みがあります。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上は日本セグメントが中心で、2026年3月期の外部顧客への売上高は日本41,483百万円に対しインドネシア1,804百万円です。製品別ではステンレス管が最も大きく、日本とインドネシアを合わせた売上高は26,325百万円です。属するステンレス業界は、建設業界における人手不足を背景とした需要の低迷や、安価な輸入材の流入による市況悪化の影響を受けています。",
        "basis": "セグメント情報の外部顧客への売上高と製品別の売上高、MD&Aの経営成績の状況の概要（ステンレス業界の事業環境とセグメントの状況）",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
