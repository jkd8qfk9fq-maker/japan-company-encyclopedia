  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是「わが社は誠実と創造をもって事にあたり 建設を通じ社会に貢献します」と経営理念「わが社は挑戦する企業体質のもと 人間と環境を大切にし 感動的価値の創造をめざします」を掲げます。2026年12月期を起点とする長期ビジョン「FUKUDA VISION 2035」と、その第1フェーズの5ヶ年計画「中期経営計画2030」を推進し、スローガン「誇る、繋ぐ、挑む。そして、未来を創る。」の実現を目指します。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1902年の創業から続く総合建設会社で、新潟市に本社を置き、東京・名古屋・大阪・仙台・福岡・札幌に支店を持ちます。子会社25社と関連会社4社で建設事業と不動産事業を展開し、福田道路をはじめとする子会社が施工に協力します。",
        "basis": "【事業の内容】と【主要な設備の状況】と【沿革】の記載に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
