  "relatedCompanies": [
    {
      "companyId": "duskin",
      "relationship": "business-partner",
      "description": "株式会社ダスキンとは資本業務提携等の関係にあります。2018年8月に資本業務提携契約を締結し、同社は当社の発行済株式（自己株式を除く。）の27.88％を保有する主要株主です。当社は同社とのフランチャイズ契約に基づき、同社が開発した商品の借受け・買取りを行ってレンタル・販売を行っており、レンタル事業の中核をなしています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【重要な契約等】"
    },
    {
      "companyId": "yamada-holdings",
      "relationship": "major-shareholder",
      "description": "株式会社ヤマダホールディングスは、当社の発行済株式（自己株式を除く。）の10.63％を保有する主要株主です。同社の子会社の株式会社ヤマダホームズは、当社グループと事務所の賃貸借等の取引関係にあります。",
      "sourceIds": [
        "yuho-2026"
      ],
