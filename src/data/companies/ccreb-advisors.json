  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年10月に中期経営計画FY2026-FY2028「A Tech-Driven Platform Strategy」を策定し、不動産テックを起点としたCREソリューションの高い質と成長性を通じて、CREプラットフォーマーとしての地位確立を目指すとしています。CREソリューションビジネスでは戦略的アライアンスや各サービスの強化、CRE×M&Aを掲げ、不動産テックビジネスではシステムの機能強化と利用拡大を推進するとしています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年8月期は、4月に有効活用不動産のマスターリース事業の立ち上げを決定し、5月に地主株式会社と業務提携契約を、6月に北海道アセットマネジメント株式会社とビジネスマッチング契約を締結するなど、パートナー企業とのアライアンスを通じた事業拡大を進めました。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独自のAIエンジンが有価証券報告書や中期経営計画書などの開示情報を解析し、企業の不動産ニーズをスコアリングする仕組みを持ち、「CCReB AI」と「CCReB GATEWAY」の仕組みについては特許を取得しています。マッチングシステム「CCReB CREMa」は2025年8月期末時点でユーザー数502件、情報登録数6,867件まで広がっています。",
        "basis": "事業の内容と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "民間法人が保有する企業不動産のストックは約524兆円とされ、そのうち当社が注力するコンパクトサイズの企業不動産は約60兆円規模と当社は集計しています。情報の流通量が少なく非対称性が高い市場の中で、大手の不動産会社や中堅・中小の不動産会社が金額規模などの問題で積極的に取り扱わないコンパクトサイズの物件に絞って事業を展開しています。",
        "basis": "事業の内容と経営方針、経営環境及び対処すべき課題等による。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
