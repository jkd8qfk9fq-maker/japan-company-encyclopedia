  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「未来を『つなぐ』技術で世界中の人と想いを『つなぐ』」を掲げ、中期経営計画「ビジョン24」のもと、グローバル最適生産体制の再構築、収益構造の転換、新規事業の育成、DXの推進、人材戦略の強化、サステナビリティ経営の推進を重点課題として取り組んでいます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "金属材料を常温で金型とプレスで成形する冷間鍛造をコア技術としており、生産速度が速く、材料のムダが少なく、製品の強度と品質が安定するという特長を持つ製造体制を築いています。",
        "basis": "【事業の内容】に、冷間鍛造をコア技術とすることと、冷間鍛造の特長として生産速度が速いこと、材料のムダが少ないこと、製品強度を高め品質が安定することが印字されています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
