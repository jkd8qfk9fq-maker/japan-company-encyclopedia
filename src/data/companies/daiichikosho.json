  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是「もっと音楽を世に もっとサービスを世に」のもと、「カラオケを通じた音楽文化の振興」と「楽しいコミュニケーションの場の提供」を基本方針としています。高い市場占有率を持つ業務用カラオケ事業とカラオケ・飲食店舗事業に経営資源を投入し、「DAM」と「ビッグエコー」のブランド価値を高めるほか、成長事業であるパーキング事業の規模拡大と収益力向上を図ります。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "カラオケ・飲食店舗事業と業務用カラオケ事業が売上高の中心で、2事業で2026年3月期の売上高の8割以上を占めます。音楽ソフト事業は売上高が前期比1.7％減と縮小し、パーキング事業などを含む「その他」は前期比13.9％増と伸びています。",
        "basis": "セグメント情報の外部顧客への売上高（2026年3月期）に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
