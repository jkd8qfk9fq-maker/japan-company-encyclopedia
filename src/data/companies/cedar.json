  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2026年４月１日付で、株式会社ダブルエイチオーの発行済株式の全てを取得し、子会社化した旨が重要な後発事象に印字されています。同社は名古屋市内において介護付有料老人ホーム２施設および訪問看護事業を運営する介護事業者です。本登録は2026年３月31日現在の体制に基づきます。"
    ]
  },
  "updatedAt": "2026-11-15",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "リハビリテーションを中心としたサービスの提供に取り組み、事業規模の拡大を図るとしています。デイサービス事業では介護予防に対応したサービスで新規顧客の獲得を進め、施設サービス事業では関東を中心とした地域や政令指定都市などの介護保険事業計画に基づく公募に応募して施設展開を進める考えです。各地の施設を核としたドミナントエリアの拡大やM&Aの実施、介護保険外のサービス事業の開発による多角化も掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "施設サービス事業が外部顧客への売上高の大半を占め、デイサービス事業がこれに次ぐ構成です。子会社の株式会社パインも施設サービス事業を担い、味屋フーズ株式会社が給食事業を担う体制で、施設運営を中心に周辺サービスまでをグループで手がけています。",
        "basis": "セグメント情報の外部顧客への売上高、【関係会社の状況】の子会社の事業内容、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "理学療法士や作業療法士などの専門家によるリハビリテーションを中心としたサービスを事業の大きなテーマに掲げ、デイサービスと在宅サービスの双方でリハビリを前面に出しています。介護人材の確保では外国人介護人材の採用と育成にも取り組み、初任者研修の受講支援や日本語教育を続け、外国人職員が介護福祉士の国家試験に合格する実績も出ています。",
        "basis": "【事業の内容】のリハビリテーションに関する記載と、【経営方針、経営環境及び対処すべき課題等】の人材の確保に関する記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "顧客はすべて一般の個人利用者で、特定の主要な顧客は存在しません。超高齢化社会への移行に伴い介護サービスの利用者数は増加し、需要は更に高まっている一方、介護人材の確保は業界全体の課題になっています。同社は北海道から九州まで7つの地区に介護拠点を展開しています。",
        "basis": "セグメント情報の【関連情報】（主要な顧客ごとの情報）、MD&Aの経営環境の記載、【主要な設備の状況】の地区別拠点に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
