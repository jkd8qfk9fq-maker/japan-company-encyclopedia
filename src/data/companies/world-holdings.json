  "history": [
    {
      "year": 1993,
      "title": "株式会社ワールドインテックを設立",
      "description": "北九州市小倉北区に、各種業務の請負業（アウトソーシング）を事業目的として株式会社ワールドインテック（現・株式会社ワールドホールディングス）を設立しました。創業者の伊井田栄吉は、製造業の空洞化が進む中で、「ものづくり」を通じた人材育成と雇用の創出を目指しました。",
      "significance": "グループの起源で、製造分野の人材ビジネスが祖業です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "ジャスダック証券取引所に上場",
      "description": "ジャスダック証券取引所に株式を上場しました。",
      "significance": "上場企業としての展開が始まった転機です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2005,
      "title": "情報通信事業へ進出",
      "description": "株式会社イーサポートと株式会社ネットワークソリューションがグループに入り、携帯電話の販売代理店などの情報通信事業へ進出しました。",
      "significance": "人材ビジネス以外の事業への多角化の始まりです。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2010,
