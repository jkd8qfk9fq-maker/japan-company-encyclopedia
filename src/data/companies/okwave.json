  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスとして「社会のウェルビーイング向上のため、世界中の「ありがとう」の物語を蓄積し、可視化する」を掲げ、「問い」から始まり「ありがとう」が生まれるコミュニケーションの習慣化を目指しています。中長期的には「OKWAVE」の登録ユーザーの拡大、「OKWAVE Plus」の法人顧客の拡大、「GRATICA」の法人顧客基盤の強化に取り組み、互助の社会への構造変化を促す方針です。あわせて、収益構造の改善、M&Aによる収益構造の改善、財務基盤の安定化を進め、早期の黒字化を目指しています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "長年運営してきたQ&Aコミュニティの利用者基盤と、交わされた「ありがとう」の蓄積を土台に、個人向けのコミュニティと法人向けのソリューションの双方を提供できる点が強みです。",
        "basis": "【事業の内容】に、Q&A形式のコミュニティ「OKWAVE」の運営を中核に、法人向けに「OKWAVE Plus」と「GRATICA」を提供すると印字されていること。あわせて【経営方針、経営環境及び対処すべき課題等】に、「ありがとう」の可視化により組織やコミュニティ内の関係性向上と労働生産性を高めるソリューションを提供すると印字されていること",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "生成AIの普及が進む環境で、同社は「確度の高い正解を提供する」領域では自社データで学習したAIを活用し、「正解のない」領域に注力する方針を示しています。企業内では心理的安全性やエンゲージメント向上への関心が高まり、互助の必要性が叫ばれる環境にあると捉えています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】に、生成AIの台頭への対応方針と、組織内の心理的安全性やエンゲージメントへの関心の高まりなどの経営環境が印字されていること",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
