  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当社は、パーパス「食でつなぐ。人を満たす。」のもと、2027年3月期から2029年3月期までの「中期経営計画2028」を策定し、ビジョンに「“真の”飲食店のサポーター」を掲げています。全社方針は『提供価値の変革』と『飲食店ネットワークの拡大』で、メディア・会員サービスの強化、エージェント事業の確立、加盟価値の拡充、営業体制の強化・活動プロセスの改善、AI時代に即したデータ基盤の構築・活用の5つを戦略として掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約8割を飲食店販促サービスが占めており、楽天グループとの資本業務提携のもとで運営する『楽天ぐるなび』を軸に、加盟料や予約手数料などの継続的な収入を積み上げる構造になっています。プロモーションと関連事業は合わせて売上高の約2割です。",
        "basis": "セグメント情報等の【関連情報】における外部顧客への売上高と、【関係会社の状況】及び【重要な契約等】における楽天グループとの資本業務提携の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2026年3月末時点で、ストック型の有料加盟店舗数は33,881店舗、ネット予約に対応する店舗数は3.6万店舗あり、飲食店のネットワークの大きさが事業の基盤になっています。楽天IDとの連携による送客に加え、専任のサポート担当者が飲食店ごとに付く体制で、加盟店との関係を継続しています。",
        "basis": "経営成績等の状況の分析・検討内容における、2026年3月末時点のストック型有料加盟店舗数とネット予約対応店舗数の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "飲食店情報サイトは1996年に開設されたもので、飲食店の集客を支援する老舗のサービスです。会社自身は、食領域でも多様なプレイヤーが台頭して競争が激しくなっていると認識し、集客メディアから飲食店の経営そのものを支える存在への転換を掲げています。",
        "basis": "【沿革】における飲食店情報サイトの開設年と、【経営方針、経営環境及び対処すべき課題等】における経営環境の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
