  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「DESIGNING WELLNESS LIFE」というパーパスのもと、「人生から不安をなくし、生きるをサポートする。」企業グループとして、「からだ」の不安をなくすウェルネス事業と「おかね」の不安をなくすファイナンシャル事業を展開し、“Wellness Life”が溢れる社会の実現を目指す方針です。対処すべき課題としては、全国の接骨院との取引シェアの拡大を掲げ、新規開拓活動を続けて取引実績の拡大に取り組むとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "接骨院の経営課題に対して、システム、機材、コンサルティング、請求代行、健康関連製品という複数の手段を一つのグループでそろえ、開業後の運営から資金繰りや集客までをまとめて支援できることが特徴です。",
        "basis": "事業の内容に、接骨院の経営・運営における問題として売上の減少、資金難、経営戦略不足、教育制度の未整備等が挙げられ、それに対応する五つのサービス区分（ソフトウェア、機材・消耗品、コンサルティング、請求代行、健康サポート）が印字されていること",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "当社グループと取引実績のある接骨院数は、2026年3月末で5,550院です。全国の接骨院数50,924院に対する取引実績率は約11％です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    }
  },
