  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年までの中期経営ビジョン『物語ビジョン2030』と『中期3カ年経営計画2026～2028』を策定し、『業態開発型リーディングカンパニー実現に向けた全方位成長戦略』を掲げています。重点テーマは『選ばれるブランドづくり』『成長を加速させる新業態・新事業開発』『海外事業の拡大』の3つです。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "成長を支える『人財力』を競争優位性かつ差別化の源泉と捉え、人財の育成と活躍を後押しする取り組みを通じて、持続的な企業価値の向上を目指すとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "新しい業態を自社で開発して出店するサイクルを続けており、2021年以降も『焼きたてのかるび』『果実屋珈琲』『熟成肉とんかつ ロース堂』『町中華 丸福飯店』『肉讃岐 もっちりうどん源次郎』と、新ブランドの1号店を毎年のように開いています。",
        "basis": "【沿革】の新ブランド1号店の開店年と【事業の内容】のブランド一覧",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
