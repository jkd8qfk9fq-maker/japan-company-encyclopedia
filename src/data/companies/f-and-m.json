  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "事業者のバックオフィス業務の効率化と改善を使命とし、日本の事業者の大半を占める個人事業主や中堅・中小企業への支援に注力しています。地域金融機関や税理士、社会保険労務士といった既存の販売チャネルをさらに深耕し、新たな販売チャネルの開拓も進めるほか、AI技術を導入したサービス基盤の構築や、人事労務クラウドソフト「オフィスステーション」シリーズの拡販に取り組む方針です。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "会員制のサービスを積み上げる形の事業が中心で、会計サービスの会員数は113,502件、エフアンドエムクラブの会員数は14,817社と、いずれも前期末から増えており、会員数の増加が売上高の伸びにつながっています。",
        "basis": "セグメント注記の外部顧客への売上高と、MD&Aの経営成績の概要における各サービスの会員数の開示に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "エフアンドエムクラブでは地域金融機関234行庫と業務提携し、金融機関の取引先である中小企業へサービスを届ける販売経路を持っています。会計サービスでは生命保険会社の研修への参加を通じて個人事業主と接点を持つなど、既存の組織を通じた営業機会の確保が仕組みになっています。",
        "basis": "MD&Aの経営成績の概要における、エフアンドエムクラブの提携金融機関数とアカウンティングサービス事業の営業機会の確保に関する開示に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "個人事業主向けの記帳代行から中堅・中小企業向けの管理部門支援、士業事務所向けの支援まで、事業者のバックオフィス業務を幅広く担うサービスをそろえ、顧客の規模の変化に応じて複数のサービスを提供できる構成になっています。",
        "basis": "セグメント注記の外部顧客への売上高と、【事業の内容】における各事業の対象顧客の開示に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
