  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「世界を変える、新しい流れを。」のもと、“Specialty” Marketplaceである「BUYMA」と「BUYMA TRAVEL」を中心に、消費者が求める『真の価値』を強固な信頼基盤のもとで提供することにより、持続的な成長基盤の強化に努めています。あわせて、新規事業の創出やM&Aによる中長期的な新しい収益の創出を進めています。",
        "asOf": "2026-04-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "世界185ヵ国に在住する24万人超のパーソナルショッパーが、注文を受けてから買い付けを行うため在庫リスクを持たずに出品でき、店舗や中間業者を介さない品揃えと価格を実現していることが土台になっています。2026年1月現在の会員数は約1,201万人です。",
        "basis": "【事業の内容】にパーソナルショッパーの国数・人数、出品の仕組みと会員数が印字されていること",
        "asOf": "2026-04-27",
