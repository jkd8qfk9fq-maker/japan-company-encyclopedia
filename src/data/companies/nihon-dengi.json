  "history": [
    {
      "year": 1959,
      "title": "日本電技を設立",
      "description": "空調計装工事の設計施工及び自動制御機器の販売を目的として、東京都千代田区丸の内に日本電技株式会社を設立しました。",
      "significance": "現在の空調計装関連事業の起点です。",
