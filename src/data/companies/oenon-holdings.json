  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループ企業理念として「自然の恵みを活かし、バイオ技術をベースに、人々に食の楽しさと健やかなくらしを提供します」を掲げ、発酵技術を核とするバイオテクノロジーをベースに事業を展開するとしています。長期ビジョン「NEXT100」では、中核事業の競争力の強化、新領域への挑戦、ESG経営の推進を3つの重要課題とし、2024年から2028年までの5年間を対象とする「中期経営計画2028」を進めています。計画3年目の2026年12月期は、総合焼酎メーカーとしての存在感の強化や、酒類輸出の販路拡大と規模の拡大などに取り組むとしています。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1900年に始めた民間初のアルコール製造以来、発酵技術を核として酒類と酵素医薬品の両事業を展開してきた点が特徴です。酒類では焼酎から清酒、洋酒、原料用アルコールまで幅広い品目を自社工場で製造し、酵素医薬品事業でも同じ発酵技術を診断薬や発酵受託に活かしています。",
        "basis": "【沿革】の創業と酒造の歴史、【事業の内容】の事業構成、【経営方針、経営環境及び対処すべき課題等】の基本方針の記載に基づく。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高では酒類が81,570百万円と全体の9割以上を占め、酵素医薬品が4,644百万円、不動産が1,322百万円と続きます。主要な顧客ごとの情報では、イオントップバリュ株式会社への売上高が11,393百万円（13.0％）、伊藤忠食品株式会社への売上高が9,168百万円（10.5％）と開示されています。本邦の外部顧客への売上高が連結売上高の90％を超えるため、地域ごとの売上高は開示されていません。",
        "basis": "セグメント情報における事業別の外部顧客への売上高、関連情報における主要な顧客ごとの情報と地域ごとの情報の記載に基づく。",
        "asOf": "2026-03-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
