  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年度からの中期経営計画「未来を拓く、新たな一歩」に基づき、事業別戦略、開発戦略、環境・デジタル戦略、経営基盤の強化、資本効率経営の推進の5つの重要戦略に取り組み、持続可能な100年企業を目指します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上の大部分を占める建設事業では、防災・減災や国土強靭化に関わる構造技術の提案と、建築分野での複合提案を進め、ベトナムの現地法人の施工基盤の強化を掲げています。コンサルティング事業では、グループでプロジェクトと戦略を共有し、構造設計への提案力を高めるとしています。",
        "basis": "セグメント情報の外部顧客への売上高、【事業の内容】、【経営方針、経営環境及び対処すべき課題等】、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "中掘り工法、TN-X工法、ATTコラム工法、ガンテツパイル工法、CP-X工法などの杭工法と、テノコラム工法、テノキューブ工法、ピュアパイル工法などの地盤改良工法を自社で開発し、特許や国土交通大臣認定、技術審査証明などの公的な裏付けを持つことが特徴です。施工管理装置の全工法への展開など、施工品質を高める開発も続けています。",
        "basis": "【沿革】【研究開発活動】、【経営方針、経営環境及び対処すべき課題等】に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "基礎工事に特化した専門工事会社で、売上高の大部分が国内向けです。主要な顧客の大成建設株式会社向けの売上高が連結売上高の13.7％を占めます。海外ではベトナムに現地法人を持ち、現地でテノコラム工法の技術認証を取得しています。",
        "basis": "セグメント関連情報の主要な顧客ごとの情報と地域ごとの情報、【事業の内容】、MD&Aの経営成績等の状況の概要に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
