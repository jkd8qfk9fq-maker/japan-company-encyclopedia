  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「世界中の人々のために、不可能を可能に。」の実現に向け、経営戦略として、人材の採用・育成、研究開発への継続的な投資、イノベーションを生み出す企業カルチャーの醸成に注力するとしています。対処すべき課題としては、ストック型ビジネスモデル事業の強化・拡大による強い収益基盤の確立を掲げ、生成AIによる事業強化やAPIソリューション事業の拡大にも取り組むとしています。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社で開発するソフトウェア「LifeKeeper」とクラウドサービス「Gluegentシリーズ」を持ち、繰り返し収益が見込めるストック型の製品を持っている点が読み取れます。加えて、Red Hat, Inc.関連商品の販売とテクニカルサポート、オープンソースソフトウェアに関する相談対応や受託開発までをグループで一貫して提供しており、製品の販売だけでなく導入後の支援も担う形になっています。",
        "basis": "事業の内容（3事業の製品・サービスの内容）とセグメント情報（報告セグメントごとの外部顧客への売上高）に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心はソフトウェアセールス＆ソリューション事業で、2025年12月期の外部顧客への売上高9,860百万円と全体の約半分を占めます。主要な顧客ごとの情報では、株式会社大塚商会が売上高の28.5％、株式会社ネットワールドが12.0％を占める販売先として開示されています。プロダクト＆サービス事業は金融機関向け経営支援システム販売事業の譲渡による構造改革の影響で減収となっています。",
        "basis": "セグメント情報（報告セグメントごとの外部顧客への売上高、関連情報の主要な顧客ごとの情報）と経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（セグメント別の業績の概要）に基づきます。",
        "asOf": "2026-03-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
