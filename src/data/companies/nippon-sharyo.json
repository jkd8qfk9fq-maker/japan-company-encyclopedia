  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「日車変革2030」では、2030年までになりたい姿として長期ビジョン「現場に安全と信頼をスマートに提供し、お客様の課題を解決するビジネスパートナーになる」を掲げ、重点事項として「収益力の徹底強化」「成長のための事業基盤改革」「ビジネスモデル変革の実現」の3本柱を推進しています。企業理念として、「インフラストラクチャー創造企業」としてものづくりに誇りを持ち、お客様のニーズに応え、社会基盤の発展に貢献することを掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "鉄道車両事業では、新幹線電車をはじめ特急型車両、通勤型車両、事業用車両など幅広い車種に対応できることを強みとし、デジタル技術の活用によって車両品質の向上に努め、車両の省メンテナンス技術や状態監視、空力性能の向上などの技術開発を推進しています。鉄構事業では、東海道新幹線の大規模改修工事における橋梁補修の工事実績を通じて蓄積したノウハウを活かして、道路橋の補修・保全工事の受注に取り組んでいます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の事業別売上高では鉄道車両事業が48,556百万円と全体の約半分を占め、地域別の売上高は日本が98,593百万円と大半を占めています。最大の顧客は親会社の東海旅客鉄道で、同社向けの売上高は30,160百万円（全体の30.2％）でした。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報（地域ごとの情報・主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
