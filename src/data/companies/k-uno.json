  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本戦略として、既存価値の適切な訴求と価格適正化を目的とした「オーダーメイド戦略」と、IP（知的財産）価値の最大化と販路の拡大を目的とした「IP戦略」の2つを両輪に据えています。オーダーメイド戦略では、パーソナライズ性・ブランド体験の一貫性・顧客向けサービスの3つの体験価値を重視したブランディングで販売単価の引き上げと認知向上を図り、IP戦略ではアニメ・ゲーム以外のIP展開や国内外の販路拡大を進めるとしています。これらを、AI活用と日タイの難易度別グローバル分業による基盤強化が支えるとしています。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "アドバイザー・デザイナー・職人を自社で抱え、デザインから製造・販売までを一貫して行う製販一貫体制により、オーダーメイドでありながら既製品とほぼ変わらない価格帯での提供を続けてきました。店舗や工場に60名以上のデザイナーと150名以上の職人を擁し、年間に約4万種類のデザインを生み出すことや、ダイヤモンド原石のカット・研磨まで自社で行い独自のカット技術で特許を取得していることが、他社には模倣しにくい強みになっています。",
        "basis": "事業の内容における製販一貫体制とデザイナー・職人の人数、経営方針におけるオーダーメイド戦略の記述に基づく。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "宝飾品市場全体の規模は2024年に前年比108.1％の1兆1,306億円と3年連続で1兆円を超え、ブライダルジュエリー市場は前年比111.8％の2,217億円と全体を上回る伸びを示しました。同社はオーダーメイドのブライダルジュエリーを入口に、ファッションジュエリーやリフォームへ広げる形でこの市場に位置しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における市場環境の記述と、事業の内容における生涯顧客像の記述に基づく。",
        "asOf": "2025-12-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
