        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "衣料品では、高価格帯の「TORNADO MART」「HIGH STREET」、中価格帯の「METHOD」「流儀圧搾」、エスニックの「チチカカ」と、価格帯の異なるブランドを全国の店舗網で展開していることが特徴です。",
        "basis": "事業の内容及び経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の記載に基づく",
        "asOf": "2026-06-01",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内アパレル市場では物価上昇を背景に選別消費や低価格志向が根強く、調達コストの上昇も続いています。一方で系統用蓄電池は国の支援策を背景に市場が拡大し参入も相次いでおり、GPUサーバーは生成AIの普及で需要が拡大する一方、競争も激しくなっているとされています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営環境の記載に基づく",
