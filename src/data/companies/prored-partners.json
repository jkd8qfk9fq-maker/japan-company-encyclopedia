  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営方針としてコンサルティングサービスの事業拡大を掲げています。固定報酬型のサービスに有償契約前の「投資フェーズ」を設ける成功報酬型のモデルを確立して規模を拡大し、コンサルティングの品質向上、優秀な人材の採用と育成、大企業への営業力の強化に取り組むとしています。ファンド事業では、投資先企業へのハンズオン支援を続けてファンドのパフォーマンス向上を図るとしています。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年10月期は、ファンド事業の売上高がコンサルティング事業の約2倍となり、売上構成が前期から大きく変わりました。中期経営方針の中心であるコンサルティング事業も前期に比べ28.6％伸びていますが、当期の売上高の伸びは、ファンドが保有する株式の売却に大きく支えられています。",
        "basis": "セグメント情報における事業別の外部顧客への売上高と、経営成績の分析における事業別の売上高の推移の記載",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "成果報酬型コンサルティングでは、成果が出なければ報酬が発生しない仕組みを採り、需要の高いサービスを標準化したパターンオーダー型の提供により、コンサルタント個人の経験や技量に頼らないサービスを実現しているとしています。各業界と各コストの企業コスト実勢価格のデータをコンサルティングに活用し、プロジェクトごとに成果を測定して改善を続けていることも特徴として挙げています。",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "コンサルティング事業で培った経営支援の知見は、ファンド事業の投資先支援にも使われています。ファンド担当者が投資先企業の役員に就任するハンズオンの支援や、コンサルティングサービスとファンドの連携により、投資先企業の価値向上とファンドの成果の両方を狙う体制になっています。",
        "basis": "【事業の内容】における、ファンド担当者の投資先企業への役員就任によるハンズオン支援と、コンサルティング事業との連携の記載",
        "asOf": "2026-01-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
