  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年6月に開示した中期経営計画のグランドデザインとして、主要三事業の収益基盤の強化、宇宙ビジネスやAI開発環境構築等のNEXT事業の創出、M&Aや業務提携等の事業投資、サステナビリティ戦略、人財投資を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、文部科学省が進める「GIGAスクール構想」のもとでの大規模な高速無線ネットワークシステムの納入案件や、連結子会社の株式会社エアロパートナーズにおける防衛省向け航空機エンジンの大型修理案件が寄与し、売上高は前年同期比4.3％増となりました。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "日本、米国並びにアジアの技術的発展と各国の業界動向に着目した輸出入販売の体制を持ち、顧客からの受注後に個々の商品を発注する受注販売を原則としている点、千歳・恵庭営業所をフォトニクスビジネスの受託生産拠点として設計・受託開発まで担う点が特徴です。",
        "basis": "セグメント情報の外部顧客への売上高、事業の内容、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "AIやクラウドサービスの普及で通信データの送受信量が増え、光ファイバ関連の需要が伸びるなか、防衛省への販売が総販売実績の56.7％を占めており、防衛分野の需要動向が業績に与える影響が大きい位置にあります。",
        "basis": "セグメント情報の外部顧客への売上高、主要な顧客ごとの情報、MD&Aの相手先別の販売実績と経営成績の概要に依拠します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
