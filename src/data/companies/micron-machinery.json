  "updatedAt": "2026-11-20",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「世界最高峰の研削技術・技能を極める」「妥協のない品質と顧客満足を追求する」「一歩先行くものづくりで地球環境を守る」をビジョンに掲げ、競合他社との差別化を図り、お客様から信頼されるオンリーワン企業となることを目指しています。優先的に対処すべき課題として、医療機器分野や航空機分野等、自動車産業以外の分野も含めた技術・研究開発力の強化と、アメリカ、タイ、中国の三拠点の現地法人による海外市場への展開を掲げています。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "競合他社が着手しにくい難しい研削にも挑戦し続けることで技術面で優位に立ち、2005年には米国Caterpillar社から日本企業としては異例のグローバルサプライヤに選定され、2020年には経済産業省のグローバルニッチトップ企業に選定されています。",
        "basis": "経営方針に、競合他社が着手しにくい難しい研削にも挑戦し続けることで他社に対し技術面で優位に立ち、お客様に選んでいただけるトップメーカを目指してきたこと、2005年に米国Caterpillar社から日本企業としては異例のグローバルサプライヤに選定されたこと、2020年6月に経済産業省認定のグローバルニッチトップ企業に選定されたことが印字されているため。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "工作機械業界の中で、心なし研削盤を主力とするメーカーです。日本国内で培った研削技術を礎に、アメリカや中国をはじめ、世界28か国以上のお客様に製品を納入しています。",
        "basis": "経営方針に、当社グループは心なし研削盤及び内面研削盤とその周辺装置の製造・販売を主たる業務とすること、アメリカや中国をはじめ世界28か国以上のお客様に納入していることが印字されているため。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
