  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "オペレーティング・リースシステムを通じて環境保護と経済成長が両立する社会の形成に貢献することと、物の命を大切にする再生オペレーティング・リースシステムを推進し廃棄物の減量化と省資源化に取り組むことを基本方針とし、中長期的には運営の効率化による人手不足への対応や外注工事のリース商品化による収益の確保を図るとしています。優先課題として、リース用資産の在庫状況および納期、採算を一体で重視した受注活動、運営や業務の効率化による組織の構築、安全衛生管理や商品などの市場ニーズへの対応による得意先満足度の向上を掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期は、リース用資産の在庫状況および納期、採算を一体で重視した受注活動を行い、商品の品質向上および安全衛生管理の徹底を図りました。売上高は、官公庁需要案件の期中受注・期中完工の計画未達があった一方で、民間需要案件の売上高が伸び、前期比2.5％増となりました。",
        "basis": "セグメント情報等における関連情報（製品及びサービスごとの情報）、地域ごとの情報、主要な顧客ごとの情報と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "使用後の建物部材を回収・再利用する独自のオペレーティング・リース・システムによる循環型ビジネスモデルを確立しており、規格化されたリユース商品の活用は廃棄物削減と資源の有効活用に加えて工期の短縮にも寄与するとしています。全国に工場・配送センターを配置し、1拠点が罹災しても他の拠点がリース用資産を供給できる体制をとっています。",
        "basis": "サステナビリティに関する考え方及び取組（戦略）と事業等のリスク、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要なユーザーは建設および石油化学業界などの民間企業と官公庁で、これらの需要動向が量と単価の両面で受注状況に影響すると自ら位置づけています。本邦の外部顧客への売上高が全体の90％を超え、外部顧客への売上高の10％以上を占める相手先はありません。",
        "basis": "事業等のリスク（市場動向等に関するリスク）、セグメント情報等における関連情報（地域ごとの情報、主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
