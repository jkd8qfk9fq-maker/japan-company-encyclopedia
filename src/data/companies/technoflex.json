  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-21",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "3カ年の計画を毎期見直しながら、継手事業、防災・工事事業、自動車・ロボット事業、介護事業の4事業を、景気動向や市場変動の影響が相互に補い合う事業ポートフォリオとして展開するとしています。半導体、水素・原子力などのクリーンエネルギー、社会インフラ更新といった拡大する市場での成長を目指し、安全・安心をコンセプトとする周辺分野では積極的にM&Aを行う方針です。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期は海外市場の好調や真空機器の案件、防災・工事事業での半導体工場関連の工事が売上高を押し上げ、その他以外の全ての事業セグメントで増収となりました。地域別の売上高は日本が中心で、アジアと欧米向けも伸びています。",
        "basis": "セグメント情報の外部顧客への売上高、地域ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "配管工事で用いる多様な継手をワンストップで揃える製品ラインナップを持ち、消防設備や真空配管では設計からプレハブ加工、施工までをセットで請け負える体制があります。中国とベトナムに生産子会社を持ち、国内の工場とあわせて供給体制を築いています。",
        "basis": "事業の内容、関係会社の状況、主要な設備の状況に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "真空機器の市場は数年単位で大きく変動するものの、中長期的には成長を続けており、同社の主要市場の1つです。半導体工場向けの真空配管工事は半導体産業の成長とともに増加しており、防災・工事事業の成長市場と位置づけられています。",
        "basis": "事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
