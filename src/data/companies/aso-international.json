  "updatedAt": "2026-11-23",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「高品質」で「高付加価値」の『アソインターナショナルにしかできないこと』を追求し、製品の品質向上と需要増加に対応するため作業工程の機械化・デジタル化を積極的に導入・推進するとしています。中期経営計画2025-2028に基づき、アメリカの大学及び有力歯科医院の新規開拓の加速やオランダの歯科技工所との業務提携によるヨーロッパ市場進出の基盤づくり、海外製作拠点の人員拡充による製造能力の拡大を進めるとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "既存の取引歯科医療機関との関係深化で1医院あたりの受注を増やしながら、アメリカ本土とヨーロッパへの展開で海外の顧客基盤を広げる二つの方向で成長を図る構造が読み取れます。2026年6月期の売上高は4,166百万円でした。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】における経営戦略の記載と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における経営成績の記載に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "内製と外注のバランスを取る柔軟な製造体制を持ち、当社では特殊品など複雑で高付加価値の技工物に特化し、海外子会社や協力パートナーの歯科技工所では一般的な技工物を製作することで、受注状況に応じた調整と固定費の負担抑制が可能だとしています。創業以来蓄積した症例データと「歯を並べて動かす」ノウハウをデジタル技術と融合させ、100種類以上の矯正歯科技工物を提供できるとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "自社と海外子会社、独立した歯科技工士が設立した協力パートナーを使い分ける分業体制により、複雑な製品と一般的な製品の両方に対応しながら受注量の変動を吸収できる点が特徴です。歯科医師同士のネットワークでの紹介や大学附属病院での利用実績が長期的な取引関係につながる構造も読み取れます。",
        "basis": "【事業の内容】における事業の特徴の記載に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "審美・美容を目的とした歯科矯正治療へのニーズは拡大傾向にあり、マウスピース型矯正装置をはじめとしたアライナー型矯正装置の普及が加速しているとしています。一方で歯科技工士の高齢化や若年層の離れにより業界全体の従事者数は減少傾向にあり、技術の優れた歯科技工士を一定数確保することが顧客満足度を高める上で必要だとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "全国の歯科大学や大学の歯学部、大学附属病院と取引実績を持ち、2026年6月期に6,848箇所の歯科医療機関と取引するなど、矯正専門の歯科技工所として広い顧客基盤を持つ位置付けにあります。アメリカの大学歯学部の公式サプライヤーとして登録されるなど、海外でも供給先を広げています。",
        "basis": "【事業の内容】における顧客関係の記載と、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】における取引歯科医療機関数の記載に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
