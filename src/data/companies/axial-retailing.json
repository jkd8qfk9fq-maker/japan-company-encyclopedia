  "history": [
    {
      "year": 1907,
      "title": "長岡市で洋ローソクの製造販売を創業",
      "description": "1907年（明治40年）、新潟県長岡市で初代の原信吾が洋ローソクの製造販売業を始めました。その後は陶磁器の卸売・小売も手がけています。",
      "significance": "現在のスーパーマーケット事業の出発点となる創業です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "新潟県初のバラエティストアを開店",
      "description": "1963年（昭和38年）、食料品・日用品・雑貨・実用衣料を中心としたバラエティストアを長岡市に開店しました。新潟県では初めての業態の店でした。",
      "significance": "小売業としての店づくりが始まった節目です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1967,
      "title": "株式会社原信を設立し、食品スーパーを開店",
      "description": "1967年8月、有限会社原信商店を改組して株式会社原信を設立しました。食品スーパーマーケットの1号店を長岡市に開き、チェーンストア志向を明確にして市内各地に出店しました。",
      "significance": "現在の会社の法人としての設立で、スーパーマーケットのチェーン化が始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1979,
      "title": "共同仕入の組織に加入",
      "description": "1979年3月、シジシージャパン（共同集中仕入機構）に加入し、継続的商取引契約を結びました。",
      "significance": "複数のスーパーが共同で商品を仕入れる仕組みを使い、仕入れの規模を生かす体制につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1988,
      "title": "新潟証券取引所に株式を上場",
      "description": "1988年10月、新潟証券取引所に株式を上場しました。2000年3月に東京証券取引所市場第二部、2007年3月に同第一部へ上場しています。",
      "significance": "資金調達の場が広がり、のちの東京証券取引所への上場へと進みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "中之島物流センターを開設",
      "description": "1996年4月、物流の集中化とコスト削減のため、商品通過型の大規模物流センターである中之島物流センターを開設しました。2008年7月に上越物流センター、2016年9月に前橋物流センターが続いています。",
      "significance": "店舗への商品の流れを集約する、物流網づくりの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "純粋持株会社へ移行し、ナルスを完全子会社化",
      "description": "2006年4月、商号を原信ナルスホールディングス株式会社に変更し、会社分割で事業のすべてを新設の株式会社原信に引き継いで純粋持株会社になりました。同月、株式交換でナルスを完全子会社にしました。",
      "significance": "グループ全体を管理する持株会社と、店舗を運営する事業会社に役割が分かれました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "仕入・決済機能を集約する会社を設立",
      "description": "2008年4月、原信ナルスロジテックを設立し、スーパーマーケット事業の仕入と決済の機能を集約しました。同社は2013年10月に原信ナルスオペレーションサービスへ商号を変更しています。",
      "significance": "店舗を運営する各社の仕入などを一か所にまとめる体制が整いました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "原信ネットスーパーを開設",
      "description": "2011年9月、株式会社原信がインターネット上に原信ネットスーパーを開設しました。2022年12月にはフレッセイもフレッセイネットスーパーを開設しています。",
      "significance": "店舗での販売に加え、インターネットで注文を受ける販売の形が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "アクシアル リテイリングに商号変更、フレッセイを子会社化",
      "description": "2013年10月、商号をアクシアル リテイリング株式会社に変更しました。同月、株式交換で株式会社フレッセイホールディングスを完全子会社にし、群馬県を地盤とするフレッセイなどがグループに加わりました。",
      "significance": "新潟県中心だった事業が群馬県にも広がりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "自社開発商品の開発会社を設立",
      "description": "2014年1月、プライベート・ブランド商品の開発に関わる機能を独立させ、アクシアル レーベル株式会社を設立しました。",
      "significance": "グループの店舗で売る自社開発商品を専門に開発する会社ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "東京証券取引所プライム市場へ移行",
      "description": "2022年4月、東京証券取引所の市場区分の見直しにより、上場市場がプライム市場に移りました。",
      "significance": "現在の上場区分です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2026,
      "title": "長野エリアセンターを開設",
      "description": "2026年2月、広域物流を拡充するため、長野県で初めての物流拠点となる長野エリアセンターを長野市に開設しました。",
      "significance": "長野県の店舗を含む広い地域へ商品を届ける物流の拠点が増えました。",
      "sourceIds": [
