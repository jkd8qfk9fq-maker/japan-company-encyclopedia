  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "当連結会計年度を最終年度とした中期経営計画「TO PLAN 2026」に掲げた「既存事業の収益力を最大限に発揮し、持続可能な企業へと成長するための基盤づくり」の実現に向け、コア事業を中心とした業績の回復および財務体質の強化に取り組みました。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "自動車関連、流通、木材、建設、不動産賃貸という性格の異なる５事業を北海道を地盤に併せ持ち、景気や消費動向の影響を受けやすい小売・自動車と、賃貸のような継続収入の事業を組み合わせた構成です。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、関係会社の状況、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "函館市を発祥の地として、自動車ディーラー、小売店舗、建設、不動産賃貸まで地域に密着した複数の事業を持ち、主要な設備の多くが北海道内にあります。木材事業は函館・盛岡の拠点から全国の小売店・建設会社へ販売しています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、主要な設備の状況、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高では自動車関連が8,973百万円と最大で、次いで流通が7,887百万円であり、この２事業でグループ売上高の中心を占めています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
