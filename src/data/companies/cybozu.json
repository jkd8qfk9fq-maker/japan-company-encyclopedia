  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「チームワークあふれる社会を創る」という企業理念のもと、情報共有の基盤となるソフトウェアを提供することを主な事業領域としています。対処すべき課題として、パートナーとの連携を強化しながらエンタープライズ市場も含めた新規顧客の獲得と既存顧客の全社利用推進、AI機能の開発、グローバル展開等に取り組む方針です。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の中心は、クラウドサービスの積み上がりを軸に、新規顧客の獲得と既存顧客の全社利用の推進を両面で進めることです。2025年1月にはエンタープライズ事業本部を設立し、大企業向けの提案活動を強化しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の記載と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析における製品・サービスの状況の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、パートナー企業とともに顧客への提供価値を高めるエコシステムにあります。2025年12月末時点のパートナー社数は約560社、パートナー企業が提供するプラグイン・連携サービスは500サービス以上であり、クラウド関連事業の国内売上高のうちパートナー経由の売上高は21,956百万円と印字されています。また、2011年に開始したクラウドサービスは契約社数70,000社、契約ユーザーライセンス数360万人を突破しています。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるパートナービジネスと主な製品・サービスの状況の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは「ソフトウェアの開発・販売」のみで、製品・サービス、地域、主要な顧客のいずれについても単一区分が90％を超える、又は10％以上を占める相手先がないため記載が省略されています。グローバル展開では、2025年12月末時点の導入社数が米国で910社、中華圏で1,430社、APACで760社と印字されています。",
        "basis": "セグメント情報における関連情報（製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報）の記載と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるグローバル展開の状況の記載",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
