  "history": [
    {
      "year": 1949,
      "title": "粧美堂株式会社を設立",
      "description": "大阪市東住吉区に粧美堂株式会社を設立しました。前年の1948年10月には、創業者である寺田正次が大阪市東区博労町（現在の中央区）でクシ・ブラシ等の化粧雑貨の一次卸問屋を創業していました。",
      "significance": "現在の当社の起点です。問屋として出発したことが、後のファブレスメーカーとしての事業の土台になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "総合スーパーへの販路を拡大",
      "description": "株式会社ダイエーとの取引開始を契機に、その後ジャスコ株式会社（現・イオンリテール株式会社）、株式会社ニチイ（現・イオンリテール株式会社）、株式会社イトーヨーカ堂等へ、順次、総合スーパーの販路を拡大しました。",
      "significance": "量販店向けの販路が広がり、事業拡大の基盤になりました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1996,
      "title": "ツバキ株式会社の株式を取得しサンリオのライセンスを継承",
      "description": "頭髪商品メーカーであったツバキ株式会社の過半数の株式を取得し、商品企画開発機能の充実を図りました。あわせて株式会社サンリオとのライセンス契約を継承しました。",
      "significance": "キャラクター雑貨の事業につながるライセンスの起点の一つです。",
