  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針に「情報の活用機動力を武器に生産性の向上」を、営業方針に「選択と集中」「小さな市場の大きなシェアを取る」「消費者と直接繋がる」を掲げています。中長期の課題として、真のメーカー化による粧美堂ブランドの確立、「モノづくりのパートナー」としてのOEMビジネスの強化、ECビジネスの強化、新しい商材の強化を挙げています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当期は、化粧品のOEM製造受託を行う株式会社ピコモンテ・ジャパンを子会社化する一方で、相乗効果が十分に得られなかったビューティードア株式会社を譲渡するなど、グループ会社の再編による選択と集中を進めました。",
        "basis": "MD&Aの経営成績の概要に、グループ会社の再編の実施とその理由が述べられていること、【関係会社の状況】に両社の異動が印字されていることを根拠としています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "問屋発祥のファブレスメーカーとして、マーケティングから企画、デザイン、開発、販売までを自社単独で一気通貫で行えるスピード感と、自社企画商品、別注商品、OEM商品など幅広い取引形態に対応できる柔軟性が強みです。数多くのブランドライセンスの使用により、顧客の要望に沿った提案ができる対応力も備えています。",
        "basis": "【事業の内容】に、ファブレスメーカーとしての事業の進め方と強みが述べられていることを根拠としています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な販売先は株式会社セリア（2025年9月期の売上高の13.5％）と株式会社ドン・キホーテ（同11.6％）で、100円ショップやディスカウントストア等の大手小売業向けの販売が中心です。キャラクター雑貨では、株式会社サンリオやウォルト・ディズニー・ジャパン株式会社などの版権元から商品化許諾を受けて商品化しています。",
        "basis": "セグメント注記の【関連情報】の主要な顧客ごとの情報に販売先と売上高の割合が印字されていること、【事業の内容】にキャラクター雑貨の版権元が述べられていることを根拠としています。",
        "asOf": "2025-12-18",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
