  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「消費者的視点に立った経営」を企業理念とし、日本の食文化の新しい価値の創造を提案の柱とすることを基本方針としています。具体的な施策として、多様化・個性化する消費者の支持を得られる新製品の開発、新販路と新しいマーケットの開拓強化、製品の安全性と品質の安定性の向上、生産性の向上と全社的な経費削減、中国をはじめとする海外マーケットの開拓の５点を掲げています。安全・安心な製品の安定供給に努め、生産活動の効率化やコスト削減を推し進め、新製品の開発に注力する方針です。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "原料海苔の仕入価格の高騰で当期は損失となった中、新製品の開発と販路・海外市場の開拓を進めながら、生産効率化と経費削減で収益の回復をはかる構成になっています。福岡工場隣接地の新工場は2026年３月稼働開始予定で、生産体制の増強が次の段階です。",
        "basis": "経営方針における対処すべき課題と５つの施策、および沿革における新工場の記載に基づく",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1955年の設立以来、海苔を中心とした加工食品に特化してきました。福岡工場と広川工場では国際品質管理規格の認証を取得し、品質管理の体制を整えています。「しらすふりかけ」や「緑黄野菜ふりかけ」、「カリカリ梅」シリーズなど、長く販売を続けている製品を持ち、家庭用と業務用の両方の販路に製品を供給しています。",
        "basis": "沿革における設立と製品発売・認証取得の記載、および事業の内容における製品構成の記載に基づく",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主原料である海苔は、気候変動の影響や生産漁家の減少などから国内の収穫量が減少傾向にあり、仕入価格が変動する環境にあります。当期は収穫量が前年より増加したものの、仕入価格は前年度より上昇しました。売上高の構成は業務用海苔が最大で、次いで家庭用海苔、ふりかけ等が続いています。",
        "basis": "経営方針における経営環境の記載と、品目別の販売実績の構成に基づく",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
