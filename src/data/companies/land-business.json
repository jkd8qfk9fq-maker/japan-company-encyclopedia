  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "東京のオフィスビル・レジデンスを中心とした不動産賃貸事業を収益基盤として確立すると同時に、新規物件の取得や保有物件の開発による収益の獲得増加に取り組み、美しいデザインと確かな機能性を併せ持つリビルド工事により保有物件の付加価値を高め、建物の維持管理の質を上げることで他社との差別化を図ることを掲げています。外食事業では良い空間、良い食事、良いサービスを提供すること、服飾事業では時代に流されることのないベーシックな価値を持つ「装う楽しみ」を提供することを目指しています。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期は、不動産関連事業で販売用不動産を売却したことが寄与し、売上高は前期比86.5％増の18,603百万円となりました。不動産関連事業が売上高の過半を占める一方、外食事業と服飾事業は新規出店や子会社の取り込みで規模を広げており、2025年5月には村田商事株式会社の全株式を取得して連結子会社としました。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、MD&Aの経営成績の概況における売上高の増減説明、重要な契約等における村田商事株式会社の株式取得の記述に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「都市にヨーロッパの光と風」をデザインコンセプトに掲げ、既存のオフィスビル・レジデンス・商業施設を取得してリニューアルし、経済的価値の増大と耐用年数の長期化を図る建物づくりを強みとしています。服飾事業では、商品企画・生産から販売まで一貫した体制をグループ内に持っています。",
        "basis": "事業の内容における事業運営の理念とデザインコンセプト、投資その他事業のリニューアルの記述、服飾事業の一貫体制の記述、経営方針、経営環境及び対処すべき課題等における差別化の記述に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは不動産関連事業、外食事業、服飾事業の3つで、2025年9月期の外部顧客への売上高は不動産関連事業が10,010百万円と過半を占め、服飾事業が7,169百万円、外食事業が1,218百万円です。売上高の10％以上を占める主要な顧客はなく、連結の従業員数は604人です。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高、関連情報（主要な顧客ごとの情報）、連結経営指標等の従業員数に基づく。",
        "asOf": "2025-12-19",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
