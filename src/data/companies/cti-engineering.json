  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年を目標年次とする中長期ビジョン「SPRONG2030」に基づき、グローバルインフラソリューショングループとして飛躍することを目指しています。その実現に向けた中期経営計画2027（2025年1月～2027年12月）では、事業ポートフォリオの変革（コア事業領域の深化、成長分野の加速、新規事業の探索、海外事業の拡大）と、成長基盤の再構築（人的資本への投資強化、DX／生産システム改革の促進など）の2本柱を基本方針としています。",
        "asOf": "2026-04-07",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "1945年に創立された財団法人建設技術研究所を前身とし、「誠実」と「技術」を社是として、電力確保のためのダム建設をはじめとする社会資本整備の調査・計画・設計で実績を重ねてきました。河川、ダム、道路、環境、情報などの幅広い分野で、企画から運用維持管理までを一貫して担える体制を築いています。",
        "asOf": "2026-04-07",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の連結売上高101,038百万円の内訳は、セグメント別の外部顧客への売上高で国内建設コンサルティング事業69,724百万円、海外建設コンサルティング事業31,313百万円です。地域別では日本が69,921百万円、英国が23,320百万円で、英国はWaterman Group Plcを中心とする海外事業の拠点です。主要な顧客である日本国への売上高は30,741百万円で、総販売実績の30.4％を占めています。",
        "basis": "セグメント情報の外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報",
        "asOf": "2026-04-07",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
