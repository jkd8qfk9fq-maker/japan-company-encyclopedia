  "updatedAt": "2026-11-09",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期経営ビジョン ～Kyokuto Kaihatsu 2030～では2030年度に売上高2,000億円を目指し、中期経営計画2025-27では2027年度に売上高1,900億円を目指しています。5つの基本方針は、高付加価値製品・サービスを通じた社会的課題解決と価値創造、生産性の向上と利益体質の強化、海外事業の成長加速、サステナビリティ経営の推進、企業価値向上を実現する資本政策の推進です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "特装車事業が売上高の8割以上を占める一方で、環境事業も前期比27.4%増と伸びており、3つの事業をあわせ持つ体制です。海外ではインドやインドネシア、オーストラリアで生産販売する体制を広げています。",
        "basis": "外部顧客への売上高は特装車事業135,212百万円、環境事業18,077百万円、パーキング事業8,042百万円です。インドのチェンナイ工場が2026年2月に竣工し、インドネシアの新工場も2026年7月の竣工に向けた準備を進めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ダンプトラックからテールゲートリフタ、タンクローリ、ごみ収集車、トレーラまで幅広い特装車を手がけ、製造からアフターサービスまで一貫して提供する体制があります。電動式ごみ収集車やIoTを利用した車両管理支援システムなど、新技術の製品化も進めています。",
        "basis": "特装車事業はダンプトラック、テールゲートリフタ、タンクローリ、ごみ収集車、トレーラなどの製造販売を行っています。2025年4月にBEVシャシ向け電動式ごみ収集車を発売し、IoTを利用した車両管理支援システムがグッドデザイン賞を受賞しました。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "特装車を中核に、環境事業とパーキング事業をあわせ持ち、長期経営ビジョンではサステナブル社会の実現・発展に貢献し業界をリードするグローバルな総合インフラメーカーを目指しています。",
        "basis": "長期経営ビジョンでは「サステナブル社会の実現・発展に貢献し業界をリードするグローバルな総合インフラメーカー」を目指すとしています。各報告セグメントの外部顧客に対する売上高の連結売上高に対する割合は、特装車事業が83.8%、環境事業が11.2%、パーキング事業が5.0%です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
