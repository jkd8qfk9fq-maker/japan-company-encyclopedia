  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年6月期を初年度とする中期経営計画（2028年6月期まで）では、手芸の裾野拡大、収益性の向上、グループシナジーの深化の3つを骨子に据え、ライトユーザーの取り込み強化、グループ各社の強みを生かした商品開発による他社との差別化、グループ各社の仕入・マーケティングの機能一元化に取り組むとしています。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "手芸専門店のチェーンと手芸書籍の出版を同じグループに持ち、店舗でのワークショップや講習会と、書籍やECサイトでの情報発信を組み合わせられる構成です。",
        "basis": "【事業の内容】に、藤久が手芸専門店「クラフトハートトーカイ」を中心とする店舗とECモールサイトで手芸用品・生活雑貨等を販売していること、日本ヴォーグ社が手芸関連書籍の出版事業を行っていることが書かれています。【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】には、店舗で編み物初心者向けのワークショップを開催していること、日本ヴォーグ社が自社ECサイト「手づくりタウン」をメディア型ECサイトへ転換を進めたことが書かれています。",
        "asOf": "2026-09-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
