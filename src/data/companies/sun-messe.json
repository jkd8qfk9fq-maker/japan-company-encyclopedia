  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年の創業90周年を機に、初めてのコーポレート・パーパス『対話（コミュニケーション）と技術力で、“感動をデザイン”する。』を制定し、新ビジョン『印刷を、超えた「総合コミュニケーション企業」へ』を掲げています。創業100周年にあたる2035年をターゲットにした中長期経営計画「Ｃｈａｎｇｅ －ＳＸ２０３５－ 印刷を、超える。」のもと、コア事業である商業印刷を堅持しつつ、ＩＰＳやパッケージといった成長領域へ経営資源を重点配分し、印刷を超えた領域での収益の柱の確立を目指しています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期の売上高17,130百万円の内訳は、印刷事業16,522百万円、イベント事業608百万円で、印刷事業が全体の96％あまりを占めます。印刷事業の中では商業印刷関連が10,386百万円と最大ですが前期比では減少しており、一方でＩＰＳ関連は2,286百万円と前期比23.2％増、ＢＰＯ関連とコーポレート・コミュニケーション関連も前期から増えています。",
        "basis": "セグメント情報における外部顧客への売上高と収益の分解情報、及び経営成績の分析におけるセグメント別売上高の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "同社は、企画、デザイン、製版、印刷、製本までを自社グループで一貫して手がけており、印刷に加えてデータ・プリント・サービス（ＩＰＳ）や仕分け・梱包・発送（ＢＰＯ）までを一体で受注できる体制を整えています。また、環境に配慮した印刷技術の提供を経営の基本方針の一つに掲げています。",
        "basis": "【事業の内容】における事業範囲の記載と、経営方針における経営基本方針（環境保護）の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "印刷業界では、情報媒体のデジタルシフトによるペーパーメディア需要の減少が進み、競争の激化やコスト上昇分の価格転嫁の難しさ、人手不足に伴う生産体制の見直しなど、厳しい環境が続いているとされています。同社は岐阜県大垣市に本社を置く総合印刷会社として、商業印刷を中核にしながら、ＩＰＳやパッケージ等の成長領域とイベント事業へ展開しています。",
        "basis": "経営成績の分析における印刷業界の環境認識と、経営方針における経営環境の記載に基づきます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
