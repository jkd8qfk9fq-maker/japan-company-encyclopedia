  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「技術者の地位向上と業界最高の収入を実現し創造的個人経営者集団を形成させる」を掲げ、知識に基づく知恵を扱う「技術商社」として人材を育成し社会に貢献することを使命としています。中長期の戦略では、中期経営計画の「テクノロジスト700人体制」の構築に向け、採用活動の強化、独自の技術教育プラットフォームによる育成体制の強化、AIなど先進技術分野での新規顧客の獲得に取り組むとしています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "連結売上高のすべてが技術職知財リース事業によるもので、一般派遣及びエンジニア派遣事業は前期から全業務を休止しています。収益は単一の事業に集中しており、その事業の技術者の確保が業績を左右する構造です。",
        "basis": "セグメント情報の外部顧客への売上高と、経営成績の分析における一般派遣及びエンジニア派遣事業の休止の記載に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "研究開発や設計といった上流工程の4分野に特化し、技術者を「テクノロジスト」と位置づけて、分野別研修や独自の技術教育プラットフォームで育成する体制を持っています。技術力に加えて創造性や人間力を重視する人材育成が、派遣先への提供価値を支えています。",
        "basis": "【事業の内容】の技術職知財リース事業の説明と、【経営方針、経営環境及び対処すべき課題等】の人材育成に関する記載に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "技術者派遣に特化し、顧客は製造業を中心に自動車関連、産業用機器関連、情報処理関連、建築関連など幅広い業種に分散しています。主要な顧客として株式会社デンソーテンと株式会社LIXILが開示されています。",
        "basis": "【事業の内容】の取引先業種の一覧と、【関連情報】の主要な顧客ごとの情報の記載に基づきます。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
