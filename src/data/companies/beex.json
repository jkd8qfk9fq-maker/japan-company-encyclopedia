  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期の経営戦略として、MSPとクラウドライセンスリセールを中心としたストック型収益モデルを構築し、継続的な成長と安定的な収益モデルの構築を推進するとしています。成長戦略として、大規模な基幹システムのクラウド移行案件の獲得、顧客企業のデジタルトランスフォーメーションを実現するプラットフォームの構築、セキュリティソリューションの提供を掲げています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、SAPシステム基盤とクラウドの双方を理解し、運用にも精通したエンジニア体制にあります。AWS、Microsoft、Google、SAPの認定資格を持つエンジニアを多数育成し、AWSパートナーの最上位であるプレミアティアサービスパートナーの認定を受けています。自社の運用サービスツール「BeeX Service Console」は、顧客企業が導入パートナーを選ぶ際の差別化要因になっています。",
        "basis": "【事業の内容】における認定資格取得数とエンジニア体制の記載、【経営方針、経営環境及び対処すべき課題等】におけるBeeX Service Consoleの差別化要因としての記載に基づく。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "パブリッククラウド市場は拡大が続いており、同社はAWS、Microsoft Azure、Google Cloudの3つのクラウドを取り扱うマルチクラウド対応を進めています。MSPの期末月の顧客数は2022年2月期の58社から2026年2月期の114社へ増え、クラウドライセンスリセールのアカウント数合計も増えています。",
        "basis": "【事業の内容】におけるMSP顧客数とクラウドライセンスリセールのアカウント数の推移の記載、【経営方針、経営環境及び対処すべき課題等】におけるクラウド市場の動向の記載に基づく。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
