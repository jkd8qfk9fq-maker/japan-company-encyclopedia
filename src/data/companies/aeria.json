  "history": [
    {
      "year": 1998,
      "title": "前身の有限会社コミュニケーションオンラインを創業",
      "description": "1998年5月、現在の代表取締役会長の長嶋貴之氏と代表取締役社長の小林祐介氏が、千葉県流山市に有限会社コミュニケーションオンラインを出資金3百万円で設立しました。1999年7月には株式会社に組織変更し、商号を株式会社コミュニケーションオンラインとしています。",
      "significance": "有価証券報告書は、この会社を当社の前身としています。インターネット上のコミュニティ事業（個人向けに無料でホームページ環境を提供する事業）をもとに、その技術と運営ノウハウを活かしたシステムソリューション事業やモバイル事業などへ事業を広げた、と書いています。",
      "sourceIds": [
        "yuho-2025"
      ]
    },
    {
      "year": 2002,
      "title": "会社分割で株式会社アエリアを設立",
      "description": "2002年10月、株式会社コミュニケーションオンラインの会社分割により、東京都港区に資本金10百万円で株式会社アエリアを設立しました。同時に、インターネットコム株式会社と株式会社ゲームポットを子会社として承継しています。",
      "significance": "当社は、コミュニティ事業以外の全事業（モバイルコンテンツ＆ソリューション事業、システムソリューション事業、メディア事業）を承継する新設会社として生まれました。コミュニティ事業だけを承継した株式会社コミュニケーションオンラインは、株式交換により楽天株式会社の100%子会社となり、有価証券報告書は「実質的にはコミュニティ事業を株式交換によって事業売却した形」と書いています。",
      "sourceIds": [
