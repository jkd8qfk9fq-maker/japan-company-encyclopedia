  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期を初年度とする3か年の中期経営計画を策定し、既存事業によるオーガニック成長を継続しつつ、M&A戦略をさらに強化することで、顧客基盤のさらなる拡大と既存事業とのシナジー創出を図るとしています。ロールアップ型のM&Aで顧客基盤を強化し、AI等の先端技術を含む提供価値を増やし続けることで、顧客生涯価値の向上と事業の成長を同時に実現する循環を回し、ITの総合サービス企業として進化していくとしています。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の約8割を占めるITインフラ関連事業を基盤に、既存顧客へのアップセルとクロスセルで顧客あたりの導入商材数を増やす進め方が、MD&Aに印字された当期の取り組み（複数商材の利用促進と継続型商材の受注）と整合しています。",
        "basis": "セグメント情報の外部顧客への売上高と、MD&Aの経営成績の概要（セグメントごとの経営成績）に基づく。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "長年にわたり情報通信機器やISP回線の手配などの販売を行ってきた実績を活かし、通信環境を意識したオフィスレイアウトの提案まで行う点と、電力小売りや光コラボレーション、法人向けトータルサポートなどの継続型の商材を複数そろえ、1社の顧客に複数商材を届けられる点が強みです。",
        "basis": "事業の内容（ITインフラ関連事業の説明）と、MD&Aのセグメントごとの経営成績に基づく。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主に中小企業市場を対象とし、ITインフラからデジタルマーケティング、業務自動化までを一つのグループで提供する体制をとっています。前期はオリックス株式会社が売上高の10％以上を占める主要な顧客でしたが、当期は10％以上を占める顧客はありません。",
        "basis": "事業の内容と、セグメント情報の関連情報（主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-16",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
