  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年8月に公表した中期経営計画2025-2027のもと、「『0→1』の事業創出に加え、『1→10』の事業成長が実現できる会社」への進化を目指し、「ブランディングの強化」と「高リテンション事業の創出」を全社の基本的な方針として事業を推進する方針です。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "アルバイト・転職・ITエンジニアと採用領域の異なる複数のメディアを長年運営し、求人企業と求職者の双方を利用者として集めている点が強みです。不動産情報サービスも手がけ、求人以外の領域にも事業を広げています。",
        "basis": "事業の内容に、マッハバイト・転職会議・転職ドラフト・イエシルの各サービスの内容が印字され、経営者による分析にサービス別の売上高が印字されているため。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "インターネットメディア事業の単一セグメントで、2025年12月期の売上高は前期比10.8％減少しました。マッハバイトの売上高が前期比18.7％減少した一方で、転職会議は12.5％、転職ドラフトは4.8％増加しています。",
        "basis": "経営者による分析に、連結売上高と主要事業の売上高の前期比（マッハバイト3,201,436千円で18.7％減、転職会議1,180,529千円で12.5％増、転職ドラフト594,879千円で4.8％増）が印字されているため。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
