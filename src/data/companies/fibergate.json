  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「『ありがとう』を集める。」を掲げ、透明性の高い企業経営とコンプライアンスの徹底を経営の基本としています。優先的に対処すべき課題として、成長ピッチの回復と構内インフラ・インテグレーターとしての地歩固めを挙げています。通信事業では、集合住宅向けにレジデンスWi-Fiサービスの新規契約獲得とシェア拡大を目標に掲げ、フリーWi-Fiではホテル、介護施設、BCP対策などの業務利用需要の開拓を進めます。構内インフラ・インテグレーター（通信×エネルギー）化に向けては、地域別営業体制への再編による通信とエネルギーのクロスセル営業の加速や、通信×エネルギーのワンストップサービスによる差別化を推進するとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "自社で開発した通信機器等の販売も含め、通信機器開発からWi-Fi環境の構築、運用、顧客サポートまで一気通貫でサービス提供できるノウハウを有する垂直統合型のビジネスモデルを構築したことが、当社グループの大きな特徴であるとしています。顧客側からはワンストップサービスを委託できる安心感と、契約からサービス導入までのスケジュールの短縮があり、当社グループ側では工程ごとのノウハウが蓄積され、各工程の調達費用の削減等によるコスト低減が図れるとしています。また、エンドユーザーから当社グループへの直接の問い合わせ対応を通して把握したニーズを、早期に事業戦略に反映することに努めています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高は2022年6月期の10,624百万円から2026年6月期の13,664百万円へ増えています。売上高の96％超を通信事業が占め、賃貸物件への導入戸数は堅調で、医療・介護分野への売上や学校向け案件も伸長したとされています。同社は、ニッチな市場を自ら創出し、構内インフラ・インテグレーターとして市場占有率を高めることによってプライスメーカーとなることを経営方針に掲げています。2024年からは成長の第5ステージとして、独立系Wi-Fiソリューション企業から構内インフラ・インテグレーターへの地歩固めを行う期間と位置付けています。",
        "basis": "経営指標等の推移に印字された売上高の推移と、経営方針、経営環境及び対処すべき課題等に印字された成長ステージの位置付け、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に印字された事業の進捗に基づきます。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
