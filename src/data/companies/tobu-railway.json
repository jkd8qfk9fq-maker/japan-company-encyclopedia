  "history": [
    {
      "year": 1897,
      "title": "東武鉄道株式会社を設立",
      "description": "1897年11月に東武鉄道株式会社が設立されました。",
      "significance": "現在の東武グループの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1899,
      "title": "伊勢崎線の北千住〜久喜間が開通し営業を開始",
      "description": "1899年8月に伊勢崎線の北千住〜久喜間が開通し、営業を始めました。その後、1910年7月に太田〜伊勢崎間が開通しています。",
      "significance": "鉄道業の始まりです。2026年3月期の当社の営業キロは463.3キロです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1920,
      "title": "東上鉄道を合併",
      "description": "1912年7月に佐野鉄道、1920年6月に東上鉄道を合併しました。1944年3月には総武鉄道も合併しています。",
      "significance": "他の鉄道会社の合併や買収で路線網を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1929,
      "title": "日光線が開通し、事業目的に土地建物の売買・賃貸と自動車事業を追加",
      "description": "1929年4月に事業目的へ土地建物の売買、賃貸および自動車事業を加え、同年10月に日光線が開通しました。1934年4月には乗合自動車事業を川越地区で始めています。",
      "significance": "鉄道以外の不動産やバスの事業に広がる最初の一歩です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1931,
      "title": "浅草雷門（現・浅草）〜業平橋（現・とうきょうスカイツリー）間などが開通",
      "description": "1931年5月に浅草雷門（現・浅草）〜業平橋（現・とうきょうスカイツリー）間、8月に宇都宮線、12月に大師線が開通しました。",
      "significance": "東京の中心部と日光・宇都宮方面を結ぶ路線の骨格がこの頃にできました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1942,
      "title": "東武通運を設立し貨物運送事業を開始",
      "description": "1942年12月に東武通運㈱（現・東武運輸㈱）を設立し、貨物運送事業を始めました。",
      "significance": "東武運輸㈱は現在、運輸事業の貨物運送業を担っています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "東京証券取引所に上場",
      "description": "1949年5月に東京証券取引所に上場しました。1961年10月に市場第一部に指定され、2022年4月の市場区分の見直しでプライム市場へ移行しています。",
      "significance": "表紙は上場金融商品取引所を東京証券取引所プライム市場と記載しています。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1960,
      "title": "東武百貨店を設立し、流通事業が広がる",
      "description": "1958年6月に㈱東武宇都宮百貨店、1960年9月に㈱東武百貨店、同年12月に㈱東武会館（現・㈱東武ストア）を設立しました。1962年5月には池袋西口に東武百貨店池袋店を開店しています。",
      "significance": "百貨店とストアは現在、流通事業の中心です。2026年3月期の流通事業の外部顧客への営業収益は165,445百万円です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "地下鉄日比谷線との相互乗入れ運転を開始",
      "description": "1962年5月に帝都高速度交通営団（現・東京地下鉄）日比谷線（北千住〜人形町間）が開通し、相互乗入れ運転を始めました。その後、1987年に有楽町線、2003年3月に半蔵門線・東急田園都市線、2008年6月に副都心線との相互乗入れを始めています。",
      "significance": "都心の地下鉄や他社線への乗入れを重ねて、沿線から都心への直通ルートを広げてきました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2012,
      "title": "東京スカイツリータウンが開業",
      "description": "2012年5月に東京スカイツリータウンが開業しました。",
      "significance": "現在、スカイツリー業はレジャー事業、スカイツリータウン業は不動産事業に含まれます。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2018,
      "title": "東武ストアを完全子会社化",
      "description": "㈱東武ストアは1979年9月に東京証券取引所市場第二部、1988年8月に市場第一部に上場していました。2018年10月に公開買付け等で当社の完全子会社となり、上場廃止となりました。",
      "significance": "㈱東武ストアは現在、流通事業のストア業を担う連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "東上線から新横浜・西谷・海老名・湘南台方面への直通運転を開始",
      "description": "2023年3月に、東上線、東京メトロ副都心線、東急東横線・新横浜線、相鉄新横浜線・本線・いずみ野線（小川町〜和光市〜渋谷〜日吉〜新横浜〜西谷〜海老名・湘南台間）で直通運転を始めました。",
      "significance": "直通運転は、沿革に記載された最も新しい出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
  ],
