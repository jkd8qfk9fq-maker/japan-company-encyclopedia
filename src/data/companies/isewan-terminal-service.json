  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年までに目指したい姿（2030年ビジョン）を「和を重んじた つなぐ物流で、地域・港湾の発展に寄与する」と定め、その実現に向けて2024年５月に中期経営計画を策定しました。スローガン「Challenge～つなぐ物流で未来へ」のもと、ＤＸ・ロボティクス、サステナビリティ・人的資本経営、グローバルの３つの物流イノベーション施策を重点として推進しています。優先的に対処すべき課題として「グローバルな海外展開」と「人材育成」を挙げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "名古屋港を基盤に、海運・陸運・空運を通してあらゆる貨物の取扱いを一貫して引き受ける総合物流事業者としての体制を持ちます。港湾運送にとどまらず、タイ・米国・ドイツ・中国・香港・インドネシア・台湾・メキシコの現地法人を含む海外ネットワークで、保管・輸送・通関を自社グループで担えることが特徴です。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営の基本方針と、【事業の内容】【関係会社の状況】のグループ構成に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "物流事業の単一セグメントで事業を展開しています。2026年３月期の売上高は57,893百万円で、地域別では日本が47,055百万円、その他が10,838百万円でした。MD&Aの作業種別の内訳では、附帯作業料が200億23百万円と最も大きく、海上運送料が103億28百万円、陸上運送料が81億62百万円、船内荷役料が75億98百万円、沿岸荷役料が75億円、倉庫料が37億53百万円でした。主要な顧客はオークマ株式会社で、主要な顧客ごとの情報に最大の顧客として記載されています。",
        "basis": "セグメント情報の関連情報（地域ごとの情報、主要な顧客ごとの情報）と、MD&Aの作業種別の内訳に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
