  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「『働く』を豊かにする。～B2B領域でイノベーションを起こし続ける～」をミッションに掲げ、各セグメントのサービスを顧客である事業者に対して一体的に提供し、その成長を支援することで、グループシナジーの最大化を図ることを主要な戦略としています。プロフェッショナルサービス事業で大手企業のニーズにテイラーメイドで対応して蓄積した知見を、SaaS事業の各サービスの機能に組み込み、DX事業ではShopifyを用いたサイト構築支援やアプリの開発・提供を進めるとしています。今後はグループ横断での顧客支援体制を強化し、共通のデータ基盤の活用を通じて継続的な取引拡大を目指すとしています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "プロフェッショナルサービス事業で得た広告運用の知見をSaaS事業のツールの機能に組み込み、データフィード分野では両事業が互いにサービスを利用し合うなど、3つの事業が補完し合う組み立てになっています。DX事業のShopify関連サービスは、SaaS事業で提供するサービスとの親和性が高いとされ、EC事業者を入口にグループの複数サービスへ広げる構造になっています。",
        "basis": "経営戦略等に記載された、プロフェッショナルサービス事業の知見のSaaS事業への組み込み、データフィード分野における両事業の補完関係、DX事業とSaaS事業の親和性の内容に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "多様なデジタルプラットフォーマーと良好なパートナーシップを構築しており、各プラットフォームへの広告掲載やAPIの利用にあたって求められる情報・要件について熟知しているため、円滑な広告出稿やAPIを活用したサービス提供が可能であるとしています。テクニカルパートナーとして開発に協力するなど、従来から各プラットフォーマーとの関係を構築してきているとしています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "広告媒体やID認証などの基盤を自社で持つのではなく、複数のプラットフォーマーの技術的要件に通じたうえで、広告運用の代行と自社ツールの両方を提供している点が、単独の広告代理や単独のツール提供とは異なる組み立てになっています。",
        "basis": "事業の内容に記載された、プラットフォーマーとのパートナーシップと技術的要件への熟知、運用型広告代行とデータフィード・ID連携ツールの提供内容に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "主要な事業領域である国内のインターネット広告市場は拡大を続けており、動画広告需要の高まりを背景に伸長しているとしています。消費者向け電子商取引（BtoC-EC）市場も拡大が続いているとしています。",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "インターネット広告の運用支援と、EC事業者向けのツール・構築支援の両方を手がけており、広告市場の拡大とEC市場の拡大の双方に関わる位置にあります。顧客は特定の相手先に偏っておらず、外部顧客への売上高の10％以上を占める相手先はないとされています。",
        "basis": "経営環境に記載されたインターネット広告市場とBtoC-EC市場の動向と、セグメント情報の主要な顧客ごとの情報に10％以上を占める相手先がない旨の記載に基づく",
        "asOf": "2026-08-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
