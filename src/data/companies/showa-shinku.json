  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "真空技術をキーテクノロジーとして、成長するニッチ市場へフォーカスし、技術力による差別化と独自性を発揮することを経営方針としています。水晶・光学デバイス分野に加えて成長分野へ次期戦略装置を提供するため、市場別戦略の明確化と受注体制の高度化、品質を基軸とした設計生産体制の強化、次世代人材の育成に取り組むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、既存の水晶・光学デバイス向け装置に加え、AI・データセンターや航空宇宙などの成長分野で使われる電子部品向けに、真空技術の応用範囲を広げることです。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境と対処すべき課題、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "顧客のニーズに合わせて仕様を調整するカスタムメイドの真空装置を自社で開発・製造し、装置を納めた後も部品販売、改造工事、修理のサービスで顧客と取引を続ける体制を持つことが強みです。",
        "basis": "【事業の内容】の事業内容、【経営方針、経営環境及び対処すべき課題等】の経営方針、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "アルバックグループの真空機器事業に位置づけられ、水晶デバイス、光学デバイス、電子部品向けの薄膜形成装置を担っています。グループの中心である株式会社アルバックとは電子部品メーカー向けの分野が一部重なりますが、取り扱う装置の中心や納入先、価格帯が異なると説明されています。",
        "basis": "【事業の内容】の株式会社アルバック及び同社を中心とする企業集団との関係についての記述",
        "asOf": "2026-06-25",
        "sourceIds": [
