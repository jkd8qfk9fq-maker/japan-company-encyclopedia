  "history": [
    {
      "year": 1966,
      "title": "前身のフロンティア製茶を静岡市に設立",
      "description": "1966年8月、日本ファミリーサービス株式会社と合資会社ビーエー商会の共同出資で、前身のフロンティア製茶株式会社を静岡県静岡市に設立しました。緑茶のルートセールス（小売店などへの直接販売）を始めました。",
      "significance": "伊藤園は、緑茶を小売店へ直接売る営業から始まりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "株式会社伊藤園に商号変更",
      "description": "1969年5月にフロンティア製茶から「株式会社伊藤園」へ商号を変更しました。同年6月には、株式会社本庄商事と合資会社ビーエー商会から緑茶事業の営業譲渡を受け、生産部門を確保しました。",
      "significance": "現在の社名が生まれ、販売だけでなく生産の部門も持つようになりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "茶産地育成事業を開始",
      "description": "1976年4月に茶産地育成事業の展開を始めました。",
      "significance": "茶葉の調達に関わる取り組みの始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1981,
      "title": "缶入りウーロン茶を発売し、缶飲料に本格進出",
      "description": "1979年8月に日本初のウーロン茶輸入代理店契約を結び、1981年3月に無糖茶飲料「缶入りウーロン茶」の全国販売を始めました。缶飲料業界に本格的に進出しました。",
      "significance": "茶葉の販売に加え、飲料（ドリンク）の販売へ広がった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1985,
      "title": "緑茶飲料「缶入り煎茶」を発売",
      "description": "1985年2月に緑茶飲料「缶入り煎茶」の全国販売を始めました。1989年2月に名称を変更し、「お～いお茶」ブランドとして販売を始めました。",
      "significance": "「お～いお茶」ブランドの原点となる製品です。",
