  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「人」「力」「技術」を社是とし、2024年4月期から2027年4月期を対象とする「中期経営計画2024－2027」と、2027年4月期をターゲットとする「NOVAC VISION」を掲げています。公共工事を軸とする土木工事事業と、民間工事を軸とする建築工事事業の二大セグメントを推進して事業の安定化を図り、DXの推進による生産性の向上や、連結子会社の株式会社ＴＯＭＴＥＮとの連携によるシナジー効果の創出にも取り組みます。",
        "asOf": "2026-07-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "元請として工事を直接受注する比率が高く、直近5期で100％を維持しています（当社規定による官公庁の1億円以上の工事を対象とする算定）。また、従業員に占める監理技術者資格者証の保有者の割合は2026年4月末時点で45.2％と、全国平均とされる25％程度を上回っており、品質向上に特化した技術力の向上や、優良工事等施工者としての表彰の実績があります。",
        "asOf": "2026-07-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建築工事事業が売上の中心で、土木工事事業と合わせると売上のほぼ全てを建設工事の請負が占める構成です。不動産賃貸を行うその他はごく小さく、業績は建築と土木の受注と工事の進み具合に左右されます。",
        "basis": "セグメント情報における2026年4月期の外部顧客への売上高（建築工事事業24,533百万円、土木工事事業10,816百万円、その他13百万円、連結売上高35,363百万円）と、経営成績の概要におけるセグメント別の記述に基づきます。",
        "asOf": "2026-07-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
