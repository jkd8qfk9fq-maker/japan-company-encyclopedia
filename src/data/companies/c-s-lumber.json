  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "創業50周年を迎える2032年に向けた将来像「シー・エス・ランバーVISION 2032」を掲げ、プレカット事業を基盤としながらもその枠にとらわれず、多様な収益源を創りながら事業の拡大・成長を続ける企業集団を目指すとしています。プレカット事業では、サイディング（外壁材）プレカット事業の提案力強化、構造材と建て方工事を組み合わせた「材工一体」の提案、プレカット加工機の刷新による省人化と歩留まりの追求を進めます。建築請負事業では大型木造施設の受注やエリア拡大、不動産賃貸事業では収益物件や分譲候補地の取得による安定した賃貸収入の確保に取り組むとしています。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年5月期は、新設住宅着工戸数の低迷でプレカット事業の売上が減った一方、建築請負事業と不動産賃貸事業の売上が伸び、グループの売上に占める両事業の割合が高まりました。",
        "basis": "セグメント情報の外部顧客への売上高、MD&Aの経営成績の概要、関連情報に依拠します。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "製材・加工から配送、建築、不動産までをグループ内で一貫して担える体制を持ちます。不動産賃貸事業では保育所23物件を含む賃貸施設から安定した賃料収入を得ており、住宅市況の影響を受けにくい収益源を持っています。",
        "basis": "【事業の内容】の事業の内容とグループ会社の位置付け、【経営方針、経営環境及び対処すべき課題等】の対処すべき課題、MD&Aの経営成績の概要に依拠します。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "同社が属する住宅関連業界では、2025年6月から2026年5月までの累計で新設住宅着工戸数が前年同期比5.3％減となるなど、需要が伸び悩む環境が続いています。そのなかでプレカット事業の出荷棟数は5,106棟でした。",
        "basis": "MD&Aの経営成績の概要、セグメント情報の外部顧客への売上高に依拠します。",
        "asOf": "2026-08-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
