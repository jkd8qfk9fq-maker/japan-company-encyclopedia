    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「Ｍ＆Ａ Ｔｅｃｈにより未来のＭ＆Ａ市場を創造する」という企業理念のもと、従来のＭ＆Ａ仲介のアナログな手法をテクノロジーで刷新し、成約スピードの向上と価格の抑制を実現することを経営方針としています。成長戦略としては、Ｍ＆Ａアドバイザーの採用と教育体制の強化に取り組み、ＡＩマッチングの精度向上などを通じて1人あたりの売上収益の向上を図るとしています。",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年9月期は、コンサルティング事業の売上収益が前期の247百万円から1,451百万円へ拡大し、独立した報告セグメントとなりました。シンガポール現地法人とオペレーティング・リース事業の子会社も新たに設立され、Ｍ＆Ａ仲介以外の事業の幅が広がっています。",
        "basis": "セグメント情報と経営成績の分析における事業別の記載に基づく",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "競合優位性として、譲渡企業からは成約まで報酬を受け取らない完全成功報酬制の料金体系、2025年9月期に成約した案件の平均成約期間が7.2ヶ月という速さ、過去の事例と蓄積したデータを学習するＡＩマッチングアルゴリズムによる提案、自社開発のシステムと高い採用力を挙げています。",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "Ｍ＆Ａアドバイザーは2025年9月期に78名増員し、期末時点で390名となりました。成約件数は234件でした。",
        "basis": "経営成績の分析における主要なＫＰＩの記載に基づく",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "日本国内の中小企業のＭ＆Ａ市場については、経営者の高齢化と後継者不在企業の増加を背景に拡大が続いているとしています。後継者不在企業の割合は高止まりしており、Ｍ＆Ａによる第三者への事業承継が解決策の一つとして位置づけられています。",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当社グループの売上収益の9割超はＭ＆Ａ仲介事業によるもので、事業承継を中心とする国内のＭ＆Ａ仲介市場への依存度が高い事業構成です。",
        "basis": "セグメント情報の外部顧客への売上収益の構成に基づく",
        "asOf": "2026-01-05",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
