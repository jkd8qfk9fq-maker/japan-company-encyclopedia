  "history": [
    {
      "year": 1998,
      "title": "福岡県筑後市にタマホームを設立",
      "description": "現代表取締役会長の玉木康裕が、福岡県筑後市に注文住宅建設会社としてタマホーム株式会社を設立しました。「高品質住宅を低価格で提供する」という理念を掲げての創業です。",
      "significance": "タマホームの創業です。設立当初から掲げる「より良いものをより安く提供することにより社会に奉仕する」という経営方針の起点となりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2011,
      "title": "全47都道府県への出店を完了",
      "description": "タマホーム沖縄株式会社が沖縄県那覇市に新都心展示場を開設し、全国47都道府県すべてへの出店を完了しました。",
      "significance": "九州発の同社が全国展開を果たした節目です。",
      "sourceIds": [
