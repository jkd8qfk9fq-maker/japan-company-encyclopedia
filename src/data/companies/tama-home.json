  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念である「より良いものをより安く提供することにより社会に奉仕する」のもと、2027年5月期から2031年5月期までを対象とする中期経営計画「タマステップ2031」を策定しています。「V字回復から持続的成長へ」を基本方針に掲げ、事業競争力の強化と収益基盤の再構築を進めることで、持続的な企業価値の向上を目指しています。計画最終年度である2031年5月期の売上高目標は3,100億円です。",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "全国47都道府県に広がるロードサイド型独立店舗（183店舗）と住宅総合展示場（51箇所）を併用する店舗網と、設立当初から提供を続ける主力商品「大安心の家」シリーズが特徴です。地域の断熱区分に応じて商品を取りそろえ、「自由設計・オール電化・豊富な設備仕様」を特徴とする住宅を低価格で提供する姿勢を続けています。",
        "basis": "【事業の内容】の記載",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年5月期の売上高197,740百万円のうち、住宅事業が135,902百万円と約7割を占め、不動産事業の54,917百万円が続きます。本邦の外部顧客への売上高が全体の90％を超えています。国内の新設住宅着工戸数が弱含みで推移する中、注文住宅の引渡棟数の減少が当期の減収につながりました。",
        "basis": "【セグメント情報】・【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の記載",
        "asOf": "2026-08-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
