  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンは「アジアのコンシューマーファイナンスカンパニーとしてトップブランドを確立する」です。2025年度を初年度とする中期3カ年経営計画「Do next!」をスタートさせ、MUFGグループとの連携とM&Aによる成長戦略の加速、量から質への転換による抜本的な事業構造改革の推進、ALMの高度化による財務健全性の確保と資本効率の向上の3つの重点戦略に取り組んでいます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "加盟店網と信用調査の機能を軸に、クレジット、ペイメント、ファイナンスの3部門を一体で提供しています。国内に加え、ベトナム、インドネシア、カンボジア、フィリピンで二輪やオートローンの事業を展開しています。",
        "basis": "クレジット、ペイメント、ファイナンスの3部門を主力とすることと、海外4か国で事業を行うことが有報に記載されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の営業収益は192,315百万円で、国内が170,415百万円、海外が21,897百万円です。従業員数は5,532人です。",
        "basis": "報告セグメントごとの外部顧客への営業収益と従業員数が有報に記載されています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【セグメント情報】"
      }
    }
