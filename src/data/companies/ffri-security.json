  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「世界トップレベルのセキュリティ・リサーチ・チームを作り、コンピュータ社会の健全な運営に寄与する」を掲げ、国内でほぼ唯一となるコア技術からの研究開発と、純国産のサイバー・セキュリティ企業としての優位性を発揮できるナショナルセキュリティ領域への注力を中長期的な経営戦略としています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "サイバー・セキュリティのコア技術から研究開発を行う国内でほぼ唯一の企業であり、パターンファイルに依存しない完全ヒューリスティック検出技術により、未知のマルウェアや脆弱性を狙った攻撃を防御できます。研究成果をBlack Hatなどの国際的なセキュリティカンファレンスで発表するリサーチ能力も強みです。",
        "basis": "事業の内容における技術力の記載と、経営方針における研究開発戦略の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年5月に成立したサイバー対処能力強化法に基づく能動的サイバー防御の導入など、政府のサイバー安全保障への取り組みが加速し、ナショナルセキュリティ領域の需要が拡大しています。当社グループの主要な顧客には官公庁や政府関連機関が並びます。",
        "basis": "経営方針、経営環境及び対処すべき課題等と、経営者による分析における業界環境の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
