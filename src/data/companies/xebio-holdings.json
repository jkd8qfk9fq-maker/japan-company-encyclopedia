  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様第一主義」を経営理念とし、「オンリーワン」企業になることを経営の基本方針としています。スポーツ用品の小売事業を中核に、スポーツの力を活用する周辺事業へ領域を広げ、国内外の企業との協業やM&Aも活用するとしています。前期から進める経営構造改革を継続し、国内小売事業の販売力強化や海外事業の基盤強化などを重点施策に掲げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "大型複合店のスーパースポーツゼビオ、ゴルフ専門店のゴルフパートナー、アウトドア専門店のエルブレスなど、分野ごとの専門業態を使い分け、972店舗の店舗網を持っている点が特徴です。商品部門では、一般競技スポーツ・シューズとゴルフの2部門で売上の3分の2近くを占めています。",
        "basis": "【事業の内容】に各業態の店名が印字され、MD&Aにグループ総店舗数972店舗（2026年3月31日現在）と商品部門別販売実績（一般競技スポーツ・シューズ89,448百万円、ゴルフ80,185百万円、合計169,633百万円で売上高252,331百万円の約67％）が印字されている。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "連結売上高の9割以上が国内のスポーツ用品・用具の販売によるもので、国内市場を中心とするスポーツ小売グループです。海外ではシンガポールの子会社を通じたゴルフ事業などを展開しています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境に「連結売上高の９割以上が国内におけるスポーツ用品・用具の販売」と印字され、【関係会社の状況】に在外子会社Leonian Singapore Pte.Ltd.（海外事業統括）が印字されている。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
