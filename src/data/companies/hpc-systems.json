  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「Vision2027」のもと、「スーパーコンピュータからエッジコンピュータ」まで網羅するコンピューティングソリューションをワンストップで提供する体制を構築し、研究開発DXと製造業・非製造業DXを戦略分野として事業部間のシナジーによる差別化を図るとしています。グローバル戦略として海外向けソフトウェアライセンスビジネスの強化にも取り組むとしています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】"
      },
      "analysis": {
        "text": "売上高の約6割を占めるHPC事業と、産業用コンピュータのCTO事業の2事業体制で、研究機関と製造業の双方に顧客を持つ構成であることが読み取れます。",
        "basis": "セグメント情報でHPC事業の外部顧客への売上高が5,000百万円、CTO事業が2,905百万円であること。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "HPC事業では、計算化学分野の知見と、大学の研究室や公的研究機関、企業の研究開発部門との長年の関係を土台に、ハードウェアからソフトウェア、受託計算や技術支援までをワンストップで提供しています。CTO事業では、仕様設計から量産、出荷後の保守までの一貫体制と、同一仕様の産業用コンピュータを長期間安定して供給できる部品調達力が特徴です。",
        "basis": "【事業の内容】に、計算化学分野の強みと研究機関との関係性、ワンストップ体制、CTO事業の一貫体制と長期安定供給が書かれていること。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
