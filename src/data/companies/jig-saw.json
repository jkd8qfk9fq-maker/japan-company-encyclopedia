  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "あらゆる機器・装置や物質、生物・細胞・人体までをネットワークにつなぎ、極小ソフトウェアと生成AI基盤による監視・運用・制御でデジタルユニバース時代の中心の1社になることを目指しています。IoTエンジン「NEQTO」の世界への浸透、システムマネジメントとAI制御データコントロールのグローバル化、クラウドセキュリティSaaSの展開、自動運転ソフトウェアライセンスの商用化を推し進め、研究開発や人的資本への先行投資を続ける方針です。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
