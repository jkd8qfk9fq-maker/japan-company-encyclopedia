  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「我々は一人一人の夢の実現をサポートするワンストップパートナーであり続けます」を掲げ、優先的に対処すべき課題として、DX推進による優良な自社企画開発物件の安定供給体制の強化や、人材の確保・育成、DX・AI活用による業務効率化を掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、城南3区に開発エリアを絞り、土地仕入から物件管理までを一貫して行うワンストップサービスで物件価値を高め、安定供給を続けることです。高級賃貸レジデンス「THE GRANDUO」で商品の幅を広げ、不動産マネジメント事業で継続的な管理収入も積み上げています。",
        "basis": "セグメント情報の外部顧客への売上高、【事業の内容】の事業の特徴、【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績等の状況の概要",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "土地仕入・企画・設計・施工・賃貸募集・販売・物件管理をすべて自社で行うため、中間コストの削減や開発期間の短縮、各部門の連携による物件価値の最大化が図れます。城南3区で300棟を超える開発実績を持ち、用地情報が集まりやすい環境と、仲介・紹介によるプル型の販売体制も強みです。",
        "basis": "【事業の内容】のワンストップサービスの説明と事業の特徴、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "首都圏の分譲マンションは供給戸数が減る一方で価格上昇が続き、東京の居住用賃貸不動産への投資需要は引き続き高水準で推移しています。当社は城南3区に絞った開発で、2026年3月期は不動産商品22件、建築商品4件等を販売し、連結売上高は32,916百万円と前期を上回りました。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の経営成績等の状況の概要とセグメント別の経営成績、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
