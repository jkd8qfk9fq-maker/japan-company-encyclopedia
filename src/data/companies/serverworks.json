  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年4月に中期経営方針（FY26-FY28）を公表し、2023年に締結したAWSとの戦略的協業契約を中心の戦略として、クラウド基盤のコンサルティングと基盤構築・運用、生成AIを活用した新たなサービス展開、セキュリティ領域での付加価値の強化、アライアンスによる海外展開に取り組むとしています。あわせて、マネージドセキュリティサービスや生成AI関連などの戦略領域への進出と、能力の強化を進めるとしています。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "AWSの日本法人が設立される以前のクラウドの黎明期からAWS導入支援を始め、移行のコンサルティングから基盤構築、アプリケーション開発、移行後の運用支援までを一貫して担う体制を持ちます。数多くの導入実績から得た知識を蓄積して社内の技術研修に使い、AWS認定資格を持つ多くのエンジニアを育成しています。",
        "basis": "【事業の内容】の黎明期からの導入支援と一貫したサービス提供、知識の蓄積と技術研修の記載に基づきます。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "国内のクラウド市場が成長を続ける中で、AWSを中核とするクラウド専業のインテグレーターとして事業を行います。事業はクラウド事業の単一セグメントで、2026年2月期の外部顧客への売上高40,006,534千円のうち、リセールが35,877,350千円と大半を占めます。売上高の10％以上を占める主要な顧客はありません。",
        "basis": "【経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析】の市場環境の記載と、セグメント注記の関連情報（製品及びサービスごとの情報、主要な顧客ごとの情報）に基づきます。",
        "asOf": "2026-05-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
