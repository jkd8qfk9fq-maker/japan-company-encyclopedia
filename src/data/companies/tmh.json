  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "半導体製造装置のアフターマーケット分野に注力し、部品販売・修理サービスと装置販売サービスに加えて、半導体製造装置および付帯設備の販売や導入後のメンテナンス等のサービス領域の拡充を目指しています。人材プラットフォーム「LAYLA-HR」を中核に、情報メディアサイト「SEMICON.TODAY」による情報発信を起点として、人材、情報、サービスを横断的に連携させ、トータルソリューション事業の高度化を図る方針です。あわせて、エンジニアをはじめとする人材の確保と育成を重要な課題としています。",
        "asOf": "2026-02-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2024年12月の上場と2025年７月の韓国子会社設立を経て、国内の装置・部品の取引を軸にしながら、海外拠点と人材・情報のサービスを広げる段階にあります。",
        "basis": "沿革における上場と子会社設立の記載、および関係会社の状況に基づく",
        "asOf": "2026-02-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「LAYLA-EC」には世界のサプライヤー200社以上が登録し、36.9万点超のアイテムが掲載され、国内の半導体工場の50％以上が利用しています（2025年11月30日現在）。加えて、20年以上のエンジニアリング経験を持つ技術営業人員が装置の解体から搬出・設置までを一貫して担い、100台以上の装置搬出実績を持ちます。デジタルプラットフォームと人的なエンジニアリング力を組み合わせている点が特徴です。",
        "basis": "事業の内容における「LAYLA-EC」の登録状況とエンジニアリング実績の記載に基づく",
        "asOf": "2026-02-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主な対象は、旧型の設備が多いレガシー半導体工場のアフターマーケットと中古半導体製造装置の市場です。売上高の内訳はアジア向けが中心で、装置販売サービスが大半を占める構成です。",
        "basis": "経営方針における市場環境の記載と、地域ごとの情報およびサービス別の販売実績の構成に基づく",
        "asOf": "2026-02-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
