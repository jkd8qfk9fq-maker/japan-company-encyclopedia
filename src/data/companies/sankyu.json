  "history": [
    {
      "year": 1918,
      "title": "山九運輸として発足",
      "description": "1918年10月、創立者の中村精七郎が磯部組（1917年11月設立、本店は門司市）を買収し、山九運輸㈱と社名を変えて、山陽・北九州の港湾運送を主な業務として発足しました。",
      "significance": "会社の始まりとなる出来事で、港湾運送が出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1949,
      "title": "建設業を開始",
      "description": "1949年10月に建設業を開始し、その後1950年3月に通運事業、1952年7月に貨物自動車運送事業を始めました。",
      "significance": "港湾運送から、建設や陸上輸送へ事業を広げた時期です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1959,
      "title": "山九運輸機工に社名変更し機工部門へ進出",
      "description": "1959年7月に山九運輸機工㈱へ社名を変え、製鉄機械・石油化学装置の据付など、機工・建設部門へ進出しました。",
      "significance": "現在の「物流」と「機工」の二本柱のうち、機工事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京・福岡の証券取引所に上場",
      "description": "1962年3月に東京証券取引所市場第二部に上場し、5月に福岡証券取引所にも上場しました。1966年8月には東京証券取引所市場第一部に上場しています。",
      "significance": "現在の東京・福岡両取引所での上場につながる出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1964,
      "title": "マレーシアに事務所を開設し海外へ進出",
      "description": "1964年4月にマレーシアに現地事務所を開設し、海外建設工事などへ進出しました。1971年のシンガポールを皮切りに、ブラジル、香港、インドネシアなどに現地法人を設立しています。",
      "significance": "海外ネットワークの出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1980,
      "title": "山九株式会社に社名変更",
      "description": "1980年10月、経営の多角化を明確にするため、山九㈱に社名を変更しました。",
      "significance": "現在と同じ社名になった出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
