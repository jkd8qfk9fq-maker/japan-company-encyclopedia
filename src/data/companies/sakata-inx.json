  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2030年を目標とする長期ビジョン『SAKATA INX VISION 2030』のもと、事業拡大・収益力強化に取り組む3年間として策定した中期経営計画2026（CCC-Ⅱ）を進めています。主力のパッケージ分野を中心に、ボタニカルインキシリーズなど環境配慮型製品を軸としたサステナブルな製品の積極展開や、グローバルアカウント向け戦略製品の拡充・拡販、機能性材料の新市場への拡大などに取り組み、計画最終年の2026年12月期は売上高2,700億円を計画しています。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "印刷インキで培った顔料分散などの基盤技術を、インクジェットインキや顔料分散液などの機能性材料に応用・拡大していることが、製品領域を広げる基盤になっています。また、20を超える国と地域に生産・販売拠点を持ち、地域ごとに現地法人が包括的な戦略を立案する体制です。",
        "basis": "セグメント概要に「印刷インキ事業で培われた顔料分散等の基盤技術を応用・拡大したインクジェットインキ、トナー、顔料分散液等」と印字され、経営方針に「20を超える国と地域に展開」と印字されている。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は印刷インキで、地域別では米州が最大のセグメントです。海外の売上が国内を上回る構成で、機能性材料は印刷インキに次ぐ第2の柱として拡大が進められています。",
        "basis": "セグメント注記に2025年12月期の外部顧客への売上高（米州101,117百万円、アジア56,008百万円、日本49,318百万円、欧州20,861百万円、機能性材料20,331百万円、連結売上高257,668百万円）が印字されている。",
        "asOf": "2026-03-23",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
