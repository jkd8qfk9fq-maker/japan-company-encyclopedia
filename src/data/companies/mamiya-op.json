  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として「利益ある成長」「徹底したお客様志向」「独自分野に果敢に挑戦する開拓精神」を掲げ、OEM中心の事業構造を改革し、システムソリューション事業の強化と新規事業領域の開拓・深耕によって持続的な安定成長を目指すとしています。",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の内訳は電子機器事業が15,952百万円、スポーツ事業が4,703百万円、不動産事業が237百万円で、電子機器事業への依存度が高い構成です。会社が掲げるシステムソリューション事業の強化は、電子機器事業の中のソフトウェア・システム開発を担うマミヤITソリューションズ株式会社を中心に進められています。",
        "basis": "セグメント情報（報告セグメントごとの売上高）、事業の内容、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "電子機器の企画・開発・製造・販売・アフターサービスを一貫して担う体制を持ち、ゴルフシャフトでは「LIN-Q」をグローバルブランドとして展開し、バングラデシュと米国の生産・販売拠点を有しています。",
        "basis": "経営方針、経営環境及び対処すべき課題等、事業の内容、MD&Aの経営成績等の状況の概要",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電子機器事業の主要顧客である日本ゲームカード株式会社への売上高は連結売上高の49.2％に達しており、特定の取引先への依存度が高い一方、スマート遊技機の市場導入の進展が周辺機器の需要を支えています。",
        "basis": "事業等のリスク、セグメント情報の主要な顧客ごとの情報、経営方針、経営環境及び対処すべき課題等",
        "asOf": "2026-07-08",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
