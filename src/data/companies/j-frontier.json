  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念に「人と社会を健康に美しく」を掲げ、ヘルスケアテックカンパニーとしてデジタル技術の活用により医療・ヘルスケア領域を革新するとしています。未病・予防から疾病まで人々の「ヘルスケアサイクル」のすべてのアクションが「SOKUYAKU」で完結する「SOKUYAKUヘルスケア経済圏」の創出とサービスの拡充に取り組み、健康食品等の通信販売と医薬品の通信販売では新商品の投入や定期会員へのサービス拡充を通じて安定的な収益基盤を構築するとしています。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の過半を占めるヘルスケアマーケティング事業が前期比で大きく伸びる一方、通販の２事業は前期比で減少しており、グループの収益の重心は法人向けの販促支援・BPOへ移っています。「SOKUYAKU」では前期のシステム利用料の価格改定で利用単価が向上し、法人向けの「SOKUYAKUベネフィット」の導入や旅行会社の修学旅行プランへの組み込みなど、法人領域の収益源づくりが進んでいます。",
        "basis": "セグメント情報等の外部顧客への売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の経営成績の状況の概要に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "広告代理業で培った著名人のキャスティング等の販促ノウハウを、自社ブランド商品の通信販売の拡大と法人向け販促支援の双方に使えることが特徴です。商品の製造はGMP認証を取得したOEM先に委託し、品質管理部が製造工程と品質を監査する体制で、自社で工場を持たずに医薬品・健康食品を展開しています。",
        "basis": "事業の内容、セグメント情報等の外部顧客への売上高に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高では、ヘルスケアマーケティング事業が11,568百万円で売上高の52.0％、ヘルスケアセールス事業が5,383百万円で24.2％、メディカルケアセールス事業が5,283百万円で23.8％を占めています。本邦の外部顧客への売上高が90％を超えるため地域別の売上高は省略されており、売上高の10％以上を占める主要な顧客もありません。",
        "basis": "セグメント情報等の外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報に基づく",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
