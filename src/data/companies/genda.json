  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "Aspiration「世界中の人々の人生をより楽しく」を掲げ、グローバルにエンターテイメントのネットワークを構築し、世の中に流通する「楽しさの総量」を増やすことを目指しています。成長戦略の柱として、M&Aを通じた「連続的な非連続な成長」を定め、2040年には世界一のエンターテイメント企業になることを目指しています。",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "アミューズメント施設の運営で培った知見と、会員数163万人のGiGOアプリを擁する顧客基盤を持ち、M&Aを成長の柱として2026年1月末時点で累計60件の案件を公表してきました。国内419店舗のアミューズメント施設に加え、北米では約10,000箇所のミニロケーションを展開しています。",
        "basis": "2026年1月期の事業の内容、経営方針及びセグメント情報の記載に基づきます。",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年1月期の売上高は170,787百万円で、地域別では日本が135,445百万円、米国が25,290百万円、その他が10,050百万円です。従業員数は2,018人で、連結子会社は45社です。",
        "basis": "2026年1月期の連結経営指標等、セグメント情報及び従業員の状況の記載に基づきます。",
        "asOf": "2026-04-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
