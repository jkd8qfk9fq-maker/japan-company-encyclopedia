  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グローバルニッチトップの複合体を成すことを成長シナリオの主眼とし、中期経営基本方針として、市場開拓による事業規模の拡大、構造改革による収益力の強化、新たなグローバルニッチトップ事業の創出、未来を担う人材の育成、グローバル経営管理体制の強化を掲げています。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上高は、リード端子事業8,802百万円と光部品・デバイス事業8,651百万円がほぼ半分ずつを占める構成です。祖業のリード端子で高付加価値製品の拡販を進める一方、光部品・デバイスでは高純度石英ガラス製品の量産体制の構築など新しい製品分野の育成を進める、2事業を軸にした構成であることがうかがえます。",
        "basis": "セグメント情報等（報告セグメントごとの外部顧客への売上高）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（セグメント別の業績）に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "リード端子では、創業以来すべての製造工程と装置・設備を自社で開発・設計し、溶接・プレス・洗浄・化成の一貫生産により安定した品質を実現しています。光部品・デバイスでは、最深8,000メートルの海底で25年間機能し続けることが求められる海底ケーブル用光アイソレータを中核とし、精密形状石英ガラスの製造技術と精密組立技術を強みとしています。",
        "basis": "事業の内容（各事業の強み）に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "リード端子では、自動車市場（駆動系）やAIサーバー向けで高い市場シェアを占め、アルミ電解コンデンサ市場全体でも相対的に高い市場シェアを持つとされています。光部品・デバイス事業では、主要な顧客であるAlcatel Submarine Networks UK Ltd.とSubCom, LLCの2社で売上高の3割超を占めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等（経営環境）、セグメント情報等の関連情報（主要な顧客ごとの情報）に基づく",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
