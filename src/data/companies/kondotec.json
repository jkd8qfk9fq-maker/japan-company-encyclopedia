  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "長期ビジョンのもと、経営環境の変化に伴うリスクと機会を踏まえて特定したマテリアリティ（重要課題）に対処し、持続的な成長と中長期的な企業価値向上を目指しています。成長戦略として、既存事業を強化するオーガニック成長（新規販売先の開拓、新商材の提供、拠点展開、工事・レンタルなど販売手段やサービスの多様化）、海外市場への展開やデジタル技術の活用による周辺分野の強化、その両方を加速させるM&Aを掲げています。経営基盤の強化では、生産性を高めるデジタル技術の活用と人的資本の強化を進めています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "九州・関東・滋賀・札幌に自社工場を持ち建設金物を自社製造するメーカーの機能と、全国の支店網を通じた販売の両方を備えています。M&Aで取得した子会社が産業資材・電設資材・足場工事の各事業に加わり、取扱分野と販売体制を広げてきました。",
        "basis": "【沿革】の工場開設と子会社取得の記録、【事業の内容】の4部門の分担と主要な会社、【関係会社の状況】の連結子会社11社の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "建設関連資材を中心とする4つの報告セグメントで事業を行っています。2026年3月期の外部顧客への売上高は、産業資材が39,536百万円で全体の約半分を占め、鉄構資材が21,605百万円、電設資材が12,934百万円、足場工事が9,872百万円です。売上高の100分の10以上を占める主要な販売先はありません。",
        "basis": "セグメント情報の外部顧客への売上高と、【関連情報】の主要な顧客ごとの情報（10％以上の販売先なし）の記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
