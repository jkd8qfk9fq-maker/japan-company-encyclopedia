  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "パーパスとして「おいしい！の笑顔をつくる」を掲げ、「不易流行」の考え方のもと「特色経営」を磨く方針です。中期経営計画「Value Innovation 2026（新価値創造）」の最終年度にあたり、冷菓事業では「あずきバー」シリーズの販売強化に向け、付加価値の高い商品開発機能を備えた新工場を本社敷地内に建設し、海外ではアメリカでの現地生産品の販売強化、中国事業会社の販路拡大、マレーシアからのASEAN市場への輸出拡大に取り組む方針です。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は、過去最高の売上本数を記録した「あずきバー」を擁する冷菓カテゴリーと、機能性素材を用いたOEM商品が伸長する調味料事業です。新工場による冷菓の生産能力の増強と、海外の生産・販売拠点の販路拡大を組み合わせる構えです。",
        "basis": "経営方針、経営環境及び対処すべき課題等の中期経営計画と対処すべき課題の記載、MD&Aのセグメント別・カテゴリー別の概況、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1896年の創業以来のあずき加工の蓄積と、「あずきバー」「肉まん・あんまん」等のロングセラー商品のブランドが強みです。製造を担う井村屋株式会社と、調味料と受託加工を担う井村屋フーズ株式会社を中心に、製造から販売までをグループで担う体制があります。",
        "basis": "沿革の創業と主要商品の発売の記載、事業の内容のグループ構成と事業区分、MD&Aの冷菓カテゴリーにおける「あずきバー」シリーズの売上本数の記載",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "食料品メーカーとして、2026年3月期の連結売上高53,723百万円のうち流通事業が48,881百万円、調味料事業が4,605百万円を占めます。販売は食品卸を通じる構成で、最大の顧客である株式会社日本アクセス向けが総販売実績の29.8％を占め、本邦の外部顧客への売上高が連結売上高の90％を超える国内中心の構成です。",
        "basis": "セグメント情報の外部顧客への売上高と主要な顧客ごとの情報、関連情報（地域ごとの情報の省略基準）、MD&Aの相手先別販売実績",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
