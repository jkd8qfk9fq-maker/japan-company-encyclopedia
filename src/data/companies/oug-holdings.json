  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として「水産物をコアとし、お客様に価値ある商品とサービスを提供することにより、食文化の発展に貢献します」を掲げ、生産者から消費者までの水産物流通のトータルシステムである「新しい水産物流通サービス業を創造し、お客様に安全・安心と満足を提供する」ことをグループ経営の基本方針としています。2024年度から2026年度までを対象とする『ＯＵＧグループ中期経営計画2024』の最終年度にあたり、鮮魚事業の強化、商品力の強化、関東マーケットの深耕・拡大、海外事業の拡大、サステナブルな事業活動を事業テーマに取り組んでいます。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "水産物荷受事業は、中央卸売市場を核とする集荷販売機能を持ちます。市場外水産物卸売事業は、全国各地を網羅する販売拠点を活かした幅広い流通網を持ち、世界数十カ国から水産物を輸入しています。養殖、食品加工、物流の事業もあわせ持ち、水産物流通の各段階をグループで担っています。",
        "asOf": "2026-06-23",
