  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中長期経営ビジョン「VISION2026」と2024年度から2026年度までの第2次中期経営計画のもと、受託型のSier向け事業・プライム向け事業と企画型のサービス提供事業の3つの事業スタイルを強化し、エンハンスビジネスで創出した利益を源泉にSIビジネスとデジタルビジネスの領域拡大を進める方針です。売上高構成比はエンハンスビジネス6、SIビジネス3、デジタルビジネス1を目指すとしています。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期は、デジタルビジネスとSIビジネスが受注拡大で増収となる一方、エンハンスビジネスは低収益案件の見直しと他領域へのリソース投入により減収となり、売上高の構成はエンハンスビジネスが約51％、SIビジネスが約42％、デジタルビジネスが約7％でした。会社が目指す構成比に向けて、SIビジネスとデジタルビジネスへの移行が進んでいることがうかがえます。",
        "basis": "セグメント情報等の【関連情報】（製品及びサービスごとの情報、主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1972年の創業以来培ってきたソフトウェアエンジニアリング力を土台に、上流のコンサルティングから開発、運用・保守までをワンストップで担う体制を持ちます。ベトナムと中国の子会社を含むグループの生産体制と、株式会社野村総合研究所や富士通株式会社との長期的な協業関係が受注基盤になっています。",
        "basis": "事業の内容、沿革、関係会社の状況、主要な設備の状況、経営方針、経営環境及び対処すべき課題等に基づく",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "情報サービス産業でDX需要が継続する中、2026年3月期の売上高は18,498百万円でした。販売実績では野村総合研究所グループ向けが総販売実績の48.7％、富士通グループ向けが26.2％を占め、大手SIerとの協業を軸とする受託型の構成になっています。",
        "basis": "事業等のリスク、セグメント情報等の【関連情報】（主要な顧客ごとの情報）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に基づく",
        "asOf": "2026-06-18",
