  "businesses": [
    {
      "id": "link-and-motivation",
      "name": "株式会社リンクアンドモチベーション",
      "description": "東京都中央区銀座に本社を置き、子会社22社と持分法適用関連会社1社の合計24社でグループを構成しています。基幹技術「モチベーションエンジニアリング」を用いて組織と個人の変革を支援し、報告セグメントはマッチングDivision、組織開発Division、個人開発Divisionの3つです。2025年12月期の連結従業員数は1,629人です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【事業の内容】",
      "children": [
        {
          "id": "matching",
          "name": "マッチングDivision",
          "description": "組織と個人をつなぐ機会を提供する部門です。自治体向けに外国語指導助手（ALT）の派遣と英語指導の請負を行うALT配置事業と、社員クチコミの情報プラットフォーム「OpenWork」等を通じて求職者と企業のマッチングを支援する人材紹介事業を行っています。2025年12月期の外部顧客への売上収益は19,022百万円です。",
          "customers": [
            "自治体",
            "求職者",
            "企業"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "organizational-development",
          "name": "組織開発Division",
          "description": "個人から選ばれる組織づくりを支援する部門です。組織課題の診断と採用・育成・制度・風土の変革ソリューションやクラウドサービス「モチベーションクラウド」を提供するコンサル・クラウド事業と、統合報告書等の制作や決算説明会の動画配信等を行うIR支援事業を行っています。2025年12月期の外部顧客への売上収益は16,539百万円です。",
          "customers": [
            "企業"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "individual-development",
          "name": "個人開発Division",
          "description": "組織から選ばれる個人づくりを支援する部門です。パソコンスクール「AVIVA」、資格スクール「DAIEI」、外国語スクール等を運営するキャリアスクール事業と、個別指導学習塾「SS-1」と中高生向け学習塾「モチベーションアカデミア」を運営する学習塾事業を行っています。2025年12月期の外部顧客への売上収益は5,951百万円です。",
          "customers": [
            "大学生・社会人",
            "小・中・高校生"
          ],
          "sourceIds": [
            "yuho-2025"
          ],
          "locator": "【セグメント情報】"
        },
        {
          "id": "other",
          "name": "その他",
          "description": "報告セグメントに含まれない区分で、グループのステークホルダーが集う場としてイタリアンレストランを経営しています。2025年12月期の外部顧客への売上収益は9百万円です。",
          "customers": [
            "レストランの利用客"
