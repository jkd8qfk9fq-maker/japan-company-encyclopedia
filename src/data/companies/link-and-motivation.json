  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「モチベーションエンジニアリングによって、組織と個人に変革の機会を提供し、意味のあふれる社会を実現する」のもと、成長可能性の高い組織開発Divisionのコンサル・クラウド事業に注力し、「モチベーションクラウド」を中心とした収益の安定化・ストック化を進める方針です。既存サービスの対象を国内中堅・中小企業へ広げ、新しい領域のクラウド化も進め、アジア5か国での海外展開も進める方針です。2026年4月には採用支援のクラウドサービス「モチベーションクラウド エントリーマネジメント」をリリースする予定です。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年12月期の売上収益は41,522百万円で前期比10.9％増でした。MD&Aでは、キャリアスクール事業以外の事業が伸長して売上収益が予想を上回り、過去最高の売上収益になったと説明されています。「モチベーションクラウド」が組織開発Divisionの成長を牽引したと説明されています。",
        "basis": "MD&Aの経営成績の概要、セグメント情報（外部顧客への売上収益）、経営方針",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "基幹技術「モチベーションエンジニアリング」は経営学・社会システム論・行動経済学・心理学等の学術的成果を取り入れた技術で、組織の診断と変革をワンストップで支援できる点が特徴です。MD&Aでは、「モチベーションクラウド エンゲージメント」が従業員エンゲージメント市場のベンダー別売上金額及びシェアで9年連続1位を獲得したと説明され、ALT配置事業では民間企業で圧倒的No.1のシェアを確立していると説明されています。",
        "basis": "事業の内容、MD&Aの事業別の概況（コンサル・クラウド事業、ALT配置事業）",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはマッチングDivision（外部顧客への売上収益19,022百万円）、組織開発Division（同16,539百万円）、個人開発Division（同5,951百万円）の3つで、マッチングDivisionが最も大きいです。地域ごとの情報は、本邦の外部顧客への売上収益が大部分を占めるため記載が省略されています。主要な顧客ごとの情報は、売上収益の10％以上を占める相手先がないため記載が省略されています。",
        "basis": "セグメント情報（外部顧客への売上収益、地域ごとの情報、主要な顧客ごとの情報）",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
