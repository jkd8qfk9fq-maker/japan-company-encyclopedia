    "competitiveAdvantage": {
      "disclosed": {
        "text": "会社は店舗の特徴として、人生の節目や大切な記念日に贈るプレゼント選びの場を提供する「アニバーサリーコンセプトショップ」を基本コンセプトとし、高級感を重視した店舗に宝飾品・地金商品とインポートブランド品を豊富に品揃えし、「一流のおもてなし」と「お客様の立場でのご提案」によって喜びや感動を提供できる店づくりを目指していることを挙げています。オリジナルブランド「ｈ＆ｄ」も展開しています。",
        "asOf": "2025-11-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      }
    },
