  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "基本戦略として、データの収集・統合・分析による単価と収益性の向上、歴史の長い産業のデジタル置換による顧客数の増加、金融DX事業における「Project Pax」とトークン化預金関連事業への注力による新規事業開発の、3つの活動に注力するとしています。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "事業の運営を通じて蓄積した査定仲介や見込み顧客のデータ、マーケティング関連のデータを、施策成果の予測や自動最適化に生かしてマッチングの精度を高める体制を持つことが強みです。事業間で共通の基盤をもとに領域ごとに特化させた独自システムで運用を最適化する点も強みです。",
        "basis": "経営方針の「当社グループの強み」における、事業開発全体へのデータの活用と、独自システムを利用したオペレーションの最適化の印字に基づく。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "中古不動産売却、外壁リフォーム、介護という歴史の長い産業領域で消費者と事業者をつなぐマッチングプラットフォームを運営し、参入した市場では事業者向けのツール提供など業務効率化の支援まで広げる事業者です。",
        "basis": "事業の内容における、主力サービス3つの運営と、マッチングプラットフォームとして参入した後に事業者へのツール提供等を通じた業務効率化DXソリューションサービスを提供する方針の印字に基づく。",
        "asOf": "2025-12-22",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
