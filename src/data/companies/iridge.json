  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッション「Tech Tomorrow」のもと、2027年3月期を最終年度とする中期経営計画で「開発力とビジネス創出力という強みを活かした顧客企業のTech & Innovation Partnerへ成長」をテーマに掲げています。成長戦略として、アプリビジネス事業の継続成長（「APPBOX」の生成AI技術の活用を前提とした次世代基盤への刷新を含む）、既存の顧客基盤を活かしたアプリ関連領域以外のデジタル領域への展開と生成AIを活用した新たなDXサービスの提供、株式会社Ｑｏｉｌを中心としたビジネスプロデュース事業領域への進出、人材リソース最適化プラットフォーム「Co-Assign」やリテールメディアなどの新規事業の創出・成長加速、顧客企業とのパートナーシップの強化（共同事業やレベニューシェア型の事業形態への展開を含む）に取り組むとしています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "エンタープライズ企業向けスマートフォンアプリの豊富な企画・開発実績を持ち、アプリデータの収集・分析やデザイン提案から、リリース後の集客・販売促進支援までを統合的に手掛けています。自社ソリューションの導入アプリは累計300アプリを超え、そのMAUは1億ユーザーを超えています。「APPBOX」にはアプリ開発で用いる各種機能群（SDK）が整備されており、従来のスクラッチ開発よりもスピーディーかつ初期コストを抑えたアプリ開発と、容易な機能拡張が可能だと会社は述べています。",
        "basis": "【事業の内容】におけるアプリの企画・開発・運用支援と「FANSHIP」「APPBOX」の記載、及び【経営方針、経営環境及び対処すべき課題等】における導入アプリ数とMAUの記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上の中心はアプリビジネス事業で、2026年3月期の外部顧客への売上高5,296百万円は連結売上高7,084百万円の約4分の3を占めます。当期はディップ株式会社との共同事業などを通じたEX-DX領域の取引が大幅に拡大し、新たな成長ドライバーになったと会社は述べています。ビジネスプロデュース事業がこれに続き、フィンテック事業は2025年7月1日の株式会社フィノバレーの全株式譲渡により撤退しました。",
        "basis": "【セグメント情報等】の外部顧客への売上高の記載と、経営成績等の分析におけるEX-DX領域の取引拡大とフィンテック事業からの撤退の記載に基づきます。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
