  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 2022年10月１日付で普通株式１株につき２株の割合で株式分割を行っている（主要な経営指標等の推移の注記に記載）。"
    ]
  },
  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループスローガンとして「日本の『資産』を未来の力に」を掲げています。事業戦略として、ホテル運営事業の強化（グローバルなラグジュアリーブランドのホテルオペレーターとの協業で培った運営ノウハウの活用と、ホテルオペレーションに特化したアセットマネジメント部署による収益改善）、進捗中の７件のホテル開発プロジェクトの着実な進捗と収益機会の確保、小・中規模ホテル案件の推進、2027年３月期からのソーシング機能の当社への集約を進める方針です。Daiichi Lifeグループとは、ソーシング、ホテル開発、ホテル運営、出口戦略等の各フェーズで協業可能性を幅広く検討していく方針です。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "世界各地で展開するグローバルなラグジュアリーブランドのホテルオペレーターとの協業を通じて培った運営ノウハウを持ちます。また、ホテル竣工後の運営収益に加え、竣工前の開発プロセスにおいても収益機会を創出できる事業モデルで、ソーシング、開発、運営、出口までをグループ内で担います。",
        "basis": "経営方針におけるホテル運営事業の強みと事業モデルの記述、セグメント情報における３事業の外部顧客への売上高に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "外部顧客への売上高の約７割をホテル運営事業が占めます。ホテル業界では訪日外客数が年間過去最高を更新するなどインバウンド需要が活況で、開業２年目を迎えた京都の２ホテルの売上高が堅調に伸長しました。",
        "basis": "セグメント情報における事業別の外部顧客への売上高と、経営者による分析におけるホテル業界と訪日外客数の記述に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
