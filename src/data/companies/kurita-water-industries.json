  "history": [
    {
      "year": 1949,
      "title": "神戸市で設立",
      "description": "水処理薬品の製造販売を目的として、神戸市で栗田工業株式会社が設立されました。",
      "significance": "水処理薬品から始まった、現在の事業の出発点です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1954,
      "title": "水処理装置の製造販売を開始",
      "description": "薬品に加えて、水処理装置の製造販売を始めました。",
      "significance": "薬品だけでなく装置も扱う、今の事業の形につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1962,
      "title": "東京・大阪証券取引所市場第一部に上場",
      "description": "1961年に市場第二部に上場し、1962年に東京・大阪証券取引所の市場第一部へ移りました。",
      "significance": "上場企業として成長する基盤ができました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "建設工事事業から撤退",
      "description": "独占禁止法違反の再発を防ぐため、国や地方公共団体などが発注するすべての建設工事事業から撤退しました。",
      "significance": "事業の範囲を見直した出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2009,
      "title": "クリタ・ケミカル製造を設立",
      "description": "国内の水処理薬品の製造技術やノウハウを集め、品質と生産効率を高めるため、100％子会社を設立しました。",
      "significance": "薬品の国内製造を集約する体制になりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2015,
      "title": "BK Giulini社の薬品事業を買収",
      "description": "BK Giulini GmbHとその関係会社から、水処理薬品事業、紙プロセス薬品事業、アルミナ化合物事業を買収しました。",
      "significance": "海外の薬品事業を取り込みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2017,
      "title": "米国と韓国で買収・連結子会社化",
      "description": "1月に米国のフレモント・インダストリーズ,LLCを買収し、11月に持分法適用関連会社だった韓国の韓水を連結子会社にしました。",
      "significance": "米国と韓国で事業を広げました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2019,
      "title": "米国のU.S.ウォーター・サービス社などを買収",
      "description": "3月に米国の水処理薬品・装置の会社U.S.ウォーター・サービス,Inc.他3社を、5月にRO膜薬品などの会社アビスタ・テクノロジーズ,Inc.を買収しました。",
      "significance": "米国の事業が大きくなりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2020,
      "title": "米国の精密洗浄会社を連結子会社化",
      "description": "4月に米国の精密洗浄会社ペンタゴン・テクノロジーズ・グループ,Inc.他2社を連結子会社にしました。また、U.S.ウォーター・サービス,Inc.はクリタ・アメリカ,Inc.に社名を変えました。",
      "significance": "精密洗浄の分野が加わりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2022,
      "title": "プライム市場へ移行、Kurita Innovation Hubを開設",
      "description": "4月に東京証券取引所の市場区分の見直しでプライム市場に移りました。同月、東京都昭島市に新しい研究開発拠点を開設しました。",
      "significance": "市場区分の変更と、研究開発拠点の移管がありました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2023,
      "title": "アルカデ・エンジニアリングGmbHなどを買収",
      "description": "水処理装置の製造・販売会社であるアルカデ・エンジニアリングGmbH他3社を買収しました。",
      "significance": "欧州の水処理装置の事業を取り込みました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2024,
      "title": "国内の販売会社を2社に再編",
      "description": "4月に、水処理薬品とメンテナンス・サービスを一体で提案するため、国内販売事業会社等11社をクリタ東日本とクリタ西日本の2社に再編しました。",
      "significance": "国内営業を一体化した出来事です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2025,
      "title": "クリタ・アメリカがアビスタ社を吸収合併",
      "description": "4月にクリタ・アメリカ,Inc.がアビスタ・テクノロジーズ,Inc.を吸収合併しました。9月には第3回無担保社債（ブルーボンド）を発行しました。",
      "significance": "米国の事業を統合しました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    }
