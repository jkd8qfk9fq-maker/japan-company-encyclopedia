  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "中期経営計画「TOHO Step Up Plan 2027」（2026年3月期を初年度とする3か年計画）に取り組んでおり、計画期間を「持続可能な成長と価値創造のための変革期」と位置づけています。最重要課題として、電子情報材料事業の拡大・中核事業化、子会社である東邦化学（上海）有限公司を成長軌道に乗せることと海外市場開拓の強化、高機能・高付加価値製品の開発の加速、最適生産体制の構築による生産性改善と業務効率化を掲げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "成長の軸は電子情報産業用の微細加工用樹脂です。2026年3月期はスペシャリティーケミカルが増収して全体の売上を支え、千葉工場では新しい電子情報材料プラントの二期増設工事が進み、2026年11月の完工が予定されています。",
        "basis": "経営方針の対処すべき課題（最重要課題の電子情報材料事業の拡大）、MD&Aのセグメント別経営成績、セグメント情報の外部顧客への売上高、設備の新設等の計画",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1938年の設立以来蓄積した界面活性剤の技術を土台に、香粧原料から電子情報産業用の微細加工用樹脂まで多岐にわたる製品群を持ち、国内の工場と中国・タイの生産拠点で製造する体制が強みです。",
        "basis": "沿革の製造開始・工場新設の記載、事業の内容のグループ構成と製品分野、主要な設備の状況の工場一覧",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の約半分を界面活性剤が占め、スペシャリティーケミカルが約3割を占める構成です。売上高の地域別では日本が中心で、中国とその他の海外向けも販売しています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの売上高、MD&Aの売上構成の記載",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
