  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年４月から中期経営計画（2024年度～2026年度）をスタートさせ、「未来の躍進に繋げる投資」を基本方針として、収益基盤の持続的な強化、持続的な成長戦略の展開、経営基盤の強化の三つの重点施策を掲げています。脱炭素案件の獲得に向けた情報収集と共有を図り、将来的なエネルギー源となる水素・アンモニアに係る防熱技術・工法の開発等を進めるとしています。配当方針については中期経営計画期間中の考え方が示されていますが、その内容は将来に関する事項のため、ここには転記していません。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "コア事業である断熱工事・技術を通じてエネルギーの有効利用に貢献する技術力が、多業種にわたるユーザーから高い信頼を得ているとしています。けい酸カルシウム保温材を製造する日本ケイカル株式会社をはじめ、材料の製造から施工までをグループで担い、アジア地域等の現地法人を含む連結子会社が国内外の工事に対応する体制を取っています。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "当社グループの報告セグメントは建設工事事業とボイラ事業の２つです。2026年３月期の外部顧客への売上高は、建設工事事業が54,145百万円、ボイラ事業が6,154百万円で、建設工事事業が全体の約９割を占めます。施工地別の売上高は日本が56,553百万円、アジアが3,741百万円、その他が4百万円と、日本が大半を占めます。売上高の10％以上を占める主要な顧客はないため、主要な顧客ごとの情報は省略されています。",
        "basis": "セグメント情報等（報告セグメントごとの売上高及び収益の分解情報、主要な顧客ごとの情報）に基づく。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
