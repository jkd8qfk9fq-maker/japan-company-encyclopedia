  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念は「生命と暮らしに寄り添い、地球との共生を実現する。」です。中期経営計画「Act For SMILE COMPASS 2026」（2026年度まで）では、国内の構造改革と日用品のブランド力向上による収益力の強化と、現地法人を通じたアジア市場での展開や輸出事業による海外売上高の拡大を目指します。最終年度の連結売上高の目標は1,700億円で、2025年12月期に1年前倒しで達成しました。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "虫ケア用品ではアースノーマットやごきぶりホイホイ、ブラックキャップ、日用品ではモンダミンやバスロマン、バスクリン、きき湯など、家庭で広く使われるブランドを持ちます。タイやマレーシア、中国、ベトナム、フィリピンにも現地法人を持ち、海外でも虫ケア用品や日用品を製造販売しています。",
        "basis": "有報の事業の内容とMD&Aの記載によります。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2025年12月期の売上高は1,791億82百万円で、家庭用品事業が145,263百万円、総合環境衛生事業が33,918百万円です。地域別では日本が159,511百万円、アジアが18,314百万円です。従業員数は4,963人です。",
        "basis": "有報のセグメント情報と関連情報の記載によります。",
        "asOf": "2026-03-24",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【セグメント情報】"
      }
