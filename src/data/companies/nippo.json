  "history": [
    {
      "year": 1952,
      "title": "日邦産業株式会社を設立",
      "description": "東邦カーボン製造所（後の株式会社レイホー製作所）の販売部門を母体として日邦産業株式会社を設立し、株式会社日立製作所化学製品の特約店となり、各種炭素製品の販売を開始しました。",
      "significance": "現在の会社の始まりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1963,
      "title": "日立化成工業の特約店となり、プラスチック分野に着手",
      "description": "株式会社日立製作所の化学製品事業部が分離独立して日立化成工業株式会社（現、株式会社レゾナック）となったことに伴い、同社の特約店となりました。あわせてプラスチック電材・機械部品の研究開発を行い、ジュラコン・機械部品の販売を開始しました。",
      "significance": "現在のエレクトロニクス事業につながる取扱分野の広がりです。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1968,
      "title": "プラスチック成形工場を一宮市に開設",
      "description": "プラスチック成形工場を愛知県一宮市に開設しました。",
      "significance": "自社で成形品をつくる製造への進出です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1987,
      "title": "タイ・バンコクに海外生産拠点を設立",
      "description": "ユーザーの海外シフトとニーズに対応し、海外生産拠点として、バンコクに現地法人（現、NIPPO MECHATRONICS(THAILAND)CO.,LTD.）を設立しました。",
      "significance": "海外生産の始まりで、同社は現在の連結子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2004,
      "title": "ジャスダック証券取引所に上場",
      "description": "株式会社ジャスダック証券取引所に株式を上場しました。",
      "significance": "株式公開の節目です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2008,
      "title": "株式会社岸田製作所などを取得し、製造機能を強化",
      "description": "半導体製造関連治具の製作販売を推進するため、株式会社岸田製作所（現、日邦メタルテック株式会社）の全株式を取得し、子会社としました。金属加工部品の内製化を推進するため、株式会社京都映工社も子会社としました。",
      "significance": "製造・加工機能の取り込みです。取得した会社は現在の連結子会社につながります。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2013,
      "title": "タイに地域統括会社を設立",
      "description": "当社の海外連結子会社に対する事務、営業及び開発支援サービスの提供を目的として、タイ・バンコクに地域統括会社NIPPO GLOBAL MANAGEMENT CO.,LTD.を設立しました。",
      "significance": "現在のその他区分のマネジメント業務の担い手です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2014,
      "title": "メキシコに合弁会社を設立",
      "description": "メキシコに株式会社富士プレスとの合弁会社FNA MECHATRONICS MEXICO S.A. de C.V.を設立しました。",
      "significance": "北米での生産体制の構築です。同社はその後100％出資子会社となり、現在は清算手続き中です。",
