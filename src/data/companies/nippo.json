  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "お客様のものづくりを支えるテクニカルイノベーターとして、「異色ある価値を提供し、世界をリードするお客様のモノづくりを支えること」を存在目的としています。2024年11月に示した長期経営目標2031では、目指す姿を「異色ある価値の創造で、お客様のものづくりの進化と持続可能な社会の実現を支えるエッセンシャル・カンパニー」とし、メーカー事業の売上高構成比の拡大、新たな事業セグメントであるEcoプロダクツ事業を第4の事業の柱に成長させることなどを掲げています。中期経営計画2025は2026年3月期が最終年度で、次の中期経営計画2028は策定を進めているとされています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "戦略の軸は、商社とファブレスの機能を持つエレクトロニクスを中心としながら、自社製造であるメーカー事業の比重を高め、既存の3セグメントに加わる新しい事業を育てる構成になっています。",
        "basis": "経営方針における存在目的と長期経営目標2031の記載、事業の内容における報告セグメントの説明",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
