  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "宅配拠点において構築した顧客データベースやマーケティングノウハウ等のリソースとシナジー効果のある業務提携、Ｍ＆Ａ、ファンドからの出資等を行うことにより、「誰もがご自宅にいながらにして享受できる、より便利で快適な新しいライフスタイルの創出」に貢献していく「次世代ホームネット戦略」を基本戦略としています。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "１つの拠点に複数のブランドの店舗を併設する複合化により、拠点当たりの売上拡大と出店設備投資の抑制、物件・設備の共有を図る出店戦略を中核に据えています。",
        "basis": "セグメント情報等（単一セグメントのため記載省略）、事業の内容、経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "注文時に登録される顧客情報や注文履歴のデータベースを保有し、顧客ごとの嗜好性や店舗状況を把握・分析して、ダイレクトメールやメールマガジン、公式アプリからのプッシュ通知などOne to Oneマーケティングを行っています。来店を想定しない宅配専業のため物件確保が容易で物件取得費や設備投資が抑えられ、冷凍食材の解凍では宅配寿司業界で独占的に使用可能な高電場解凍機を用いています。",
        "basis": "セグメント情報等（単一セグメントのため記載省略）、事業の内容、経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "宅配食市場では高齢化の進展、単身世帯や夫婦共働き世帯の増加を背景に中食需要が堅調と印字されるなか、チェーン全体で695店舗・352拠点を展開し、タイ王国にも店舗を展開しています。",
        "basis": "セグメント情報等（単一セグメントのため記載省略）、事業の内容、経営方針、経営環境及び対処すべき課題等、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）に基づく",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
