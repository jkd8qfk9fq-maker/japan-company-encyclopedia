  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "開発期間の期限をあえて設けない「品質最優先」の開発を最重要事項とし、20年先・30年先にも残るような価値ある自社IPの創出と、開発中の自社IP新作ゲームアプリの世界同時配信かつ自社配信を前提とした海外市場展開を進めるとしています。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ユーザー動向の分析やKPIの変動要因の把握、新機能の実装後の推移確認を続けるPDCAサイクルと、PC向けゲームやゲームアプリの開発で蓄積したノウハウを基盤に、自社IPのタイトルを長期に運営する力を持っています。",
        "basis": "事業の内容の「当社の特徴及び強み」における、ゲームアプリの長期運営の基盤としてのPDCAサイクルと蓄積したノウハウの活用の印字に基づく。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2024年の世界のモバイルゲーム市場は12兆4,103億円、そのうち日本国内は１兆7,290億円と高い水準で推移しており、主力タイトルの『メメントモリ』は累計400万ダウンロードを超え、『恋庭』はゲーム恋活アプリ利用者数No.1をうたうサービスとして累計300万ダウンロードを超えています。",
        "basis": "MD&Aにおけるモバイルゲーム市場規模の印字と、事業の内容における各サービスの累計ダウンロード数と利用者数No.1の印字に基づく。",
        "asOf": "2025-12-25",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
