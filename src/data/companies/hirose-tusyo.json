  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「金融商品取引を通じて世界中の人々に平等な投資のチャンスを提供する」ため、低価格戦略とフルラインアップ戦略をともに採用し、マーケットリーダーを目指すことを基本方針としています。中長期的には、顧客ニーズの素早い把握と実現、取引システムの安定稼働、ブランディング力の強化、ホワイトラベルの提供などによる収益源の多様化により、安定した収益の確保を図るとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1,000通貨単位からの少額取引を手数料なしで提供する低コストの取引環境、国内外の銀行等金融機関20社以上の中から最良のレートを顧客へ配信する仕組み、外部委託ではなく自社の従業員が担う24時間の顧客サポートが特徴です。",
        "basis": "【事業の内容】に、1,000通貨単位を主とした取引を手数料なしで提供していること、国内外の実績ある銀行等金融機関20社以上と取引を行い最良のレートを顧客へ配信できること、24時間対応の顧客サポートを外部委託ではなく当社従業員にて実施していることが書かれています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
