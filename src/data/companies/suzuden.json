  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「もの造りサポーティングカンパニー」として、もの造りの現場への設備・機器・部品・サービス等の供給とサポートを行い、成長市場と成長分野への経営資源の選択と集中や、通販サイト「FA Ubon」の機能拡充と取扱商品の拡大を進める方針です。",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の大部分を占める電機・電子部品販売事業を中核に、半導体製造装置関連の顧客への経営資源の集中やメディカル市場での提案を掲げており、開示された事業構成と整合しています。",
        "basis": "セグメント情報の外部顧客への売上高、中長期的な会社の経営戦略の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "国内有力メーカーとの代理店・販売店契約に基づく仕入の基盤に加え、大和工場と松本ユーボン工場のもの造り拠点を持ち、オリジナルブランド「Ubon」の商品も展開しています。",
        "basis": "重要な契約等の主な代理店契約、事業の内容、経営方針における商圏・商材の拡大の記載",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "電機・電子部品販売事業が売上高の大部分を占め、製造事業は半導体製造装置向けアルミフレームの組立等を行う小さな事業です。本邦の外部顧客への売上高が90％を超え、主要な顧客は東京エレクトロン宮城株式会社です。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報の地域ごとの情報と主要な顧客ごとの情報",
        "asOf": "2026-06-22",
        "sourceIds": [
          "yuho-2026"
        ]
