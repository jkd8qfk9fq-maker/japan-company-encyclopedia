  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念として顧客第一主義、共存共栄主義、人材育成主義、創造的開拓主義を掲げ、「不動産・債権に関するワンストップサービスの提供」をビジネスモデルとして実践するとしています。サービサー事業では、債権のデューデリジェンス能力や、回収が見込める将来キャッシュ・フローに基づく価格提示力の向上に努め、メガバンクや地域金融機関を中心に債権買取機会の確保に取り組むとしています。あわせて、金融機関が引き続き保有するリスケジュール債権や問題債権について、事業再生等の観点から自社のノウハウや専門家とのネットワークを活用する分野に注力するとしています。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "強みは、司法書士・土地家屋調査士の専門法人を親会社に持つグループ一体の体制にあります。登記や測量の専門機能と債権回収の機能が同じグループ内にそろい、派遣事業を通じてグループ各社の専門業務に対応できる人材を供給しているため、不動産と債権に関わる相談を一か所で受け止める体制ができています。",
        "basis": "【事業の内容】におけるグループ構成と各事業の記載、【経営方針、経営環境及び対処すべき課題等】におけるワンストップサービスの位置づけの記載に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "サービサー法に基づき法務大臣の許可を受けた債権回収会社の一つで、1999年に第20号の許可を受けています。売上高は2021年12月期の2,188百万円から2025年12月期の2,280百万円へ推移し、連結従業員数は231人です。",
        "basis": "【沿革】におけるサービサー法の許可取得の記載と、主要な経営指標等の推移における売上高と従業員数の推移に基づく。",
        "asOf": "2026-03-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
