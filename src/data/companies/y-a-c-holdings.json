  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「より多く社会に貢献する」の実現に向け、2020年に定めた企業理念「究極の理念」のもと、社員への豊かさの供与、納税額の拡大、全員経営・連携と競争、SDGs経営の推進に取り組んでいます。対処すべき課題として、グループ各社間の連携と健全な競争による企業価値の向上、成長の可能性が高い分野への経営資源の重点配分と不採算事業の再構築、シナジー効果を引き出すM&Aの積極的な実施を掲げています。",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度に三和電気計器株式会社と三和テスメックス株式会社を買収して環境・社会インフラ関連事業に編入し、あわせてセグメント構成会社の見直しも行っていることから、M&Aと事業の組み替えによって事業構成を更新していく進め方が当期の動きから読み取れます。",
        "basis": "事業の内容、セグメント情報等（報告セグメントの変更等に関する事項）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（経営成績等の状況の概要）",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "半導体製造装置から医療機器、工業計器・計測器まで幅広い装置技術をグループ内に持ち、製品ごとに専門の子会社が開発・設計・製造・販売・保守サービスまでを担う体制が特徴です。海外にも製造・販売子会社を持ち、現地顧客向けの製造や保守サービスを行っています。",
        "basis": "事業の内容、関係会社の状況",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の構成は、半導体・メカトロニクス関連と環境・社会インフラ関連がそれぞれ4割弱、医療・ヘルスケア関連が約2割です。地域別では日本の売上高が20,161百万円と大半を占め、中国とアジアのその他が続きます。",
        "basis": "セグメント情報等（報告セグメントごとの売上高、関連情報の地域ごとの情報）",
        "asOf": "2026-06-29",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
