  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "放送事業を核とする認定放送持株会社として、2026年3月期より開始した新セグメント体制のもとで重点課題に取り組む方針を示しています。放送関連事業では放送とデジタルの融合を加速させ、システム関連事業では自治体システムの標準化対応やガバメントクラウドへの移行支援のニーズ取り込みと自社製品のストックビジネス化を進め、不動産事業では保有資産の有効活用を図り、ライフスタイル事業ではｅコマースの成長とサーモン陸上養殖のフル稼働体制の早期確立を目指すとしています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "売上高の柱は放送関連事業で、2026年3月期は新設されたライフスタイル事業が加わって売上構成が広がりました。システム関連事業が放送関連事業に次ぐ規模の収益源です。",
        "basis": "セグメント情報における外部顧客への売上高と、経営成績等の分析における事業別の経過及びその成果の説明に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "福岡エリアでテレビ・ラジオ放送を手がける放送局を中核とし、ＪＮＮ・ＪＲＮのネットワーク加盟各社と編成・報道・制作・営業で相互に協力する体制を持ちます。自社制作番組や地域イベントの展開に加え、システム開発や不動産賃貸などの事業をグループ内に持つことで、広告収入以外の収益源を組み合わせています。",
        "basis": "事業の内容、重要な契約等（ネットワーク協定の概略）、セグメント情報に基づきます。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
