  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2024年11月に策定したグループビジョンとして、パーパス「未来を包む - Inclusion for Future -」、ビジョン「循環型社会に最適解を提供する」、バリュー「誠実、挑戦、協創」を掲げ、包装資材分野におけるアジアのリーディングカンパニーを目指すとしています。2028年3月期を最終年度とする第８次中期経営計画『New Challenge 2027』を推進し、パルプモウルド製品では茨城工場の設備増強による供給力の強化と高付加価値製品「パラミル」の市場展開、フィルム製品では特殊フィルムの開発加速と成長市場への参入に取り組むとしています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "紙を原料とする緩衝材（パルプモウルド・段ボール）からフィルム・重包装袋まで、緩衝と包装の両機能を持つ製品群を自社工場とマレーシアの生産子会社で製造する総合力が特徴です。石油由来製品から紙製パッケージへの転換需要が高まる中、環境配慮型製品としてパルプモウルドを位置付け、独自技術による高付加価値製品「パラミル」の展開を進めています。",
        "basis": "事業の内容、セグメント情報の売上高、経営方針・経営環境の記載、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "総合包装資材メーカーとして、緩衝機能材事業と包装機能材事業の2つの報告セグメントが売上高のほぼ半分ずつを占めます。地域別では日本が20,363百万円、アジアが3,000百万円で、マレーシアに紙袋とラミネート製品の生産子会社を持ちます。主要な顧客として株式会社エフピコが両セグメントにわたって開示されています。",
        "basis": "セグメント情報の外部顧客への売上高、地域ごとの情報、主要な顧客ごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
