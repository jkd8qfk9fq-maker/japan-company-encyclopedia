  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として、お客様を原点に変化を先取りして新たな価値を創造し、最適なソリューションと優れたサービスの提供によって企業価値の持続的な向上を実現することを掲げ、ステークホルダーとの「Thinking Together」を事業活動方針としています。対処すべき課題として、生成AI・先端技術を活用した高付加価値サービスの創出、ストック型ビジネスの進化と伴走型支援の拡充、人財の育成、経営基盤の強化に取り組む方針です。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年3月期の売上高は、首都圏が14,854百万円と最大ですが前期に比べて減少し、東日本が8,091百万円、西日本が7,126百万円と伸びて全体の増加を支えました。製品・サービス別では情報関連機器の外部顧客への売上高が最も大きく、次いでシステムソリューション、フィールドサービス、コンポーネント・デバイスの順です。",
        "basis": "セグメント情報のセグメント別売上高、関連情報の製品及びサービスごとの情報、MD&Aの経営成績の概要に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "ITの専門スキルを持つ営業、システムエンジニア、サービスエンジニアの三位一体によるトータルサポート力を強みとして掲げています。富士通とは1963年の電子部品特約店契約、1979年の保守委託契約以来の取引関係があり、現在も富士通グループの取扱製品の販売に関するパートナー契約と保守業務の基本契約を結んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等、沿革の記録、重要な契約等の記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "仕入では富士通グループ3社（富士通株式会社、富士通Japan株式会社、エフサステクノロジーズ株式会社）との取引の割合が大きく、とくにエフサステクノロジーズ株式会社からの仕入高は仕入全体の21.2％を占めています。3社とは取引基本契約等が締結され、取引関係は安定しているとされています。",
        "basis": "事業等のリスクの特定の取引先への依存度についての記載に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
