  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "MISSION「社会の基盤を創り、人と社会の未来と幸福を支える」とVISION「Update The World～変化し、変化させ、必要不可欠なOnly Oneへ」を掲げ、2035年に向けて「規模じゃない、価値で勝つ。業界を代表する企業へ」を目指しています。2026年８月に策定した中期経営計画2030では、基本方針を「インフラテックプラットフォーム」の構築・拡張とし、現場オペレーションの受託とSaaSを組み合わせたBPaaSの拡大を成長エンジンに、対応領域の拡大、BLASの拡販・BPaaS化、全社AXによる経営基盤の変革、ブランディング・マーケティング、M&Aの５つを重点戦略としています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "自社開発の現場作業DXクラウド「BLAS」にAI（画像認識）やRPAを組み合わせ、現場管理・作業・プロジェクト管理の自動化と効率化を進めていることが強みです。国内主要都市の拠点と545社の協力会社ネットワーク「ベイシスパートナーズ」により全国規模の案件に対応できる体制を持ち、モバイル領域では客先常駐型のプロジェクト支援や、通信キャリアを問わない無線機への対応実績を蓄積しています。",
        "basis": "【事業の内容】に、自社開発の「BLAS」とAI・RPAの活用による効率化、拠点と協力会社ネットワークによる全国対応体制、客先常駐型のプロジェクト支援を強みとすること、通信キャリアを問わない無線機への対応実績が印字されています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "IoTエンジニアリングサービスがモバイルエンジニアリングサービスを上回り、最大のサービス区分となりました。通信事業者の５Ｇエリア展開工事の縮小でモバイル領域が減少する一方、労働力不足を背景とした現場の省人化・デジタル化の需要のもとで、スマートメーターや各種IoTデバイスの設置案件がIoT領域の成長を牽引しています。主要顧客への売上集中があり、ソフトバンク株式会社が売上高の18.2％を占めています。",
        "basis": "【セグメント情報】の【関連情報】に、IoTエンジニアリングサービスの外部顧客への売上高3,742百万円、モバイルエンジニアリングサービスの3,252百万円、主要な顧客ごとの情報としてソフトバンク株式会社の売上高割合18.2％が印字されています。経営成績の分析には、５Ｇエリア展開工事の縮小とIoTデバイス設置案件の拡大が印字されています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
