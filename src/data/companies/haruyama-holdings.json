  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「お客様第一主義」を経営の基本方針とし、創業理念である「より良いものをより安く」の実現に向けて高機能・高品質の商品の企画に努めています。「地域に必要とされる店に」なることを経営ビジョンとし、商品・サービスの品質向上、集客力の強化、生産性の向上を基本戦略としています。",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2026年3月31日現在で363店舗を展開し、郊外型店舗と都市型店舗の両形態でチェーン展開を行っています。機能性オフィスカジュアル商品やレディス向け商品の拡充に加え、疲労回復ウェア「YOKUNERU」の発売や、健康衣料を中心とした店舗「DRUG WEAR」のオープンなど、新しい商品と店舗にも取り組んでいます。",
        "basis": "事業の内容、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析の概要、事業等のリスクの店舗展開の記載",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは衣料品販売事業のみです。単一の製品・サービスの区分の外部顧客への売上高が連結売上高の90％を超え、本邦の外部顧客への売上高も連結売上高の90％を超えています。外部顧客への売上高のうち、連結売上高の10％以上を占める顧客はありません。",
        "basis": "セグメント情報等の関連情報、販売実績の記載",
        "asOf": "2026-06-26",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
