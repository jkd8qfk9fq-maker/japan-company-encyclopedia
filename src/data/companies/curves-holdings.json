  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "会社は、健康寿命の延伸に貢献する「地域密着の健康インフラ」として成長することを掲げ、2025年8月期本決算で発表した中期ビジョンでは、2030年8月期に店舗数2,600店舗、会員数120万人をコミットターゲットとしています。当面の課題として、顧客満足度の向上、マーケティング強化による会員数の拡大、商品開発と物販の拡大、メンズ・カーブスやピント・アップを含めた店舗網拡大を挙げています。",
        "asOf": "2025-11-21",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年8月期は、会員数が前期末の81.7万名から86.3万名へ増え、国内店舗数は1,996店舗になりました。MD&Aでは、年3回の新規入会募集キャンペーンと、テレビやウェブを中心とした広告、口コミや地域に密着した取り組みにより新規入会が増えたこと、会員向け物販売上高が過去最高になったことが説明されています。",
        "basis": "MD&Aの経営成績等の状況の概要、事業の内容",
        "asOf": "2025-11-21",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "女性だけの30分という分かりやすい形の運動の場を、フランチャイズ店舗1,914店舗と直営店舗82店舗の店舗網で提供しています。会員向け物販では定期便契約者数が過去最高になったことが説明され、店舗での運動と自宅での食生活の両面で会員と接点を持っています。",
        "basis": "事業の内容、MD&Aの経営成績等の状況の概要、セグメント情報の関連情報（製品及びサービスごとの情報）",
        "asOf": "2025-11-21",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "事業はカーブス事業の単一セグメントで、外部顧客への売上高の内訳はショッピング売上23,080百万円、フランチャイズ関連売上等14,485百万円です。地域ごとの情報では、本邦の外部顧客への売上高が全体の90%を超えるため記載が省略されています。欧州では2025年6月末時点で124店舗を展開しています。",
        "basis": "セグメント情報の関連情報（製品及びサービスごとの情報、地域ごとの情報）、事業の内容",
        "asOf": "2025-11-21",
