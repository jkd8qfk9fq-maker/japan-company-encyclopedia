  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「優秀な製品による社会への貢献」のもと、高性能・高品質の製品を開発し、国内外の顧客に供給することによって豊かな社会作りに貢献するとともに、会社の限りない繁栄を実現することを経営の基本方針としています。2026年３月期を初年度とする中期経営計画では『飛躍、そして次の時代へ』をテーマに、「企業価値の向上」「成長戦略の推進と有効投資」「収益性の更なる向上」「サステナビリティ経営の実践」の各施策に取り組んでいます。当期は棚卸資産の適正化を最優先課題とし、海外事業ポートフォリオの健全化に向けたイタリア子会社への増資や中国事業の見直し、インド企業との合弁会社の設立・操業開始の準備を進めました。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1935年の創業以来、モビールクレーンに始まり、油圧式トラッククレーン、全油圧式パワーショベル、ラフテレーンクレーン、オールテレーンクレーンと、クレーンとショベルの開発・生産の技術と経験を蓄積してきたことが強みです。茨城・群馬・坂東の国内工場とイタリア・オランダ等の海外拠点を持ち、地域ごとの市場ニーズを反映した製造・販売体制を備えています。",
        "basis": "【沿革】における製品開発の歩み、【事業の内容】及び【主要な設備の状況】における国内外の製造・販売体制の記載に基づく",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは地域別の日本・欧州・その他の３つで、2026年３月期の外部顧客への売上高は日本50,831百万円、欧州4,374百万円、その他1,129百万円です。製品及びサービスごとでは建設用クレーン38,849百万円、油圧ショベル等16,265百万円、その他1,220百万円です。顧客の所在地を基礎とした地域別の売上高は、日本44,246百万円、欧州4,304百万円、その他の地域7,783百万円です。売上高の10％以上を占める主要な顧客はありません。",
        "basis": "【セグメント情報等】の報告セグメントごとの売上高、製品及びサービスごとの情報、地域ごとの情報及び主要な顧客ごとの情報の記載に基づく",
        "asOf": "2026-06-24",
