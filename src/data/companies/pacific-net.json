  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「企業のIT支援を通し、『人々』『社会』を幸せにしたい」のもと、IT機器の導入から処分までをワンストップで支援するLCMサービスを中核事業として展開し、重点課題として、ストック収益の拡大、LCMサービスの推進、資産効率・収益性の向上、人的資本経営の推進、成長機会に備えたインフラの整備とDX推進に取り組むとしています。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "サブスクリプション型のサービスが事業の大部分を占め、長期のレンタル契約が積み上がることで、継続的な収益の土台が厚くなっていく構造です。",
        "basis": "事業の内容でサブスクリプション型サービスが大部分を占めると印字されていることと、経営成績等の分析で長期サブスクリプションの稼働が堅調でストック売上が積み上がっていると印字されていることによる。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "IT機器の調達・導入から運用管理、使用後の回収・データ消去、リユースまでを一貫して引き受けられるため、顧客は機器のライフサイクル全体を一社に任せることができます。",
        "basis": "事業の内容におけるITサブスクリプション事業とITAD事業の記述と、経営方針におけるLCMサービスの説明による。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "IT機器のライフサイクル全体を支援するLCMサービスを中核事業として展開する上場企業としての独自のポジションを掲げています。傘下の株式会社ケンネットは、国内の旅行関連市場でガイドレシーバーのシェア90％以上を持っています。",
        "basis": "経営方針、経営環境及び対処すべき課題等における独自のポジションの記述と、事業の内容におけるケンネットのシェアの記述による。",
        "asOf": "2026-08-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
