  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 新規事業の開始: 家事代行サービス「saikou!」の提供を2026年4月に東京・大阪・京都で開始しました（有報の【沿革】に記載）。これは決算日（2026年3月31日）後の開始であり、本登録の事業構成の記載は2026年3月31日現在のセグメント構成に基づいています。"
    ]
  },
  "updatedAt": "2026-11-09",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念『大切な3つの“Standard”』と長期ビジョン『ホーローと共に、光り輝く魅力ある企業へ』を掲げています。2024年度を初年度とする3ヵ年計画「中期経営計画2026」では「変革への再挑戦」をテーマに、収益構造改革・財務戦略・サステナビリティ戦略の3つを成長戦略の柱とし、2027年3月期の売上高2,500億円、2031年3月期の売上高2,700億円を目標としています。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "独自のホーロー技術を核とし、ホーローの釉薬の主原料であるフリットの製造から、キッチン・浴室などの製品の製造までをグループで手がけている点が特徴です。",
        "basis": "【事業の内容】の製品部門表にフリットや薄板鋼板ホーローが印字され、【研究開発活動】に「独自のホーロー技術を核とした高付加価値商品の開発」と印字されていることによる。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高のほとんどを住宅設備関連事業が占め、製品部門別ではキッチンが最大です。国内の外部顧客への売上高が連結売上高の90％を超えており、事業の中心は国内です。",
        "basis": "セグメント情報の外部顧客への売上高（2026年3月期: 住宅設備関連252,493百万円・その他262百万円）、MD&Aの製品部門別販売実績（キッチン154,762百万円が最大）、【関連情報】の地域ごとの情報に「本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超える」と印字されていることによる。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
