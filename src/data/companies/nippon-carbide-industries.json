  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ミッションは「技術力で価値を創造し、より豊かな社会の発展に貢献する。」であり、「キラリと光る、価値ある企業グループ」となることを目指しています。新中期経営計画「NCIキラリ 2nd STAGE 2030」では、2030年のありたい姿を「サステナブルな社会に貢献する、キラリと光る企業グループ」とし、エレクトロニクスとセーフティを注力領域として、One & Onlyの製品と技術を軸に事業拡大を進めるとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "新中期経営計画では成長ドライバーをOne & Onlyの製品と技術に改めて着目して再定義し、各セグメントで強みを軸に事業拡大を進める方針です。電子・機能製品では医薬品・農薬向けや半導体向けの出荷増と製品価格の改定が進み、フィルム・シート製品では米国での自動車向け3Dエンブレムやブラジルでの二輪車関連製品など海外拡販が進んでいます。",
        "basis": "経営方針、経営環境及び対処すべき課題等（中長期的な会社の経営戦略）、MD&Aのセグメントごとの経営成績",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "1935年の創業以来の化学技術を基盤に、再帰反射シートやセラミック基板、半導体用金型クリーニング材など、他社にない製品（One & Onlyの製品・技術）を持つことが特徴です。タイ、ベトナム、インド、インドネシア、ブラジルに生産子会社、米国や欧州に販売子会社を持ち、海外で製造販売する体制を整えています。",
        "basis": "事業の内容、沿革、経営方針、経営環境及び対処すべき課題等",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは電子・機能製品、フィルム・シート製品、建材関連、エンジニアリングの４つで、外部顧客への売上高はフィルム・シート製品が22,395百万円と最大です。地域ごとの売上高は日本が23,205百万円、アジアが16,531百万円（うち中国が5,996百万円）、その他が10,172百万円で、海外売上が過半を占めます。連結売上高の10％以上を占める主要な顧客はないと印字されています。",
        "basis": "セグメント情報（報告セグメントごとの売上高、地域ごとの情報、主要な顧客ごとの情報）、MD&Aの経営成績の概要",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
