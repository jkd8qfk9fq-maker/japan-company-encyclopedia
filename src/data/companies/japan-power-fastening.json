  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「日本で最大の総合ファスニングメーカーを目指す」ことを企業目標に掲げ、建築・土木市場を成長分野と捉えて製品開発・改良及び用途開発の強化と販売拡大に努め、生産及び物流体制の合理化や品質管理体制の強化を図る方針です。中期経営計画「Next Challenge 2027」を策定し、業績回復に取り組んでいます。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "豊岡工場でねじの一貫生産を行い、六価クロムを含まず耐食性に優れた独自の表面処理技術「サスガード」「エフガード」を持つなど、長年培ったファスニング技術が強みです。",
        "basis": "沿革に1989年９月に（新）豊岡工場が完成しねじの一貫生産を開始したと印字され、サステナビリティに関する取組に、有害物質である六価クロムを含まず耐食性に優れた当社独自の表面処理技術（クロムフリー）である「サスガード」「エフガード」を推奨していると印字されているため。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上は国内が中心で、住宅市場と一般建築市場の双方に販売しています。主要な顧客である積水ハウス株式会社向けの販売が総販売実績の26.6％を占めるなど、大手住宅メーカーとの取引が大きい位置にあります。",
        "basis": "セグメント情報の関連情報に、本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えると印字され、経営者による分析に、積水ハウス株式会社向けの販売が総販売実績の26.6％を占めると印字されているため。",
        "asOf": "2026-03-26",
        "sourceIds": [
          "yuho-2025"
        ]
      }
