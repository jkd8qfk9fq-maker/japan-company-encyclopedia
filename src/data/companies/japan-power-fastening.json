  "history": [
    {
      "year": 1964,
      "title": "日本シェークプルーフ株式会社を設立",
      "description": "新和工業株式会社、日本発条株式会社と米国のイリノイ・ツール・ワークス社の３社が出資し、業界最初の日米合弁会社である日本シェークプルーフ株式会社を滋賀県野洲郡中主町（現・野洲市）に設立しました。",
      "significance": "実質上の存続会社の創業で、現在の事業の起源です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1966,
      "title": "イリノイ・ツール・ワークス社と技術援助契約を締結",
      "description": "米国のイリノイ・ツール・ワークス社と、特許品「テクス」の導入に関する技術援助契約を結びました。",
      "significance": "ファスニング技術の基盤が導入されました。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1969,
      "title": "豊岡工場を建設",
      "description": "兵庫県豊岡市の誘致を受けて豊岡工場を建設し、操業を開始しました。",
      "significance": "現在の主力生産拠点の始まりです。",
      "sourceIds": [
