    {
      "year": 1979,
      "title": "ニスコ株式会社に商号変更",
      "description": "商号をニスコ株式会社に変更しました。",
      "significance": "後の商号変更につながる節目です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
