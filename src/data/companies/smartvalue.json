  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営の基本方針として、「スマート＆テクノロジーで歴史に残る社会システムを創る！」を標榜し、事業成長を図りつつ競合他社との差別化に注力するとともに、企業価値を継続的に拡大させる方針としています。中長期の方針として「Moonshot Vision 2028」を定め、既存クラウドサービスの拡充を図りつつ、リアルなまちをデジタルとコミュニティのチカラで未来の社会システム（スマートシティ）の創造を目指すとしています。モビリティ・サービスではクラウドサービスの充実を通じた月次経常収益の積み上げを、スマートベニューではGLION ARENA KOBEの貸館事業の稼働とパートナーアクティベーション契約の拡大を重要な指標として掲げています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "モビリティ・サービスでは、テレマティクスサービスの実績とノウハウを活かしたプラットフォームを展開し、「Kuruma Base」の契約管理台数は建機レンタルの無人化による契約増を背景に1,000台を達成しました。スマートベニューでは、民間事業者による事例の少ないベニュー事業において、GLION ARENA KOBEの開業初年度から運営ノウハウを蓄積し、連結子会社の神戸ストークスがB2リーグで優勝して観客動員を大きく伸ばしました。連結子会社のノースディテールは、まちづくりICT基盤の構築を担うソフトウェア開発の要としてグループ内に抱えています。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高は2022年６月期の3,805百万円から2024年６月期の3,814百万円まで横ばいで推移した後、2025年６月期に4,361百万円、2026年６月期に5,864百万円と拡大しました。2026年６月期の売上高は前期比34.4％の増加であり、外部顧客への売上高の約８割を、GLION ARENA KOBEが開業したスマートベニューが占める構成へと移行しています。",
        "basis": "経営指標等の推移に印字された売上高、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に印字された売上高の増減率、セグメント情報に印字された外部顧客への売上高に基づきます。",
        "asOf": "2026-09-28",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
