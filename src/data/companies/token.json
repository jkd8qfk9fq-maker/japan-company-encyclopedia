    {
      "year": 2005,
      "title": "ナスステンレスを子会社化",
      "description": "東建リーバが株式を取得して子会社にしました。現在のナスラックで、建設資材や住設機器を供給しています。",
      "significance": "建設に使う資材を自社グループで調達する体制につながりました。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 2006,
      "title": "東建ビル管理を設立",
      "description": "名古屋市中区に設立しました。オーナーとのマスターリース契約に基づく賃貸と管理を担います。",
      "significance": "不動産賃貸事業の中心となる子会社です。",
      "sourceIds": [
        "yuho-2026"
      ],
      "locator": "【沿革】"
