  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "肝炎関連の受託試験サービスが減少するなか、市場規模の大きい安全性等分野でのPXBマウスとPXB-cellsの普及に努め、製品販売に重点を置く方針としています。あわせて、in vitro分野への展開としてPXB-cellsの関連製品の市場投入や生体模倣システム等の新規技術の研究開発を強化し、核酸医薬や遺伝子治療、代謝機能障害関連脂肪性肝疾患などの新しい市場を取り込むとしています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "マウスの肝臓の70％以上がヒト肝細胞に置き換わった状態を維持できる実験動物を、年間4,000匹以上コンスタントに生産できる点に特徴があります。同じドナーの肝細胞を持つマウスで実験を繰り返せることや、PXBマウスから採取したヒト肝細胞を凍結せず新鮮なまま提供できることも強みです。",
        "basis": "【事業の内容】に、PXBマウスはマウス肝細胞の70％以上がヒト肝細胞に置換され、当社グループでは年間4,000匹以上のPXBマウスをコンスタントに生産していること、PXB-cellsは非凍結のまま新鮮な状態で提供が可能であることが印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "売上高の中心は米国市場で、2026年3月期の地域別の売上高は米国が853百万円と全体の過半を占めています。また、主要な顧客であるAlnylam Pharmaceuticals, Inc.への売上高は591百万円で、売上高全体の37.8％を占めています。",
        "basis": "【セグメント情報等】の地域ごとの情報に、2026年3月期の売上高は日本423百万円、米国853百万円、欧州193百万円、その他94百万円と印字され、主要な顧客ごとの情報にAlnylam Pharmaceuticals, Inc.への売上高591,747千円と印字されています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
