  "updatedAt": "2026-11-21",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "企業理念「医科学の研究成果を事業化し、人々の健康で安全な生活の実現に寄与する」のもと、大学発のバイオマーカー技術に基づくエビデンスの構築と活用を進め、医療DXを活用した総合ヘルスケアプラットフォームを構築して予防から治療までのサービスを提供し、セルフメディケーション社会の構築に寄与することで、事業の拡大を図るとしています。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "当連結会計年度は、中国での化粧品事業から撤退し、国内の化粧品事業と機能性素材開発事業を日本予防医薬株式会社へ集約する構造改革を進めています。2027年６月期からは報告セグメントを３区分に変更して医療DXを活用したヘルスケアプラットフォーム事業を本格展開し、中国・ASEAN市場を対象とした健康補助食品や機能性素材の海外展開と現地企業向けOEM事業を推進する方針が示されています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、関係会社の状況、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "大阪大学発のバイオベンチャーとして、疲労を定量化するバイオマーカー技術をはじめとする大学の研究成果を事業化してきた実績があります。疲労プロジェクトから生まれた「イミダペプチド」は、機能性表示食品制度で疲労感の軽減を表示できる製品となっており、特定保健指導では生活習慣病の専門医から成る一般社団法人専門医ヘルスケアネットワークと共同で事業を展開しています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、関係会社の状況、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "高齢化と医療費の増加を背景に、科学的根拠に基づく評価・介入を支える社会のEBM（科学的根拠に基づく医療）の重要性が高まり、健康保険組合のデータヘルス計画の推進や機能性表示食品制度の信頼性向上が進む事業環境にあります。2026年６月期は健康補助食品事業が最大の事業であり、主要な顧客である高浪控股股份有限公司への売上高が連結売上高の17.0％を占めています。",
        "basis": "セグメント情報等の外部顧客への売上高、事業の内容、関係会社の状況、主要な顧客ごとの情報、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析による。",
        "asOf": "2026-09-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
