  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営理念「HAPPY FOR ALL」の下、ECモール事業、プラットフォーム事業、ブランド事業を運営し、認知度の向上を通じた国内の衣料・服装雑貨等のEC化率の拡大と、M&A等による新規・既存事業への積極的な投資により、企業価値の向上を目指すとしています。目標とする経営指標として、商品取扱高（返品後）を重視するとしています。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "3事業は相互補完の構造にあり、ECモールのために行ったECシステムや物流インフラの改善はプラットフォーム事業の各サービスへ自動的に反映され、プラットフォーム側での在庫の共通化はECモールで販売できる商品を広げます。M&Aによる多モール展開と、ブランドM&Aのための中間持株会社ANBUR LEAGUEの設立により、M&Aによる成長と既存基盤の活用を組み合わせています。",
        "basis": "事業の内容（ECモール事業とプラットフォーム事業の相互補完性）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（MD&A）の概況に基づく。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "7つのECモールの裏側にあるITインフラと物流インフラを一元化し、複数のモールを効率的に運営できる点が強みです。プラットフォーム事業では、自社公式EC支援、倉庫受託、店舗POS、店舗の欠品フォロー、基幹システムまでを一括で受託でき、倉庫受託では百貨店や卸への出荷にも対応できる体制を持ちます。M&A後の統合を自社プラットフォームの活用を軸に速やかに実行する進め方も特徴です。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（MD&A）の概況、事業の内容（プラットフォーム事業の各サービス）に基づく。",
        "asOf": "2026-05-27",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "ファッションEC市場は拡大が続いており、国内の衣料品等のEC化率は23.4％（経済産業省調べとして経営方針に引用）と、諸外国と比較して低い水準にあると会社は認識しています。同社は靴を中心とするファッションECで7つのモールを展開し、2026年2月期の出店ブランド数は5,049でした。売上高19,441百万円のうち、一般消費者向けのECモール事業とブランド事業が大半を占めます。",
        "basis": "経営方針、経営環境及び対処すべき課題等（EC化率の引用）、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析（MD&A）の概況、セグメント情報等の関連情報（製品及びサービスごとの情報）に基づく。",
        "asOf": "2026-05-27",
