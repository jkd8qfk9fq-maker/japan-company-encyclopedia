  "status": {
    "state": "needs-attention",
    "notes": [
      "businessModel: 重要な後発事象: 連結子会社の株式会社コシダカSPは、2025年9月12日の決議と契約締結により、株式会社スタンダードが運営するカラオケボックス・複合カフェ・飲食店（約70店舗、「JOYSOUND」ブランド）の事業を吸収分割により承継し、2025年11月1日に効力が発生した。承継したコシダカSPは株式会社スタンダードに商号を変更している。登録は2025年8月31日現在のグループ構成（連結子会社8社）に基づく。"
    ]
  },
  "updatedAt": "2026-11-27",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2019年9月から取り組む中期経営ビジョン「エンタメをインフラに」（EIP）について、最終目標の達成時期を2027年8月期と定め、仕上げの時期（EIPファイナルステージ）と位置付けています。重点課題は、店舗網の拡充とカラオケルーム数の拡大、各種エンターテインメントの提供、高度人財の採用と組織体制づくりです。施策として、出店ペースの加速と既存店のリロケーションによる大型化・効率化、エンタメプラットフォーム「E-bo」の全店導入などによる、カラオケルームで楽しめるエンターテインメントの拡充、新人事制度WIP（Koshidaka Workstyle Innovation Plan）の推進を掲げています。",
        "asOf": "2025-11-28",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "居抜き出店を基本の出店形態として店舗網を広げ、国内703店舗の直営カラオケ店舗網を持ちます（2025年8月31日現在）。「カラオケまねきねこ」と一人カラオケ専門店「ワンカラ」の2つのブランドを展開し、カラオケルームでカラオケ以外の楽しみ方も提供する取り組みや、エンタメボックス「E-bo」の導入を進めています。",
        "basis": "【沿革】の居抜き出店の開始、【事業の内容】のブランド展開、経営成績等の状況の分析における店舗数と「E-bo」導入の記載に基づきます。",
        "asOf": "2025-11-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントはカラオケ、不動産管理、その他事業の3区分で、2025年8月期の外部顧客への売上高はカラオケ671億62百万円、不動産管理13億45百万円、その他事業8億79百万円と、カラオケが全体の大半を占めます。海外では韓国、マレーシア、タイ、インドネシアの4か国に25店舗を展開しています。本邦の外部顧客への売上高が全体の90％を超えるため地域ごとの情報の開示は省略され、売上高の10％以上を占める特定の顧客もありません。",
        "basis": "セグメント情報等の外部顧客への売上高と関連情報（製品及びサービスごとの情報・地域ごとの情報・主要な顧客ごとの情報）、経営成績等の状況の分析における店舗数の記載に基づきます。",
        "asOf": "2025-11-28",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
