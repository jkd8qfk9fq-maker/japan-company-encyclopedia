  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年4月1日に制定した「Mission・Vision・Values」のもと、Missionに「先端微細加工技術で革新的な未来を描く」、Visionに「常に選ばれる存在へ」を掲げています。対処すべき課題として、フォトマスク事業の拡大（米国や中国を除くアジアでの生産能力の拡大、EUVマスクでの先行）、レガシー領域の戦略的強化、8つの製造拠点があたかも1つの工場として機能するバーチャル「1」工場化、ナノインプリント技術を応用した新事業開拓（ARグラス用Waveguide用モールドなど）を挙げています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "材料ベンダーと共同で先端マスクブランクスを開発し、生産プロセスを最適化していること、先端からレガシーまで一つの半導体デバイスに必要なマスクをセット単位で対応できる設備群とレガシー設備の延命ノウハウを持つこと、工場や設備が異なっても同じ仕上がりになるデータマッチング技術で複数拠点の認定を短期間に取得し、短納期で供給できることを強みとしています。IBM社とは2nm半導体向けEUVマスクのプロセス共同開発契約を締結しています。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "2024年において、半導体向け外販フォトマスク市場におけるシェア37.8％というトップの位置にあります（出典 SEMI「2024 PHOTOMASK CHARACTERIZATION STUDY」）。",
        "asOf": "2026-06-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【事業の内容】"
