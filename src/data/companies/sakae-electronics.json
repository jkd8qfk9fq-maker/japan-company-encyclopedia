  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年３月期から2028年３月期を対象とする中期経営計画を策定し、基本方針として「資本コストを意識した経営により企業価値を高める」ことを掲げています。重点施策として、新規顧客および新規分野の開拓による収益基盤の拡大、社会インフラ・重電分野などへの展開による事業領域の拡充、東アジアを中心とした海外展開の推進、DX推進による業務効率化などを挙げています。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月に設立した台湾の現地法人をアジアにおける販売・調達のネットワーク拠点と位置づけており、主力の半導体製造装置関連市場への依存による業績変動への対応として、顧客と事業領域の拡大で収益源の多様化を進める構成です。",
        "basis": "経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析に記載された台湾現地法人の位置づけと、経営方針に記載された優先的に対処すべき課題に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "TDKや山一電機といった電子部品メーカーとの特約店契約や海外メーカーとの販売代理店契約に基づく仕入れの枠組みと、本社のほか国内各地の営業所網を通じて顧客に販売する体制が特徴です。",
        "basis": "重要な契約等に記載された特約店契約・販売代理店契約と、主要な設備の状況に記載された営業所網に基づく",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
