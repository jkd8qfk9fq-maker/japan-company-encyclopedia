  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営方針として「IT技術教育（人材育成）によりビジネスを創造し、社会の発展に貢献する」ことを掲げ、採用力とIT技術教育によりIT人材を創出して顧客のITプロジェクトを支援するとしています。また、「みどりクラウド」をはじめとした独自商品サービスや新商品を開発・展開し、DX領域で社会課題を解決するITビジネスを展開するとしています。対処すべき課題として、優秀な人材の確保・育成、プロジェクトマネジャーの育成、営業の強化、新規事業の開発と拡大を挙げています。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2025年8月期の売上高は前期比11.5％増の24,776百万円でした。デジタルインテグレーション事業が前期比11.9％増、機械設計エンジニアリング事業が同5.5％増と伸びた一方、みどりクラウド事業は同1.3％減でした。",
        "basis": "セグメント情報における報告セグメントごとの外部顧客への売上高と、経営者による財政状態、経営成績及びキャッシュ・フローの状況の分析におけるセグメント別の概況の記載に基づきます。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "IT業界未経験者を中心に採用し、独自の教育プログラムにより入社から1か月から2か月でITエンジニアとしての就業を可能にする「教育型人材創出モデル」を持っています。経験の浅いエンジニアを運用担当として供給し、スキルに応じてソリューション案件やチームのリーダー、人材育成担当へ段階的に移す体制で、教育内容は「セラク情熱大学」として蓄積・提供されています。",
        "basis": "事業の内容における教育型人材創出モデルの特徴の記載に基づきます。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主要な顧客ごとの情報では、外部顧客への売上高のうち連結売上高の10％以上を占める相手先はないと開示されています。売上高の大半はデジタルインテグレーション事業が占め、みどりクラウド事業と機械設計エンジニアリング事業の規模は小さい構成です。",
        "basis": "セグメント情報の関連情報における主要な顧客ごとの情報と、報告セグメントごとの外部顧客への売上高の記載に基づきます。",
        "asOf": "2025-11-20",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    }
  },
