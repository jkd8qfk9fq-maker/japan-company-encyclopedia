  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-19",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "「日本の伸びしろを、花ひらかせる」を掲げ、共働き家族・子育て家族のための総合ソリューションカンパニーとして、中核の保育サービス事業では乳幼児教育プログラム「CLiP」により子どもたちの成長をサポートし、在園児保護者限定の子育て支援・コミュニティアプリ「さくらさくパーク」の本格始動などICT化を推進した子育て支援サービスの充実を図ることで、保育サービスの付加価値向上を推進していくことを掲げています。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年7月期は、2026年4月に大阪市認可保育所を1施設開設し、東京都認可保育所を1施設増床して、運営施設は89施設になりました。売上高は前期比4.3％減の17,593百万円で、前期に大型の販売用不動産の売却があったことによるもので、保育サービス自体は保育補助金の増額などにより増収だったと説明されています。",
        "basis": "MD&Aの経営成績の概況における新規開園・増床と売上高の増減説明、セグメント関連情報の製品及びサービスごとの情報に基づく。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「おうちのようなほいくえん」づくりをコンセプトに、職員の教育研修に力を入れることで保育の質を支えています。あわせて、様々な不動産情報を収集し、蓄積された保育ノウハウを施設整備に活かした保育所開発を行い、駅からの距離や利便性の高いエリアにこだわった立地で、ソフトとハードの両輪を見据えて事業を展開している点が特徴です。",
        "basis": "事業の内容における保育のコンセプトと職員の教育研修、保育所開発と立地の記述に基づく。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "報告セグメントは子ども・子育て支援事業の単一セグメントで、2026年7月期の外部顧客への売上高は保育所が15,807百万円、その他が1,785百万円です。売上高の10％以上を占める相手先は自治体で、練馬区が1,971百万円、中央区が1,849百万円です。連結の従業員数は1,786人です。",
        "basis": "セグメント情報の関連情報における製品及びサービスごとの情報と主要な顧客ごとの情報、連結経営指標等の従業員数に基づく。",
        "asOf": "2026-10-22",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
