  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2026年3月期を初年度とする3ヵ年の中期計画2027では、「経営基盤強化と成長戦略の実行による収益性の改善」を基本方針として掲げています。長期ビジョンとして『「自動化技術×複合加工技術」で、お客様のモノづくりを支え続けるグローバル・ソリューション・カンパニーへ！』を定めています。",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "機械単体の標準機を販売するのではなく、顧客のニーズに細かく対応し、適切な加工方法などの提案も行うこと、そしてコストパフォーマンスや使い勝手に優れた自動化された製品群を提供し続けることを、企業価値の源泉と位置付けています。",
        "basis": "【会社の支配に関する基本方針】に、企業価値の源泉は、機械単体の標準機を販売するのではなく、お客様のニーズに細かく対応し、当社からも適切な加工方法などの提案を行うこと、コストパフォーマンスや使い勝手に優れた自動化された製品群をお客様に提供し続けることである旨が印字されている。",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "主力分野である工作機械業界については、日本工作機械工業会が2026年暦年の業界受注見通しを1兆7,000億円（前年比6.0％増）としており、内需では老朽化設備の更新や生産性向上を目的とした需要が底流にあると会社は見ています。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の経営環境に、日本工作機械工業会は2026年暦年業界受注見通しを1兆7,000億円（前年同期比6.0％増）としており、内需においては老朽化設備の更新や生産性向上を目的とした需要が底流としてある旨が印字されている。",
        "asOf": "2026-07-03",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
