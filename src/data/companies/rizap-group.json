  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "グループ理念「『人は変われる。』を証明する」を掲げ、「自己実現産業」を事業領域としています。長期ビジョンとして「人類の健康に最も貢献する企業グループ」を目指し、最重点戦略事業である「chocoZAP」を「健康の社会インフラ」として定着させることを目指します。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "「RIZAP」の知見を活かした独自のメソッドと低価格戦略により、chocoZAPは事業開始からわずか2年で日本最大の会員数を達成し、早期の黒字化を実現しました。",
        "basis": "【経営方針、経営環境及び対処すべき課題等】の中長期的な会社の経営戦略の記載に基づきます。",
        "asOf": "2026-06-25",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
