  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "社是「奉仕努力」のもと、「おいしい笑顔をお届けします」を経営コンセプトとして、「品質」と「ブランド」を重視し、安全・安心な商品の提供に努めています。2025年3月期から始めた3カ年中期経営計画では、基本方針としてコア事業の深化に挑戦し、収益構造を変革することを掲げ、2031年の創業100周年に向けて持続的成長の実現を目指しています。",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "重点は家庭用事業部門の立て直しと冷凍麺の拡大です。家庭用チルド麺は秋冬期や西日本地域での拡売と、販売・商品・生産・物流での業務改善を進め、需要が高まっている冷凍麺は商品開発やターゲット企業・国の開拓に着手する方針です。あわせて生産物流体制を見直し、安定供給できる体制の構築に向けた準備を進めています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の経営戦略等と優先的に対処すべき事業上及び財務上の課題の記載",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "商品力が強みです。ゆでずにさっと水でほぐすだけで食べられる「流水麺」や、からだにやさしい「健美麺」などの独自商品をFSSC22000取得工場で生産し、テレビＣＭや消費者キャンペーンなどの広告販促活動も行っています。2025年度の家庭用チルド麺の全国販売金額シェアは10.8％で第2位、関東エリアでは20.6％で第2位であり、2025年の業務用冷凍麺の全国販売金額シェアは19.0％で第2位でした。",
        "basis": "事業の内容の家庭用事業部門と業務用事業部門の商品、生産体制、広告販促活動と販売金額シェアの記載",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "食品事業のみの単一セグメントで、売上高410億61百万円の内訳は家庭用事業部門254億38百万円と業務用事業部門156億22百万円です。家庭用が過半を占め、業務用がこれに続く構成です。その他は連結子会社が当社グループへ行うリース・物販・損害保険代理等のサービスで、事業部門別の販売実績に独立した金額はありません。",
        "basis": "セグメント情報の単一セグメントの記載、MD&Aの事業部門別販売実績と経営成績の概要、事業の内容のその他の記載",
        "asOf": "2026-06-17",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
