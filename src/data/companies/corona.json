  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-14",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2027年の創業90周年を見据えた「2026ビジョン」のもと、第10次中期経営計画（2025年度～2027年度）を進めています。基本戦略は、脱炭素社会に向けた事業ポートフォリオの再構築（CO2排出量削減に寄与する機器やレジリエンス性の高い機器の拡大）、「楽」から「楽しい」への事業領域拡大（家事負担の軽減に寄与する商品やアウトドア領域の商品・サービスの提供）、経営基盤の再構築（社内制度や業務の進め方の見直しと働きがいの向上）の3つです。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "2001年に世界で初めて自然冷媒（CO2）ヒートポンプ給湯機エコキュートを発売した技術開発の蓄積があり、省エネ大賞を繰り返し受賞しています。三条・柏崎・長岡の生産拠点と技術開発センターを持ち、製造から販売、施工、アフターサービスまでをグループで担う体制も強みです。",
        "basis": "【沿革】のエコキュート発売と省エネ大賞受賞の記録、【事業の内容】の製造・販売・サービスの分担、【設備の状況】の生産拠点と技術開発センターの記載に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "住宅関連機器の単一セグメントで事業を行っています。2026年3月期の製品別の外部顧客への売上高は、住宅設備機器が42,367百万円と全体の約半分を占め、暖房機器が23,300百万円、空調・家電機器が13,816百万円、その他が5,853百万円です。国内の外部顧客への売上高が全体の90％を超えており、売上高の10％以上を占める特定の顧客はいません。",
        "basis": "セグメント情報等の注記の製品及びサービスごとの情報、地域ごとの情報、主要な顧客ごとの情報に基づく。",
        "asOf": "2026-06-23",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
