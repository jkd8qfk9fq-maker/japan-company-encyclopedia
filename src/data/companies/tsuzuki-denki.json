  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2033年3月期の創業100周年に向けた長期ビジョン「Growth Navigator（成長をナビゲートし、ともに創りあげる集団）」を掲げ、2027年3月期から2029年3月期までの中期経営計画「Trust & Challenge 2029」に取り組んでいます。計画では、AIを前提とした価値創出モデルへの転換（AI Nativeへの移行）と、エンジニアリングサービスを軸としたサービス中心の収益モデルへの進化、戦略投資によるインオーガニック成長、人材ポートフォリオの転換を軸に、プロフェッショナルサービスカンパニーへの変革を目指しています。当期は、日本IBM株式会社とのAIパートナーシップの締結や、クラウド型動態管理・配送管理サービス「TCloud for SCM」の機能強化を実行しました。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ソフトウエア開発からネットワーク構築・運用までを一貫して提供できる体制と、顧客理解・業界知見に基づくエンジニアリングサービスの提供力を強みとしています。SIとNIの両領域で、真の顧客理解に基づいた最適なソリューションを提供してきました。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "2026年3月期の連結売上高103,728百万円は単一セグメントの売上高で、ビジネスモデル別では機器が43,378百万円、サービスが42,957百万円、開発・構築が17,391百万円です。サービスは運用・保守とクラウド等の月額サービスからなるストック型の収益で、売上高の4割強を占めています。顧客は製造業、官公庁、金融業、サービス業、運輸業などに広がり、全ての顧客について販売実績は連結売上高の10％未満と分散しています。事業は国内中心で、本邦の外部顧客への売上高が連結売上高の90％を超えています。",
        "basis": "ビジネスモデル別の売上高、セグメント関連情報の主要な顧客ごとの情報と地域ごとの情報に基づく。",
        "asOf": "2026-06-19",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
