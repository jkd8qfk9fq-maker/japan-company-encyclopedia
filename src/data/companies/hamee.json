  "status": {
    "state": "published"
  },
  "updatedAt": "2026-11-17",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "2025年11月の株式分配型スピンオフによりプラットフォーム事業（NE株式会社）を分離した後はコマース事業に経営資源を集中し、2027年4月期からの3ヵ年を対象とする中期経営計画を策定したとしています。Mission/Strategyとして「ZカルチャーSPAと脱炭素の両立」を掲げ、ビューティー事業とゲーミングアクセサリー事業のカテゴリー拡張や新規ブランド・新カテゴリーの育成により、事業ポートフォリオの多角化を一層加速するとしています。",
        "asOf": "2026-07-24",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "スピンオフ後の体制ではコマース事業のみが残り、2026年4月期の売上高の9割以上をコマース事業が占めています。コマース事業の外部売上高は前期比5.8％増の20,095百万円で、モバイルアクセサリーを基盤にコスメティクスとゲーミングアクセサリーを第2・第3の柱とする構成への移行が進んでいます。",
        "basis": "セグメント情報の報告セグメント別外部売上高、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-07-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "若年層に高い認知度を持つiFaceブランドを主力とし、商品の企画・デザインから製造、物流、販売までのサプライチェーンをグループで構築していることが特徴です。多数のEC店舗における販売状況の分析を商品仕入れや企画に活用する体制も持っています。コスメティクスでは「ByUR」がベースメイク領域における主要ブランドとしての位置づけを確立したとされています。",
        "basis": "【事業の内容】の販路・サプライチェーンの記述、MD&Aの経営成績の概要に基づく。",
        "asOf": "2026-07-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "スマートフォンアクセサリー市場では海外勢を含む競合ブランドの台頭によりECを中心に競争が激化したとされ、モバイルライフ事業の売上高は前期比1.5％減となりました。一方、コスメティクス事業の売上高は前期比30.4％増、グローバル事業は同11.3％増と伸びています。",
        "basis": "MD&Aの経営成績の概要、セグメント情報の外部売上高に基づく。",
        "asOf": "2026-07-24",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
