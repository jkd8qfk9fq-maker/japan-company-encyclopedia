  "history": [
    {
      "year": 1966,
      "title": "株式会社コンピュータアプリケーションズの設立",
      "description": "コンピュータソフトウエアの受託設計制作及び販売を目的として、株式会社コンピュータアプリケーションズを設立しました。登記上の設立は1979年ですが、実質上の存続会社である同社の設立が当社グループの起点です。",
      "significance": "当社グループの創業であり、現在の事業の原点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1976,
      "title": "ファシリティーマネージメント事業の開始",
      "description": "コンピュータ専用ビル「CAC-FMセンター（飯田橋尚学ビル）」が竣工し、総合的なシステム運用管理サービスを目的とするファシリティーマネージメント事業を開始しました。",
      "significance": "システム運用管理サービスが当社グループの事業の柱の一つとなった起点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1989,
      "title": "米国子会社の設立",
      "description": "Computer Applications(America)Co.,Ltd.（現：CAC AMERICA CORPORATION）を米国ニューヨーク市に設立しました。",
      "significance": "海外IT事業の起点となった初の海外子会社です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1990,
      "title": "英国子会社の設立",
      "description": "Computer Applications(Europe)Company Limited（現：CAC EUROPE LIMITED）を英国ロンドン市に設立しました。",
      "significance": "欧州への展開の起点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1994,
      "title": "株式会社シーエーシーへの商号変更とSAPジャパンとの業務提携",
      "description": "子会社２社を吸収合併し、商号を株式会社シーエーシーに変更しました。同年、ERPパッケージの販売会社であるSAPジャパンと業務提携し、同社製品「R/3」を応用したシステム構築事業を開始しました。",
      "significance": "現在の主力子会社と同名となった節目であり、ERP関連のシステム構築事業の起点です。",
      "sourceIds": [
        "yuho-2025"
      ],
      "locator": "【沿革】"
    },
    {
      "year": 1999,
      "title": "株式の店頭登録",
      "description": "日本証券業協会に店頭登録銘柄として株式を公開しました。",
      "significance": "上場への第一歩となった資本市場への進出です。",
      "sourceIds": [
