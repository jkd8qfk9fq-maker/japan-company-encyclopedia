  "updatedAt": "2026-11-16",
  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "ビジョン「ハートを揺さぶるデザインで世界を前進させる」とミッション「デザインの力を証明する」のもと、デザイナー組織を拡大してデザインパートナー事業の成長を図るとともに、AI領域を含めた事業ポートフォリオの拡張や提供ソリューションの拡充を目指す方針です。顧客の事業フェーズに合わせた「Incubation」「Growth」「Transformation」の3つの価値提供を行い、プラットフォーム事業では「ReDesigner」のダイレクトリクルーティングプラットフォームへの拡大、「Strap」の導入規模の拡大、AIプロダクトの機能開発を進める方針です。",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "デザインパートナー事業の収益の源泉はデザインプロジェクトからの月額報酬であり、月額平均顧客単価の拡大と顧客社数の増加を通じて売上高を継続的に成長させる方針が示されています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の「目標とする経営指標」に、デザインパートナー事業の収益源泉と、判断指標としての顧客単価・顧客社数の位置づけが記載されていることに基づく",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "competitiveAdvantage": {
      "disclosed": {
        "text": "ユーザー体験を戦略・要件・構造・骨格・表層の5つの要素で捉え、プロトタイピングを繰り返しながらデザインを進めるデザインプロセスと、デザインストラテジスト・UXデザイナー・UIデザイナー・エンジニアが一体となったチーム体制を強みとしています。体系化したデザインノウハウの蓄積と研修により、デザイナーの属人性を下げ、品質の再現性を高める仕組みを整えています。",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ],
        "locator": "【事業の内容】"
      },
      "analysis": {
        "text": "正社員デザイナーの社内組織に加え、登録したフリーランスデザイナーがフルリモートで参加する「Goodpatch Anywhere」を組み合わせることで、プロジェクトの内容に応じてデザイナーを選定し、社員デザイナーと協働させる編成ができる点が特徴です。",
        "basis": "事業の内容に記載された正社員デザイン部門と「Goodpatch Anywhere」の体制と人数（2025年8月末現在）に基づく",
        "asOf": "2025-11-27",
        "sourceIds": [
          "yuho-2025"
        ]
      }
    },
    "industryPosition": {
      "disclosed": {
        "text": "企業のDXへの投資が拡大し、経済産業省がデザインを重要な経営資源として活用する「デザイン経営」の推進を提言するなかで、同社のUI/UXデザイン支援は、企業レベルでのブランディングから個別サービスにおけるデザインの実装までを幅広くサポートする位置づけにあります。国内のDX市場は2030年度にかけて拡大が見込まれています。",
        "asOf": "2025-11-27",
