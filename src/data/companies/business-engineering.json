  "perspectives": {
    "strategy": {
      "disclosed": {
        "text": "経営計画『経営Vision 2026 改訂版』と、2030年度に目指す姿および目標である成長戦略『BE 2030』のもと、『ものづくりデジタライゼーション』の拡大、『変革のためのDX』の推進、グローバル支援の強化、サステナビリティへの貢献の『４つの柱』に取り組んでいます。",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ],
        "locator": "【経営方針、経営環境及び対処すべき課題等】"
      },
      "analysis": {
        "text": "2026年３月期は、ソリューション事業とプロダクト事業の外部顧客への売上高がいずれも前期から大きく伸び、売上高は４期連続で過去最高となりました。一方でシステムサポート事業の外部顧客への売上高は前期を下回っており、売上構成ではシステムの導入・構築と自社製品の販売への比重が高まっています。",
        "basis": "セグメント情報の外部顧客への売上高、関連情報（製品及びサービスごとの情報）、MD&Aの経営成績の状況の概要",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "competitiveAdvantage": {
      "analysis": {
        "text": "前身である東洋エンジニアリング株式会社の工場システム化支援事業以来30年以上にわたる製造業のIT支援の実績と、自社プロダクトの製品企画・開発力、顧客との信頼関係、世界25か国での展開実績を強みとしています。",
        "basis": "経営方針、経営環境及び対処すべき課題等の『B-EN-Gの強みとリソース』の記述、MD&Aの経営成績の状況の概要",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    },
    "industryPosition": {
      "analysis": {
        "text": "顧客のデジタル変革（DX）に対する投資意欲は底堅く、製造業の情報化投資は堅調に推移するなかで、当社は製造業向けのERP導入支援と自社製品『mcframe』シリーズに特化した情報サービス事業者として、製造業のデジタル化を支援する位置にあります。",
        "basis": "MD&Aの経営成績の状況の概要、セグメント情報の外部顧客への売上高",
        "asOf": "2026-06-18",
        "sourceIds": [
          "yuho-2026"
        ]
      }
    }
  },
