# Copy to .env.local for development. Never commit real values.

# Public origin. Required for any production build (canonical URLs, sitemap, robots).
SITE_URL=http://localhost:3000

# Where reader reports are stored. Unset in development → .data/content-reports.json.
# Unset in production → the report form refuses to send (fail closed).
# Apply the schema with: npm run db:migrate
DATABASE_URL=

# Admin login. Generate both with: npm run admin:hash-password
# Either missing (or the secret shorter than 32 characters) → /admin is closed.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
